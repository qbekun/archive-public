[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 100,0:00:14.32,0:00:18.28,Default Echo,,0,0,0,,{\i1}Dawno temu dziewczynka \No nieprzeciętnym intelekcie,
Dialogue: 100,0:00:18.28,0:00:21.96,Default Echo,,0,0,0,,{\i1}która nie skończyła nawet roku, \Nzostała powierzona pewnej instytucji.
Dialogue: 100,0:00:22.50,0:00:26.33,Default Echo,,0,0,0,,{\i1}Stało się to niedługo po tym,\N jak nauczyła się mówić.
Dialogue: 100,0:00:30.63,0:00:33.38,Default Echo,,0,0,0,,{\i1\an8}W nowym domu po raz\N pierwszy zetknęła się z grami.
Dialogue: 100,0:00:35.26,0:00:39.81,Default Echo,,0,0,0,,{\i1}Kazano jej przechodzić\N kolejne "testy na inteligencję",
Dialogue: 100,0:00:39.81,0:00:43.18,Default Echo,,0,0,0,,{\i1}lecz bez względu na to,\N z kim grała, były dla niej nużące.
Dialogue: 100,0:00:44.64,0:00:46.90,Default Echo,,0,0,0,,{\i1}W ten sposób minęły dwa lata,
Dialogue: 100,0:00:48.06,0:00:51.57,Default Echo,,0,0,0,,{\i1}aż w końcu spotkała kogoś, \Nkto najwyraźniej jest jej matką
Dialogue: 100,0:00:53.11,0:00:56.16,Default Echo,,0,0,20,,{\i1}oraz o siedem lat starszego od siebie chłopca.
Dialogue: 100,0:00:56.16,0:01:00.08,Default Echo,,0,0,20,,{\i1}Rozmawiał z dorosłymi\N w najbardziej stosowny sposób,
Dialogue: 100,0:01:00.08,0:01:03.25,Default Echo,,0,0,0,,{\i1}racząc ich przy tym pustym\N i nienaturalnym uśmiechem.
Dialogue: 100,0:01:03.25,0:01:06.87,Default Echo,,0,0,0,,{\i1}Mimo że milczała od bardzo \Ndługiego czasu, dziewczynka powiedziała:
Dialogue: 100,0:01:09.09,0:01:11.13,Default Echo,,0,0,0,,Naprawdę jesteś pusty.
Dialogue: 100,0:01:20.93,0:01:23.60,Default Echo,,0,0,0,,{\an8}Ej, zagrajmy w coś.
Dialogue: 100,0:01:44.33,0:01:45.37,Default,,0,0,0,,Kto to taki?
Dialogue: 100,0:01:46.96,0:01:48.33,Default,,0,0,0,,Puści...
Dialogue: 100,0:01:50.38,0:01:51.88,Default,,0,0,0,,Puści nie...
Dialogue: 100,0:01:52.71,0:01:54.05,Default,,0,0,100,,Puści nie...
Dialogue: 100,0:02:08.77,0:02:11.40,Default Echo,,0,0,0,,Musiałaś mieć jakiś koszmar.
Dialogue: 100,0:02:11.40,0:02:13.48,Default Echo,,0,0,0,,Zaraz przyniosę ciepłego mleka.
Dialogue: 100,0:02:13.48,0:02:15.07,Default Echo,,0,0,0,,Nie! To nie tak!
Dialogue: 100,0:02:15.65,0:02:17.03,Default Echo,,0,0,0,,Był tutaj.
Dialogue: 100,0:02:17.03,0:02:18.28,Default Echo,,0,0,0,,Zawsze byliśmy razem.
Dialogue: 100,0:02:18.82,0:02:19.74,Default Echo,,0,0,0,,Dlatego...
Dialogue: 100,0:02:24.24,0:02:25.16,Default Echo,,0,0,0,,{\fad(0,500)}Shiro.
Dialogue: 100,0:02:28.96,0:02:30.00,Default Echo,,0,0,0,,Shiro!
Dialogue: 100,0:02:39.05,0:02:40.63,Default Echo,,0,0,0,,Zimne.
Dialogue: 100,0:02:42.14,0:02:44.60,Default Echo,,0,0,0,,Więc tu jesteś, moja pani.
Dialogue: 100,0:02:44.60,0:02:49.19,Default Echo,,0,0,0,,Dola martwiła się twoim zachowaniem, \Nwięc zaczęłam cię szukać.
Dialogue: 100,0:02:49.19,0:02:50.48,Default Echo,,0,0,0,,Jibril.
Dialogue: 100,0:02:50.48,0:02:52.77,Default Echo,,0,0,0,,Tak, o co chodzi?
Dialogue: 100,0:02:52.77,0:02:55.65,Default Echo,,0,0,0,,Kto jest twoim panem?
Dialogue: 100,0:02:56.11,0:02:58.07,Default Echo,,0,0,0,,Czemu tak nagle\N zadajesz takie pytanie?
Dialogue: 100,0:02:58.07,0:02:58.99,Default Echo,,0,0,0,,Odpowiedz!
Dialogue: 100,0:03:01.32,0:03:02.95,Default Echo,,0,0,0,,Ty, panienko Shiro.
Dialogue: 100,0:03:03.91,0:03:06.29,Default Echo,,0,0,0,,Kto był twoim \Nprzeciwnikiem w grze?
Dialogue: 100,0:03:06.66,0:03:08.37,Default,,0,0,0,,Ty, panienko Shiro.
Dialogue: 100,0:03:09.12,0:03:12.21,Default,,0,0,0,,A kto kazał Steph się zakochać?
Dialogue: 100,0:03:12.21,0:03:13.96,Default,,0,0,0,,Słyszałam, że ty, panienko Shiro.
Dialogue: 100,0:03:14.25,0:03:17.34,Default,,0,0,0,,Kto odkrył, na czym polega \Ngra Konfederacji Wschodniej?
Dialogue: 100,0:03:17.34,0:03:20.80,Default,,0,0,0,,Ty, używając wskazówek \Nzostawionych przez dziadka Doli.
Dialogue: 100,0:03:23.30,0:03:28.52,Default Echo,,0,0,0,,Będąc zauroczoną twoją nieprzeciętną inteligencją i pomysłowością,
Dialogue: 100,0:03:28.52,0:03:30.56,Default Echo,,0,0,0,,stałam się twoją wierną służką.
Dialogue: 100,0:03:31.02,0:03:32.98,Default Echo,,0,0,0,,Moją?
Dialogue: 100,0:03:33.56,0:03:34.27,Default Echo,,0,0,0,,Owszem.
Dialogue: 100,0:03:35.36,0:03:39.90,Default,,0,0,0,,{\t(3840,4510,1,\3c&HFFFFFF&)}Służę władczyni Elkii, \Njedynej reprezentantce Imanitów - tobie.
Dialogue: 100,0:03:43.16,0:03:46.16,Default Echo,,0,0,0,,Twierdzi, że ktoś\N jej w tym towarzyszył?
Dialogue: 100,0:03:46.99,0:03:49.16,Default Echo,,0,0,0,,Nie znalazłam żadnego dowodu.
Dialogue: 100,0:03:49.16,0:03:54.50,Default Echo,,0,0,0,,Podsłuchałam nawet rozmowy\N w mieście, lecz nic to nie dało.
