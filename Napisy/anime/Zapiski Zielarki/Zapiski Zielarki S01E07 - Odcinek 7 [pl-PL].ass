Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:32.19,0:01:35.19,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:35.49,0:01:37.32,Default,Maomao,0,0,0,,Tatku!
Dialogue: 0,0:01:40.16,0:01:41.24,Default,Maomao,0,0,0,,Tatku!
Dialogue: 0,0:01:46.87,0:01:50.84,Default,Text,0,0,0,,{\an8}ODCINEK 7: POWRÓT DO DOMU
Dialogue: 0,0:01:53.70,0:01:56.34,Default,Maomao,0,0,0,,Ciekawe, czy z tatkiem\Nwszystko w porządku.
Dialogue: 0,0:01:59.61,0:02:02.85,Default,Maomao,0,0,0,,Racja. Po wczorajszym przyjęciu...
Dialogue: 0,0:02:02.85,0:02:04.31,Default,Yinghua,0,0,0,,O czym ty bredzisz?
Dialogue: 0,0:02:04.31,0:02:07.10,Default,Ailan,0,0,0,,Minister, który połknął truciznę,\Njest w fatalnym stanie!
Dialogue: 0,0:02:07.10,0:02:08.64,Default,Guiyuan,0,0,0,,Jesteś chora. Idź się wyspać!
Dialogue: 0,0:02:10.90,0:02:13.55,Default,Maomao,0,0,0,,Dzięki temu udało mi się wyspać.
Dialogue: 0,0:02:13.55,0:02:15.65,Default,Maomao,0,0,0,,Jednak spanie\Ndo południa to przesada.
Dialogue: 0,0:02:21.20,0:02:24.18,Default,Maomao,0,0,0,,Ale bez makijażu ani rusz.
Dialogue: 0,0:02:28.72,0:02:29.77,Default,Gyokuyou,0,0,0,,Rany.
Dialogue: 0,0:02:29.79,0:02:31.92,Default,Gyokuyou,0,0,0,,Trzeba było sobie wziąć wolne.
Dialogue: 0,0:02:32.22,0:02:36.08,Default,Maomao,0,0,0,,To nie w moim stylu.\NCzekam na twe rozkazy.
Dialogue: 0,0:02:36.42,0:02:38.42,Default,Gyokuyou,0,0,0,,Piegi wróciły?
Dialogue: 0,0:02:38.42,0:02:42.68,Default,Maomao,0,0,0,,Bez nich czuję się nieswojo.\NMogą zostać?
Dialogue: 0,0:02:42.68,0:02:44.65,Default,Gyokuyou,0,0,0,,Zrozumiano.
Dialogue: 0,0:02:44.65,0:02:49.24,Default,Gyokuyou,0,0,0,,Wszyscy mnie męczyli,\Nby zdradzić im, kim była ta służka.
Dialogue: 0,0:02:49.24,0:02:51.08,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:02:51.08,0:02:52.43,Default,Gyokuyou,0,0,0,,W porządku.
Dialogue: 0,0:02:52.43,0:02:55.88,Default,Gyokuyou,0,0,0,,W każdym razie Gaoshun wpadł do nas\Nz samego rana. Chcesz go zobaczyć?
Dialogue: 0,0:02:56.67,0:03:00.49,Default,Gyokuyou,0,0,0,,Chyba się nudził, więc poprosiłam\Ngo o usunięcie kilku chwastów.
Dialogue: 0,0:03:01.30,0:03:02.87,Default,Maomao,0,0,0,,Chwastów...
Dialogue: 0,0:03:02.87,0:03:06.76,Default,Maomao,0,0,0,,Na przyjęciu znajdował się\Nna dość wysokiej pozycji.
Dialogue: 0,0:03:06.76,0:03:08.37,Default,Maomao,0,0,0,,Nie jest całkiem głupi.
Dialogue: 0,0:03:09.04,0:03:14.14,Default,Maomao,0,0,0,,Dobrze wie, jak podbić\Nserca wszystkich służek.
Dialogue: 0,0:03:15.73,0:03:19.09,Default,Maomao,0,0,0,,Mogłabym skorzystać z salonu?
Dialogue: 0,0:03:19.47,0:03:22.12,Default,Gyokuyou,0,0,0,,Oczywiście. Hongniang.
Dialogue: 0,0:03:22.12,0:03:22.72,Default,Hongniang,0,0,0,,Tak jest.
Dialogue: 0,0:03:22.72,0:03:26.72,Default,Maomao,0,0,0,,Czy tylko mi się wydaje,\Nczy Hongniang zabłysły oczka?
Dialogue: 0,0:03:27.24,0:03:29.39,Default,Gaoshun,0,0,0,,Pan Jinshi prosił,\Nbym ci to przekazał.
Dialogue: 0,0:03:31.14,0:03:35.15,Default,Maomao,0,0,0,,To zupa, którą miała dostać\Npani Gyokuyou, prawda?
Dialogue: 0,0:03:35.67,0:03:36.74,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:03:36.77,0:03:38.65,Default,Maomao,0,0,0,,Miło z jego strony.
Dialogue: 0,0:03:39.67,0:03:40.99,Default,Gaoshun,0,0,0,,Proszę, nie jedz jej.
Dialogue: 0,0:03:40.99,0:03:42.03,Default,Maomao,0,0,0,,Nie zamierzam.
Dialogue: 0,0:03:42.64,0:03:48.49,Default,Maomao,0,0,0,,Srebro szybko ulega korozji.\NUtlenia się i nie smakuje już tak dobrze.
Dialogue: 0,0:03:48.49,0:03:50.06,Default,Gaoshun,0,0,0,,Tak dobrze…
Dialogue: 0,0:03:50.06,0:03:52.41,Default,Maomao,0,0,0,,Dotykałeś tego gołymi rękami?
Dialogue: 0,0:03:52.41,0:03:54.99,Default,Gaoshun,0,0,0,,Nie, nie dotknąłem miski.
Dialogue: 0,0:03:54.99,0:03:58.04,Default,Gaoshun,0,0,0,,Łyżeczką przeszukałem zupę,\Nczy nie ma podejrzanych składników.
Dialogue: 0,0:03:58.04,0:04:00.57,Default,Gaoshun,0,0,0,,{\an8}Wiązu, wiązu, wiązu.
Dialogue: 0,0:03:58.04,0:04:01.01,Default,Gaoshun,0,0,0,,Potem od razu zawinąłem ją w szmatkę.
Dialogue: 0,0:04:02.96,0:04:04.76,Default,Maomao,0,0,0,,Momencik.
Dialogue: 0,0:04:04.76,0:04:05.99,Default,Maomao,0,0,0,,Ciach, ciach, ciach.
Dialogue: 0,0:04:06.01,0:04:07.13,Default,Maomao,0,0,0,,Stuk, stuk, stuk.
Dialogue: 0,0:04:08.31,0:04:10.80,Default,Gaoshun,0,0,0,,Wata, mąka i pędzelek.
Dialogue: 0,0:04:10.80,0:04:11.94,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:04:11.94,0:04:13.44,Default,Gaoshun,0,0,0,,Co zamierzasz z tym zrobić?
Dialogue: 0,0:04:13.88,0:04:15.74,Default,Maomao,0,0,0,,W zielarni, w której kiedyś pracowałam,
Dialogue: 0,0:04:15.74,0:04:20.36,Default,Maomao,0,0,0,,umieszczaliśmy barwniki na naczyniach,\Nktórych nie należało dotykać.
Dialogue: 0,0:04:20.36,0:04:22.24,Default,Maomao,0,0,0,,Zasada działania jest podobna.
Dialogue: 0,0:04:22.59,0:04:26.74,Default,Maomao,0,0,0,,To banalne.\NNa wacik nakładam trochę mąki.
Dialogue: 0,0:04:27.35,0:04:29.19,Default,Maomao,0,0,0,,Potem na miskę.
Dialogue: 0,0:04:29.76,0:04:33.14,Default,Maomao,0,0,0,,A na końcu nadmiar\Nusuwam pędzelkiem.
Dialogue: 0,0:04:36.03,0:04:37.06,Default,Maomao,0,0,0,,I już.
Dialogue: 0,0:04:37.09,0:04:39.01,Default,Gaoshun,0,0,0,,Są jakieś białe ślady.
Dialogue: 0,0:04:39.18,0:04:41.53,Default,Maomao,0,0,0,,Takie ślady pozostawia ludzka dłoń.
Dialogue: 0,0:04:42.23,0:04:46.38,Default,Maomao,0,0,0,,Łatwo je więc zostawić\Nna metalowych powierzchniach.
Dialogue: 0,0:04:46.38,0:04:49.88,Default,Maomao,0,0,0,,A jeszcze łatwiej \Nzobaczyć je na srebrze.
Dialogue: 0,0:04:50.28,0:04:53.77,Default,Maomao,0,0,0,,Dlatego należy dokładnie przecierać\Nsrebrne przedmioty przed użyciem.
Dialogue: 0,0:04:54.20,0:04:57.56,Default,Gaoshun,0,0,0,,Czyli ślady palców, które tutaj są,
Dialogue: 0,0:04:57.56,0:05:00.77,Default,Gaoshun,0,0,0,,że zostawili je ludzie,\Nktórzy dotknęli miski po przetarciu?
Dialogue: 0,0:05:01.12,0:05:02.48,Default,Maomao,0,0,0,,W rzeczy samej.
Dialogue: 0,0:05:03.12,0:05:08.34,Default,Maomao,0,0,0,,Wielkość i rozmieszczenie odcisków pozwala\Nodgadnąć, w jaki sposób ją trzymano.
Dialogue: 0,0:05:09.11,0:05:10.49,Default,Maomao,0,0,0,,Miskę musiał nieść…
Dialogue: 0,0:05:12.06,0:05:13.25,Default,Gaoshun,0,0,0,,Co się stało?
Dialogue: 0,0:05:17.64,0:05:18.73,Default,Maomao,0,0,0,,Nic takiego.
Dialogue: 0,0:05:19.34,0:05:23.28,Default,Maomao,0,0,0,,Miskę trzymały cztery osoby.
Dialogue: 0,0:05:23.28,0:05:24.65,Default,Gaoshun,0,0,0,,Cztery?
Dialogue: 0,0:05:25.34,0:05:28.52,Default,Maomao,0,0,0,,Najpierw trzy osoby dotknęły boku miski.
Dialogue: 0,0:05:28.96,0:05:30.71,Default,Maomao,0,0,0,,Ktoś, kto nalewał zupę,
Dialogue: 0,0:05:31.35,0:05:32.95,Default,Maomao,0,0,0,,ktoś, kto ją niósł,
Dialogue: 0,0:05:33.67,0:05:35.62,Default,Maomao,0,0,0,,i testerka pani Li Shu.
Dialogue: 0,0:05:36.69,0:05:38.64,Default,Maomao,0,0,0,,Ale był ktoś jeszcze.
Dialogue: 0,0:05:38.64,0:05:41.51,Default,Maomao,0,0,0,,Ktoś postronny dotknął krawędzi miski.
Dialogue: 0,0:05:41.86,0:05:46.61,Default,Maomao,0,0,0,,Myślę, że ta nieznana osoba\Nzatruła posiłek.
Dialogue: 0,0:05:47.56,0:05:53.19,Default,Gaoshun,0,0,0,,Jeśli tak było, to dlaczego na jej misce\Nznajduje się odcisk palca testerki?
Dialogue: 0,0:05:53.65,0:06:00.11,Default,Maomao,0,0,0,,Odpowiedź jest prosta. Testerka\Npani Li Shu celowo podmieniła posiłki.
Dialogue: 0,0:06:00.11,0:06:01.88,Default,Maomao,0,0,0,,nie wiedząc, że jest zatruty.
Dialogue: 0,0:06:01.88,0:06:02.88,Default,Gaoshun,0,0,0,,Podmieniła?
Dialogue: 0,0:06:04.04,0:06:05.34,Default,Maomao,0,0,0,,To złośliwość.
Dialogue: 0,0:06:05.34,0:06:08.46,Default,Gaoshun,0,0,0,,Zwykła służka ośmiela się tak\Ntraktować cesarską małżonkę?
Dialogue: 0,0:06:08.46,0:06:10.22,Default,Maomao,0,0,0,,Chyba ciężko w to uwierzyć.
Dialogue: 0,0:06:10.82,0:06:12.35,Default,Gaoshun,0,0,0,,Możesz to wyjaśnić?
Dialogue: 0,0:06:13.49,0:06:18.32,Default,Maomao,0,0,0,,Przede wszystkim chcę zaznaczyć,\Nże to tylko moje gdybanie.
Dialogue: 0,0:06:18.32,0:06:19.84,Default,Gaoshun,0,0,0,,Nie ma sprawy.
Dialogue: 0,0:06:19.84,0:06:23.88,Default,Maomao,0,0,0,,Pamiętasz suknię pani Li Shu\Nz przyjęcia w ogrodzie?
Dialogue: 0,0:06:23.88,0:06:26.86,Default,Gaoshun,0,0,0,,Tak. To był chyba jaskrawo różowy kolor.
Dialogue: 0,0:06:27.35,0:06:29.12,Default,Maomao,0,0,0,,Gdy konkubina wybierze kolor,
Dialogue: 0,0:06:29.12,0:06:32.16,Default,Maomao,0,0,0,,który kolidowałby\Nz suknią pani Gyokuyou,
Dialogue: 0,0:06:32.51,0:06:35.44,Default,Maomao,0,0,0,,to jej służki powinny jej go odradzić.
Dialogue: 0,0:06:35.44,0:06:40.17,Default,Maomao,0,0,0,,A jeśli ich nie posłucha, muszą\Ndopasować swoje stroje do jej wyboru.
Dialogue: 0,0:06:40.68,0:06:44.67,Default,Maomao,0,0,0,,Jednak wszystkie\Njej służki wybrały kolor biały.
Dialogue: 0,0:06:46.28,0:06:52.58,Default,Maomao,0,0,0,,Przez co pani Li Shu\Nwystawiła się na drwiny innych.
Dialogue: 0,0:06:52.58,0:06:54.56,Default,Maomao,0,0,0,,Służki są tylko tłem dla swojej pani.
Dialogue: 0,0:06:55.27,0:06:57.81,Default,Maomao,0,0,0,,Biorąc to pod uwagę, tego dnia…
Dialogue: 0,0:06:57.81,0:07:03.54,Default,Ah-Duo's Lady-in-Waiting 1,0,0,0,,Za grosz w was godności.\NSukienka w takim kolorze?
Dialogue: 0,0:07:04.81,0:07:07.42,Default,Maomao,0,0,0,,Służki pani A Duo zbeształy
Dialogue: 0,0:07:07.42,0:07:10.17,Default,Maomao,0,0,0,,służki pani Li Shu za to,\Nże nie wykonują obowiązków.
Dialogue: 0,0:07:10.82,0:07:12.97,Default,Maomao,0,0,0,,W wewnętrznym pałacu\Nnikomu nie można ufać,
Dialogue: 0,0:07:12.97,0:07:17.67,Default,Maomao,0,0,0,,więc konkubina może\Nufać tylko swoim służkom.
Dialogue: 0,0:07:17.67,0:07:22.79,Default,Maomao,0,0,0,,Przypuszczam, że to służki\Npoleciły tę suknię Cnotliwej Damie,
Dialogue: 0,0:07:23.20,0:07:26.32,Default,Maomao,0,0,0,,a ona go założyła,\Nnie wiedząc, że chciały ją upokorzyć.
Dialogue: 0,0:07:26.32,0:07:28.17,Default,Maomao,0,0,0,,Niczego nie podejrzewała.
Dialogue: 0,0:07:28.80,0:07:35.24,Default,Gaoshun,0,0,0,,Ale im było mało i próbowały podmienić go\Nna taki, którego nie mogła zjeść?
Dialogue: 0,0:07:35.24,0:07:38.04,Default,Maomao,0,0,0,,Tak, choć nie wiedziały,\Nże jest zatruty.
Dialogue: 0,0:07:38.04,0:07:40.55,Default,Maomao,0,0,0,,I to ją uratowało.
Dialogue: 0,0:07:42.69,0:07:44.50,Default,Maomao,0,0,0,,Niemniej to dalej było paskudne.
Dialogue: 0,0:07:46.39,0:07:48.23,Default,Gaoshun,0,0,0,,Dlaczego miałyby to robić?
Dialogue: 0,0:07:48.80,0:07:52.35,Default,Maomao,0,0,0,,Pani Li Shu w bardzo młodym wieku\Nzostała konkubiną poprzedniego cesarza.
Dialogue: 0,0:07:52.35,0:07:55.96,Default,Maomao,0,0,0,,Bardzo szybko została wdową,\Na na dworze zajmuje szczególne miejsce.
Dialogue: 0,0:07:55.96,0:07:58.94,Default,Maomao,0,0,0,,Każda kobieta jest gotowa\Npoświęcić wszystko dla męża.
Dialogue: 0,0:07:58.94,0:08:01.14,Default,Maomao,0,0,0,,Wpaja się nam to od najmłodszych lat.
Dialogue: 0,0:08:01.56,0:08:05.44,Default,Maomao,0,0,0,,Może i poślubiła syna zmarłego\Nmęża z powodów politycznych,
Dialogue: 0,0:08:05.44,0:08:07.75,Default,Maomao,0,0,0,,jednak kazirodztwo \Njest nie do przyjęcia.
Dialogue: 0,0:08:09.68,0:08:11.78,Default,Maomao,0,0,0,,Myślę, że odcisk przy krawędzi miski
Dialogue: 0,0:08:12.19,0:08:15.18,Default,Maomao,0,0,0,,pozostawiła osoba, \Nktóra dodała truciznę.
Dialogue: 0,0:08:15.52,0:08:18.89,Default,Maomao,0,0,0,,Pewnie trzymały ją za krawędź\Npodczas mieszania trucizny.
Dialogue: 0,0:08:18.89,0:08:19.93,Default,Gaoshun,0,0,0,,Rozumiem.
Dialogue: 0,0:08:20.71,0:08:25.32,Default,Maomao,0,0,0,,Opuszki palców nie mogą dotknąć miejsca,\Nktóre przeznaczone jest dla warg.
Dialogue: 0,0:08:25.32,0:08:26.94,Default,Maomao,0,0,0,,Nauczyła mnie tego Hongniang.
Dialogue: 0,0:08:27.83,0:08:29.93,Default,Maomao,0,0,0,,To wszystko, na co wpadłam.
Dialogue: 0,0:08:31.68,0:08:34.28,Default,Gaoshun,0,0,0,,Mogę zapytać o jeszcze jedną rzecz?
Dialogue: 0,0:08:34.28,0:08:35.37,Default,Maomao,0,0,0,,O co chodzi?
Dialogue: 0,0:08:37.25,0:08:40.95,Default,Gaoshun,0,0,0,,Czemu wczoraj nie wydałaś \Ntamtej testerki?
Dialogue: 0,0:08:43.83,0:08:47.21,Default,Gaoshun,0,0,0,,Pytam z ciekawości.\NTak bez żadnego powodu.
Dialogue: 0,0:08:50.66,0:08:55.72,Default,Maomao,0,0,0,,Życie służki jest niczym\Nw porównaniu z życiem konkubiny.
Dialogue: 0,0:08:58.08,0:09:01.85,Default,Maomao,0,0,0,,Zwłaszcza jeśli to życie\Nnależy do testerki…
Dialogue: 0,0:09:08.48,0:09:11.05,Default,Gaoshun,0,0,0,,Wyjaśnię to panu Jinshiemu.
Dialogue: 0,0:09:11.62,0:09:13.16,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:09:16.79,0:09:21.74,Default,Maomao,0,0,0,,Włożyła wiele trudu w zamienienie\Ntych misek. Powinnam jej podziękować.
Dialogue: 0,0:09:23.36,0:09:25.78,Default,Maomao,0,0,0,,Dzięki niej mogłam \Nskosztować tej trucizny.
Dialogue: 0,0:09:26.88,0:09:31.38,Default,Maomao,0,0,0,,Powinnam była łyknąć tę zupę.
Dialogue: 0,0:09:35.40,0:09:36.51,Default,Gaoshun,0,0,0,,To wszystko.
Dialogue: 0,0:09:36.51,0:09:41.56,Default,Jinshi,0,0,0,,Rozumiem. Imponujesz mi\Nsposobem dobierania słów.
Dialogue: 0,0:09:41.92,0:09:43.14,Default,Gaoshun,0,0,0,,Naprawdę?
Dialogue: 0,0:09:43.14,0:09:46.68,Default,Jinshi,0,0,0,,Mamy zdrajcę w naszych szeregach.
Dialogue: 0,0:09:46.68,0:09:49.06,Default,Gaoshun,0,0,0,,Na to wygląda.
Dialogue: 0,0:09:50.31,0:09:52.38,Default,Jinshi,0,0,0,,Łatwo powiedzieć.
Dialogue: 0,0:09:53.09,0:09:55.66,Default,Jinshi,0,0,0,,Po wczorajszej porażce\Nnie miałem czasu się wyspać
Dialogue: 0,0:09:55.66,0:09:57.47,Default,Jinshi,0,0,0,,ani nawet kiedy się przebrać.
Dialogue: 0,0:09:57.47,0:09:58.95,Default,Jinshi,0,0,0,,Nie mogę już nawet myśleć.
Dialogue: 0,0:09:59.59,0:10:01.86,Default,Gaoshun,0,0,0,,Twoja natura przemówiła.
Dialogue: 0,0:10:01.86,0:10:04.40,Default,Jinshi,0,0,0,,Kogo to obchodzi? Nikogo tu nie ma.
Dialogue: 0,0:10:04.40,0:10:05.45,Default,Gaoshun,0,0,0,,Jestem ja.
Dialogue: 0,0:10:05.86,0:10:07.58,Default,Jinshi,0,0,0,,Mógłbyś mi trochę odpuścić?
Dialogue: 0,0:10:07.58,0:10:09.12,Default,Gaoshun,0,0,0,,Nie.
Dialogue: 0,0:10:09.12,0:10:11.18,Default,Jinshi,0,0,0,,Nic co powiem,\Ncię stąd nie ruszy, co?
Dialogue: 0,0:10:11.18,0:10:12.95,Default,Gaoshun,0,0,0,,Za długo się znamy.
Dialogue: 0,0:10:13.36,0:10:17.59,Default,Jinshi,0,0,0,,Posiadanie opiekuna\Nod urodzenia nie jest łatwe.
Dialogue: 0,0:10:18.71,0:10:21.60,Default,Gaoshun,0,0,0,,Panie Jinshi, zapomniałeś\Nzdjąć spinkę do włosów.
Dialogue: 0,0:10:21.60,0:10:24.60,Default,Jinshi,0,0,0,,Rany. Wyleciało mi to z głowy.
Dialogue: 0,0:10:24.60,0:10:26.73,Default,Gaoshun,0,0,0,,Ukrywała się we włosach.
Dialogue: 0,0:10:26.73,0:10:29.92,Default,Gaoshun,0,0,0,,Powinieneś być ostrożniejszy.
Dialogue: 0,0:10:29.92,0:10:31.67,Default,Jinshi,0,0,0,,Zajmij się nią.
Dialogue: 0,0:10:32.75,0:10:35.32,Default,Gaoshun,0,0,0,,Znowu nią rzuciłeś.
Dialogue: 0,0:10:36.48,0:10:41.32,Default,Gaoshun,0,0,0,,Tylko nieliczne osoby mogą pochwalić się\Ntak cennym dodatkiem, więc dbaj o niego.
Dialogue: 0,0:10:41.76,0:10:43.28,Default,Jinshi,0,0,0,,Wiem o tym.
Dialogue: 0,0:10:43.28,0:10:44.70,Default,Gaoshun,0,0,0,,Nie sądzę.
Dialogue: 0,0:10:46.36,0:10:48.16,Default,Gaoshun,0,0,0,,Proszę wybaczyć.
Dialogue: 0,0:10:53.72,0:10:55.13,Default,Jinshi,0,0,0,,Do roboty.
Dialogue: 0,0:10:58.63,0:11:01.58,Default,Xiaolan,0,0,0,,A właśnie, masz spinki do włosów?
Dialogue: 0,0:11:01.58,0:11:02.63,Default,Maomao,0,0,0,,Kilka.
Dialogue: 0,0:11:04.90,0:11:06.28,Default,Xiaolan,0,0,0,,Supcio!
Dialogue: 0,0:11:06.28,0:11:07.28,Default,Xiaolan,0,0,0,,Więc…
Dialogue: 0,0:11:08.26,0:11:10.14,Default,Xiaolan,0,0,0,,Możesz wyjść z wewnętrznego pałacu!
Dialogue: 0,0:11:12.04,0:11:14.59,Default,Maomao,0,0,0,,Coś ty powiedziała?
Dialogue: 0,0:11:14.59,0:11:16.66,Default,Xiaolan,0,0,0,,Możesz wyjść z wewnętrznego pałacu?
Dialogue: 0,0:11:17.15,0:11:19.03,Default,Maomao,0,0,0,,Więcej szczegółów!
Dialogue: 0,0:11:20.69,0:11:22.03,Default,Xiaolan,0,0,0,,Jasne…
Dialogue: 0,0:11:24.05,0:11:27.20,Default,Xiaolan,0,0,0,,Jest on niedostępny\Ndla mężczyzn z zewnątrz, ale…
Dialogue: 0,0:11:27.56,0:11:32.36,Default,Xiaolan,0,0,0,,jeśli uzyska specjalne pozwolenie,\Nmoże poprosić dworkę o opuszczenie pałacu.
Dialogue: 0,0:11:32.36,0:11:36.88,Default,Maomao,0,0,0,,Więc to właśnie oznaczają rozdawane\Nna przyjęciu ogrodowym ozdoby.
Dialogue: 0,0:11:36.88,0:11:43.47,Default,Xiaolan,0,0,0,,Zgadza się! Spinka do włosów tożsama\Njest z prośbą o wypuszczenie z pałacu.
Dialogue: 0,0:11:43.79,0:11:47.97,Default,Maomao,0,0,0,,Dobra. Dzięki, Xiaolan.\NSpróbuję.
Dialogue: 0,0:11:49.17,0:11:50.56,Default,Xiaolan,0,0,0,,Nie ma sprawy.
Dialogue: 0,0:11:51.20,0:11:53.77,Default,Xiaolan,0,0,0,,Maomao, dzięki za owoce głogu!
Dialogue: 0,0:11:54.17,0:11:55.94,Default,Xiaolan,0,0,0,,Były pyszne!
Dialogue: 0,0:12:00.18,0:12:03.07,Default,Maomao,0,0,0,,W sumie dostałam\Ncztery spinki do włosów.
Dialogue: 0,0:12:03.07,0:12:05.41,Default,Maomao,0,0,0,,W tym dwie od facetów.
Dialogue: 0,0:12:06.05,0:12:08.96,Default,Maomao,0,0,0,,Czekaj no, czy faceta,\Na w zasadzie kastrata,
Dialogue: 0,0:12:08.96,0:12:11.25,Default,Maomao,0,0,0,,można dalej nazywać mężczyzną?
Dialogue: 0,0:12:11.75,0:12:13.29,Default,Jinshi,0,0,0,,Zielareczko!
Dialogue: 0,0:12:14.44,0:12:15.54,Default,Maomao,0,0,0,,Dobra!
Dialogue: 0,0:12:20.63,0:12:23.93,Default,Eunuch 1,0,0,0,,Panie Lihaku, dama dworu\Nprzesyła ci wiadomość.
Dialogue: 0,0:12:23.93,0:12:25.53,Default,Lihaku,0,0,0,,Dobrze.
Dialogue: 0,0:12:26.95,0:12:31.20,Default,Lihaku,0,0,0,,Rany, czy ona na serio\Nwzięła tę spinkę?
Dialogue: 0,0:12:31.20,0:12:34.14,Default,Lihaku,0,0,0,,Jednak jeśli to jakaś ślicznotka,\Nto byłaby szkoda…
Dialogue: 0,0:12:34.14,0:12:36.15,Default,Text,0,0,0,,{\an8}JADEITOWY PAWILON\NMAOMAO
Dialogue: 0,0:12:36.15,0:12:39.98,Default,Lihaku,0,0,0,,Rozdałem tylko jedną\Nspinkę w Jadeitowym Pałacu…
Dialogue: 0,0:12:39.98,0:12:41.26,Default,Lihaku,0,0,0,,Co oznacza, że…
Dialogue: 0,0:12:43.12,0:12:44.65,Default,Lihaku,0,0,0,,to ona?
Dialogue: 0,0:12:45.75,0:12:48.91,Default,Lihaku,0,0,0,,Pytanie, jak mam jej odmówić…
Dialogue: 0,0:12:51.27,0:12:52.62,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:12:55.78,0:12:57.00,Default,Maomao,0,0,0,,Dziękuję za cierpliwość.
Dialogue: 0,0:12:57.40,0:12:59.34,Default,Lihaku,0,0,0,,Co? Ktoś ty?
Dialogue: 0,0:12:59.80,0:13:01.31,Default,Maomao,0,0,0,,Często to słyszę.
Dialogue: 0,0:13:01.31,0:13:04.81,Default,Lihaku,0,0,0,,Czy ktoś ci kiedyś mówił,\Nże w makijażu jesteś kimś innym?
Dialogue: 0,0:13:04.81,0:13:06.38,Default,Maomao,0,0,0,,A bo to raz.
Dialogue: 0,0:13:08.20,0:13:11.21,Default,Lihaku,0,0,0,,Tak czy inaczej, wezwałaś mnie…
Dialogue: 0,0:13:11.84,0:13:14.14,Default,Maomao,0,0,0,,Chcę wrócić do mojej rodziny.
Dialogue: 0,0:13:14.14,0:13:15.38,Default,Lihaku,0,0,0,,Rodziny?
Dialogue: 0,0:13:15.96,0:13:18.52,Default,Lihaku,0,0,0,,Więc wiesz, co to oznacza?
Dialogue: 0,0:13:18.52,0:13:23.49,Default,Maomao,0,0,0,,Ponoć mogłabym wrócić do domu,\No ile poręczyłbyś za mnie.
Dialogue: 0,0:13:23.49,0:13:25.40,Default,Lihaku,0,0,0,,Masz niezły tupet.
Dialogue: 0,0:13:25.40,0:13:29.45,Default,Lihaku,0,0,0,,Naprawdę myślisz, że oficer jak ja\Nprzystanie na takie żądanie?
Dialogue: 0,0:13:29.99,0:13:31.00,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:13:32.72,0:13:36.28,Default,Lihaku,0,0,0,,I tylko po to mnie wezwałaś?
Dialogue: 0,0:13:36.28,0:13:37.28,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:13:37.31,0:13:40.78,Default,Lihaku,0,0,0,,Istnieje cienka granica między\Nzuchwałością a bezczelnością.
Dialogue: 0,0:13:42.34,0:13:48.51,Default,Lihaku,0,0,0,,Jeśli dobrze cię zrozumiałem, chcesz\Nmnie wykorzystać, by wrócić do domu.
Dialogue: 0,0:13:48.51,0:13:52.97,Default,Maomao,0,0,0,,Nie. Myślę, że mogę zaoferować\Ncoś cennego w zamian.
Dialogue: 0,0:13:53.43,0:13:54.56,Default,Lihaku,0,0,0,,Co?
Dialogue: 0,0:13:57.48,0:14:00.48,Default,Maomao,0,0,0,,Chcesz podziwiać kwiaty\Nw Grynszpanowym Pawilonie?
Dialogue: 0,0:14:02.41,0:14:05.34,Default,Lihaku,0,0,0,,Grynszpanowy Pawilon?\NChyba żartujesz!
Dialogue: 0,0:14:05.34,0:14:08.32,Default,Lihaku,0,0,0,,Zwykła wizyta tam jest bardzo kosztowna!
Dialogue: 0,0:14:08.32,0:14:12.95,Default,Maomao,0,0,0,,Nie, jak przyjdziesz na moje zaproszenie.\NTo jest twoja przepustka.
Dialogue: 0,0:14:12.95,0:14:16.20,Default,Maomao,0,0,0,,Pairin. Joka. Meimei.
Dialogue: 0,0:14:17.25,0:14:19.08,Default,Lihaku,0,0,0,,Własnym uszom nie wierzę!
Dialogue: 0,0:14:19.08,0:14:22.67,Default,Lihaku,0,0,0,,To Trzy Księżniczki, na które nie stać\Nnawet najwyższych urzędników!
Dialogue: 0,0:14:22.67,0:14:25.39,Default,Maomao,0,0,0,,No cóż, skoro mi nie wierzysz…
Dialogue: 0,0:14:26.24,0:14:29.18,Default,Maomao,0,0,0,,Przepraszam,\Nże zmarnowałam twój czas.
Dialogue: 0,0:14:29.18,0:14:30.36,Default,Lihaku,0,0,0,,Cz-czekaj…
Dialogue: 0,0:14:30.36,0:14:33.40,Default,Maomao,0,0,0,,Szkoda, więc będę musiała\Npoprosić kogoś innego.
Dialogue: 0,0:14:33.40,0:14:35.60,Default,Maomao,0,0,0,,Zapomnij, o czym mówiłam.
Dialogue: 0,0:14:37.08,0:14:40.22,Default,Lihaku,0,0,0,,Ma jeszcze innych kandydatów?!
Dialogue: 0,0:14:40.22,0:14:43.32,Default,Lihaku,0,0,0,,Spinki do włosów\Nz różowym kwarcem i srebrem?
Dialogue: 0,0:14:43.32,0:14:46.00,Default,Lihaku,0,0,0,,To urzędnicy znacznie bogatsi ode mnie!
Dialogue: 0,0:14:46.00,0:14:48.17,Default,Lihaku,0,0,0,,Kim jest ta dziewucha?!
Dialogue: 0,0:14:48.17,0:14:50.82,Default,Lihaku,0,0,0,,Jeśli tak, to co powiedziała może być…
Dialogue: 0,0:14:50.82,0:14:53.07,Default,Lihaku,0,0,0,,To zbyt piękne, by było prawdziwe!
Dialogue: 0,0:14:53.37,0:14:59.58,Default,Lihaku,0,0,0,,Ale jeśli tak, to okazja do spotkania\Nzacnych niewiast już się nie powtórzy…
Dialogue: 0,0:14:59.90,0:15:01.91,Default,Lihaku,0,0,0,,Co mam zrobić?!
Dialogue: 0,0:15:03.60,0:15:05.75,Default,Maomao,0,0,0,,No więc jak będzie?
Dialogue: 0,0:15:13.73,0:15:15.68,Default,Lihaku,0,0,0,,Przegrałem.
Dialogue: 0,0:15:15.68,0:15:17.97,Default,Yinghua,0,0,0,,Gratulacje, Maomao!
Dialogue: 0,0:15:17.97,0:15:20.70,Default,Yinghua,0,0,0,,Ledwo przyjechałaś,\Na już zdołałaś nas ubiec!
Dialogue: 0,0:15:20.70,0:15:22.19,Default,Ailan,0,0,0,,Tak się cieszę!
Dialogue: 0,0:15:22.19,0:15:24.19,Default,Guiyuan,0,0,0,,Pewnie poznałaś kogoś fajnego!
Dialogue: 0,0:15:24.19,0:15:26.44,Default,Maomao,0,0,0,,Podziękować?
Dialogue: 0,0:15:26.44,0:15:28.83,Default,Yinghua,0,0,0,,Twój brak entuzjazmu jest powalający!
Dialogue: 0,0:15:28.83,0:15:31.45,Default,Maomao,0,0,0,,Bez obaw, wrócę z pamiątkami.
Dialogue: 0,0:15:31.45,0:15:33.56,Default,Yinghua,0,0,0,,Gdzie go poznałaś?
Dialogue: 0,0:15:33.56,0:15:35.05,Default,Maomao,0,0,0,,Przypadek?
Dialogue: 0,0:15:35.05,0:15:39.08,Default,Hongniang,0,0,0,,Chyba nie zrozumiała \Nznaczenia tej spinki.
Dialogue: 0,0:15:39.37,0:15:44.33,Default,Gyokuyou,0,0,0,,Z pewnością. Żal mi tego kogoś.
Dialogue: 0,0:15:46.97,0:15:48.51,Default,Gyokuyou,0,0,0,,To takie zabawne.
Dialogue: 0,0:15:50.07,0:15:52.46,Default,Gyokuyou,0,0,0,,Ciekawe, jaką będzie miał minę…
Dialogue: 0,0:15:52.46,0:15:56.03,Default,Hongniang,0,0,0,,Przewiduję spore\Nkłopoty z tym związane…
Dialogue: 0,0:15:56.47,0:16:01.21,Default,Narrator,0,0,0,,Jinshi, uwolniony w końcu od swoich\Nobowiązków, przybył do pałacu
Dialogue: 0,0:16:01.21,0:16:04.85,Default,Narrator,0,0,0,,dzień po odejściu\Nswojej ulubienicy Maomao.
Dialogue: 0,0:16:04.85,0:16:09.14,Default,Gyokuyou,0,0,0,,Maomao opuściła nas z kimś.
Dialogue: 0,0:16:15.52,0:16:17.66,Default,Gyokuyou,0,0,0,,Na trzydniowy pobyt w domu.
Dialogue: 0,0:16:18.69,0:16:22.41,Default,Maomao,0,0,0,,Dzielnica uciech, w której dorastałam,\Nznajduje się niedaleko.
Dialogue: 0,0:16:23.19,0:16:28.17,Default,Maomao,0,0,0,,Po przekroczeniu murów pałacu\Nmożna pokonać dystans pieszo.
Dialogue: 0,0:16:30.04,0:16:32.92,Default,Maomao,0,0,0,,Powóz? Jaka burżuazja.
Dialogue: 0,0:16:32.92,0:16:35.74,Default,Maomao,0,0,0,,Trzeba przyznać, że te trzy kurtyzany
Dialogue: 0,0:16:35.74,0:16:39.72,Default,Maomao,0,0,0,,są niedostępne \Ndla zwykłych śmiertelników.
Dialogue: 0,0:16:40.34,0:16:43.60,Default,Maomao,0,0,0,,Tylko nieliczni mają okazję\Nstanąć z nimi twarzą w twarz.
Dialogue: 0,0:16:43.60,0:16:45.94,Default,Lihaku,0,0,0,,No i jesteśmy…
Dialogue: 0,0:16:47.46,0:16:48.90,Default,Lihaku,0,0,0,,Dzielnica uciech!
Dialogue: 0,0:16:51.91,0:16:56.46,Default,Maomao,0,0,0,,Niektóre dziewczyny przychodzą\Ndo burdeli, by stać się takie jak one.
Dialogue: 0,0:16:56.46,0:16:58.41,Default,Maomao,0,0,0,,Jednak nie jest to łatwe.
Dialogue: 0,0:16:59.08,0:17:01.77,Default,Maomao,0,0,0,,W przypadku nowicjuszek\Nnie ma gwarancji,
Dialogue: 0,0:17:01.77,0:17:03.75,Default,Maomao,0,0,0,,że kiedykolwiek odniosą sukces.
Dialogue: 0,0:17:06.25,0:17:08.51,Default,Lihaku,0,0,0,,Więc to jest Grynszpanowy Pawilon…
Dialogue: 0,0:17:08.51,0:17:09.53,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:17:09.13,0:17:12.45,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:17:09.72,0:17:12.46,Default,Lihaku,0,0,0,,Wygląda naprawdę prestiżowo.
Dialogue: 0,0:17:12.46,0:17:14.64,Default,Maomao,0,0,0,,To prawdziwy unikat
Dialogue: 0,0:17:14.64,0:17:17.84,Default,Maomao,0,0,0,,znany jedynie\Nze swoich luksusowych kurtyzan.
Dialogue: 0,0:17:19.64,0:17:21.10,Default,Maomao,0,0,0,,Dawno się nie widziałyśmy.
Dialogue: 0,0:17:22.04,0:17:23.35,Default,Maomao,0,0,0,,Jak się wszyscy…
Dialogue: 0,0:17:28.65,0:17:31.78,Default,Old Lady,0,0,0,,Co ma znaczyć: „dawno się nie\Nwidziałyśmy?!”, głupia dziewucho?
Dialogue: 0,0:17:31.78,0:17:35.16,Default,Lihaku,0,0,0,,Nic ci nie jest?!\NCo jest z tą staruszką?!
Dialogue: 0,0:17:35.16,0:17:39.08,Default,Maomao,0,0,0,,To jest właścicielka\NGrynszpanowego Pawilonu.
Dialogue: 0,0:17:39.08,0:17:43.20,Default,Maomao,0,0,0,,Kiedyś pomogło mi to wypluć\Nwszystkie trucizny, które próbowałam.
Dialogue: 0,0:17:43.64,0:17:45.83,Default,Old Lady,0,0,0,,Czy to o tego klienta chodzi?
Dialogue: 0,0:17:46.35,0:17:50.25,Default,Old Lady,0,0,0,,Ma ładną buźkę i niezłe ciałko.
Dialogue: 0,0:17:50.25,0:17:52.99,Default,Old Lady,0,0,0,,Podobno mają\Nco do ciebie wielkie nadzieje.
Dialogue: 0,0:17:52.99,0:17:56.84,Default,Maomao,0,0,0,,Po co mówisz to na głos?
Dialogue: 0,0:17:56.84,0:17:59.05,Default,Old Lady,0,0,0,,Hej. Zawołaj Pairin.
Dialogue: 0,0:17:59.05,0:18:00.76,Default,Old Lady,0,0,0,,Powinna dziś parzyć herbatę.
Dialogue: 0,0:18:00.76,0:18:01.82,Default,Serving Girl,0,0,0,,Tak jest!
Dialogue: 0,0:18:01.85,0:18:02.91,Default,Lihaku,0,0,0,,Pairin…
Dialogue: 0,0:18:02.91,0:18:06.33,Default,Maomao,0,0,0,,Panie Lihaku, jak u ciebie z krzepą?
Dialogue: 0,0:18:06.33,0:18:08.58,Default,Lihaku,0,0,0,,Całkiem nieźle.
Dialogue: 0,0:18:09.19,0:18:11.94,Default,Maomao,0,0,0,,Może da radę…
Dialogue: 0,0:18:11.94,0:18:13.38,Default,Serving Girl,0,0,0,,Tędy, proszę.
Dialogue: 0,0:18:14.37,0:18:15.53,Default,Lihaku,0,0,0,,Denerwuję się…
Dialogue: 0,0:18:16.15,0:18:18.35,Default,Maomao,0,0,0,,Bawcie się dobrze.
Dialogue: 0,0:18:18.35,0:18:19.41,Default,Lihaku,0,0,0,,Jasne!
Dialogue: 0,0:18:21.37,0:18:27.50,Default,Old Lady,0,0,0,,A zatem… Żadna sztuczka ci nie straszna.\NZniknąć na dziesięć miesięcy bez śladu.
Dialogue: 0,0:18:27.50,0:18:31.24,Default,Maomao,0,0,0,,Nie miałam nic do powiedzenia.\NNie czytałaś listu, który wysłałam?
Dialogue: 0,0:18:31.24,0:18:33.76,Default,Old Lady,0,0,0,,Zrobiłam to! Inaczej nie zmusiłabym się
Dialogue: 0,0:18:33.76,0:18:35.82,Default,Old Lady,0,0,0,,do niańczenia tego młodego kogucika.
Dialogue: 0,0:18:35.82,0:18:43.10,Default,Maomao,0,0,0,,Wiem, wiem. Oto połowa tego,\Nco do tej pory zarobiłam.
Dialogue: 0,0:18:43.10,0:18:47.15,Default,Old Lady,0,0,0,,To za mało jak za Pairin.
Dialogue: 0,0:18:47.15,0:18:49.58,Default,Maomao,0,0,0,,W końcu tylko wypiją\Nsobie herbatkę, prawda?
Dialogue: 0,0:18:49.58,0:18:54.02,Default,Old Lady,0,0,0,,Głupia! Myślisz, że Pairin oprze\Nsię chłopu z takim ciałem?
Dialogue: 0,0:18:54.02,0:18:57.00,Default,Maomao,0,0,0,,Wiedziałam.\NAle jeśli to ona straci kontrolę…
Dialogue: 0,0:18:57.00,0:19:00.97,Default,Old Lady,0,0,0,,To nie przejdzie!\NDopiszę ci to do rachunku.
Dialogue: 0,0:19:00.97,0:19:02.59,Default,Maomao,0,0,0,,Nie stać mnie na to…
Dialogue: 0,0:19:02.59,0:19:05.04,Default,Old Lady,0,0,0,,Przyślij mi więc kilku klientów,\Ntakich solidnych.
Dialogue: 0,0:19:05.04,0:19:09.04,Default,Old Lady,0,0,0,,Podobnych do tego kolesia.\NMłodych i porządnie wygłodzonych.
Dialogue: 0,0:19:09.88,0:19:12.47,Default,Maomao,0,0,0,,Czy eunuch spełni te wymagania?
Dialogue: 0,0:19:12.90,0:19:15.72,Default,Maomao,0,0,0,,Nawet o tym nie myśl.\NWywołałoby to totalny chaos,
Dialogue: 0,0:19:15.72,0:19:17.16,Default,Maomao,0,0,0,,a burdel by zbankrutował.
Dialogue: 0,0:19:17.57,0:19:20.80,Default,Maomao,0,0,0,,Szkoda by mi było Gaoshuna\Nalbo tego medyka…
Dialogue: 0,0:19:22.00,0:19:26.26,Default,Old Lady,0,0,0,,Twój staruszek musi być w domu.\NIdź się z nim zobacz, ale już.
Dialogue: 0,0:19:30.18,0:19:34.77,Default,Maomao,0,0,0,,Wystarczy przejść przez jedną ulicę,\Nby widok kompletnie się zmienił.
Dialogue: 0,0:19:35.43,0:19:39.53,Default,Maomao,0,0,0,,Zniszczone budynki,\Nżebracy i chorzy na syfilis.
Dialogue: 0,0:19:41.48,0:19:43.53,Default,Maomao,0,0,0,,Nic się nie zmieniło.
Dialogue: 0,0:19:57.76,0:19:59.92,Default,Maomao,0,0,0,,Wróciłam, tatku.
Dialogue: 0,0:19:59.92,0:20:03.93,Default,Luomen,0,0,0,,Witaj w domu. Co tak długo?
Dialogue: 0,0:20:05.94,0:20:07.93,Default,Maomao,0,0,0,,Nareszcie wróciłam do domu.
Dialogue: 0,0:20:08.63,0:20:13.90,Default,Maomao,0,0,0,,Poszłam kupić trochę kosmetyków\Ndo makijażu, aż tu nagle…
Dialogue: 0,0:20:25.40,0:20:29.23,Default,Maomao,0,0,0,,Wyjeżdżam pojutrze.\NMoja umowa jeszcze się nie skończyła.
Dialogue: 0,0:20:29.23,0:20:30.29,Default,Luomen,0,0,0,,Rozumiem.
Dialogue: 0,0:20:30.38,0:20:33.11,Default,Maomao,0,0,0,,Spać mi się chce,\Nale jeszcze się umyję.
Dialogue: 0,0:20:33.50,0:20:36.97,Default,Luomen,0,0,0,,Możesz to zrobić jutro\Nw Grynszpanowym Pawilonie.
Dialogue: 0,0:20:38.16,0:20:40.51,Default,Maomao,0,0,0,,Tak zrobię.
Dialogue: 0,0:20:58.92,0:21:03.58,Default,Luomen,0,0,0,,Wewnętrzny pałac… Los bywa przewrotny.
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.52,0:22:48.65,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Słomka”.
Dialogue: 0,0:22:48.67,0:22:50.25,Default,,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
