Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.48,0:01:33.48,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:31.49,0:01:33.73,Default,Jinshi,0,0,0,,{\an8}To trochę kłopotliwe...
Dialogue: 0,0:01:34.03,0:01:34.74,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:01:34.74,0:01:39.12,Default,Maomao,0,0,0,,Zwykle nie waha się\Npakować mnie w tarapaty.
Dialogue: 0,0:01:39.12,0:01:41.45,Default,Maomao,0,0,0,,Bardzo nie w jego stylu.
Dialogue: 0,0:01:43.08,0:01:44.62,Default,Maomao,0,0,0,,O co chodzi?
Dialogue: 0,0:01:44.62,0:01:45.66,Default,Jinshi,0,0,0,,No cóż...
Dialogue: 0,0:01:46.26,0:01:49.88,Default,Jinshi,0,0,0,,Jest to coś związanego z takim\Njednym znajomym znajomego.
Dialogue: 0,0:01:51.24,0:01:54.22,Default,Jinshi,0,0,0,,Cyzelator, pałacowy dostawca, zmarł,
Dialogue: 0,0:01:54.22,0:01:58.94,Default,Jinshi,0,0,0,,zanim przekazał swoje techniki\Nswoim synom, a zarazem uczniom.
Dialogue: 0,0:02:00.33,0:02:04.89,Default,Jinshi,0,0,0,,Podobno niektóre z tych technik\Nbyły ściśle tajne i nikomu nieznane.
Dialogue: 0,0:02:06.05,0:02:10.65,Default,Maomao,0,0,0,,Więc chcesz poznać tajne\Ntechniki tego cyzelatora.
Dialogue: 0,0:02:11.62,0:02:13.77,Default,Jinshi,0,0,0,,Łatwiej powiedzieć niż zrobić.
Dialogue: 0,0:02:14.08,0:02:17.80,Default,Jinshi,0,0,0,,Poza tym czemu nam wrażenie,\Nże już się podnieciłaś?
Dialogue: 0,0:02:19.38,0:02:20.95,Default,Maomao,0,0,0,,Naprawdę?
Dialogue: 0,0:02:23.75,0:02:28.00,Default,Jinshi,0,0,0,,Jego trzej synowie\Nbyli również jego uczniami.
Dialogue: 0,0:02:28.00,0:02:32.54,Default,Jinshi,0,0,0,,Jako że ojciec zmarł, wiadomo,\Nże jeden z synów zajmie jego miejsce.
Dialogue: 0,0:02:33.73,0:02:38.12,Default,Jinshi,0,0,0,,Testament wskazywał dyspozycje\Npodziału majątku po ojcu.
Dialogue: 0,0:02:38.66,0:02:41.21,Default,Jinshi,0,0,0,,Pracownia dla najstarszego syna.
Dialogue: 0,0:02:41.89,0:02:44.65,Default,Jinshi,0,0,0,,Mebel ozdobiony metalową\Ndekoracją dla średniego syna.
Dialogue: 0,0:02:45.19,0:02:47.52,Default,Jinshi,0,0,0,,A akwarium dla najmłodszego.
Dialogue: 0,0:02:47.87,0:02:54.40,Default,Jinshi,0,0,0,,I jedno zdanie: „Mam nadzieję, że\Nspotkacie się na herbatce jak dawniej”.
Dialogue: 0,0:02:54.76,0:02:58.86,Default,Maomao,0,0,0,,Herbatka? Dość zagadkowa treść.
Dialogue: 0,0:02:59.38,0:03:04.07,Default,Maomao,0,0,0,,Czy dosłownie chodziło mu o spotkanie\Nprzy herbacie? A może coś więcej?
Dialogue: 0,0:03:05.03,0:03:08.20,Default,Jinshi,0,0,0,,Po odczytaniu testamentu jego\Nsynowie też nic nie rozumieją.
Dialogue: 0,0:03:08.57,0:03:12.21,Default,Maomao,0,0,0,,Przedmioty w testamencie\Nrównież się mocno różnią.
Dialogue: 0,0:03:13.76,0:03:16.81,Default,Maomao,0,0,0,,Pracownia, mebel i akwarium?
Dialogue: 0,0:03:16.81,0:03:20.22,Default,Maomao,0,0,0,,Ewidentnie najmłodszy syn\Nwyszedł na tym najgorzej.
Dialogue: 0,0:03:21.56,0:03:23.61,Default,Maomao,0,0,0,,Jak wyglądały te przedmioty?
Dialogue: 0,0:03:23.61,0:03:27.18,Default,Maomao,0,0,0,,Nie znam szczegółów. Ale...
Dialogue: 0,0:03:28.09,0:03:31.85,Default,Lakan,0,0,0,,Jeśli to ją zaintryguje,\Ntu masz adres.
Dialogue: 0,0:03:33.41,0:03:37.37,Default,Jinshi,0,0,0,,Jeśli naprawdę cię to zaciekawiło,\Ntutaj masz adres.
Dialogue: 0,0:03:40.28,0:03:41.74,Default,Maomao,0,0,0,,Dobrze się przygotował.
Dialogue: 0,0:03:42.32,0:03:46.66,Default,Maomao,0,0,0,,Zupełnie jakby się tego spodziewał.\NFascynujące.
Dialogue: 0,0:03:47.43,0:03:50.58,Default,Maomao,0,0,0,,Jeśli będę miała jutro czas...
Dialogue: 0,0:03:52.72,0:03:53.64,Default,Jinshi,0,0,0,,Taa...
Dialogue: 0,0:03:53.64,0:03:57.46,Default,Maomao,0,0,0,,Jak wrócę, to nie będę\Nwiedzieć, w co ręce włożyć.
Dialogue: 0,0:03:58.09,0:04:02.05,Default,Text,0,0,0,,{\an8}ODCINEK 16: OŁÓW
Dialogue: 0,0:04:02.92,0:04:05.15,Default,Maomao,0,0,0,,To...
Dialogue: 0,0:04:05.15,0:04:07.22,Default,Maomao,0,0,0,,Basen, prawda?
Dialogue: 0,0:04:07.56,0:04:11.34,Default,Basen,0,0,0,,Tak jak poprzednim razem,\Nmasz tylko obserwować.
Dialogue: 0,0:04:11.34,0:04:13.08,Default,Basen,0,0,0,,Nie rób niczego bez mojej zgody.
Dialogue: 0,0:04:13.72,0:04:15.10,Default,Maomao,0,0,0,,Zrozumiano.
Dialogue: 0,0:04:16.29,0:04:20.65,Default,Maomao,0,0,0,,Podobnie jak ostatnio,\Nwylewny to on nie jest.
Dialogue: 0,0:04:20.65,0:04:22.47,Default,Maomao,0,0,0,,Sądzę, że mnie nie lubi.
Dialogue: 0,0:04:23.76,0:04:26.68,Default,Maomao,0,0,0,,Dopóki nie działa\Nna moją szkodę, mam to gdzieś.
Dialogue: 0,0:04:30.92,0:04:31.95,Default,Youngest Son,0,0,0,,Proszę.
Dialogue: 0,0:04:34.07,0:04:37.67,Default,Youngest Son,0,0,0,,Panicz Basen.\NPowiadomiono nas o pańskiej wizycie.
Dialogue: 0,0:04:39.25,0:04:40.13,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:04:45.22,0:04:47.55,Default,Youngest Son,0,0,0,,Należało do mojego ojca.
Dialogue: 0,0:04:48.20,0:04:50.72,Default,Youngest Son,0,0,0,,Miał dziwne hobby,\Nzbierał nietypowe rzeczy.
Dialogue: 0,0:04:51.78,0:04:53.18,Default,Maomao,0,0,0,,Aha.
Dialogue: 0,0:04:53.92,0:04:56.70,Default,Basen,0,0,0,,Czy to jest pracownia?
Dialogue: 0,0:04:56.70,0:05:00.52,Default,Youngest Son,0,0,0,,Tak, ale obecnie pracujemy\Nw głównym budynku.
Dialogue: 0,0:05:00.91,0:05:03.69,Default,Youngest Son,0,0,0,,W pracowni obecnie\Nnajemnicy piją herbatę.
Dialogue: 0,0:05:06.13,0:05:06.91,Default,Youngest Son,0,0,0,,Wchodźcie.
Dialogue: 0,0:05:07.70,0:05:09.82,Default,Youngest Son,0,0,0,,Przyprowadziłem gości.
Dialogue: 0,0:05:10.87,0:05:11.58,Default,Eldest Son,0,0,0,,Widzę.
Dialogue: 0,0:05:11.58,0:05:13.04,Default,Second Son,0,0,0,,Dzięki za fatygę.
Dialogue: 0,0:05:13.04,0:05:18.04,Default,Maomao,0,0,0,,Zatem to są starsi bracia,\Na ten co nas przyprowadził to najmłodszy.
Dialogue: 0,0:05:18.41,0:05:20.60,Default,Basen,0,0,0,,Umeblowanie jest dość dziwne.
Dialogue: 0,0:05:21.09,0:05:21.84,Default,Basen,0,0,0,,Ej.
Dialogue: 0,0:05:22.23,0:05:23.26,Default,Maomao,0,0,0,,W rzeczy samej...
Dialogue: 0,0:05:23.26,0:05:25.97,Default,Maomao,0,0,0,,Kładzenie przedmiotów\Nna środku jest irytujące.
Dialogue: 0,0:05:26.44,0:05:29.24,Default,Maomao,0,0,0,,Niemniej jednak pomieszczenie\Nnadal nieźle się prezentuje,
Dialogue: 0,0:05:29.24,0:05:32.36,Default,Maomao,0,0,0,,najpewniej przez ten stół,\Nktóry spaja je w całość,
Dialogue: 0,0:05:32.84,0:05:34.89,Default,Maomao,0,0,0,,oraz klasycznie wyglądającej komody.
Dialogue: 0,0:05:38.95,0:05:42.27,Default,Maomao,0,0,0,,Rogi pokryte są metalowymi zdobieniami.
Dialogue: 0,0:05:42.27,0:05:46.91,Default,Maomao,0,0,0,,Trzy górne szuflady i jedna\Nśrodkowa mają dziurki na klucze.
Dialogue: 0,0:05:46.91,0:05:50.33,Default,Maomao,0,0,0,,Jednak kolor metalu jest\Nzupełnie inny niż na pozostałych...
Dialogue: 0,0:05:52.70,0:05:55.25,Default,Maomao,0,0,0,,Przykręcono ją na stałe?
Dialogue: 0,0:05:55.25,0:05:57.29,Default,Second Son,0,0,0,,Ej, to moje.
Dialogue: 0,0:05:57.72,0:06:00.54,Default,Second Son,0,0,0,,Możesz patrzeć, ale nie dotykać.
Dialogue: 0,0:06:01.57,0:06:05.05,Default,Maomao,0,0,0,,Racja, drugi syn otrzymał\Nmebel na pamiątkę.
Dialogue: 0,0:06:06.54,0:06:09.26,Default,Maomao,0,0,0,,Skoro ta komoda jest wspomnianym\Nmeblem,
Dialogue: 0,0:06:09.26,0:06:11.42,Default,Maomao,0,0,0,,to znaczy, że jest to drugi syn.
Dialogue: 0,0:06:12.55,0:06:16.68,Default,Maomao,0,0,0,,A ten wysoki, stojący\Nprzy ścianie jest najstarszy.
Dialogue: 0,0:06:20.00,0:06:22.75,Default,Maomao,0,0,0,,Umiejscowienie okien też jest dziwne.
Dialogue: 0,0:06:22.75,0:06:25.52,Default,Maomao,0,0,0,,W zachodnim stylu i zaskakująco wysoko.
Dialogue: 0,0:06:25.52,0:06:28.16,Default,Maomao,0,0,0,,Chociaż do środka wpada\Ndużo światła słonecznego,
Dialogue: 0,0:06:28.16,0:06:31.99,Default,Maomao,0,0,0,,ogromny kasztanowiec\Nznacznie je ogranicza.
Dialogue: 0,0:06:32.83,0:06:35.42,Default,Maomao,0,0,0,,Ostatecznie wpada tu\Nbardzo mało światła.
Dialogue: 0,0:06:35.42,0:06:38.46,Default,Maomao,0,0,0,,I to jedyne miejsce,\Ngdzie słońce może wpadać.
Dialogue: 0,0:06:40.87,0:06:44.46,Default,Maomao,0,0,0,,Ten ślad. Coś tu musiało\Nchyba długo stać.
Dialogue: 0,0:06:44.46,0:06:48.47,Default,Eldest Son,0,0,0,,Naprawdę potrafisz odgadnąć,\Nco nasz ojciec nam zostawił?
Dialogue: 0,0:06:49.05,0:06:50.49,Default,Basen,0,0,0,,To...
Dialogue: 0,0:06:56.91,0:07:00.77,Default,Basen,0,0,0,,Żebyśmy mogli poznać odpowiedź,\Nmusisz udzielać dokładniejszych odpowiedzi.
Dialogue: 0,0:07:02.05,0:07:04.49,Default,Eldest Son,0,0,0,,Jest tak, jak słyszałeś.
Dialogue: 0,0:07:04.49,0:07:08.17,Default,Eldest Son,0,0,0,,Ojciec odszedł nie przekazując\Nnam swojej sekretnej techniki.
Dialogue: 0,0:07:08.17,0:07:11.66,Default,Eldest Son,0,0,0,,Jedyne, co mi zostawił,\Nto tę ruderę.
Dialogue: 0,0:07:11.66,0:07:14.31,Default,Second Son,0,0,0,,A mnie tę komodę z szufladami.
Dialogue: 0,0:07:15.16,0:07:17.95,Default,Youngest Son,0,0,0,,Ja dostałem to.
Dialogue: 0,0:07:17.95,0:07:20.08,Default,Maomao,0,0,0,,Szklany więc drogi.
Dialogue: 0,0:07:20.08,0:07:24.25,Default,Maomao,0,0,0,,Myślałam, że będzie drewniane\Nalbo co najwyżej ceramiczne.
Dialogue: 0,0:07:24.25,0:07:29.38,Default,Maomao,0,0,0,,Chyba wszystkie pamiątki\Nmają jakąś wartość.
Dialogue: 0,0:07:30.88,0:07:34.38,Default,Second Son,0,0,0,,Coś ty sobie myślał, staruchu?
Dialogue: 0,0:07:34.38,0:07:39.48,Default,Second Son,0,0,0,,Dzięki za ten prezent, ale mam klucz,\Nktóry nie pasuje do zamka.
Dialogue: 0,0:07:39.99,0:07:41.64,Default,Basen,0,0,0,,Klucz nie pasuje?
Dialogue: 0,0:07:41.64,0:07:46.69,Default,Second Son,0,0,0,,Pewnie to klucz do środkowej szuflady,\Nale nie pasuje do zamka.
Dialogue: 0,0:07:47.11,0:07:51.05,Default,Second Son,0,0,0,,Górne trzy szuflady zamykane\Nsą na ten sam klucz,
Dialogue: 0,0:07:51.67,0:07:54.35,Default,Second Son,0,0,0,,ale nigdzie go nie ma.
Dialogue: 0,0:07:54.35,0:07:56.70,Default,Second Son,0,0,0,,Jaki sens jest to dziedziczyć?
Dialogue: 0,0:07:57.64,0:08:03.39,Default,Eldest Son,0,0,0,,Mam tak samo. Jaki jest sens posiadania\Npracowni, jeśli nie mogę jej sprzedać?
Dialogue: 0,0:08:03.39,0:08:05.15,Default,Eldest Son,0,0,0,,To jest problem.
Dialogue: 0,0:08:05.15,0:08:06.41,Default,Youngest Son,0,0,0,,Ojciec pewnie...
Dialogue: 0,0:08:07.43,0:08:10.34,Default,Youngest Son,0,0,0,,Ojciec pewnie myślał...
Dialogue: 0,0:08:10.34,0:08:15.37,Default,Eldest Son,0,0,0,,Szczerze ci zazdroszczę.\NMasz coś, co możesz łatwo sprzedać.
Dialogue: 0,0:08:15.37,0:08:20.64,Default,Second Son,0,0,0,,Co prawda to niewiele,\Nale i tak wystarczyłoby na jakiś czas.
Dialogue: 0,0:08:21.11,0:08:23.35,Default,Eldest Son,0,0,0,,W ogóle nie rozumiem ojca.
Dialogue: 0,0:08:23.35,0:08:27.11,Default,Second Son,0,0,0,,Co da nam picie jakichś\Npopołudniowych herbatek?
Dialogue: 0,0:08:29.60,0:08:31.76,Default,Maomao,0,0,0,,Co powinniśmy teraz zrobić?
Dialogue: 0,0:08:31.76,0:08:36.50,Default,Maomao,0,0,0,,Najstarsi bracia nie pałają zbyt\Nwielką miłością do najmłodszego.
Dialogue: 0,0:08:37.12,0:08:39.45,Default,Mother,0,0,0,,Przestańcie!
Dialogue: 0,0:08:39.45,0:08:42.44,Default,Mother,0,0,0,,Nie można się tak\Nzachowywać przy gościach.
Dialogue: 0,0:08:42.84,0:08:46.96,Default,Mother,0,0,0,,Przepraszam. Nie mam pojęcia,\Nkiedy zaczęli się tak zachowywać.
Dialogue: 0,0:08:46.96,0:08:50.00,Default,Mother,0,0,0,,Dwójka najstarszych\Nstała się bardzo cyniczna.
Dialogue: 0,0:08:50.55,0:08:53.01,Default,Mother,0,0,0,,A najmłodszy nie ma\Nnawet własnego zdania.
Dialogue: 0,0:08:53.01,0:08:58.51,Default,Mother,0,0,0,,Mój mąż martwił się\No nich aż do śmierci.
Dialogue: 0,0:08:59.68,0:09:01.37,Default,Maomao,0,0,0,,Martwienie się o swoje dzieci,
Dialogue: 0,0:09:01.37,0:09:04.81,Default,Maomao,0,0,0,,niezależnie od ich wieku,\Njest nieodłączną częścią rodzicielstwa.
Dialogue: 0,0:09:07.52,0:09:10.28,Default,Mother,0,0,0,,Proszę, herbatka. Przepraszam.
Dialogue: 0,0:09:16.45,0:09:21.87,Default,Maomao,0,0,0,,Wszyscy się poruszyli. Zgaduję,\Nże każdy z nich ma swoje miejsce.
Dialogue: 0,0:09:22.71,0:09:26.36,Default,Maomao,0,0,0,,Pewnie z przyzwyczajenia,\Nżeby nie zasłaniać okna.
Dialogue: 0,0:09:26.36,0:09:29.88,Default,Maomao,0,0,0,,O tej porze dnia promienie\Nsłoneczne wpadają przez okno.
Dialogue: 0,0:09:30.22,0:09:34.01,Default,Maomao,0,0,0,,Jeżeli promienie słoneczne dotarłyby\Nnieco dalej, mogłyby trafić w komodę...
Dialogue: 0,0:09:34.01,0:09:36.38,Default,Maomao,0,0,0,,Ale na komodzie nie ma\Nwyblakłych śladów.
Dialogue: 0,0:09:37.73,0:09:39.10,Default,Maomao,0,0,0,,Wyblakłe ślady?
Dialogue: 0,0:09:40.96,0:09:41.97,Default,Basen,0,0,0,,Ej.
Dialogue: 0,0:09:45.76,0:09:49.06,Default,Maomao,0,0,0,,Przez drzewo promienie\Nnie padają tutaj zbyt długo.
Dialogue: 0,0:10:01.17,0:10:03.20,Default,Maomao,0,0,0,,Coś jest w środku?
Dialogue: 0,0:10:03.20,0:10:05.03,Default,Basen,0,0,0,,Udało ci się coś ustalić?
Dialogue: 0,0:10:05.66,0:10:09.37,Default,Maomao,0,0,0,,Wiedziałam, że kogoś mi przypomina.
Dialogue: 0,0:10:09.37,0:10:12.21,Default,Maomao,0,0,0,,Wygląda jak Gaoshun!
Dialogue: 0,0:10:15.43,0:10:16.57,Default,Basen,0,0,0,,A więc?
Dialogue: 0,0:10:17.56,0:10:21.04,Default,Maomao,0,0,0,,Środkowa szuflada się\Nnie otwiera, prawda?
Dialogue: 0,0:10:21.04,0:10:26.95,Default,Maomao,0,0,0,,Dawniej działała, ale chyba zacięła się\Npo tym, jak tata przy niej majstrował.
Dialogue: 0,0:10:27.56,0:10:28.98,Default,Maomao,0,0,0,,I jest tylko jeden klucz?
Dialogue: 0,0:10:29.42,0:10:31.16,Default,Second Son,0,0,0,,Tylko ten.
Dialogue: 0,0:10:31.16,0:10:36.02,Default,Second Son,0,0,0,,Ojciec powiedział, że jeśli uszkodzimy\Nzamek, to zniszczymy to, co jest w środku.
Dialogue: 0,0:10:36.60,0:10:38.97,Default,Second Son,0,0,0,,Więc siłą też tu nic nie zdziałamy.
Dialogue: 0,0:10:41.00,0:10:44.63,Default,Maomao,0,0,0,,Pamiątki darowane poszczególnym synom.
Dialogue: 0,0:10:44.63,0:10:48.14,Default,Maomao,0,0,0,,Pracownia, komoda i akwarium.
Dialogue: 0,0:10:48.66,0:10:51.23,Default,Maomao,0,0,0,,Komoda przykręcona do podłogi w pracowni.
Dialogue: 0,0:10:51.23,0:10:53.32,Default,Maomao,0,0,0,,Z szufladami, których nie można otworzyć.
Dialogue: 0,0:10:53.83,0:10:54.71,Default,Maomao,0,0,0,,I...
Dialogue: 0,0:10:55.57,0:10:58.76,Default,Jinshi,0,0,0,,„Mam nadzieję, że spotkacie się\Nna herbatce jak dawniej”.
Dialogue: 0,0:11:02.69,0:11:04.01,Default,Maomao,0,0,0,,Czy może to być...
Dialogue: 0,0:11:11.37,0:11:17.15,Default,Maomao,0,0,0,,Przepraszam. Czy akwarium\Nstało wcześniej na tej szafce?
Dialogue: 0,0:11:17.15,0:11:19.94,Default,Youngest Son,0,0,0,,Co? Tak.
Dialogue: 0,0:11:19.94,0:11:23.38,Default,Youngest Son,0,0,0,,Kiedyś trzymaliśmy w nim złotą rybką.
Dialogue: 0,0:11:24.10,0:11:25.95,Default,Youngest Son,0,0,0,,Zimą było dla niej za zimno,
Dialogue: 0,0:11:26.50,0:11:30.03,Default,Youngest Son,0,0,0,,więc stawialiśmy ją tu zawsze\Npodczas spotkań przy herbacie.
Dialogue: 0,0:11:30.03,0:11:31.96,Default,Youngest Son,0,0,0,,O podobnej porze co dziś.
Dialogue: 0,0:11:32.42,0:11:37.96,Default,Youngest Son,0,0,0,,Jednak od kilku lat nie\Nmieliśmy żadnej złotej rybki.
Dialogue: 0,0:11:41.11,0:11:42.49,Default,Basen,0,0,0,,Ej!
Dialogue: 0,0:11:42.49,0:11:45.19,Default,Maomao,0,0,0,,Idę poprosić o trochę wody.
Dialogue: 0,0:11:45.19,0:11:47.93,Default,Basen,0,0,0,,Znowu robi, co chce!
Dialogue: 0,0:11:53.19,0:11:56.19,Default,Maomao,0,0,0,,Napełnione było tak jak teraz?
Dialogue: 0,0:11:56.59,0:12:00.61,Default,Youngest Son,0,0,0,,Tak. A wzór skierowany\Nbył w ten sposób.
Dialogue: 0,0:12:04.16,0:12:04.95,Default,Maomao,0,0,0,,Wiedziałam.
Dialogue: 0,0:12:05.95,0:12:07.41,Default,Second Son,0,0,0,,Hej! Co to jest?!
Dialogue: 0,0:12:10.62,0:12:11.33,Default,Maomao,0,0,0,,Zostaw to!
Dialogue: 0,0:12:12.77,0:12:16.62,Default,Maomao,0,0,0,,Przepraszam. Oślepnąłbyś,\Ngdyby światło padłoby na twoje oczy.
Dialogue: 0,0:12:16.62,0:12:18.92,Default,Maomao,0,0,0,,Poza tym, proszę się cofnąć,\Nbo blokujesz drogę.
Dialogue: 0,0:12:18.92,0:12:20.63,Default,Maomao,0,0,0,,I nie damy rady zwolnić blokady.
Dialogue: 0,0:12:33.94,0:12:36.48,Default,Maomao,0,0,0,,Wygląda na to,\Nże kasztanowiec rzuca teraz cień.
Dialogue: 0,0:12:39.46,0:12:42.11,Default,Maomao,0,0,0,,Jest gorący i czuć dziwny zapach.
Dialogue: 0,0:12:42.11,0:12:44.62,Default,Second Son,0,0,0,,Ej, co to wszystko ma znaczyć?!
Dialogue: 0,0:12:44.62,0:12:48.37,Default,Maomao,0,0,0,,Proszę, otwórz szufladę tym kluczem.
Dialogue: 0,0:12:48.79,0:12:51.47,Default,Second Son,0,0,0,,Mówiłem już, że nie pasuje.
Dialogue: 0,0:12:51.47,0:12:52.37,Default,Maomao,0,0,0,,Śmiało.
Dialogue: 0,0:12:58.16,0:12:59.99,Default,Second Son,0,0,0,,Co jest grane?!
Dialogue: 0,0:13:01.01,0:13:05.93,Default,Maomao,0,0,0,,Czy wasz ojciec cierpiał\Nna anemię i miewał bóle brzucha?
Dialogue: 0,0:13:06.95,0:13:08.60,Default,Youngest Child,0,0,0,,Tak, zgadza się.
Dialogue: 0,0:13:08.89,0:13:11.60,Default,Maomao,0,0,0,,Miewał nudności i był smutny?
Dialogue: 0,0:13:11.60,0:13:12.81,Default,Youngest Child,0,0,0,,Też.
Dialogue: 0,0:13:13.44,0:13:16.85,Default,Maomao,0,0,0,,Nie znam się na metalurgii,
Dialogue: 0,0:13:17.88,0:13:20.51,Default,Maomao,0,0,0,,ale czy używał stopu ołowiu i cyny?
Dialogue: 0,0:13:20.51,0:13:21.86,Default,Youngest Child,0,0,0,,Tak, to prawda.
Dialogue: 0,0:13:22.39,0:13:23.74,Default,Basen,0,0,0,,Co to znaczy?
Dialogue: 0,0:13:23.74,0:13:30.70,Default,Maomao,0,0,0,,Po prostu postąpiłam zgodnie z wolą\Nzmarłego. Tak jak kiedyś piliście herbatkę.
Dialogue: 0,0:13:33.55,0:13:37.74,Default,Maomao,0,0,0,,Forma do odlewu. Mogę wyjąć klucz?
Dialogue: 0,0:13:37.74,0:13:38.92,Default,Second Son,0,0,0,,J-jasne.
Dialogue: 0,0:13:39.40,0:13:42.86,Default,Maomao,0,0,0,,Jest jeszcze ciepły i miękki.
Dialogue: 0,0:13:43.38,0:13:47.07,Default,Maomao,0,0,0,,Metal, który tkwił w dziurce od\Nklucza, stopił się pod wpływem ciepła
Dialogue: 0,0:13:47.07,0:13:49.91,Default,Maomao,0,0,0,,i spłynął do znajdującej się pod nim formy.
Dialogue: 0,0:13:58.81,0:13:59.77,Default,Second Son,0,0,0,,Otworzyło się!
Dialogue: 0,0:13:59.77,0:14:00.65,Default,Eldest Son,0,0,0,,Co jest w środku?
Dialogue: 0,0:14:02.98,0:14:04.11,Default,Second Son,0,0,0,,Co to ma być?!
Dialogue: 0,0:14:04.64,0:14:10.78,Default,Maomao,0,0,0,,Wygląda jak ta ruda,\Nktórą widziałam przy wejściu.
Dialogue: 0,0:14:11.13,0:14:14.97,Default,Second Son,0,0,0,,Cholera! To miał być jego\Nsposób, byśmy się dogadali?
Dialogue: 0,0:14:14.97,0:14:18.51,Default,Second Son,0,0,0,,Nawet po śmierci z nas zakpił!
Dialogue: 0,0:14:18.51,0:14:19.75,Default,Eldest Son,0,0,0,,To jest problem!
Dialogue: 0,0:14:20.29,0:14:22.41,Default,Youngest Son,0,0,0,,Ołów i cyna?
Dialogue: 0,0:14:23.84,0:14:28.88,Default,Maomao,0,0,0,,Znałam rzemieślnika, który twierdził,\Nże techniki należy obserwować i podkradać.
Dialogue: 0,0:14:29.64,0:14:34.80,Default,Maomao,0,0,0,,Sama też brałam to na serio i próbowałam\Ntworzyć własne leki wzorując się na tacie.
Dialogue: 0,0:14:34.80,0:14:36.70,Default,Maomao,0,0,0,,Skończyło się na zatruciu i...
Dialogue: 0,0:14:36.70,0:14:38.85,Default,Luomen,0,0,0,,Trzeba było zapytać.
Dialogue: 0,0:14:38.85,0:14:41.15,Default,Maomao,0,0,0,,To była lekcja, jaką mi dał.
Dialogue: 0,0:14:41.49,0:14:46.15,Default,Maomao,0,0,0,,Wygląda na to, że tylko najmłodszy\Nsyn zrozumiał zamysł zmarłego ojca.
Dialogue: 0,0:14:46.85,0:14:50.67,Default,Maomao,0,0,0,,Podobno dzięki zmieszaniu ze sobą\Nkilku różnych rodzajów metali,
Dialogue: 0,0:14:50.67,0:14:54.82,Default,Maomao,0,0,0,,powstaje stop topiący się w niższej\Ntemperaturze niż pozostałe metale.
Dialogue: 0,0:14:55.38,0:14:58.84,Default,Maomao,0,0,0,,Dwie z trzech brył to ołów i cyna.
Dialogue: 0,0:14:58.84,0:15:05.17,Default,Maomao,0,0,0,,W połączeniu z trzecią\Npowstaje całkiem nowy stop.
Dialogue: 0,0:15:05.86,0:15:09.67,Default,Maomao,0,0,0,,Chociaż szklane akwarium\Nskoncentrowało ciepło,
Dialogue: 0,0:15:09.67,0:15:12.75,Default,Maomao,0,0,0,,to jednak nie trwało to długo.
Dialogue: 0,0:15:12.75,0:15:15.68,Default,Maomao,0,0,0,,Więc temperatura topnienia\Ntego stopu jest dość niska.
Dialogue: 0,0:15:16.47,0:15:18.86,Default,Maomao,0,0,0,,Różne szuflady\Nmogą odpowiadać proporcjom,
Dialogue: 0,0:15:18.86,0:15:21.19,Default,Maomao,0,0,0,,w jakich metale powinny być mieszane,
Dialogue: 0,0:15:22.02,0:15:24.94,Default,Maomao,0,0,0,,ale tego chyba nie muszę dodawać.
Dialogue: 0,0:15:25.59,0:15:27.69,Default,Eldest Son,0,0,0,,Co on sobie myślał? Chodźmy stąd.
Dialogue: 0,0:15:28.29,0:15:30.40,Default,Second Son,0,0,0,,To strata czasu.
Dialogue: 0,0:15:31.40,0:15:32.78,Default,Youngest Son,0,0,0,,Czekajcie!
Dialogue: 0,0:15:34.04,0:15:36.03,Default,Youngest Son,0,0,0,,To nie jest żart.
Dialogue: 0,0:15:36.03,0:15:38.50,Default,Eldest Son,0,0,0,,Więc co to jest?!
Dialogue: 0,0:15:38.80,0:15:44.95,Default,Youngest Son,0,0,0,,Ojciec naprawdę chciał, żeby\Nnasza trójka znów się dogadywała!
Dialogue: 0,0:15:46.63,0:15:52.97,Default,Youngest Son,0,0,0,,Dlatego uważam, że nasza trójka\Npowinna dalej ze sobą współpracować!
Dialogue: 0,0:15:58.10,0:16:00.52,Default,Eldest Son,0,0,0,,Razem? Nasza trójka?
Dialogue: 0,0:16:01.59,0:16:05.94,Default,Eldest Son,0,0,0,,To jakiś absurd.\NZa bardzo się różnimy.
Dialogue: 0,0:16:05.94,0:16:11.40,Default,Second Son,0,0,0,,Ty masz do tego smykałkę.\NOjcu zależało tylko na tobie.
Dialogue: 0,0:16:11.40,0:16:14.32,Default,Youngest Son,0,0,0,,To nieprawda!
Dialogue: 0,0:16:14.32,0:16:17.78,Default,Youngest Son,0,0,0,,Ojciec zawsze wam ufał!
Dialogue: 0,0:16:18.48,0:16:20.54,Default,Youngest Son,0,0,0,,Zawsze mi powtarzał...
Dialogue: 0,0:16:21.24,0:16:26.08,Default,Youngest Son,0,0,0,,Chang, zawsze jesteś opanowany\Ni dokładny przy tym, co robisz.
Dialogue: 0,0:16:26.08,0:16:29.00,Default,Youngest Son,0,0,0,,Mówił, że może na tobie polegać,\Nbo nie robisz błędów!
Dialogue: 0,0:16:29.59,0:16:32.34,Default,Youngest Son,0,0,0,,Tzu, ty za to świetnie\Numiesz dogadać się z ludźmi.
Dialogue: 0,0:16:33.88,0:16:39.06,Default,Youngest Son,0,0,0,,Mówił, że powinieneś być dumny z tego,\Nże potrafisz zaprzyjaźnić się z każdym!
Dialogue: 0,0:16:40.32,0:16:45.62,Default,Youngest Son,0,0,0,,Ojciec traktował naszą trójkę tak samo.
Dialogue: 0,0:16:52.77,0:16:55.57,Default,Youngest Son,0,0,0,,Tak mi się przynajmniej wydaje.
Dialogue: 0,0:16:58.93,0:16:59.85,Default,Basen,0,0,0,,Przepraszam.
Dialogue: 0,0:16:59.85,0:17:01.66,Default,Youngest Son,0,0,0,,A, przepraszam.
Dialogue: 0,0:17:02.96,0:17:07.88,Default,Maomao,0,0,0,,Ojciec... Właściwie nie mam\Nz tym nic wspólnego.
Dialogue: 0,0:17:08.84,0:17:10.46,Default,Youngest Son,0,0,0,,Dziękujemy.
Dialogue: 0,0:17:11.11,0:17:13.77,Default,Maomao,0,0,0,,Powinnam mu jednak\Npowiedzieć jedną rzecz.
Dialogue: 0,0:17:14.20,0:17:15.35,Default,Basen,0,0,0,,Ej.
Dialogue: 0,0:17:17.54,0:17:20.06,Default,Maomao,0,0,0,,W Grynszpanowym Pawilonie\Nw dzielnicy uciech,
Dialogue: 0,0:17:20.06,0:17:22.46,Default,Maomao,0,0,0,,pracuje zielarz, imieniem Luomen.
Dialogue: 0,0:17:22.46,0:17:24.67,Default,Maomao,0,0,0,,Jest także świetnym medykiem.
Dialogue: 0,0:17:24.67,0:17:28.18,Default,Maomao,0,0,0,,Skontaktuj się z nim,\Njeśli będzie ci coś dolegać.
Dialogue: 0,0:17:28.18,0:17:29.66,Default,Youngest Son,0,0,0,,J-jasne.
Dialogue: 0,0:17:44.33,0:17:46.66,Default,Lakan,0,0,0,,Podziękować za kolejny dzionek.
Dialogue: 0,0:17:46.66,0:17:50.76,Default,Lakan,0,0,0,,Był on naprawdę interesujący.
Dialogue: 0,0:17:50.76,0:17:56.42,Default,Lakan,0,0,0,,Ostatecznie najmłodszy syn\Nokazał się tym najzdolniejszym.
Dialogue: 0,0:17:57.25,0:18:00.22,Default,Jinshi,0,0,0,,Zapewne wiedział o tym\Nod samego początku.
Dialogue: 0,0:18:00.22,0:18:05.39,Default,Lakan,0,0,0,,Zaczął nagle ujawniać swoje talenty.
Dialogue: 0,0:18:05.39,0:18:09.94,Default,Lakan,0,0,0,,Chodzą słuchy, że całkiem niedługo może\Notrzymać zlecenie z cesarskiego pałacu.
Dialogue: 0,0:18:11.03,0:18:16.53,Default,Lakan,0,0,0,,Pozostała dwójka odpuściła\Nsobie jednak tę branżę.
Dialogue: 0,0:18:17.41,0:18:18.56,Default,Jinshi,0,0,0,,Czy to z...
Dialogue: 0,0:18:18.56,0:18:21.98,Default,Lakan,0,0,0,,A skąd. Nie jest tak źle.
Dialogue: 0,0:18:21.98,0:18:26.75,Default,Lakan,0,0,0,,Możliwe, że zrozumieli, co ich\Nzmarły ojciec chciał im przekazać.
Dialogue: 0,0:18:27.27,0:18:29.50,Default,Lakan,0,0,0,,Najstarszy zajął się finansami.
Dialogue: 0,0:18:29.97,0:18:32.17,Default,Lakan,0,0,0,,Drugi zajmie się\Nzdobywaniem nowych klientów.
Dialogue: 0,0:18:32.68,0:18:37.59,Default,Lakan,0,0,0,,Obaj pomogą rodzinie\Nw odmienny sposób.
Dialogue: 0,0:18:38.01,0:18:43.06,Default,Lakan,0,0,0,,Krótko mówiąc,\Nkażdy z nich znalazł swoje miejsce.
Dialogue: 0,0:18:45.42,0:18:48.12,Default,Jinshi,0,0,0,,Nie wiem, co się tam wydarzyło.
Dialogue: 0,0:18:48.65,0:18:52.86,Default,Jinshi,0,0,0,,Zielareczka na pewno dobrze wie,\Nale milczy jak zaklęta.
Dialogue: 0,0:18:52.86,0:18:56.86,Default,Lakan,0,0,0,,Dzieła zmarłego rzemieślnika\Nbyły doprawdy wspaniałe.
Dialogue: 0,0:18:57.49,0:19:04.62,Default,Lakan,0,0,0,,Niby najzwyklejszy kawałek metalu, ale na\Nrytualnym przedmiocie wyglądał bajecznie.
Dialogue: 0,0:19:06.55,0:19:08.00,Default,Jinshi,0,0,0,,Nie da się zaprzeczyć.
Dialogue: 0,0:19:08.49,0:19:10.55,Default,Jinshi,0,0,0,,Ale wkurzający typek.
Dialogue: 0,0:19:10.55,0:19:15.25,Default,Jinshi,0,0,0,,Doskonale wie, że nie mam nic\Nwspólnego z żadnymi rytuałami.
Dialogue: 0,0:19:15.52,0:19:17.29,Default,Jinshi,0,0,0,,Czemu takiego generała ciekawią...
Dialogue: 0,0:19:17.29,0:19:23.88,Default,Lakan,0,0,0,,Po prostu nie chciałem, by się\Nzmarnował taki wspaniały talent.
Dialogue: 0,0:19:23.88,0:19:25.60,Default,Lakan,0,0,0,,Bez względu na wiek braci.
Dialogue: 0,0:19:26.03,0:19:30.31,Default,Lakan,0,0,0,,Osoby z talentem powinny się rozwijać.
Dialogue: 0,0:19:32.28,0:19:35.96,Default,Jinshi,0,0,0,,I ma rację.\NMoże i Lakan jest cwanym facetem,
Dialogue: 0,0:19:35.96,0:19:38.28,Default,Jinshi,0,0,0,,ale bez wątpienia zna się na ludziach.
Dialogue: 0,0:19:38.78,0:19:42.82,Default,Jinshi,0,0,0,,I to właśnie ta umiejętność\Ndoprowadziła go do obecnej pozycji.
Dialogue: 0,0:19:44.37,0:19:45.58,Default,Jinshi,0,0,0,,Swoją drogą...
Dialogue: 0,0:19:46.29,0:19:49.06,Default,Jinshi,0,0,0,,Chciałbym usłyszeć resztę tej historii.
Dialogue: 0,0:19:49.70,0:19:51.71,Default,Lakan,0,0,0,,Jakiej historii?
Dialogue: 0,0:19:53.08,0:19:56.04,Default,Jinshi,0,0,0,,Tej o tamtej kurtyzanie.
Dialogue: 0,0:19:56.44,0:20:00.84,Default,Lakan,0,0,0,,A, tak! Sposób na obniżenie\Nwartości damy do towarzystwa.
Dialogue: 0,0:20:03.16,0:20:08.10,Default,Lakan,0,0,0,,Najlepiej zapytać kogoś,\Nkto zna ten świat.
Dialogue: 0,0:20:10.60,0:20:12.96,Default,Lakan,0,0,0,,Ale się już późno zrobiło!
Dialogue: 0,0:20:12.96,0:20:15.83,Default,Lakan,0,0,0,,Jeżeli zostanę dłużej,\Nmoi podwładni mnie zbesztają.
Dialogue: 0,0:20:20.90,0:20:25.40,Default,Lakan,0,0,0,,Przekaż to swojej pokojówce.
Dialogue: 0,0:20:25.40,0:20:28.91,Default,Lakan,0,0,0,,Doskonały napój, nie za słodki.
Dialogue: 0,0:20:28.91,0:20:31.58,Default,Lakan,0,0,0,,Do zobaczenia jutro.
Dialogue: 0,0:20:37.93,0:20:39.32,Default,Gaoshun,0,0,0,,Panie Jinshi.
Dialogue: 0,0:20:39.32,0:20:40.63,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:20:41.51,0:20:43.59,Default,Gaoshun,0,0,0,,Przepraszam, że cię męczę, ale...
Dialogue: 0,0:20:48.36,0:20:49.69,Default,Maomao,0,0,0,,W czym mogę pomóc?
Dialogue: 0,0:20:50.32,0:20:52.77,Default,Jinshi,0,0,0,,Znasz się na makijażu?
Dialogue: 0,0:20:53.19,0:20:56.81,Default,Maomao,0,0,0,,Tak tylko troszeczkę.
Dialogue: 0,0:20:56.81,0:20:58.35,Default,Jinshi,0,0,0,,W takim razie...
Dialogue: 0,0:20:58.35,0:21:00.61,Default,Jinshi,0,0,0,,Może mi go zrobisz?
Dialogue: 0,0:21:03.51,0:21:04.44,Default,Maomao,0,0,0,,Słucham?
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.52,0:22:50.05,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Wycieczka po mieście”.
Dialogue: 0,0:22:46.59,0:22:50.05,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
