Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:31.52,0:01:34.49,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:33.49,0:01:35.81,Default,Hongniang,0,0,0,,Maomao, przedstawię cię.
Dialogue: 0,0:01:35.81,0:01:38.65,Default,Hongniang,0,0,0,,To nowe dwórki,\Nktóre dołączyły do Jadeitowego Pałacu.
Dialogue: 0,0:01:38.65,0:01:39.91,Default,Hongniang,0,0,0,,To siostry.
Dialogue: 0,0:01:40.75,0:01:42.20,Default,Haku-u,0,0,0,,Jestem Haku.
Dialogue: 0,0:01:42.20,0:01:43.61,Default,Koku-u,0,0,0,,A ja Koku.
Dialogue: 0,0:01:43.61,0:01:44.66,Default,Seki-u,0,0,0,,A ja Sekiu.
Dialogue: 0,0:01:45.24,0:01:47.16,italics,Maomao,0,0,0,,Wyglądają tak samo.
Dialogue: 0,0:01:47.99,0:01:49.76,Default,Haku-u,0,0,0,,Wszystko w porządku?
Dialogue: 0,0:01:49.76,0:01:51.71,Default,Ailan,0,0,0,,Tak, dawno się nie widziałyśmy.
Dialogue: 0,0:01:53.17,0:01:54.72,Default,Maomao,0,0,0,,Znacie się?
Dialogue: 0,0:01:54.72,0:01:58.08,Default,Yinghua,0,0,0,,Tak, wszystkie pochodzimy\Nz tego samego miasta.
Dialogue: 0,0:01:58.08,0:02:01.72,Default,Yinghua,0,0,0,,Najstarsza, Haku, jest w tym\Nsamym wieku co pani Gyokuyou.
Dialogue: 0,0:02:02.86,0:02:06.06,italics,Maomao,0,0,0,,Zawężanie personelu do osób\Nz rodzinnego miasta.
Dialogue: 0,0:02:06.06,0:02:09.04,italics,Maomao,0,0,0,,To bardzo bezpieczne\Nposunięcie ze strony pani Gyokuyou,
Dialogue: 0,0:02:09.04,0:02:10.98,italics,Maomao,0,0,0,,która prawie została już zamordowana.
Dialogue: 0,0:02:11.63,0:02:12.67,Default,Haku-u,0,0,0,,A ty?
Dialogue: 0,0:02:13.21,0:02:15.82,Default,Maomao,0,0,0,,Jestem Maomao,\Ntesterka, pani Koku.
Dialogue: 0,0:02:16.45,0:02:18.74,Default,Haku-u,0,0,0,,Nie jestem Koku.
Dialogue: 0,0:02:18.74,0:02:21.37,Default,Maomao,0,0,0,,Co? To pani Sekiu?
Dialogue: 0,0:02:21.76,0:02:22.83,Default,Haku-u,0,0,0,,Jestem Haku.
Dialogue: 0,0:02:27.51,0:02:31.42,Default,Haku-u,0,0,0,,Od dziś każda z nas będzie nosić opaskę\Ndo włosów w kolorze zgodnym z imieniem,
Dialogue: 0,0:02:31.42,0:02:32.82,Default,Haku-u,0,0,0,,byś mogła nas rozpoznać.
Dialogue: 0,0:02:32.82,0:02:34.38,Default,Maomao,0,0,0,,Zrozumiano.
Dialogue: 0,0:02:35.35,0:02:37.66,italics,Maomao,0,0,0,,Nie umiem ich odróżnić.
Dialogue: 0,0:02:38.16,0:02:40.64,italics,Maomao,0,0,0,,Na naukę będę miała sporo czasu.
Dialogue: 0,0:02:41.49,0:02:43.68,italics,Maomao,0,0,0,,Co ważniejsze, sprawa jest...
Dialogue: 0,0:02:43.68,0:02:46.97,Default,Yinghua,0,0,0,,Maomao! Wracaj już do siebie!
Dialogue: 0,0:02:47.24,0:02:49.98,Default,Maomao,0,0,0,,Podziękuję, wolę obecną miejscówkę.
Dialogue: 0,0:02:49.98,0:02:53.08,Default,Maomao,0,0,0,,Poza tym pani Hongniang\Npowiedziała, że to jest teraz mój pokój.
Dialogue: 0,0:02:53.08,0:02:55.44,Default,Maomao,0,0,0,,Więc zostaje tutaj!
Dialogue: 0,0:02:55.44,0:02:57.37,Default,Yinghua,0,0,0,,Nie pozwolę na to!
Dialogue: 0,0:02:57.37,0:02:59.69,Default,Yinghua,0,0,0,,Żart wszedł ci za mocno do głowy!
Dialogue: 0,0:03:00.67,0:03:04.66,Default,Maomao,0,0,0,,Wszystko już przeniosłam tutaj...
Dialogue: 0,0:03:04.66,0:03:08.16,Default,Yinghua,0,0,0,,Dajesz zły przykład nowym dwórkom!
Dialogue: 0,0:03:11.25,0:03:14.08,Default,Hongniang,0,0,0,,Co wasza dwójka odwala?!
Dialogue: 0,0:03:26.01,0:03:29.98,Default,Text,0,0,0,,{\an8}ODCINEK 34: OPOWIEŚCI O DUCHACH
Dialogue: 0,0:03:26.06,0:03:30.31,Default,Gyokuyou,0,0,0,,Więc teraz Maomao mieszka w szopie?
Dialogue: 0,0:03:31.13,0:03:33.06,Default,Gyokuyou,0,0,0,,Zrób z nim, co chcesz.
Dialogue: 0,0:03:33.84,0:03:37.47,Default,Hongniang,0,0,0,,Ale chciałabym, byś wróciła\Ndo poprzedniego pokoju.
Dialogue: 0,0:03:38.02,0:03:39.03,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:03:40.44,0:03:42.45,italics,Maomao,0,0,0,,To dobre szefowe.
Dialogue: 0,0:03:46.75,0:03:48.46,italics,Maomao,0,0,0,,Po dołączeniu nowych dwórek
Dialogue: 0,0:03:48.46,0:03:51.40,italics,Maomao,0,0,0,,ilość pracy do zrobienia drastycznie spadła.
Dialogue: 0,0:03:52.43,0:03:58.34,italics,Maomao,0,0,0,,Ze względu na ciążę pani Gyokuyou Jadeitowy\NPałac potrzebuje więcej personelu niż zazwyczaj.
Dialogue: 0,0:03:58.34,0:04:01.34,italics,Maomao,0,0,0,,Te nowe nabytki są pomocne, ale...
Dialogue: 0,0:04:02.16,0:04:04.94,italics,Maomao,0,0,0,,Dodatkowo ma to wyrównać również
Dialogue: 0,0:04:04.94,0:04:09.24,italics,Maomao,0,0,0,,proporcje z Granatowym Pałacem\Nkonkubiny Loulan, którego personel jest olbrzymi.
Dialogue: 0,0:04:11.41,0:04:12.56,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:04:13.33,0:04:15.31,Default,Maomao,0,0,0,,Lecę do szopy...
Dialogue: 0,0:04:15.91,0:04:17.35,Default,Yinghua,0,0,0,,Ej, Maomao!
Dialogue: 0,0:04:18.44,0:04:23.34,Default,Seki-u,0,0,0,,Yinghua, Maomao mieszka\Nw szopie, a nie w swoim pokoju?
Dialogue: 0,0:04:23.34,0:04:26.57,Default,Koku-u,0,0,0,,Naprawdę? Pomimo że jest\Ndwórką pani Gyokuyou?
Dialogue: 0,0:04:26.57,0:04:30.29,Default,Yinghua,0,0,0,,Wiecie... to... Haha...
Dialogue: 0,0:04:42.62,0:04:47.17,italics,Maomao,0,0,0,,Nie podoba mi się,\Nże Yinghua wyciągnęła mnie stąd,
Dialogue: 0,0:04:47.17,0:04:49.89,italics,Maomao,0,0,0,,ale wiem, że zrobiła to\Nz dobroci serca.
Dialogue: 0,0:04:49.89,0:04:53.22,italics,Maomao,0,0,0,,Chciała, bym szybciej oswoiła\Nsię z nowymi dwórkami.
Dialogue: 0,0:04:53.22,0:04:54.89,italics,Maomao,0,0,0,,Troskliwa, jak zawsze.
Dialogue: 0,0:05:00.82,0:05:03.49,Default,Maomao,0,0,0,,Przepraszam, że jestem taką egoistką.
Dialogue: 0,0:05:03.49,0:05:05.45,Default,Yinghua,0,0,0,,Cóż, nie przeszkadza mi to aż tak bardzo.
Dialogue: 0,0:05:05.45,0:05:08.51,Default,Yinghua,0,0,0,,Ej, Maomao. Nie żałujesz tego,\Nco zrobiłaś, nawet trochę?
Dialogue: 0,0:05:08.51,0:05:10.29,Default,Maomao,0,0,0,,Co? Ależ oczywiście.
Dialogue: 0,0:05:10.29,0:05:12.72,Default,Yinghua,0,0,0,,Naprawdę? Wiesz, że teraz\Nmasz u mnie dług?
Dialogue: 0,0:05:12.72,0:05:14.46,Default,Maomao,0,0,0,,O tak, na pewno...
Dialogue: 0,0:05:14.78,0:05:16.17,Default,Yinghua,0,0,0,,No wiem, prawda?
Dialogue: 0,0:05:16.49,0:05:19.67,Default,Yinghua,0,0,0,,Zatem będziesz mi dziś towarzyszyć!
Dialogue: 0,0:05:19.67,0:05:20.28,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:05:20.28,0:05:23.92,Default,Yinghua,0,0,0,,Tylko my mamy wolny wieczór.
Dialogue: 0,0:05:24.25,0:05:26.17,Default,Yinghua,0,0,0,,Doskonałe wyczucie czasu!
Dialogue: 0,0:05:29.03,0:05:30.54,italics,Maomao,0,0,0,,Dopadła mnie...
Dialogue: 0,0:05:35.88,0:05:39.00,Default,Maomao,0,0,0,,Czy pani Hongniang wie\No naszej wspólnej wyprawie?
Dialogue: 0,0:05:39.00,0:05:42.02,Default,Yinghua,0,0,0,,Nie martw się. Mam pozwolenie.
Dialogue: 0,0:05:42.61,0:05:44.72,italics,Maomao,0,0,0,,Północna strona wewnętrznego pałacu...
Dialogue: 0,0:05:46.26,0:05:49.41,italics,Maomao,0,0,0,,Powinny być tu tylko stare budynki.
Dialogue: 0,0:05:51.95,0:05:55.91,Default,Yinghua,0,0,0,,Maomao, załóż to. O tak.
Dialogue: 0,0:05:57.79,0:05:59.21,Default,Maomao,0,0,0,,Nie za ciepło ci?
Dialogue: 0,0:05:59.52,0:06:01.79,Default,Yinghua,0,0,0,,Nie martw się.\NZa chwilę będzie chłodniej.
Dialogue: 0,0:06:08.03,0:06:08.96,Default,Yinghua,0,0,0,,Jesteśmy.
Dialogue: 0,0:06:13.91,0:06:16.68,Default,Older Court Lady,0,0,0,,Witam. Dołączycie do nas?
Dialogue: 0,0:06:17.05,0:06:19.27,Default,Yinghua,0,0,0,,Tak, dziękuję.
Dialogue: 0,0:06:19.76,0:06:21.17,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:06:21.17,0:06:24.54,Default,Older Court Lady,0,0,0,,Zgaś lampkę i weź to.
Dialogue: 0,0:06:28.79,0:06:32.49,italics,Maomao,0,0,0,,Ładna, ale trochę stara jak na dwórkę.
Dialogue: 0,0:06:32.99,0:06:34.70,Default,Older Court Lady,0,0,0,,A teraz chodźmy.
Dialogue: 0,0:06:37.70,0:06:41.46,Default,Older Court Lady,0,0,0,,Z tego miejsca korzystano\Nza czasów poprzedniego cesarza.
Dialogue: 0,0:06:42.01,0:06:45.53,Default,Older Court Lady,0,0,0,,Liczba kobiet na dworze znacznie\Nspadła w stosunku do tamtych czasów.
Dialogue: 0,0:06:47.72,0:06:49.97,Default,Older Court Lady,0,0,0,,Ale na takie okazje to miejsce jest idealne.
Dialogue: 0,0:06:54.51,0:06:56.89,Default,Older Court Lady,0,0,0,,Siądźcie tam.
Dialogue: 0,0:07:02.77,0:07:04.23,Default,Older Court Lady,0,0,0,,Mamy już komplet.
Dialogue: 0,0:07:05.43,0:07:10.07,italics,Maomao,0,0,0,,Dwanaście osób zamkniętych\Nw pokoju w ciepły wieczór...
Dialogue: 0,0:07:10.50,0:07:14.78,Default,Older Court Lady,0,0,0,,Macie przygotowane swoje historie?
Dialogue: 0,0:07:15.27,0:07:20.29,Default,Older Court Lady,0,0,0,,Dzisiejszej nocy rozkoszujmy się trzynastoma\Nmrożącymi krew w żyłach opowieściami.
Dialogue: 0,0:07:20.84,0:07:22.76,italics,Maomao,0,0,0,,Trzynaście opowieści?
Dialogue: 0,0:07:25.85,0:07:27.92,Default,First Court Lady,0,0,0,,Od tego momentu...
Dialogue: 0,0:07:28.41,0:07:30.67,Default,First Court Lady,0,0,0,,Każdej nocy w fosie przy północnej bramie
Dialogue: 0,0:07:30.67,0:07:33.56,Default,First Court Lady,0,0,0,,można było zobaczyć służącą\Nrzucającą się w kółko do wody.
Dialogue: 0,0:07:34.32,0:07:38.20,Default,First Court Lady,0,0,0,,Pewna współczująca jej dwórka,\Nktóra przyszła rozsypać kwiaty na fosie,
Dialogue: 0,0:07:38.20,0:07:40.73,Default,First Court Lady,0,0,0,,usłyszała skądś głos.
Dialogue: 0,0:07:41.33,0:07:44.00,Default,First Court Lady,0,0,0,,A gdy spojrzała do fosy,\Nby poznać przyczynę...
Dialogue: 0,0:07:44.00,0:07:46.58,Default,First Court Lady,0,0,0,,Blada twarz służącej ukazała się...
Dialogue: 0,0:07:46.58,0:07:51.24,Default,First Court Lady,0,0,0,,Kiedy dwórka próbowała uciec,\Ncoś nagle chwyciło ją za nogi!
Dialogue: 0,0:07:52.93,0:07:56.27,Default,First Court Lady,0,0,0,,Służąca wyszła z wody i powiedziała...
Dialogue: 0,0:07:56.90,0:08:01.74,Default,First Court Lady,0,0,0,,„Osoba, która wepchnęła mnie tamtego dnia...
Dialogue: 0,0:08:04.25,0:08:06.38,Default,First Court Lady,0,0,0,,To ty"!
Dialogue: 0,0:08:09.85,0:08:12.66,italics,Maomao,0,0,0,,Chyba gdzieś to słyszałam.
Dialogue: 0,0:08:13.95,0:08:17.18,italics,Maomao,0,0,0,,Zatem Yinghuę łatwo\Nprzestraszyć, ale lubi te historie.
Dialogue: 0,0:08:22.02,0:08:25.82,italics,Maomao,0,0,0,,Wydaje się, że spotkanie polega\Nna opowiadaniu po kolei strasznych historii,
Dialogue: 0,0:08:25.82,0:08:29.27,italics,Maomao,0,0,0,,a na koniec należy zdmuchnąć świeczkę.
Dialogue: 0,0:08:29.79,0:08:34.04,italics,Maomao,0,0,0,,Niemniej historie te przypominają raczej\Nplotki usłyszane w wewnętrznym pałacu.
Dialogue: 0,0:08:34.04,0:08:36.03,Default,Maomao,0,0,0,,Tyłka nie urywają.
Dialogue: 0,0:08:39.67,0:08:42.72,italics,Maomao,0,0,0,,W wewnętrznym pałacu ciężko o dobrą zabawę.
Dialogue: 0,0:08:42.72,0:08:45.69,italics,Maomao,0,0,0,,Takie wspólne obrady są chyba dozwolone.
Dialogue: 0,0:08:48.05,0:08:49.53,Default,Shisui,0,0,0,,Siemaneczko!
Dialogue: 0,0:08:49.53,0:08:50.65,Default,Maomao,0,0,0,,Shisui.
Dialogue: 0,0:08:50.65,0:08:51.42,Default,Shisui,0,0,0,,Chcesz gryza?
Dialogue: 0,0:08:51.71,0:08:52.60,Default,Maomao,0,0,0,,Dzięki.
Dialogue: 0,0:08:58.06,0:08:59.15,Default,Eighth Court Lady,0,0,0,,Więc.
Dialogue: 0,0:09:00.25,0:09:03.64,Default,Eighth Court Lady,0,0,0,,To historia z mojego rodzinnego miasta.
Dialogue: 0,0:09:05.18,0:09:07.25,italics,Eighth Court Lady,0,0,0,,W pobliżu wioski znajdował się las,
Dialogue: 0,0:09:07.25,0:09:10.66,italics,Eighth Court Lady,0,0,0,,do którego nie wolno było\Nwchodzić mieszkańcom.
Dialogue: 0,0:09:11.22,0:09:15.62,italics,Eighth Court Lady,0,0,0,,Każdy, kto tam wszedł, stawał się przeklęty,\Na demony pożerały jego duszę.
Dialogue: 0,0:09:16.43,0:09:21.46,italics,Eighth Court Lady,0,0,0,,Lecz pewnego dnia\Ndziecko złamało tę zasadę.
Dialogue: 0,0:09:22.18,0:09:24.50,italics,Eighth Court Lady,0,0,0,,W tym roku zbiory były słabe,
Dialogue: 0,0:09:24.50,0:09:30.35,italics,Eighth Court Lady,0,0,0,,więc dzieciak zawędrował do lasu,\Nby szukać jedzenia.
Dialogue: 0,0:09:32.89,0:09:35.42,italics,Eighth Court Lady,0,0,0,,Powiedział on o tym swojej matce:
Dialogue: 0,0:09:35.93,0:09:40.58,italics,Eighth Court Lady,0,0,0,,„Zdradzę ci pewien sekret.\NW tym lesie jest mnóstwo jedzenia”.
Dialogue: 0,0:09:41.81,0:09:45.79,italics,Eighth Court Lady,0,0,0,,Kiedy reszta mieszkańców\Nwioski dowiedziała się o tym,
Dialogue: 0,0:09:45.79,0:09:48.19,italics,Eighth Court Lady,0,0,0,,to chłopiec i jego matka zostali odrzuceni.
Dialogue: 0,0:09:48.86,0:09:54.03,italics,Eighth Court Lady,0,0,0,,Teraz oboje, samotni, nie mieli nic\Ndo jedzenia i chudli z dnia na dzień.
Dialogue: 0,0:09:54.03,0:09:56.86,italics,Eighth Court Lady,0,0,0,,Nikt jednak nie chciał im pomóc.
Dialogue: 0,0:09:58.12,0:10:05.48,italics,Eighth Court Lady,0,0,0,,Pewnej nocy ktoś dostrzegł\Nświatło wpadające do ich domu.
Dialogue: 0,0:10:06.15,0:10:11.00,italics,Eighth Court Lady,0,0,0,,Następnego dnia przywódca wioski\Nusłyszał wieści i poszedł ich odwiedzić.
Dialogue: 0,0:10:11.95,0:10:16.21,italics,Eighth Court Lady,0,0,0,,Dziecko leżało martwe,\Na matka była na skraju śmierci.
Dialogue: 0,0:10:17.23,0:10:19.22,italics,Eighth Court Lady,0,0,0,,Kobieta powiedziała do niego:
Dialogue: 0,0:10:20.49,0:10:23.72,italics,Eighth Court Lady,0,0,0,,„Zdradzę ci pewien sekret”.
Dialogue: 0,0:10:24.20,0:10:27.74,italics,Eighth Court Lady,0,0,0,,Lecz w tym momencie umarła.
Dialogue: 0,0:10:28.69,0:10:32.62,italics,Eighth Court Lady,0,0,0,,Na jej twarzy gościł dziwny uśmiech.
Dialogue: 0,0:10:33.58,0:10:37.74,italics,Eighth Court Lady,0,0,0,,Nikt nie wie, co chciała powiedzieć.
Dialogue: 0,0:10:37.74,0:10:41.02,italics,Eighth Court Lady,0,0,0,,Miejscowi wciąż lękają się lasu,\Npostrzegając go jako przeklęty.
Dialogue: 0,0:10:41.02,0:10:44.66,italics,Eighth Court Lady,0,0,0,,Każdy, kto tam wejdzie, stanie się\Nofiarą demona we własnym domu,
Dialogue: 0,0:10:44.66,0:10:47.23,italics,Eighth Court Lady,0,0,0,,a jego dusza zostanie pożarta.
Dialogue: 0,0:10:50.49,0:10:52.29,Default,Maomao,0,0,0,,A, rozumiem.
Dialogue: 0,0:10:52.29,0:10:54.29,Default,Shisui,0,0,0,,Co takiego?
Dialogue: 0,0:10:54.29,0:10:55.77,Default,Maomao,0,0,0,,Później ci powiem.
Dialogue: 0,0:10:57.93,0:10:59.56,italics,Maomao,0,0,0,,Z jakiegoś powodu chcę mi się spać.
Dialogue: 0,0:11:00.04,0:11:02.34,italics,Maomao,0,0,0,,Chyba za dużo ludzi w jednym miejscu.
Dialogue: 0,0:11:02.34,0:11:04.68,italics,Maomao,0,0,0,,Może przez ten tłum\Nmam zawroty głowy?
Dialogue: 0,0:11:05.02,0:11:06.72,Default,Elder Court Lady,0,0,0,,Teraz twoja kolej.
Dialogue: 0,0:11:07.79,0:11:09.13,Default,Shisui,0,0,0,,Dobrze.
Dialogue: 0,0:11:11.67,0:11:16.26,Default,Shisui,0,0,0,,To opowieść z odległej krainy,\Npołożonej daleko na wschodzie.
Dialogue: 0,0:11:18.10,0:11:23.78,italics,Shisui,0,0,0,,Pewien mnich skończył odprawiać\Nrytuały pogrzebowe w odległej krainie.
Dialogue: 0,0:11:23.78,0:11:26.54,italics,Shisui,0,0,0,,Gdy wracał do domu,\Nzdał sobie sprawę, że zaszło słońce.
Dialogue: 0,0:11:27.41,0:11:33.21,italics,Shisui,0,0,0,,Otaczała go wysoka trawa,\Na w pobliżu słychać było dzikie psy.
Dialogue: 0,0:11:33.98,0:11:37.05,italics,Shisui,0,0,0,,Mnich chciał uciec\Nod niebezpieczeństwa i nagle...
Dialogue: 0,0:11:37.05,0:11:39.55,italics,Shisui,0,0,0,,przed nim pojawił się stary dom.
Dialogue: 0,0:11:42.12,0:11:44.84,Default,Monk,0,0,0,,Przepraszam, że niepokoję\No tak późnej porze.
Dialogue: 0,0:11:46.35,0:11:48.70,Default,Wife,0,0,0,,O co chodzi, wielebny?
Dialogue: 0,0:11:48.70,0:11:52.08,Default,Monk,0,0,0,,Chciałem przejść przez góry,\Nale nie udało mi się przed zmrokiem.
Dialogue: 0,0:11:52.08,0:11:56.27,Default,Monk,0,0,0,,Czy mogę zostać na noc?\NWystarczy kącik w szopie.
Dialogue: 0,0:11:56.56,0:12:00.57,Default,Wife,0,0,0,,Musisz być bardzo zmęczony.
Dialogue: 0,0:12:02.29,0:12:07.33,italics,Shisui,0,0,0,,Żona ugościła mnicha\Njedzeniem i posłaniem.
Dialogue: 0,0:12:08.09,0:12:13.18,italics,Shisui,0,0,0,,Mnich był wdzięczny za ciepłe powitanie,\Nale nie mógł dać nic w zamian.
Dialogue: 0,0:12:13.18,0:12:17.04,italics,Shisui,0,0,0,,Pomyślał, że najlepsze, co może zrobić,\Nto recytować dla niej sutrę.
Dialogue: 0,0:12:23.01,0:12:24.59,italics,Monk,0,0,0,,Czy to dźwięk dzwonka...?
Dialogue: 0,0:12:25.37,0:12:31.22,italics,Monk,0,0,0,,Nie, brzmi jak dzwonek,\Nale w istocie jest to ludzki głos?
Dialogue: 0,0:12:31.62,0:12:34.42,Default,Wife,0,0,0,,Co zamierzasz zrobić?
Dialogue: 0,0:12:34.42,0:12:36.48,Default,Husband,0,0,0,,Nic. W porządku.
Dialogue: 0,0:12:36.48,0:12:41.07,Default,Wife,0,0,0,,Nie możesz. Proszę.\NNie chcę zostać sama.
Dialogue: 0,0:12:41.48,0:12:43.36,Default,Husband,0,0,0,,Więc co powinniśmy zrobić?
Dialogue: 0,0:12:43.96,0:12:45.78,Default,Wife,0,0,0,,Dłużej tego nie zniosę.
Dialogue: 0,0:12:47.00,0:12:51.08,italics,Monk,0,0,0,,Czy oni się kłócą?\NPowinienem interweniować?
Dialogue: 0,0:12:51.36,0:12:55.35,italics,Monk,0,0,0,,Nie, coś mi mówi, że nie mogę przestać.
Dialogue: 0,0:12:55.35,0:12:57.40,Default,Husband,0,0,0,,Użyjmy tego mnicha jako zastępstwa.
Dialogue: 0,0:12:57.40,0:12:58.92,Default,Wife,0,0,0,,To jedyny sposób.
Dialogue: 0,0:13:00.44,0:13:03.49,Default,Wife,0,0,0,,To do dzieła.
Dialogue: 0,0:13:05.94,0:13:08.58,Default,Wife,0,0,0,,Gdzie ten mnich?
Dialogue: 0,0:13:20.29,0:13:21.82,Default,Wife,0,0,0,,Czyżby dał nogę?
Dialogue: 0,0:13:24.26,0:13:26.78,Default,Wife,0,0,0,,Nie ma go... nie ma go!
Dialogue: 0,0:13:26.78,0:13:30.38,Default,Wife,0,0,0,,Muszę go znaleźć! Inaczej...
Dialogue: 0,0:13:30.70,0:13:35.21,Default,Wife,0,0,0,,{\t(0,1450,\c&H5253FF&)}Zajmę twoje miejsce!
Dialogue: 0,0:13:38.81,0:13:44.18,italics,Shisui,0,0,0,,Mnich nie przestawał śpiewać,\Ndopóki odgłosy nie ustały.
Dialogue: 0,0:13:45.29,0:13:49.12,italics,Shisui,0,0,0,,Gdy zapadła cisza,\Nmnich wyszedł na zewnątrz.
Dialogue: 0,0:13:50.01,0:13:53.77,italics,Shisui,0,0,0,,Młoda para zniknęła, a zamiast nich...
Dialogue: 0,0:13:54.86,0:13:57.31,italics,Shisui,0,0,0,,Znalazł tylko skrzydła owadów.
Dialogue: 0,0:13:57.79,0:14:01.57,Default,Shisui,0,0,0,,Mnich zacisnął dłonie\Ni wędrował do świtu,
Dialogue: 0,0:14:02.58,0:14:05.03,Default,Shisui,0,0,0,,recytując sutrę.
Dialogue: 0,0:14:06.06,0:14:10.53,italics,Maomao,0,0,0,,Niezła gaduła. Jak nie ona.
Dialogue: 0,0:14:11.72,0:14:17.54,italics,Maomao,0,0,0,,Pod tym kątem jej twarz...\Nwydaje się znajoma?
Dialogue: 0,0:14:20.03,0:14:21.84,Default,Shisui,0,0,0,,Maomao, twoja kolej.
Dialogue: 0,0:14:21.84,0:14:23.67,Default,Maomao,0,0,0,,Co? A, racja.
Dialogue: 0,0:14:24.13,0:14:26.18,Default,Maomao,0,0,0,,Co by tu opowiedzieć?
Dialogue: 0,0:14:27.87,0:14:30.32,Default,Maomao,0,0,0,,Znam to od mojego tatka.
Dialogue: 0,0:14:30.32,0:14:33.62,Default,Maomao,0,0,0,,Plotki głosiły, że na cmentarzu\Nwidziano unoszące się w powietrzu duchy.
Dialogue: 0,0:14:35.42,0:14:40.77,Default,Maomao,0,0,0,,Grupka dzielnych młodzieńców\Npostanowiła zbadać sprawę.
Dialogue: 0,0:14:42.04,0:14:42.77,Default,Maomao,0,0,0,,I wtedy...
Dialogue: 0,0:14:48.75,0:14:53.74,Default,Maomao,0,0,0,,Był to tylko kolejny mężczyzna\Nz tej samej mieściny, spacerujący z pochodnią.
Dialogue: 0,0:14:55.81,0:14:56.87,Default,Yinghua,0,0,0,,To tyle?
Dialogue: 0,0:14:57.16,0:14:58.19,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:14:58.19,0:15:02.71,Default,Maomao,0,0,0,,Mężczyzna był grabarzem.\NStrasznie interesował się dziwną klątwą
Dialogue: 0,0:15:02.71,0:15:05.71,Default,Maomao,0,0,0,,i rozkopywał groby,\Nby poćwiartować zwłoki,
Dialogue: 0,0:15:06.06,0:15:08.82,Default,Maomao,0,0,0,,i zebrać ludzkie wątroby,\Nktóre, jak wierzył, leczyły...
Dialogue: 0,0:15:08.82,0:15:10.30,Default,Yinghua,0,0,0,,Wystarczy!
Dialogue: 0,0:15:11.49,0:15:12.96,Default,Maomao,0,0,0,,To wszystko.
Dialogue: 0,0:15:15.81,0:15:18.00,Default,Maomao,0,0,0,,Teraz ty, Yinghua.
Dialogue: 0,0:15:18.00,0:15:22.31,Default,Yinghua,0,0,0,,Co? A, no...
Dialogue: 0,0:15:22.78,0:15:25.93,Default,Yinghua,0,0,0,,Dawno, dawno temu był sobie człowiek...
Dialogue: 0,0:15:25.93,0:15:28.82,Default,Yinghua,0,0,0,,A może... to była staruszka?
Dialogue: 0,0:15:29.14,0:15:30.24,Default,Yinghua,0,0,0,,Um...
Dialogue: 0,0:15:37.38,0:15:39.72,Default,Older Court Lady,0,0,0,,Teraz moja kolej.
Dialogue: 0,0:15:40.83,0:15:45.59,italics,Maomao,0,0,0,,W sumie na początku\Nmówiła „trzynaście historii”.
Dialogue: 0,0:15:46.27,0:15:49.98,italics,Maomao,0,0,0,,Nas jest tylko dwunastka.\NO co w tym biega?
Dialogue: 0,0:15:49.98,0:15:52.59,Default,Older Court Lady,0,0,0,,Miało to miejsce\Nza czasów zmarłego cesarza.
Dialogue: 0,0:15:53.02,0:15:58.61,Default,Older Court Lady,0,0,0,,W tamtych czasach wewnętrzny pałac\Nciągle się rozrastał, dodając nowe sekcje.
Dialogue: 0,0:15:59.38,0:16:00.83,Default,Older Court Lady,0,0,0,,Dlaczego?
Dialogue: 0,0:16:01.60,0:16:07.55,Default,Older Court Lady,0,0,0,,W owym czasie Wielka Cesarzowa Wdowa,\Nznana jako Cesarzowa, sprawowała ogromną władzę.
Dialogue: 0,0:16:07.55,0:16:11.66,Default,Older Court Lady,0,0,0,,Usiłowała znaleźć dziewczyny,\Nktóre przypadłyby do gustu cesarzowi.
Dialogue: 0,0:16:14.05,0:16:15.42,italics,Maomao,0,0,0,,Co jest...?
Dialogue: 0,0:16:16.06,0:16:21.25,Default,Older Court Lady,0,0,0,,Cesarz wybierał najmłodsze dziewczęta,\Nkalając je jedna po drugiej. {miałam dać posuwał xD}
Dialogue: 0,0:16:22.15,0:16:28.94,Default,Older Court Lady,0,0,0,,Dziewczęta spędzały całe dnie w wewnętrznym\Npałacu, z którego nie mogły wychodzić.
Dialogue: 0,0:16:29.87,0:16:33.76,Default,Older Court Lady,0,0,0,,Jedna z nich zaszła w ciążę.
Dialogue: 0,0:16:34.37,0:16:36.76,Default,Older Court Lady,0,0,0,,Złożyła prośbę do cesarza, ale...
Dialogue: 0,0:16:37.56,0:16:41.27,Default,Older Court Lady,0,0,0,,Nigdy nie pozwolono jej opuścić pałacu.
Dialogue: 0,0:16:41.61,0:16:43.95,Default,Older Court Lady,0,0,0,,Tuż przed śmiercią powiedziała...
Dialogue: 0,0:16:46.11,0:16:48.83,Default,Older Court Lady,0,0,0,,{\t(\c&H5253FF&)}„Teraz twoja kolej"!
Dialogue: 0,0:16:50.90,0:16:51.82,Default,Yinghua,0,0,0,,Maomao?!
Dialogue: 0,0:16:54.70,0:16:57.28,italics,Maomao,0,0,0,,Nie dziwota, że kręciło mi się w głowie!
Dialogue: 0,0:16:57.28,0:16:58.91,Default,Maomao,0,0,0,,Panno Yinghua! Shisui!
Dialogue: 0,0:16:58.91,0:17:01.87,Default,Maomao,0,0,0,,Przenieście nieprzytomne\Nkobiety bliżej okien i drzwi.
Dialogue: 0,0:17:02.22,0:17:04.00,Default,Yinghua,0,0,0,,Co? Co się stało?
Dialogue: 0,0:17:04.00,0:17:10.05,Default,Maomao,0,0,0,,Szybko! Tlący się ogień zalewa\Npomieszczenie szkodliwym powietrzem!
Dialogue: 0,0:17:10.40,0:17:12.15,Default,Yinghua,0,0,0,,Jasne!
Dialogue: 0,0:17:17.37,0:17:19.48,italics,Maomao,0,0,0,,Za długo nie zdawałam\Nsobie z tego sprawy.
Dialogue: 0,0:17:21.89,0:17:24.43,Default,Older Court Lady,0,0,0,,{\t(\c&H5253FF&)}Prawie mi się udało...
Dialogue: 0,0:17:28.18,0:17:29.90,italics,Maomao,0,0,0,,Ta dwórka...
Dialogue: 0,0:17:35.39,0:17:40.18,Default,Yinghua,0,0,0,,Co za noc. Zniknęła też organizatorka.
Dialogue: 0,0:17:40.86,0:17:42.04,Default,Shisui,0,0,0,,Maomao.
Dialogue: 0,0:17:42.85,0:17:44.28,Default,Yinghua,0,0,0,,To ta z wcześniej?
Dialogue: 0,0:17:44.28,0:17:46.25,Default,Maomao,0,0,0,,To moja znajoma.
Dialogue: 0,0:17:46.61,0:17:49.71,Default,Shisui,0,0,0,,Hej, Maomao.\NO czym była ta historia?
Dialogue: 0,0:17:50.13,0:17:51.18,Default,Maomao,0,0,0,,Historia?
Dialogue: 0,0:17:51.18,0:17:53.80,Default,Shisui,0,0,0,,Ta o zakazanym lesie.
Dialogue: 0,0:17:54.61,0:17:55.34,Default,Maomao,0,0,0,,Aaa.
Dialogue: 0,0:17:56.12,0:17:59.30,Default,Maomao,0,0,0,,„Zakazany las” to pewnie tylko przesąd.
Dialogue: 0,0:17:59.30,0:18:03.87,Default,Maomao,0,0,0,,Jednak niektóre rzeczy nie bez powodu są zakazane. I to może być jedna z nich.
Dialogue: 0,0:18:03.87,0:18:04.97,Default,Shisui,0,0,0,,Co?
Dialogue: 0,0:18:05.26,0:18:09.94,Default,Maomao,0,0,0,,Lasy są pełne pożywienia,\Nale nie wszystko jest jadalne.
Dialogue: 0,0:18:11.03,0:18:16.78,Default,Maomao,0,0,0,,Jeśli ktoś obcy wszedłby do lasu,\Nzjadłby coś i zachorował,
Dialogue: 0,0:18:17.42,0:18:21.05,Default,Maomao,0,0,0,,byłoby naturalne,\Nże rozeszłaby się wieść, że należy uważać
Dialogue: 0,0:18:21.05,0:18:22.78,Default,Maomao,0,0,0,,przy jedzeniu rzeczy z lasu.
Dialogue: 0,0:18:23.23,0:18:27.33,Default,Maomao,0,0,0,,Z biegiem lat może to\Nprzerodzić się w coś „zakazanego”.
Dialogue: 0,0:18:27.33,0:18:29.79,Default,Maomao,0,0,0,,Później, kiedy nastał głód,
Dialogue: 0,0:18:30.06,0:18:34.34,Default,Maomao,0,0,0,,ludzie nie wiedzieli, co można,\Na czego nie można jeść.
Dialogue: 0,0:18:34.97,0:18:39.31,Default,Maomao,0,0,0,,Mama z synem z tej historii\Ngłodowali z powodu słabych zbiorów.
Dialogue: 0,0:18:39.31,0:18:43.60,Default,Maomao,0,0,0,,Weszli do lasu, gdy zrobiło się\Nciemno, bo przecież łamali zasady.
Dialogue: 0,0:18:43.60,0:18:47.85,Default,Maomao,0,0,0,,Szukali pożywienia i wrócili\Ndo domu, gdy zapadła noc.
Dialogue: 0,0:18:48.57,0:18:52.64,Default,Maomao,0,0,0,,Jest pewien grzyb zwany\Nkielichowcem japońskim.
Dialogue: 0,0:18:53.01,0:18:55.64,Default,Maomao,0,0,0,,Przypomina boczniaka\Ni wygląda przepysznie,
Dialogue: 0,0:18:55.64,0:18:58.11,Default,Maomao,0,0,0,,ale jest trujący i świeci w ciemnościach.
Dialogue: 0,0:18:59.01,0:19:02.92,Default,Maomao,0,0,0,,Jeśli mieszkaniec wioski zobaczył z daleka\Nkogoś niosącego te grzyby w ciemności,
Dialogue: 0,0:19:02.92,0:19:05.12,Default,Maomao,0,0,0,,mogło to przypominać unoszącego się ducha.
Dialogue: 0,0:19:05.94,0:19:12.00,Default,Maomao,0,0,0,,Nie jest to silna trucizna, ale jeśli\Nspożyje ją wygłodzona, osłabiona osoba...
Dialogue: 0,0:19:15.75,0:19:20.00,Default,Maomao,0,0,0,,Możliwe, że umierająca\Nmatka chciała powiedzieć...
Dialogue: 0,0:19:21.37,0:19:25.22,Default,Mother,0,0,0,,W lesie można znaleźć pyszne grzyby.
Dialogue: 0,0:19:26.73,0:19:31.14,Default,Maomao,0,0,0,,By zemścić się na mieszkańcach\Nwioski, którzy porzucili ją i jej syna.
Dialogue: 0,0:19:31.75,0:19:33.97,Default,Shisui,0,0,0,,Więc to o to chodziło!
Dialogue: 0,0:19:33.97,0:19:35.88,Default,Shisui,0,0,0,,Świetnie, teraz wszystko jasne!
Dialogue: 0,0:19:35.88,0:19:37.96,Default,Shisui,0,0,0,,Dobra, lecę tędy, pa!
Dialogue: 0,0:19:40.02,0:19:43.78,Default,Yinghua,0,0,0,,Ha. Teraz, gdy znam prawdę,\Nto wcale nie jest straszne!
Dialogue: 0,0:19:44.54,0:19:47.99,Default,Yinghua,0,0,0,,Pewnie wszystkie historie\Nmają podobne podłoże.
Dialogue: 0,0:19:49.16,0:19:51.46,Default,Maomao,0,0,0,,Cóż... kto wie?
Dialogue: 0,0:19:51.46,0:19:53.92,Default,Yinghua,0,0,0,,Choć raz mnie udobruchaj, dobrze?!
Dialogue: 0,0:19:56.18,0:19:57.61,Default,Yinghua,0,0,0,,Wróciłyśmy.
Dialogue: 0,0:19:57.61,0:20:00.61,Default,Hongniang,0,0,0,,Jesteście wcześniej, niż myślałam.
Dialogue: 0,0:20:00.61,0:20:02.96,Default,Yinghua,0,0,0,,Zrobiło się lekkie zamieszanie.
Dialogue: 0,0:20:02.96,0:20:04.68,Default,Hongniang,0,0,0,,Tego się spodziewałam.
Dialogue: 0,0:20:05.05,0:20:08.74,Default,Hongniang,0,0,0,,Domyślam się, że wszystko może\Nsię zdarzyć, gdy organizator jest nowy.
Dialogue: 0,0:20:08.74,0:20:10.18,Default,Maomao,0,0,0,,Nowy organizator?
Dialogue: 0,0:20:10.18,0:20:13.18,Default,Hongniang,0,0,0,,Kobieta, która organizowała\Nto wydarzenie, zmarła w zeszłym roku.
Dialogue: 0,0:20:13.18,0:20:16.48,Default,Hongniang,0,0,0,,Martwiło mnie trochę,\Nkto przejmie stery w tym roku.
Dialogue: 0,0:20:16.48,0:20:17.72,Default,Yinghua,0,0,0,,Co?
Dialogue: 0,0:20:17.72,0:20:21.53,Default,Hongniang,0,0,0,,Była miłą osobą, bardzo pomocną.\NDużo mi też pomogła.
Dialogue: 0,0:20:21.53,0:20:24.49,Default,Hongniang,0,0,0,,Chyba nigdy nie opuściła\Nwewnętrznego pałacu.
Dialogue: 0,0:20:24.96,0:20:28.49,Default,Hongniang,0,0,0,,Tak naprawdę łączyły ją\Nstosunki ze zmarłym cesarzem.
Dialogue: 0,0:20:28.49,0:20:31.70,Default,Hongniang,0,0,0,,Mówiła, że to spotkanie było\Njedyną rozrywką, jaką kiedykolwiek miała.
Dialogue: 0,0:20:32.62,0:20:37.84,Default,Hongniang,0,0,0,,Szkoda byłoby, gdyby te spotkania\Nzakończyły się rok po jej śmierci,
Dialogue: 0,0:20:38.42,0:20:41.34,Default,Hongniang,0,0,0,,więc cieszę się, że ktoś je przejął.
Dialogue: 0,0:20:43.83,0:20:45.39,Default,Yinghua,0,0,0,,Ta historia...
Dialogue: 0,0:20:47.81,0:20:53.34,flashback,Older Court Lady,0,0,0,,Cesarz wybierał najmłodsze dziewczęta,\Nkalając je jedna po drugiej.
Dialogue: 0,0:20:53.34,0:20:57.36,flashback,Older Court Lady,0,0,0,,Dziewczęta spędzały całe dnie w wewnętrznym\Npałacu, z którego nie mogły wychodzić.
Dialogue: 0,0:20:59.02,0:21:03.11,italics,Maomao,0,0,0,,Ta kobieta opowiadała\Nz własnego doświadczenia.
Dialogue: 0,0:21:03.66,0:21:07.52,italics,Maomao,0,0,0,,A może to tylko żart kogoś zaufanego?
Dialogue: 0,0:21:10.59,0:21:14.62,italics,Maomao,0,0,0,,Na świecie jest wiele rzeczy,\Nktórych nie umiem w pełni zrozumieć.
Dialogue: 0,0:21:15.54,0:21:20.63,flashback,Older Court Lady,0,0,0,,Dzisiejszej nocy rozkoszujmy się trzynastoma\Nmrożącymi krew w żyłach opowieściami.
Dialogue: 0,0:21:21.87,0:21:27.64,italics,Maomao,0,0,0,,Łącznie z nią było tam\Ntylko dwanaście osób.
Dialogue: 0,0:21:28.10,0:21:32.97,italics,Maomao,0,0,0,,Dobrze, że nie skończyłyśmy\Njako trzynasta historia.
Dialogue: 0,0:21:33.43,0:21:35.49,Default,Yinghua,0,0,0,,M-Maomao...
Dialogue: 0,0:21:35.49,0:21:36.14,Default,Maomao,0,0,0,,Tak?
Dialogue: 0,0:21:36.60,0:21:40.02,Default,Yinghua,0,0,0,,Proszę, śpij dziś ze mną!
Dialogue: 0,0:21:45.47,0:21:50.58,italics,Maomao,0,0,0,,Noc mrożąca krew w żyłach\Nokazała się gorąca i duszna.
Dialogue: 0,0:21:51.74,0:21:53.03,Default,Maomao,0,0,0,,Zaraz się roztopię...
Dialogue: 0,0:23:45.07,0:23:47.07,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.35,0:24:00.00,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku\N„Polowanie”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
