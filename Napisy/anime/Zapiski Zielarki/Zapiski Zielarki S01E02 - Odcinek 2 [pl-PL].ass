Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:29.98,0:01:32.24,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:32.33,0:01:36.33,Default,Episode Title,0,0,0,,{\an8}ODCINEK 2: OBOJĘTNA ZIELARKA
Dialogue: 0,0:01:41.33,0:01:42.36,Default,Soldier A,0,0,0,,Ej!
Dialogue: 0,0:01:44.51,0:01:45.62,Default,Soldier A,0,0,0,,To trucizna!
Dialogue: 0,0:01:47.54,0:01:49.99,Default,Soldier B,0,0,0,,Palancie! Czyja to sprawka?!
Dialogue: 0,0:01:51.03,0:01:52.17,Default,Officer,0,0,0,,Czekaj.
Dialogue: 0,0:01:53.20,0:01:55.21,Default,Officer,0,0,0,,Wpierw zajmij się żołnierzami.
Dialogue: 0,0:02:04.69,0:02:05.79,Default,Jinshi,0,0,0,,Trucizna?
Dialogue: 0,0:02:05.82,0:02:08.46,Default,Gaoshun,0,0,0,,Jedzenie przygotowywali\Nmieszkańcy wioski.
Dialogue: 0,0:02:08.63,0:02:12.80,Default,Gaoshun,0,0,0,,Przywódca wioski został\Npojmany za pomoc bandytom.
Dialogue: 0,0:02:12.80,0:02:14.12,Default,Gaoshun,0,0,0,,Prosimy o radę.
Dialogue: 0,0:02:14.12,0:02:17.25,Default,Jinshi,0,0,0,,Dobrze. Dajcie mi chwilę.
Dialogue: 0,0:02:17.25,0:02:18.25,Default,Gaoshun,0,0,0,,Wedle życzenia.
Dialogue: 0,0:02:19.29,0:02:20.45,Default,Gaoshun,0,0,0,,Przy okazji…
Dialogue: 0,0:02:20.77,0:02:25.16,Default,Gaoshun,0,0,0,,Doszły mnie słuchy, że zatrudniłeś\Nnową służkę konkubinie Gyokuyou.
Dialogue: 0,0:02:25.16,0:02:28.87,Default,Jinshi,0,0,0,,Tak. Konkubina ma jedynie cztery służki.
Dialogue: 0,0:02:29.44,0:02:31.31,Default,Jinshi,0,0,0,,To niewiele w porównaniu z Li Huą,
Dialogue: 0,0:02:31.31,0:02:34.42,Default,Jinshi,0,0,0,,która ma taką samą rangę\Ni posiada ich ponad dziesięć.
Dialogue: 0,0:02:35.21,0:02:38.47,Default,Jinshi,0,0,0,,To zdecydowanie uwłacza jej\Njako konkubinie wysokiej rangi.
Dialogue: 0,0:02:38.47,0:02:43.28,Default,Gaoshun,0,0,0,,Tak, konkubina Gyokuyou\Njest nie tylko bystra i łagodna,
Dialogue: 0,0:02:43.28,0:02:45.60,Default,Gaoshun,0,0,0,,ale także mądra i ostrożna.
Dialogue: 0,0:02:46.70,0:02:50.10,Default,Jinshi,0,0,0,,Nie przyjęłaby kogoś\No niewiadomym pochodzeniu.
Dialogue: 0,0:02:50.94,0:02:55.17,Default,Jinshi,0,0,0,,Nieustanna ostrożność\Nwobec wszystkich ludzi wokół,
Dialogue: 0,0:02:55.17,0:02:57.48,Default,Jinshi,0,0,0,,to jedyny sposób,\Nby konkubina zdołała przeżyć.
Dialogue: 0,0:02:57.88,0:03:00.24,Default,Gaoshun,0,0,0,,Więc kim jest ta służka?
Dialogue: 0,0:03:01.58,0:03:04.75,Default,Jinshi,0,0,0,,Gaoshun, udało mi się\Ntrafić na idealnego pionka.
Dialogue: 0,0:03:05.65,0:03:07.79,Default,Jinshi,0,0,0,,To ta piegowata służka.
Dialogue: 0,0:03:10.19,0:03:13.62,Default,Jinshi,0,0,0,,Jej znajomość medycyny to coś,\Nz czego nie możemy zrezygnować.
Dialogue: 0,0:03:13.62,0:03:17.47,Default,Gaoshun,0,0,0,,Rozumiem.\NAle jeśli nadużyje tej wiedzy…
Dialogue: 0,0:03:18.57,0:03:21.42,Default,Jinshi,0,0,0,,Dopilnuję, żeby tego nie zrobiła.
Dialogue: 0,0:03:21.42,0:03:22.80,Default,Jinshi,0,0,0,,To będzie prościzna.
Dialogue: 0,0:03:23.66,0:03:26.69,Default,Jinshi,0,0,0,,W razie czego zawsze mogę ją uwieść.
Dialogue: 0,0:03:29.31,0:03:32.45,Default,Xiaolan,0,0,0,,Fajnie, że będziesz służyć\Nkonkubinie wysokiej rangi.
Dialogue: 0,0:03:32.45,0:03:34.65,Default,Maomao,0,0,0,,Nie chciałam tego.
Dialogue: 0,0:03:40.06,0:03:43.50,Default,Jinshi,0,0,0,,Zielareczko, gotowa do drogi?
Dialogue: 0,0:03:43.50,0:03:46.69,Default,Maomao,0,0,0,,Tak, właśnie udaję się\Ndo Jadeitowego Pałacu.
Dialogue: 0,0:03:46.69,0:03:48.34,Default,Maomao,0,0,0,,Czegoś potrzebujesz?
Dialogue: 0,0:03:48.34,0:03:50.00,Default,Jinshi,0,0,0,,Nie, niczego.
Dialogue: 0,0:03:50.31,0:03:51.36,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:03:52.35,0:03:54.88,Default,Maomao,0,0,0,,Więc po co tu przylazł?\NNie ma nic lepszego do roboty?
Dialogue: 0,0:03:58.63,0:04:01.92,Default,Jinshi,0,0,0,,Nie zapomnij dobrze\Nsłużyć konkubinie Gyokuyou.
Dialogue: 0,0:04:06.40,0:04:07.81,Default,Maomao,0,0,0,,Wybacz.
Dialogue: 0,0:04:09.36,0:04:10.81,Default,Xiaolan,0,0,0,,Powodzonka, Maomao.
Dialogue: 0,0:04:14.48,0:04:16.31,Default,Maomao,0,0,0,,To było ohydne.
Dialogue: 0,0:04:20.39,0:04:22.20,Default,Hongniang,0,0,0,,Ty jesteś Maomao?
Dialogue: 0,0:04:22.20,0:04:23.53,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:04:24.00,0:04:27.95,Default,Hongniang,0,0,0,,Jestem Hongniang, główna\Nosobista służąca pani Gyokuyou.
Dialogue: 0,0:04:28.73,0:04:31.83,Default,Hongniang,0,0,0,,Oprowadzę cię po Jadeitowym\NPałacu. Chodź za mną.
Dialogue: 0,0:04:32.38,0:04:33.54,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:04:37.66,0:04:42.92,Default,Gyokuyou,0,0,0,,Witamy w Jadeitowym Pałacu.\NCzekaliśmy na ciebie, Maomao.
Dialogue: 0,0:04:44.67,0:04:46.93,Default,Gyokuyou,0,0,0,,Xiaoling też się cieszy, że cię widzi.
Dialogue: 0,0:04:47.48,0:04:49.33,Default,Gyokuyou,0,0,0,,Cieszymy się, że jesteś z nami.
Dialogue: 0,0:04:52.33,0:04:54.09,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:04:55.27,0:04:59.46,Default,Hongniang,0,0,0,,To salon, w którym przyjmujemy gości.
Dialogue: 0,0:04:59.46,0:05:00.77,Default,Maomao,0,0,0,,Ale wielki…
Dialogue: 0,0:05:00.77,0:05:04.44,Default,Hongniang,0,0,0,,To kuchnia. Powinnaś dać\Nsobie radę z prostymi posiłkami.
Dialogue: 0,0:05:06.30,0:05:07.64,Default,Hongniang,0,0,0,,To jest pokój dzienny.
Dialogue: 0,0:05:07.64,0:05:11.33,Default,Hongniang,0,0,0,,Oto pozostałe służące.\NPozwól, że ci je przedstawię.
Dialogue: 0,0:05:11.33,0:05:12.95,Default,Hongniang,0,0,0,,Kochane, chodźcie tutaj.
Dialogue: 0,0:05:12.95,0:05:14.20,Default,Ladies-in-waiting,0,0,0,,Dobrze.
Dialogue: 0,0:05:14.76,0:05:19.25,Default,Yinghua,0,0,0,,Miło mi cię poznać,\Njestem Yinghua. Pytaj o wszystko!
Dialogue: 0,0:05:19.25,0:05:22.90,Default,Guiyuan,0,0,0,,Hej, jestem Guiyuan.\NMiło mi cię poznać.
Dialogue: 0,0:05:22.90,0:05:27.01,Default,Ailan,0,0,0,,Jestem Ailan.\NCieszę się, że mogę cię poznać.
Dialogue: 0,0:05:27.01,0:05:29.76,Default,Maomao,0,0,0,,Nazywam się Maomao.\NLiczę na wasze wsparcie.
Dialogue: 0,0:05:31.89,0:05:35.38,Default,Hongniang,0,0,0,,W Jadeitowym Pałacu\Nnie ma dodatkowej służby.
Dialogue: 0,0:05:35.38,0:05:38.74,Default,Hongniang,0,0,0,,Dlatego to my\Nzajmujemy się wszystkim.
Dialogue: 0,0:05:38.74,0:05:43.03,Default,Yinghua,0,0,0,,Przynajmniej tyle możemy zrobić,\Nby pani Gyokuyou czuła się dobrze.
Dialogue: 0,0:05:43.52,0:05:44.90,Default,Maomao,0,0,0,,W takim razie ja też…
Dialogue: 0,0:05:44.90,0:05:46.98,Default,Yinghua,0,0,0,,Odpocznij w swoim pokoju.
Dialogue: 0,0:05:47.75,0:05:49.69,Default,Guiyuan,0,0,0,,Nie przejmuj się.
Dialogue: 0,0:05:49.69,0:05:52.42,Default,Ailan,0,0,0,,Masz specjalne zadanie do wykonania.
Dialogue: 0,0:05:52.42,0:05:53.99,Default,Maomao,0,0,0,,Specjalne zadanie?
Dialogue: 0,0:05:54.81,0:05:57.08,Default,Hongniang,0,0,0,,Maomao, zaprowadzę cię do pokoju.
Dialogue: 0,0:05:57.08,0:05:58.33,Default,Maomao,0,0,0,,A, jasne.
Dialogue: 0,0:06:01.68,0:06:04.40,Default,Yinghua,0,0,0,,Widziałyście jej lewą rękę?
Dialogue: 0,0:06:04.40,0:06:08.16,Default,Yinghua,0,0,0,,Zasłania ją bandażami,\Nale pod spodem ma blizny, prawda?
Dialogue: 0,0:06:08.16,0:06:10.92,Default,Guiyuan,0,0,0,,Pewnie była torturowana przez rodzinę
Dialogue: 0,0:06:10.92,0:06:13.36,Default,Guiyuan,0,0,0,,i sprzedana do wewnętrznego pałacu…
Dialogue: 0,0:06:13.36,0:06:16.98,Default,Ailan,0,0,0,,Do tego jeszcze ta okropna praca...
Dialogue: 0,0:06:17.69,0:06:20.90,Default,Three Ladies-in-waiting,0,0,0,,Ale z niej biedaczysko!
Dialogue: 0,0:06:23.17,0:06:25.74,Default,Hongniang,0,0,0,,Odpocznij sobie,\Naż nie zostaniesz wezwana, dobrze?
Dialogue: 0,0:06:25.74,0:06:26.81,Default,Maomao,0,0,0,,Ale…
Dialogue: 0,0:06:32.76,0:06:35.91,Default,Maomao,0,0,0,,Udało mi się awansować.
Dialogue: 0,0:06:37.55,0:06:40.52,Default,Maomao,0,0,0,,Jadeitowy Pałac od zawsze\Nbył miejscem rządzonym przez wybrańców.
Dialogue: 0,0:06:40.52,0:06:44.13,Default,Maomao,0,0,0,,To oczywiste, że świeżak\Nnie jest mile widziany.
Dialogue: 0,0:06:44.84,0:06:46.30,Default,Maomao,0,0,0,,Ale wszystkie wyglądały tak…
Dialogue: 0,0:06:48.24,0:06:51.95,Default,Maomao,0,0,0,,Życzliwie? Dlaczego?
Dialogue: 0,0:06:53.92,0:06:55.18,Default,Jinshi,0,0,0,,Testerka trucizn.
Dialogue: 0,0:06:55.73,0:06:58.39,Default,Jinshi,0,0,0,,To twoja robota, zielareczko.
Dialogue: 0,0:06:59.37,0:07:02.40,Default,Maomao,0,0,0,,Trucizny! Testerka trucizn!
Dialogue: 0,0:07:04.03,0:07:05.11,Default,Maomao,0,0,0,,Uspokój się.
Dialogue: 0,0:07:06.81,0:07:13.04,Default,Jinshi,0,0,0,,Jej posiłki przechodzą przez wiele rąk,\Nzanim w ogóle tutaj trafią.
Dialogue: 0,0:07:15.33,0:07:19.33,Default,Jinshi,0,0,0,,Istnieje możliwość, że ktoś\Nzatruje je podczas tej drogi.
Dialogue: 0,0:07:20.40,0:07:23.11,Default,Jinshi,0,0,0,,Co więcej, gdy konkubina\NGyokuyou zaszła w ciążę,
Dialogue: 0,0:07:23.62,0:07:25.67,Default,Jinshi,0,0,0,,jej jedzenie zatruto\Nprzynajmniej dwa razy.
Dialogue: 0,0:07:26.68,0:07:32.47,Default,Jinshi,0,0,0,,Poprzednia testerka ma uszkodzone nerwy\Ni do dziś nie rusza rękami i nogami.
Dialogue: 0,0:07:33.77,0:07:37.34,Default,Maomao,0,0,0,,To ma sens.\NTo tłumaczy ich troskę.
Dialogue: 0,0:07:38.26,0:07:41.29,Default,Hongniang,0,0,0,,A więc… Proszę.
Dialogue: 0,0:07:42.83,0:07:44.48,Default,Maomao,0,0,0,,Te miseczki…
Dialogue: 0,0:07:45.98,0:07:49.86,Default,Maomao,0,0,0,,Kolor normalny.\NŻadnego dziwnego zapachu.
Dialogue: 0,0:07:52.62,0:07:53.99,Default,Maomao,0,0,0,,Nic nie drętwieje.
Dialogue: 0,0:07:56.33,0:07:58.49,Default,Maomao,0,0,0,,Nie wyczułam tu żadnej trucizny.
Dialogue: 0,0:08:00.67,0:08:06.17,Default,Maomao,0,0,0,,Kiedy mieszkałam w dzielnicy uciech,\Nrobiłam wiele testów na swojej ręce.
Dialogue: 0,0:08:07.50,0:08:09.67,Default,Luomen,0,0,0,,Walnięty naukowiec.
Dialogue: 0,0:08:10.19,0:08:15.69,Default,Maomao,0,0,0,,Od dawna testowałam na sobie trucizny,\Nwięc wiele z nich na mnie nie działa.
Dialogue: 0,0:08:15.69,0:08:18.35,Default,Maomao,0,0,0,,Szczerze mówiąc,\Nnie nadaję się na testerkę.
Dialogue: 0,0:08:19.40,0:08:23.57,Default,Maomao,0,0,0,,W pewnym sensie\Nta praca to dar od losu.
Dialogue: 0,0:08:25.04,0:08:26.42,Default,Jinshi,0,0,0,,Śmieje się…
Dialogue: 0,0:08:27.99,0:08:32.99,Default,Maomao,0,0,0,,Warto wymienić zastawę na srebrną,\Nponieważ reaguje na niektóre trucizny.
Dialogue: 0,0:08:33.44,0:08:39.99,Default,Hongniang,0,0,0,,To właśnie mistrz Jinshi powiedział,\Nbyśmy użyły ceramiki, by cię sprawdzić.
Dialogue: 0,0:08:41.87,0:08:43.68,Default,Maomao,0,0,0,,A więc to jego sprawka!
Dialogue: 0,0:08:45.33,0:08:48.46,Default,Hongniang,0,0,0,,Naprawdę znasz się nie tylko\Nna truciznach, ale i medykamentach.
Dialogue: 0,0:08:48.46,0:08:51.20,Default,Maomao,0,0,0,,Pracowałam kiedyś jako zielarka.
Dialogue: 0,0:08:51.20,0:08:56.11,Default,Hongniang,0,0,0,,Gdybyś wcześniej powiedziała, że umiesz\Nczytać i pisać, to więcej byś zarobiła.
Dialogue: 0,0:08:56.11,0:08:58.28,Default,Maomao,0,0,0,,Zostałam porwana i sprzedana tutaj,
Dialogue: 0,0:08:58.28,0:09:04.39,Default,Maomao,0,0,0,,a porywacze dostają część mojego\Nwynagrodzenia, co bardzo mnie wkurza.
Dialogue: 0,0:09:05.00,0:09:10.80,Default,Hongniang,0,0,0,,Czyli wolisz dostać mniej, niż oddać\Nporywaczom pieniądze na picie, co?
Dialogue: 0,0:09:20.66,0:09:23.98,Default,Hongniang,0,0,0,,Rany, ale to było drogie.
Dialogue: 0,0:09:24.52,0:09:27.40,Default,Hongniang,0,0,0,,Z aktualną pensją nie stać cię na to.
Dialogue: 0,0:09:27.40,0:09:30.00,Default,Hongniang,0,0,0,,Teraz nie będziesz mogła\Nwysyłać pieniędzy rodzinie.
Dialogue: 0,0:09:30.81,0:09:33.34,Default,Hongniang,0,0,0,,I w sumie będziemy\Nmusieli ich obciążyć.
Dialogue: 0,0:09:34.84,0:09:38.08,Default,Maomao,0,0,0,,Najmocniej przepraszam.
Dialogue: 0,0:09:38.49,0:09:40.97,Default,Maomao,0,0,0,,Proszę, odlicz to\Nod części przesyłanej rodzinie.
Dialogue: 0,0:09:40.97,0:09:42.97,Default,Maomao,0,0,0,,Skoro to za mało,\Nto z moich własnych też.
Dialogue: 0,0:09:43.81,0:09:46.24,Default,Hongniang,0,0,0,,Tak, zajmę się formalnościami.
Dialogue: 0,0:09:46.80,0:09:52.27,Default,Hongniang,0,0,0,,Tak przy okazji,\Noto dodatkowa zapłata za testowanie.
Dialogue: 0,0:09:52.93,0:09:55.23,Default,Maomao,0,0,0,,To prawie tyle, co moja zwykła pensja…
Dialogue: 0,0:09:55.23,0:09:59.41,Default,Maomao,0,0,0,,I z tego ci bandyci nie dostaną\Nani grosza, całość jest moja.
Dialogue: 0,0:10:00.65,0:10:02.37,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:10:03.87,0:10:06.69,Default,Maomao,0,0,0,,Zna metodę kija i marchewki.
Dialogue: 0,0:10:17.28,0:10:18.51,Default,Yinghua,0,0,0,,Nie martw się!
Dialogue: 0,0:10:19.20,0:10:20.30,Default,Guiyuan,0,0,0,,Odpocznij sobie.
Dialogue: 0,0:10:20.30,0:10:22.30,Default,Ailan,0,0,0,,Zawsze miałyśmy\Ndość rąk do pracy.
Dialogue: 0,0:10:22.30,0:10:24.56,Default,Maomao,0,0,0,,Nudzę się!
Dialogue: 0,0:10:25.24,0:10:30.90,Default,Maomao,0,0,0,,Jako testerka jestem wzywana\Nna dwa posiłki i popołudniową herbatkę.
Dialogue: 0,0:10:30.90,0:10:33.29,Default,Maomao,0,0,0,,Teraz, gdy mam swój własny kąt,
Dialogue: 0,0:10:33.29,0:10:36.47,Default,Maomao,0,0,0,,mogłabym przetestować\Nna sobie działanie jadu węża.
Dialogue: 0,0:10:36.47,0:10:37.66,Default,Hongniang,0,0,0,,Maomao.
Dialogue: 0,0:10:39.43,0:10:41.96,Default,Maomao,0,0,0,,Wzywała mnie pani?
Dialogue: 0,0:10:41.96,0:10:43.66,Default,Gyokuyou,0,0,0,,Można tak powiedzieć.
Dialogue: 0,0:10:45.57,0:10:46.66,Default,Maomao,0,0,0,,Fujka.
Dialogue: 0,0:10:47.60,0:10:48.96,Default,Jinshi,0,0,0,,Czemu to na nią nie działa?
Dialogue: 0,0:10:54.14,0:10:55.96,Default,Maomao,0,0,0,,W czym mogę panu dzisiaj służyć?
Dialogue: 0,0:10:56.75,0:11:00.68,Default,Jinshi,0,0,0,,Dostałem je od pewnego oficera.\NCzy mogłabyś ich spróbować?
Dialogue: 0,0:11:01.13,0:11:02.30,Default,Maomao,0,0,0,,Bułeczki Baozi…
Dialogue: 0,0:11:07.80,0:11:09.52,Default,Maomao,0,0,0,,Nafaszerowane afrodyzjakiem.
Dialogue: 0,0:11:10.36,0:11:11.98,Default,Jinshi,0,0,0,,Wyczułaś to bez spróbowania?
Dialogue: 0,0:11:11.98,0:11:15.91,Default,Maomao,0,0,0,,Nie są szkodliwe.\NProszę, rozkoszuj się nimi.
Dialogue: 0,0:11:15.91,0:11:19.93,Default,Jinshi,0,0,0,,Zważywszy na to, od kogo\Nje otrzymałem, nie zrobię tego.
Dialogue: 0,0:11:19.93,0:11:24.62,Default,Maomao,0,0,0,,Możliwe, że odwiedzi cię dziś wieczorem.
Dialogue: 0,0:11:24.89,0:11:27.24,Default,Jinshi,0,0,0,,A więc da się to poznać\Npo samym zapachu?
Dialogue: 0,0:11:27.24,0:11:32.46,Default,Maomao,0,0,0,,Usiłował zmusić mnie do zjedzenia tego,\Nwiedząc, że jest tam afrodyzjak?!
Dialogue: 0,0:11:38.94,0:11:41.97,Default,Jinshi,0,0,0,,Mam do ciebie jeszcze jedno pytanie.
Dialogue: 0,0:11:42.32,0:11:44.24,Default,Maomao,0,0,0,,O co chodzi?
Dialogue: 0,0:11:44.24,0:11:49.33,Default,Jinshi,0,0,0,,Pewnego dnia otruto oddział żołnierzy\Nwalczących z barbarzyńcami.
Dialogue: 0,0:11:49.33,0:11:50.33,Default,Maomao,0,0,0,,Otruty?
Dialogue: 0,0:11:50.88,0:11:53.14,Default,Jinshi,0,0,0,,Kilka osób zachorowało po posiłku.
Dialogue: 0,0:11:53.14,0:11:57.50,Default,Jinshi,0,0,0,,Mieli nudności, trudności\Nw oddychaniu i inne dolegliwości.
Dialogue: 0,0:11:57.93,0:12:00.49,Default,Maomao,0,0,0,,Mdłości i duszności…
Dialogue: 0,0:12:01.61,0:12:03.86,Default,Jinshi,0,0,0,,Posiłek przygotowano\Nw pobliskiej wiosce.
Dialogue: 0,0:12:04.67,0:12:07.87,Default,Jinshi,0,0,0,,Aresztowano przywódcę wioski\Npod zarzutem wspierania barbarzyńców,
Dialogue: 0,0:12:07.87,0:12:09.91,Default,Jinshi,0,0,0,,ale oficer załagodził sytuację
Dialogue: 0,0:12:09.91,0:12:11.58,Default,Jinshi,0,0,0,,i odroczył decyzję.
Dialogue: 0,0:12:12.27,0:12:17.77,Default,Maomao,0,0,0,,Normalnym odruchem byłoby przyjęcie,\Nże wieśniacy otruli żołnierzy, ale…
Dialogue: 0,0:12:20.05,0:12:23.38,Default,Maomao,0,0,0,,Panie Jinshi.\NGdzie spożywali posiłek?
Dialogue: 0,0:12:23.38,0:12:25.64,Default,Jinshi,0,0,0,,Przebywali w obozie,\Nwięc zapewne na uboczu.
Dialogue: 0,0:12:25.64,0:12:28.95,Default,Maomao,0,0,0,,Czy mieszkańcy wioski\Ndostarczyli talerze i pałeczki?
Dialogue: 0,0:12:28.95,0:12:32.68,Default,Jinshi,0,0,0,,Nie, żołnierze powinni mieć własne.
Dialogue: 0,0:12:33.96,0:12:35.42,Default,Jinshi,0,0,0,,Coś ci przyszło do głowy?
Dialogue: 0,0:12:36.40,0:12:39.71,Default,Maomao,0,0,0,,To tylko moje domysły,\Nale podzielę się nimi.
Dialogue: 0,0:12:40.74,0:12:43.15,Default,Maomao,0,0,0,,To jest azalia japońska.
Dialogue: 0,0:12:44.25,0:12:45.84,Default,Gyokuyou,0,0,0,,Jest smaczna?
Dialogue: 0,0:12:45.84,0:12:49.65,Default,Maomao,0,0,0,,Nie, jej spożycie\Nwywołuje mdłości i duszności.
Dialogue: 0,0:12:49.65,0:12:50.66,Default,Jinshi,0,0,0,,Ej!
Dialogue: 0,0:12:51.26,0:12:55.56,Default,Maomao,0,0,0,,Jak widać, nawet tutaj\Nznajdują się trujące rośliny.
Dialogue: 0,0:12:55.56,0:12:59.87,Default,Maomao,0,0,0,,Trucizna występuje w liściach, ale też\Nmoże być w korzeniach i łodygach.
Dialogue: 0,0:12:59.87,0:13:04.08,Default,Maomao,0,0,0,,Ponadto spalanie niektórych typów\Ndrewna powoduje wydzielanie trucizny.
Dialogue: 0,0:13:04.08,0:13:05.71,Default,Gyokuyou,0,0,0,,Spalanie?
Dialogue: 0,0:13:09.57,0:13:10.81,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:13:11.95,0:13:14.45,Default,Maomao,0,0,0,,Całe szczęście,\Nże na miejscu był oficer.
Dialogue: 0,0:13:14.45,0:13:17.34,Default,Maomao,0,0,0,,Niewykluczone,\Nże stracilibyśmy całą wioskę.
Dialogue: 0,0:13:17.79,0:13:18.82,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:13:19.29,0:13:21.62,Default,Maomao,0,0,0,,Jeśli to wszystko,\Nto już sobie pójdę.
Dialogue: 0,0:13:21.62,0:13:23.22,Default,Jinshi,0,0,0,,Nie tak szybko.
Dialogue: 0,0:13:23.22,0:13:24.57,Default,Maomao,0,0,0,,Potrzebujesz coś jeszcze?
Dialogue: 0,0:13:27.54,0:13:29.66,Default,Jinshi,0,0,0,,Umiesz sporządzić afrodyzjak?
Dialogue: 0,0:13:31.26,0:13:33.12,Default,Maomao,0,0,0,,Sporządzić? Znaczy się…
Dialogue: 0,0:13:34.36,0:13:36.54,Default,Maomao,0,0,0,,Zrobić lekarstwa?!
Dialogue: 0,0:13:42.32,0:13:45.00,Default,Maomao,0,0,0,,Jeśli znajdę czas,\Nsprzęt i odpowiednie składniki,
Dialogue: 0,0:13:45.00,0:13:48.05,Default,Maomao,0,0,0,,myślę, że dałabym radę.
Dialogue: 0,0:13:49.25,0:13:51.76,Default,Mid-Rank Concubine,0,0,0,,Panie Jinshi.\NGdzie się wybierasz?
Dialogue: 0,0:13:54.80,0:13:58.65,Default,Jinshi,0,0,0,,Wracam do swojego biura.\NW czym mogę pomóc?
Dialogue: 0,0:13:58.65,0:14:01.72,Default,Mid-Rank Concubine,0,0,0,,Myślałam, że może\Nnapiłbyś się ze mną herbatki?
Dialogue: 0,0:14:01.72,0:14:05.40,Default,Jinshi,0,0,0,,Niestety, mam dużo pracy.\NBardzo przepraszam.
Dialogue: 0,0:14:10.73,0:14:13.41,Default,Gaoshun,0,0,0,,Służba nie ma bladego pojęcia,
Dialogue: 0,0:14:13.73,0:14:18.50,Default,Gaoshun,0,0,0,,że pan Jinshi sprawdza\Nich lojalność wobec cesarza.
Dialogue: 0,0:14:18.50,0:14:20.66,Default,Jinshi,0,0,0,,Nie powinna uwodzić innych mężczyzn
Dialogue: 0,0:14:20.66,0:14:22.89,Default,Jinshi,0,0,0,,tylko dlatego, że cesarz \Njej nie odwiedza.
Dialogue: 0,0:14:22.89,0:14:24.53,Default,Jinshi,0,0,0,,Co za bezczelność.
Dialogue: 0,0:14:24.53,0:14:25.97,Default,Gaoshun,0,0,0,,Zgadzam się.
Dialogue: 0,0:14:25.97,0:14:30.52,Default,Jinshi,0,0,0,,Konkubina to nie tylko piękno\Nczy dobre wykształcenie.
Dialogue: 0,0:14:30.52,0:14:34.53,Default,Jinshi,0,0,0,,Muszą być lojalne wobec cesarza\Ni dochować czystości.
Dialogue: 0,0:14:34.96,0:14:40.69,Default,Gaoshun,0,0,0,,Więc wysłał cię do wewnętrznego\Npałacu w celu weryfikacji…
Dialogue: 0,0:14:41.31,0:14:43.52,Default,Gaoshun,0,0,0,,Czasami potrafi być podły.
Dialogue: 0,0:14:43.52,0:14:46.44,Default,Jinshi,0,0,0,,Wszyscy wykorzystujemy\Nwszelkie środki. Ale…
Dialogue: 0,0:14:46.44,0:14:50.03,Default,Jinshi,0,0,0,,Ona nie tylko mnie nie pragnie,\Nale jeszcze ten wzrok…
Dialogue: 0,0:14:50.03,0:14:52.49,Default,Maomao,0,0,0,,Oblech…
Dialogue: 0,0:14:53.20,0:14:56.72,Default,Jinshi,0,0,0,,Jeszcze nigdy w życiu\Nnikt tak na mnie nie spojrzał.
Dialogue: 0,0:14:57.72,0:14:59.89,Default,Gaoshun,0,0,0,,Także… proszę mi wybaczyć.
Dialogue: 0,0:15:05.13,0:15:07.47,Default,Maomao,0,0,0,,Możliwe, że odwiedzi cię dziś wieczorem.
Dialogue: 0,0:15:07.47,0:15:10.37,Default,Maomao,0,0,0,,Dziś wieczorem… wieczorem…
Dialogue: 0,0:15:13.51,0:15:15.31,Default,Maomao,0,0,0,,Więc będę lecieć.
Dialogue: 0,0:15:15.31,0:15:17.30,Default,Hongniang,0,0,0,,Powodzenia.
Dialogue: 0,0:15:17.30,0:15:18.39,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:15:24.06,0:15:25.60,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:15:26.07,0:15:28.29,Default,Maomao,0,0,0,,To ten konował i…
Dialogue: 0,0:15:29.47,0:15:32.00,Default,Gaoshun,0,0,0,,Panno Maomao.\NPrzedstawię się raz jeszcze.
Dialogue: 0,0:15:32.00,0:15:33.50,Default,Gaoshun,0,0,0,,Jestem Gaoshun.
Dialogue: 0,0:15:34.11,0:15:36.53,Default,Gaoshun,0,0,0,,Asystent pana Jinshiego.
Dialogue: 0,0:15:37.13,0:15:38.70,Default,Gaoshun,0,0,0,,Miło mi cię poznać.
Dialogue: 0,0:15:39.66,0:15:40.71,Default,Maomao,0,0,0,,Dobry.
Dialogue: 0,0:15:41.00,0:15:43.77,Default,Maomao,0,0,0,,Podziwiam, że z nim wytrzymuje.
Dialogue: 0,0:15:44.58,0:15:48.96,Default,Guen,0,0,0,,Co ta służka robi na moim terenie?
Dialogue: 0,0:15:50.30,0:15:51.52,Default,Gaoshun,0,0,0,,Tędy, proszę.
Dialogue: 0,0:15:54.52,0:15:58.52,Default,Gaoshun,0,0,0,,Możesz używać wszystkiego,\Nco się tu znajduje.
Dialogue: 0,0:16:09.28,0:16:11.70,Default,Jinshi,0,0,0,,Próbujesz rzucić na kogoś urok?
Dialogue: 0,0:16:15.32,0:16:19.37,Default,Maomao,0,0,0,,To luksus mieć papier do dyspozycji.
Dialogue: 0,0:16:19.62,0:16:21.55,Default,Maomao,0,0,0,,Poza tym potrzebuję…
Dialogue: 0,0:16:22.56,0:16:24.05,Default,Gaoshun,0,0,0,,Zaraz przyniosę.
Dialogue: 0,0:16:25.33,0:16:29.34,Default,Maomao,0,0,0,,Całkiem szybko łapie.\NW przeciwieństwie do niego…
Dialogue: 0,0:16:30.89,0:16:33.34,Default,Maomao,0,0,0,,Skoro nie masz nic do roboty, to spadaj.
Dialogue: 0,0:16:33.34,0:16:34.39,Default,Gaoshun,0,0,0,,Proszę.
Dialogue: 0,0:16:35.71,0:16:37.43,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:16:38.69,0:16:39.98,Default,Maomao,0,0,0,,Nie starczy.
Dialogue: 0,0:16:41.42,0:16:42.58,Default,Jinshi,0,0,0,,Co to jest?
Dialogue: 0,0:16:42.58,0:16:43.80,Default,Maomao,0,0,0,,To kakałko.
Dialogue: 0,0:16:43.80,0:16:46.77,Default,Jinshi,0,0,0,,Jeżeli potrzeba więcej,\Nz łatwością zdobędziemy więcej.
Dialogue: 0,0:16:46.77,0:16:50.90,Default,Maomao,0,0,0,,Ale pochodzi on z dalekiego\Nrejonu na południowym zachodzie.
Dialogue: 0,0:16:50.90,0:16:54.03,Default,Jinshi,0,0,0,,Z pewnością jest tego więcej\Nw magazynie handlowym.
Dialogue: 0,0:17:01.32,0:17:06.53,Default,Maomao,0,0,0,,Mleko, masło, cukier,\Nmiód i kakao w proszku.
Dialogue: 0,0:17:07.04,0:17:08.67,Default,Maomao,0,0,0,,To powinno wystarczyć.
Dialogue: 0,0:17:09.31,0:17:11.10,Default,Yinghua,0,0,0,,Patrzcie jaka burżuazja.
Dialogue: 0,0:17:11.10,0:17:13.57,Default,Ailan,0,0,0,,Co ona może kombinować?
Dialogue: 0,0:17:13.57,0:17:15.13,Default,Guiyuan,0,0,0,,Może jakieś łakocie?
Dialogue: 0,0:17:15.38,0:17:17.34,Default,Hongniang,0,0,0,,A panienki co tu robią?
Dialogue: 0,0:17:17.64,0:17:19.35,Default,Hongniang,0,0,0,,Wracać do pracy!
Dialogue: 0,0:17:19.35,0:17:21.10,Default,Three Ladies-in-waiting,0,0,0,,Przepraszamy!
Dialogue: 0,0:17:22.41,0:17:23.45,Default,Hongniang,0,0,0,,Boże.
Dialogue: 0,0:17:24.53,0:17:26.81,Default,Maomao,0,0,0,,Czas wreszcie zrobić ten afrodyzjak!
Dialogue: 0,0:17:31.05,0:17:33.99,Default,Maomao,0,0,0,,Spróbowałam kakao tylko raz w życiu.
Dialogue: 0,0:17:33.99,0:17:37.91,Default,Meimei,0,0,0,,Zwą to „czekoladką”.\NPowiedz „aaa”, Maomao.
Dialogue: 0,0:17:39.68,0:17:41.03,Default,Meimei,0,0,0,,Maomao?!
Dialogue: 0,0:17:43.12,0:17:47.73,Default,Maomao,0,0,0,,Przebiegły klient ofiarował jej kilka,\Nby pozyskać jej względy.
Dialogue: 0,0:17:47.73,0:17:51.85,Default,Maomao,0,0,0,,Jednak cwana starucha powiedziała,\Nże go wykastruje, jak znów go zobaczy.
Dialogue: 0,0:17:52.30,0:17:53.68,Default,Maomao,0,0,0,,Wygląda nieźle.
Dialogue: 0,0:17:53.68,0:17:55.26,Default,Maomao,0,0,0,,I już.
Dialogue: 0,0:17:57.10,0:17:59.51,Default,Maomao,0,0,0,,Zostawiamy do ostygnięcia.
Dialogue: 0,0:18:00.30,0:18:03.31,Default,Maomao,0,0,0,,Trochę mi zostało. Już wiem.
Dialogue: 0,0:18:05.56,0:18:07.98,Default,Maomao,0,0,0,,Te nie muszą stygnąć.
Dialogue: 0,0:18:10.52,0:18:13.04,Default,Maomao,0,0,0,,Dobra, to teraz sprzątanko.
Dialogue: 0,0:18:17.95,0:18:19.79,Default,Maomao,0,0,0,,Chwila, ziółka?
Dialogue: 0,0:18:19.79,0:18:22.49,Default,Maomao,0,0,0,,Tu i tu, i tutaj też!
Dialogue: 0,0:18:24.70,0:18:27.21,Default,Maomao,0,0,0,,Trochę mnie poniosło.
Dialogue: 0,0:18:27.21,0:18:29.23,Default,Maomao,0,0,0,,Przepraszam za spóźnienie!
Dialogue: 0,0:18:41.27,0:18:43.41,Default,Jinshi,0,0,0,,Przynajmniej wiemy, że działa.
Dialogue: 0,0:18:44.00,0:18:45.89,Default,Hongniang,0,0,0,,Co tu się dzieje?!
Dialogue: 0,0:18:46.24,0:18:48.39,Default,Maomao,0,0,0,,Nic więcej nie powiem.
Dialogue: 0,0:18:49.42,0:18:51.65,Default,Maomao,0,0,0,,Żadnych ofiar śmiertelnych…
Dialogue: 0,0:18:54.16,0:18:56.28,Default,Gyokuyou,0,0,0,,A więc to jest ten afrodyzjak?
Dialogue: 0,0:18:56.28,0:18:59.11,Default,Maomao,0,0,0,,Nie, to jest to.
Dialogue: 0,0:19:00.57,0:19:02.45,Default,Jinshi,0,0,0,,Więc co to jest?
Dialogue: 0,0:19:02.45,0:19:03.99,Default,Maomao,0,0,0,,Moja dzisiejsza kolacja.
Dialogue: 0,0:19:05.70,0:19:07.96,Default,Maomao,0,0,0,,Jeśli ktoś nawykł do alkoholu i używek,
Dialogue: 0,0:19:07.96,0:19:09.79,Default,Maomao,0,0,0,,to działanie nie będzie aż tak duże.
Dialogue: 0,0:19:10.05,0:19:14.13,Default,Jinshi,0,0,0,,Czyli nie będzie problemu, \Njeśli to zjem?
Dialogue: 0,0:19:14.13,0:19:16.17,Default,Gaoshun & Hongniang,0,0,0,,Proszę, nie rób tego!
Dialogue: 0,0:19:17.92,0:19:19.59,Default,Jinshi,0,0,0,,Żartowałem.
Dialogue: 0,0:19:19.59,0:19:23.70,Default,Maomao,0,0,0,,Cóż za karygodny żart\Nprzy ulubienicy cesarza.
Dialogue: 0,0:19:23.70,0:19:28.08,Default,Maomao,0,0,0,,Trudno mi to przyznać,\Nale z taką anielską twarzyczką…
Dialogue: 0,0:19:30.04,0:19:33.81,Default,Maomao,0,0,0,,Zachwyciłby każdego\Nbez względu na płeć.
Dialogue: 0,0:19:33.81,0:19:35.40,Default,Maomao,0,0,0,,W końcu ma ładną twarzyczkę.
Dialogue: 0,0:19:36.52,0:19:40.15,Default,Maomao,0,0,0,,Jako że to silny środek,\Nspożywa się go tylko raz na dobę.
Dialogue: 0,0:19:40.15,0:19:43.87,Default,Maomao,0,0,0,,Przedawkowanie może wywołać\Nskok ciśnienia i krwotok z nosa.
Dialogue: 0,0:19:44.16,0:19:48.68,Default,Gyokuyou,0,0,0,,Może mogłabyś zrobić trochę\Ndla cesarza, by uniknąć nudy.
Dialogue: 0,0:19:48.68,0:19:52.41,Default,Maomao,0,0,0,,Jego działanie jest trzykrotnie\Nsilniejsze od zwykłego toniku.
Dialogue: 0,0:19:53.05,0:19:56.31,Default,Gyokuyou,0,0,0,,Trzy razy?\NCzy jej chodzi o czas działania?
Dialogue: 0,0:19:56.80,0:19:59.05,Default,Maomao,0,0,0,,Udam, że nic nie słyszałam.
Dialogue: 0,0:19:59.40,0:20:04.44,Default,Maomao,0,0,0,,— Pamiętaj też, by używać tego\Ntylko wtedy, gdy jesteś sam na sam.
Dialogue: 0,0:19:59.40,0:20:04.81,Default,Gyokuyou,0,0,0,,{\an8}— Trzy razy… Trzy razy…
Dialogue: 0,0:20:04.44,0:20:05.49,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:20:06.50,0:20:09.60,Default,Gyokuyou,0,0,0,,Pójdę już sobie.
Dialogue: 0,0:20:12.82,0:20:15.61,Default,Hongniang,0,0,0,,Więc ona umie robić lekarstwa?
Dialogue: 0,0:20:16.15,0:20:17.66,Default,Gyokuyou,0,0,0,,Jest niezawodna.
Dialogue: 0,0:20:22.40,0:20:23.78,Default,Maomao,0,0,0,,Nareszcie koniec.
Dialogue: 0,0:20:29.55,0:20:31.54,Default,Jinshi,0,0,0,,Dobra robota.
Dialogue: 0,0:20:39.39,0:20:40.46,Default,Jinshi,0,0,0,,Dziękuję.
Dialogue: 0,0:20:46.52,0:20:47.76,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:20:48.47,0:20:50.72,Default,Maomao,0,0,0,,Oby nie było żadnych ofiar.
Dialogue: 0,0:22:34.95,0:22:36.95,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:45.34,0:22:47.67,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Duch w świetle księżyca”.
Dialogue: 0,0:22:47.69,0:22:49.29,Default,,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
