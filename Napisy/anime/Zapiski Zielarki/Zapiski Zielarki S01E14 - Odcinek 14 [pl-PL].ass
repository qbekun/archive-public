Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:03:02.57,0:03:06.54,Default,Text,0,0,0,,{\an8}ODCINEK 14: NOWA CZYSTA DAMA
Dialogue: 0,0:03:07.78,0:03:09.39,Default,Hongniang,0,0,0,,Poważnie?
Dialogue: 0,0:03:09.39,0:03:10.41,Default,Gyokuyou,0,0,0,,Oczywiście.
Dialogue: 0,0:03:10.76,0:03:13.99,Default,Gyokuyou,0,0,0,,Maomao wróciła,\Nwięc trzeba ten fakt jak najlepiej.
Dialogue: 0,0:03:18.34,0:03:20.36,Default,Maomao,0,0,0,,Na razie tyle styknie.
Dialogue: 0,0:03:20.36,0:03:25.04,Default,Maomao,0,0,0,,W przeciwieństwie do wewnętrznego pałacu,\Ntutaj nie rosną prawie żadne zioła.
Dialogue: 0,0:03:25.04,0:03:27.13,Default,Maomao,0,0,0,,Trzeba to naprawić.
Dialogue: 0,0:03:27.13,0:03:28.50,Default,Suiren,0,0,0,,Xiaomao.
Dialogue: 0,0:03:28.85,0:03:32.98,Default,Suiren,0,0,0,,Chyba poprosiłam cię\No posprzątanie gabinetu.
Dialogue: 0,0:03:32.98,0:03:34.60,Default,Maomao,0,0,0,,Już pędzę!
Dialogue: 0,0:03:35.72,0:03:38.53,Default,Suiren,0,0,0,,Nie trać tyle czasu na uprawę roślin.
Dialogue: 0,0:03:39.06,0:03:40.14,Default,Maomao,0,0,0,,Twarda sztuka.
Dialogue: 0,0:03:41.02,0:03:42.88,Default,Jinshi,0,0,0,,O co chodzi?
Dialogue: 0,0:03:42.88,0:03:43.70,Default,Gaoshun,0,0,0,,Nie mam pojęcia.
Dialogue: 0,0:03:43.70,0:03:46.66,Default,Text,0,0,0,,{\an8}KRYSZTAŁOWY PAŁAC\NMĄDRA DAMA, LI HUA
Dialogue: 0,0:03:43.70,0:03:46.66,Default,Text,0,0,0,,{\an8}JADEITOWY PAŁAC\NSZLACHETNA DAMA, GYOKUYOU
Dialogue: 0,0:03:47.67,0:03:48.81,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:03:50.21,0:03:50.91,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:03:56.15,0:04:00.32,Default,Jinshi,0,0,0,,Słyszałaś o nowej Czystej Damie,\Nktóra pojawiła się w Granatowym Pałacu?
Dialogue: 0,0:04:00.32,0:04:01.22,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:04:01.58,0:04:04.38,Default,Maomao,0,0,0,,Następczyni konkubiny A Duo,\Nktóra opuściła pałac.
Dialogue: 0,0:04:07.16,0:04:11.48,Default,Jinshi,0,0,0,,Cóż, wewnętrzny pałac\Nchce trochę ją podszkolić.
Dialogue: 0,0:04:12.56,0:04:15.35,Default,Jinshi,0,0,0,,I z jakiegoś powodu chcą,\Nbyś ty się tym zajęła.
Dialogue: 0,0:04:14.77,0:04:16.27,Default,Text,0,0,0,,{\an8}NAUCZYCIELKA\NMAOMAO
Dialogue: 0,0:04:17.78,0:04:19.78,Default,Maomao,0,0,0,,Świetny żart.
Dialogue: 0,0:04:19.78,0:04:24.01,Default,Jinshi,0,0,0,,To nie żart.\NSpójrz, kto cię polecił.
Dialogue: 0,0:04:24.01,0:04:24.99,Default,Maomao,0,0,0,,Polecił?
Dialogue: 0,0:04:24.99,0:04:27.45,Default,Text,0,0,0,,{\an8}SZLACHETNA DAMA\NGYOKUYOU
Dialogue: 0,0:04:27.45,0:04:29.05,Default,Jinshi,0,0,0,,I jeszcze jeden.
Dialogue: 0,0:04:29.99,0:04:32.00,Default,Text,0,0,0,,{\an8}MĄDRA DAMA\NLI HUA
Dialogue: 0,0:04:32.00,0:04:33.94,Default,Maomao,0,0,0,,Pani Li Hua też?
Dialogue: 0,0:04:38.35,0:04:39.43,Default,Maomao,0,0,0,,A więc to tak?
Dialogue: 0,0:04:39.99,0:04:42.09,Default,Jinshi,0,0,0,,W każdym razie liczę na ciebie.
Dialogue: 0,0:04:47.22,0:04:51.56,Default,Maomao,0,0,0,,Nie mogę zignorować\Npróśb dwóch konkubin.
Dialogue: 0,0:04:52.10,0:04:55.80,Default,Maomao,0,0,0,,Przynajmniej dały mi znać,\Nile za to zgarnę.
Dialogue: 0,0:04:56.68,0:05:00.27,Default,Maomao,0,0,0,,Ta starucha na pewno\Npodniosłaby tę cenę.
Dialogue: 0,0:05:05.64,0:05:06.94,Default,Maomao,0,0,0,,To moja szansa...
Dialogue: 0,0:05:08.29,0:05:10.65,Default,Jinshi,0,0,0,,To wszystko to materiały\Ndydaktyczne na zajęcia?
Dialogue: 0,0:05:11.33,0:05:13.94,Default,Maomao,0,0,0,,Tak. A tu jest fakturka.
Dialogue: 0,0:05:15.68,0:05:16.97,Default,Jinshi,0,0,0,,Wygląda na prawdziwą.
Dialogue: 0,0:05:18.07,0:05:21.60,Default,Suiren,0,0,0,,Ciekawe, dlaczego atrament\Nma tutaj inny kolor.
Dialogue: 0,0:05:21.60,0:05:22.25,Default,Maomao,0,0,0,,Jeny!
Dialogue: 0,0:05:23.19,0:05:24.48,Default,Maomao,0,0,0,,To naprawdę twarda sztuka.
Dialogue: 0,0:05:24.48,0:05:28.01,Default,Maomao,0,0,0,,Chyba nie mogę żerować na naszym\Npaniczu, gdy ona jest w pobliżu.
Dialogue: 0,0:05:28.36,0:05:29.72,Default,Jinshi,0,0,0,,Co jest w środku?
Dialogue: 0,0:05:31.51,0:05:34.10,Default,Maomao,0,0,0,,Za kija nie pokażę mu moich\Nprzedmiotów dydaktycznych.
Dialogue: 0,0:05:35.28,0:05:37.39,Default,Jinshi,0,0,0,,Dobra, nie będę patrzył.
Dialogue: 0,0:05:38.89,0:05:41.21,Default,Gaoshun,0,0,0,,Pomóc ci je przenieść?
Dialogue: 0,0:05:41.21,0:05:42.57,Default,Maomao,0,0,0,,Dam sobie radę.
Dialogue: 0,0:05:42.94,0:05:45.59,Default,Maomao,0,0,0,,Jak już muszę to zrobić,\Nto idę na całość.
Dialogue: 0,0:05:48.81,0:05:51.32,Default,Maomao,0,0,0,,Dawno mnie tu nie było.
Dialogue: 0,0:05:51.32,0:05:53.52,Default,Maomao,0,0,0,,Ta dziwna babska aura\Ndziała odprężająco.
Dialogue: 0,0:05:53.52,0:05:54.96,Default,Mid-Level Concubine 1,0,0,0,,{\an8}To pan Jinshi!
Dialogue: 0,0:05:54.96,0:05:57.10,Default,Mid-Level Concubine 2,0,0,0,,Piękny jak zawsze.
Dialogue: 0,0:06:01.20,0:06:03.32,Default,Maomao,0,0,0,,Całkiem niezły tłum.
Dialogue: 0,0:06:03.32,0:06:06.38,Default,Jinshi,0,0,0,,Z całą pewnością doszły\Ndo nich pogłoski o lekcji.
Dialogue: 0,0:06:09.25,0:06:13.63,Default,Jinshi,0,0,0,,Uwaga! W dzisiejszym spotkaniu wezmą\Nudział tylko konkubiny wysokiej rangi.
Dialogue: 0,0:06:13.63,0:06:15.47,Default,Jinshi,0,0,0,,Jeśli to wszystko,\Nmożecie odejść.
Dialogue: 0,0:06:20.88,0:06:23.73,Default,Maomao,0,0,0,,Ten eunuch to jakiś legendarny potwór?
Dialogue: 0,0:06:36.45,0:06:37.70,Default,Maomao,0,0,0,,Nie wolno!
Dialogue: 0,0:06:38.47,0:06:39.29,Default,Jinshi,0,0,0,,Dlaczego?
Dialogue: 0,0:06:39.29,0:06:43.25,Default,Maomao,0,0,0,,Tylko konkubiny wysokiej rangi\Nbiorą udział w lekcji. Sam to powiedziałeś.
Dialogue: 0,0:06:44.22,0:06:47.21,Default,Maomao,0,0,0,,Cholercia, jest silniejszy,\Nniż na to wygląda.
Dialogue: 0,0:06:47.53,0:06:52.06,Default,Maomao,0,0,0,,Będziemy tu mówić o sekretnych\Nsztuczkach przeznaczonych tylko dla kobiet!
Dialogue: 0,0:06:59.33,0:07:01.01,Default,Maomao,0,0,0,,Pani Gyokuyou.
Dialogue: 0,0:07:01.01,0:07:02.99,Default,Maomao,0,0,0,,Piękna jak zawsze.
Dialogue: 0,0:07:02.99,0:07:05.65,Default,Maomao,0,0,0,,Pani Hongniang również się nie zmieniła.
Dialogue: 0,0:07:06.31,0:07:08.94,Default,Maomao,0,0,0,,Pani Li Shu wygląda na podenerwowaną.
Dialogue: 0,0:07:08.94,0:07:13.40,Default,Maomao,0,0,0,,Chyba to normalne, biorąc pod uwagę,\Nże są tu trzy pozostałe konkubiny.
Dialogue: 0,0:07:13.40,0:07:17.41,Default,Maomao,0,0,0,,Tak długo, jak jest z nią testerka,\Nbędzie jej lepiej niż przedtem.
Dialogue: 0,0:07:17.79,0:07:23.69,Default,Maomao,0,0,0,,Pani Li Hua chyba w pełni wróciła\Njuż do swojej ponętnej formy.
Dialogue: 0,0:07:23.69,0:07:26.55,Default,Maomao,0,0,0,,Co? Czy to ta damulka z afery\Nzwiązanej z pudrem do twarzy?
Dialogue: 0,0:07:27.64,0:07:29.42,Default,Maomao,0,0,0,,Nie musi się mnie tak bać.
Dialogue: 0,0:07:30.31,0:07:32.76,Default,Maomao,0,0,0,,I następczyni konkubiny A Duo,
Dialogue: 0,0:07:33.16,0:07:36.44,Default,Maomao,0,0,0,,nowa Czysta Dama, konkubina Loulan.
Dialogue: 0,0:07:36.44,0:07:39.02,Default,Maomao,0,0,0,,Ten krzykliwy południowy\Nstrój to jej normalny ubiór?
Dialogue: 0,0:07:39.73,0:07:44.42,Default,Maomao,0,0,0,,Z rysów widać północne pochodzenie, ale\Nprzez tę tapetę ciężko dostrzec jej twarz.
Dialogue: 0,0:07:47.40,0:07:51.11,Default,Maomao,0,0,0,,Zważywszy na jej wiek, cesarz\Nzapewne spędzi z nią trochę czasu.
Dialogue: 0,0:07:51.52,0:07:55.12,Default,Maomao,0,0,0,,Chyba nie wpłynie to źle na\Nrównowagę w wewnętrznym pałacu.
Dialogue: 0,0:07:56.48,0:07:58.94,Default,Maomao,0,0,0,,Ale kogo to obchodzi.
Dialogue: 0,0:08:00.95,0:08:05.38,Default,Maomao,0,0,0,,Nazywam się Maomao.\NDzisiaj będę waszą nauczycielką.
Dialogue: 0,0:08:06.79,0:08:09.46,Default,Maomao,0,0,0,,Dzisiaj nauczę was sekretnych sztuczek,
Dialogue: 0,0:08:09.46,0:08:12.01,Default,Maomao,0,0,0,,z których korzystają tylko kobiety.
Dialogue: 0,0:08:12.96,0:08:15.48,Default,Maomao,0,0,0,,Nie wolno nikomu ich zdradzać.
Dialogue: 0,0:08:16.93,0:08:19.93,Default,Maomao,0,0,0,,Teraz rozdam wam materiały.
Dialogue: 0,0:08:31.67,0:08:33.11,Default,Gyokuyou,0,0,0,,Rany!
Dialogue: 0,0:08:42.93,0:08:47.69,Default,Lishu,0,0,0,,Rany!
Dialogue: 0,0:09:09.41,0:09:12.48,Default,Gaoshun,0,0,0,,Co się tam dzieje?
Dialogue: 0,0:09:12.48,0:09:13.69,Default,Jinshi,0,0,0,,Nie wiem.
Dialogue: 0,0:09:14.96,0:09:16.66,Default,Maomao,0,0,0,,Uff. Co?
Dialogue: 0,0:09:18.00,0:09:20.12,Default,Jinshi,0,0,0,,Świetna robota. Trochę ci zeszło.
Dialogue: 0,0:09:20.52,0:09:23.03,Default,Maomao,0,0,0,,Z pewnością podsłuchiwał.
Dialogue: 0,0:09:24.23,0:09:25.56,Default,Maomao,0,0,0,,Co się stało?
Dialogue: 0,0:09:27.11,0:09:29.63,Default,Jinshi,0,0,0,,Co tu się stało?
Dialogue: 0,0:09:30.00,0:09:32.09,Default,Gyokuyou,0,0,0,,Żegnaj rutyno!
Dialogue: 0,0:09:32.56,0:09:34.26,Default,Lihua,0,0,0,,Zrób tak, a potem to...
Dialogue: 0,0:09:34.71,0:09:37.19,Default,Lishu,0,0,0,,Nigdy. Przenigdy...
Dialogue: 0,0:09:37.65,0:09:39.14,Default,Kanan,0,0,0,,Pani Li Shu!
Dialogue: 0,0:09:42.08,0:09:44.97,Default,Maomao,0,0,0,,Uczyłam je zgodnie z rozkazem.
Dialogue: 0,0:09:46.37,0:09:50.15,Default,Maomao,0,0,0,,Sprawiłam przyjemność\Nosobom, które mnie poleciły.
Dialogue: 0,0:09:57.98,0:10:02.74,Default,Maomao,0,0,0,,Nie wiedziałam, o czym myśli.
Dialogue: 0,0:10:07.58,0:10:09.26,Default,Maomao,0,0,0,,Wykorzystaj tę wiedzę, jak chcesz.
Dialogue: 0,0:10:09.26,0:10:11.76,Default,Jinshi,0,0,0,,Co dokładnie było na wykładzie?
Dialogue: 0,0:10:11.76,0:10:15.10,Default,Maomao,0,0,0,,Później możesz zapytać cesarza,\Nczy było mu dobrze, czy nie.
Dialogue: 0,0:10:15.10,0:10:15.94,Default,Jinshi,0,0,0,,Ej!
Dialogue: 0,0:10:32.61,0:10:34.31,Default,Maomao,0,0,0,,Padam z nóg.
Dialogue: 0,0:10:37.56,0:10:40.53,Default,Maomao,0,0,0,,Premię mam jak w banku!
Dialogue: 0,0:10:49.62,0:10:51.14,Default,Soldier,0,0,0,,Tędy!
Dialogue: 0,0:11:00.23,0:11:01.81,Default,Maomao,0,0,0,,I nie będę się w to wtrącać.
Dialogue: 0,0:11:01.81,0:11:03.03,Default,Maomao,0,0,0,,Zimno...
Dialogue: 0,0:11:09.18,0:11:11.02,Default,Rikuson,0,0,0,,Panie Lakan! Panie Lakan!
Dialogue: 0,0:11:21.41,0:11:23.78,Default,Rikuson,0,0,0,,Panie Lakan, tu jesteś.
Dialogue: 0,0:11:27.94,0:11:29.68,Default,Rikuson,0,0,0,,Coś godnego uwagi?
Dialogue: 0,0:11:29.68,0:11:32.58,Default,Lakan,0,0,0,,Nie, nic takiego.
Dialogue: 0,0:11:42.97,0:11:45.86,Default,Maomao,0,0,0,,Ciekawe, co to był za hałas tej nocy.
Dialogue: 0,0:11:47.57,0:11:52.23,Default,Maomao,0,0,0,,Jest eunuchem, więc myślałam,\Nże zarządza tylko wewnętrznym pałacem.
Dialogue: 0,0:11:53.30,0:11:57.66,Default,Maomao,0,0,0,,Ale chyba w zewnętrznym\Npałacu też ma co robić.
Dialogue: 0,0:12:01.11,0:12:04.65,Default,Maomao,0,0,0,,To niezły papier. Mogłabym go\Nsprzedać za całkiem niezłą sumkę.
Dialogue: 0,0:12:04.65,0:12:06.41,Default,Maomao,0,0,0,,Szkoda go palić.
Dialogue: 0,0:12:07.91,0:12:11.26,Default,Maomao,0,0,0,,Palarnia śmieci znajduje się\Nprzy budynkach wojskowych...
Dialogue: 0,0:12:11.26,0:12:12.23,Default,Gaoshun,0,0,0,,Xiaomao.
Dialogue: 0,0:12:14.07,0:12:15.42,Default,Gaoshun,0,0,0,,Na zewnątrz jest zimno.
Dialogue: 0,0:12:18.64,0:12:20.09,Default,Maomao,0,0,0,,Dziękuję bardzo.
Dialogue: 0,0:12:20.87,0:12:24.51,Default,Maomao,0,0,0,,Dobra dusza.\NSzkoda, że jest eunuchem.
Dialogue: 0,0:12:28.79,0:12:34.49,Default,Gaoshun,0,0,0,,To od pana Jinshiego!\NTylko go dostarczyłem!
Dialogue: 0,0:12:35.00,0:12:35.90,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:12:36.61,0:12:41.86,Default,Maomao,0,0,0,,Danie służącej ciepłego ubranka\Nteż wymaga pozwolenia? Co za kłopot.
Dialogue: 0,0:12:41.86,0:12:44.78,Default,Maomao,0,0,0,,Dziękuję bardzo, panie Jinshi.
Dialogue: 0,0:12:45.49,0:12:46.87,Default,Jinshi,0,0,0,,Żaden kłopot.
Dialogue: 0,0:12:53.64,0:12:57.24,Default,Maomao,0,0,0,,Zewnętrzny pałac jest kilkakrotnie\Nwiększy od wewnętrznego,
Dialogue: 0,0:12:57.24,0:12:59.50,Default,Maomao,0,0,0,,a jednak rośnie tu mało ziółek.
Dialogue: 0,0:13:00.04,0:13:03.68,Default,Maomao,0,0,0,,Co najwyżej można tu\Nznaleźć mniszek lekarski i piołun,
Dialogue: 0,0:13:03.68,0:13:06.07,Default,Maomao,0,0,0,,których wszędzie jest pełno.
Dialogue: 0,0:13:07.00,0:13:09.64,Default,Maomao,0,0,0,,W zimę ciężko je znaleźć.
Dialogue: 0,0:13:09.64,0:13:12.30,Default,Maomao,0,0,0,,Mogłabym tu zasiać kilka nasionek.
Dialogue: 0,0:13:14.08,0:13:15.64,Default,Maomao,0,0,0,,O, czerwona lilia pajęcza!
Dialogue: 0,0:13:15.64,0:13:17.60,Default,Maomao,0,0,0,,I tutaj! I tu też!
Dialogue: 0,0:13:17.60,0:13:21.36,Default,Maomao,0,0,0,,Będą pyszne,\Njeśli namoczy się cebulkę w wodzie.
Dialogue: 0,0:13:21.36,0:13:26.16,Default,Maomao,0,0,0,,Bo jak nie usunie się z nich\Ntrucizny, to biegunka murowana.
Dialogue: 0,0:13:26.16,0:13:26.86,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:13:27.60,0:13:28.91,Default,Maomao,0,0,0,,To pan Lihaku.
Dialogue: 0,0:13:28.91,0:13:31.55,Default,Maomao,0,0,0,,Jego pasek jest innego koloru.
Dialogue: 0,0:13:31.55,0:13:33.33,Default,Maomao,0,0,0,,Czyżby awansował?
Dialogue: 0,0:13:33.78,0:13:36.71,Default,Lihaku,0,0,0,,O, cześć, panienko.
Dialogue: 0,0:13:37.28,0:13:38.74,Default,Maomao,0,0,0,,Pan Lihaku.
Dialogue: 0,0:13:38.74,0:13:41.00,Default,Lihaku,0,0,0,,Przyszłaś z konkubiną\Nczy coś w tym stylu?
Dialogue: 0,0:13:41.00,0:13:43.34,Default,Lihaku,0,0,0,,Rzadko widuję cię\Npoza wewnętrznym pałacem.
Dialogue: 0,0:13:44.56,0:13:47.34,Default,Maomao,0,0,0,,Jeszcze nie wie, że mnie wylali.
Dialogue: 0,0:13:48.13,0:13:51.82,Default,Maomao,0,0,0,,Pan Lihaku zakochał się\Nw siostrzyczce Pairin,
Dialogue: 0,0:13:51.82,0:13:53.80,Default,Maomao,0,0,0,,jednej z trzech tutejszych\Nksiężniczek.
Dialogue: 0,0:13:53.80,0:13:58.86,Default,Maomao,0,0,0,,Stara się o awans\Ndla swojej ukochanej. Ależ to urocze.
Dialogue: 0,0:13:58.86,0:13:59.86,Default,Lihaku,0,0,0,,Co?
Dialogue: 0,0:14:00.76,0:14:05.93,Default,Maomao,0,0,0,,Opłata za noc z Pairin kosztuje\Npołowę rocznej pensji zwykłego człowieka.
Dialogue: 0,0:14:06.40,0:14:11.79,Default,Maomao,0,0,0,,A że to jest drogi biznes, to wiem,\Nże często odwiedza Grynszpanowy Pawilon,
Dialogue: 0,0:14:11.79,0:14:13.62,Default,Maomao,0,0,0,,by wypić herbatkę ze służącymi.
Dialogue: 0,0:14:14.16,0:14:16.22,Default,Maomao,0,0,0,,Jednak nigdy się na niego nie natknęłam.
Dialogue: 0,0:14:16.22,0:14:20.03,Default,Maomao,0,0,0,,Kiedy człowiek choć raz\Nspróbuje boskiego nektaru,
Dialogue: 0,0:14:20.03,0:14:21.88,Default,Maomao,0,0,0,,zawsze będzie\Npróbował go liznąć.
Dialogue: 0,0:14:23.12,0:14:24.46,Default,Maomao,0,0,0,,Chłopak bardzo się stara.
Dialogue: 0,0:14:24.83,0:14:26.35,Default,Lihaku,0,0,0,,Co jest?
Dialogue: 0,0:14:26.35,0:14:29.53,Default,Maomao,0,0,0,,Nic. Przeniesiono mnie\Nz wewnętrznego pałacu
Dialogue: 0,0:14:29.53,0:14:32.15,Default,Maomao,0,0,0,,na służbę w roli pokojówki\Ndla jednego jegomościa.
Dialogue: 0,0:14:32.64,0:14:36.43,Default,Maomao,0,0,0,,Pokojówki? Kto był\Nna tyle stuknięty, by to zrobić?
Dialogue: 0,0:14:36.43,0:14:38.44,Default,Maomao,0,0,0,,Też się nad tym zastanawiam.
Dialogue: 0,0:14:39.24,0:14:41.82,Default,Maomao,0,0,0,,Tak w ogóle chyba\Njest pan czymś zajęty?
Dialogue: 0,0:14:41.82,0:14:42.98,Default,Lihaku,0,0,0,,Troszeczkę.
Dialogue: 0,0:14:43.56,0:14:46.38,Default,Lihaku,0,0,0,,To tylko niewielki pożar,\Nnietypowy o tej porze roku.
Dialogue: 0,0:14:46.38,0:14:49.49,Default,Lihaku,0,0,0,,Wezwano mnie bym zbadał sprawę,\Nbo nie mogą znaleźć przyczyny.
Dialogue: 0,0:14:49.49,0:14:54.49,Default,Maomao,0,0,0,,Nieznany powód? Zatem to\Npewnie hałas z wczorajszej nocy.
Dialogue: 0,0:14:54.98,0:14:56.44,Default,Maomao,0,0,0,,Ktoś został ranny?
Dialogue: 0,0:14:56.44,0:14:59.77,Default,Lihaku,0,0,0,,Tylko wartownik.\NNie jest poważnie ranny, ale...
Dialogue: 0,0:14:59.77,0:15:02.40,Default,Lihaku,0,0,0,,Ej, nie podchodź za blisko.
Dialogue: 0,0:15:02.40,0:15:03.54,Default,Maomao,0,0,0,,Zrozumiano.
Dialogue: 0,0:15:04.36,0:15:08.55,Default,Maomao,0,0,0,,Myślał, że mnie to nie zainteresuje,\Njak o tym wspomniał?
Dialogue: 0,0:15:10.93,0:15:13.43,Default,Maomao,0,0,0,,Sadza sięgnęła przyległego budynku.
Dialogue: 0,0:15:14.00,0:15:16.68,Default,Maomao,0,0,0,,Wszędzie pełno rozrzuconych kawałków.
Dialogue: 0,0:15:17.02,0:15:20.31,Default,Maomao,0,0,0,,Przypomina to bardziej eksplozję niż pożar.
Dialogue: 0,0:15:21.94,0:15:23.56,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:15:24.23,0:15:27.19,Default,Maomao,0,0,0,,Podejrzewają podpalenie.
Dialogue: 0,0:15:27.19,0:15:32.32,Default,Maomao,0,0,0,,To dlatego jest tu pan Lihaku,\Na nie urzędnik niższej rangi.
Dialogue: 0,0:15:33.36,0:15:35.85,Default,Maomao,0,0,0,,Nie jest to przypadkowy magazyn.
Dialogue: 0,0:15:35.85,0:15:38.20,Default,Maomao,0,0,0,,To pałac, w którym przebywa cesarz.
Dialogue: 0,0:15:39.70,0:15:46.94,Default,Maomao,0,0,0,,W całym kraju panuje ogólny pokój,\Nale zawsze znajdzie się ktoś niezadowolony.
Dialogue: 0,0:15:47.99,0:15:50.72,Default,Maomao,0,0,0,,Od czasu do czasu\Nzdarzają się ataki barbarzyńców
Dialogue: 0,0:15:50.72,0:15:53.90,Default,Maomao,0,0,0,,lub też czasy głodówki\Npo wielkich suszach.
Dialogue: 0,0:15:54.52,0:15:57.74,Default,Maomao,0,0,0,,Nikt nie wie, jak długo potrwa\Npokój z sąsiednimi krajami.
Dialogue: 0,0:15:58.23,0:16:01.75,Default,Maomao,0,0,0,,Zawsze znajdą się ambitni politycy,\Nktórym wojna byłaby na rękę.
Dialogue: 0,0:16:04.13,0:16:07.24,Default,Maomao,0,0,0,,Węgiel? Nie, to przypalony ziemniak.
Dialogue: 0,0:16:07.24,0:16:08.40,Default,Maomao,0,0,0,,Jaka strata.
Dialogue: 0,0:16:10.37,0:16:13.36,Default,Maomao,0,0,0,,Więc to magazyn żywności.
Dialogue: 0,0:16:24.63,0:16:27.50,Default,Maomao,0,0,0,,Fajka? Z Kości słoniowej?
Dialogue: 0,0:16:28.13,0:16:30.07,Default,Lihaku,0,0,0,,Chyba o coś prosiłem!
Dialogue: 0,0:16:30.90,0:16:32.06,Default,Maomao,0,0,0,,Fajka...
Dialogue: 0,0:16:33.59,0:16:37.70,Default,Maomao,0,0,0,,Eksplozja. Magazyn żywności. Fajka.
Dialogue: 0,0:16:40.79,0:16:41.77,Default,Lihaku,0,0,0,,Ej!
Dialogue: 0,0:16:53.44,0:16:54.95,Default,Lihaku,0,0,0,,Słyszysz mnie?!
Dialogue: 0,0:16:55.29,0:16:57.20,Default,Maomao,0,0,0,,Ta, słyszałam.
Dialogue: 0,0:16:57.20,0:16:58.95,Default,Maomao,0,0,0,,Ale kto mówił, że się posłucham.
Dialogue: 0,0:16:59.31,0:17:03.20,Default,Maomao,0,0,0,,Czy w tym spalonym magazynie\Nprzechowuje się to samo co tutaj?
Dialogue: 0,0:17:04.18,0:17:07.17,Default,Lihaku,0,0,0,,Tak. Najstarsze produkty\Ntrafiają na koniec.
Dialogue: 0,0:17:08.92,0:17:11.30,Default,Maomao,0,0,0,,Mogę to wziąć?
Dialogue: 0,0:17:11.76,0:17:13.29,Default,Lihaku,0,0,0,,Chyba tak.
Dialogue: 0,0:17:13.29,0:17:14.75,Default,Maomao,0,0,0,,A to?
Dialogue: 0,0:17:14.75,0:17:18.54,Default,Maomao,0,0,0,,Potrzebuję też młotka,\Npiły i kilku gwoździ.
Dialogue: 0,0:17:18.54,0:17:20.73,Default,Lihaku,0,0,0,,Co chcesz zrobić?
Dialogue: 0,0:17:21.31,0:17:23.10,Default,Maomao,0,0,0,,Malutki eksperyment.
Dialogue: 0,0:17:28.12,0:17:29.83,Default,Maomao,0,0,0,,To wystarczy.
Dialogue: 0,0:17:29.83,0:17:31.61,Default,Lihaku,0,0,0,,O dziwo świetnie ci idzie.
Dialogue: 0,0:17:31.98,0:17:36.03,Default,Maomao,0,0,0,,Dorastałam w biedzie, więc\Nmusiałam jakoś sobie poradzić.
Dialogue: 0,0:17:40.55,0:17:42.95,Default,Lihaku,0,0,0,,To mąka, prawda?
Dialogue: 0,0:17:42.95,0:17:45.00,Default,Maomao,0,0,0,,Tak, była w magazynie.
Dialogue: 0,0:17:49.09,0:17:50.80,Default,Subordinate,0,0,0,,To jest to, czego potrzebowałaś?
Dialogue: 0,0:17:50.80,0:17:53.35,Default,Maomao,0,0,0,,Tak. A gdzie jakaś podpałka?
Dialogue: 0,0:17:54.79,0:17:55.83,Default,Subordinate,0,0,0,,Tutaj.
Dialogue: 0,0:17:56.23,0:17:57.72,Default,Maomao,0,0,0,,Dziękuję bardzo.
Dialogue: 0,0:18:02.04,0:18:03.72,Default,Lihaku,0,0,0,,Nie łapię tego.
Dialogue: 0,0:18:03.72,0:18:07.38,Default,Maomao,0,0,0,,Gotowe. Proszę się odsunąć.\NTo niebezpieczne.
Dialogue: 0,0:18:07.73,0:18:09.99,Default,Subordinate,0,0,0,,Dobrze...
Dialogue: 0,0:18:12.89,0:18:15.20,Default,Maomao,0,0,0,,Panie Lihaku, to niebezpieczne.
Dialogue: 0,0:18:15.20,0:18:16.72,Default,Lihaku,0,0,0,,A co w tym takiego groźnego?
Dialogue: 0,0:18:16.72,0:18:20.12,Default,Lihaku,0,0,0,,Cokolwiek kombinujesz,\Nnie przestraszysz tym oficera jak ja.
Dialogue: 0,0:18:20.95,0:18:25.45,Default,Maomao,0,0,0,,Wiem. Ja nie żartuję,\Nproszę się odsunąć.
Dialogue: 0,0:18:25.45,0:18:27.40,Default,Maomao,0,0,0,,A teraz czas na ucieczkę.
Dialogue: 0,0:18:28.53,0:18:30.79,Default,Lihaku,0,0,0,,Co? Ucieczkę? Niby przed czy...
Dialogue: 0,0:18:35.41,0:18:36.88,Default,Lihaku,0,0,0,,Zgaście to!
Dialogue: 0,0:18:40.63,0:18:42.70,Default,Maomao,0,0,0,,Widzisz? A nie mówiłam?
Dialogue: 0,0:18:46.08,0:18:49.64,Default,Lihaku,0,0,0,,Co zatem spowodowało eksplozję?
Dialogue: 0,0:18:50.17,0:18:51.65,Default,Maomao,0,0,0,,To było to.
Dialogue: 0,0:18:52.24,0:18:53.90,Default,Lihaku,0,0,0,,Mąka?
Dialogue: 0,0:18:53.90,0:18:57.92,Default,Maomao,0,0,0,,Tak. Bywa, że pył z mąki pszennej\Nlub gryczanej jest łatwopalny.
Dialogue: 0,0:18:57.92,0:19:00.95,Default,Maomao,0,0,0,,Rozpylone w powietrzu drobinki\Nmogą się zapalić.
Dialogue: 0,0:19:02.90,0:19:04.53,Default,Maomao,0,0,0,,To pewnie było przyczyną.
Dialogue: 0,0:19:04.87,0:19:06.25,Default,Lihaku,0,0,0,,Fajka?
Dialogue: 0,0:19:07.19,0:19:10.68,Default,Maomao,0,0,0,,Gdy wartownik szedł do środka,\Nby na osobności sobie zapalić,
Dialogue: 0,0:19:12.25,0:19:15.30,Default,Maomao,0,0,0,,podmuch wiatru z zewnątrz\Nuniósł drobinki mąki w powietrze.
Dialogue: 0,0:19:15.99,0:19:18.26,Default,Maomao,0,0,0,,A kiedy zapalił fajkę...
Dialogue: 0,0:19:20.80,0:19:26.38,Default,Maomao,0,0,0,,Drobinki mąki zajęły się ogniem,\Nco wywołało eksplozję.
Dialogue: 0,0:19:27.36,0:19:32.52,Default,Maomao,0,0,0,,Należy poinformować wartowników,\Nby nie palili w magazynach.
Dialogue: 0,0:19:32.52,0:19:35.47,Default,Lihaku,0,0,0,,Skąd to wiesz?
Dialogue: 0,0:19:35.47,0:19:39.78,Default,Maomao,0,0,0,,Zdarzyło mi się raz wysadzić\Npokój w Grynszpanowym Pawilonie.
Dialogue: 0,0:19:40.23,0:19:42.03,Default,Lihaku,0,0,0,,Ty...
Dialogue: 0,0:19:42.63,0:19:45.96,Default,Old Lady,0,0,0,,Głupia dziewucha!
Dialogue: 0,0:19:45.96,0:19:48.86,Default,Maomao,0,0,0,,Staruszka wtedy była naprawdę groźna.
Dialogue: 0,0:19:48.86,0:19:53.02,Default,Lihaku,0,0,0,,Wybuchające pyłki? To trochę dziwne.
Dialogue: 0,0:19:53.02,0:19:56.22,Default,Maomao,0,0,0,,Na tym świecie\Nnie ma zagadek nie do rozwiązania.
Dialogue: 0,0:19:56.22,0:19:59.30,Default,Maomao,0,0,0,,Wszystko wydaje się dziwne,\Njeśli nie mamy odpowiedniej wiedzy.
Dialogue: 0,0:20:00.20,0:20:01.46,Default,Lihaku,0,0,0,,Apsik!
Dialogue: 0,0:20:01.92,0:20:04.64,Default,Maomao,0,0,0,,Uważaj, aby się nie przeziębić.
Dialogue: 0,0:20:04.64,0:20:08.52,Default,Maomao,0,0,0,,W razie czego idź do Luomena w dzielnicy\Nuciech. Jego leki działają cuda.
Dialogue: 0,0:20:08.52,0:20:09.56,Default,Lihaku,0,0,0,,Dobrze.
Dialogue: 0,0:20:09.56,0:20:14.56,Default,Maomao,0,0,0,,Tatko nie ma głowy do interesów.\NMuszę mu trochę pomóc.
Dialogue: 0,0:20:15.81,0:20:19.07,Default,Maomao,0,0,0,,Może odwiedzi Pairin,\Ngdy już tam będzie.
Dialogue: 0,0:20:20.00,0:20:22.38,Default,Maomao,0,0,0,,Cóż, wracam do pracy.
Dialogue: 0,0:20:22.38,0:20:23.38,Default,Lihaku,0,0,0,,Jasne.
Dialogue: 0,0:20:26.37,0:20:29.66,Default,Maomao,0,0,0,,Przez przypadek zabrałam ją ze sobą.
Dialogue: 0,0:20:30.06,0:20:34.44,Default,Maomao,0,0,0,,Może gdybym ją wyczyściła i założyła\Nnowy ustnik, to byłaby jak nówka?
Dialogue: 0,0:20:34.44,0:20:36.67,Default,Maomao,0,0,0,,Mogłabym ją sprzedać\Nza całkiem niezłą sumkę.
Dialogue: 0,0:20:37.62,0:20:40.95,Default,Maomao,0,0,0,,Dziwne, że zwykły wartownik\Nmiał taką luksusową rzecz.
Dialogue: 0,0:20:41.43,0:20:43.77,Default,Maomao,0,0,0,,Może to jakaś cenna pamiątka?
Dialogue: 0,0:20:45.11,0:20:47.43,Default,Maomao,0,0,0,,Wyczyszczę ją i oddam.
Dialogue: 0,0:20:54.02,0:20:55.40,Default,Official's Younger Brother,0,0,0,,Psiakrew!
Dialogue: 0,0:20:57.20,0:20:58.92,Default,Official's Younger Brother,0,0,0,,Także jestem godzien...\NPsiakrew!
Dialogue: 0,0:22:34.95,0:22:36.95,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.51,0:22:49.97,Default,Voice,0,0,0,,{\an8}W kolejnym odcinku:\N„Kuai”.
Dialogue: 0,0:22:47.97,0:22:49.97,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
