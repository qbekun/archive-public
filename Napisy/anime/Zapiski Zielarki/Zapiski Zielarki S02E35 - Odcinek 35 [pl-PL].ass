Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.48,0:01:33.48,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:38.24,0:01:43.79,Default,Old Eunuch,0,0,0,,{\i1}Jeśli chcesz przerzedzić linię krwi,\Nto czemu nie dodasz do niej jej?
Dialogue: 0,0:01:43.79,0:01:46.33,Default,Anshi,0,0,0,,{\i1}Warto ukryć swoją ulubienicę.
Dialogue: 0,0:01:46.33,0:01:48.33,Default,Anshi,0,0,0,,{\i1}Albo ktoś sprzątnie ci ją sprzed nosa.
Dialogue: 0,0:01:51.96,0:01:54.31,Default,Gaoshun,0,0,0,,Dzień dobry, panie Jinshi.
Dialogue: 0,0:01:55.26,0:01:57.63,Default,Jinshi,0,0,0,,Gotowy na jutro?
Dialogue: 0,0:01:57.63,0:01:59.45,Default,Gaoshun,0,0,0,,Wszystko przygotowane.
Dialogue: 0,0:01:59.45,0:02:02.36,Default,Jinshi,0,0,0,,Została tylko dziewczyna...
Dialogue: 0,0:02:02.36,0:02:04.68,Default,Gaoshun,0,0,0,,Jeśli zamierzasz zabrać ją ze sobą,
Dialogue: 0,0:02:05.02,0:02:07.31,Default,Gaoshun,0,0,0,,wątpię, że uda się to przed nią ukryć.
Dialogue: 0,0:02:07.60,0:02:08.89,Default,Jinshi,0,0,0,,Wiem o tym.
Dialogue: 0,0:02:09.57,0:02:13.69,Default,Jinshi,0,0,0,,Chcę podczas tej wyprawy\Nwyjawić jej prawdę
Dialogue: 0,0:02:14.23,0:02:15.85,Default,Jinshi,0,0,0,,o moim prawdziwy statusie.
Dialogue: 0,0:02:20.33,0:02:22.48,Default,Yinghua,0,0,0,,Maomao, wzywają cię.
Dialogue: 0,0:02:24.29,0:02:25.37,Default,Maomao,0,0,0,,Wybaczcie.
Dialogue: 0,0:02:25.72,0:02:28.75,Default,Maomao,0,0,0,,Pani Gyokuyou, w czym mogę pomóc?
Dialogue: 0,0:02:29.40,0:02:31.88,Default,Gyokuyou,0,0,0,,Właściwie to nie ja cię wezwałam.
Dialogue: 0,0:02:32.18,0:02:33.34,Default,Jinshi,0,0,0,,Tylko ja.
Dialogue: 0,0:02:35.05,0:02:36.84,Default,Maomao,0,0,0,,Jak mogę pomóc?
Dialogue: 0,0:02:38.41,0:02:42.22,Default,Jinshi,0,0,0,,Chciałbym, byś zwróciła mi ją na kilka dni.
Dialogue: 0,0:02:42.98,0:02:43.97,Default,Gyokuyou,0,0,0,,„Zwrócić”?
Dialogue: 0,0:02:45.38,0:02:48.58,Default,Maomao,0,0,0,,{\i1}Teoretycznie wróciłam\Ndo Jadeitowego Pałacu
Dialogue: 0,0:02:48.58,0:02:52.44,Default,Maomao,0,0,0,,{\i1}w ramach specjalnego zadania\Nna czas trwania ciąży pani Gyokuyou.
Dialogue: 0,0:02:52.84,0:02:56.92,Default,Gyokuyou,0,0,0,,Rany. Kto teraz będzie\Nsprawdzał moje jedzenie?
Dialogue: 0,0:02:56.92,0:02:58.99,Default,Jinshi,0,0,0,,Pożyczę ci moją służącą.
Dialogue: 0,0:02:58.99,0:03:01.09,Default,Gyokuyou,0,0,0,,Jest godna zaufania?
Dialogue: 0,0:03:01.09,0:03:01.95,Default,Jinshi,0,0,0,,Oczywiście.
Dialogue: 0,0:03:02.44,0:03:06.28,Default,Gyokuyou,0,0,0,,Na kilka dni...\NWybierasz się gdzieś?
Dialogue: 0,0:03:06.28,0:03:09.53,Default,Jinshi,0,0,0,,Dostałem zaproszenie na polowanie\Nod kogoś, komu nie mogę odmówić.
Dialogue: 0,0:03:09.53,0:03:10.96,Default,Gyokuyou,0,0,0,,Ktoś, komu nie można odmówić?
Dialogue: 0,0:03:11.30,0:03:13.61,Default,Jinshi,0,0,0,,Zaproszenie od pana Shishou.
Dialogue: 0,0:03:13.61,0:03:16.15,Default,Gyokuyou,0,0,0,,Ciężko jest nadążyć za tym wszystkim.
Dialogue: 0,0:03:16.15,0:03:19.97,Default,Gyokuyou,0,0,0,,To dlatego chcesz\N„pożyczyć” moją Maomao.
Dialogue: 0,0:03:19.97,0:03:23.09,Default,Jinshi,0,0,0,,Owszem. Chciałbym, żeby „wróciła”.
Dialogue: 0,0:03:23.42,0:03:28.37,Default,Gyokuyou,0,0,0,,Musi to być Maomao?\NMam wiele miłych dziewczyn.
Dialogue: 0,0:03:28.37,0:03:32.77,Default,Jinshi,0,0,0,,Nie. Wystarczy, że zwrócisz mi\Ntę dziewczynę.
Dialogue: 0,0:03:33.02,0:03:36.17,Default,Gyokuyou,0,0,0,,Rany... Która to dziewczyna?
Dialogue: 0,0:03:36.17,0:03:38.34,Default,Jinshi,0,0,0,,Ta dziewczyna.
Dialogue: 0,0:03:39.02,0:03:41.99,Default,Gyokuyou,0,0,0,,Ciągle mówisz tylko „ta dziewczyna”.
Dialogue: 0,0:03:43.58,0:03:44.99,Default,Jinshi,0,0,0,,Czy to problem?
Dialogue: 0,0:03:47.37,0:03:48.46,Default,Gyokuyou,0,0,0,,Gaoshun?
Dialogue: 0,0:03:48.46,0:03:49.21,Default,Gaoshun,0,0,0,,Tak?
Dialogue: 0,0:03:49.69,0:03:53.02,Default,Gyokuyou,0,0,0,,Jak nazywasz Maomao?
Dialogue: 0,0:03:53.02,0:03:54.96,Default,Gaoshun,0,0,0,,Mówię „Xiaomao”.
Dialogue: 0,0:03:55.77,0:03:59.51,Default,Gyokuyou,0,0,0,,A jak ty ją nazywasz?
Dialogue: 0,0:04:04.07,0:04:09.09,Default,Maomao,0,0,0,,{\i1}A, w sumie jak pomyślę, nigdy nie zwracał się\Ndo mnie po imieniu. Nie żeby mi to przeszkadzało.
Dialogue: 0,0:04:09.09,0:04:11.68,Default,Maomao,0,0,0,,{\i1}Czemu pan Jinshi jest taki spięty?
Dialogue: 0,0:04:15.62,0:04:20.48,Default,Maomao,0,0,0,,{\i1}Dopiero po trzydziestu minutach\Npani Gyokuyou się zgodziła.
Dialogue: 0,0:04:27.24,0:04:31.20,Default,Text,0,0,0,,{\an8}ODCINEK 35: POLOWANIE
Dialogue: 0,0:04:32.73,0:04:36.08,Default,Basen,0,0,0,,Znak używany do zapisu\Nnazwy narodu Li
Dialogue: 0,0:04:36.08,0:04:38.19,Default,Basen,0,0,0,,odzwierciedla również\Nhistorię jego powstania.
Dialogue: 0,0:04:38.70,0:04:41.09,Default,Basen,0,0,0,,Trzy miecze w trawie.
Dialogue: 0,0:04:41.09,0:04:45.55,Default,Basen,0,0,0,,„Trawa” to „kwiat” reprezentujący\NCesarzową Matkę, przodkinię cesarza.
Dialogue: 0,0:04:45.55,0:04:50.32,Default,Basen,0,0,0,,Trzy „miecze” pod nią symbolizują\Ntrójkę wojowników, którzy jej pomogli.
Dialogue: 0,0:04:50.83,0:04:57.80,Default,Basen,0,0,0,,Spośród trzech mieczy jeden większy\Nmiecz symbolizuje Shihoku-shu, północne ziemie.
Dialogue: 0,0:04:58.34,0:05:02.06,Default,Basen,0,0,0,,Na całym tym obszarze\Nuprawia się sorgo i pszenicę.
Dialogue: 0,0:05:02.06,0:05:05.14,Default,Basen,0,0,0,,Udając się bardziej na północ,\Ntrafiamy na tereny górzyste...
Dialogue: 0,0:05:05.14,0:05:06.91,Default,Basen,0,0,0,,Ej, słuchasz mnie?!
Dialogue: 0,0:05:08.83,0:05:10.87,Default,Maomao,0,0,0,,Przepraszam, panie Basen.
Dialogue: 0,0:05:11.55,0:05:14.41,Default,Basen,0,0,0,,Opowiadam o miejscu,\Ndo którego jedziemy.
Dialogue: 0,0:05:15.02,0:05:16.56,Default,Maomao,0,0,0,,Północne...
Dialogue: 0,0:05:16.56,0:05:18.28,Default,Basen,0,0,0,,Shihoku-shu!
Dialogue: 0,0:05:18.28,0:05:20.08,Default,Basen,0,0,0,,Kontrolę nad nim\Nsprawuje klan pana Shishou
Dialogue: 0,0:05:20.08,0:05:22.64,Default,Basen,0,0,0,,i to właśnie on zaprosił\Npana Jinshi na polowanie.
Dialogue: 0,0:05:23.90,0:05:28.28,Default,Maomao,0,0,0,,{\i1}Polowanie to pretekst,\Nby ściągnąć go na swój teren.
Dialogue: 0,0:05:28.70,0:05:33.31,Default,Maomao,0,0,0,,{\i1}Nie nakłonił cesarza do przybycia,\Nale źle nie trafił nawet.
Dialogue: 0,0:05:33.31,0:05:36.51,Default,Basen,0,0,0,,Dlaczego mojemu ojcu tak\Nbardzo zależy na tej dziewczynie?
Dialogue: 0,0:05:36.51,0:05:38.93,Default,Maomao,0,0,0,,{\i1}Ojcu, tak?
Dialogue: 0,0:05:38.93,0:05:41.69,Default,Maomao,0,0,0,,{\i1}Basen jest najwyraźniej\Nsynem pana Gaoshuna.
Dialogue: 0,0:05:42.77,0:05:46.33,Default,Maomao,0,0,0,,{\i1}Pan Gaoshun został zaproszony\Njako gość na tę wyprawę,
Dialogue: 0,0:05:46.33,0:05:49.70,Default,Maomao,0,0,0,,{\i1}więc Basen ma służyć\Njako pomocnik panu Jinshiemu.
Dialogue: 0,0:05:50.26,0:05:53.66,Default,Maomao,0,0,0,,{\i1}Eunuchowie nie rodzą się tacy,
Dialogue: 0,0:05:53.66,0:05:56.86,Default,Maomao,0,0,0,,{\i1}więc nic dziwnego, że ma syna,\Npatrząc na jego wiek.
Dialogue: 0,0:05:59.18,0:06:00.46,Default,Basen,0,0,0,,Już prawie jesteśmy.
Dialogue: 0,0:06:05.72,0:06:08.59,Default,Maomao,0,0,0,,{\i1}Wysokie położenie sprawia,\Nże jest tu chłodno.
Dialogue: 0,0:06:08.59,0:06:12.10,Default,Maomao,0,0,0,,{\i1}Region ten był ulubionym letnim kurortem\Nzmarłego cesarza, który co roku go odwiedzał.
Dialogue: 0,0:06:13.19,0:06:16.84,Default,Maomao,0,0,0,,{\i1}Za rządów obecnego cesarza członkowie\Nrodziny cesarskiej nie odwiedzają tego miejsca,
Dialogue: 0,0:06:16.84,0:06:19.78,Default,Maomao,0,0,0,,{\i1}ale klan pana Shishou wciąż nim zarządza.
Dialogue: 0,0:06:27.37,0:06:29.68,Default,Maomao,0,0,0,,{\i1}A więc to tutaj się zatrzymamy...
Dialogue: 0,0:06:37.30,0:06:40.08,Default,Maomao,0,0,0,,{\i1}Pokój jest dziwnie ciepły.
Dialogue: 0,0:06:40.57,0:06:44.42,Default,Maomao,0,0,0,,{\i1}Nie wspominając już o sposobie,\Nw jaki ten goguś się relaksuje.
Dialogue: 0,0:06:45.07,0:06:48.64,Default,Maomao,0,0,0,,{\i1}Może i zmęczył się bardziej\Nniż zwykle, ale są jakieś granice.
Dialogue: 0,0:06:49.93,0:06:51.43,Default,Maomao,0,0,0,,{\i1}Czy to kominiarka?
Dialogue: 0,0:06:51.96,0:06:56.31,Default,Maomao,0,0,0,,{\i1}Czyżby musiał ukrywać swoją gębę,\Ngdy opuszcza swój pokój?
Dialogue: 0,0:06:57.91,0:06:59.89,Default,Basen,0,0,0,,Jak mam się do ciebie zwracać?
Dialogue: 0,0:07:00.31,0:07:02.77,Default,Jinshi,0,0,0,,W zaufanym gronie\Nmów do mnie normalnie.
Dialogue: 0,0:07:02.77,0:07:04.85,Default,Jinshi,0,0,0,,W innych przypadkach\Nmów do mnie „Kousen”.
Dialogue: 0,0:07:04.85,0:07:07.07,Default,Basen,0,0,0,,Zrozumiałem, panie Kousen.
Dialogue: 0,0:07:07.41,0:07:08.40,Default,Maomao,0,0,0,,{\i1}Co?
Dialogue: 0,0:07:08.94,0:07:10.90,Default,Maomao,0,0,0,,Co to za dziwna zasada?
Dialogue: 0,0:07:11.66,0:07:13.30,Default,Jinshi,0,0,0,,Chodzi o to...
Dialogue: 0,0:07:19.01,0:07:23.34,Default,Maomao,0,0,0,,Pan Gaoshun również został\Nzaproszony jako gość, prawda?
Dialogue: 0,0:07:23.70,0:07:24.96,Default,Gaoshun,0,0,0,,Tak, ale...
Dialogue: 0,0:07:25.32,0:07:29.26,Default,Maomao,0,0,0,,{\i1}Czemu w takim razie trafił\Ndo tego samego budynku?
Dialogue: 0,0:07:29.26,0:07:32.94,Default,Maomao,0,0,0,,{\i1}Różnica w pozycji między\Nnimi jest nieco większa...
Dialogue: 0,0:07:32.94,0:07:37.12,Default,Basen,0,0,0,,My, klan Ma, służymy rodzinie\Npana Kousena od wielu pokoleń.
Dialogue: 0,0:07:37.12,0:07:39.28,Default,Basen,0,0,0,,To oczywiste, że trafimy\Ndo tego samego budynku.
Dialogue: 0,0:07:39.71,0:07:40.93,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:07:41.40,0:07:44.62,Default,Maomao,0,0,0,,{\i1}Czyli pan Jinshi\Npochodzi z dobrej rodziny.
Dialogue: 0,0:07:46.62,0:07:51.27,Default,Basen,0,0,0,,Ojcze, co się dzieje?\NCzy to możliwe, że ona...
Dialogue: 0,0:07:58.21,0:08:00.96,Default,Gaoshun,0,0,0,,Xiaomao o niczym nie wie.
Dialogue: 0,0:08:03.99,0:08:06.82,Default,Gaoshun,0,0,0,,Pan Jinshi niebawem jej powie.
Dialogue: 0,0:08:07.22,0:08:09.22,Default,Gaoshun,0,0,0,,Dlatego milcz do tego czasu.
Dialogue: 0,0:08:09.22,0:08:11.42,Default,Basen,0,0,0,,Ale mimo wszystko...
Dialogue: 0,0:08:13.50,0:08:15.26,Default,Maomao,0,0,0,,{\i1}Co oni odwalają?
Dialogue: 0,0:08:16.23,0:08:19.53,Default,Maomao,0,0,0,,{\i1}Tak czy siak, muszę pomóc\Nprzy rozpakowywaniu i sprzątaniu.
Dialogue: 0,0:08:19.53,0:08:22.92,Default,Maomao,0,0,0,,{\i1}Trzeba popracować, bo inaczej\Npani Suiren będzie się wściekać.
Dialogue: 0,0:08:33.33,0:08:36.09,Default,Maomao,0,0,0,,{\i1}Na zewnątrz całkiem nieźle się bawią.
Dialogue: 0,0:08:36.09,0:08:39.35,Default,Maomao,0,0,0,,{\i1}Czemu więc ukrywa się w pokoju?
Dialogue: 0,0:08:40.62,0:08:44.35,Default,Maomao,0,0,0,,Może otworzymy chociaż okna?
Dialogue: 0,0:08:44.35,0:08:48.36,Default,Jinshi,0,0,0,,Nie rób tego.\NSkosztuj na razie jedzenia.
Dialogue: 0,0:08:49.42,0:08:50.75,Default,Jinshi,0,0,0,,Zrozumiesz, gdy to zrobisz.
Dialogue: 0,0:08:52.17,0:08:54.65,Default,Maomao,0,0,0,,Czy to żółw miękkoskóry?
Dialogue: 0,0:08:54.65,0:08:56.06,Default,Jinshi,0,0,0,,Podobno.
Dialogue: 0,0:09:00.49,0:09:05.19,Default,Maomao,0,0,0,,{\i1}Aperitif też jest niczego sobie,\Nchoć próbowano to ukryć sokiem owocowym.
Dialogue: 0,0:09:05.88,0:09:08.69,Default,Maomao,0,0,0,,{\i1}Wszystko... od przystawek po desery...
Dialogue: 0,0:09:09.45,0:09:13.15,Default,Maomao,0,0,0,,Wszystko wygląda zachęcająco.
Dialogue: 0,0:09:13.48,0:09:14.92,Default,Jinshi,0,0,0,,Teraz rozumiesz, prawda?
Dialogue: 0,0:09:17.03,0:09:18.55,Default,Maomao,0,0,0,,{\i1}Przetworzone jedzenie?
Dialogue: 0,0:09:19.27,0:09:22.35,Default,Maomao,0,0,0,,Nie będziesz tego jadł?\NNie jest zatrute.
Dialogue: 0,0:09:22.35,0:09:24.79,Default,Jinshi,0,0,0,,Nawet jeśli nie, to nie jest\Nto coś, co powinienem jeść.
Dialogue: 0,0:09:25.39,0:09:27.89,Default,Maomao,0,0,0,,Podejrzane będzie,\Njeśli będzie nietknięty,
Dialogue: 0,0:09:27.89,0:09:29.96,Default,Maomao,0,0,0,,więc mogę go zjeść?
Dialogue: 0,0:09:30.69,0:09:31.96,Default,Jinshi,0,0,0,,Rób, co chcesz.
Dialogue: 0,0:09:40.18,0:09:41.75,Default,Jinshi,0,0,0,,Smakuje?
Dialogue: 0,0:09:42.17,0:09:43.66,Default,Maomao,0,0,0,,Pyszne.
Dialogue: 0,0:09:43.66,0:09:46.38,Default,Maomao,0,0,0,,Reszta dań też pewnie jest świetna.
Dialogue: 0,0:09:46.38,0:09:48.76,Default,Maomao,0,0,0,,Jesteś pewien, że nie chcesz?
Dialogue: 0,0:09:49.55,0:09:50.89,Default,Jinshi,0,0,0,,Na pewno mogę?
Dialogue: 0,0:09:51.29,0:09:54.45,Default,Maomao,0,0,0,,W końcu to twoje jedzenie.
Dialogue: 0,0:09:54.45,0:09:56.34,Default,Jinshi,0,0,0,,Jesteś naprawdę pewna?
Dialogue: 0,0:09:56.34,0:09:57.49,Default,Maomao,0,0,0,,{\i1}Co jest z nim?
Dialogue: 0,0:10:00.36,0:10:03.69,Default,Jinshi,0,0,0,,Nie zjem. Basen, możesz to zjeść.
Dialogue: 0,0:10:03.69,0:10:05.08,Default,Basen,0,0,0,,Jest pan pewien?
Dialogue: 0,0:10:05.08,0:10:06.88,Default,Jinshi,0,0,0,,Tak, a właściwie to rozkaz.
Dialogue: 0,0:10:07.45,0:10:08.33,Default,Basen,0,0,0,,W takim razie...
Dialogue: 0,0:10:16.51,0:10:17.54,Default,Basen,0,0,0,,Pyszne.
Dialogue: 0,0:10:17.54,0:10:19.09,Default,Jinshi,0,0,0,,Dobrze to słyszeć.
Dialogue: 0,0:10:19.09,0:10:19.94,Default,Basen,0,0,0,,Ale...
Dialogue: 0,0:10:19.94,0:10:20.59,Default,Jinshi,0,0,0,,Ale?
Dialogue: 0,0:10:23.23,0:10:25.78,Default,Basen,0,0,0,,Jak jej nic nie jest?
Dialogue: 0,0:10:25.78,0:10:29.06,Default,Maomao,0,0,0,,Może taki już mój urok.
Dialogue: 0,0:10:29.33,0:10:33.23,Default,Basen,0,0,0,,Przepraszam.\NPójdę do swojego pokoju...
Dialogue: 0,0:10:33.23,0:10:35.35,Default,Maomao,0,0,0,,{\i1}Młodość to nie przelewki.
Dialogue: 0,0:10:38.14,0:10:39.32,Default,Maomao,0,0,0,,Co powinniśmy zrobić?
Dialogue: 0,0:10:39.32,0:10:43.06,Default,Jinshi,0,0,0,,Niech śpi tutaj. Ja pójdę do jego pokoju.
Dialogue: 0,0:10:43.06,0:10:45.08,Default,Gaoshun,0,0,0,,Zaniosę go do pokoju.
Dialogue: 0,0:10:45.08,0:10:46.59,Default,Jinshi,0,0,0,,Musisz być zmęczony.
Dialogue: 0,0:10:47.54,0:10:49.14,Default,Gaoshun,0,0,0,,Jeżeli tak mówisz...
Dialogue: 0,0:10:50.90,0:10:56.37,Default,Gaoshun,0,0,0,,Straż będzie korzystać z mojego pokoju,\Nwięc, Xiaomao, ten jest twój.
Dialogue: 0,0:10:56.37,0:10:56.96,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:11:00.75,0:11:04.64,Default,Maomao,0,0,0,,{\i1}Jest nawet wanna? Burżuazja.
Dialogue: 0,0:11:07.92,0:11:09.89,Default,Maomao,0,0,0,,{\i1}Polowanie rozpoczyna się jutro.
Dialogue: 0,0:11:10.94,0:11:13.50,Default,Maomao,0,0,0,,{\i1}Oby obyło się bez incydentów.
Dialogue: 0,0:11:19.38,0:11:22.53,Default,Man 1,0,0,0,,To jest to? Trochę mały. {mały ale wariat xD}
Dialogue: 0,0:11:22.53,0:11:26.85,Default,Man 2,0,0,0,,To najnowszy model.\NMa lepszy zasięg i celność.
Dialogue: 0,0:11:26.85,0:11:29.21,Default,Man 2,0,0,0,,Dzięki temu możemy używać go także w lesie.
Dialogue: 0,0:11:30.28,0:11:33.72,Default,Man 1,0,0,0,,To tutaj zginą.
Dialogue: 0,0:11:39.72,0:11:43.26,Default,Maomao,0,0,0,,{\i1}Polowanie odbywa się w miejscu\Noddalonym o pół godziny konno
Dialogue: 0,0:11:43.26,0:11:46.82,Default,Maomao,0,0,0,,{\i1}i godzinę piechotą pod górkę.
Dialogue: 0,0:11:47.22,0:11:48.92,Default,Maomao,0,0,0,,{\i1}Celem tej imprezy jest chyba
Dialogue: 0,0:11:48.92,0:11:51.63,Default,Maomao,0,0,0,,{\i1}ugotowanie złapanej zwierzyny\Nprzez szlachtę na miejscu.
Dialogue: 0,0:12:01.59,0:12:05.70,Default,Maomao,0,0,0,,{\i1}Nie mam nic do roboty.\NMoże się przejdę.
Dialogue: 0,0:12:09.71,0:12:11.82,Default,Maomao,0,0,0,,{\i1}Całkiem ładny las.
Dialogue: 0,0:12:11.82,0:12:15.63,Default,Maomao,0,0,0,,{\i1}Zapowiada się dobre\Nmiejsce na zioła i grzyby...
Dialogue: 0,0:12:19.47,0:12:21.76,Default,Maomao,0,0,0,,{\i1}W pobliżu jest jakiś duży wodospad?
Dialogue: 0,0:12:22.53,0:12:24.94,Default,Lihaku,0,0,0,,Dobry piesek!
Dialogue: 0,0:12:24.94,0:12:26.97,Default,Maomao,0,0,0,,— Dobry piesek! Dobry piesek!\N— Co? Czy to...
Dialogue: 0,0:12:29.51,0:12:30.64,Default,Maomao,0,0,0,,Dzieńdoberek.
Dialogue: 0,0:12:30.64,0:12:32.17,Default,Lihaku,0,0,0,,Dzieńdoberek?
Dialogue: 0,0:12:33.14,0:12:37.14,Default,Lihaku,0,0,0,,Witaj, panienko!\NCo ty tutaj robisz?
Dialogue: 0,0:12:37.14,0:12:39.40,Default,Maomao,0,0,0,,Dostałam zaproszenie.
Dialogue: 0,0:12:39.40,0:12:40.31,Default,Lihaku,0,0,0,,Serio?
Dialogue: 0,0:12:41.00,0:12:42.45,Default,Lihaku,0,0,0,,Ja tak samo.
Dialogue: 0,0:12:42.45,0:12:47.32,Default,Lihaku,0,0,0,,Miałem robić za ochroniarza,\Nale zamiast tego kazali mi zająć się psem.
Dialogue: 0,0:12:47.80,0:12:50.58,Default,Maomao,0,0,0,,{\i1}Lihaku również otrzymał zaproszenie,
Dialogue: 0,0:12:50.58,0:12:52.65,Default,Maomao,0,0,0,,{\i1}ale pochodzi ze wsi.
Dialogue: 0,0:12:52.65,0:12:56.83,Default,Maomao,0,0,0,,{\i1}Reszta zarozumiałych\Nstrażników musiała go przepędzić.
Dialogue: 0,0:12:57.30,0:13:00.25,Default,Maomao,0,0,0,,{\i1}Od niedawna wdrapuje się na szczyt,
Dialogue: 0,0:13:00.25,0:13:02.84,Default,Maomao,0,0,0,,{\i1}ale ciągle dostaje kłody pod nogi.
Dialogue: 0,0:13:03.18,0:13:04.76,Default,Maomao,0,0,0,,Nie umiesz gwizdać.
Dialogue: 0,0:13:04.76,0:13:05.93,Default,Lihaku,0,0,0,,Cicho bądź.
Dialogue: 0,0:13:06.43,0:13:08.70,Default,Lihaku,0,0,0,,Na szczęście mam to.
Dialogue: 0,0:13:14.53,0:13:16.02,Default,Maomao,0,0,0,,Bystrzak z niego.
Dialogue: 0,0:13:16.49,0:13:21.08,Default,Lihaku,0,0,0,,Co nie? Podobno w niektórych sytuacjach\Nmożna go zawołać z dużej odległości.
Dialogue: 0,0:13:21.44,0:13:22.68,Default,Maomao,0,0,0,,Aha...
Dialogue: 0,0:13:24.89,0:13:27.47,Default,Maomao,0,0,0,,{\i1}Pies głaszcze psa...
Dialogue: 0,0:13:35.34,0:13:37.06,Default,Maomao,0,0,0,,{\i1}Letnie kurorty powinny być fajne,
Dialogue: 0,0:13:37.06,0:13:39.25,Default,Maomao,0,0,0,,{\i1}ale dziś jest bezchmurnie\Ni bardzo gorąco.
Dialogue: 0,0:13:39.81,0:13:42.67,Default,Maomao,0,0,0,,{\i1}Osiągnięcie wygody nie jest łatwe.
Dialogue: 0,0:13:45.59,0:13:51.60,Default,Maomao,0,0,0,,{\i1}Nawet w tym upale\Nnie zdejmie kominiarki i nie zje?
Dialogue: 0,0:13:53.56,0:13:56.37,Default,Maomao,0,0,0,,{\i1}Pomijając tę podejrzaną szmatkę,
Dialogue: 0,0:13:56.37,0:14:01.39,Default,Maomao,0,0,0,,{\i1}mając na uwadze jego miejsce,\Nmusi być najważniejszą osobą na tej imprezie.
Dialogue: 0,0:14:02.97,0:14:06.59,Default,Maomao,0,0,0,,{\i1}To pan Shishou,\Nojciec konkubiny Loulan.
Dialogue: 0,0:14:06.59,0:14:09.78,Default,Maomao,0,0,0,,{\i1}Przywódca regionu Shihoku-shu\Ni organizator tego polowania.
Dialogue: 0,0:14:10.86,0:14:13.29,Default,Maomao,0,0,0,,{\i1}Co? Czy on mu coś powiedział?
Dialogue: 0,0:14:14.67,0:14:20.96,Default,Maomao,0,0,0,,{\i1}Czy ten niezwykle elegancki eunuch\Nwykazałby się tak oczywistą postawą?
Dialogue: 0,0:14:22.07,0:14:24.96,Default,Maomao,0,0,0,,{\i1}Czekaj, czy to możliwe,\Nże z powodu upału...
Dialogue: 0,0:14:26.73,0:14:28.80,Default,Maomao,0,0,0,,{\i1}Mówi, żebym nic nie robiła?
Dialogue: 0,0:14:39.33,0:14:40.39,Default,Gaoshun,0,0,0,,Xiaomao.
Dialogue: 0,0:14:40.39,0:14:41.11,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:14:43.44,0:14:45.55,Default,Maomao,0,0,0,,Mogę to wziąć?
Dialogue: 0,0:14:45.55,0:14:46.90,Default,Servant,0,0,0,,Tak, jasne.
Dialogue: 0,0:14:57.78,0:14:58.55,Default,Master,0,0,0,,Panie Ji...
Dialogue: 0,0:14:59.06,0:15:00.00,Default,Maomao,0,0,0,,Panie Kousen!
Dialogue: 0,0:15:02.76,0:15:03.85,Default,Jinshi,0,0,0,,To ty.
Dialogue: 0,0:15:04.25,0:15:06.02,Default,Maomao,0,0,0,,Proszę, zdejmij to.
Dialogue: 0,0:15:06.02,0:15:07.07,Default,Jinshi,0,0,0,,Nie mogę.
Dialogue: 0,0:15:08.39,0:15:10.01,Default,Maomao,0,0,0,,Nie ma nikogo w pobliżu.
Dialogue: 0,0:15:10.27,0:15:11.97,Default,Jinshi,0,0,0,,Ktoś może nadejść.
Dialogue: 0,0:15:12.34,0:15:14.11,Default,Maomao,0,0,0,,Rany, co za wrzód!
Dialogue: 0,0:15:14.94,0:15:19.27,Default,Maomao,0,0,0,,Jak tak bardzo chcesz nie dać się poznać,\Nto chodźmy gdzieś, gdzie nas nie znajdą.
Dialogue: 0,0:15:27.19,0:15:29.95,Default,Maomao,0,0,0,,Przepraszam. Wytrę ci twarz.
Dialogue: 0,0:15:31.15,0:15:34.14,Default,Maomao,0,0,0,,{\i1}Jest gorący. Pewnie ma zawroty głowy.
Dialogue: 0,0:15:34.14,0:15:36.00,Default,Maomao,0,0,0,,{\i1}Zmuszę go do wypicia wody,\Nktórą zabrałam...
Dialogue: 0,0:15:36.00,0:15:39.41,Default,Jinshi,0,0,0,,Zielareczko, jest coś,\Nco chcę ci powiedzieć.
Dialogue: 0,0:15:39.71,0:15:40.83,Default,Maomao,0,0,0,,Akurat teraz?
Dialogue: 0,0:15:42.02,0:15:44.42,Default,Jinshi,0,0,0,,Kiedyś i tak miałem ci to powiedzieć.
Dialogue: 0,0:15:45.62,0:15:48.67,Default,Jinshi,0,0,0,,Jestem... Właściwie to jestem...
Dialogue: 0,0:15:50.13,0:15:51.17,Default,Maomao,0,0,0,,{\i1}Co to było?
Dialogue: 0,0:15:55.14,0:15:56.60,Default,Maomao,0,0,0,,{\i1}Zapach siarki?
Dialogue: 0,0:15:56.97,0:15:57.85,Default,Jinshi,0,0,0,,Ognista lanca?
Dialogue: 0,0:15:59.94,0:16:00.81,Default,Jinshi,0,0,0,,Wybacz!
Dialogue: 0,0:16:00.81,0:16:01.89,Default,Jinshi,0,0,0,,Może to cię lekko zaskoczyć!
Dialogue: 0,0:16:06.61,0:16:08.86,Default,Maomao,0,0,0,,{\i1}To się nazywa trochę?!
Dialogue: 0,0:16:13.61,0:16:15.47,Default,Man 1,0,0,0,,Przeszukać teren pod wodospadem?
Dialogue: 0,0:16:15.47,0:16:18.21,Default,Man 2,0,0,0,,Nie ma mowy,\Nby przeżył z takiej wysokości.
Dialogue: 0,0:16:18.21,0:16:20.62,Default,Man 2,0,0,0,,Co ważniejsze, ukryj broń.
Dialogue: 0,0:16:42.73,0:16:44.91,Default,Jinshi,0,0,0,,Nie wiedziałem,\Nże nie potrafisz pływać, wybacz.
Dialogue: 0,0:16:45.35,0:16:49.40,Default,Maomao,0,0,0,,W tej sytuacji nie ma znaczenia,\Nczy umiem pływać, czy nie...
Dialogue: 0,0:16:50.38,0:16:55.12,Default,Maomao,0,0,0,,{\i1}Klif miał z pięćdziesiąt metrów wysokości.\NSkok z niego to szaleństwo.
Dialogue: 0,0:16:55.59,0:16:57.74,Default,Maomao,0,0,0,,Myślałam, że oszalałeś.
Dialogue: 0,0:16:58.22,0:17:00.80,Default,Jinshi,0,0,0,,Ten wodospad jest bardzo głęboki.
Dialogue: 0,0:17:00.80,0:17:04.29,Default,Jinshi,0,0,0,,Jeśli zeskoczysz w odpowiednim momencie,\Nnie zginiesz, chyba że utoniesz.
Dialogue: 0,0:17:04.29,0:17:06.79,Default,Maomao,0,0,0,,No pewnie. Chyba że utonę.
Dialogue: 0,0:17:13.88,0:17:15.05,Default,Jinshi,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:17:15.31,0:17:20.39,Default,Maomao,0,0,0,,Wybacz za striptiz dla ubogich,\Nale nie chcę się przeziębić.
Dialogue: 0,0:17:23.99,0:17:26.88,Default,Maomao,0,0,0,,{\i1}Zostawię tylko bieliznę.
Dialogue: 0,0:17:26.88,0:17:30.55,Default,Maomao,0,0,0,,{\i1}Choć jestem płaska jak decha,\Nwolę to jakoś ukryć.
Dialogue: 0,0:17:32.28,0:17:35.94,Default,Maomao,0,0,0,,Jeśli zdejmiesz swoje, też je wycisnę.
Dialogue: 0,0:17:44.07,0:17:45.37,Default,Jinshi,0,0,0,,Sam to zrobię.
Dialogue: 0,0:17:45.75,0:17:49.18,Default,Jinshi,0,0,0,,Daj też swoje.\NJestem silniejszy od ciebie.
Dialogue: 0,0:17:49.18,0:17:49.97,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:17:52.36,0:17:55.91,Default,Maomao,0,0,0,,{\i1}Dobrze. Wygląda lepiej niż wcześniej.
Dialogue: 0,0:17:56.47,0:17:58.46,Default,Maomao,0,0,0,,{\i1}Jednak jego humor jest gorszy.
Dialogue: 0,0:17:59.82,0:18:01.90,Default,Maomao,0,0,0,,{\i1}No i ziółka szlag trafił.
Dialogue: 0,0:18:02.35,0:18:04.04,Default,Maomao,0,0,0,,{\i1}Jest coś jeszcze?
Dialogue: 0,0:18:08.90,0:18:09.94,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:18:11.26,0:18:12.41,Default,Jinshi,0,0,0,,Co jest?
Dialogue: 0,0:18:12.41,0:18:16.60,Default,Maomao,0,0,0,,Nie ma tego wiele, ale może\Nchciałbyś coś przekąsić?
Dialogue: 0,0:18:17.00,0:18:18.78,Default,Jinshi,0,0,0,,To jakiś lek?
Dialogue: 0,0:18:19.19,0:18:21.38,Default,Maomao,0,0,0,,To lepiężnik z naszego śniadania.
Dialogue: 0,0:18:21.38,0:18:27.79,Default,Maomao,0,0,0,,Wzięłam go jako przekąskę,\Nale myślę, że potrzebujesz trochę soli.
Dialogue: 0,0:18:27.79,0:18:28.54,Default,Jinshi,0,0,0,,Soli?
Dialogue: 0,0:18:29.21,0:18:34.03,Default,Maomao,0,0,0,,Kiedy cię goniłam, przyniosłam\Ntrochę wody z pastą sojową i cukrem,
Dialogue: 0,0:18:34.03,0:18:36.35,Default,Maomao,0,0,0,,ale zostawiłam ją\Nna szczycie wodospadu.
Dialogue: 0,0:18:36.80,0:18:40.11,Default,Maomao,0,0,0,,W każdym razie, odkąd\Nwyszedłeś na polowanie w masce,
Dialogue: 0,0:18:40.11,0:18:43.88,Default,Maomao,0,0,0,,odmawiałeś jedzenia i picia,\Nwięc pewnie jesteś w kiepskim stanie.
Dialogue: 0,0:18:43.88,0:18:47.78,Default,Maomao,0,0,0,,Nie boli cię głowa z powodu upału\Ni braku nawodnienia?
Dialogue: 0,0:18:57.71,0:19:02.37,Default,Maomao,0,0,0,,Gorączka chyba ustąpiła,\Nale na wszelki wypadek zjedz trochę soli.
Dialogue: 0,0:19:03.11,0:19:04.97,Default,Jinshi,0,0,0,,Jeśli tak twierdzisz...
Dialogue: 0,0:19:07.78,0:19:09.63,Default,Jinshi,0,0,0,,Lepsze, niż sądziłem.
Dialogue: 0,0:19:14.67,0:19:15.86,Default,Jinshi,0,0,0,,Ty też trochę zjedz.
Dialogue: 0,0:19:18.61,0:19:19.88,Default,Maomao,0,0,0,,Smacznego.
Dialogue: 0,0:19:24.97,0:19:27.40,Default,Maomao,0,0,0,,A tak w ogóle, co to było?
Dialogue: 0,0:19:28.33,0:19:29.64,Default,Jinshi,0,0,0,,Eruptor.
Dialogue: 0,0:19:29.64,0:19:30.56,Default,Maomao,0,0,0,,Eruptor?
Dialogue: 0,0:19:31.11,0:19:34.08,Default,Jinshi,0,0,0,,To broń wojenna\Nwykorzystująca proch strzelniczy.
Dialogue: 0,0:19:34.51,0:19:37.20,Default,Jinshi,0,0,0,,Wymaga przygotowania po każdym strzale.
Dialogue: 0,0:19:37.20,0:19:39.99,Default,Jinshi,0,0,0,,Jednak strzelili dwa razy z rzędu.
Dialogue: 0,0:19:41.78,0:19:44.70,Default,Maomao,0,0,0,,Zatem oznacza to,\Nże było wielu sprawców?
Dialogue: 0,0:19:44.70,0:19:49.45,Default,Jinshi,0,0,0,,Tak, przynajmniej dwóch. Może więcej.
Dialogue: 0,0:19:50.77,0:19:53.96,Default,Maomao,0,0,0,,{\i1}Kto żywi do niego urazę i dlaczego?
Dialogue: 0,0:20:02.39,0:20:06.43,Default,Maomao,0,0,0,,Panie Jinshi, wiesz, jak stąd wyjść?
Dialogue: 0,0:20:06.43,0:20:09.14,Default,Maomao,0,0,0,,Poza pływaniem, oczywiście.
Dialogue: 0,0:20:09.14,0:20:10.81,Default,Jinshi,0,0,0,,Głębiej w stropie jest dziura.
Dialogue: 0,0:20:11.34,0:20:14.21,Default,Maomao,0,0,0,,Pan Gaoshun o tym wie?
Dialogue: 0,0:20:14.21,0:20:19.78,Default,Jinshi,0,0,0,,Raczej nie. Basen będzie wiedział,\Nale nie wiem, czy od razu to zauważy...
Dialogue: 0,0:20:28.83,0:20:32.60,Default,Maomao,0,0,0,,Może stąd krzykniemy,\Nby wezwać pomoc?
Dialogue: 0,0:20:32.60,0:20:34.92,Default,Jinshi,0,0,0,,Żeby nas usłyszeli,\Nmusieliby być bardzo blisko.
Dialogue: 0,0:20:35.41,0:20:39.67,Default,Jinshi,0,0,0,,Może gdybyśmy krzyczeli cały dzień,\Nktoś by to zauważył, ale...
Dialogue: 0,0:20:41.59,0:20:42.61,Default,Jinshi,0,0,0,,Co to?
Dialogue: 0,0:20:42.61,0:20:44.01,Default,Maomao,0,0,0,,Nic takiego.
Dialogue: 0,0:20:44.92,0:20:48.43,Default,Jinshi,0,0,0,,Jest wysoko, ale jak jedno stanie na drugim,\Nmoże uda nam się dosięgnąć.
Dialogue: 0,0:20:49.69,0:20:53.27,Default,Maomao,0,0,0,,{\i1}Jeśli pani Suiren dowie się,\Nże podeptałam pana Jinshiego...
Dialogue: 0,0:20:56.05,0:20:58.30,Default,Jinshi,0,0,0,,Zmiażdżę cię, jeśli ja to zrobię.
Dialogue: 0,0:20:58.30,0:20:59.27,Default,Maomao,0,0,0,,Ale...
Dialogue: 0,0:20:59.53,0:21:00.25,Default,Jinshi,0,0,0,,Do dzieła.
Dialogue: 0,0:21:05.03,0:21:07.39,Default,Jinshi,0,0,0,,Powinnaś trochę przytyć.
Dialogue: 0,0:21:07.39,0:21:09.24,Default,Maomao,0,0,0,,To nieodpowiedni moment na to.
Dialogue: 0,0:21:12.26,0:21:15.94,Default,Maomao,0,0,0,,{\i1}Jest mokro i ślisko,\Nale dopóki mogę zahaczyć palcami...
Dialogue: 0,0:21:15.94,0:21:16.88,Default,Maomao,0,0,0,,Wstaję.
Dialogue: 0,0:21:16.88,0:21:17.71,Default,Jinshi,0,0,0,,Dobrze!
Dialogue: 0,0:21:30.42,0:21:31.90,Default,Maomao,0,0,0,,O, żabka.
Dialogue: 0,0:21:34.77,0:21:35.82,Default,Jinshi,0,0,0,,Ej!
Dialogue: 0,0:21:43.41,0:21:46.32,Default,Maomao,0,0,0,,{\i1}Nie bolało...
Dialogue: 0,0:21:58.87,0:22:00.92,Default,Maomao,0,0,0,,Przepraszam, panie Jinshi.
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Ka Zuigetsu”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
