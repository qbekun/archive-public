Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:33.98,0:01:34.99,Default,Lady-in-Waiting A,0,0,0,,Niemożliwe!
Dialogue: 0,0:01:35.32,0:01:39.28,Default,Text,0,0,0,,{\an8}ODCINEK 3: DUCH W ŚWIETLE KSIĘŻYCA
Dialogue: 0,0:01:35.88,0:01:36.90,Default,Lady-in-Waiting A,0,0,0,,Nagroda?
Dialogue: 0,0:01:41.88,0:01:43.08,Default,Fuyou,0,0,0,,Rozumiem.
Dialogue: 0,0:01:45.28,0:01:47.48,Default,Lady-in-Waiting B,0,0,0,,- Pani Fuyou!\N- Proszę zaczekać!
Dialogue: 0,0:02:24.15,0:02:25.60,Default,Yinghua,0,0,0,,Rany, ale zimno!
Dialogue: 0,0:02:25.60,0:02:27.98,Default,Guiyuan,0,0,0,,Jesteśmy w stolicy\Njuż od jakiegoś czasu,
Dialogue: 0,0:02:27.98,0:02:30.73,Default,Guiyuan,0,0,0,,ale poranny chłodek dalej zaskakuje.
Dialogue: 0,0:02:30.73,0:02:33.21,Default,Yinghua,0,0,0,,Tęsknię za piaskiem\Ni słońcem z mojego kraju.
Dialogue: 0,0:02:33.21,0:02:36.22,Default,Ailan,0,0,0,,Na zachodzie poranki\Ni noce również bywały zimne.
Dialogue: 0,0:02:36.22,0:02:38.00,Default,Guiyuan,0,0,0,,Zachodnia stolica…
Dialogue: 0,0:02:38.00,0:02:40.14,Default,Guiyuan,0,0,0,,To było wieki temu.
Dialogue: 0,0:02:40.14,0:02:44.20,Default,Guiyuan,0,0,0,,Za to przybycie pani Gyokuyou\Ndo pałacu pamiętam jakby było wczoraj.
Dialogue: 0,0:02:44.61,0:02:48.40,Default,Ailan,0,0,0,,Przy okazji mój ojciec\Nprzekazał mi dobre wieści.
Dialogue: 0,0:02:48.40,0:02:52.48,Default,Ailan,0,0,0,,Handel między zachodnimi\Ni centralnymi stolicami nabiera tempa.
Dialogue: 0,0:02:52.92,0:02:55.44,Default,Guiyuan,0,0,0,,Cesarz naprawdę kocha panią Gyokuyou.
Dialogue: 0,0:02:55.74,0:02:58.92,Default,Yinghua,0,0,0,,To dom rodzinny ulubienicy cesarza.
Dialogue: 0,0:02:58.92,0:03:00.98,Default,Yinghua,0,0,0,,Z pewnością urzędnicy\Ntego nie zignorują.
Dialogue: 0,0:03:01.56,0:03:05.03,Default,Ailan,0,0,0,,Sprzątasz kuchnię?\NMożemy pomóc.
Dialogue: 0,0:03:05.03,0:03:08.80,Default,Yinghua,0,0,0,,Nie, musimy się rozdzielić,\Nbo nigdy nie skończymy pracy.
Dialogue: 0,0:03:08.80,0:03:10.79,Default,Yinghua,0,0,0,,Nie możemy polegać na innych.
Dialogue: 0,0:03:10.79,0:03:13.68,Default,Ailan,0,0,0,,Pamiętam, co się działo,\Nkiedy była w ciąży.
Dialogue: 0,0:03:13.68,0:03:16.84,Default,Ailan,0,0,0,,Na przykład, gdy w jej stroju\Nznaleziono zatrutą igłę.
Dialogue: 0,0:03:16.84,0:03:20.29,Default,Yinghua,0,0,0,,Prawdopodobnie dlatego,\Nże jest księżniczką obcego kraju.
Dialogue: 0,0:03:20.29,0:03:24.05,Default,Guiyuan,0,0,0,,Jest dobrze. Mamy dodatkową\Nosobistą służącą, co nie?
Dialogue: 0,0:03:26.87,0:03:29.52,Default,Yinghua,0,0,0,,Maomao, co robisz?
Dialogue: 0,0:03:29.52,0:03:30.97,Default,Maomao,0,0,0,,Lek na przeziębienie.
Dialogue: 0,0:03:30.97,0:03:32.90,Default,Yinghua,0,0,0,,Takie też umiesz zrobić?
Dialogue: 0,0:03:33.73,0:03:35.86,Default,Yinghua,0,0,0,,Nasza świeżynka jest taka utalentowana.
Dialogue: 0,0:03:40.78,0:03:43.31,Default,Yinghua,0,0,0,,Ej, na pewno niczego nie potrzebujesz?
Dialogue: 0,0:03:43.31,0:03:44.76,Default,Yinghua,0,0,0,,Dobrze się odżywiasz?
Dialogue: 0,0:03:44.76,0:03:46.17,Default,Maomao,0,0,0,,Tak, dzięki tobie…
Dialogue: 0,0:03:46.17,0:03:48.68,Default,Yinghua,0,0,0,,Pamiętaj, nie ukrywaj niczego!
Dialogue: 0,0:03:48.68,0:03:49.79,Default,Maomao,0,0,0,,Jasne…
Dialogue: 0,0:03:51.21,0:03:56.43,Default,Yinghua,0,0,0,,Swoją drogą, słyszałaś nową\Nplotkę, o której każdy mówi?
Dialogue: 0,0:03:56.43,0:03:57.45,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:03:58.05,0:04:00.26,Default,Yinghua,0,0,0,,Podobno w wewnętrznym\Npałacu pojawił się duch.
Dialogue: 0,0:04:01.57,0:04:02.97,Default,Maomao,0,0,0,,Duch?
Dialogue: 0,0:04:02.97,0:04:05.80,Default,Xialoan,0,0,0,,Słyszałam! Upiorna kobieta w bieli, tak?
Dialogue: 0,0:04:06.26,0:04:07.49,Default,Maomao,0,0,0,,A więc jest sławna?
Dialogue: 0,0:04:07.94,0:04:11.52,Default,Xialoan,0,0,0,,Każdy o niej mówi,\Nsłudzy, eunuchowie i konkubiny!
Dialogue: 0,0:04:12.12,0:04:14.48,Default,Xiaolan,0,0,0,,Chyba zaczęło się to kilka tygodni temu.
Dialogue: 0,0:04:14.48,0:04:18.82,Default,Xiaolan,0,0,0,,Ponoć ta upiorna biała dama\Ntańczy przy świetle księżyca!
Dialogue: 0,0:04:20.08,0:04:23.20,Default,Xiaolan,0,0,0,,I co noc pojawia się\Nna wschodnich murach obronnych!
Dialogue: 0,0:04:26.34,0:04:27.70,Default,Maomao,0,0,0,,Aha…
Dialogue: 0,0:04:28.92,0:04:31.87,Default,Maomao,0,0,0,,Mury obronne otaczają\Ncałkowicie wewnętrzny pałac.
Dialogue: 0,0:04:32.28,0:04:37.59,Default,Maomao,0,0,0,,Wejść można z czterech stron:\Npółnocy, południa, wschodu i zachodu.
Dialogue: 0,0:04:39.59,0:04:44.62,Default,Maomao,0,0,0,,Bramy są stale strzeżone,\Na mury otoczone fosą.
Dialogue: 0,0:04:44.62,0:04:46.59,Default,Maomao,0,0,0,,Trudno tam wejść i wyjść.
Dialogue: 0,0:04:47.52,0:04:51.68,Default,Maomao,0,0,0,,Powiadają, że głębiny fosy skrywają…
Dialogue: 0,0:04:55.77,0:04:59.65,Default,Maomao,0,0,0,,Ciała konkubin,\Nktóre próbowały uciec.
Dialogue: 0,0:04:59.65,0:05:03.03,Default,Maomao,0,0,0,,Innymi słowy,\Ntypowa historyjka o duchach.
Dialogue: 0,0:05:03.34,0:05:05.98,Default,Xiaolan,0,0,0,,Co mam zrobić, gdy go zobaczę?
Dialogue: 0,0:05:05.98,0:05:07.97,Default,Maomao,0,0,0,,To tylko pogłoski.
Dialogue: 0,0:05:11.30,0:05:14.12,Default,Maomao,0,0,0,,Przepraszam.\NCzy mógłbyś rzucić okiem na ten lek?
Dialogue: 0,0:05:14.64,0:05:18.13,Default,Guen,0,0,0,,Witaj, panienko. Chwileczkę.
Dialogue: 0,0:05:18.13,0:05:21.75,Default,Maomao,0,0,0,,A jeszcze niedawno\Ntak się mnie obawiał.
Dialogue: 0,0:05:22.63,0:05:28.55,Default,Maomao,0,0,0,,Gdy dowiedział się, że umiem\Ntworzyć leki, sam mi na to pozwolił.
Dialogue: 0,0:05:28.55,0:05:31.26,Default,Maomao,0,0,0,,Daje mi też potrzebne składniki.
Dialogue: 0,0:05:31.26,0:05:33.18,Default,Maomao,0,0,0,,Nawet parzy mi herbatkę.
Dialogue: 0,0:05:33.91,0:05:36.77,Default,Maomao,0,0,0,,Może naprawdę powinnam wyluzować?
Dialogue: 0,0:05:37.83,0:05:39.15,Default,Guen,0,0,0,,Wybacz, że tyle czekałaś.
Dialogue: 0,0:05:42.75,0:05:45.36,Default,Guen,0,0,0,,Bardziej wolisz słone \Nniż słodkie, prawda?
Dialogue: 0,0:05:45.36,0:05:47.32,Default,Jinshi,0,0,0,,Też mogę trochę dostać?
Dialogue: 0,0:05:48.00,0:05:49.00,Default,Guen,0,0,0,,Jak najbardziej!
Dialogue: 0,0:05:53.54,0:05:55.53,Default,Jinshi,0,0,0,,Dobra robota.
Dialogue: 0,0:05:55.53,0:05:57.21,Default,Maomao,0,0,0,,To wszystko, co mogłam zrobić.
Dialogue: 0,0:05:58.28,0:06:00.33,Default,Maomao,0,0,0,,Czy on nie ma nic lepszego do roboty?
Dialogue: 0,0:06:01.00,0:06:03.69,Default,Maomao,0,0,0,,Czy on nie ma czasem własnego biura?
Dialogue: 0,0:06:03.69,0:06:07.81,Default,Maomao,0,0,0,,Tymczasem błąka się po całym\Npałacu, niczym pies na służbie…
Dialogue: 0,0:06:09.68,0:06:13.68,Default,Maomao,0,0,0,,Zdecydowanie zachowuje się jak ktoś,\Nkto jest wyżej niż nadzorca haremu.
Dialogue: 0,0:06:14.37,0:06:20.19,Default,Maomao,0,0,0,,Mógłby być strażnikiem cesarza,\Nale jest chyba na to za młody.
Dialogue: 0,0:06:20.84,0:06:25.69,Default,Maomao,0,0,0,,Już wiem, to pewnie\N„osobisty wybraniec” cesarza.
Dialogue: 0,0:06:26.50,0:06:29.45,Default,Jinshi,0,0,0,,Czyżbyś pomyślała o czymś zbereźnym?
Dialogue: 0,0:06:29.45,0:06:31.78,Default,Maomao,0,0,0,,Ułańska fantazja cię ponosi.
Dialogue: 0,0:06:32.42,0:06:36.63,Default,Jinshi,0,0,0,,Doktorze, czy mógłbyś mi to przynieść?
Dialogue: 0,0:06:41.75,0:06:44.25,Default,Maomao,0,0,0,,Czego więc tak naprawdę chcesz?
Dialogue: 0,0:06:45.91,0:06:47.76,Default,Jinshi,0,0,0,,Słyszałaś już może o duchu?
Dialogue: 0,0:06:48.15,0:06:49.68,Default,Maomao,0,0,0,,Coś tam mi się obiło.
Dialogue: 0,0:06:49.68,0:06:52.05,Default,Jinshi,0,0,0,,A może to lunatykowanie?
Dialogue: 0,0:06:54.40,0:06:55.56,Default,Maomao,0,0,0,,Lunatykowanie…
Dialogue: 0,0:06:56.61,0:06:58.23,Default,Jinshi,0,0,0,,W końcu przykułem twoją uwagę.
Dialogue: 0,0:07:02.64,0:07:04.06,Default,Jinshi,0,0,0,,Jak można to wyleczyć?
Dialogue: 0,0:07:04.80,0:07:08.57,Default,Maomao,0,0,0,,Nie wiem. Nie ma na to lekarstwa.
Dialogue: 0,0:07:08.57,0:07:11.07,Default,Jinshi,0,0,0,,A może jest coś innego niż leki?
Dialogue: 0,0:07:11.07,0:07:13.49,Default,Maomao,0,0,0,,Specjalizuję się w medycynie.
Dialogue: 0,0:07:15.67,0:07:16.95,Default,Jinshi,0,0,0,,Wielka szkoda.
Dialogue: 0,0:07:20.64,0:07:22.46,Default,Jinshi,0,0,0,,Naprawdę wielka szkoda.
Dialogue: 0,0:07:23.96,0:07:27.40,Default,Maomao,0,0,0,,Ohyda! Ale się klei!
Dialogue: 0,0:07:30.23,0:07:31.78,Default,Maomao,0,0,0,,Zrobię, co mogę.
Dialogue: 0,0:07:44.84,0:07:47.86,Default,Maomao,0,0,0,,Ten gość nie wygląda jak eunuch.
Dialogue: 0,0:07:49.54,0:07:50.74,Default,Gaoshun,0,0,0,,Panienko Maomao.
Dialogue: 0,0:07:51.16,0:07:56.07,Default,Maomao,0,0,0,,Błagam, nie nazywaj mnie\N„panienką”. Jesteś ode mnie starszy.
Dialogue: 0,0:07:56.87,0:07:59.06,Default,Gaoshun,0,0,0,,W takim razie może Xiaomao?
Dialogue: 0,0:07:59.49,0:08:02.58,Default,Maomao,0,0,0,,„Xiao”? Teraz to poleciał.
Dialogue: 0,0:08:02.58,0:08:08.38,Default,Gaoshun,0,0,0,,Mogłabyś nie patrzeć\Nna pana Jinshiego jak na robaka?
Dialogue: 0,0:08:08.38,0:08:10.21,Default,Maomao,0,0,0,,Rany, domyślił się.
Dialogue: 0,0:08:10.60,0:08:12.55,Default,Gaoshun,0,0,0,,Gdy wrócił do biura,
Dialogue: 0,0:08:12.55,0:08:17.55,Default,Gaoshun,0,0,0,,z zachwytem opowiadał, że patrzyłaś\Nsię na niego, jak na jadowitą gąsienicą.
Dialogue: 0,0:08:19.20,0:08:21.09,Default,Maomao,0,0,0,,Postaram się.
Dialogue: 0,0:08:24.20,0:08:28.86,Default,Gaoshun,0,0,0,,Jeżeli ktoś niepowołany zobaczyłby\Ngo w takim stanie, padły trupem.
Dialogue: 0,0:08:30.18,0:08:32.19,Default,Maomao,0,0,0,,Dla każdego coś innego…
Dialogue: 0,0:08:40.12,0:08:41.27,Default,Gaoshun,0,0,0,,To tam.
Dialogue: 0,0:08:51.14,0:08:53.09,Default,Maomao,0,0,0,,Bawełniana róża w świetle księżyca…
Dialogue: 0,0:08:53.92,0:08:55.88,Default,Gaoshun,0,0,0,,Dobrze zgadujesz.
Dialogue: 0,0:08:57.33,0:08:59.64,Default,Gaoshun,0,0,0,,To księżniczka Fuyou.
Dialogue: 0,0:09:00.66,0:09:02.00,Default,Gaoshun,0,0,0,,Ma średnią rangę konkubiny,
Dialogue: 0,0:09:02.00,0:09:05.27,Default,Gaoshun,0,0,0,,która w nagrodę\Nma zostać oddana oficerowi.
Dialogue: 0,0:09:14.59,0:09:16.89,Default,Guen,0,0,0,,To już chyba dwa lata.
Dialogue: 0,0:09:16.89,0:09:19.14,Default,Guen,0,0,0,,Bardzo nieśmiała księżniczka.
Dialogue: 0,0:09:19.68,0:09:23.15,Default,Guen,0,0,0,,Wykonując taniec przed cesarzem,\Npotknęła się podczas swego występu.
Dialogue: 0,0:09:23.15,0:09:28.67,Default,Guen,0,0,0,,Cesarz nie tknął jej palcem, a ona\Nod tego czasu zamknęła się w sobie.
Dialogue: 0,0:09:30.21,0:09:33.25,Default,Guen,0,0,0,,Pewnych rzeczy\Nnie da się uniknąć, ale…
Dialogue: 0,0:09:34.12,0:09:35.43,Default,Ladies-in-Waiting,0,0,0,,{\an8}- Pani Fuyou!
Dialogue: 0,0:09:34.12,0:09:36.36,Default,Guen,0,0,0,,- Darowizna? Współczuję jej.
Dialogue: 0,0:09:38.56,0:09:41.88,Default,Maomao,0,0,0,,Lunatykuje, bo potraktowano ją\Njako nagrodę?
Dialogue: 0,0:09:41.88,0:09:45.35,Default,Maomao,0,0,0,,Powiadają, że jest to choroba\Nwynikająca z zachwianej psychiki…
Dialogue: 0,0:09:46.61,0:09:49.85,Default,Maomao,0,0,0,,Potrzebuję więcej informacji.
Dialogue: 0,0:09:49.85,0:09:51.77,Default,Maomao,0,0,0,,Przyjrzę się jej jeszcze raz.
Dialogue: 0,0:09:52.31,0:09:54.41,Default,Maomao,0,0,0,,Gdzie jest pokój konkubiny Fuyou?
Dialogue: 0,0:09:55.28,0:09:57.37,Default,Guen,0,0,0,,Znajduje się on na północnej stronie.
Dialogue: 0,0:09:57.83,0:10:01.24,Default,Maomao,0,0,0,,Dziękuję. I dziękuję za przekąski.
Dialogue: 0,0:10:01.94,0:10:03.33,Default,Guen,0,0,0,,Wychodzisz już?
Dialogue: 0,0:10:05.16,0:10:07.85,Default,Guen,0,0,0,,Mam nadzieję, że poczuje się lepiej.
Dialogue: 0,0:10:08.31,0:10:10.99,Default,Guen,0,0,0,,Podobno to księżniczka\Nz małego państwa wasalnego.
Dialogue: 0,0:10:10.99,0:10:13.00,Default,Guen,0,0,0,,Z pewnością nie chciałaby tam wracać.
Dialogue: 0,0:10:14.29,0:10:15.46,Default,Maomao,0,0,0,,Wracać?
Dialogue: 0,0:10:15.92,0:10:17.75,Default,Guen,0,0,0,,Tak. Bo wiesz…
Dialogue: 0,0:10:18.99,0:10:21.61,Default,Lady-in-Waiting,0,0,0,,Żal mi konkubiny Fuyou.
Dialogue: 0,0:10:21.97,0:10:24.78,Default,Low-rank Concubine,0,0,0,,Ta, w końcu będzie\Noddana jakiemuś oficerowi.
Dialogue: 0,0:10:24.78,0:10:26.48,Default,Low-rank Concubine,0,0,0,,Mam ciarki, gdy o tym pomyślę.
Dialogue: 0,0:10:36.01,0:10:41.12,Default,Maomao,0,0,0,,Wygląda całkowicie inaczej\Nniż podczas tańca na murze.
Dialogue: 0,0:10:41.12,0:10:45.24,Default,Gaoshun,0,0,0,,Tak, sam byłem zdziwiony,\Ngdy pierwszy raz ją spotkałem.
Dialogue: 0,0:10:45.80,0:10:47.83,Default,Gaoshun,0,0,0,,Zazwyczaj jest bardzo powściągliwa.
Dialogue: 0,0:10:49.16,0:10:51.83,Default,Maomao,0,0,0,,Naprawdę jest jak bawełniana róża.
Dialogue: 0,0:10:52.22,0:10:53.72,Default,Gaoshun,0,0,0,,Bawełniana róża?
Dialogue: 0,0:10:54.12,0:10:55.16,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:10:55.62,0:10:58.14,Default,Maomao,0,0,0,,Kwiat fuyou,\Ninaczej bawełniana róża,
Dialogue: 0,0:10:58.14,0:11:00.37,Default,Maomao,0,0,0,,wita poranek pięknym białym kwiatem,
Dialogue: 0,0:11:00.97,0:11:06.34,Default,Maomao,0,0,0,,zaś wieczorem zmienia kolor na różowy.
Dialogue: 0,0:11:06.97,0:11:11.45,Default,Gaoshun,0,0,0,,Czyli kwiat ten zmienia swoje\Noblicze w ciągu jednego dnia?
Dialogue: 0,0:11:11.45,0:11:12.45,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:11:18.78,0:11:20.49,Default,Xiaolan,0,0,0,,Historia o duchu?
Dialogue: 0,0:11:20.49,0:11:25.01,Default,Maomao,0,0,0,,Tak, chciałabym usłyszeć więcej\Nna ten temat. Wiesz coś jeszcze?
Dialogue: 0,0:11:26.15,0:11:31.66,Default,Xiaolan,0,0,0,,Ponoć po raz pierwszy\Npokazała się na północnej stronie.
Dialogue: 0,0:11:31.66,0:11:33.91,Default,Maomao,0,0,0,,- Co? Północ?
Dialogue: 0,0:11:33.07,0:11:36.05,Default,Serving girl,0,0,0,,{\an8}- Xiaolan! Pranie!
Dialogue: 0,0:11:35.44,0:11:37.42,Default,Maomao,0,0,0,,- Przeprowadziła się\Nz północy na wschód?
Dialogue: 0,0:11:36.56,0:11:37.85,Default,Xiaolan,0,0,0,,{\an8}- Idę!
Dialogue: 0,0:11:37.85,0:11:38.88,Default,Xiaolan,0,0,0,,{\an8}- Muszę lecieć.
Dialogue: 0,0:11:37.85,0:11:38.88,Default,Maomao,0,0,0,,- Tylko…
Dialogue: 0,0:11:39.34,0:11:41.72,Default,Guen,0,0,0,,Tak. Bo wiesz…
Dialogue: 0,0:11:42.31,0:11:45.56,Default,Maomao,0,0,0,,Wiedziałam. Konkubina Fuyou jest…
Dialogue: 0,0:11:50.56,0:11:55.23,Default,Maomao,0,0,0,,Ojciec zawsze mówił,\Nbym nie gdybała, jednak…
Dialogue: 0,0:11:57.43,0:12:01.20,Default,Maomao,0,0,0,,Na temat lunatykowania\Nnie wiadomo zbyt wiele.
Dialogue: 0,0:12:01.20,0:12:03.68,Default,Maomao,0,0,0,,Podobno jest to choroba duszy.
Dialogue: 0,0:12:03.68,0:12:07.66,Default,Maomao,0,0,0,,Chory porusza się podczas snu,\Ntak jakby nie spał.
Dialogue: 0,0:12:08.90,0:12:13.62,Default,Maomao,0,0,0,,W jednym z domów schadzek\Npewna kurtyzana też na to zapadła.
Dialogue: 0,0:12:15.40,0:12:18.46,Default,Maomao,0,0,0,,Była wesołą osobą, kochającą poezję.
Dialogue: 0,0:12:18.46,0:12:20.70,Default,Maomao,0,0,0,,Dostała nawet propozycję wykupu.
Dialogue: 0,0:12:22.05,0:12:25.01,Default,Maomao,0,0,0,,Jednakże nie doszło to do skutku.
Dialogue: 0,0:12:25.91,0:12:31.43,Default,Maomao,0,0,0,,Zaraz po tym zaczęła błąkać się\Npo korytarzach niczym opętana.
Dialogue: 0,0:12:39.64,0:12:42.32,Default,Courtesan A,0,0,0,,Ojej. Co się stało, kochani?
Dialogue: 0,0:12:43.19,0:12:46.82,Default,Maomao,0,0,0,,Nic nie pamiętała z minionej nocy.
Dialogue: 0,0:12:47.44,0:12:49.53,Default,Jinshi,0,0,0,,I co się potem stało?
Dialogue: 0,0:12:49.53,0:12:55.04,Default,Maomao,0,0,0,,Nic. Po wycofaniu propozycji\Nwykupu lunatykowanie ustało.
Dialogue: 0,0:12:55.36,0:12:59.50,Default,Gyokuyou,0,0,0,,Czyli… ta kurtyzana\Nnie chciała zostać sprzedana?
Dialogue: 0,0:13:01.65,0:13:02.80,Default,Maomao,0,0,0,,Możliwe.
Dialogue: 0,0:13:03.65,0:13:05.47,Default,Maomao,0,0,0,,Propozycję złożył bogaty kupiec,
Dialogue: 0,0:13:06.07,0:13:09.38,Default,Maomao,0,0,0,,który nie tylko miał żonę i dzieci,\Nale także wnuki.
Dialogue: 0,0:13:10.38,0:13:14.73,Default,Maomao,0,0,0,,Rok później jej kontrakt\Nz domem uciech wygasł.
Dialogue: 0,0:13:18.76,0:13:21.23,Default,Gyokuyou,0,0,0,,Może konkubina Fuyou jest taka sama.
Dialogue: 0,0:13:21.55,0:13:25.57,Default,Jinshi,0,0,0,,Czy to już wszystko?
Dialogue: 0,0:13:29.20,0:13:30.33,Default,Maomao,0,0,0,,Zdecydowanie.
Dialogue: 0,0:13:31.40,0:13:33.08,Default,Jinshi,0,0,0,,Naprawdę?
Dialogue: 0,0:13:35.27,0:13:37.08,Default,Gaoshun,0,0,0,,Proszę, zachowaj spokój.
Dialogue: 0,0:13:37.48,0:13:39.08,Default,Maomao,0,0,0,,Wrócę do pracy.
Dialogue: 0,0:13:47.48,0:13:51.34,Default,Maomao,0,0,0,,Od tamtej nocy konkubina Fuyou\Nnie mogła opuszczać swojego pokoju.
Dialogue: 0,0:13:52.10,0:13:56.60,Default,Maomao,0,0,0,,Dopóki nie została oddana,\Neunuchowie mieli jej pilnować.
Dialogue: 0,0:14:00.61,0:14:02.82,Default,Maomao,0,0,0,,Mam nadzieję, że to wypali.
Dialogue: 0,0:14:07.52,0:14:11.51,Default,Gyokuyou,0,0,0,,Czy Maomao nie\Nzachowuje się ostatnio dziwnie?
Dialogue: 0,0:14:12.00,0:14:13.74,Default,Hongniang,0,0,0,,Naprawdę?
Dialogue: 0,0:14:21.72,0:14:22.81,Default,Gyokuyou,0,0,0,,Tak myślę.
Dialogue: 0,0:14:23.43,0:14:25.08,Default,Gyokuyou,0,0,0,,Coś musi być na rzeczy.
Dialogue: 0,0:14:32.29,0:14:36.06,Default,Gyokuyou,0,0,0,,Konkubina Fuyou\Ndzisiaj odejdzie, prawda?
Dialogue: 0,0:14:37.17,0:14:38.89,Default,Maomao,0,0,0,,Tak słyszałam.
Dialogue: 0,0:14:56.15,0:14:57.20,Default,Gyokuyou,0,0,0,,Ej.
Dialogue: 0,0:14:57.41,0:15:03.42,Default,Gyokuyou,0,0,0,,To jaki był koniec tamtej historii?
Dialogue: 0,0:15:04.20,0:15:07.78,Default,Gyokuyou,0,0,0,,Nie będę zła,\Nw końca sama o to pytam.
Dialogue: 0,0:15:11.19,0:15:16.51,Default,Maomao,0,0,0,,To jedynie gdybanie, więc\Nchciałabym, by zostało to tajemnicą.
Dialogue: 0,0:15:16.51,0:15:18.47,Default,Gyokuyou,0,0,0,,Buzia na kłódkę.
Dialogue: 0,0:15:21.54,0:15:24.84,Default,Maomao,0,0,0,,Pamięta pani historię kurtyzany,\No której opowiadałam?
Dialogue: 0,0:15:25.48,0:15:27.24,Default,Gyokuyou,0,0,0,,Tej lunatyczki?
Dialogue: 0,0:15:27.24,0:15:28.28,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:15:28.62,0:15:31.66,Default,Maomao,0,0,0,,Z tego samego powodu
Dialogue: 0,0:15:31.66,0:15:34.78,Default,Maomao,0,0,0,,odwołano ofertę\Nnabycia innej kurtyzany.
Dialogue: 0,0:15:34.78,0:15:39.79,Default,Maomao,0,0,0,,Wkrótce potem\Nwpłynęła kolejna oferta,
Dialogue: 0,0:15:39.79,0:15:45.08,Default,Maomao,0,0,0,,ale z uwagi na jej stan zdrowia,\Ncena została obniżona o połowę.
Dialogue: 0,0:15:46.15,0:15:49.18,Default,Maomao,0,0,0,,Było to jednak oszustwo.
Dialogue: 0,0:15:49.62,0:15:50.84,Default,Gyokuyou,0,0,0,,Oszustwo?
Dialogue: 0,0:15:51.41,0:15:55.76,Default,Maomao,0,0,0,,Klienci składający\Nofertę doskonale się znali.
Dialogue: 0,0:15:56.53,0:16:01.66,Default,Maomao,0,0,0,,Kobieta udawała chorą,\Naby uniknąć pierwszej oferty.
Dialogue: 0,0:16:01.66,0:16:06.61,Default,Maomao,0,0,0,,Wówczas prawdziwy kupiec\Nzłożył ofertę o połowę niższą.
Dialogue: 0,0:16:07.65,0:16:11.64,Default,Maomao,0,0,0,,Chcieli być ze sobą,\Nale on miał za mało pieniędzy,
Dialogue: 0,0:16:11.64,0:16:13.96,Default,Maomao,0,0,0,,a ona kontrakt z domem schadzek.
Dialogue: 0,0:16:15.12,0:16:19.12,Default,Gyokuyou,0,0,0,,Myślisz, że z konkubiną\NFuyou jest tak samo?
Dialogue: 0,0:16:19.52,0:16:22.03,Default,Maomao,0,0,0,,Konkubina Fuyou i oficer wojskowy
Dialogue: 0,0:16:22.03,0:16:25.84,Default,Maomao,0,0,0,,to przyjaciele z dzieciństwa,\Nktórzy razem się wychowali.
Dialogue: 0,0:16:25.84,0:16:26.84,Default,Gyokuyou,0,0,0,,Co?
Dialogue: 0,0:16:26.84,0:16:33.13,Default,Maomao,0,0,0,,Podobno ten człowiek wykazał się\Nodwagą, walcząc z barbarzyńcami.
Dialogue: 0,0:17:03.58,0:17:05.69,Default,Maomao,0,0,0,,Zapytany o nagrodę,
Dialogue: 0,0:17:05.69,0:17:09.00,Default,Maomao,0,0,0,,usilnie nalegał na konkubinę Fuyou.
Dialogue: 0,0:17:12.20,0:17:16.92,Default,Maomao,0,0,0,,Zapewne marzył o tym,\Nzanim jeszcze opuścił dom.
Dialogue: 0,0:17:17.54,0:17:21.39,Default,Maomao,0,0,0,,Jako oficer nigdy nie mógł\Noświadczyć się księżniczce.
Dialogue: 0,0:17:22.44,0:17:26.46,Default,Gyokuyou,0,0,0,,A później księżniczkę\Nzabrano do haremu.
Dialogue: 0,0:17:27.25,0:17:30.40,Default,Maomao,0,0,0,,Księżniczka też coś czuła\Ndo przyjaciela z dzieciństwa.
Dialogue: 0,0:17:31.17,0:17:33.90,Default,Maomao,0,0,0,,Dlatego też specjalnie\Npopełniła błąd w tańcu,
Dialogue: 0,0:17:34.17,0:17:37.91,Default,Maomao,0,0,0,,by nie zwrócić\Nna siebie uwagi cesarza.
Dialogue: 0,0:17:38.64,0:17:43.13,Default,Maomao,0,0,0,,Zgodnie z planem cesarz nigdy\Njej nie dotknął. Pozostała dziewicą.
Dialogue: 0,0:17:46.66,0:17:48.28,Default,Maomao,0,0,0,,Jednakże było możliwe,
Dialogue: 0,0:17:48.28,0:17:50.57,Default,Maomao,0,0,0,,że cesarz i tak zauważyłby\Nkonkubinę Fuyou,
Dialogue: 0,0:17:50.57,0:17:53.16,Default,Maomao,0,0,0,,zwłaszcza teraz,\Ngdy ma zostać oddana.
Dialogue: 0,0:17:53.67,0:17:56.70,Default,Gyokuyou,0,0,0,,Więc udawała chodzenie we śnie po to…
Dialogue: 0,0:17:57.38,0:18:01.93,Default,Gyokuyou,0,0,0,,by cesarz nie złożył jej \Nostatniej wizyty.
Dialogue: 0,0:18:02.28,0:18:05.48,Default,Maomao,0,0,0,,Ukochany walczył na wschodzie.
Dialogue: 0,0:18:05.48,0:18:08.56,Default,Maomao,0,0,0,,A nocne tańce\Nkonkubiny Fuyou odbywały się na…
Dialogue: 0,0:18:09.88,0:18:11.06,Default,Gyokuyou,0,0,0,,Wschodniej bramie?
Dialogue: 0,0:18:12.29,0:18:15.05,Default,Maomao,0,0,0,,Być może czekała na jego powrót.
Dialogue: 0,0:18:15.05,0:18:17.40,Default,Maomao,0,0,0,,To tylko gdybanie, nic więcej.
Dialogue: 0,0:18:50.76,0:18:52.60,Default,Gyokuyou,0,0,0,,Hej, Maomao.
Dialogue: 0,0:18:52.60,0:18:53.64,Default,Maomao,0,0,0,,Tak?
Dialogue: 0,0:18:54.08,0:19:00.22,Default,Gyokuyou,0,0,0,,Czy będę okrutna, jeśli powiem,\Nże zazdroszczę konkubinie Fuyou?
Dialogue: 0,0:19:08.64,0:19:12.08,Default,Maomao,0,0,0,,Tego wieczoru jej uroda\Nzapierała dech w piersiach.
Dialogue: 0,0:19:16.56,0:19:21.75,Default,Maomao,0,0,0,,Całkowite przeciwieństwo jej nijakiego\Nwyglądu prezentowanego w ciągu dnia.
Dialogue: 0,0:19:26.48,0:19:28.93,Default,Maomao,0,0,0,,Nigdy bym tak nie pomyślała.
Dialogue: 0,0:19:55.65,0:19:56.73,Default,Gyokuyou,0,0,0,,Chodźmy.
Dialogue: 0,0:19:57.17,0:19:58.24,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:20:19.41,0:20:22.73,Default,Maomao,0,0,0,,Skoro miłość może\Nuczynić kobietę piękną,
Dialogue: 0,0:20:25.30,0:20:27.85,Default,Maomao,0,0,0,,mogłaby być lekiem\Nna wszystko, nie?
Dialogue: 0,0:20:55.23,0:20:59.05,Default,Emperor,0,0,0,,Mam sprawę do tej małej zielarki,\No której jest głośno.
Dialogue: 0,0:22:34.95,0:22:36.95,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.17,0:22:48.74,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Groźba”.
Dialogue: 0,0:22:48.76,0:22:50.76,Default,,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
