Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.40,0:01:33.40,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:34.92,0:01:37.22,Default,Jinshi,0,0,0,,{\i1}Ten gwizdek...\NTo na pewno Lihaku.
Dialogue: 0,0:01:37.76,0:01:40.24,Default,Jinshi,0,0,0,,{\i1}Udało mu się uwolnić Maomao.
Dialogue: 0,0:01:40.98,0:01:41.80,Default,Jinshi,0,0,0,,Basen.
Dialogue: 0,0:01:42.41,0:01:43.70,Default,Jinshi,0,0,0,,Nie spinaj się tak.
Dialogue: 0,0:01:44.15,0:01:46.41,Default,Basen,0,0,0,,Zatem pozwól mi pójść przodem!
Dialogue: 0,0:01:52.54,0:01:53.88,Default,Jinshi,0,0,0,,Czekaj, cofnij się!
Dialogue: 0,0:01:54.67,0:01:55.88,Default,Basen,0,0,0,,Eruptor!
Dialogue: 0,0:01:55.88,0:01:56.63,Default,Jinshi,0,0,0,,Naprzód!
Dialogue: 0,0:01:56.63,0:01:57.76,Default,Kanzan,0,0,0,,Kurwa!
Dialogue: 0,0:02:02.60,0:02:04.10,Default,Jinshi,0,0,0,,Gdzie jest Shishou?
Dialogue: 0,0:02:04.40,0:02:08.37,Default,Kanzan,0,0,0,,Nie wiem! Wykiwali nas!
Dialogue: 0,0:02:08.37,0:02:10.13,Default,Basen,0,0,0,,Zapluty kłamca!
Dialogue: 0,0:02:10.13,0:02:13.90,Default,Basen,0,0,0,,Mamy dowody na to, że zdefraudowałeś\Npubliczne środki na tę twierdzę!
Dialogue: 0,0:02:14.61,0:02:16.67,Default,Basen,0,0,0,,Z pewnością wiesz, co to oznacza!
Dialogue: 0,0:02:17.34,0:02:19.31,Default,Kanzan,0,0,0,,Wmówiono nam, że to dla dobra kraju!
Dialogue: 0,0:02:19.31,0:02:22.25,Default,Kanzan,0,0,0,,Zrobiliśmy to tylko dla dobra kraju!
Dialogue: 0,0:02:23.74,0:02:26.12,Default,Shishou,0,0,0,,Jakże miło z twojej strony.
Dialogue: 0,0:02:30.30,0:02:32.84,Default,Shishou,0,0,0,,Skoro i tak ma zostać zabity...
Dialogue: 0,0:02:33.82,0:02:36.60,Default,Shishou,0,0,0,,To nie ma, co się opieprzać.
Dialogue: 0,0:02:36.60,0:02:37.17,Default,Basen,0,0,0,,Shishou!
Dialogue: 0,0:02:39.23,0:02:42.46,Default,Jinshi,0,0,0,,Jesteś na pozór spokojny, Shishou.
Dialogue: 0,0:02:43.98,0:02:45.43,Default,Jinshi,0,0,0,,Cesarski rozkaz.
Dialogue: 0,0:02:45.94,0:02:48.89,Default,Jinshi,0,0,0,,Jesteś aresztowany\Nza defraudację i rebelię.
Dialogue: 0,0:02:48.89,0:02:54.23,Default,Shishou,0,0,0,,To jasne, że rozkaz wydał cesarz,\Nskoro tu jesteście.
Dialogue: 0,0:02:54.52,0:02:56.69,Default,Soldier A,0,0,0,,Oszalałeś? Nie masz nawet zapałki!
Dialogue: 0,0:02:58.32,0:02:59.08,Default,Jinshi,0,0,0,,Padnij!
Dialogue: 0,0:03:03.70,0:03:10.03,Default,Shishou,0,0,0,,Żałosne. Na wolności żwawo\Nstrzelałeś do zwierzyny.
Dialogue: 0,0:03:10.03,0:03:14.05,Default,Shishou,0,0,0,,Nie mogłeś się doczekać,\Nby przetestować go na ludziach.
Dialogue: 0,0:03:14.05,0:03:15.25,Default,Shishou,0,0,0,,Wielka szkoda, prawda?
Dialogue: 0,0:03:15.25,0:03:17.28,Default,Kanzan,0,0,0,,Nic takiego nie mówiłem!
Dialogue: 0,0:03:17.28,0:03:18.77,Default,Soldier B,0,0,0,,Bez zapałki?!
Dialogue: 0,0:03:18.77,0:03:22.38,Default,Jinshi,0,0,0,,To najnowszy model.\NMoże strzelać bez niej.
Dialogue: 0,0:03:22.38,0:03:24.72,Default,Shishou,0,0,0,,Oczywiście, że wiedziałeś.
Dialogue: 0,0:03:25.00,0:03:26.81,Default,Jinshi,0,0,0,,Zaatakowali mnie jedną z nich.
Dialogue: 0,0:03:27.21,0:03:31.60,Default,Shishou,0,0,0,,Było blisko. Szkoda, że wtedy\Nnie udało mi się ciebie zabić.
Dialogue: 0,0:03:32.45,0:03:34.61,Default,Shishou,0,0,0,,Naprawdę, było tak blisko.
Dialogue: 0,0:03:35.24,0:03:37.48,Default,Shishou,0,0,0,,Cóż, to chyba koniec.
Dialogue: 0,0:03:38.12,0:03:40.49,Default,Shishou,0,0,0,,Gdybym tylko miał więcej czasu...
Dialogue: 0,0:03:40.89,0:03:44.16,Default,Shishou,0,0,0,,Chociaż nie. Może to\Nwcale by nie pomogło.
Dialogue: 0,0:03:44.60,0:03:45.78,Default,Jinshi,0,0,0,,{\i1}Co takiego?
Dialogue: 0,0:03:46.14,0:03:48.95,Default,Jinshi,0,0,0,,{\i1}Tak jakby powtarzał gotowy scenariusz...
Dialogue: 0,0:03:51.62,0:03:52.96,Default,Basen,0,0,0,,Brać go!
Dialogue: 0,0:04:28.55,0:04:33.08,Default,Jinshi,0,0,0,,{\i1}Zupełnie jakbym oglądał\Nsztukę odgrywaną przez Shishou.
Dialogue: 0,0:04:36.88,0:04:39.49,Default,Jinshi,0,0,0,,{\i1}Najważniejszy doradca cesarza
Dialogue: 0,0:04:39.49,0:04:40.59,Default,Jinshi,0,0,0,,{\i1}i zdrajca.
Dialogue: 0,0:04:41.00,0:04:42.84,Default,Jinshi,0,0,0,,{\i1}Porywczy? Rozczarowujący?
Dialogue: 0,0:04:43.70,0:04:45.40,Default,Jinshi,0,0,0,,{\i1}Jedno i drugie pasuje.
Dialogue: 0,0:04:47.17,0:04:49.35,Default,Woman 1,0,0,0,,Nic nie zrobiliśmy!
Dialogue: 0,0:04:47.89,0:04:51.81,Default,Text,0,0,0,,{\an8}ODCINEK 47: KLAN SHI
Dialogue: 0,0:04:49.35,0:04:51.97,Default,Woman 2,0,0,0,,Shenmei i Loulan są w tylnym pokoju!
Dialogue: 0,0:04:52.66,0:04:53.99,Default,Jinshi,0,0,0,,Zajmij się tym.
Dialogue: 0,0:04:53.99,0:04:54.77,Default,Soldier 1,0,0,0,,Dobrze.
Dialogue: 0,0:05:00.42,0:05:01.44,Default,Jinshi,0,0,0,,Sprawdźcie tam.
Dialogue: 0,0:05:01.44,0:05:02.43,Default,Basen,0,0,0,,Zrozumiano.
Dialogue: 0,0:05:16.60,0:05:17.94,Default,Loulan,0,0,0,,Akuku.
Dialogue: 0,0:05:19.58,0:05:20.50,Default,Jinshi,0,0,0,,Loulan!
Dialogue: 0,0:05:20.93,0:05:23.28,Default,Loulan,0,0,0,,Witaj, Księżycowy Książę.
Dialogue: 0,0:05:23.77,0:05:27.89,Default,Loulan,0,0,0,,Nie. Dla wygody będę cię\Nnazywała panem Jinshim.
Dialogue: 0,0:05:29.16,0:05:31.90,Default,Loulan,0,0,0,,Czy mógłbyś pójść za mną?
Dialogue: 0,0:05:31.90,0:05:33.39,Default,Jinshi,0,0,0,,A jak odmówię?
Dialogue: 0,0:05:33.66,0:05:36.32,Default,Loulan,0,0,0,,To ja tu mam broń.
Dialogue: 0,0:05:38.18,0:05:40.98,Default,Loulan,0,0,0,,Naprawdę będziesz\Nposłusznym pieskiem?
Dialogue: 0,0:05:41.59,0:05:44.28,Default,Jinshi,0,0,0,,Sama tego ode mnie chciałaś.
Dialogue: 0,0:05:44.74,0:05:49.39,Default,Loulan,0,0,0,,Z łatwością mógłbyś mi ją odebrać.
Dialogue: 0,0:05:53.31,0:05:54.29,Default,Loulan,0,0,0,,Jesteśmy.
Dialogue: 0,0:05:56.50,0:06:00.29,Default,Loulan,0,0,0,,Siostrzyczko Suirei,\Nprzestała cię w końcu gnębić?
Dialogue: 0,0:06:01.33,0:06:02.84,Default,Jinshi,0,0,0,,{\i1}A więc to jest Suirei.
Dialogue: 0,0:06:03.55,0:06:07.13,Default,Jinshi,0,0,0,,{\i1}Uwiodła medyka\Ni upozorowała własną śmierć,
Dialogue: 0,0:06:07.63,0:06:10.33,Default,Jinshi,0,0,0,,{\i1}by wrócić pod przykrywką eunucha.
Dialogue: 0,0:06:11.53,0:06:13.90,Default,Jinshi,0,0,0,,{\i1}Myślałem, że jest odważną,\Nśmiałą kobietą, ale...
Dialogue: 0,0:06:14.98,0:06:17.60,Default,Shenmei,0,0,0,,Loulan, ten człowiek... Czy to...
Dialogue: 0,0:06:17.60,0:06:21.61,Default,Loulan,0,0,0,,Prosiłam go, by przyszedł tu\Nze mną i spełnił twoje życzenie.
Dialogue: 0,0:06:23.34,0:06:27.93,Default,Loulan,0,0,0,,Zawsze go nienawidziłaś, prawda?\NOsoby wyglądającej jak on.
Dialogue: 0,0:06:28.57,0:06:32.03,Default,Loulan,0,0,0,,A może byłaś zazdrosna o to,\Nże był piękniejszy od ciebie?
Dialogue: 0,0:06:32.58,0:06:37.08,Default,Loulan,0,0,0,,A może dlatego, że wybrał\Ndwórkę dużo młodszą od ciebie?
Dialogue: 0,0:06:37.93,0:06:41.55,Default,Loulan,0,0,0,,Chociaż nigdy nie odwiedził ciebie,\Nkonkubiny wysokiej rangi,
Dialogue: 0,0:06:41.55,0:06:42.96,Default,Shenmei,0,0,0,,Loulan!
Dialogue: 0,0:06:43.38,0:06:45.71,Default,Loulan,0,0,0,,Chyba wystarczy tych czułości.
Dialogue: 0,0:06:46.44,0:06:52.34,Default,Loulan,0,0,0,,Zanim jednak spełnimy twoje\Nżyczenie, trochę się zabawny.
Dialogue: 0,0:06:54.83,0:06:57.89,Default,Loulan,0,0,0,,Historia ta zaczęła się\Nponad 30 lat temu.
Dialogue: 0,0:06:57.89,0:07:01.77,Default,Loulan,0,0,0,,Ostatni cesarz był błaznem, który nie\Numiał przeciwstawić się własnej matce.
Dialogue: 0,0:07:02.26,0:07:06.29,Default,Loulan,0,0,0,,Dlatego to ona dzierżyła prawdziwą władzę,
Dialogue: 0,0:07:06.29,0:07:08.78,Default,Loulan,0,0,0,,a za jej plecami ludzie\Nnazywali ją „Cesarzową”.
Dialogue: 0,0:07:09.55,0:07:13.78,Default,Loulan,0,0,0,,Zaczęła niecierpliwić się,\Nże jej syn nie interesuje się kobietami.
Dialogue: 0,0:07:14.18,0:07:17.00,Default,Loulan,0,0,0,,Do wewnętrznego pałacu wysłała\Nkażdą piękność, jaką udało jej się znaleźć.
Dialogue: 0,0:07:18.49,0:07:19.96,Default,Loulan,0,0,0,,Aż pewnego dnia...
Dialogue: 0,0:07:20.74,0:07:21.65,Default,Young Shishou,0,0,0,,{\i1}Shenmei!
Dialogue: 0,0:07:22.46,0:07:25.96,Default,Young Shishou,0,0,0,,{\i1}Idziesz do wewnętrznego pałacu?\NTo prawda?
Dialogue: 0,0:07:25.96,0:07:29.05,Default,Young Shenmei,0,0,0,,{\i1}Tak! Błagali mnie, bym została\Nkonkubiną wysokiej rangi.
Dialogue: 0,0:07:29.38,0:07:32.05,Default,Young Shishou,0,0,0,,{\i1}Ale my... Zamierzaliśmy się...
Dialogue: 0,0:07:32.32,0:07:34.28,Default,Young Shenmei,0,0,0,,{\i1}To już nieważne.
Dialogue: 0,0:07:34.28,0:07:35.13,Default,Young Shishou,0,0,0,,{\i1}Ale...
Dialogue: 0,0:07:35.13,0:07:37.97,Default,Young Shenmei,0,0,0,,{\i1}Nie rozumiesz?\NTo wspaniała okazja.
Dialogue: 0,0:07:38.91,0:07:42.54,Default,Young Shenmei,0,0,0,,{\i1}Jeśli udałoby mi się zajść w ciążę,\Nmogłabym nawet zostać cesarzową!
Dialogue: 0,0:07:43.33,0:07:47.57,Default,Young Shenmei,0,0,0,,{\i1}Nie chcę tkwić jako żona lokalnego\Nszlachcica na północnych rubieżach.
Dialogue: 0,0:07:48.82,0:07:49.97,Default,Young Shishou,0,0,0,,{\i1}Shenmei...
Dialogue: 0,0:07:50.44,0:07:53.69,Default,Loulan,0,0,0,,poprosili cię, byś została\Nkonkubiną wysokiej rangi...
Dialogue: 0,0:07:53.69,0:07:56.58,Default,Loulan,0,0,0,,Ale to była tylko podpucha.
Dialogue: 0,0:07:56.88,0:08:00.27,Default,Shenmei,0,0,0,,Podpucha? O czym ty mówisz, Loulan?!
Dialogue: 0,0:08:00.27,0:08:02.37,Default,Shenmei,0,0,0,,Błagali mnie, bym została...
Dialogue: 0,0:08:03.53,0:08:06.64,Default,Loulan,0,0,0,,Pewnie tak ci się wydawało.
Dialogue: 0,0:08:06.64,0:08:11.74,Default,Loulan,0,0,0,,Gdy mój dziadek konał w swoim łóżku,\Nwydusił z siebie jedną rzecz niczym klątwę.
Dialogue: 0,0:08:12.14,0:08:15.38,Default,Loulan,0,0,0,,Że nie mógł nic zrobić,\Nskoro jego córka była zakładniczką.
Dialogue: 0,0:08:15.89,0:08:17.38,Default,Shenmei,0,0,0,,Zakładniczką?
Dialogue: 0,0:08:17.38,0:08:19.66,Default,Loulan,0,0,0,,Branie córki wysokiego\Nurzędnika jako zakładniczki
Dialogue: 0,0:08:19.66,0:08:22.31,Default,Loulan,0,0,0,,i nazywanie jej konkubiną\Njest dość popularne.
Dialogue: 0,0:08:24.58,0:08:28.40,Default,Loulan,0,0,0,,Ojciec już raz się\Nciebie wyrzekł, matko.
Dialogue: 0,0:08:28.70,0:08:31.90,Default,Loulan,0,0,0,,Ale stało się coś zupełnie\Nniespodziewanego:
Dialogue: 0,0:08:31.90,0:08:33.69,Default,Loulan,0,0,0,,upodobania zmarłego cesarza.
Dialogue: 0,0:08:34.11,0:08:39.10,Default,Loulan,0,0,0,,Panie Jinshi, czy wiesz, dlaczego\Nwewnętrzny pałac tak się rozrósł?
Dialogue: 0,0:08:39.10,0:08:42.54,Default,Jinshi,0,0,0,,Podobno Shishou przekonał\NCesarzową do jego rozbudowy.
Dialogue: 0,0:08:42.54,0:08:48.51,Default,Loulan,0,0,0,,Tak, zasugerował jego rozbudowę\Njako nowy element rozwoju publicznego.
Dialogue: 0,0:08:49.07,0:08:50.88,Default,Loulan,0,0,0,,By zastąpić handel niewolnikami.
Dialogue: 0,0:08:51.71,0:08:53.34,Default,Jinshi,0,0,0,,Handel... niewolnikami?
Dialogue: 0,0:08:54.59,0:08:58.41,Default,Loulan,0,0,0,,Kompletnie nic nie wiesz, matko.
Dialogue: 0,0:08:58.41,0:09:02.24,Default,Loulan,0,0,0,,O tym, co zrobił dziadek,\Nby przykuć uwagę Cesarzowej.
Dialogue: 0,0:09:02.24,0:09:05.06,Default,Jinshi,0,0,0,,Ale niewolnictwo\Nbyło wtedy legalne.
Dialogue: 0,0:09:05.91,0:09:09.15,Default,Loulan,0,0,0,,Słyszałam, że były traktowane\Npodobnie do kurtyzan z dzielnic uciech.
Dialogue: 0,0:09:09.15,0:09:13.71,Default,Loulan,0,0,0,,Jednakże nie dotyczyło to niewolników\Nsprzedawanych do innych krajów.
Dialogue: 0,0:09:14.36,0:09:18.75,Default,Loulan,0,0,0,,Właśnie dlatego Cesarzowa\Nzakazała handlu niewolnikami.
Dialogue: 0,0:09:18.75,0:09:21.76,Default,Loulan,0,0,0,,Klan Shi, którego córka była zakładniczką,
Dialogue: 0,0:09:21.76,0:09:25.61,Default,Loulan,0,0,0,,nie miał wyboru i ograniczył handel\Nniewolnikami, który był ich rodzinnym biznesem.
Dialogue: 0,0:09:26.31,0:09:31.75,Default,Loulan,0,0,0,,Kiedy dziadek stracił już wszystkie opcje,\Nzjawił się ojciec i zasugerował...
Dialogue: 0,0:09:32.41,0:09:36.80,Default,Young Shishou,0,0,0,,{\i1}Może wykorzystamy wewnętrzny pałac jako\Nmiejsce do zsyłania pozostałych niewolników?
Dialogue: 0,0:09:37.61,0:09:39.96,Default,Young Shishou,0,0,0,,{\i1}Młode kobiety mogłyby\Npracować jako służki i dwórki,
Dialogue: 0,0:09:40.37,0:09:42.72,Default,Young Shishou,0,0,0,,{\i1}a mężczyźni jako eunuchowie.
Dialogue: 0,0:09:43.26,0:09:46.01,Default,Young Shishou,0,0,0,,{\i1}Rozbudowę wewnętrznego pałacu\Nzaproponujemy Cesarzowej
Dialogue: 0,0:09:46.01,0:09:49.56,Default,Young Shishou,0,0,0,,{\i1}jako pretekst, by wzbudzić\Nzainteresowanie cesarza kobietami.
Dialogue: 0,0:09:49.88,0:09:52.57,Default,Clan Elder,0,0,0,,{\i1}Racja. Co więcej, rodziny,\Nktóre sprzedały swoje córki,
Dialogue: 0,0:09:52.57,0:09:57.66,Default,Clan Elder,0,0,0,,{\i1}nie czułyby się tak winne, jeśli ich córki trafią\Ndo wewnętrznego pałacu, a nie za granicę.
Dialogue: 0,0:09:57.66,0:09:58.28,Default,Young Shishou,0,0,0,,{\i1}Zgadza się.
Dialogue: 0,0:09:59.50,0:10:02.18,Default,Young Shishou,0,0,0,,{\i1}To korzyść dla każdego.
Dialogue: 0,0:10:02.65,0:10:06.18,Default,Loulan,0,0,0,,Ojciec próbował zdobyć\Nzaufanie Cesarzowej,
Dialogue: 0,0:10:06.18,0:10:11.71,Default,Loulan,0,0,0,,by przywrócić pozycję klanu Shi\Ni uwolnić zakładniczkę, ciebie.
Dialogue: 0,0:10:11.71,0:10:13.84,Default,Loulan,0,0,0,,Sprawiałaś kłopoty, matko.
Dialogue: 0,0:10:14.85,0:10:19.55,Default,Loulan,0,0,0,,A wszystko byłoby prostsze,\Ngdyby wtedy uciekł...
Dialogue: 0,0:10:25.14,0:10:27.73,Default,Adult Shenmei,0,0,0,,{\i1}Shishou?! Jak się tu dostałeś?!
Dialogue: 0,0:10:27.73,0:10:29.44,Default,Adult Shishou,0,0,0,,{\i1}Zbudowałem tajne przejście.
Dialogue: 0,0:10:29.96,0:10:33.08,Default,Adult Shishou,0,0,0,,{\i1}Ucieknijmy razem, Shenmei.
Dialogue: 0,0:10:33.08,0:10:33.82,Default,Adult Shenmei,0,0,0,,{\i1}Co...?
Dialogue: 0,0:10:34.39,0:10:37.32,Default,Adult Shishou,0,0,0,,{\i1}Jeśli tego pragniesz,\Nuciekniemy razem!
Dialogue: 0,0:10:37.63,0:10:40.61,Default,Adult Shenmei,0,0,0,,{\i1}Opuszczenie wewnętrznego\Npałacu to zbrodnia!
Dialogue: 0,0:10:40.61,0:10:43.20,Default,Adult Shishou,0,0,0,,{\i1}Zbudowanie tajnego przejścia tak samo.
Dialogue: 0,0:10:43.58,0:10:46.76,Default,Adult Shishou,0,0,0,,{\i1}Nie potrafiłem z ciebie zrezygnować!
Dialogue: 0,0:10:46.76,0:10:49.69,Default,Adult Shishou,0,0,0,,{\i1}Nie mogę pogodzić się z tym,\Nże nie jesteś moją żoną!
Dialogue: 0,0:10:49.69,0:10:51.58,Default,Adult Shishou,0,0,0,,{\i1}Nie potrafiłem się oprzeć,\Nby cię nie zobaczyć...
Dialogue: 0,0:10:53.82,0:10:55.74,Default,Adult Shenmei,0,0,0,,{\i1}Dobrze, jeśli dalej mnie...
Dialogue: 0,0:10:55.74,0:10:56.83,Default,Adult Shishou,0,0,0,,{\i1}Oczywiście!
Dialogue: 0,0:10:58.85,0:10:59.59,Default,Adult Shishou,0,0,0,,{\i1}No chodź.
Dialogue: 0,0:11:08.37,0:11:12.73,Default,Low-Rank Concubine A,0,0,0,,{\i1}To ta „wysokiej rangi” konkubina,\Nktóra przegrała ze swoją dwórką, Taihou?
Dialogue: 0,0:11:12.73,0:11:16.20,Default,Low-Rank Concubine B,0,0,0,,{\i1}A przecież była tu wcześniej\Nniż pani Anshi!
Dialogue: 0,0:11:16.20,0:11:19.40,Default,Low-Rank Concubine C,0,0,0,,{\i1}Podobno ani razu\Ncesarz jej nie odwiedził!
Dialogue: 0,0:11:20.45,0:11:21.82,Default,Adult Shenmei,0,0,0,,{\i1}Nie poniżaj mnie!
Dialogue: 0,0:11:21.82,0:11:25.03,Default,Adult Shenmei,0,0,0,,{\i1}Mam uciec, zażenowana i poniżona?!
Dialogue: 0,0:11:25.32,0:11:25.99,Default,Adult Shishou,0,0,0,,{\i1}Nie!
Dialogue: 0,0:11:26.30,0:11:26.99,Default,Adult Shenmei,0,0,0,,{\i1}Wynocha!
Dialogue: 0,0:11:29.67,0:11:35.29,Default,Loulan,0,0,0,,Nie potrafiłaś zaufać mężczyźnie,\Nktóry odrzuciłby własny status dla ciebie?
Dialogue: 0,0:11:35.71,0:11:39.30,Default,Shenmei,0,0,0,,Nie mogłam zaufać temu durniowi!
Dialogue: 0,0:11:39.30,0:11:41.87,Default,Shenmei,0,0,0,,Po chorobie ojca od razu\Npołożył łapę na rodzinie
Dialogue: 0,0:11:41.87,0:11:44.81,Default,Shenmei,0,0,0,,i pojął za żonę matkę tej dziewuchy!
Dialogue: 0,0:11:49.01,0:11:51.78,Default,Loulan,0,0,0,,Przepraszam, siostrzyczko.
Dialogue: 0,0:11:56.04,0:11:57.52,Default,Shenmei,0,0,0,,Co?! Czy to...
Dialogue: 0,0:11:57.81,0:11:59.98,Default,Shenmei,0,0,0,,Szpilka do włosów Feniksa?
Dialogue: 0,0:11:59.98,0:12:03.05,Default,Shenmei,0,0,0,,Tak, ty wiesz o tym, matko.
Dialogue: 0,0:12:03.45,0:12:07.41,Default,Shenmei,0,0,0,,Jedynymi, którym wolno je nosić, są ci,
Dialogue: 0,0:12:07.41,0:12:09.75,Default,Shenmei,0,0,0,,którzy mają w sobie cesarską krew.
Dialogue: 0,0:12:10.08,0:12:13.84,Default,Shenmei,0,0,0,,Bzdura! Cesarz nigdy\Nsię do tego nie przyznał!
Dialogue: 0,0:12:14.97,0:12:18.11,Default,Loulan,0,0,0,,Wygląda na to, że cały\Nczas czuł się winny.
Dialogue: 0,0:12:18.64,0:12:21.79,Default,Loulan,0,0,0,,Martwił się o dziecko, które\Nwyrzucił z wewnętrznego pałacu.
Dialogue: 0,0:12:22.19,0:12:25.84,Default,Loulan,0,0,0,,Od czasu do czasu\Nodwiedzał ją przy pomocy ojca.
Dialogue: 0,0:12:27.13,0:12:31.97,Default,Loulan,0,0,0,,Wprawdzie raz temu zaprzeczył,\Nale wiedział, że to jego córka.
Dialogue: 0,0:12:31.97,0:12:34.35,Default,Loulan,0,0,0,,Właśnie dlatego poprosił ojca,\Nktóry wtedy był wolny...
Dialogue: 0,0:12:35.08,0:12:38.44,Default,Late Emperor,0,0,0,,{\i1}Chcę, żebyś pojął\Nmoją córkę za żonę.
Dialogue: 0,0:12:39.00,0:12:41.81,Default,Loulan,0,0,0,,Ojciec pojął za żonę córkę
Dialogue: 0,0:12:41.81,0:12:45.20,Default,Loulan,0,0,0,,zrodzoną między cesarzem\Na twoją damą dworu.
Dialogue: 0,0:12:46.15,0:12:49.22,Default,Loulan,0,0,0,,A później przyszło\Nna świat ich dziecko.
Dialogue: 0,0:12:50.57,0:12:52.50,Default,Shishou,0,0,0,,{\i1}Nazwałem ją Shisui.
Dialogue: 0,0:12:52.50,0:12:57.02,Default,Late Emperor,0,0,0,,{\i1}Shisui... Świetne imię\Ndla członka klanu Shi.
Dialogue: 0,0:12:57.02,0:13:01.00,Default,Shishou,0,0,0,,{\i1}Wasza Wysokość, powiedziałeś\Nmi, że spełnisz moje życzenie.
Dialogue: 0,0:13:01.31,0:13:07.01,Default,Shishou,0,0,0,,{\i1}Czy mógłbym otrzymać w prezencie\NShenmei, konkubinę wysokiej rangi?
Dialogue: 0,0:13:07.01,0:13:11.61,Default,Loulan,0,0,0,,Kiedy jego wnuczka otrzymała imię\N„Shi”, zmarły cesarz odetchnął z ulgą.
Dialogue: 0,0:13:11.61,0:13:14.18,Default,Loulan,0,0,0,,Nie musiał już dłużej\Nwięzić zakładniczki.
Dialogue: 0,0:13:14.60,0:13:17.90,Default,Loulan,0,0,0,,W ten oto sposób\Nzostałaś ofiarowana ojcu.
Dialogue: 0,0:13:21.32,0:13:23.71,Default,Jinshi,0,0,0,,{\i1}Poprzedni cesarz był idiotą.
Dialogue: 0,0:13:24.19,0:13:26.05,Default,Jinshi,0,0,0,,{\i1}Nie miał pojęcia,
Dialogue: 0,0:13:26.05,0:13:30.83,Default,Jinshi,0,0,0,,{\i1}jak jego samolubne życzenia odbiją\Nsię na jego własnej córce i Shishou.
Dialogue: 0,0:13:31.23,0:13:33.62,Default,Shenmei,0,0,0,,To bujdy! Kłamstwa! Kłamiesz!
Dialogue: 0,0:13:33.62,0:13:35.04,Default,Shenmei,0,0,0,,Wszystko to jest kompletną bzdurą!
Dialogue: 0,0:13:35.46,0:13:37.18,Default,Loulan,0,0,0,,Bzdury, powiadasz?
Dialogue: 0,0:13:37.18,0:13:40.92,Default,Loulan,0,0,0,,Ojciec dla ciebie zrobił wszystko.
Dialogue: 0,0:13:40.92,0:13:44.22,Default,Loulan,0,0,0,,Chociaż wiedział, że wszystko\Ni tak skończy się katastrofą.
Dialogue: 0,0:13:48.10,0:13:51.39,Default,Loulan,0,0,0,,Nawet nie pojmujesz,\Ndlaczego pan Jinshi jest tu teraz?
Dialogue: 0,0:13:52.76,0:13:55.14,Default,Loulan,0,0,0,,Jak mój ojciec zakończył swój żywot?
Dialogue: 0,0:13:56.51,0:13:58.22,Default,Jinshi,0,0,0,,Umierał, śmiejąc się.
Dialogue: 0,0:13:59.30,0:14:02.54,Default,Shenmei,0,0,0,,Wszystko, czego on kiedykolwiek\Npragnął, to zdobyć władzę!
Dialogue: 0,0:14:02.54,0:14:04.00,Default,Shenmei,0,0,0,,Pojął mnie za żonę tylko po to,
Dialogue: 0,0:14:04.00,0:14:06.53,Default,Shenmei,0,0,0,,by afiszować się swoją\Npozycją lidera tego klanu!
Dialogue: 0,0:14:07.21,0:14:12.46,Default,Loulan,0,0,0,,Ale kiedy wszystko ucichło, to ty, matko,\Nprzejęłaś kontrolę nad naszym klanem.
Dialogue: 0,0:14:12.94,0:14:19.37,Default,Loulan,0,0,0,,Wiesz, co członkowie klanu, którzy\Nci się podlizują, robili w pałacu?
Dialogue: 0,0:14:19.68,0:14:22.59,Default,Jinshi,0,0,0,,Chodzi ci o defraudację?
Dialogue: 0,0:14:22.59,0:14:26.52,Default,Loulan,0,0,0,,Tak, brali udział\Nw wielu przestępstwach.
Dialogue: 0,0:14:26.52,0:14:31.18,Default,Loulan,0,0,0,,Ci rozsądni, którzy się temu sprzeciwiali,\Nzostali usunięci, zostali tylko zdeprawowani.
Dialogue: 0,0:14:31.71,0:14:34.99,Default,Loulan,0,0,0,,Ojciec wcielił się\Nw rolę zdrajcy, by zniszczyć
Dialogue: 0,0:14:34.99,0:14:38.94,Default,Loulan,0,0,0,,każdą parszywą część klanu\NShi w jednej katastrofie.
Dialogue: 0,0:14:39.59,0:14:43.70,Default,Loulan,0,0,0,,Panie Jinshi, ludzie nazywali\Nmojego ojca „cwanym jenotem”,
Dialogue: 0,0:14:43.70,0:14:46.94,Default,Loulan,0,0,0,,ale czy wiesz, że są one w rzeczywistości\Nbardzo płochliwymi stworzeniami?
Dialogue: 0,0:14:47.20,0:14:50.74,Default,Loulan,0,0,0,,Właśnie dlatego próbują oszukać\Ninnych, bo od tego zależy ich życie.
Dialogue: 0,0:14:51.33,0:14:54.75,Default,Jinshi,0,0,0,,{\i1}Jeżeli jej słowa są prawdziwe,\Nto trzeba rozdzielić te dwie kwestie...
Dialogue: 0,0:14:54.75,0:14:57.38,Default,Jinshi,0,0,0,,{\i1}Rozbudowę wewnętrznego\Npałacu i defraudację.
Dialogue: 0,0:14:57.94,0:15:00.22,Default,Jinshi,0,0,0,,{\i1}Shishou odegrał rolę złego,
Dialogue: 0,0:15:00.22,0:15:02.74,Default,Jinshi,0,0,0,,{\i1}by zebrać całą zarazę kraju\Nw jednym miejscu.
Dialogue: 0,0:15:03.49,0:15:04.75,Default,Jinshi,0,0,0,,{\i1}Ale za to nie dostanie żadnej nagrody.
Dialogue: 0,0:15:05.06,0:15:09.13,Default,Loulan,0,0,0,,Czy ojciec należycie wywiązał\Nsię ze swojej roli złoczyńcy?
Dialogue: 0,0:15:10.46,0:15:13.35,Default,Jinshi,0,0,0,,Czy masz dowód na to,\Nże to wszystko prawda?
Dialogue: 0,0:15:13.35,0:15:17.96,Default,Loulan,0,0,0,,Cała zgnilizna w pałacu\Npowinna być już usunięta.
Dialogue: 0,0:15:17.96,0:15:20.37,Default,Jinshi,0,0,0,,Byłaś pewna,\Nże to wszystko się uda?
Dialogue: 0,0:15:20.37,0:15:24.43,Default,Loulan,0,0,0,,Inaczej moglibyśmy po prostu\Nprzejąć władzę w kraju.
Dialogue: 0,0:15:24.43,0:15:27.57,Default,Loulan,0,0,0,,Jeżeli kraj jest tak słaby,\Nto nie zasługuje na istnienie.
Dialogue: 0,0:15:27.57,0:15:31.53,Default,Shenmei,0,0,0,,Oboje mnie oszukiwaliście\Nprzez cały ten czas?!
Dialogue: 0,0:15:31.53,0:15:35.44,Default,Loulan,0,0,0,,Zrobiłam tylko to,\Nco kazałaś, matko.
Dialogue: 0,0:15:35.44,0:15:39.53,Default,Loulan,0,0,0,,Sama to powiedziałaś:\N„Ten kraj zasługuje na zagładę”.
Dialogue: 0,0:15:41.43,0:15:44.14,Default,Loulan,0,0,0,,Otaczasz się wygadanymi idiotami.
Dialogue: 0,0:15:44.14,0:15:48.21,Default,Loulan,0,0,0,,Serio myślałaś, że uda ci się pokonać\Ngwardię królewską w ten sposób?
Dialogue: 0,0:15:48.21,0:15:49.71,Default,Shenmei,0,0,0,,Loulan!
Dialogue: 0,0:15:53.22,0:15:56.47,Default,Shenmei,0,0,0,,Właśnie po to kazałam je zrobić!
Dialogue: 0,0:15:56.47,0:15:59.93,Default,Loulan,0,0,0,,Nie dasz rady. Oddaj to, proszę.
Dialogue: 0,0:16:00.24,0:16:01.69,Default,Shenmei,0,0,0,,Zamknij się!
Dialogue: 0,0:16:02.89,0:16:04.10,Default,Shenmei,0,0,0,,Co cię tak śmieszy?!
Dialogue: 0,0:16:04.52,0:16:06.35,Default,Loulan,0,0,0,,Ojejku, matko.
Dialogue: 0,0:16:06.83,0:16:09.07,Default,Loulan,0,0,0,,Jesteś taka małostkowa.
Dialogue: 0,0:16:09.36,0:16:10.90,Default,Shenmei,0,0,0,,Loulan!
Dialogue: 0,0:16:15.00,0:16:16.03,Default,Basen,0,0,0,,Wystrzał?!
Dialogue: 0,0:16:16.47,0:16:17.67,Default,Soldier A,0,0,0,,Panie Basen!
Dialogue: 0,0:16:23.27,0:16:25.79,Default,Loulan,0,0,0,,Ale ze mnie zła córka.
Dialogue: 0,0:16:26.25,0:16:30.55,Default,Loulan,0,0,0,,Jeśli byłabym wierna zamiarom mojego ojca,\Nnigdy bym tego nie zrobiła.
Dialogue: 0,0:16:30.90,0:16:33.08,Default,Jinshi,0,0,0,,Zablokowałaś to, by nie zadziałało?
Dialogue: 0,0:16:33.77,0:16:36.44,Default,Loulan,0,0,0,,Nowy model ma złożoną konstrukcję.
Dialogue: 0,0:16:37.01,0:16:41.18,Default,Loulan,0,0,0,,Nie myślałeś o tym,\Nżeby mi go odebrać?
Dialogue: 0,0:16:41.18,0:16:43.80,Default,Loulan,0,0,0,,Z właściwym wyczuciem czasu\Nbyłaby to dla ciebie łatwizna.
Dialogue: 0,0:16:44.27,0:16:46.10,Default,Jinshi,0,0,0,,Chciałaś mi coś powiedzieć.
Dialogue: 0,0:16:47.87,0:16:50.86,Default,Loulan,0,0,0,,Gdybyś tylko był głupkiem z ładną buzią.
Dialogue: 0,0:16:56.62,0:17:00.33,Default,Loulan,0,0,0,,Matko, ojciec nie żyje.
Dialogue: 0,0:17:00.33,0:17:02.79,Default,Loulan,0,0,0,,Nie uronisz nawet jednej łzy?
Dialogue: 0,0:17:03.45,0:17:06.41,Default,Loulan,0,0,0,,Przez całe życie czekał na ciebie.
Dialogue: 0,0:17:07.13,0:17:11.19,Default,Loulan,0,0,0,,Jakbyś tylko uroniła choć jedną łzę,\Nnie musiałabym tego robić...
Dialogue: 0,0:17:13.48,0:17:15.91,Default,Jinshi,0,0,0,,Nie było innego sposobu?
Dialogue: 0,0:17:17.02,0:17:22.07,Default,Loulan,0,0,0,,Możliwe, ale zwyczajnie\Nnie jesteśmy aż tak mądrzy.
Dialogue: 0,0:17:22.60,0:17:27.49,Default,Jinshi,0,0,0,,{\i1}Shenmei chciała zrównać\Nz ziemią kraj, który z niej kpił.
Dialogue: 0,0:17:27.49,0:17:31.05,Default,Jinshi,0,0,0,,{\i1}Shishou zrobiłby wszystko dla Shenmei,
Dialogue: 0,0:17:31.05,0:17:34.27,Default,Jinshi,0,0,0,,{\i1}ale zarazem był lojalnym sługą,\Nktóry nie potrafiłby porzucić kraju.
Dialogue: 0,0:17:34.75,0:17:35.89,Default,Loulan,0,0,0,,Panie Jinshi.
Dialogue: 0,0:17:36.77,0:17:41.66,Default,Loulan,0,0,0,,Wiem, że to zbyt wiele,\Nale mam do ciebie dwie prośby.
Dialogue: 0,0:17:42.98,0:17:43.91,Default,Jinshi,0,0,0,,Jakie?
Dialogue: 0,0:17:44.32,0:17:46.00,Default,Loulan,0,0,0,,Dziękuję.
Dialogue: 0,0:17:48.93,0:17:50.80,Default,Loulan,0,0,0,,Po pierwsze, weź to.
Dialogue: 0,0:17:55.39,0:17:59.28,Default,Loulan,0,0,0,,Chciałam użyć tego jako\Nkarty przetargowej, by błagać o życie,
Dialogue: 0,0:17:59.28,0:18:01.26,Default,Loulan,0,0,0,,ale chyba nie wyszło.
Dialogue: 0,0:18:01.90,0:18:06.32,Default,Loulan,0,0,0,,Są rzeczy, które mogą\Nod teraz zdarzyć się w tym kraju.
Dialogue: 0,0:18:08.22,0:18:10.00,Default,Loulan,0,0,0,,Moim pierwszym życzeniem jest to:
Dialogue: 0,0:18:10.39,0:18:12.77,Default,Loulan,0,0,0,,Członkowie klanu myślący racjonalnie,
Dialogue: 0,0:18:12.77,0:18:15.15,Default,Loulan,0,0,0,,zostali usunięci przez moją\Nmatkę i stracili swoje imiona.
Dialogue: 0,0:18:15.65,0:18:17.86,Default,Loulan,0,0,0,,Podobnie wygląda\Nsytuacja mojej siostry.
Dialogue: 0,0:18:18.49,0:18:24.26,Default,Loulan,0,0,0,,Skoro już raz polegli,\Nczy mógłbyś ich oszczędzić?
Dialogue: 0,0:18:24.26,0:18:25.55,Default,Jinshi,0,0,0,,Zrobię, co będę mógł.
Dialogue: 0,0:18:25.55,0:18:29.90,Default,Loulan,0,0,0,,Zatem pozwolisz odejść tym,\Nktórzy już raz polegli.
Dialogue: 0,0:18:30.44,0:18:32.21,Default,Loulan,0,0,0,,Dziękuję.
Dialogue: 0,0:18:32.21,0:18:33.44,Default,Jinshi,0,0,0,,A druga?
Dialogue: 0,0:18:44.20,0:18:46.47,Default,Loulan,0,0,0,,Moją drugą prośbą...
Dialogue: 0,0:19:02.54,0:19:04.24,Default,Loulan,0,0,0,,Dziękuję.
Dialogue: 0,0:19:04.76,0:19:09.54,Default,Loulan,0,0,0,,Matko, to najlepsze, co mogę zrobić.
Dialogue: 0,0:19:20.39,0:19:23.68,Default,Loulan,0,0,0,,Ciekawe, czy będę lepszą\Naktorką niż mój ojciec.
Dialogue: 0,0:20:59.57,0:21:01.68,Default,Jinshi,0,0,0,,{\i1}Powinienem był ją powstrzymać?
Dialogue: 0,0:21:02.22,0:21:04.71,Default,Jinshi,0,0,0,,{\i1}Nie, nie mógłbym.
Dialogue: 0,0:21:05.25,0:21:08.66,Default,Jinshi,0,0,0,,{\i1}Finałowy występ zła\Njedynego w swoim rodzaju...
Dialogue: 0,0:21:09.58,0:21:11.08,Default,Jinshi,0,0,0,,{\i1}Nie byłem w stanie tego zrobić.
Dialogue: 0,0:21:12.17,0:21:15.18,Default,Jinshi,0,0,0,,{\i1}Nie mogłem też odwrócić od niej wzroku.
Dialogue: 0,0:21:54.11,0:21:57.87,Default,Jinshi,0,0,0,,{\i1}To był ostatni raz,\Nkiedy widziałem Loulan.
Dialogue: 0,0:22:06.83,0:22:08.59,Default,Jinshi,0,0,0,,{\i1}Moje ciało jest takie ociężałe.
Dialogue: 0,0:22:08.59,0:22:12.11,Default,Jinshi,0,0,0,,{\i1}Przez ostatnie kilka dni w ogóle nie spałem.
Dialogue: 0,0:22:12.75,0:22:14.14,Default,Jinshi,0,0,0,,Co z dziewczyną?
Dialogue: 0,0:22:14.14,0:22:15.40,Default,Gaoshun,0,0,0,,Jest bezpieczna.
Dialogue: 0,0:22:15.40,0:22:17.85,Default,Gaoshun,0,0,0,,Musisz trochę odpocząć...
Dialogue: 0,0:22:18.35,0:22:19.56,Default,Jinshi,0,0,0,,Gdzie jest?
Dialogue: 0,0:22:21.25,0:22:23.04,Default,Gaoshun,0,0,0,,Nie powinieneś zbytnio się zbliżać...
Dialogue: 0,0:22:29.16,0:22:32.26,Default,Gaoshun,0,0,0,,To martwe dzieci klanu Shi.
Dialogue: 0,0:22:32.26,0:22:35.05,Default,Jinshi,0,0,0,,Dlaczego ona tu śpi?
Dialogue: 0,0:22:35.05,0:22:38.54,Default,Gaoshun,0,0,0,,Błagała mnie, bym jej pozwolił.\NNie umiałem odmówić.
Dialogue: 0,0:22:39.58,0:22:42.54,Default,Jinshi,0,0,0,,Wariatka z niej.
Dialogue: 0,0:22:42.99,0:22:44.70,Default,Gaoshun,0,0,0,,Podobnie jak pan.
Dialogue: 0,0:22:46.92,0:22:51.55,Default,Jinshi,0,0,0,,{\i1}Wiedziałem, że rozcięcie na mojej twarzy\Ndoprowadzi do ukarania podwładnego.
Dialogue: 0,0:22:52.20,0:22:56.06,Default,Jinshi,0,0,0,,{\i1}Ale i tak zgodziłem się\Nz prośbą Loulan.
Dialogue: 0,0:22:56.38,0:22:57.67,Default,Jinshi,0,0,0,,Mną się nie przejmuj.
Dialogue: 0,0:22:58.11,0:23:01.99,Default,Jinshi,0,0,0,,Powinniśmy się cieszyć,\Nże nie ma tu stratega, prawda?
Dialogue: 0,0:23:02.42,0:23:04.69,Default,Gaoshun,0,0,0,,Tak, zdecydowanie.
Dialogue: 0,0:23:05.30,0:23:06.50,Default,Jinshi,0,0,0,,Poczekaj na zewnątrz.
Dialogue: 0,0:23:14.09,0:23:17.28,Default,Jinshi,0,0,0,,Gdyby mnie tu nie było,\Nnie wpadłaby w takie tarapaty...
Dialogue: 0,0:23:26.99,0:23:31.34,Default,Maomao,0,0,0,,Gdzie z tą łapą, panie Jinshi?
Dialogue: 0,0:23:43.02,0:23:44.11,Default,Guard,0,0,0,,Czy to...
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku: „Początek”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
Dialogue: 0,0:23:58.70,0:24:00.00,Default,Text,0,0,0,,{\an8}MAOMAO, SHISUI
