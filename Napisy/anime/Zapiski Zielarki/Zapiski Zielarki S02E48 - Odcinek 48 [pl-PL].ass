Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:39.20,0:01:43.16,Default,Text,0,0,0,,{\an8}ODCINEK 48: POCZĄTEK
Dialogue: 0,0:01:49.70,0:01:53.42,Default,Maomao,0,0,0,,Gdzie z tą łapą, panie Jinshi?
Dialogue: 0,0:01:53.42,0:01:55.76,Default,Jinshi,0,0,0,,N-nie! Ja tylko...
Dialogue: 0,0:01:59.72,0:02:02.31,Default,Maomao,0,0,0,,Panie Jinshi, co ci się stało...
Dialogue: 0,0:02:03.46,0:02:06.00,Default,Jinshi,0,0,0,,Nic takiego. Zwykłe zadrapanie.
Dialogue: 0,0:02:08.31,0:02:09.87,Default,Maomao,0,0,0,,Pokaż mi to.
Dialogue: 0,0:02:16.73,0:02:18.20,Default,Maomao,0,0,0,,Wybacz.
Dialogue: 0,0:02:24.45,0:02:26.60,Default,Maomao,0,0,0,,Szwy zrobione byle jak.
Dialogue: 0,0:02:27.20,0:02:30.96,Default,Maomao,0,0,0,,{\i1}Chętnie bym je poprawiła,\Nale ręce drżą mi ze zmęczenia...
Dialogue: 0,0:02:33.08,0:02:34.63,Default,Maomao,0,0,0,,Byłeś na froncie?
Dialogue: 0,0:02:35.08,0:02:38.39,Default,Jinshi,0,0,0,,Nie mogę siedzieć bezczynnie\Nz założonymi rękami i czekać.
Dialogue: 0,0:02:38.39,0:02:42.05,Default,Maomao,0,0,0,,Możesz i powinieneś.\NW końcu taką masz rolę.
Dialogue: 0,0:02:42.41,0:02:45.33,Default,Maomao,0,0,0,,Nie narażaj się świadomie\Nna niebezpieczeństwo.
Dialogue: 0,0:02:45.33,0:02:48.64,Default,Maomao,0,0,0,,Kiedy zostajesz ranny,\Nto inni ludzie wpadają w tarapaty.
Dialogue: 0,0:02:50.04,0:02:51.10,Default,Jinshi,0,0,0,,Masz rację.
Dialogue: 0,0:02:51.98,0:02:54.51,Default,Jinshi,0,0,0,,Nie miałem tego w planach.
Dialogue: 0,0:02:57.37,0:02:59.24,Default,Maomao,0,0,0,,Nikt nigdy nie ma!
Dialogue: 0,0:03:04.69,0:03:07.33,Default,Jinshi,0,0,0,,Spełniłem dziwaczne żądanie.
Dialogue: 0,0:03:10.49,0:03:13.80,Default,Jinshi,0,0,0,,Byłyście z Loulan blisko?
Dialogue: 0,0:03:17.34,0:03:18.96,Default,Jinshi,0,0,0,,Byłyście przyjaciółkami?
Dialogue: 0,0:03:20.67,0:03:23.92,Default,Maomao,0,0,0,,Sama... już nie wiem.
Dialogue: 0,0:03:25.10,0:03:26.22,Default,Maomao,0,0,0,,{\i1}Przyjaciółki...
Dialogue: 0,0:03:27.09,0:03:32.48,Default,Maomao,0,0,0,,{\i1}Z mojego punktu widzenia myślę,\Nże to w sumie prawda.
Dialogue: 0,0:03:32.98,0:03:35.73,Default,Maomao,0,0,0,,{\i1}Loulan... Shisui i Xiaolan.
Dialogue: 0,0:03:36.83,0:03:40.42,Default,Maomao,0,0,0,,{\i1}Wspólne spędzanie czasu\Nwcale nie było złe.
Dialogue: 0,0:03:42.31,0:03:45.84,Default,Maomao,0,0,0,,{\i1}Ale nie wiem, co czuła Shisui.
Dialogue: 0,0:03:47.91,0:03:51.96,Default,Maomao,0,0,0,,Tak naprawdę nigdy\Njej nie rozgryzłam.
Dialogue: 0,0:03:53.99,0:03:55.46,Default,Jinshi,0,0,0,,Mam tak samo.
Dialogue: 0,0:04:00.38,0:04:02.84,Default,Jinshi,0,0,0,,Wszystko skończyło się,\Nnim zrozumiałem, o co chodzi.
Dialogue: 0,0:04:03.77,0:04:05.22,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:04:06.03,0:04:08.85,Default,Maomao,0,0,0,,{\i1}Więc Shisui...
Dialogue: 0,0:04:10.35,0:04:11.94,Default,Shisui,0,0,0,,{\i1}Resztę zostawiam tobie.
Dialogue: 0,0:04:13.81,0:04:18.91,Default,Maomao,0,0,0,,{\i1}Wszystko, co mogę zrobić,\Nto dokończyć to, co powierzyła mi Shisui.
Dialogue: 0,0:04:19.79,0:04:21.02,Default,Maomao,0,0,0,,{\i1}I tyle.
Dialogue: 0,0:04:25.47,0:04:26.62,Default,Maomao,0,0,0,,Zrobione.
Dialogue: 0,0:04:27.58,0:04:28.74,Default,Jinshi,0,0,0,,Dziękuję.
Dialogue: 0,0:04:29.02,0:04:32.22,Default,Maomao,0,0,0,,Kiepsko wyglądasz.\NMoże idź odpocząć?
Dialogue: 0,0:04:32.22,0:04:34.34,Default,Jinshi,0,0,0,,Ta, padam z nóg.
Dialogue: 0,0:04:34.34,0:04:36.77,Default,Maomao,0,0,0,,Idź spać gdzie indziej!
Dialogue: 0,0:04:36.77,0:04:38.85,Default,Jinshi,0,0,0,,Czemu nie? Nie mam siły.
Dialogue: 0,0:04:38.85,0:04:40.68,Default,Maomao,0,0,0,,Mam na myśli...
Dialogue: 0,0:04:41.14,0:04:43.17,Default,Maomao,0,0,0,,Jest tu strasznie brudno.
Dialogue: 0,0:04:43.17,0:04:44.26,Default,Jinshi,0,0,0,,Widzę.
Dialogue: 0,0:04:45.38,0:04:46.72,Default,Jinshi,0,0,0,,Więc...
Dialogue: 0,0:04:54.53,0:04:58.18,Default,Maomao,0,0,0,,{\i1}Dłonie pana Jinshiego są zimne.
Dialogue: 0,0:04:58.73,0:05:01.48,Default,Jinshi,0,0,0,,Więc co tu robisz?
Dialogue: 0,0:05:02.43,0:05:05.28,Default,Maomao,0,0,0,,Szkoda mi jest dzieci.
Dialogue: 0,0:05:05.28,0:05:06.52,Default,Jinshi,0,0,0,,Czyżby?
Dialogue: 0,0:05:06.52,0:05:11.22,Default,Jinshi,0,0,0,,Twój opiekun chyba zabronił\Nci macania trupów, co?
Dialogue: 0,0:05:11.22,0:05:14.00,Default,Maomao,0,0,0,,{\i1}Rany. Pamięta.
Dialogue: 0,0:05:14.00,0:05:18.84,Default,Jinshi,0,0,0,,Ciekawi mnie, czemu zostałaś\Ntu tak długo mimo tego zakazu.
Dialogue: 0,0:05:18.84,0:05:20.96,Default,Maomao,0,0,0,,{\i1}Czasami jest strasznie bystry.
Dialogue: 0,0:05:23.43,0:05:25.91,Default,Maomao,0,0,0,,{\i1}Jakiej wymówki użyć?
Dialogue: 0,0:05:28.03,0:05:29.68,Default,Jinshi,0,0,0,,Skąd masz tę ranę?
Dialogue: 0,0:05:29.68,0:05:32.03,Default,Maomao,0,0,0,,Wpadłam na niewłaściwą osobę.
Dialogue: 0,0:05:32.91,0:05:34.19,Default,Jinshi,0,0,0,,Napadnięto cię?
Dialogue: 0,0:05:34.19,0:05:35.92,Default,Maomao,0,0,0,,To była kobieta.
Dialogue: 0,0:05:35.92,0:05:40.79,Default,Maomao,0,0,0,,{\i1}Czemu on cały czas się o mnie martwi?
Dialogue: 0,0:05:42.01,0:05:43.98,Default,Jinshi,0,0,0,,Oby tylko nie została po tym blizna.
Dialogue: 0,0:05:44.57,0:05:46.57,Default,Maomao,0,0,0,,Szybko zniknie.
Dialogue: 0,0:05:47.19,0:05:48.74,Default,Jinshi,0,0,0,,Dopilnuj, aby nie pozostała blizna.
Dialogue: 0,0:05:49.27,0:05:52.95,Default,Maomao,0,0,0,,Mogę chyba powiedzieć to samo.
Dialogue: 0,0:05:54.60,0:05:56.66,Default,Jinshi,0,0,0,,Jestem facetem. To żaden problem.
Dialogue: 0,0:05:57.03,0:05:59.94,Default,Maomao,0,0,0,,Jesteś kimś więcej.
Dialogue: 0,0:05:59.94,0:06:01.60,Default,Jinshi,0,0,0,,Nie obchodzi mnie to.
Dialogue: 0,0:06:01.60,0:06:03.66,Default,Maomao,0,0,0,,Więc mnie też.
Dialogue: 0,0:06:03.66,0:06:07.78,Default,Maomao,0,0,0,,Nie ma znaczenia, czy zwykła\Nblizna zniszczy mój urok.
Dialogue: 0,0:06:13.18,0:06:14.10,Default,Jinshi,0,0,0,,Ej.
Dialogue: 0,0:06:14.93,0:06:16.10,Default,Jinshi,0,0,0,,Czy ja...
Dialogue: 0,0:06:16.89,0:06:19.94,Default,Jinshi,0,0,0,,jestem kimś, kto z powodu blizny\Nmógłby stracić swoją wartość?
Dialogue: 0,0:06:20.99,0:06:22.74,Default,Jinshi,0,0,0,,Urocza buzia to jedyna\Nwartość, jaką posiadam?
Dialogue: 0,0:06:27.95,0:06:32.58,Default,Maomao,0,0,0,,Prawdę mówiąc, więcej blizn\Nby ci nie zaszkodziło.
Dialogue: 0,0:06:34.04,0:06:36.51,Default,Maomao,0,0,0,,{\i1}Pan Jinshi jest zbyt piękny.
Dialogue: 0,0:06:36.51,0:06:39.10,Default,Maomao,0,0,0,,{\i1}Ludzie wokół niego\Ndostają palpitacji serca,
Dialogue: 0,0:06:39.10,0:06:41.42,Default,Maomao,0,0,0,,{\i1}przez co skupiają się\Ntylko na jego pięknu.
Dialogue: 0,0:06:41.88,0:06:46.18,Default,Maomao,0,0,0,,{\i1}Jednak jego prawdziwa natura\Nnie jest tak fikuśna, jak jego wygląd.
Dialogue: 0,0:06:46.18,0:06:47.91,Default,Maomao,0,0,0,,{\i1}Jest zdecydowanie silniejszy i konkretny.
Dialogue: 0,0:06:48.39,0:06:52.68,Default,Maomao,0,0,0,,{\i1}To chyba jest o wiele\Ncenniejsze niż jego wygląd.
Dialogue: 0,0:06:54.34,0:06:57.18,Default,Maomao,0,0,0,,Trochę zmężniałeś.
Dialogue: 0,0:07:08.17,0:07:09.80,Default,Maomao,0,0,0,,Co się stało?
Dialogue: 0,0:07:09.80,0:07:13.07,Default,Jinshi,0,0,0,,Z uwagi na sytuację,\Nchciałem się powstrzymać.
Dialogue: 0,0:07:13.93,0:07:17.20,Default,Maomao,0,0,0,,No cóż, skoro chcesz\Nspać, możesz iść i...
Dialogue: 0,0:07:17.99,0:07:18.78,Default,Maomao,0,0,0,,{\i1}Co?!
Dialogue: 0,0:07:19.46,0:07:22.18,Default,Jinshi,0,0,0,,Myślałem, że potrafię się opanować.
Dialogue: 0,0:07:22.74,0:07:23.42,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:07:23.42,0:07:27.13,Default,Jinshi,0,0,0,,Chyba poradziłem\Nsobie lepiej, niż myślałem.
Dialogue: 0,0:07:27.59,0:07:30.33,Default,Maomao,0,0,0,,{\i1}Czekaj, ta sytuacja...
Dialogue: 0,0:07:31.20,0:07:35.06,Default,Maomao,0,0,0,,Panie Jinshi, chyba\Npowinieneś iść spać, co?
Dialogue: 0,0:07:35.06,0:07:36.47,Default,Jinshi,0,0,0,,Wszystko gra.
Dialogue: 0,0:07:36.82,0:07:38.24,Default,Maomao,0,0,0,,Może jakieś środki przeciwbólowe?
Dialogue: 0,0:07:38.24,0:07:40.64,Default,Jinshi,0,0,0,,Wytrzymam jeszcze jakieś pół godziny.
Dialogue: 0,0:07:40.64,0:07:42.64,Default,Maomao,0,0,0,,Pół godziny na co dokładnie?
Dialogue: 0,0:07:43.73,0:07:46.11,Default,Maomao,0,0,0,,{\i1}O czym on bredzi, jak ledwo\Ntrzyma się na nogach?!
Dialogue: 0,0:07:47.62,0:07:50.68,Default,Maomao,0,0,0,,{\i1}Nie... Jest źle!
Dialogue: 0,0:07:54.02,0:07:55.32,Default,Jinshi,0,0,0,,Co to za odgłos?
Dialogue: 0,0:07:59.17,0:07:59.91,Default,Jinshi,0,0,0,,Ej!
Dialogue: 0,0:08:02.95,0:08:04.02,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:08:07.98,0:08:08.88,Default,Maomao,0,0,0,,Nie...
Dialogue: 0,0:08:21.03,0:08:22.06,Default,Shisui,0,0,0,,{\i1}To było lekarstwo.
Dialogue: 0,0:08:22.77,0:08:26.00,Default,Maomao,0,0,0,,{\i1}Shisui mówiła, że to\Nlekarstwo, a nie trucizna.
Dialogue: 0,0:08:26.00,0:08:30.12,Default,Maomao,0,0,0,,{\i1}Lekarstwo, które zabija człowieka,\Nby później przywrócić go do życia...
Dialogue: 0,0:08:30.12,0:08:31.94,Default,Maomao,0,0,0,,{\i1}Zioło życia...
Dialogue: 0,0:08:42.42,0:08:43.41,Default,Jinshi,0,0,0,,Ona żyje?
Dialogue: 0,0:08:43.83,0:08:47.24,Default,Maomao,0,0,0,,Panie Jinshi! Ciepła woda!\NPrzynieś trochę ciepłej wody!
Dialogue: 0,0:08:47.24,0:08:50.80,Default,Maomao,0,0,0,,I coś ciepłego! Ubrania,\Njedzenie, cokolwiek!
Dialogue: 0,0:08:51.63,0:08:54.92,Default,Maomao,0,0,0,,{\i1}Nie wiem, co pan Jinshi\Nzrobi z tymi dziećmi.
Dialogue: 0,0:08:55.33,0:08:58.76,Default,Maomao,0,0,0,,{\i1}Ale właśnie po to\Nmnie tu sprowadzono.
Dialogue: 0,0:08:59.98,0:09:01.89,Default,Jinshi,0,0,0,,Raz polegli...
Dialogue: 0,0:09:01.89,0:09:06.10,Default,Loulan,0,0,0,,Zatem pozwolisz odejść tym,\Nktórzy już raz polegli.
Dialogue: 0,0:09:07.55,0:09:09.23,Default,Jinshi,0,0,0,,Zostałem oszukany przez lisicę.
Dialogue: 0,0:09:09.23,0:09:10.30,Default,Maomao,0,0,0,,Panie Jinshi!
Dialogue: 0,0:09:10.30,0:09:11.84,Default,Jinshi,0,0,0,,Jasne, zrozumiałem!
Dialogue: 0,0:09:19.00,0:09:22.19,Default,Jinshi,0,0,0,,Hej! Przynieście wiadro\Ngorącej wody i koce.
Dialogue: 0,0:09:22.19,0:09:23.93,Default,Jinshi,0,0,0,,Przynieście też coś ciepłego do picia!
Dialogue: 0,0:09:23.93,0:09:24.71,Default,Soldier A,0,0,0,,Tak jest!
Dialogue: 0,0:09:27.71,0:09:28.67,Default,Gaoshun,0,0,0,,Panie Jinshi?
Dialogue: 0,0:09:35.89,0:09:38.80,Default,Maomao,0,0,0,,Potrzebuję pomocy!\NPrzyprowadźcie Suirei, jeśli można!
Dialogue: 0,0:09:39.09,0:09:40.54,Default,Jinshi,0,0,0,,Gaoshun, proszę.
Dialogue: 0,0:09:40.54,0:09:41.47,Default,Gaoshun,0,0,0,,Oczywiście.
Dialogue: 0,0:09:54.98,0:09:56.78,Default,Jinshi,0,0,0,,Zostawiam tutaj gorącą wodę.
Dialogue: 0,0:09:56.78,0:09:58.32,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:10:01.37,0:10:03.27,Default,Jinshi,0,0,0,,Dokończymy kiedy indziej, dobrze?
Dialogue: 0,0:10:03.74,0:10:05.54,Default,Maomao,0,0,0,,Tak, tak. Jasne.
Dialogue: 0,0:10:15.79,0:10:16.74,Default,Jinshi,0,0,0,,Suirei.
Dialogue: 0,0:10:18.67,0:10:20.39,Default,Jinshi,0,0,0,,Dzieci powróciły do życia.
Dialogue: 0,0:10:23.32,0:10:24.14,Default,Soldier B,0,0,0,,Hej!
Dialogue: 0,0:10:46.42,0:10:49.23,Default,Pairin,0,0,0,,Jakże uroczy początek roku.
Dialogue: 0,0:10:49.75,0:10:52.42,Default,Pairin,0,0,0,,Ogłoszono nowego\Nksięcia koronnego, prawda?
Dialogue: 0,0:10:52.42,0:10:53.75,Default,Joka,0,0,0,,Tak słyszałam.
Dialogue: 0,0:10:53.75,0:10:57.65,Default,Meimei,0,0,0,,Dzięki świątecznej atmosferze\Nnasi goście są dość hojni.
Dialogue: 0,0:10:57.65,0:11:00.44,Default,Meimei,0,0,0,,Babiczka tylko szczerzy\Nsię do swojego liczydełka.
Dialogue: 0,0:11:04.65,0:11:09.75,Default,Meimei,0,0,0,,Podobno konkubina Gyokuyou,\Nktórej służyła Maomao, ma zostać cesarzową.
Dialogue: 0,0:11:22.90,0:11:24.53,Default,Maomao,0,0,0,,{\i1}Po porodzie
Dialogue: 0,0:11:25.00,0:11:27.17,Default,Maomao,0,0,0,,{\i1}zdecydowali się zostawić\Ntatka w pałacu,
Dialogue: 0,0:11:27.17,0:11:29.42,Default,Maomao,0,0,0,,{\i1}— zamiast odsyłać go do dzielnicy uciech.\N— Guen, zostawię to tutaj.
Dialogue: 0,0:11:29.42,0:11:33.50,Default,Maomao,0,0,0,,{\i1}— Pierwotnie został niesłusznie\Nwyrzucony z wewnętrznego pałacu,
Dialogue: 0,0:11:32.04,0:11:34.55,Default,Guen,0,0,0,,{\an8}—Dobrze, Luomen.
Dialogue: 0,0:11:33.50,0:11:35.60,Default,Maomao,0,0,0,,{\i1}— ale jego umiejętności\Njako medyka są doskonałe.
Dialogue: 0,0:11:36.19,0:11:38.85,Default,Maomao,0,0,0,,{\i1}To naturalne, że chcieli go zatrzymać.
Dialogue: 0,0:11:42.49,0:11:44.93,Default,Maomao,0,0,0,,{\i1}Od tamtej pory\Nnie widziałam pana Jinshiego.
Dialogue: 0,0:11:45.33,0:11:47.16,Default,Maomao,0,0,0,,{\i1}Pewnie jest zajęty\Nsprzątaniem po klanie Shi,
Dialogue: 0,0:11:47.16,0:11:49.59,Default,Maomao,0,0,0,,{\i1}równocześnie wypełniając\Nswoje poprzednie zajęcie.
Dialogue: 0,0:11:51.50,0:11:53.76,Default,Maomao,0,0,0,,{\i1}To dobra wiadomość,
Dialogue: 0,0:11:54.98,0:11:58.40,Default,Maomao,0,0,0,,{\i1}ale zarazem nie było już dla mnie\Nmiejsca w wewnętrznym pałacu.
Dialogue: 0,0:12:00.03,0:12:03.84,Default,Maomao,0,0,0,,{\i1}Z drugiej strony praca w dzielnicy\Nuciech jest bardziej czasochłonna.
Dialogue: 0,0:12:03.84,0:12:07.45,Default,Maomao,0,0,0,,{\i1}Zapasy leków, w które tatko się\Nzaopatrzył przed wyjazdem, skończyły się.
Dialogue: 0,0:12:07.45,0:12:10.00,Default,Chou-u,0,0,0,,Hej, Piegusko!\NDaj jakąś przekąskę!
Dialogue: 0,0:12:10.00,0:12:14.33,Default,Maomao,0,0,0,,Nie biegaj tyle. Jeszcze niedawno\Nbyłeś przykuty do łóżka.
Dialogue: 0,0:12:14.33,0:12:15.88,Default,Chou-u,0,0,0,,Nic mi nie jest!
Dialogue: 0,0:12:16.19,0:12:19.17,Default,Chou-u,0,0,0,,— Cała piątka odzyskała przytomność.\N—To było tutaj?
Dialogue: 0,0:12:20.15,0:12:23.43,Default,Maomao,0,0,0,,{\i1}Jemu wybudzenie zajęło najwięcej czasu.
Dialogue: 0,0:12:24.90,0:12:27.43,Default,Suirei,0,0,0,,{\i1}Lek wciąż był jeszcze testowany.
Dialogue: 0,0:12:28.06,0:12:31.56,Default,Suirei,0,0,0,,{\i1}Chciałam najpierw\Nupewnić się, że to działa...
Dialogue: 0,0:12:32.37,0:12:35.73,Default,Maomao,0,0,0,,{\i1}Powrót Kyou trwał najdłużej.\NUtracił wspomnienia...
Dialogue: 0,0:12:35.73,0:12:38.06,Default,Maomao,0,0,0,,{\i1}i ma częściowo sparaliżowaną\Njedną stronę ciała.
Dialogue: 0,0:12:38.84,0:12:43.74,Default,Maomao,0,0,0,,{\i1}Jednak powinien cieszyć się,\Nże w ogóle wrócił do zdrowia.
Dialogue: 0,0:12:44.58,0:12:48.50,Default,Maomao,0,0,0,,{\i1}Reszta dzieci zmieniła\Nimiona i żyła dalej.
Dialogue: 0,0:12:49.31,0:12:53.82,Default,Maomao,0,0,0,,{\i1}Nie wiem dlaczego, ale wszystkie\Ndzieci, które pierwsze się obudziły,
Dialogue: 0,0:12:53.82,0:12:58.57,Default,Maomao,0,0,0,,{\i1}zostały adoptowane\Nprzez byłą konkubinę A Duo.
Dialogue: 0,0:12:59.62,0:13:01.43,Default,Maomao,0,0,0,,Przygarnęła również... Suirei.
Dialogue: 0,0:13:02.93,0:13:05.73,Default,Maomao,0,0,0,,{\i1}Suirei przysporzyła\Nkłopotów w całym pałacu,
Dialogue: 0,0:13:05.73,0:13:09.06,Default,Maomao,0,0,0,,{\i1}ale chyba zastosowali\Nłagodzące okoliczności.
Dialogue: 0,0:13:09.63,0:13:11.81,Default,Maomao,0,0,0,,{\i1}Poza tym płynie w niej\Nkrew zmarłego cesarza.
Dialogue: 0,0:13:11.81,0:13:14.41,Default,Maomao,0,0,0,,{\i1}Nie zostanie stracona,\Nale będzie pod obserwacją.
Dialogue: 0,0:13:14.97,0:13:20.38,Default,Maomao,0,0,0,,{\i1}Z powodu utraty pamięci Kyou był jedynym,\Nktóry przybył do dzielnicy uciech.
Dialogue: 0,0:13:20.38,0:13:23.29,Default,Maomao,0,0,0,,{\i1}Zdecydowano, że powinien\Ndorastać z dala od innych dzieci.
Dialogue: 0,0:13:23.85,0:13:28.22,Default,Maomao,0,0,0,,{\i1}Co mieli na myśli przez słowa\N„to chyba w sumie najbezpieczniejsze miejsce”?
Dialogue: 0,0:13:28.78,0:13:30.11,Default,Chou-u,0,0,0,,Znalazłem!
Dialogue: 0,0:13:31.29,0:13:32.80,Default,Chou-u,0,0,0,,Ej! Za co to było?!
Dialogue: 0,0:13:32.80,0:13:35.10,Default,Maomao,0,0,0,,Nie jedz tego bez pozwolenia,\NChou, gamoniu.
Dialogue: 0,0:13:35.63,0:13:39.04,Default,Maomao,0,0,0,,{\i1}Zmieniono jego imię\Nz „Kyou” na „Chou”.
Dialogue: 0,0:13:39.38,0:13:43.49,Default,Maomao,0,0,0,,{\i1}Była to ostatnia deska ratunku, bo pamiętał\Nbrzmienie swojego dawnego imienia.
Dialogue: 0,0:13:43.49,0:13:45.71,Default,Maomao,0,0,0,,Chou, proszę, łapaj.
Dialogue: 0,0:13:45.71,0:13:47.88,Default,Chou-u,0,0,0,,Tak! Lecę się pobawić!
Dialogue: 0,0:13:53.13,0:13:56.01,Default,Maomao,0,0,0,,Panna Seki?
Dialogue: 0,0:13:57.19,0:13:58.73,Default,Seki-u,0,0,0,,Kopę lat.
Dialogue: 0,0:14:00.11,0:14:04.60,Default,Seki-u,0,0,0,,Słyszałam, że pracujesz jako zielarka,\Nale nie sądziłam, że w dzielnicy uciech.
Dialogue: 0,0:14:04.60,0:14:06.82,Default,Maomao,0,0,0,,Nie było problemów\Nz ogłoszeniem księcia koronnego?
Dialogue: 0,0:14:07.29,0:14:09.10,Default,Seki-u,0,0,0,,Tak, poszło jak z płatka.
Dialogue: 0,0:14:09.10,0:14:11.32,Default,Seki-u,0,0,0,,Masz pozdrowienia od pozostałych.
Dialogue: 0,0:14:11.32,0:14:13.41,Default,Seki-u,0,0,0,,O i to. Miałam ci to przekazać.
Dialogue: 0,0:14:14.17,0:14:16.59,Default,Seki-u,0,0,0,,Byłoby źle, gdybym zapomniała.
Dialogue: 0,0:14:17.16,0:14:20.75,Default,Text,0,0,0,,{\an8}SHISUI, MAOMAO, XIAOLAN
Dialogue: 0,0:14:19.50,0:14:20.75,Default,Maomao,0,0,0,,Xiaolan...
Dialogue: 0,0:14:20.75,0:14:24.38,Default,Seki-u,0,0,0,,Była naprawdę smutna,\Ngdy ty i Shisui odeszłyście.
Dialogue: 0,0:14:24.38,0:14:27.30,Default,Seki-u,0,0,0,,Liczyła, że przynajmniej\Nzostawisz jej jakąś wiadomość.
Dialogue: 0,0:14:27.30,0:14:33.22,Default,Maomao,0,0,0,,Oficjalna wersja mówi, że ja i Shisui\Nzostałyśmy zatrudnione gdzie indziej, prawda?
Dialogue: 0,0:14:33.71,0:14:35.63,Default,Seki-u,0,0,0,,Tak, ale...
Dialogue: 0,0:14:36.33,0:14:38.97,Default,Seki-u,0,0,0,,Fajnie, że nadal myśli pozytywnie.
Dialogue: 0,0:14:38.97,0:14:42.40,Default,Seki-u,0,0,0,,Nie jest najlepszą pracownicą,\Nale samej też nie można jej zostawić.
Dialogue: 0,0:14:49.50,0:14:51.34,Default,Seki-u,0,0,0,,Uważaj na siebie.
Dialogue: 0,0:14:51.34,0:14:53.29,Default,Maomao,0,0,0,,Jasne. Ty również, Seki.
Dialogue: 0,0:14:57.80,0:15:03.06,Default,Maomao,0,0,0,,{\i1}Seki szczegółowo wyjaśniła mi,\Njak Xiaolan się miewała.
Dialogue: 0,0:15:04.09,0:15:07.21,Default,Text,0,0,0,,{\an8}SHISUI, MAOMAO
Dialogue: 0,0:15:05.82,0:15:11.32,Default,Maomao,0,0,0,,{\i1}Po naszym odejściu Xiaolan dalej\Nsumiennie pracowała w łaźniach.
Dialogue: 0,0:15:11.32,0:15:13.72,Default,Maomao,0,0,0,,{\i1}Seki nie mogła zostawić jej samej.
Dialogue: 0,0:15:15.75,0:15:17.22,Default,Maomao,0,0,0,,Rozumiem...
Dialogue: 0,0:15:17.98,0:15:19.94,Default,Maomao,0,0,0,,Xiaolan nie jest...
Dialogue: 0,0:15:29.49,0:15:33.96,Default,Maomao,0,0,0,,—„Maomao, jak się masz? U mnie nieźle”.
Dialogue: 0,0:15:32.38,0:15:33.96,Default,Xiaolan,0,0,0,,{\i1\an2}—U mnie nieźle.{\i0}
Dialogue: 0,0:15:34.82,0:15:38.67,Default,Xiaolan,0,0,0,,{\i1}Moja kadencja dobiegła\Nkońca i odchodzę z pałacu.
Dialogue: 0,0:15:39.41,0:15:43.12,Default,Xiaolan,0,0,0,,{\i1}Konkubina, która dała mi szpilkę\Ndo włosów, polubiła moją pracę,
Dialogue: 0,0:15:43.12,0:15:47.59,Default,Xiaolan,0,0,0,,{\i1}więc zatrudniła mnie\Nu swojej młodszej siostry.
Dialogue: 0,0:15:48.75,0:15:51.90,Default,Xiaolan,0,0,0,,{\i1}Dam z siebie wszystko, a nawet więcej!
Dialogue: 0,0:15:53.09,0:15:58.04,Default,Xiaolan,0,0,0,,{\i1}Żałuję, że nie mogę ci\Ntego powiedzieć osobiście.
Dialogue: 0,0:16:03.62,0:16:07.58,Default,Xiaolan,0,0,0,,{\i1}Chcę się niedługo z wami zobaczyć.
Dialogue: 0,0:16:08.58,0:16:11.20,Default,Xiaolan,0,0,0,,{\i1}Chciałabym znowu\Nrazem zajadać się lodami.
Dialogue: 0,0:16:22.75,0:16:27.75,Default,Text,0,0,0,,{\an8}SHISUI
Dialogue: 0,0:16:31.65,0:16:32.88,Default,Maomao,0,0,0,,Śnieżek...
Dialogue: 0,0:16:39.51,0:16:44.27,Default,Maomao,0,0,0,,{\i1}Podobno nie znaleźli ciała Shisui,\Nbez względu na to, ile śniegu przeczesali.
Dialogue: 0,0:16:46.33,0:16:50.50,Default,Maomao,0,0,0,,{\i1}Najpewniej poszukiwania zostaną\Nwznowione, gdy tylko przyjdzie wiosna.
Dialogue: 0,0:17:02.09,0:17:04.02,Default,Maomao,0,0,0,,Oby nigdy jej nie znaleźli.
Dialogue: 0,0:17:08.88,0:17:11.17,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:17:09.74,0:17:11.17,Default,Maomao,0,0,0,,Rany!
Dialogue: 0,0:17:11.63,0:17:15.63,Default,Maomao,0,0,0,,To nie to, co oczekiwałam.
Dialogue: 0,0:17:15.63,0:17:17.69,Default,Maomao,0,0,0,,Wiedziałam.
Dialogue: 0,0:17:19.60,0:17:20.74,Default,Maomao,0,0,0,,No to jedziemy!
Dialogue: 0,0:17:20.74,0:17:22.31,Default,Jinshi,0,0,0,,Co usiłujesz zrobić?
Dialogue: 0,0:17:23.73,0:17:27.44,Default,Maomao,0,0,0,,Pan Jinshi. Skończyłeś swoją robotę?
Dialogue: 0,0:17:27.44,0:17:29.44,Default,Jinshi,0,0,0,,Zdecydowanie zasłużyłem na przerwę.
Dialogue: 0,0:17:31.59,0:17:35.32,Default,Old Lady,0,0,0,,Ohoho! Proszę bardzo!\NBaw się dobrze!
Dialogue: 0,0:17:37.72,0:17:39.02,Default,Maomao,0,0,0,,{\i1}Co w nią wstąpiło?
Dialogue: 0,0:17:40.50,0:17:43.07,Default,Maomao,0,0,0,,{\i1}O, jak ładnie pozszywane.
Dialogue: 0,0:17:43.87,0:17:45.75,Default,Maomao,0,0,0,,{\i1}Chyba tatko poprawił szwy.
Dialogue: 0,0:17:46.98,0:17:48.46,Default,Maomao,0,0,0,,Wyglądasz na zmęczonego.
Dialogue: 0,0:17:48.46,0:17:54.63,Default,Jinshi,0,0,0,,Zajmowałem się sprawami organizacyjnymi,\Nziemiami należącymi do klanu Shi i tak dalej.
Dialogue: 0,0:17:55.97,0:18:00.81,Default,Maomao,0,0,0,,{\i1}Podobno większość członków\Nklanu Shi została już stracona.
Dialogue: 0,0:18:00.81,0:18:03.36,Default,Maomao,0,0,0,,{\i1}Ich ziemia jest przejmowana przez rząd.
Dialogue: 0,0:18:03.89,0:18:06.30,Default,Maomao,0,0,0,,{\i1}Pełno tam ogromnych obszarów leśnych.
Dialogue: 0,0:18:06.30,0:18:08.23,Default,Maomao,0,0,0,,{\i1}To powinno wzmocnić zasoby kraju.
Dialogue: 0,0:18:08.74,0:18:12.40,Default,Maomao,0,0,0,,{\i1}Drewno, co?\NOby zrobili dużo papieru.
Dialogue: 0,0:18:12.40,0:18:15.66,Default,Jinshi,0,0,0,,Ej, przestań traktować\Nmnie jak powietrze.
Dialogue: 0,0:18:15.66,0:18:17.52,Default,Maomao,0,0,0,,Przepraszam. To z przyzwyczajenia.
Dialogue: 0,0:18:19.21,0:18:22.62,Default,Jinshi,0,0,0,,Dobra. Musisz wywiązać się z obietnicy.
Dialogue: 0,0:18:22.62,0:18:23.37,Default,Maomao,0,0,0,,Obietnicy?
Dialogue: 0,0:18:23.76,0:18:26.04,Default,Jinshi,0,0,0,,Mam dla ciebie składniki na lody.
Dialogue: 0,0:18:26.37,0:18:29.04,Default,Maomao,0,0,0,,Lody... A, szpilka do włosów!
Dialogue: 0,0:18:29.04,0:18:30.09,Default,Jinshi,0,0,0,,Co się stało?
Dialogue: 0,0:18:30.09,0:18:33.58,Default,Maomao,0,0,0,,Cóż... Jeśli chodzi o tę szpilkę...
Dialogue: 0,0:18:34.27,0:18:35.60,Default,Maomao,0,0,0,,Oddałam ją.
Dialogue: 0,0:18:35.60,0:18:36.09,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:18:37.05,0:18:39.63,Default,Maomao,0,0,0,,Może znajdziemy ją,\Ngdy nadejdzie wiosna.
Dialogue: 0,0:18:39.63,0:18:40.93,Default,Jinshi,0,0,0,,Czemu wiosną?
Dialogue: 0,0:18:41.77,0:18:44.00,Default,Maomao,0,0,0,,A może nigdy nie znajdziemy.
Dialogue: 0,0:18:44.71,0:18:48.18,Default,Maomao,0,0,0,,Mogła wylądować na jakimś straganie.
Dialogue: 0,0:18:48.18,0:18:49.49,Default,Jinshi,0,0,0,,Sprzedałaś ją?!
Dialogue: 0,0:18:49.49,0:18:51.08,Default,Maomao,0,0,0,,Nie sprzedałam!
Dialogue: 0,0:18:51.08,0:18:53.25,Default,Maomao,0,0,0,,Więc... ja...
Dialogue: 0,0:18:53.25,0:18:56.41,Default,Maomao,0,0,0,,Dałam ją Shisui... Loulan.
Dialogue: 0,0:18:56.79,0:19:00.14,Default,Maomao,0,0,0,,Poprosiłam, by mi ją kiedyś oddała.
Dialogue: 0,0:19:00.84,0:19:02.07,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:19:02.57,0:19:06.60,Default,Jinshi,0,0,0,,Więc spełnij swoją drugą obietnicę.
Dialogue: 0,0:19:06.60,0:19:09.42,Default,Maomao,0,0,0,,Słuchać tego,\Nco mówisz do końca, prawda?
Dialogue: 0,0:19:09.42,0:19:10.42,Default,Jinshi,0,0,0,,Bingo.
Dialogue: 0,0:19:12.29,0:19:14.38,Default,Maomao,0,0,0,,Zgoda. Mów śmiało.
Dialogue: 0,0:19:17.55,0:19:18.30,Default,Maomao,0,0,0,,No mów.
Dialogue: 0,0:19:20.38,0:19:21.69,Default,Maomao,0,0,0,,Mowę ci odebrało?
Dialogue: 0,0:19:21.69,0:19:23.76,Default,Jinshi,0,0,0,,Cóż, ja...
Dialogue: 0,0:19:23.76,0:19:27.77,Default,Jinshi,0,0,0,,Chyba wiesz już,\Nco chciałem ci powiedzieć.
Dialogue: 0,0:19:27.77,0:19:31.28,Default,Maomao,0,0,0,,{\i1}Chyba wszystkie te sprawy\Nna temat jego pozycji to stare dzieje.
Dialogue: 0,0:19:31.94,0:19:34.02,Default,Maomao,0,0,0,,Zatem czy jest coś jeszcze?
Dialogue: 0,0:19:34.70,0:19:35.82,Default,Jinshi,0,0,0,,Coś jeszcze...
Dialogue: 0,0:19:37.80,0:19:39.26,Default,Maomao,0,0,0,,{\i1}Więc nic innego nie chce?
Dialogue: 0,0:19:51.64,0:19:54.05,Default,Maomao,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:19:54.05,0:19:55.85,Default,Jinshi,0,0,0,,Czy teraz wiesz, co chcę?
Dialogue: 0,0:19:56.69,0:19:59.91,Default,Maomao,0,0,0,,Czasami ludzka ślina\Nmoże być trująca.
Dialogue: 0,0:20:01.77,0:20:04.84,Default,Jinshi,0,0,0,,Na ciebie nie zadziałają\Ntak lekkie trucizny!
Dialogue: 0,0:20:05.55,0:20:09.47,Default,Maomao,0,0,0,,Aua! Aua! Aua!\NChcesz mnie zagryźć na śmierć?
Dialogue: 0,0:20:15.61,0:20:17.61,Default,Jinshi,0,0,0,,Czasem naprawdę tego chcę.
Dialogue: 0,0:20:18.13,0:20:19.02,Default,Maomao,0,0,0,,Co?!
Dialogue: 0,0:20:20.44,0:20:23.05,Default,Jinshi,0,0,0,,Wróćmy do tego,\Nna czym wtedy skończyliśmy.
Dialogue: 0,0:20:29.05,0:20:31.10,Default,Maomao,0,0,0,,{\i1}Są naprawdę doskonałe...
Dialogue: 0,0:20:35.62,0:20:39.34,Default,Jinshi,0,0,0,,Czy ty również jesteś trucizną?
Dialogue: 0,0:20:40.29,0:20:41.21,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:20:43.98,0:20:47.71,Default,Chou-u,0,0,0,,Hej, Piegusko! Zobacz!\NTego chciałaś, prawda?!
Dialogue: 0,0:20:47.71,0:20:49.45,Default,Maomao,0,0,0,,Dobra robota!
Dialogue: 0,0:20:51.23,0:20:52.17,Default,Maomao,0,0,0,,Ale wielgachna.
Dialogue: 0,0:20:52.17,0:20:53.16,Default,Chou-u,0,0,0,,Co nie?
Dialogue: 0,0:20:54.13,0:20:56.57,Default,Jinshi,0,0,0,,Dlaczego zawsze ktoś mi przeszkadza?
Dialogue: 0,0:20:57.13,0:20:58.56,Default,Chou-u,0,0,0,,Co z nim nie tak?
Dialogue: 0,0:20:59.99,0:21:01.40,Default,Maomao,0,0,0,,Jest zmęczony.
Dialogue: 0,0:21:01.88,0:21:03.61,Default,Maomao,0,0,0,,Oto twoja zapłata. Brązowy cukier.
Dialogue: 0,0:21:04.97,0:21:05.94,Default,Chou-u,0,0,0,,Dziękówka!
Dialogue: 0,0:21:10.41,0:21:14.64,Default,Maomao,0,0,0,,Starucho, przygotuj mu łóżko.\NI może jakieś kadzidełko.
Dialogue: 0,0:21:14.64,0:21:16.83,Default,Old Lady,0,0,0,,Cholera. Już idę!
Dialogue: 0,0:21:21.52,0:21:25.00,Default,Maomao,0,0,0,,Wyglądasz na przemęczonego,\Nidź więc odpocząć.
Dialogue: 0,0:21:25.00,0:21:26.38,Default,Jinshi,0,0,0,,W porządku. Tak zrobię.
Dialogue: 0,0:21:27.64,0:21:28.72,Default,Maomao,0,0,0,,Co...
Dialogue: 0,0:21:28.72,0:21:30.35,Default,Jinshi,0,0,0,,Ale tylko z moją podusią.
Dialogue: 0,0:21:31.77,0:21:33.39,Default,Maomao,0,0,0,,Panie Jinshi?
Dialogue: 0,0:21:36.57,0:21:39.52,Default,Maomao,0,0,0,,Tylko udajesz, że śpisz, panie Jinshi?
Dialogue: 0,0:21:44.69,0:21:46.74,Default,Maomao,0,0,0,,{\i1}No i usnął mi na kolanach.
Dialogue: 0,0:22:13.86,0:22:18.14,Default,Merchant,0,0,0,,Proszę bardzo i dziękuję!
Dialogue: 0,0:22:18.14,0:22:19.28,Default,Tamamo,0,0,0,,Proszę pana.
Dialogue: 0,0:22:19.28,0:22:21.34,Default,Merchant,0,0,0,,Tak?
Dialogue: 0,0:22:21.34,0:22:23.27,Default,Tamamo,0,0,0,,Czy to cykada?
Dialogue: 0,0:22:23.69,0:22:27.74,Default,Merchant,0,0,0,,Tak, wykonana jest z popularnego\Nw dawnych czasach jadeitu.
Dialogue: 0,0:22:27.74,0:22:30.12,Default,Tamamo,0,0,0,,Jadeit, tak?
Dialogue: 0,0:22:30.12,0:22:33.61,Default,Merchant,0,0,0,,Ej, to cenny towar.\NNie zawracaj mi tyłka.
Dialogue: 0,0:22:33.61,0:22:34.75,Default,Merchant,0,0,0,,Kupujesz?
Dialogue: 0,0:22:34.75,0:22:37.46,Default,Tamamo,0,0,0,,Nie mam aż tyle.
Dialogue: 0,0:22:37.46,0:22:39.78,Default,Merchant,0,0,0,,Więc nie dotykaj.
Dialogue: 0,0:22:39.78,0:22:42.04,Default,Tamamo,0,0,0,,A może się wymienimy?
Dialogue: 0,0:22:42.40,0:22:43.40,Default,Tamamo,0,0,0,,Spójrz na to.
Dialogue: 0,0:22:43.82,0:22:44.98,Default,Merchant,0,0,0,,Szpilka do włosów?
Dialogue: 0,0:22:45.95,0:22:49.97,Default,Merchant,0,0,0,,Co to?! Nie widuję takich\Nrzeczy w tej okolicy!
Dialogue: 0,0:22:51.71,0:22:52.47,Default,Tamamo,0,0,0,,I jak będzie?
Dialogue: 0,0:22:52.83,0:22:55.24,Default,Merchant,0,0,0,,Panienko, skąd to...
Dialogue: 0,0:22:55.24,0:22:57.50,Default,Merchant,0,0,0,,Znaczy się, umowa stoi!
Dialogue: 0,0:22:57.50,0:22:59.23,Default,Tamamo,0,0,0,,Dzięki, biorę to!
Dialogue: 0,0:23:03.31,0:23:05.00,Default,Tamamo,0,0,0,,Ale piękne.
Dialogue: 0,0:23:08.65,0:23:10.02,Default,Tamamo,0,0,0,,Hej, proszę pana!
Dialogue: 0,0:23:10.02,0:23:11.32,Default,Merchant,0,0,0,,Co?
Dialogue: 0,0:23:11.32,0:23:14.12,Default,Tamamo,0,0,0,,Nazywam się Tamamo.
Dialogue: 0,0:23:14.43,0:23:17.16,Default,Merchant,0,0,0,,„Tama” jak w drugim czytaniu\Ndla jadeitu, a „mo” jak w wodorostach? {玉 - są dwa czytania tego znaku tama i gyoku}
Dialogue: 0,0:23:17.58,0:23:20.36,Default,Merchant,0,0,0,,Brzmi jak imię\Nz błogosławieństwem oceanu.
Dialogue: 0,0:23:20.36,0:23:21.12,Default,Tamamo,0,0,0,,Dokładnie!
Dialogue: 0,0:23:23.22,0:23:24.76,Default,Tamamo,0,0,0,,Racja...
Dialogue: 0,0:23:25.57,0:23:28.38,Default,Tamamo,0,0,0,,Druga strona oceanu brzmi ekscytująco.
Dialogue: 0,0:23:31.51,0:23:33.88,Default,Tamamo,0,0,0,,Dobra, jeszcze raz dzięki!
Dialogue: 0,0:23:35.73,0:23:37.62,Default,Tamamo,0,0,0,,Do widzenia!
Dialogue: 0,0:23:40.00,0:23:42.98,Default,Tamamo,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
