Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.44,0:01:33.44,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:42.17,0:01:43.46,Default,Jinshi,0,0,0,,Przepraszam.
Dialogue: 0,0:01:43.46,0:01:44.54,Default,Hongniang,0,0,0,,Pan Jinshi.
Dialogue: 0,0:01:45.10,0:01:47.51,Default,Jinshi,0,0,0,,Słyszałem, że konkubina\NGyokuyou zaczęła rodzić.
Dialogue: 0,0:01:45.58,0:01:49.54,Default,Text,0,0,0,,{\an8}ODCINEK 42: MIECHUNKA ROZDĘTA
Dialogue: 0,0:01:47.51,0:01:49.75,Default,Hongniang,0,0,0,,Tak, z samego rana.
Dialogue: 0,0:01:49.75,0:01:54.09,Default,Hongniang,0,0,0,,Potrwa to jeszcze trochę,\Nale jesteśmy już w gotowości.
Dialogue: 0,0:01:54.79,0:01:55.76,Default,Hongniang,0,0,0,,Zapraszam.
Dialogue: 0,0:02:06.95,0:02:08.06,Default,Jinshi,0,0,0,,Co z nią?
Dialogue: 0,0:02:08.36,0:02:10.65,Default,Luomen,0,0,0,,Jej stan jest stabilny.
Dialogue: 0,0:02:11.03,0:02:14.72,Default,Luomen,0,0,0,,Skurcze ustąpiły\Ni nie wygląda na wycieńczoną.
Dialogue: 0,0:02:15.69,0:02:16.56,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:02:17.21,0:02:20.57,Default,Luomen,0,0,0,,Na razie nie wiemy,\Nkiedy odbędzie się poród.
Dialogue: 0,0:02:21.15,0:02:22.95,Default,Jinshi,0,0,0,,Co z dzieckiem?
Dialogue: 0,0:02:22.95,0:02:26.34,Default,Luomen,0,0,0,,Nie ma już powodów do obaw,\Njeżeli chodzi o poród miednicowy.
Dialogue: 0,0:02:26.34,0:02:29.93,Default,Luomen,0,0,0,,Wygląda na to,\Nże zabiegi Maomao zadziałały.
Dialogue: 0,0:02:31.67,0:02:32.73,Default,Jinshi,0,0,0,,{\i1}Maomao...
Dialogue: 0,0:02:34.63,0:02:37.70,Default,Jinshi,0,0,0,,{\i1}Od jej zaginięcia minęło już dziesięć dni.
Dialogue: 0,0:02:38.49,0:02:39.69,Default,Jinshi,0,0,0,,{\i1}Nic jej nie jest?
Dialogue: 0,0:02:46.86,0:02:50.84,Default,Guen,0,0,0,,L-Luomen, mogę jakoś pomóc?
Dialogue: 0,0:02:50.84,0:02:52.85,Default,Yinghua,0,0,0,,Medyku, z drogi!
Dialogue: 0,0:02:52.85,0:02:55.46,Default,Guiyuan,0,0,0,,Nie stój w drzwiach, proszę!
Dialogue: 0,0:02:56.65,0:02:58.42,Default,Koku-u,0,0,0,,Zaopiekuj się kotką.
Dialogue: 0,0:02:58.42,0:02:59.47,Default,Guen,0,0,0,,Dobrze!
Dialogue: 0,0:03:04.81,0:03:08.87,Default,Jinshi,0,0,0,,{\i1}Pociesza mnie fakt,\Nże inni panikują bardziej niż ja.
Dialogue: 0,0:03:13.47,0:03:17.75,Default,Jinshi,0,0,0,,Na razie znikam. Jeśli coś\Nsię stanie, powiadom mnie.
Dialogue: 0,0:03:18.90,0:03:19.92,Default,Gaoshun,0,0,0,,Panie Jinshi!
Dialogue: 0,0:03:20.39,0:03:21.22,Default,Jinshi,0,0,0,,Co jest?
Dialogue: 0,0:03:22.74,0:03:25.08,Default,Gaoshun,0,0,0,,Chodzi o zaginionego eunucha.
Dialogue: 0,0:03:29.19,0:03:31.31,Default,Jinshi,0,0,0,,Co udało się znaleźć?
Dialogue: 0,0:03:31.90,0:03:33.89,Default,Gaoshun,0,0,0,,Nazywa się on Tian.
Dialogue: 0,0:03:33.89,0:03:36.91,Default,Gaoshun,0,0,0,,Rzekomo był niewolnikiem\Npochodzącym z zagranicy,
Dialogue: 0,0:03:36.91,0:03:40.82,Default,Gaoshun,0,0,0,,ale nikt z przybyłych go nie kojarzył.
Dialogue: 0,0:03:40.82,0:03:43.95,Default,Gaoshun,0,0,0,,Musiał się jakoś wślizgnąć.
Dialogue: 0,0:03:45.72,0:03:47.95,Default,Jinshi,0,0,0,,By przeniknąć do wewnętrznego pałacu.
Dialogue: 0,0:03:49.21,0:03:53.13,Default,Gaoshun,0,0,0,,Zapewne trzymał się z dala od innych,\Nby zachować anonimowość.
Dialogue: 0,0:03:53.13,0:03:56.11,Default,Gaoshun,0,0,0,,Przez to nie mamy prawie\Nżadnych informacji na jego temat.
Dialogue: 0,0:03:58.31,0:03:59.13,Default,Jinshi,0,0,0,,Coś jeszcze?
Dialogue: 0,0:03:59.13,0:04:02.39,Default,Gaoshun,0,0,0,,Widziano go, jak modlił się w świątyni.
Dialogue: 0,0:04:02.83,0:04:05.66,Default,Jinshi,0,0,0,,To nic dziwnego.\NMoże był po prostu religijny.
Dialogue: 0,0:04:06.51,0:04:07.85,Default,Gaoshun,0,0,0,,Cóż...
Dialogue: 0,0:04:12.86,0:04:15.85,Default,Jinshi,0,0,0,,Cmentarz na północnej stronie?
Dialogue: 0,0:04:15.85,0:04:16.31,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:04:16.94,0:04:21.94,Default,Gaoshun,0,0,0,,Groby tych, którzy zostali\Nskalani przez zmarłego cesarza.
Dialogue: 0,0:04:25.56,0:04:30.26,Default,Gaoshun,0,0,0,,Widziano, jak Tian odwiedzał\Njeden z tamtejszych grobów.
Dialogue: 0,0:04:35.08,0:04:39.74,Default,Jinshi,0,0,0,,{\i1}Te, które zostały za młodu\Nwykorzystane przez zmarłego cesarza,
Dialogue: 0,0:04:40.15,0:04:42.94,Default,Jinshi,0,0,0,,{\i1}nigdy nie mogły opuścić\Nwewnętrznego pałacu, nawet po śmierci.
Dialogue: 0,0:04:48.09,0:04:53.80,Default,Jinshi,0,0,0,,{\i1}Przepadły w tym ogrodzie,\Na ich nazwisk nie zachowano.
Dialogue: 0,0:05:01.91,0:05:03.53,Default,Jinshi,0,0,0,,Czy to pracownica kliniki?
Dialogue: 0,0:05:04.94,0:05:06.94,Default,Shenlü,0,0,0,,P-przepraszam.
Dialogue: 0,0:05:12.33,0:05:13.58,Default,Jinshi,0,0,0,,{\i1}Ten zapach...
Dialogue: 0,0:05:22.05,0:05:23.42,Default,Jinshi,0,0,0,,Gdzie podziała się Maomao?!
Dialogue: 0,0:05:29.32,0:05:33.06,Default,Jinshi,0,0,0,,{\i1}Uspokój się!\NTeraz jesteś „eunuchem” Jinshim.
Dialogue: 0,0:05:33.06,0:05:34.56,Default,Jinshi,0,0,0,,{\i1}Muszę być sobą, jak zwykle...
Dialogue: 0,0:05:37.98,0:05:39.96,Default,Jinshi,0,0,0,,Szukam piegowatej służki
Dialogue: 0,0:05:39.96,0:05:42.58,Default,Jinshi,0,0,0,,pracującej dla Jadeitowego Pałacu.
Dialogue: 0,0:05:43.06,0:05:44.75,Default,Jinshi,0,0,0,,Wiesz, o kim mówię?
Dialogue: 0,0:05:54.69,0:05:56.04,Default,Jinshi,0,0,0,,Ty coś wiesz.
Dialogue: 0,0:05:57.32,0:06:02.42,Default,Shenlü,0,0,0,,Przypomniałam sobie...\Npewne wspomnienie.
Dialogue: 0,0:06:06.42,0:06:09.32,Default,Shenlü,0,0,0,,Wypowiedział moje imię\Ntak łagodnym głosem.
Dialogue: 0,0:06:10.50,0:06:14.24,Default,Shenlü,0,0,0,,Podarował zagraniczne łakocie.
Dialogue: 0,0:06:27.80,0:06:29.15,Default,Jinshi,0,0,0,,O czym mówisz?
Dialogue: 0,0:06:29.78,0:06:34.33,Default,Shenlü,0,0,0,,Chyba nikt nie wie,\Njak wyglądał za młodu.
Dialogue: 0,0:06:35.05,0:06:38.41,Default,Shenlü,0,0,0,,Podobno w swoich ostatnich\Nchwilach zupełnie się zmienił.
Dialogue: 0,0:06:39.01,0:06:42.86,Default,Shenlü,0,0,0,,Gdy dorosłam,\Nnigdy mnie nie odwiedził,
Dialogue: 0,0:06:42.86,0:06:45.22,Default,Shenlü,0,0,0,,wszystko, co o nim wiem,\Npochodzi z plotek.
Dialogue: 0,0:06:45.94,0:06:47.65,Default,Jinshi,0,0,0,,O kim mówisz?
Dialogue: 0,0:06:47.65,0:06:49.93,Default,Shenlü,0,0,0,,Wyglądasz jak on.
Dialogue: 0,0:06:49.93,0:06:51.30,Default,Jinshi,0,0,0,,O czym ty mówisz, do diabła?!
Dialogue: 0,0:06:51.77,0:06:57.62,Default,Shenlü,0,0,0,,Jego głosik słodki jak miód,
Dialogue: 0,0:06:57.62,0:07:01.10,Default,Shenlü,0,0,0,,a buzia jak u przepięknej księżniczki.
Dialogue: 0,0:07:02.09,0:07:07.88,Default,Shenlü,0,0,0,,Dlaczego ktoś taki jak ty udaje eunucha?
Dialogue: 0,0:07:11.91,0:07:13.10,Default,Gaoshun,0,0,0,,Aresztować ją!
Dialogue: 0,0:07:13.78,0:07:14.97,Default,Shenlü,0,0,0,,Puśćcie mnie!
Dialogue: 0,0:07:14.97,0:07:16.12,Default,Gaoshun,0,0,0,,Nie opieraj się!
Dialogue: 0,0:07:17.64,0:07:19.80,Default,Gaoshun,0,0,0,,Panie Jinshi, co mamy zrobić?
Dialogue: 0,0:07:22.38,0:07:23.56,Default,Gaoshun,0,0,0,,Panie Jinshi?!
Dialogue: 0,0:07:31.63,0:07:33.47,Default,Gaoshun,0,0,0,,Co to było?! Trucizna?!
Dialogue: 0,0:07:35.05,0:07:36.09,Default,Gaoshun,0,0,0,,Przynieście wodę!
Dialogue: 0,0:07:36.09,0:07:36.81,Default,Eunuch 1,0,0,0,,Tak!
Dialogue: 0,0:07:38.22,0:07:40.18,Default,Gaoshun,0,0,0,,Pan Jinshi, pańskie rozkazy!
Dialogue: 0,0:07:42.69,0:07:43.60,Default,Gaoshun,0,0,0,,Panie Jinshi!
Dialogue: 0,0:07:48.60,0:07:52.78,Default,Gaoshun,0,0,0,,Zabierzcie tę kobietę do medyka\Ni dopilnujcie, by więcej tego nie robiła!
Dialogue: 0,0:07:52.78,0:07:53.52,Default,Eunuch 2,0,0,0,,Rozkaz!
Dialogue: 0,0:07:56.97,0:07:58.65,Default,Gaoshun,0,0,0,,Ocknij się!
Dialogue: 0,0:07:58.65,0:08:01.24,Default,Gaoshun,0,0,0,,Nie pozwól, by obelga\Njakiejś służki tobą owładnęła!
Dialogue: 0,0:08:02.60,0:08:03.92,Default,Jinshi,0,0,0,,Jakiejś?
Dialogue: 0,0:08:05.09,0:08:07.53,Default,Jinshi,0,0,0,,Wypiła truciznę.\NSytuacja wydaje się poważniejsza.
Dialogue: 0,0:08:10.76,0:08:14.51,Default,Jinshi,0,0,0,,Zbladła, gdy zobaczyła mój uśmiech.
Dialogue: 0,0:08:15.04,0:08:16.76,Default,Shenlü,0,0,0,,{\i1}Jego głosik...
Dialogue: 0,0:08:18.20,0:08:22.23,Default,Jinshi,0,0,0,,Gaoshun, czy wyglądam jak on?
Dialogue: 0,0:08:22.67,0:08:25.78,Default,Jinshi,0,0,0,,Na tyle, by ktoś ze strachu\Nwypił truciznę?
Dialogue: 0,0:08:28.05,0:08:32.81,Default,Jinshi,0,0,0,,Jak pamięcią sięgam,\Nbył już starym, niedołężnym starcem.
Dialogue: 0,0:08:34.94,0:08:38.12,Default,Jinshi,0,0,0,,Nie przypominałem matki ani brata.
Dialogue: 0,0:08:38.93,0:08:39.76,Default,Jinshi,0,0,0,,Dlatego...
Dialogue: 0,0:08:40.93,0:08:42.46,Default,Jinshi,0,0,0,,Uwierzyłem.
Dialogue: 0,0:08:43.95,0:08:46.25,Default,Lady-in-Waiting A,0,0,0,,{\i1}Ciekawe, po kim ma tę urodę?
Dialogue: 0,0:08:46.25,0:08:51.14,Default,Lady-in-Waiting A,0,0,0,,{\i1}Patrząc na gust cesarza, nie mogła\Nto być cesarzowa. Nie w jej wieku.
Dialogue: 0,0:08:53.00,0:08:56.66,Default,Lady-in-Waiting B,0,0,0,,{\i1}I to dlatego wszyscy gadają,\Nże to bękart.
Dialogue: 0,0:09:04.35,0:09:07.51,Default,Jinshi,0,0,0,,{\i1}Uwierzyłem w plotki, według których\Nnie miałem z nim nic wspólnego.
Dialogue: 0,0:09:07.95,0:09:10.52,Default,Jinshi,0,0,0,,{\i1}Usiłowałem uciec\Nod pozycji księcia koronnego.
Dialogue: 0,0:09:11.57,0:09:14.28,Default,Jinshi,0,0,0,,{\i1}Błagałem mojego brata,\Ncesarza, by pozwolił mi
Dialogue: 0,0:09:14.28,0:09:18.35,Default,Jinshi,0,0,0,,{\i1}przybrać tożsamość eunucha\Ni zaszyć się w ogrodzie kobiet. Ale po co?
Dialogue: 0,0:09:19.99,0:09:21.88,Default,Jinshi,0,0,0,,{\i1}Zabawne.
Dialogue: 0,0:09:51.61,0:09:54.44,Default,Luomen,0,0,0,,{\i1}Ale robię to,
Dialogue: 0,0:09:55.23,0:09:56.63,Default,Maomao,0,0,0,,{\i1}na co mnie stać.
Dialogue: 0,0:09:58.36,0:09:59.76,Default,Jinshi,0,0,0,,{\i1}Racja.
Dialogue: 0,0:09:59.76,0:10:01.58,Default,Jinshi,0,0,0,,{\i1}Później będę się z siebie śmiał.
Dialogue: 0,0:10:01.98,0:10:03.71,Default,Jinshi,0,0,0,,{\i1}Na razie mam co robić.
Dialogue: 0,0:10:05.27,0:10:08.79,Default,Jinshi,0,0,0,,Ta kobieta oddała hołd\Nprzy tym grobie, prawda?
Dialogue: 0,0:10:08.79,0:10:09.56,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:10:11.97,0:10:14.63,Default,Jinshi,0,0,0,,Miechunka rozdęta?\NJeszcze nie jej pora.
Dialogue: 0,0:10:16.68,0:10:18.19,Default,Jinshi,0,0,0,,Taihou...
Dialogue: 0,0:10:18.83,0:10:21.06,Default,Gaoshun,0,0,0,,Imię dwórki zmarłej w zeszłym roku.
Dialogue: 0,0:10:21.85,0:10:26.23,Default,Jinshi,0,0,0,,Tak. Spotykała się z kobietami,\Nby opowiadać historie o duchach.
Dialogue: 0,0:10:27.73,0:10:30.70,Default,Jinshi,0,0,0,,Była dwórką jednej z konkubin.
Dialogue: 0,0:10:37.96,0:10:39.31,Default,Jinshi,0,0,0,,{\i1}Jej krewnymi byli...
Dialogue: 0,0:10:43.49,0:10:46.24,Default,Jinshi,0,0,0,,{\i1}Tylko jedna osoba\Njest spokrewniona z Taihou.
Dialogue: 0,0:10:46.78,0:10:48.37,Default,Jinshi,0,0,0,,{\i1}Za panowania zmarłego cesarza
Dialogue: 0,0:10:48.37,0:10:50.99,Default,Jinshi,0,0,0,,{\i1}urodziła córkę po romansie z medykiem.
Dialogue: 0,0:10:53.69,0:10:56.07,Default,Jinshi,0,0,0,,{\i1}Jeśli jej córka żyje...
Dialogue: 0,0:11:02.29,0:11:03.56,Default,Gaoshun,0,0,0,,Dokąd idziesz?
Dialogue: 0,0:11:03.56,0:11:04.67,Default,Jinshi,0,0,0,,Do Granatowego Pałacu.
Dialogue: 0,0:11:13.89,0:11:17.77,Default,Jinshi,0,0,0,,{\i1}Konkubina, której służyła Taihou,\Nzostała później oddana Shishou.
Dialogue: 0,0:11:17.77,0:11:19.10,Default,Jinshi,0,0,0,,{\i1}Urodziła mu córkę.
Dialogue: 0,0:11:19.79,0:11:21.95,Default,Jinshi,0,0,0,,{\i1}Jest nią konkubina Loulan.
Dialogue: 0,0:11:22.61,0:11:26.81,Default,Jinshi,0,0,0,,{\i1}Jeśli chodzi o córkę Taihou i medyka,
Dialogue: 0,0:11:27.79,0:11:30.54,Default,Jinshi,0,0,0,,{\i1}nie ma żadnych wieści,\Nco stało się z nią i medykiem,
Dialogue: 0,0:11:31.20,0:11:33.10,Default,Jinshi,0,0,0,,{\i1}wyrzuconym z wewnętrznego pałacu.
Dialogue: 0,0:11:42.98,0:11:47.88,Default,Jinshi,0,0,0,,{\i1}Może konkubina Loulan wie,\Ndokąd oni się udali.
Dialogue: 0,0:11:49.64,0:11:54.34,Default,Jinshi,0,0,0,,{\i1}To tylko przeczucie. Nie wiadomo,\Nczy istnieją jakiekolwiek powiązania.
Dialogue: 0,0:11:55.05,0:11:56.06,Default,Jinshi,0,0,0,,{\i1}Ale i tak...
Dialogue: 0,0:11:58.51,0:11:59.36,Default,Lady-in-Waiting A,0,0,0,,Proszę.
Dialogue: 0,0:12:00.67,0:12:04.17,Default,Jinshi,0,0,0,,{\i1}Zrobię wszystko,\Nco w mojej mocy.
Dialogue: 0,0:12:10.45,0:12:12.81,Default,Jinshi,0,0,0,,Przepraszam za tak nagłą wizytę.
Dialogue: 0,0:12:16.84,0:12:19.30,Default,Head Lady-in-Waiting,0,0,0,,Nie ma nic przeciwko.
Dialogue: 0,0:12:19.89,0:12:21.36,Default,Jinshi,0,0,0,,Dziękuję.
Dialogue: 0,0:12:22.69,0:12:25.29,Default,Jinshi,0,0,0,,{\i1}Dziwne, jak zawsze.
Dialogue: 0,0:12:25.29,0:12:29.56,Default,Jinshi,0,0,0,,{\i1}Krzykliwe stroje i wyrazisty makijaż\Nz mocnymi kreskami w kącikach oczu...
Dialogue: 0,0:12:30.87,0:12:32.56,Default,Jinshi,0,0,0,,{\i1}Wyglądają jak szczwane lisice.
Dialogue: 0,0:12:33.66,0:12:36.69,Default,Jinshi,0,0,0,,Mam do ciebie pytanie...
Dialogue: 0,0:12:40.20,0:12:40.94,Default,Gaoshun,0,0,0,,Panie Jinshi?
Dialogue: 0,0:12:43.48,0:12:44.36,Default,Head Lady-in-Waiting,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:12:47.73,0:12:50.33,Default,Jinshi,0,0,0,,Kiedyś miałaś siedem dwórek, prawda?
Dialogue: 0,0:12:50.82,0:12:52.59,Default,Jinshi,0,0,0,,Gdzie zniknęła jedna z nich?
Dialogue: 0,0:12:54.02,0:12:58.95,Default,Jinshi,0,0,0,,Pamiętam twarze i imiona\Nwszystkich pracujących tu dwórek.
Dialogue: 0,0:12:59.87,0:13:03.82,Default,Jinshi,0,0,0,,Codziennie zmieniacie stroje i makijaże,
Dialogue: 0,0:13:04.34,0:13:07.39,Default,Jinshi,0,0,0,,więc zapamiętałem cechy,\Nktóre łatwo zauważyć.
Dialogue: 0,0:13:07.71,0:13:11.91,Default,Jinshi,0,0,0,,Na przykład kształt ust czy oczu,
Dialogue: 0,0:13:12.82,0:13:14.25,Default,Jinshi,0,0,0,,a także...
Dialogue: 0,0:13:16.20,0:13:17.74,Default,Jinshi,0,0,0,,Położenie pieprzyków.
Dialogue: 0,0:13:19.38,0:13:22.86,Default,Jinshi,0,0,0,,Sourin... nie, Renpu, zgadza się?
Dialogue: 0,0:13:23.43,0:13:24.81,Default,Jinshi,0,0,0,,Tak się nazywasz.
Dialogue: 0,0:13:27.75,0:13:30.04,Default,Jinshi,0,0,0,,Od początku było to zaplanowane, prawda?
Dialogue: 0,0:13:30.67,0:13:32.94,Default,Jinshi,0,0,0,,Sprowadzanie ogromnej liczby służek,
Dialogue: 0,0:13:32.94,0:13:35.54,Default,Jinshi,0,0,0,,wyglądających identycznie,\Nby jej służyły...
Dialogue: 0,0:13:35.99,0:13:39.35,Default,Jinshi,0,0,0,,Dziwaczne stroje i makijaże.
Dialogue: 0,0:13:39.99,0:13:42.59,Default,Jinshi,0,0,0,,Tylko po to.
Dialogue: 0,0:13:43.61,0:13:44.50,Default,Sourin,0,0,0,,P-panie Jinshi...
Dialogue: 0,0:13:44.50,0:13:45.13,Default,Jinshi,0,0,0,,Gadaj!
Dialogue: 0,0:13:45.86,0:13:47.99,Default,Jinshi,0,0,0,,Gdzie ona jest?
Dialogue: 0,0:13:50.58,0:13:52.46,Default,Jinshi,0,0,0,,Dokąd poszła?
Dialogue: 0,0:13:56.35,0:13:58.31,Default,Jinshi,0,0,0,,Gdzie polazła konkubina Loulan?!
Dialogue: 0,0:13:59.19,0:14:01.06,Default,Head Lady-in-Waiting,0,0,0,,Proszę, wybacz jej!
Dialogue: 0,0:14:01.33,0:14:04.32,Default,Head Lady-in-Waiting,0,0,0,,Renpu naprawdę nic nie wie.
Dialogue: 0,0:14:05.72,0:14:08.94,Default,Head Lady-in-Waiting,0,0,0,,Proszę, wybacz jej...
Dialogue: 0,0:14:17.99,0:14:20.41,Default,Jinshi,0,0,0,,{\i1}Cholera. Uspokój się.
Dialogue: 0,0:14:23.58,0:14:26.55,Default,Jinshi,0,0,0,,Więc nie powiedziała ci,\Ndokąd idzie?
Dialogue: 0,0:14:27.08,0:14:29.98,Default,Head Lady-in-Waiting,0,0,0,,Nie. Jedynie to, że już nie wróci.
Dialogue: 0,0:14:30.58,0:14:34.78,Default,Jinshi,0,0,0,,Konkubina wysokiej rangi z własnej\Nwoli opuściła wewnętrzny pałac.
Dialogue: 0,0:14:50.29,0:14:52.72,Default,Jinshi,0,0,0,,{\i1}Dalsze przesłuchiwanie nie ma sensu.
Dialogue: 0,0:14:56.66,0:14:58.65,Default,Gaoshun,0,0,0,,Każdy, kto mógł,\Nwyruszył na poszukiwania,
Dialogue: 0,0:14:58.65,0:15:01.13,Default,Gaoshun,0,0,0,,ale nie odnaleźli jeszcze\Nkonkubiny Loulan.
Dialogue: 0,0:15:01.95,0:15:04.26,Default,Jinshi,0,0,0,,Nie musisz już nazywać jej „konkubiną”.
Dialogue: 0,0:15:05.95,0:15:08.38,Default,Jinshi,0,0,0,,Opuszczenie wewnętrznego pałacu\Njest poważnym przestępstwem.
Dialogue: 0,0:15:08.78,0:15:10.94,Default,Jinshi,0,0,0,,Zwłaszcza dla konkubiny wysokiej rangi.
Dialogue: 0,0:15:12.31,0:15:14.64,Default,Jinshi,0,0,0,,Zaplanowała to, wiedząc o tym.
Dialogue: 0,0:15:15.05,0:15:16.00,Default,Gaoshun,0,0,0,,Tak...
Dialogue: 0,0:15:17.19,0:15:20.44,Default,Jinshi,0,0,0,,{\i1}Sprowadzenie córki urzędnika wysokiej\Nrangi do wewnętrznego pałacu
Dialogue: 0,0:15:20.78,0:15:23.06,Default,Jinshi,0,0,0,,{\i1}to transakcja korzystna również dla cesarza.
Dialogue: 0,0:15:23.91,0:15:28.54,Default,Jinshi,0,0,0,,{\i1}Łapie je jako zakładniczki do złotej klatki,\Nczyli wewnętrznego pałacu.
Dialogue: 0,0:15:30.02,0:15:33.78,Default,Jinshi,0,0,0,,{\i1}Shishou wyglądał,\Njakby zależało mu na córce.
Dialogue: 0,0:15:34.14,0:15:37.31,Default,Jinshi,0,0,0,,{\i1}Ale kto wie, co naprawdę czuł.
Dialogue: 0,0:15:40.53,0:15:43.17,Default,Jinshi,0,0,0,,{\i1}Zastanawiam się,\Njak to było z Maomao.
Dialogue: 0,0:15:44.25,0:15:47.98,Default,Jinshi,0,0,0,,{\i1}Mówiła kiedyś, że to jak próba\Nrzucenia palenia przez kurtyzanę.
Dialogue: 0,0:15:49.49,0:15:51.53,Default,Jinshi,0,0,0,,{\i1}Czy poszła z nimi z własnej woli?
Dialogue: 0,0:15:52.23,0:15:55.30,Default,Jinshi,0,0,0,,{\i1}Nie. Gdyby tak było,\Nnie zostawiłaby tej kartki.
Dialogue: 0,0:15:56.26,0:15:59.39,Default,Jinshi,0,0,0,,{\i1}Gdzie poszła i dlaczego?
Dialogue: 0,0:16:05.34,0:16:06.52,Default,Lakan,0,0,0,,Co?
Dialogue: 0,0:16:06.90,0:16:08.72,Default,Lakan,0,0,0,,Maomao...
Dialogue: 0,0:16:08.72,0:16:10.65,Default,Lakan,0,0,0,,zaginęła?
Dialogue: 0,0:16:16.59,0:16:19.45,Default,Lakan,0,0,0,,Czekaj na mnie, Maomao!
Dialogue: 0,0:16:20.37,0:16:24.90,Default,Lakan,0,0,0,,Tatuś cię uratuje!
Dialogue: 0,0:16:27.10,0:16:29.75,Default,Onsou,0,0,0,,Panie Lakan!
Dialogue: 0,0:16:31.39,0:16:33.30,Default,Jinshi,0,0,0,,Jak się o tym dowiedział?
Dialogue: 0,0:16:33.30,0:16:35.76,Default,Basen,0,0,0,,Ktoś musiał się dowiedzieć.
Dialogue: 0,0:16:38.09,0:16:41.61,Default,Basen,0,0,0,,Ponadto Shishou zniknął.
Dialogue: 0,0:16:42.44,0:16:44.85,Default,Basen,0,0,0,,Czy był w zmowie z Loulan?
Dialogue: 0,0:16:45.15,0:16:50.14,Default,Jinshi,0,0,0,,Nie wiem. Ale jest ojcem uciekinierki.
Dialogue: 0,0:16:50.14,0:16:53.90,Default,Jinshi,0,0,0,,Zostanie oskarżony o zbrodnię\Nprzeciwko cesarzowi.
Dialogue: 0,0:16:54.79,0:16:56.49,Default,Basen,0,0,0,,Rozumiem.
Dialogue: 0,0:16:57.05,0:17:00.58,Default,Basen,0,0,0,,Jeśli chodzi o wczorajszą dwórkę...\NShenlü.
Dialogue: 0,0:17:01.16,0:17:03.07,Default,Basen,0,0,0,,Jej życiu nic już nie zagraża.
Dialogue: 0,0:17:04.36,0:17:05.39,Default,Jinshi,0,0,0,,Obudziła się?
Dialogue: 0,0:17:06.11,0:17:07.67,Default,Basen,0,0,0,,Jeszcze nie.
Dialogue: 0,0:17:09.22,0:17:13.28,Default,Basen,0,0,0,,Udało nam się potwierdzić,\Nże miała powiązania z Taihou.
Dialogue: 0,0:17:13.87,0:17:16.73,Default,Basen,0,0,0,,Prawdopodobnie dlatego\Nwzięła udział w tej sprawie.
Dialogue: 0,0:17:17.66,0:17:19.35,Default,Jinshi,0,0,0,,Czy wszyscy z kliniki są w to zamieszani?
Dialogue: 0,0:17:20.22,0:17:21.14,Default,Basen,0,0,0,,Nie.
Dialogue: 0,0:17:22.38,0:17:26.26,Default,Basen,0,0,0,,Żadna z pozostałych osób\No tym nie wiedziała.
Dialogue: 0,0:17:29.71,0:17:35.11,Default,Jinshi,0,0,0,,{\i1}A jednak pomogli jej, pewnie dlatego, że wszystkie\Npodzielały urazę, jaką żywiła do nich Shenlü.
Dialogue: 0,0:17:36.36,0:17:38.30,Default,Jinshi,0,0,0,,{\i1}Po śmierci poprzedniego cesarza
Dialogue: 0,0:17:38.30,0:17:42.49,Default,Jinshi,0,0,0,,{\i1}ich gniew przeniósł się\Nna wewnętrzny pałac.
Dialogue: 0,0:17:46.45,0:17:51.16,Default,Jinshi,0,0,0,,{\i1}Muszę natychmiast znaleźć Loulan,\Nale brakuje mi informacji.
Dialogue: 0,0:17:51.65,0:17:53.82,Default,Jinshi,0,0,0,,{\i1}A może najpierw trzeba dopaść Shishou?
Dialogue: 0,0:17:54.92,0:17:57.80,Default,Jinshi,0,0,0,,{\i1}Nie, kto inny się tym zajmuje.
Dialogue: 0,0:18:03.87,0:18:04.97,Default,Basen,0,0,0,,Kto to może być?
Dialogue: 0,0:18:05.78,0:18:06.39,Default,Jinshi,0,0,0,,Zapraszam.
Dialogue: 0,0:18:08.33,0:18:09.94,Default,Lahan,0,0,0,,Przepraszam.
Dialogue: 0,0:18:20.69,0:18:21.95,Default,Jinshi,0,0,0,,{\i1}Liczydło?
Dialogue: 0,0:18:22.46,0:18:23.52,Default,Basen,0,0,0,,Czego chcesz?
Dialogue: 0,0:18:26.14,0:18:28.36,Default,Lahan,0,0,0,,Miło mi cię poznać.
Dialogue: 0,0:18:28.36,0:18:30.50,Default,Lahan,0,0,0,,Nazywam się Kan Lahan.
Dialogue: 0,0:18:31.88,0:18:37.30,Default,Jinshi,0,0,0,,{\i1}Na zewnętrznym dziedzińcu są tylko dwie\Nosoby z „La” w imieniu: Lakan i Lahan.
Dialogue: 0,0:18:37.97,0:18:40.96,Default,Jinshi,0,0,0,,{\i1}Jest to imię szlacheckie,\Ndawniej nadawane przez rodzinę cesarską.
Dialogue: 0,0:18:42.42,0:18:46.07,Default,Jinshi,0,0,0,,Członek rodziny La. Jesteś pewnie\Nadoptowanym synem stratega.
Dialogue: 0,0:18:46.07,0:18:47.16,Default,Jinshi,0,0,0,,Czego potrzebujesz?
Dialogue: 0,0:18:48.44,0:18:50.98,Default,Lahan,0,0,0,,Chciałem ci to pokazać.
Dialogue: 0,0:18:59.00,0:19:00.08,Default,Jinshi,0,0,0,,To jest...
Dialogue: 0,0:19:00.68,0:19:02.24,Default,Lahan,0,0,0,,Co o tym sądzisz?
Dialogue: 0,0:19:03.72,0:19:05.66,Default,Jinshi,0,0,0,,Rejestr przychodów cesarstwa.
Dialogue: 0,0:19:06.08,0:19:10.28,Default,Lahan,0,0,0,,Tak. Ojciec kazał mi się temu przyjrzeć.
Dialogue: 0,0:19:10.28,0:19:14.35,Default,Lahan,0,0,0,,Nie podobało mu się, że nie wiadomo,\Nskąd wziął się eruptor.
Dialogue: 0,0:19:14.76,0:19:16.46,Default,Jinshi,0,0,0,,Co mają wspólnego\Nz tym dochody cesarstwa?
Dialogue: 0,0:19:16.91,0:19:21.82,Default,Lahan,0,0,0,,Po śledztwie w sprawie niedawno ukaranych\Nurzędników było to zupełnie oczywiste.
Dialogue: 0,0:19:22.60,0:19:28.16,Default,Lahan,0,0,0,,Chciałem, byś zobaczył oryginalne zapisy,\Nale są one odrobinę długie.
Dialogue: 0,0:19:28.89,0:19:31.63,Default,Lahan,0,0,0,,Sporządziłem więc zestawienie\Nna podstawie tych najbardziej oczywistych.
Dialogue: 0,0:19:32.86,0:19:37.19,Default,Jinshi,0,0,0,,Cena zboża wyraźnie wzrosła\Nw ciągu ostatnich kilku lat.
Dialogue: 0,0:19:37.19,0:19:39.16,Default,Lahan,0,0,0,,Intrygujące, prawda?
Dialogue: 0,0:19:39.16,0:19:41.93,Default,Lahan,0,0,0,,Nie było suszy ani żadnych plag, nic a nic.
Dialogue: 0,0:19:42.44,0:19:46.66,Default,Lahan,0,0,0,,Co więcej, z jakiegoś powodu\Nwzrosła również cena żelaza.
Dialogue: 0,0:19:47.31,0:19:49.99,Default,Lahan,0,0,0,,Podobnie jak ceny\Nwszystkich metali w kraju.
Dialogue: 0,0:19:52.27,0:19:56.43,Default,Lahan,0,0,0,,Czyżbyśmy gdzieś budowali\Njakąś ogromną infrastrukturę?
Dialogue: 0,0:19:56.85,0:20:01.26,Default,Lahan,0,0,0,,Nie znalazłem nigdzie\Nplanów takiego projektu.
Dialogue: 0,0:20:01.90,0:20:05.04,Default,Jinshi,0,0,0,,{\i1}Jaki ojciec, taki syn.\NPrzebiegły i sprytny.
Dialogue: 0,0:20:06.12,0:20:07.76,Default,Jinshi,0,0,0,,Rozumiem, co usiłujesz przekazać.
Dialogue: 0,0:20:08.30,0:20:11.05,Default,Jinshi,0,0,0,,Sama cena zboża\Nnie jest niczym dziwnym,
Dialogue: 0,0:20:11.05,0:20:15.83,Default,Jinshi,0,0,0,,ale biorąc pod uwagę skalę obrotów,\Nten niewielki wzrost ceny robi ogromną różnicę.
Dialogue: 0,0:20:16.51,0:20:19.53,Default,Jinshi,0,0,0,,Ktoś zgarnia tę różnicę.
Dialogue: 0,0:20:20.10,0:20:25.51,Default,Jinshi,0,0,0,,Co więcej, cena metali oznacza,\Nże ktoś kupuje ich dużo.
Dialogue: 0,0:20:26.46,0:20:28.03,Default,Jinshi,0,0,0,,To sugerujesz, prawda?
Dialogue: 0,0:20:28.54,0:20:34.38,Default,Lahan,0,0,0,,Tak. Z tego, co sądzę,\Nprowadzi to do tego samego.
Dialogue: 0,0:20:34.38,0:20:39.20,Default,Lahan,0,0,0,,Niewielu jest ludzi,\Nktórzy byliby do tego zdolni.
Dialogue: 0,0:20:41.66,0:20:45.76,Default,Lahan,0,0,0,,Z chęcią przyjrzę się temu bliżej.
Dialogue: 0,0:20:47.10,0:20:52.51,Default,Lahan,0,0,0,,Czy nie warto wiedzieć,\Ndo kogo trafia to wszystko?
Dialogue: 0,0:21:00.10,0:21:02.07,Default,Jinshi,0,0,0,,Czego chcesz w zamian?
Dialogue: 0,0:21:04.55,0:21:07.85,Default,Jinshi,0,0,0,,Nie ma niczego za darmo, zgadza się?
Dialogue: 0,0:21:07.85,0:21:08.74,Default,Basen,0,0,0,,Panie Jinshi!
Dialogue: 0,0:21:10.88,0:21:17.02,Default,Lahan,0,0,0,,Mógłbyś dać mały rabacik na to?
Dialogue: 0,0:21:17.02,0:21:17.83,Default,Jinshi,0,0,0,,Co to?
Dialogue: 0,0:21:18.11,0:21:22.27,Default,Lahan,0,0,0,,Koszt naprawy zniszczonej bramy do\Nwewnętrznego pałacu przez mojego ojca.
Dialogue: 0,0:21:23.46,0:21:25.63,Default,Basen,0,0,0,,Powinien wypić piwo,\Nktórego naważył...
Dialogue: 0,0:21:26.01,0:21:26.93,Default,Jinshi,0,0,0,,Dobrze.
Dialogue: 0,0:21:26.93,0:21:28.39,Default,Basen,0,0,0,,Jesteś pewny?!
Dialogue: 0,0:21:31.11,0:21:33.84,Default,Jinshi,0,0,0,,Oczekuję, że będziesz skrupulatny.
Dialogue: 0,0:21:33.84,0:21:38.34,Default,Jinshi,0,0,0,,Dowiedz się, o co chodzi\Nz tymi pieniędzmi i metalem.
Dialogue: 0,0:21:42.71,0:21:44.65,Default,Lahan,0,0,0,,Wedle życzenia.
Dialogue: 0,0:21:46.65,0:21:50.11,Default,Jinshi,0,0,0,,{\i1}Wykorzystam, co tylko się da.
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Festiwal”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
