Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:31.72,0:01:34.50,Default,Gaoshun,0,0,0,,{\an8}Odnośnie dzisiejszych planów,
Dialogue: 0,0:01:33.36,0:01:36.36,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:34.50,0:01:36.57,Default,Gaoshun,0,0,0,,{\an8}po południu zaplanowana jest ceremonia.
Dialogue: 0,0:01:37.61,0:01:38.44,Default,Jinshi,0,0,0,,Tak...
Dialogue: 0,0:01:45.50,0:01:49.28,Default,Gaoshun,0,0,0,,Wiem co zaprząta ci głowę.
Dialogue: 0,0:01:49.28,0:01:51.53,Default,Gaoshun,0,0,0,,Ale proszę, nie zapominaj o pracy.
Dialogue: 0,0:01:52.82,0:01:54.34,Default,Jinshi,0,0,0,,Wiem.
Dialogue: 0,0:01:55.38,0:01:59.39,Default,Text,0,0,0,,{\an8}ODCINEK 19:\NPRZYPADEK CZY NIE?
Dialogue: 0,0:02:00.12,0:02:02.60,Default,Maomao,0,0,0,,Panie Lihaku, coś się stało?
Dialogue: 0,0:02:03.07,0:02:04.66,Default,Lihaku,0,0,0,,Mamy problem.
Dialogue: 0,0:02:05.22,0:02:07.06,Default,Maomao,0,0,0,,Czyżby jakieś tarapaty?
Dialogue: 0,0:02:07.43,0:02:10.50,Default,Lihaku,0,0,0,,Pamiętasz ten pożar w magazynie?
Dialogue: 0,0:02:10.50,0:02:11.15,Default,Maomao,0,0,0,,Ta.
Dialogue: 0,0:02:11.15,0:02:15.38,Default,Lihaku,0,0,0,,Okazało się, że tego samego dnia\Nktoś włamał się gdzie indziej.
Dialogue: 0,0:02:16.43,0:02:19.82,Default,Lihaku,0,0,0,,Założę się, że wykorzystali\Ndo tego tamtą sytuację.
Dialogue: 0,0:02:20.12,0:02:24.07,Default,Maomao,0,0,0,,Kradzież. Co ukradli?
Dialogue: 0,0:02:27.13,0:02:29.81,Default,Maomao,0,0,0,,Chyba nie do końca\Nmożna o tym głośno mówić.
Dialogue: 0,0:02:29.81,0:02:30.59,Default,Maomao,0,0,0,,Czmych.
Dialogue: 0,0:02:35.43,0:02:39.68,Default,Lihaku,0,0,0,,Przedmioty rytualne. I nie tylko to.
Dialogue: 0,0:02:39.68,0:02:42.09,Default,Maomao,0,0,0,,Tak słabo ich pilnowali?
Dialogue: 0,0:02:42.34,0:02:44.93,Default,Lihaku,0,0,0,,Nie mam pojęcia.
Dialogue: 0,0:02:45.40,0:02:48.48,Default,Lihaku,0,0,0,,Teraz żaden urzędnik ich nie pilnuje.
Dialogue: 0,0:02:48.48,0:02:50.85,Default,Lihaku,0,0,0,,Poprzedni zmarł w zeszłym roku.
Dialogue: 0,0:02:50.85,0:02:54.75,Default,Maomao,0,0,0,,A co z obecnym?\NChyba zna podstawy, prawda?
Dialogue: 0,0:02:54.75,0:02:58.86,Default,Lihaku,0,0,0,,Jakiś czas temu nabawił\Nsię zatrucia pokarmowego.
Dialogue: 0,0:02:59.17,0:03:00.50,Default,Maomao,0,0,0,,Zatrucia pokarmowego?
Dialogue: 0,0:03:01.00,0:03:05.09,Default,Lihaku,0,0,0,,Zatruł się swoimi ulubionymi wodorostami\Ni nadal nie odzyskał przytomności.
Dialogue: 0,0:03:05.09,0:03:09.30,Default,Lihaku,0,0,0,,I szybko chyba nie wróci.\NMamy przekichane, nie?
Dialogue: 0,0:03:09.30,0:03:11.56,Default,Maomao,0,0,0,,Chyba już gdzieś\Nsłyszałam tę historię.
Dialogue: 0,0:03:12.05,0:03:16.13,Default,Maomao,0,0,0,,Czy to ten urzędnik,\Nco lubi rzadkie potrawy?
Dialogue: 0,0:03:16.53,0:03:17.91,Default,Lihaku,0,0,0,,Skąd wiesz?
Dialogue: 0,0:03:18.35,0:03:19.84,Default,Maomao,0,0,0,,Dużo się wydarzyło.
Dialogue: 0,0:03:20.54,0:03:23.21,Default,Maomao,0,0,0,,Kradzież podczas pożaru.
Dialogue: 0,0:03:23.62,0:03:27.38,Default,Maomao,0,0,0,,Zwierzchnik magazynu\Nnieobecny z powodu zatrucia.
Dialogue: 0,0:03:28.14,0:03:30.18,Default,Maomao,0,0,0,,Zbyt podejrzane na zbieg okoliczności.
Dialogue: 0,0:03:31.14,0:03:34.86,Default,Maomao,0,0,0,,Kim był poprzednik obecnego\Nzwierzchnika magazynu?
Dialogue: 0,0:03:35.21,0:03:40.33,Default,Lihaku,0,0,0,,Cóż. Z tego co pamiętam, zawsze\Ntrzymał się ściśle ustalonych reguł.
Dialogue: 0,0:03:40.33,0:03:45.28,Default,Lihaku,0,0,0,,Nie pamiętam jak się nazywał. Wiem,\Nże lubił słodycze i takie tam, ale...
Dialogue: 0,0:03:45.94,0:03:49.45,Default,Maomao,0,0,0,,Czy to nie był przypadkiem pan Kounen?
Dialogue: 0,0:03:49.45,0:03:54.62,Default,Lihaku,0,0,0,,Tak, właśnie on!\NEj, skąd wiesz?
Dialogue: 0,0:03:54.62,0:03:56.00,Default,Maomao,0,0,0,,Dużo się wydarzyło.
Dialogue: 0,0:03:56.84,0:04:01.58,Default,Maomao,0,0,0,,Pan Jinshi wspominał o surowym\Nurzędniku, który uwielbiał słodycze.
Dialogue: 0,0:04:01.58,0:04:03.97,Default,Maomao,0,0,0,,Zmarł z powodu przedawkowania soli.
Dialogue: 0,0:04:04.63,0:04:07.70,Default,Maomao,0,0,0,,To wszystko zbieg okoliczności?
Dialogue: 0,0:04:07.70,0:04:10.06,Default,Maomao,0,0,0,,Choć każda sprawa\Nwyglądała na wypadek,
Dialogue: 0,0:04:10.06,0:04:15.19,Default,Maomao,0,0,0,,mogło też zostać ukartowane,\Nby osiągnąć jakiś cel...
Dialogue: 0,0:04:15.66,0:04:18.34,Default,Maomao,0,0,0,,Co więc mam dla ciebie zrobić?
Dialogue: 0,0:04:18.34,0:04:20.26,Default,Lihaku,0,0,0,,Racja! Najważniejsze.
Dialogue: 0,0:04:20.26,0:04:22.65,Default,Lihaku,0,0,0,,To ty wtedy znalazłaś tę fajkę.
Dialogue: 0,0:04:23.55,0:04:25.42,Default,Maomao,0,0,0,,A, tak, po pożarze.
Dialogue: 0,0:04:25.78,0:04:29.98,Default,Lihaku,0,0,0,,Chciałem ją oddać,\Nale wartownik odmówił.
Dialogue: 0,0:04:29.98,0:04:31.04,Default,Lihaku,0,0,0,,Nie chce już tego.
Dialogue: 0,0:04:31.58,0:04:35.80,Default,Maomao,0,0,0,,Wydaje się drogie.\NMyślałam, że to coś ważnego.
Dialogue: 0,0:04:35.80,0:04:39.22,Default,Lihaku,0,0,0,,Podobno dostał ją\Nod jakiejś przypadkowej dwórki.
Dialogue: 0,0:04:39.22,0:04:40.80,Default,Maomao,0,0,0,,Dwórki?
Dialogue: 0,0:04:40.80,0:04:42.85,Default,Lihaku,0,0,0,,Brzmi dziwnie, prawda?
Dialogue: 0,0:04:42.85,0:04:46.15,Default,Lihaku,0,0,0,,Czemu ktoś miałby to dać\Nprzypadkowemu wartownikowi?
Dialogue: 0,0:04:48.42,0:04:52.64,Default,Lihaku,0,0,0,,Ponoć strażnik odprowadził\Ndwórkę do bramy,
Dialogue: 0,0:04:52.92,0:04:55.55,Default,Lihaku,0,0,0,,gdy ta samotnie przemierzała ciemności.
Dialogue: 0,0:04:56.13,0:04:59.69,Default,Lihaku,0,0,0,,Podarowała mu tę fajkę\Njako wyraz wdzięczności.
Dialogue: 0,0:04:59.99,0:05:05.20,Default,Maomao,0,0,0,,Tak drogi prezent zapewne skusił\Ngo do szybkiego jego przetestowania.
Dialogue: 0,0:05:06.14,0:05:09.08,Default,Maomao,0,0,0,,Celowy pożar dla odwrócenia\Nuwagi wartownika,
Dialogue: 0,0:05:09.08,0:05:11.24,Default,Maomao,0,0,0,,by włamać się do magazynu.
Dialogue: 0,0:05:11.24,0:05:16.11,Default,Maomao,0,0,0,,Jeśli to po to dwórka\Ndała strażnikowi fajkę...
Dialogue: 0,0:05:17.03,0:05:19.42,Default,Maomao,0,0,0,,Panie Lihaku, co do tej dwórki...
Dialogue: 0,0:05:19.42,0:05:22.43,Default,Lihaku,0,0,0,,Próbowałem ustalić\Njakieś konkrety na jej temat.
Dialogue: 0,0:05:22.85,0:05:25.88,Default,Lihaku,0,0,0,,Kobieta miała jednak twarz\Nzasłoniętą szalikiem.
Dialogue: 0,0:05:26.53,0:05:30.90,Default,Maomao,0,0,0,,Może celowo ukryła swoją twarz.
Dialogue: 0,0:05:30.90,0:05:31.89,Default,Lihaku,0,0,0,,Może.
Dialogue: 0,0:05:31.89,0:05:37.21,Default,Lihaku,0,0,0,,Była dość wysoka jak na kobietę\Ni czuć było od niej zapach ziół.
Dialogue: 0,0:05:38.51,0:05:42.16,Default,Lihaku,0,0,0,,Po wzroście wiem, że to nie ty.
Dialogue: 0,0:05:42.16,0:05:43.66,Default,Lihaku,0,0,0,,Kojarzysz kogoś jeszcze?
Dialogue: 0,0:05:45.23,0:05:49.11,Default,Maomao,0,0,0,,Wysoka kobieta pachnąca ziołami...
Dialogue: 0,0:05:50.33,0:05:52.70,Default,Luomen,0,0,0,,Nie wygłaszaj opinii\Nna podstawie domysłów.
Dialogue: 0,0:05:54.35,0:05:59.58,Default,Maomao,0,0,0,,Czy oprócz tych wydarzeń\Nwydarzyło się coś jeszcze?
Dialogue: 0,0:06:00.10,0:06:03.34,Default,Lihaku,0,0,0,,Nie wiem. Ciężko stwierdzić...
Dialogue: 0,0:06:03.89,0:06:06.49,Default,Lihaku,0,0,0,,Sądzisz, że coś się za tym kryje?
Dialogue: 0,0:06:06.49,0:06:08.59,Default,Maomao,0,0,0,,Może tak.
Dialogue: 0,0:06:09.26,0:06:11.53,Default,Maomao,0,0,0,,A może nie.
Dialogue: 0,0:06:11.53,0:06:12.76,Default,Lihaku,0,0,0,,Zdecyduj się.
Dialogue: 0,0:06:15.77,0:06:18.94,Default,Maomao,0,0,0,,Czasami zdarzają się\Ndwa zbiegi okoliczności.
Dialogue: 0,0:06:19.75,0:06:22.25,Default,Maomao,0,0,0,,Nawet trzy na raz nie należą do rzadkości.
Dialogue: 0,0:06:23.25,0:06:25.94,Default,Maomao,0,0,0,,Ale kiedy kilka z nich się kumuluje
Dialogue: 0,0:06:26.27,0:06:28.55,Default,Maomao,0,0,0,,i wyraźnie stają się świadome...
Dialogue: 0,0:06:29.45,0:06:34.45,Default,Maomao,0,0,0,,Co jeśli zjawiłaby się tu postać\Npasująca do opisu wysokiej dwórki?
Dialogue: 0,0:06:36.59,0:06:41.71,Default,Maomao,0,0,0,,Więc nawet jeśli pojawi się imię Suirei,\Nnie będzie to miało ze mną nic wspólnego.
Dialogue: 0,0:06:43.07,0:06:47.40,Default,Lihaku,0,0,0,,Rany, jednak jesteś mądrzejsza,\Nniż wyglądasz!
Dialogue: 0,0:06:48.33,0:06:53.69,Default,Maomao,0,0,0,,Z kolei pan jest takim osiłkiem,\Njak myślałam. Proszę sobie darować.
Dialogue: 0,0:06:56.72,0:06:58.60,Default,Jinshi,0,0,0,,Dobrze się bawicie, co?
Dialogue: 0,0:06:59.80,0:07:01.85,Default,Jinshi,0,0,0,,Dobrze się bawicie, co?
Dialogue: 0,0:07:02.89,0:07:05.11,Default,Maomao,0,0,0,,Nie ma tu nic zabawnego.
Dialogue: 0,0:07:05.72,0:07:07.59,Default,Lihaku,0,0,0,,Na mnie czas!
Dialogue: 0,0:07:11.82,0:07:14.96,Default,Jinshi,0,0,0,,Całkiem blisko jesteś z tym oficerem.
Dialogue: 0,0:07:14.96,0:07:15.91,Default,Maomao,0,0,0,,Poważnie?
Dialogue: 0,0:07:16.26,0:07:21.00,Default,Maomao,0,0,0,,Wpadł tylko pogadać\Nze mną o swoich problemach.
Dialogue: 0,0:07:22.37,0:07:26.93,Default,Maomao,0,0,0,,Bez wątpienia nie ma to nic\Nwspólnego z panem Jinshi.
Dialogue: 0,0:07:29.22,0:07:32.05,Default,Maomao,0,0,0,,Pozwolisz, że przybliżę okoliczności?
Dialogue: 0,0:07:34.62,0:07:37.14,Default,Jinshi,0,0,0,,Rzeczywiście dziwny zbieg okoliczności.
Dialogue: 0,0:07:37.14,0:07:38.06,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:07:38.55,0:07:40.77,Default,Jinshi,0,0,0,,Jak myślisz, co się za tym kryje?
Dialogue: 0,0:07:41.08,0:07:42.40,Default,Maomao,0,0,0,,Nie mam pojęcia.
Dialogue: 0,0:07:42.40,0:07:45.26,Default,Maomao,0,0,0,,Żaden z tych przypadków\Nnie jest pewniakiem.
Dialogue: 0,0:07:45.26,0:07:50.53,Default,Maomao,0,0,0,,To raczej jak zastawienie kilku pułapek\Nw nadziei, że chociaż jedna zadziała.
Dialogue: 0,0:07:50.78,0:07:54.41,Default,Jinshi,0,0,0,,Myślisz, że istnieją inne zasadzki?
Dialogue: 0,0:07:54.87,0:07:57.25,Default,Maomao,0,0,0,,Ciężko określić.
Dialogue: 0,0:07:57.25,0:08:01.57,Default,Maomao,0,0,0,,Ustalenie, które z nich są przypadkowe,\Na które ukartowane, nie jest proste.
Dialogue: 0,0:08:01.57,0:08:05.55,Default,Maomao,0,0,0,,Chociaż nadal istnieje możliwość,\Nże to tylko zbieg okoliczności.
Dialogue: 0,0:08:09.41,0:08:10.63,Default,Jinshi,0,0,0,,Nie jesteś podniecona?
Dialogue: 0,0:08:11.29,0:08:12.33,Default,Maomao,0,0,0,,Podniecona?
Dialogue: 0,0:08:15.51,0:08:20.14,Default,Maomao,0,0,0,,Jestem tylko służką.\NRobię to, co mi każą.
Dialogue: 0,0:08:20.14,0:08:21.71,Default,Jinshi,0,0,0,,Ta.
Dialogue: 0,0:08:23.43,0:08:25.15,Default,Jinshi,0,0,0,,W takim razie co ty na to?
Dialogue: 0,0:08:26.36,0:08:30.11,Default,Jinshi,0,0,0,,Pewnego dnia udałem się do handlarza.
Dialogue: 0,0:08:30.41,0:08:33.02,Default,Jinshi,0,0,0,,Mówił o ciekawym towarze w magazynie.
Dialogue: 0,0:08:35.11,0:08:37.74,Default,Text,0,0,0,,{\an8}BEZOAR
Dialogue: 0,0:08:35.49,0:08:37.74,Default,Jinshi,0,0,0,,Tak chyba się to nazywało.
Dialogue: 0,0:08:38.90,0:08:41.66,Default,Maomao,0,0,0,,Bezoar, leczniczy kamień żółciowy z krówki!
Dialogue: 0,0:08:41.66,0:08:45.54,Default,Maomao,0,0,0,,To wyjątkowe lekarstwo\Nto jak wygrana w totka!
Dialogue: 0,0:08:45.54,0:08:48.25,Default,Maomao,0,0,0,,Dasz mi to?!
Dialogue: 0,0:08:48.25,0:08:49.09,Default,Maomao,0,0,0,,Serio?!
Dialogue: 0,0:08:48.25,0:08:49.09,Default,Text,0,0,0,,{\an8}BEZOAR
Dialogue: 0,0:08:49.09,0:08:50.55,Default,Maomao,0,0,0,,Chyba nie kłamiesz!
Dialogue: 0,0:08:49.09,0:08:50.55,Default,Text,0,0,0,,{\an8}BEZOAR
Dialogue: 0,0:08:53.83,0:08:54.68,Default,Jinshi,0,0,0,,Chcesz tego?
Dialogue: 0,0:08:54.68,0:08:55.70,Default,Maomao,0,0,0,,Jeszcze jak!
Dialogue: 0,0:08:55.70,0:08:56.93,Default,Gaoshun,0,0,0,,Xiaomao.
Dialogue: 0,0:09:03.96,0:09:05.02,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:09:06.13,0:09:08.11,Default,Jinshi,0,0,0,,Widzę, że palisz się do pracy.
Dialogue: 0,0:09:08.11,0:09:10.07,Default,Maomao,0,0,0,,Poważnie mi to dasz?
Dialogue: 0,0:09:08.11,0:09:10.07,Default,Text,0,0,0,,{\an8}BEZOAR
Dialogue: 0,0:09:10.53,0:09:14.06,Default,Jinshi,0,0,0,,Jeśli dobrze się postarasz.\NBędę cię na bieżąco informować.
Dialogue: 0,0:09:14.06,0:09:15.07,Default,Maomao,0,0,0,,Zrozumiano.
Dialogue: 0,0:09:16.17,0:09:18.07,Default,Maomao,0,0,0,,Wedle życzenia, panie Jinshi!
Dialogue: 0,0:09:18.07,0:09:21.32,Default,Jinshi,0,0,0,,Dlatego, Gaoshun, zajmij się tym!
Dialogue: 0,0:09:26.84,0:09:28.92,Default,Maomao,0,0,0,,To incydent z tamtego dnia.
Dialogue: 0,0:09:29.23,0:09:32.85,Default,Maomao,0,0,0,,Urzędnik, który zatruł się wodorostami,\Npracował w Ministerstwie Ceremonii.
Dialogue: 0,0:09:33.57,0:09:38.67,Default,Maomao,0,0,0,,Z tego co kojarzę, zajmują się\Ntam chyba edukacją i dyplomacją?
Dialogue: 0,0:09:40.66,0:09:44.14,Default,Maomao,0,0,0,,Gdybym porządnie przyłożyła\Nsię do egzaminów na dwórkę...
Dialogue: 0,0:09:44.14,0:09:46.06,Default,Officer,0,0,0,,Zostawię to tutaj.
Dialogue: 0,0:09:47.64,0:09:49.07,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:09:49.07,0:09:53.39,Default,Officer,0,0,0,,Nie ma problemu. Nie wahaj się pytać,\Njeśli będziesz mieć jakieś pytania.
Dialogue: 0,0:09:53.39,0:09:56.12,Default,Maomao,0,0,0,,Czym zajmuje się ten dział?
Dialogue: 0,0:09:56.12,0:09:57.03,Default,Officer,0,0,0,,Co?
Dialogue: 0,0:09:58.26,0:10:00.82,Default,Officer,0,0,0,,Zajmują się ceremoniami.
Dialogue: 0,0:10:01.30,0:10:02.93,Default,Maomao,0,0,0,,Ceremoniami?
Dialogue: 0,0:10:06.67,0:10:08.58,Default,Maomao,0,0,0,,Ma pan coś do pisania?
Dialogue: 0,0:10:08.58,0:10:10.00,Default,Officer,0,0,0,,Co? Jasne.
Dialogue: 0,0:10:10.46,0:10:12.75,Default,Maomao,0,0,0,,Ceremonie, ceremonie...
Dialogue: 0,0:10:13.34,0:10:18.09,Default,Maomao,0,0,0,,Zarówno urzędnik dotknięty zatruciem\Ni pan Kounen byli związani z ceremoniami.
Dialogue: 0,0:10:18.09,0:10:23.22,Default,Maomao,0,0,0,,Jeśli zajście z fajką było próbą\Nkradzieży rytualnych przedmiotów...
Dialogue: 0,0:10:24.09,0:10:27.49,Default,Maomao,0,0,0,,Wszystkie te zbiegi okoliczności\Nsą ze sobą powiązane,
Dialogue: 0,0:10:27.49,0:10:29.98,Default,Maomao,0,0,0,,tworząc jakiś celowy rezultat.
Dialogue: 0,0:10:30.39,0:10:34.65,Default,Maomao,0,0,0,,Jeśli ktoś zadał sobie tyle trudu,\Nby ukraść rytualne przedmioty,
Dialogue: 0,0:10:34.65,0:10:37.14,Default,Maomao,0,0,0,,to musi być to jakaś\Nważniejsza ceremonia.
Dialogue: 0,0:10:38.20,0:10:40.07,Default,Maomao,0,0,0,,Średniej ub wyższej rangi.
Dialogue: 0,0:10:40.07,0:10:43.71,Default,Maomao,0,0,0,,Muszę się dowiedzieć,\Nkiedy odbywa się ta ceremonia.
Dialogue: 0,0:10:44.67,0:10:48.76,Default,Maomao,0,0,0,,Co więcej, pan Jinshi często brał\Nudział w rytuałach oczyszczających.
Dialogue: 0,0:10:48.76,0:10:52.74,Default,Officer,0,0,0,,Jeśli zainteresowały cię ceremonie,\Nmam dla ciebie coś odpowiedniego.
Dialogue: 0,0:10:56.93,0:10:59.53,Default,Maomao,0,0,0,,Czy to plan świątyni?
Dialogue: 0,0:10:59.53,0:11:04.17,Default,Officer,0,0,0,,Tak. Mieści się ona przy zachodnim murze\Npałacu, nazywana jest Ołtarzem Niebios.
Dialogue: 0,0:11:04.17,0:11:06.18,Default,Officer,0,0,0,,Całkiem interesujący projekt, nie sądzisz?
Dialogue: 0,0:11:07.48,0:11:10.47,Default,Officer,0,0,0,,Z sufitu zwisa ogromny słup.
Dialogue: 0,0:11:12.26,0:11:15.73,Default,Officer,0,0,0,,A nad głównym ołtarzem wiszą wstęgi.
Dialogue: 0,0:11:16.19,0:11:20.15,Default,Officer,0,0,0,,Zawsze obniżają słup,\Nna którym są słowa modlitwy.
Dialogue: 0,0:11:20.99,0:11:22.90,Default,Maomao,0,0,0,,Dużo pan wie.
Dialogue: 0,0:11:22.90,0:11:26.44,Default,Officer,0,0,0,,Tak. Wstyd się przyznać,\Nale nim zostałem przydzielony do archiwum,
Dialogue: 0,0:11:26.44,0:11:29.25,Default,Officer,0,0,0,,pracowałem w Ministerstwie Ceremonii.
Dialogue: 0,0:11:29.95,0:11:34.19,Default,Officer,0,0,0,,Raz odpyskowałem przełożonym\Ni zostałem zdegradowany do tej roli.
Dialogue: 0,0:11:35.56,0:11:40.83,Default,Officer,0,0,0,,Martwiłem się o wytrzymałość konstrukcji,\Nale na szczęście wszystko z nią dobrze.
Dialogue: 0,0:11:40.83,0:11:42.22,Default,Maomao,0,0,0,,O czym pan mówi?
Dialogue: 0,0:11:42.91,0:11:46.50,Default,Officer,0,0,0,,Widzisz, jak słup zwisa z sufitu, prawda?
Dialogue: 0,0:11:46.50,0:11:51.09,Default,Officer,0,0,0,,Jest spory, więc obawiałem się, że spadnie.
Dialogue: 0,0:11:51.09,0:11:53.23,Default,Officer,0,0,0,,Gdy wspomniałem\No kwestii wytrzymałości,
Dialogue: 0,0:11:53.56,0:11:56.35,Default,Officer,0,0,0,,odesłali mnie tutaj.
Dialogue: 0,0:11:57.51,0:11:59.74,Default,Maomao,0,0,0,,To faktycznie przerażające.
Dialogue: 0,0:12:00.12,0:12:05.86,Default,Maomao,0,0,0,,Jeśli metalowe bloczki, by pękły,\Nto słup spadłby z sufitu...
Dialogue: 0,0:12:07.10,0:12:11.29,Default,Maomao,0,0,0,,Osoba znajdująca się bezpośrednio\Npod nim, byłaby najbardziej zagrożona.
Dialogue: 0,0:12:11.72,0:12:14.35,Default,Maomao,0,0,0,,Bardzo ważna osobistość może zginąć.
Dialogue: 0,0:12:16.08,0:12:18.96,Default,Maomao,0,0,0,,Wytrzymałość... Wytrzymałość...
Dialogue: 0,0:12:19.27,0:12:23.09,Default,Maomao,0,0,0,,Czym w ogóle były te skradzione przedmioty?
Dialogue: 0,0:12:23.09,0:12:27.18,Default,Maomao,0,0,0,,Skoro zaginęło coś tak ważnego,\Nto na pewno przygotowali nowe.
Dialogue: 0,0:12:28.85,0:12:30.60,Default,Maomao,0,0,0,,Przygotowaliby nowe...
Dialogue: 0,0:12:32.39,0:12:33.49,Default,Maomao,0,0,0,,Przepraszam!
Dialogue: 0,0:12:33.49,0:12:36.61,Default,Maomao,0,0,0,,Kiedy odbywa się najbliższa ceremonia?!
Dialogue: 0,0:12:36.61,0:12:39.23,Default,Officer,0,0,0,,Kiedy? Cóż...
Dialogue: 0,0:12:39.23,0:12:40.70,Default,Officer,0,0,0,,W zasadzie to dzisiaj.
Dialogue: 0,0:12:49.82,0:12:54.50,Default,Maomao,0,0,0,,Jeśli moje przeczucia są trafne, to jest to\Nbardzo skrupulatnie przygotowany plan.
Dialogue: 0,0:12:56.71,0:12:58.90,Default,Maomao,0,0,0,,Nie każdy pomysł ma szansę wypalić.
Dialogue: 0,0:12:58.90,0:13:02.50,Default,Maomao,0,0,0,,Przy zastosowaniu kilku pułapek na raz\Nczęść z nich na pewno wypali
Dialogue: 0,0:13:02.50,0:13:05.13,Default,Maomao,0,0,0,,i nałoży się na siebie,\Naż w końcu doprowadzi to celu.
Dialogue: 0,0:13:09.39,0:13:12.58,Default,Maomao,0,0,0,,To tylko moje przypuszczenia.
Dialogue: 0,0:13:12.58,0:13:16.10,Default,Maomao,0,0,0,,Ale jeśli mam rację...
Dialogue: 0,0:13:19.00,0:13:20.05,Default,Maomao,0,0,0,,To tutaj!
Dialogue: 0,0:13:28.92,0:13:29.74,Default,Military Officer 1,0,0,0,,Ej!
Dialogue: 0,0:13:30.04,0:13:31.99,Default,Military Officer 1,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:13:33.24,0:13:34.37,Default,Maomao,0,0,0,,Przepuść mnie!
Dialogue: 0,0:13:34.84,0:13:35.87,Default,Military Officer 1,0,0,0,,Nie!
Dialogue: 0,0:13:35.87,0:13:37.39,Default,Maomao,0,0,0,,To nagły wypadek!
Dialogue: 0,0:13:37.39,0:13:41.00,Default,Military Officer 1,0,0,0,,Myślisz, że byle jaka służka\Nmoże przerwać trwającą ceremonię?
Dialogue: 0,0:13:42.86,0:13:47.61,Default,Maomao,0,0,0,,Ma całkowitą rację.\NJestem tylko nic nieznaczącą służącą.
Dialogue: 0,0:13:47.61,0:13:50.47,Default,Maomao,0,0,0,,Jednak jeśli nic nie zrobię,\Nto będzie za późno.
Dialogue: 0,0:13:51.17,0:13:53.94,Default,Maomao,0,0,0,,W najgorszym razie\Nczasu już nie cofniemy.
Dialogue: 0,0:13:55.24,0:13:59.33,Default,Maomao,0,0,0,,Istnieje zagrożenie życia.\NProszę, przerwij ceremonię.
Dialogue: 0,0:13:59.33,0:14:01.29,Default,Military Officer 1,0,0,0,,Nie ty o tym decydujesz.
Dialogue: 0,0:14:01.29,0:14:05.82,Default,Military Officer 1,0,0,0,,Jeśli chcesz złożyć skargę,\Ndaj to na piśmie.
Dialogue: 0,0:14:06.19,0:14:08.14,Default,Maomao,0,0,0,,Nie ma na to czasu!
Dialogue: 0,0:14:08.14,0:14:08.91,Default,Military Officer 1,0,0,0,,Nie!
Dialogue: 0,0:14:09.31,0:14:13.16,Default,Maomao,0,0,0,,Ołtarz posiada poważną wadę!
Dialogue: 0,0:14:13.16,0:14:16.04,Default,Maomao,0,0,0,,Są powody, by przypuszczać,\Nże ktoś przy nim dłubał!
Dialogue: 0,0:14:16.04,0:14:20.42,Default,Maomao,0,0,0,,Jeśli mnie nie przepuścisz, pożałujesz!
Dialogue: 0,0:14:20.69,0:14:25.22,Default,Maomao,0,0,0,,Jeśli pomimo wysłuchania\Nmoich ostrzeżeń nadal odrzucasz...
Dialogue: 0,0:14:25.87,0:14:29.55,Default,Maomao,0,0,0,,Rozumiem, więc o to chodzi!
Dialogue: 0,0:14:29.86,0:14:35.81,Default,Maomao,0,0,0,,Rozumiem. Utrudniasz mi przejście\Ni czekasz, aż dojdzie do wypadku!
Dialogue: 0,0:14:36.25,0:14:40.06,Default,Maomao,0,0,0,,To oznacza, że jesteś w zmowie\Nz ludźmi, którzy majstrowali przy...
Dialogue: 0,0:14:58.66,0:15:00.70,Default,Maomao,0,0,0,,Tracę przytomność.
Dialogue: 0,0:15:01.59,0:15:06.09,Default,Maomao,0,0,0,,To normalne, że się wkurzył, gdy jakaś\Ndziewucha tak do niego powiedziała.
Dialogue: 0,0:15:06.37,0:15:09.58,Default,Maomao,0,0,0,,To było celowe, więc nie ma sprawy.
Dialogue: 0,0:15:11.10,0:15:16.82,Default,Maomao,0,0,0,,To na nic. Takie zamieszanie\Nnie zakłóci ceremonii.
Dialogue: 0,0:15:17.74,0:15:22.22,Default,Maomao,0,0,0,,Wszystko dobrze.\NNie mogę teraz zemdleć.
Dialogue: 0,0:15:25.79,0:15:27.40,Default,Maomao,0,0,0,,Lepiej się poczułeś?
Dialogue: 0,0:15:30.61,0:15:31.91,Default,Maomao,0,0,0,,Proszę, przepuść mnie.
Dialogue: 0,0:15:34.86,0:15:38.15,Default,Maomao,0,0,0,,W środku jest osoba\No wysokiej randze, prawda?
Dialogue: 0,0:15:39.43,0:15:43.38,Default,Maomao,0,0,0,,Jeśli coś się stanie,\Npolecą wam głowy.
Dialogue: 0,0:15:44.35,0:15:47.00,Default,Maomao,0,0,0,,Nie będę prosić\No odwołanie ceremonii.
Dialogue: 0,0:15:47.89,0:15:50.57,Default,Maomao,0,0,0,,Proszę, przepuść mnie.
Dialogue: 0,0:15:51.21,0:15:53.82,Default,Maomao,0,0,0,,Powiesz, że przypadkiem\Nmysz weszła do środka.
Dialogue: 0,0:15:55.07,0:15:58.85,Default,Maomao,0,0,0,,Wtedy tylko ja poniosę karę!
Dialogue: 0,0:15:59.33,0:16:02.85,Default,Military Officer 1,0,0,0,,Niby czemu miałbym ufać\Nsłowom jakiejś gówniary?!
Dialogue: 0,0:16:02.85,0:16:06.02,Default,Lakan,0,0,0,,A moim uwierzysz?
Dialogue: 0,0:16:13.03,0:16:15.42,Default,Military Officer 1,0,0,0,,Pan jest...
Dialogue: 0,0:16:19.02,0:16:24.50,Default,Lakan,0,0,0,,Niby dlaczego miałbyś\Nuderzyć młodą dziewczynę, nie?
Dialogue: 0,0:16:26.14,0:16:28.67,Default,Lakan,0,0,0,,A jednak jest ranna.
Dialogue: 0,0:16:31.46,0:16:36.33,Default,Lakan,0,0,0,,W każdym razie może przesuniesz się\Ni zrobisz to, o co prosi dziewczyna?
Dialogue: 0,0:16:36.33,0:16:38.58,Default,Lakan,0,0,0,,Odpowiedzialność biorę na siebie.
Dialogue: 0,0:16:39.64,0:16:42.20,Default,Maomao,0,0,0,,Nie chcę patrzeć, kto stoi za mną.
Dialogue: 0,0:16:42.20,0:16:45.10,Default,Maomao,0,0,0,,Idealne wyczucie czasu,\Nzupełnie jakby z góry zaplanowane...
Dialogue: 0,0:16:45.10,0:16:48.59,Default,Maomao,0,0,0,,Nie, nie mogę się tym teraz przejmować.
Dialogue: 0,0:16:48.89,0:16:51.15,Default,Maomao,0,0,0,,Nieważne, do kogo należy ten głos.
Dialogue: 0,0:16:58.74,0:17:00.74,Default,Maomao,0,0,0,,Na pewno wyglądam okropnie.
Dialogue: 0,0:17:00.74,0:17:03.13,Default,Maomao,0,0,0,,Po wszystkim poproszę pana Gaoshuna,
Dialogue: 0,0:17:03.13,0:17:06.12,Default,Maomao,0,0,0,,żebym mogła wziąć długą kąpiel.
Dialogue: 0,0:17:06.97,0:17:08.20,Default,Maomao,0,0,0,,Ale najpierw
Dialogue: 0,0:17:09.26,0:17:11.72,Default,Maomao,0,0,0,,muszę uniknąć egzekucji.
Dialogue: 0,0:17:56.84,0:17:58.17,Default,Maomao,0,0,0,,Zdążyłam...
Dialogue: 0,0:18:05.51,0:18:06.99,Default,Maomao,0,0,0,,Potrzebny będzie szew.
Dialogue: 0,0:18:08.18,0:18:09.06,Default,Jinshi,0,0,0,,Ej.
Dialogue: 0,0:18:14.58,0:18:17.28,Default,Jinshi,0,0,0,,Co tu jest grane?
Dialogue: 0,0:18:18.67,0:18:20.11,Default,Maomao,0,0,0,,Panie Jinshi...
Dialogue: 0,0:18:22.34,0:18:24.70,Default,Maomao,0,0,0,,Czy teraz dostanę bezoar?
Dialogue: 0,0:18:26.57,0:18:28.50,Default,Jinshi,0,0,0,,To nie pora na to.
Dialogue: 0,0:18:30.54,0:18:34.29,Default,Jinshi,0,0,0,,Co się stało z twoją twarzą?
Dialogue: 0,0:18:36.27,0:18:40.45,Default,Maomao,0,0,0,,Dlaczego pan Jinshi tutaj jest?
Dialogue: 0,0:18:42.34,0:18:46.27,Default,Maomao,0,0,0,,Co to za mina?
Dialogue: 0,0:18:50.54,0:18:55.07,Default,Maomao,0,0,0,,Przepraszam, muszę założyć szew na...
Dialogue: 0,0:18:55.93,0:18:56.90,Default,Jinshi,0,0,0,,E-ej!
Dialogue: 0,0:18:58.41,0:19:00.37,Default,Jinshi,0,0,0,,Hej, pobudka!
Dialogue: 0,0:19:01.17,0:19:03.87,Default,Jinshi,0,0,0,,Otwórz oczyska! Hej!
Dialogue: 0,0:19:04.27,0:19:05.82,Default,Jinshi,0,0,0,,Ej, zostań ze mną.
Dialogue: 0,0:19:06.53,0:19:08.68,Default,Jinshi,0,0,0,,Ej! Ej!
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.09,0:22:50.05,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Bieluń”.
Dialogue: 0,0:22:46.09,0:22:50.05,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
