Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:35.69,0:01:36.78,Default,Guard,0,0,0,,Panienka Loulan.
Dialogue: 0,0:01:49.25,0:01:52.84,Default,Maomao,0,0,0,,{\i1}Najwyraźniej zioło życia\Nto eksperyment przeprowadzony
Dialogue: 0,0:01:52.84,0:01:55.21,Default,Maomao,0,0,0,,{\i1}przy okazji pracy nad\Neliksirem nieśmiertelności.
Dialogue: 0,0:01:56.10,0:01:59.68,Default,Maomao,0,0,0,,{\i1}Suirei naprawdę ożyła dzięki niemu.
Dialogue: 0,0:02:00.25,0:02:02.81,Default,Maomao,0,0,0,,{\i1}Poprzedni zielarz był naprawdę dobry.
Dialogue: 0,0:02:04.15,0:02:06.59,Default,Maomao,0,0,0,,{\i1}Ale Shenmei chce czegoś, co sprawi,
Dialogue: 0,0:02:06.59,0:02:10.76,Default,Maomao,0,0,0,,{\i1}że po jednym łyku z czarki\Nodmłodnieje o dziesięć lat.
Dialogue: 0,0:02:15.57,0:02:17.65,Default,Maomao,0,0,0,,Ciężki żywot, co, maluchy?
Dialogue: 0,0:02:19.58,0:02:23.80,Default,Maomao,0,0,0,,Ten lek nie istnieje. Wiem o tym, ale...
Dialogue: 0,0:02:25.07,0:02:27.96,Default,Maomao,0,0,0,,To również moja duma jako zielarki!
Dialogue: 0,0:02:50.15,0:02:52.57,Default,Maomao,0,0,0,,{\i1}Dni upływają spokojnie...
Dialogue: 0,0:02:55.11,0:02:56.69,Default,Girl B,0,0,0,,Poczekaj!
Dialogue: 0,0:02:57.09,0:03:00.54,Default,Lady-in-waiting,0,0,0,,Paniczu! Nie wolno tam chodzić!\NTyle razy to powtarzałam!
Dialogue: 0,0:03:00.54,0:03:02.07,Default,Kyou-u,0,0,0,,A kogo to obchodzi?
Dialogue: 0,0:03:04.10,0:03:06.35,Default,Maomao,0,0,0,,{\i1}Kolejny raz został skarcony.
Dialogue: 0,0:03:06.35,0:03:09.78,Default,Maomao,0,0,0,,{\i1}I tak znowu zawleką go do domu,\Nwięc po co się wysilać?
Dialogue: 0,0:03:12.39,0:03:14.75,Default,Maomao,0,0,0,,{\i1}Jednak ten zapach...
Dialogue: 0,0:03:14.75,0:03:17.25,Default,Maomao,0,0,0,,{\i1}Czy pod spodem jest jakiś warsztat?
Dialogue: 0,0:03:17.25,0:03:19.13,Default,Maomao,0,0,0,,{\i1}Jak ten w wiosce?
Dialogue: 0,0:03:22.66,0:03:24.92,Default,Maomao,0,0,0,,{\i1}Oby tylko nie wybuchło...
Dialogue: 0,0:03:30.04,0:03:31.06,Default,Maomao,0,0,0,,{\i1}A to co?
Dialogue: 0,0:03:34.29,0:03:35.47,Default,Maomao,0,0,0,,{\i1}Drut?
Dialogue: 0,0:03:36.03,0:03:39.03,Default,Maomao,0,0,0,,„Uciekaj, odwrócę uwagę strażnika”.
Dialogue: 0,0:03:39.47,0:03:42.14,Default,Maomao,0,0,0,,{\i1}Uciekać? Gdzie dokładnie?
Dialogue: 0,0:03:45.11,0:03:46.52,Default,Kyou-u,0,0,0,,— Puszczaj!\N— Proszę, paniczu!
Dialogue: 0,0:03:48.54,0:03:50.29,Default,Guard,0,0,0,,Ty go do tego namówiłaś?!
Dialogue: 0,0:03:52.70,0:03:55.31,Default,Maomao,0,0,0,,Odwrócić uwagę strażnika, co?
Dialogue: 0,0:03:57.17,0:04:01.09,Default,Text,0,0,0,,{\an8}ODCINEK 45: TAIBON
Dialogue: 0,0:04:00.27,0:04:02.58,Default,Suirei,0,0,0,,Co ty sobie myślałeś?
Dialogue: 0,0:04:03.01,0:04:04.64,Default,Kyou-u,0,0,0,,Nie wiem, o co ci chodzi.
Dialogue: 0,0:04:05.56,0:04:07.05,Default,Suirei,0,0,0,,Kazałaś mu to zrobić?
Dialogue: 0,0:04:07.88,0:04:09.47,Default,Maomao,0,0,0,,Nie wiem, o co ci chodzi.
Dialogue: 0,0:04:10.99,0:04:14.14,Default,Maomao,0,0,0,,{\i1}Chyba chciał mnie uratować.
Dialogue: 0,0:04:14.77,0:04:19.44,Default,Maomao,0,0,0,,{\i1}Choć był tylko głupi żart tego dzieciaka,\Ngdyby go przyłapano, byłoby kiepsko.
Dialogue: 0,0:04:22.67,0:04:24.84,Default,Kyou-u,0,0,0,,Ja się tylko tutaj bawiłem!
Dialogue: 0,0:04:24.84,0:04:27.38,Default,Kyou-u,0,0,0,,Sprawdzałem też,\Nczy strażnik się nie obija.
Dialogue: 0,0:04:27.38,0:04:28.47,Default,Guard,0,0,0,,Co?!
Dialogue: 0,0:04:28.87,0:04:30.34,Default,Suirei,0,0,0,,Serio?
Dialogue: 0,0:04:30.34,0:04:30.87,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:04:32.75,0:04:35.00,Default,Suirei,0,0,0,,Przestań zachowywać się podejrzliwie.
Dialogue: 0,0:04:35.61,0:04:36.46,Default,Kyou-u,0,0,0,,Jasne!
Dialogue: 0,0:04:36.46,0:04:38.54,Default,Guard,0,0,0,,Czekaj, naprawdę...
Dialogue: 0,0:04:39.00,0:04:42.59,Default,Suirei,0,0,0,,Nie rób z igły widły.\NWiesz, o co mi chodzi, prawda?
Dialogue: 0,0:04:44.38,0:04:45.64,Default,Guard,0,0,0,,Tak, rozumiem...
Dialogue: 0,0:04:48.33,0:04:52.50,Default,Maomao,0,0,0,,{\i1}Cieszę się, że Suirei była\Nw pobliżu. Sprawa załatwiona.
Dialogue: 0,0:04:52.50,0:04:53.40,Default,Shenmei,0,0,0,,Ojej?
Dialogue: 0,0:04:59.06,0:05:01.53,Default,Shenmei,0,0,0,,O co ta cała wrzawa?
Dialogue: 0,0:05:01.53,0:05:03.28,Default,Kyou-u,0,0,0,,Mamo!
Dialogue: 0,0:05:09.25,0:05:10.51,Default,Kyou-u,0,0,0,,Mamo...?
Dialogue: 0,0:05:11.20,0:05:13.22,Default,Suirei,0,0,0,,To nic takiego.
Dialogue: 0,0:05:13.22,0:05:18.97,Default,Shenmei,0,0,0,,Naprawdę? Ciekawi mnie,\Nczemu zielarka jest poza pokojem.
Dialogue: 0,0:05:18.97,0:05:23.21,Default,Suirei,0,0,0,,Kyou bawił się przed jej pokojem\Ni przeszkadzał strażnikowi.
Dialogue: 0,0:05:23.81,0:05:25.78,Default,Suirei,0,0,0,,Pytałam tylko, co się dzieje...
Dialogue: 0,0:05:25.78,0:05:30.21,Default,Shenmei,0,0,0,,Ojej! Więc byłeś niegrzeczny?
Dialogue: 0,0:05:30.21,0:05:34.52,Default,Shenmei,0,0,0,,Niedobrze. Teraz będę\Nmusiała cię ukarać.
Dialogue: 0,0:05:34.85,0:05:39.74,Default,Shenmei,0,0,0,,Kilka porządnych batów\Nw plecy załatwi sprawę, nie?
Dialogue: 0,0:05:42.61,0:05:44.40,Default,Suirei,0,0,0,,Pani Shenmei, to...
Dialogue: 0,0:05:44.89,0:05:45.69,Default,Shenmei,0,0,0,,Czego?
Dialogue: 0,0:05:47.51,0:05:49.63,Default,Suirei,0,0,0,,Kyou to tylko dziecko.
Dialogue: 0,0:05:49.63,0:05:53.20,Default,Suirei,0,0,0,,Poza tym nie zrobił nic,\Nco zasługiwałoby na...
Dialogue: 0,0:06:00.18,0:06:01.72,Default,Shenmei,0,0,0,,Rozumiem.
Dialogue: 0,0:06:01.72,0:06:06.92,Default,Shenmei,0,0,0,,Więc ktoś zrobił wielkie\Nhalo z niczego, tak?
Dialogue: 0,0:06:06.92,0:06:08.72,Default,Guard,0,0,0,,Nigdy w życiu!
Dialogue: 0,0:06:10.28,0:06:12.78,Default,Shenmei,0,0,0,,Czyż nie jest to jedyny możliwy wniosek?
Dialogue: 0,0:06:12.78,0:06:15.79,Default,Shenmei,0,0,0,,Może wizyta w wodnej\Nkomorze nauczyłaby cię czegoś.
Dialogue: 0,0:06:15.79,0:06:17.06,Default,Guard,0,0,0,,Błagam, nie!
Dialogue: 0,0:06:17.06,0:06:18.06,Default,Maomao,0,0,0,,{\i1}To niedorzeczne.
Dialogue: 0,0:06:18.44,0:06:20.85,Default,Maomao,0,0,0,,{\i1}Ona nie potrzebuje powodu.
Dialogue: 0,0:06:21.47,0:06:25.53,Default,Maomao,0,0,0,,{\i1}Chce tylko, by inni cierpieli.\NSprawia jej to nawet przyjemność.
Dialogue: 0,0:06:26.30,0:06:27.90,Default,Maomao,0,0,0,,{\i1}Mnie to nie dotyczy.
Dialogue: 0,0:06:27.90,0:06:31.28,Default,Maomao,0,0,0,,{\i1}Powinnam po prostu pozwolić, by Kyou\Ni strażnik dostali to, na co zasługują.
Dialogue: 0,0:06:33.14,0:06:33.78,Default,Maomao,0,0,0,,{\i1}Ale...
Dialogue: 0,0:06:34.79,0:06:36.29,Default,Maomao,0,0,0,,{\i1}Wnerwia mnie to.
Dialogue: 0,0:06:36.29,0:06:42.40,Default,Shenmei,0,0,0,,— No cóż. Chyba będę\Nmusiała ukarać was oboje.
Dialogue: 0,0:06:41.01,0:06:42.40,Default,Maomao,0,0,0,,{\an8}— Walnięta starucha.
Dialogue: 0,0:06:43.72,0:06:44.56,Default,Shenmei,0,0,0,,Co?
Dialogue: 0,0:06:48.34,0:06:49.47,Default,Shenmei,0,0,0,,Bezczelna dziewucha!
Dialogue: 0,0:06:51.53,0:06:54.10,Default,Maomao,0,0,0,,{\i1}Jestem idiotką.
Dialogue: 0,0:06:58.51,0:07:00.19,Default,Maomao,0,0,0,,Poprosiłam go, by to zrobił.
Dialogue: 0,0:07:00.50,0:07:01.31,Default,Shenmei,0,0,0,,Co?
Dialogue: 0,0:07:03.74,0:07:08.98,Default,Maomao,0,0,0,,Poprosiłam chłopca, by pomógł\Nmi uciec z tego więzienia.
Dialogue: 0,0:07:08.98,0:07:09.65,Default,Kyou-u,0,0,0,,Co?
Dialogue: 0,0:07:09.65,0:07:10.45,Default,Shenmei,0,0,0,,Ty!
Dialogue: 0,0:07:12.74,0:07:15.29,Default,Shenmei,0,0,0,,Ta zielarka jest nic nie warta.
Dialogue: 0,0:07:15.29,0:07:17.59,Default,Shenmei,0,0,0,,Niech zastanowi się\Nnad swoim zachowaniem.
Dialogue: 0,0:07:18.06,0:07:19.80,Default,Shenmei,0,0,0,,Wrzućcie ją do komory wodnej!
Dialogue: 0,0:07:20.85,0:07:23.32,Default,Maomao,0,0,0,,{\i1}Woda w taki mróz, co?
Dialogue: 0,0:07:23.32,0:07:25.63,Default,Maomao,0,0,0,,{\i1}Powinnam była trzymać gębę na kłódkę.
Dialogue: 0,0:07:25.63,0:07:29.16,Default,Suirei,0,0,0,,Będziemy musiały\Nszukać innego zielarza.
Dialogue: 0,0:07:29.99,0:07:35.35,Default,Shenmei,0,0,0,,Oj, Suirei? Czy ja się przesłyszałam?\NNa pewno to nic takiego.
Dialogue: 0,0:07:35.35,0:07:36.59,Default,Suirei,0,0,0,,Pani Shenmei...
Dialogue: 0,0:07:37.01,0:07:38.92,Default,Shenmei,0,0,0,,Nie ruszaj się bez pozwolenia.
Dialogue: 0,0:07:40.13,0:07:41.94,Default,Suirei,0,0,0,,Najmocniej przepraszam.
Dialogue: 0,0:07:42.65,0:07:43.61,Default,Suirei,0,0,0,,Ale...
Dialogue: 0,0:07:54.46,0:08:00.58,Default,Shenmei,0,0,0,,Odrobina brudu splami\Nnawet najszlachetniejszą krew.
Dialogue: 0,0:08:03.78,0:08:07.79,Default,Maomao,0,0,0,,{\i1}Może Suirei czuje się\Nodpowiedzialna na własny sposób.
Dialogue: 0,0:08:08.05,0:08:11.84,Default,Suirei,0,0,0,,{\i1}Nie chciałam cię tu przyprowadzać.
Dialogue: 0,0:08:12.90,0:08:14.71,Default,Maomao,0,0,0,,{\i1}Witamy w klubie idiotek.
Dialogue: 0,0:08:15.72,0:08:20.14,Default,Loulan,0,0,0,,Matko, chcę użyć czegoś innego.
Dialogue: 0,0:08:20.14,0:08:20.98,Default,Shenmei,0,0,0,,Innego?
Dialogue: 0,0:08:22.02,0:08:25.16,Default,Shenmei,0,0,0,,Ach, masz na myśli taibon.
Dialogue: 0,0:08:27.15,0:08:31.99,Default,Maomao,0,0,0,,{\i1}Taibon? Co to? Chyba już\Nkiedyś słyszałam tę nazwę.
Dialogue: 0,0:08:32.35,0:08:33.82,Default,Shenmei,0,0,0,,Cóż za wspaniały pomysł.
Dialogue: 0,0:08:33.82,0:08:37.82,Default,Shenmei,0,0,0,,Poprzednim razem,\Ngdy go użyłyśmy, zdziałał cuda.
Dialogue: 0,0:08:43.20,0:08:44.32,Default,Maomao,0,0,0,,{\i1}To znaczy?
Dialogue: 0,0:08:45.24,0:08:47.79,Default,Shenmei,0,0,0,,Zabierz tam tę zielarkę.
Dialogue: 0,0:09:00.46,0:09:01.43,Default,Guard,0,0,0,,To tutaj.
Dialogue: 0,0:09:07.79,0:09:10.31,Default,Maomao,0,0,0,,Co to za pokój?
Dialogue: 0,0:09:12.17,0:09:13.87,Default,Guard,0,0,0,,Nie miej mi tego za złe.
Dialogue: 0,0:09:14.36,0:09:18.49,Default,Guard,0,0,0,,Dziękuję za ratunek, ale muszę\Nwykonywać rozkazy pani Shenmei.
Dialogue: 0,0:09:28.95,0:09:30.02,Default,Maomao,0,0,0,,{\i1}Taibon.
Dialogue: 0,0:09:30.81,0:09:33.26,Default,Maomao,0,0,0,,{\i1}Racja, już wiem.
Dialogue: 0,0:09:37.90,0:09:41.31,Default,Maomao,0,0,0,,{\i1}To kara śmierci wymyślona przez\Nobłąkanego króla z czasów starożytnych.
Dialogue: 0,0:09:42.42,0:09:45.52,Default,Maomao,0,0,0,,{\i1}Zamknij więźnia w jamie,
Dialogue: 0,0:09:46.03,0:09:47.38,Default,Maomao,0,0,0,,{\i1}a następnie wrzuć do niej kilka...
Dialogue: 0,0:09:50.02,0:09:53.53,Default,Maomao,0,0,0,,Nic dziwnego, że Suirei tak boi się węży.
Dialogue: 0,0:09:59.88,0:10:05.19,Default,Maomao,0,0,0,,Rany, ale będzie zabawa!
Dialogue: 0,0:10:10.13,0:10:12.52,Default,Guard,0,0,0,,Dlaczego ja?
Dialogue: 0,0:10:13.66,0:10:16.59,Default,Guard,0,0,0,,Hę? Co to za zapaszek?
Dialogue: 0,0:10:17.10,0:10:18.64,Default,Guard,0,0,0,,Pachnie... pikantnie i smacznie?
Dialogue: 0,0:10:24.94,0:10:25.71,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:10:27.89,0:10:29.02,Default,Guard,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:10:32.04,0:10:34.09,Default,Maomao,0,0,0,,Masz może trochę soli?
Dialogue: 0,0:10:34.09,0:10:35.89,Default,Guard,0,0,0,,Jasne, że nie!
Dialogue: 0,0:10:35.89,0:10:37.62,Default,Guard,0,0,0,,Zaraz, czy to...
Dialogue: 0,0:10:37.62,0:10:38.32,Default,Maomao,0,0,0,,Wąż.
Dialogue: 0,0:10:40.32,0:10:44.54,Default,Guard,0,0,0,,Fuj. Załóżmy, że to ryba.
Dialogue: 0,0:10:44.54,0:10:46.63,Default,Guard,0,0,0,,Ale jak...
Dialogue: 0,0:10:47.67,0:10:50.89,Default,Maomao,0,0,0,,Użyłam spinek do włosów,\Nby go pokroić i upiekłam nad pochodnią.
Dialogue: 0,0:10:50.89,0:10:53.29,Default,Guard,0,0,0,,Jak możesz być taka opanowana?
Dialogue: 0,0:10:53.29,0:10:56.80,Default,Maomao,0,0,0,,Z powodu zbliżającej się hibernacji\Nwęże i owady były ospałe.
Dialogue: 0,0:10:57.37,0:11:00.67,Default,Maomao,0,0,0,,Profilaktycznie najpierw\Npozbyłam się tych jadowitych,
Dialogue: 0,0:11:00.67,0:11:04.11,Default,Maomao,0,0,0,,a z ziół, które miałam przy sobie,\Nzrobiłam preparat odstraszający.
Dialogue: 0,0:11:04.11,0:11:06.52,Default,Guard,0,0,0,,Po co tu przyszedłem?
Dialogue: 0,0:11:07.70,0:11:10.23,Default,Maomao,0,0,0,,Po co tu jesteś?
Dialogue: 0,0:11:11.08,0:11:13.36,Default,Guard,0,0,0,,Suirei i ten bachor prosili,\Nbym sprawdził, co u ciebie.
Dialogue: 0,0:11:14.13,0:11:16.36,Default,Guard,0,0,0,,Chcieli, bym ci pomógł.
Dialogue: 0,0:11:16.85,0:11:20.74,Default,Guard,0,0,0,,Bachor dał mi nawet jadeitową ozdobę.
Dialogue: 0,0:11:21.42,0:11:25.41,Default,Guard,0,0,0,,Tak czy inaczej,\Ndzięki tobie żyjemy.
Dialogue: 0,0:11:26.44,0:11:27.62,Default,Maomao,0,0,0,,Tych dwoje...
Dialogue: 0,0:11:28.84,0:11:31.69,Default,Guard,0,0,0,,Mam już dość tego miejsca.
Dialogue: 0,0:11:31.69,0:11:33.42,Default,Guard,0,0,0,,Pojawił się sygnał dymny.
Dialogue: 0,0:11:34.26,0:11:37.05,Default,Guard,0,0,0,,Podobno oznacza to, że siły\Nzbrojne nadchodzą z miasta.
Dialogue: 0,0:11:37.49,0:11:39.30,Default,Guard,0,0,0,,W twierdzy zapanował chaos.
Dialogue: 0,0:11:39.91,0:11:42.26,Default,Maomao,0,0,0,,— Przez co dostałem się tu bez problemu.\N— Ten zapach...
Dialogue: 0,0:11:42.67,0:11:44.20,Default,Guard,0,0,0,,Spadam stąd.
Dialogue: 0,0:11:44.77,0:11:48.18,Default,Guard,0,0,0,,Jeśli też chcesz wiać,\Ndaruj sobie schody po drugiej stronie.
Dialogue: 0,0:11:48.56,0:11:50.99,Default,Guard,0,0,0,,Ponoć w piwnicy produkują\Nproch strzelniczy.
Dialogue: 0,0:11:50.99,0:11:52.10,Default,Maomao,0,0,0,,Proch strzelniczy?
Dialogue: 0,0:11:52.41,0:11:55.98,Default,Guard,0,0,0,,Jest tam pełno ludu.\NJeśli dojdzie do eksplozji, możesz zginąć...
Dialogue: 0,0:11:55.98,0:11:59.48,Default,Maomao,0,0,0,,Dziękuję. Schody po drugiej stronie, tak?
Dialogue: 0,0:11:59.48,0:12:02.61,Default,Guard,0,0,0,,Hej, ostrzegałem cię!
Dialogue: 0,0:12:21.43,0:12:23.72,Default,Maomao,0,0,0,,{\i1}To pewnie stamtąd\Npochodzi ten zapach.
Dialogue: 0,0:12:24.45,0:12:27.22,Default,Maomao,0,0,0,,{\i1}Faktycznie wygląda na to,\Nże produkują proch, ale...
Dialogue: 0,0:12:28.12,0:12:31.75,Default,Maomao,0,0,0,,{\i1}Ten dym zatruwa ich wszystkich.
Dialogue: 0,0:12:32.18,0:12:35.99,Default,Maomao,0,0,0,,{\i1}Poza tym używanie ognia\Nw pobliżu prochu...
Dialogue: 0,0:12:37.18,0:12:38.19,Default,Maomao,0,0,0,,{\i1}Rany!
Dialogue: 0,0:12:40.37,0:12:41.15,Default,Maomao,0,0,0,,{\i1}To przecież...
Dialogue: 0,0:12:45.33,0:12:47.28,Default,Loulan,0,0,0,,Opuście to miejsce natychmiast!
Dialogue: 0,0:12:48.52,0:12:50.24,Default,Leader,0,0,0,,Panienko, dlaczego...
Dialogue: 0,0:12:50.71,0:12:53.40,Default,Loulan,0,0,0,,Armia niedługo nas zaatakuje.
Dialogue: 0,0:12:53.40,0:12:56.36,Default,Loulan,0,0,0,,Twierdza zamieni się\Nw pole bitwy i upadnie.
Dialogue: 0,0:12:56.36,0:12:57.58,Default,Loulan,0,0,0,,Ratuj się, kto może!
Dialogue: 0,0:13:00.75,0:13:01.70,Default,Worker A,0,0,0,,Srebro!
Dialogue: 0,0:13:11.71,0:13:13.65,Default,Leader,0,0,0,,P-panienko?
Dialogue: 0,0:13:13.65,0:13:14.89,Default,Loulan,0,0,0,,Ty też. Pospiesz się.
Dialogue: 0,0:13:19.27,0:13:20.57,Default,Loulan,0,0,0,,Szerokiej drogi!
Dialogue: 0,0:13:22.10,0:13:23.71,Default,Worker C,0,0,0,,W nogi!
Dialogue: 0,0:13:27.80,0:13:29.54,Default,Maomao,0,0,0,,{\i1}Poważka?!
Dialogue: 0,0:13:50.76,0:13:51.43,Default,Maomao,0,0,0,,Jest źle.
Dialogue: 0,0:13:53.59,0:13:54.56,Default,Maomao,0,0,0,,{\i1}Loulan...
Dialogue: 0,0:14:00.65,0:14:01.70,Default,Maomao,0,0,0,,Loulan!
Dialogue: 0,0:14:02.76,0:14:06.07,Default,Loulan,0,0,0,,Co?! Maomao, dlaczego tu jesteś?
Dialogue: 0,0:14:06.49,0:14:08.24,Default,Maomao,0,0,0,,Mogę cię zapytać o to samo.
Dialogue: 0,0:14:08.86,0:14:10.54,Default,Loulan,0,0,0,,Nic ci nie jest?
Dialogue: 0,0:14:10.54,0:14:14.22,Default,Loulan,0,0,0,,Wiedziałam, że poradzisz sobie z taibonem.
Dialogue: 0,0:14:14.65,0:14:15.76,Default,Maomao,0,0,0,,{\i1}Dobrze myślałaś.
Dialogue: 0,0:14:17.40,0:14:19.33,Default,Maomao,0,0,0,,Tak, było przepyszne.
Dialogue: 0,0:14:21.06,0:14:23.17,Default,Loulan,0,0,0,,Jesteś szalona, wiesz?
Dialogue: 0,0:14:23.69,0:14:26.46,Default,Maomao,0,0,0,,I mówi to ktoś,\Nkto chętnie zjada owady.
Dialogue: 0,0:14:30.46,0:14:31.80,Default,Maomao,0,0,0,,Wynośmy się stąd.
Dialogue: 0,0:14:32.33,0:14:35.10,Default,Maomao,0,0,0,,Wojsko nadchodzi. Pospieszmy się.
Dialogue: 0,0:14:40.62,0:14:41.86,Default,Loulan,0,0,0,,Ja nie idę.
Dialogue: 0,0:14:43.39,0:14:45.18,Default,Loulan,0,0,0,,Mam coś jeszcze do zrobienia.
Dialogue: 0,0:14:58.11,0:15:01.88,Default,Loulan,0,0,0,,Idziesz ze mną?\NTo najlepszy czas na ucieczkę.
Dialogue: 0,0:15:02.35,0:15:03.88,Default,Maomao,0,0,0,,Wiem, że wychodzę na idiotkę.
Dialogue: 0,0:15:04.26,0:15:06.75,Default,Loulan,0,0,0,,Jeśli matka się dowie,\Nsytuacja zmieni się drastycznie.
Dialogue: 0,0:15:06.75,0:15:09.22,Default,Loulan,0,0,0,,Biczowanie to będzie pikuś.
Dialogue: 0,0:15:09.72,0:15:13.22,Default,Maomao,0,0,0,,Myślałam, że jej na\Ntobie zależy, Loulan.
Dialogue: 0,0:15:17.85,0:15:22.28,Default,Loulan,0,0,0,,Matka ledwo pamięta moją twarz.
Dialogue: 0,0:15:23.25,0:15:28.35,Default,Loulan,0,0,0,,Byłam za mała, żeby cokolwiek wiedzieć,\Nkiedy po raz pierwszy zaczęli robić mi makijaż.
Dialogue: 0,0:15:29.37,0:15:32.32,Default,Loulan,0,0,0,,„Loulan” to tylko lalka mojej matki.
Dialogue: 0,0:15:33.51,0:15:37.45,Default,Loulan,0,0,0,,Ładna i posłuszna laleczka.
Dialogue: 0,0:15:38.30,0:15:39.20,Default,Loulan,0,0,0,,Więc...
Dialogue: 0,0:15:40.58,0:15:42.48,Default,Young Loulan,0,0,0,,{\i1}Siostrzyczko!
Dialogue: 0,0:15:42.48,0:15:44.06,Default,Young Suirei,0,0,0,,{\i1}Znowu tu jesteś?
Dialogue: 0,0:15:44.06,0:15:47.19,Default,Young Loulan,0,0,0,,{\i1}Pomogę ci! Popracujemy razem!
Dialogue: 0,0:15:47.81,0:15:49.54,Default,Shenmei,0,0,0,,{\i1}Dlaczego się obijasz?
Dialogue: 0,0:15:51.76,0:15:52.72,Default,Loulan,0,0,0,,{\i1}Matk—
Dialogue: 0,0:15:55.37,0:15:57.10,Default,Shenmei,0,0,0,,{\i1}Przynieś mi moją herbatę!
Dialogue: 0,0:15:58.71,0:16:02.60,Default,Loulan,0,0,0,,Matka nie rozpoznała\Nmnie w stroju służącej
Dialogue: 0,0:16:02.90,0:16:04.71,Default,Loulan,0,0,0,,i chłostała wachlarzem.
Dialogue: 0,0:16:05.15,0:16:09.36,Default,Loulan,0,0,0,,Jeśli przebieram się za służkę,\Nto nią jestem.
Dialogue: 0,0:16:10.17,0:16:12.80,Default,Maomao,0,0,0,,Ale i tak poszłaś zobaczyć Suirei.
Dialogue: 0,0:16:13.48,0:16:16.28,Default,Loulan,0,0,0,,Chciałam się z nią zaprzyjaźnić.
Dialogue: 0,0:16:18.18,0:16:22.06,Default,Loulan,0,0,0,,Matka zawsze znęcała się nad nią.
Dialogue: 0,0:16:22.60,0:16:27.55,Default,Loulan,0,0,0,,Założę się, że jej matka również była\Nzastraszana przez moją matkę i to ją zabiło.
Dialogue: 0,0:16:29.93,0:16:32.50,Default,Loulan,0,0,0,,Kiedy ojciec przyjął\Ndo rodziny moją siostrę,
Dialogue: 0,0:16:33.17,0:16:36.99,Default,Loulan,0,0,0,,matka wpadła w szał,\Naż włosy stawały dęba na głowie.
Dialogue: 0,0:16:37.71,0:16:40.89,Default,Loulan,0,0,0,,„I matka, i córka śmiały mnie obrazić”!
Dialogue: 0,0:16:40.89,0:16:43.89,Default,Loulan,0,0,0,,„Dziwka! Kto wie, co ona zrobi”?!
Dialogue: 0,0:16:45.69,0:16:47.27,Default,Loulan,0,0,0,,Myślałam, że trafiłam do piekła.
Dialogue: 0,0:16:48.35,0:16:49.85,Default,Maomao,0,0,0,,{\i1}Matka i córka...
Dialogue: 0,0:16:51.03,0:16:55.57,Default,Suirei,0,0,0,,{\i1}Kiedy później zwrócono\Nją w ramach prezentu,
Dialogue: 0,0:16:55.97,0:16:59.08,Default,Suirei,0,0,0,,{\i1}moja matka i ja\Nbyłyśmy już z ojcem.
Dialogue: 0,0:16:59.08,0:17:05.08,Default,Shenmei,0,0,0,,{\i1}Odrobina brudu splami\Nnawet najszlachetniejszą krew.
Dialogue: 0,0:17:06.44,0:17:08.46,Default,Maomao,0,0,0,,Czekaj, czy Suirei...?!
Dialogue: 0,0:17:09.66,0:17:14.26,Default,Loulan,0,0,0,,Słyszałaś plotkę o pierwszej\Nofierze zmarłego cesarza?
Dialogue: 0,0:17:14.89,0:17:17.09,Default,Loulan,0,0,0,,Dwórka, która urodziła córkę cesarza,
Dialogue: 0,0:17:17.09,0:17:19.18,Default,Loulan,0,0,0,,tylko po to, by została\Nod niej odsunięta?
Dialogue: 0,0:17:19.98,0:17:22.35,Default,Maomao,0,0,0,,Ta, która zmarła w zeszłym roku?
Dialogue: 0,0:17:22.76,0:17:25.98,Default,Loulan,0,0,0,,Tak, to była babcia mojej siostry.
Dialogue: 0,0:17:26.52,0:17:27.98,Default,Loulan,0,0,0,,Nazywała się Taihou.
Dialogue: 0,0:17:28.55,0:17:31.86,Default,Loulan,0,0,0,,Była dwórką mojej matki,\Ngdy przebywała w wewnętrznym pałacu.
Dialogue: 0,0:17:33.46,0:17:34.54,Default,Maomao,0,0,0,,{\i1}Wiedziałam.
Dialogue: 0,0:17:35.33,0:17:40.19,Default,Loulan,0,0,0,,Lekarz, Taihou i jej córka\Nzostali wyrzuceni z pałacu.
Dialogue: 0,0:17:40.54,0:17:42.21,Default,Loulan,0,0,0,,Ta córka to matka mojej siostry.
Dialogue: 0,0:17:44.07,0:17:48.15,Default,Maomao,0,0,0,,{\i1}W Suirei płynie cesarska krew...?
Dialogue: 0,0:17:49.46,0:17:52.30,Default,Loulan,0,0,0,,Słyszałam, że uwielbiała\Nhistorie o duchach.
Dialogue: 0,0:17:53.15,0:17:55.91,Default,Loulan,0,0,0,,Raz o mało się przez to nie udusiłam.
Dialogue: 0,0:17:55.91,0:17:58.57,Default,Loulan,0,0,0,,Być może to sprawka babci.
Dialogue: 0,0:18:02.09,0:18:04.31,Default,Loulan,0,0,0,,W końcu jestem córką mojej matki.
Dialogue: 0,0:18:04.91,0:18:06.89,Default,Loulan,0,0,0,,Z pewnością mnie nienawidziła.
Dialogue: 0,0:18:07.69,0:18:10.22,Default,Loulan,0,0,0,,Na tyle, by chciała mnie zabić.
Dialogue: 0,0:18:10.75,0:18:13.70,Default,Maomao,0,0,0,,Nikt nie wie,\Nczy duchy w ogóle istnieją.
Dialogue: 0,0:18:14.43,0:18:16.07,Default,Loulan,0,0,0,,Typowa Maomao.
Dialogue: 0,0:18:19.77,0:18:24.68,Default,Loulan,0,0,0,,Moja matka poślubiła mojego\Nojca, by urodzić „Loulan”.
Dialogue: 0,0:18:25.75,0:18:28.12,Default,Loulan,0,0,0,,Wyłącznie dla własnej zemsty.
Dialogue: 0,0:18:29.41,0:18:32.39,Default,Loulan,0,0,0,,W jego żyłach płynie zachodnia krew.
Dialogue: 0,0:18:32.82,0:18:35.24,Default,Loulan,0,0,0,,Z tej samej linii co Cesarzowa Matka.
Dialogue: 0,0:18:36.55,0:18:40.04,Default,Maomao,0,0,0,,{\i1}Właśnie dlatego Loulan również jest...
Dialogue: 0,0:18:44.03,0:18:49.35,Default,Loulan,0,0,0,,Matka mawiała:\N„Możesz być nową Cesarzową Matką”.
Dialogue: 0,0:18:50.81,0:18:51.66,Default,Maomao,0,0,0,,Hej...
Dialogue: 0,0:18:53.45,0:18:56.31,Default,Maomao,0,0,0,,{\i1}Loulan? Shisui?
Dialogue: 0,0:18:57.32,0:19:00.11,Default,Maomao,0,0,0,,{\i1}Nie wiem, jak ją nazywać.
Dialogue: 0,0:19:01.22,0:19:01.82,Default,Maomao,0,0,0,,{\i1}Ale...
Dialogue: 0,0:19:07.83,0:19:08.50,Default,Maomao,0,0,0,,{\i1}Ale.
Dialogue: 0,0:19:10.53,0:19:11.67,Default,Maomao,0,0,0,,Shisui.
Dialogue: 0,0:19:21.01,0:19:22.26,Default,Shisui,0,0,0,,Co tam?
Dialogue: 0,0:19:24.98,0:19:29.77,Default,Maomao,0,0,0,,Kiedy w wewnętrznym pałacu pojawiły\Nsię leki aborcyjne, czy ty też je miałaś?
Dialogue: 0,0:19:30.43,0:19:32.10,Default,Maomao,0,0,0,,Dla samej siebie?
Dialogue: 0,0:19:33.39,0:19:39.32,Default,Maomao,0,0,0,,Kiedy opowiedziałaś tę historię o duchu,\No żonie jedzącej swojego męża...
Dialogue: 0,0:19:40.44,0:19:42.95,Default,Maomao,0,0,0,,Mówiłaś o sobie?
Dialogue: 0,0:19:43.74,0:19:47.64,Default,Maomao,0,0,0,,{\i1}Porównując się do owada, który rodzi\Nw klatce, jaką jest wewnętrzny pałac,
Dialogue: 0,0:19:48.03,0:19:50.97,Default,Maomao,0,0,0,,{\i1}by później pożreć cesarza?
Dialogue: 0,0:19:51.88,0:19:55.42,Default,Maomao,0,0,0,,{\i1}Ale Shisui nie chciała,\Nby do tego doszło.
Dialogue: 0,0:19:56.75,0:19:58.04,Default,Maomao,0,0,0,,Miechunka rozdęta...
Dialogue: 0,0:19:58.95,0:19:59.96,Default,Shisui,0,0,0,,Wiem.
Dialogue: 0,0:20:01.37,0:20:03.89,Default,Shisui,0,0,0,,Naprawdę jesteś bystra, Maomao.
Dialogue: 0,0:20:05.70,0:20:07.64,Default,Shisui,0,0,0,,Cieszę się, że cię tu ściągnęłam.
Dialogue: 0,0:20:13.18,0:20:15.44,Default,Maomao,0,0,0,,Rany, ale beznadziejny śpioch...
Dialogue: 0,0:20:25.65,0:20:27.83,Default,Shisui,0,0,0,,Nie oddychają.
Dialogue: 0,0:20:28.23,0:20:29.45,Default,Maomao,0,0,0,,Co ty...
Dialogue: 0,0:20:34.61,0:20:37.51,Default,Maomao,0,0,0,,Kazałaś im wypić truciznę?!
Dialogue: 0,0:20:53.08,0:20:54.14,Default,Shisui,0,0,0,,To było lekarstwo.
Dialogue: 0,0:20:58.01,0:21:03.19,Default,Shisui,0,0,0,,Po tym co zrobiliśmy, wszyscy umrą,\Nłącznie z kobietami i dziećmi.
Dialogue: 0,0:21:03.19,0:21:04.70,Default,Shisui,0,0,0,,Dobrze o tym wiesz, prawda?
Dialogue: 0,0:21:07.33,0:21:09.80,Default,Shisui,0,0,0,,Wymieszałam ją ze słodkim sokiem.
Dialogue: 0,0:21:10.84,0:21:13.08,Default,Shisui,0,0,0,,Po wspólnym czytaniu...
Dialogue: 0,0:21:14.65,0:21:17.88,Default,Shisui,0,0,0,,niektóre dzieciaki\Nchciały spać z mamami.
Dialogue: 0,0:21:18.53,0:21:20.19,Default,Shisui,0,0,0,,Ale nie mogłam na to pozwolić.
Dialogue: 0,0:21:20.70,0:21:26.01,Default,Shisui,0,0,0,,Ich matki są blisko z moją matką.
Dialogue: 0,0:21:29.30,0:21:34.98,Default,Shisui,0,0,0,,Kyou przybył później,\Nbo chciał cię chyba uratować.
Dialogue: 0,0:21:37.02,0:21:39.65,Default,Shisui,0,0,0,,Może wiedział.
Dialogue: 0,0:21:48.53,0:21:51.58,Default,Shisui,0,0,0,,Przygryzł usta, ale...
Dialogue: 0,0:21:52.43,0:21:54.41,Default,Shisui,0,0,0,,wypił ją jednym haustem.
Dialogue: 0,0:22:03.07,0:22:05.26,Default,Maomao,0,0,0,,Po co mnie tu sprowadziłaś?
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Gwardia Królewska”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
