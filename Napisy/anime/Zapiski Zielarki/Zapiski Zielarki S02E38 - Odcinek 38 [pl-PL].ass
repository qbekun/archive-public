Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:32.61,0:01:33.98,Default,Seki-u,0,0,0,,No nie wierzę!
Dialogue: 0,0:01:34.44,0:01:37.40,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:34.45,0:01:37.70,Default,Seki-u,0,0,0,,Że zaopiekujesz się inną\Nkonkubiną niż pani Gyokuyou!
Dialogue: 0,0:01:38.17,0:01:39.91,Default,Maomao,0,0,0,,Mówisz tak, ale...
Dialogue: 0,0:01:40.54,0:01:41.53,Default,Lishu,0,0,0,,Coś tam jest.
Dialogue: 0,0:01:41.93,0:01:45.45,Default,Lishu,0,0,0,,W pałacowej łaźni jest...
Dialogue: 0,0:01:45.45,0:01:46.79,Default,Lishu,0,0,0,,Duch!
Dialogue: 0,0:01:50.01,0:01:53.80,Default,Maomao,0,0,0,,Czemu nie powiesz o tym panu Jinshiemu?
Dialogue: 0,0:01:54.52,0:01:58.84,Default,Maomao,0,0,0,,Kogo by to nie zainteresowało?
Dialogue: 0,0:02:01.09,0:02:02.19,Default,Hongniang,0,0,0,,Maomao.
Dialogue: 0,0:02:02.73,0:02:06.31,Default,Maomao,0,0,0,,Tak jak się tego spodziewałam.
Dialogue: 0,0:02:07.15,0:02:08.48,Default,Maomao,0,0,0,,Wezwałaś mnie?
Dialogue: 0,0:02:07.31,0:02:11.27,Default,Text,0,0,0,,{\an8}ODCINEK 38: TAŃCZĄCY DUCH
Dialogue: 0,0:02:15.90,0:02:19.95,Default,Maomao,0,0,0,,Rany. Tak się szczerzyłam \Njak głupi do sera z beozaru,
Dialogue: 0,0:02:19.95,0:02:23.41,Default,Maomao,0,0,0,,że zapomniałam, co odkryłam\No nim podczas polowania.
Dialogue: 0,0:02:23.70,0:02:27.41,Default,Maomao,0,0,0,,Oprócz cesarza wszyscy mężczyźni\Nw wewnętrznym pałacu są eunuchami.
Dialogue: 0,0:02:27.41,0:02:30.42,Default,Maomao,0,0,0,,Ale nie pan Jinshi.
Dialogue: 0,0:02:30.90,0:02:33.78,Default,Maomao,0,0,0,,Ma dość pokaźną żabkę.
Dialogue: 0,0:02:36.79,0:02:39.22,Default,Gyokuyou,0,0,0,,Zatem co cię tu dziś sprowadza?
Dialogue: 0,0:02:39.72,0:02:42.68,Default,Jinshi,0,0,0,,Słyszałem, że w pokoju pewnej\Nkonkubiny pojawia się duch.
Dialogue: 0,0:02:43.05,0:02:46.33,Default,Gyokuyou,0,0,0,,Rajuśku! To musi być straszne.
Dialogue: 0,0:02:48.42,0:02:52.00,Default,Gyokuyou,0,0,0,,Która to konkubina?\NTrzeba ją odwiedzić i pocieszyć.
Dialogue: 0,0:02:52.00,0:02:56.28,Default,Hongniang,0,0,0,,Pani Gyokuyou, w twoim stanie\Nnie wolno ci opuszczać pałacu.
Dialogue: 0,0:02:56.28,0:02:58.32,Default,Gyokuyou,0,0,0,,W takim razie wyślę kogoś za mnie.
Dialogue: 0,0:02:58.67,0:03:00.11,Default,Gyokuyou,0,0,0,,Pomyślmy...
Dialogue: 0,0:03:00.82,0:03:05.41,Default,Gyokuyou,0,0,0,,Hongniang, może pójdziesz\Ni zabierzesz ze sobą Maomao?
Dialogue: 0,0:03:05.69,0:03:09.16,Default,Jinshi,0,0,0,,Pani Gyokuyou, to poufna sprawa,
Dialogue: 0,0:03:09.16,0:03:11.25,Default,Jinshi,0,0,0,,ale muszę odmówić odwiedzin.
Dialogue: 0,0:03:11.73,0:03:16.25,Default,Jinshi,0,0,0,,Czy mogłabyś\N„zwrócić” mi ją ponownie?
Dialogue: 0,0:03:16.90,0:03:19.76,Default,Gyokuyou,0,0,0,,Pewnie, że ci ją „pożyczę”.
Dialogue: 0,0:03:23.97,0:03:25.92,Default,Maomao,0,0,0,,Znowu mną handlują.
Dialogue: 0,0:03:26.65,0:03:29.35,Default,Jinshi,0,0,0,,Nie, chciałbym, byś „zwróciła”...
Dialogue: 0,0:03:29.97,0:03:32.81,Default,Jinshi,0,0,0,,mi „Maomao”.
Dialogue: 0,0:03:34.37,0:03:38.78,Default,Jinshi,0,0,0,,Jak wróci, nie będziesz\Nmogła jej o nic zapytać.
Dialogue: 0,0:03:39.33,0:03:43.64,Default,Jinshi,0,0,0,,Upewnię się, że nie puści pary z ust.
Dialogue: 0,0:03:45.88,0:03:47.92,Default,Jinshi,0,0,0,,Tak więc na mnie już pora.
Dialogue: 0,0:03:57.96,0:04:01.32,Default,Gyokuyou,0,0,0,,Co zaszło między wami na polowaniu?
Dialogue: 0,0:04:02.55,0:04:04.64,Default,Maomao,0,0,0,,To wszystko wina żaby.
Dialogue: 0,0:04:05.79,0:04:06.80,Default,Gyokuyou & Hongniang,0,0,0,,Żaby?
Dialogue: 0,0:04:07.48,0:04:13.31,Default,Maomao,0,0,0,,Może bezoar nie był wart tajemnicy,\Nktórą muszę dźwigać do śmierci.
Dialogue: 0,0:04:14.58,0:04:16.06,Default,Kanan,0,0,0,,Czekaliśmy na ciebie.
Dialogue: 0,0:04:24.78,0:04:28.35,Default,Maomao,0,0,0,,Jak dużo wie pan Gaoshun?
Dialogue: 0,0:04:28.35,0:04:32.45,Default,Maomao,0,0,0,,A może on też nie jest eunuchem?
Dialogue: 0,0:04:33.56,0:04:36.14,Default,Maomao,0,0,0,,Nie ma sensu o tym myśleć.
Dialogue: 0,0:04:40.18,0:04:42.46,Default,Jinshi,0,0,0,,Witaj, konkubino Li Shu.
Dialogue: 0,0:04:43.39,0:04:44.43,Default,Lishu,0,0,0,,Pan Jinshi!
Dialogue: 0,0:04:44.72,0:04:49.18,Default,Jinshi,0,0,0,,Pokażesz nam łaźnię, w której straszy?
Dialogue: 0,0:04:50.26,0:04:51.64,Default,Lishu,0,0,0,,A, tak...
Dialogue: 0,0:04:52.65,0:04:54.56,Default,Maomao,0,0,0,,Mogłyby chociaż trochę udawać?
Dialogue: 0,0:04:54.92,0:04:58.27,Default,Maomao,0,0,0,,Denerwuje mnie, że tak się zachowują\Nwobec konkubiny wysokiej rangi...
Dialogue: 0,0:04:58.74,0:05:00.11,Default,Kanan,0,0,0,,Tędy.
Dialogue: 0,0:05:02.61,0:05:06.07,Default,Kanan,0,0,0,,Na początku znajduje się\Nszatnia, a za nią wanna.
Dialogue: 0,0:05:07.49,0:05:13.04,Default,Kanan,0,0,0,,Pani Li Shu mówiła, że widziała\Ndziwną ludzką postać z tego okna.
Dialogue: 0,0:05:14.25,0:05:16.12,Default,Jinshi,0,0,0,,Kogo tam widziałaś?
Dialogue: 0,0:05:16.53,0:05:18.21,Default,Lishu,0,0,0,,W-Więc...
Dialogue: 0,0:05:19.23,0:05:22.13,Default,Former Head Lady-In-Waiting,0,0,0,,Ciągle o tym opowiadasz?
Dialogue: 0,0:05:22.48,0:05:24.72,Default,Former Head Lady-In-Waiting,0,0,0,,Na pewno ci się przywidziało.
Dialogue: 0,0:05:24.72,0:05:29.01,Default,Former Head Lady-In-Waiting,0,0,0,,Pani Li Shu często chce zwrócić\Nna siebie uwagę tą bajeczką.
Dialogue: 0,0:05:31.71,0:05:35.86,Default,Former Head Lady-In-Waiting,0,0,0,,Robienie z igły widły...
Dialogue: 0,0:05:35.86,0:05:41.77,Default,Former Head Lady-In-Waiting,0,0,0,,Moim zdaniem główna dwórka\Npowinna hamować takie zachowanie.
Dialogue: 0,0:05:42.16,0:05:46.93,Default,Former Head Lady-In-Waiting,0,0,0,,Może o tym nie wiesz,\Nbo byłaś tylko testerką.
Dialogue: 0,0:05:46.93,0:05:48.53,Default,Kanan,0,0,0,,Przepraszam...
Dialogue: 0,0:05:48.80,0:05:50.56,Default,Maomao,0,0,0,,Sądząc po jej gadaninie,
Dialogue: 0,0:05:50.56,0:05:53.62,Default,Maomao,0,0,0,,ten nadęty babsztyl to zapewne\Npoprzednia główna dwórka.
Dialogue: 0,0:05:53.96,0:05:56.32,Default,Maomao,0,0,0,,Pewnie jest wściekła, że testerka
Dialogue: 0,0:05:56.32,0:05:59.75,Default,Maomao,0,0,0,,odebrała jej rolę i wciąż na nią narzeka.
Dialogue: 0,0:06:00.59,0:06:01.42,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:06:02.44,0:06:04.26,Default,Maomao,0,0,0,,Ta spinka do włosów...
Dialogue: 0,0:06:05.46,0:06:07.38,Default,Former Head Lady-In-Waiting,0,0,0,,Czyż nie mam racji?
Dialogue: 0,0:06:07.93,0:06:09.37,Default,Jinshi,0,0,0,,Możliwe.
Dialogue: 0,0:06:10.37,0:06:14.55,Default,Jinshi,0,0,0,,Niemniej moją rolą\Njest wysłuchanie konkubin.
Dialogue: 0,0:06:14.55,0:06:17.06,Default,Jinshi,0,0,0,,Pozwolisz, że się tym zajmę?
Dialogue: 0,0:06:18.23,0:06:19.48,Default,Former Head Lady-In-Waiting,0,0,0,,T-Tak...
Dialogue: 0,0:06:21.10,0:06:24.19,Default,Jinshi,0,0,0,,Trochę zaschło mi w gardle...
Dialogue: 0,0:06:25.40,0:06:27.07,Default,Former Head Lady-In-Waiting,0,0,0,,Zaraz przyniosę herbatkę!
Dialogue: 0,0:06:27.07,0:06:28.13,Default,Lady-In-Waiting 1,0,0,0,,Ja to zrobię!
Dialogue: 0,0:06:28.13,0:06:29.53,Default,Lady-In-Waiting 2,0,0,0,,A właśnie, że ja!
Dialogue: 0,0:06:31.24,0:06:35.37,Default,Jinshi,0,0,0,,Więc, konkubino Li Shu,\Nopowiesz mi o tym?
Dialogue: 0,0:06:36.07,0:06:38.51,Default,Lishu,0,0,0,,T-Tak...
Dialogue: 0,0:06:39.17,0:06:43.63,Default,Maomao,0,0,0,,Takie buty. Pozbył się widowni,\Nby konkubina Li Shu mogła swobodnie mówić.
Dialogue: 0,0:06:44.25,0:06:48.88,Default,Lishu,0,0,0,,Tej nocy, jak zawsze,\Nskończyłam się kąpać.
Dialogue: 0,0:06:49.58,0:06:51.94,Default,Lishu,0,0,0,,Wolę niższe temperatury,
Dialogue: 0,0:06:51.94,0:06:54.89,Default,Lishu,0,0,0,,a dwórki zawsze przygotowują\Nmi bardzo gorącą kąpiel.
Dialogue: 0,0:06:55.51,0:06:59.27,Default,Lishu,0,0,0,,Z czasem weszło mi w krew\Nkąpanie się nieco później, jak woda ostygła.
Dialogue: 0,0:07:00.15,0:07:02.15,Default,Lishu,0,0,0,,Zauważyłam to wcześniej,
Dialogue: 0,0:07:02.98,0:07:07.61,Default,Lishu,0,0,0,,ale chyba moje dwórki\Nniezbyt za mną przepadają.
Dialogue: 0,0:07:08.22,0:07:12.20,Default,Lishu,0,0,0,,Od czasów pobytu w klasztorze\Nzawsze kąpię się sama.
Dialogue: 0,0:07:12.20,0:07:18.01,Default,Lishu,0,0,0,,Kanan... Znaczy się, moja główna\Ndwórka, pomaga mi się ubrać.
Dialogue: 0,0:07:18.45,0:07:23.33,Default,Lishu,0,0,0,,Kiedy się wycierałam, zrobiło mi\Nsię ciepło, więc odsłoniłam roletę.
Dialogue: 0,0:07:23.33,0:07:25.07,Default,Lishu,0,0,0,,Wtedy...
Dialogue: 0,0:07:25.07,0:07:29.30,Default,Lishu,0,0,0,,Chociaż okna były zamknięte,\Nzasłona unosiła się.
Dialogue: 0,0:07:30.45,0:07:34.70,Default,Lishu,0,0,0,,A biała postać tańczyła i śmiała się!
Dialogue: 0,0:07:36.34,0:07:39.35,Default,Lishu,0,0,0,,Wpatrując się we mnie!
Dialogue: 0,0:07:43.50,0:07:46.82,Default,Maomao,0,0,0,,Czy jest szansa,\Nże był tam ktoś jeszcze?
Dialogue: 0,0:07:48.10,0:07:53.30,Default,Lishu,0,0,0,,Tylko Kanan była ze mną.\NTeż widziała ducha!
Dialogue: 0,0:07:54.75,0:07:57.66,Default,Kanan,0,0,0,,Podeszłam do okna,\Nby sprawdzić, co to było,
Dialogue: 0,0:07:58.26,0:08:00.15,Default,Kanan,0,0,0,,ale wszystko zniknęło,
Dialogue: 0,0:08:01.02,0:08:05.46,Default,Kanan,0,0,0,,a zasłonka przestała się ruszać,\Njakby nigdy nic.
Dialogue: 0,0:08:06.50,0:08:10.65,Default,Maomao,0,0,0,,Wszystkie okna były zamknięte,
Dialogue: 0,0:08:10.65,0:08:12.85,Default,Maomao,0,0,0,,więc wiatr nie mógł\Nsię przez nie przedostać.
Dialogue: 0,0:08:12.85,0:08:15.68,Default,Maomao,0,0,0,,Lecz zasłonka ruszała się.
Dialogue: 0,0:08:17.00,0:08:20.27,Default,Maomao,0,0,0,,Nie jest niczym dziwnym myśleć,\Nże był to duch i bać się.
Dialogue: 0,0:08:20.81,0:08:23.22,Default,Maomao,0,0,0,,Ależ dziwaczny wygląd.
Dialogue: 0,0:08:23.22,0:08:27.54,Default,Maomao,0,0,0,,W Kryształowym i Jadeitowym Pałacu\Nłaźnie mieszczą się w oddzielnych budynkach
Dialogue: 0,0:08:27.54,0:08:29.78,Default,Maomao,0,0,0,,i zapewniają strefę\Nrelaksacyjną po kąpieli.
Dialogue: 0,0:08:30.47,0:08:34.32,Default,Maomao,0,0,0,,Czemu ktoś miałby budować\Nskładzik obok łaźni?
Dialogue: 0,0:08:37.40,0:08:40.49,Default,Maomao,0,0,0,,Czy ten pokój zawsze\Nsłużył jako składzik?
Dialogue: 0,0:08:40.49,0:08:43.32,Default,Kanan,0,0,0,,A, nie, nie zawsze...
Dialogue: 0,0:08:43.87,0:08:46.28,Default,Maomao,0,0,0,,To czemu się nim stał?
Dialogue: 0,0:08:46.28,0:08:47.38,Default,Kanan,0,0,0,,Cóż...
Dialogue: 0,0:08:51.21,0:08:54.94,Default,Kanan,0,0,0,,Szybciej będzie, jak zobaczycie\Nto na własne oczy.
Dialogue: 0,0:09:00.19,0:09:02.27,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:09:02.78,0:09:05.02,Default,Maomao,0,0,0,,Jest cały zapleśniały.
Dialogue: 0,0:09:05.48,0:09:08.97,Default,Maomao,0,0,0,,Służba w Jadeitowym\NPałacu ustaliłaby przyczynę
Dialogue: 0,0:09:08.97,0:09:11.53,Default,Maomao,0,0,0,,i zrobiła wszystko,\Nby powstrzymać pleśń, ale...
Dialogue: 0,0:09:11.93,0:09:15.50,Default,Maomao,0,0,0,,Ale po tych tutaj bym\Nsię tego nie spodziewała.
Dialogue: 0,0:09:15.50,0:09:18.57,Default,Maomao,0,0,0,,Przerobili go po prostu\Nna składzik, by to ukryć.
Dialogue: 0,0:09:24.05,0:09:27.67,Default,Maomao,0,0,0,,Ciekawe, czy podłoże też zgniło.
Dialogue: 0,0:09:28.34,0:09:31.15,Default,Maomao,0,0,0,,Czy ten budynek\Njest starszy od pozostałych?
Dialogue: 0,0:09:31.15,0:09:33.76,Default,Kanan,0,0,0,,Wręcz przeciwnie, jest całkiem nowy.
Dialogue: 0,0:09:33.76,0:09:37.01,Default,Kanan,0,0,0,,Został zbudowany, gdy pani Li Shu\Ndołączyła do wewnętrznego pałacu.
Dialogue: 0,0:09:37.01,0:09:38.84,Default,Maomao,0,0,0,,Taki stan w zaledwie kilka lat?
Dialogue: 0,0:09:39.54,0:09:43.43,Default,Maomao,0,0,0,,Konkubina Li Shu mówiła,\Nże ta zasłonka się ruszała.
Dialogue: 0,0:09:45.57,0:09:47.44,Default,Maomao,0,0,0,,Proszę, pokaż mi łaźnię.
Dialogue: 0,0:09:51.31,0:09:52.11,Default,Maomao,0,0,0,,Mam to.
Dialogue: 0,0:09:52.71,0:09:57.11,Default,Maomao,0,0,0,,Ten odpływ musi być połączony\Nz kanalizacją wewnętrznego pałacu.
Dialogue: 0,0:09:57.71,0:09:58.73,Default,Maomao,0,0,0,,Pani Li Shu.
Dialogue: 0,0:09:59.44,0:10:04.54,Default,Maomao,0,0,0,,Czy w dniu, w którym zobaczyłaś ducha,\N nie zapomniałaś zatkać odpływu?
Dialogue: 0,0:10:04.81,0:10:07.25,Default,Lishu,0,0,0,,Tak. Skąd wiedziałaś?
Dialogue: 0,0:10:07.58,0:10:08.75,Default,Maomao,0,0,0,,Tak jak myślałam.
Dialogue: 0,0:10:09.34,0:10:15.63,Default,Maomao,0,0,0,,Zamknięte okna, zasunięte\Nzasłony, niezatkana wanna...
Dialogue: 0,0:10:16.30,0:10:20.90,Default,Maomao,0,0,0,,Jeżeli moje domysły są słuszne,\Nto prawdziwym obliczem ducha jest...
Dialogue: 0,0:10:28.42,0:10:32.66,Default,Maomao,0,0,0,,Panie Gaoshun, pomożesz\Nmi przesunąć tę szafkę?
Dialogue: 0,0:10:32.66,0:10:33.40,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:10:38.36,0:10:40.02,Default,Jinshi,0,0,0,,Sytuacja jest fatalna.
Dialogue: 0,0:10:40.02,0:10:42.49,Default,Maomao,0,0,0,,Tak, spleśniała całkowicie.
Dialogue: 0,0:10:44.18,0:10:46.81,Default,Maomao,0,0,0,,Podłoga jest wypaczona i ma szczeliny.
Dialogue: 0,0:10:47.52,0:10:49.08,Default,Maomao,0,0,0,,W tym przypadku...
Dialogue: 0,0:10:49.08,0:10:52.66,Default,Maomao,0,0,0,,Czy można sprawdzić,\Nczy przebiega tędy kanalizacja?
Dialogue: 0,0:10:52.66,0:10:55.44,Default,Gaoshun,0,0,0,,Zaraz przyniosę plan\NDiamentowego Pałacu.
Dialogue: 0,0:10:57.81,0:10:58.85,Default,Gaoshun,0,0,0,,Proszę.
Dialogue: 0,0:10:58.85,0:11:00.34,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:11:02.94,0:11:05.85,Default,Maomao,0,0,0,,Tak jak sądziłam,\Nkanalizacja przepływa pod podłogą.
Dialogue: 0,0:11:06.35,0:11:11.35,Default,Maomao,0,0,0,,Przepływająca w rurach gorąca woda\Npowoduje, że podłoga i ściany łatwo gniją.
Dialogue: 0,0:11:11.64,0:11:17.86,Default,Maomao,0,0,0,,Opary przedostawały się przez tę szczelinę,\Ntworząc wiatr i poruszając zasłonami.
Dialogue: 0,0:11:19.13,0:11:22.74,Default,Lishu,0,0,0,,A co z tą twarzą, którą widziałam?!
Dialogue: 0,0:11:25.42,0:11:26.28,Default,Maomao,0,0,0,,To pewnie to.
Dialogue: 0,0:11:30.28,0:11:32.14,Default,Lishu,0,0,0,,To...
Dialogue: 0,0:11:33.23,0:11:38.09,Default,Lishu,0,0,0,,To miedziane lusterko jest\Ndla mnie ważne. Uważaj na nie.
Dialogue: 0,0:11:38.61,0:11:41.72,Default,Maomao,0,0,0,,Dobrze. Jak długo tu stoi?
Dialogue: 0,0:11:42.01,0:11:44.13,Default,Lishu,0,0,0,,Kiedyś często z niego korzystałam.
Dialogue: 0,0:11:44.13,0:11:47.31,Default,Lishu,0,0,0,,Lecz teraz posiadamy lustro, które podarowała\Nnam specjalna wysłanniczka, więc...
Dialogue: 0,0:11:47.87,0:11:50.10,Default,Maomao,0,0,0,,Lustra od specjalnych\Nwysłanniczek są wykonane ze szkła,
Dialogue: 0,0:11:50.10,0:11:52.64,Default,Maomao,0,0,0,,dzięki czemu są znacznie\Nbardziej precyzyjne niż miedziane.
Dialogue: 0,0:11:52.64,0:11:54.83,Default,Maomao,0,0,0,,To naturalne, że użyły\Ntamtego, a te schowali.
Dialogue: 0,0:11:54.83,0:11:56.55,Default,Maomao,0,0,0,,Ale jednak...
Dialogue: 0,0:11:56.55,0:11:58.83,Default,Maomao,0,0,0,,Dbasz o nie każdego dnia.
Dialogue: 0,0:11:58.83,0:12:02.75,Default,Lishu,0,0,0,,Tak, to pamiątka po mojej zmarłej matce.
Dialogue: 0,0:12:04.10,0:12:08.24,Default,Maomao,0,0,0,,Wygląda jak zwykłe miedziane lustro, ale...
Dialogue: 0,0:12:09.94,0:12:14.46,Default,Maomao,0,0,0,,Pani Li Shu, możemy go użyć?
Dialogue: 0,0:12:15.65,0:12:16.56,Default,Maomao,0,0,0,,Proszę.
Dialogue: 0,0:12:19.99,0:12:22.00,Default,Lishu,0,0,0,,Użyć?
Dialogue: 0,0:12:23.09,0:12:26.80,Default,Maomao,0,0,0,,Przy dobrym świetle\Nłatwiej będzie to zauważyć.
Dialogue: 0,0:12:32.02,0:12:35.31,Default,Maomao,0,0,0,,Jeśli nakierujesz je w ten sposób,\Nbędzie lepiej widoczny.
Dialogue: 0,0:12:44.11,0:12:46.97,Default,Maomao,0,0,0,,Rozumiem. Tak to wygląda.
Dialogue: 0,0:12:46.97,0:12:48.58,Default,Jinshi,0,0,0,,Co jest grane?!
Dialogue: 0,0:12:48.99,0:12:53.22,Default,Maomao,0,0,0,,Nazywa się to „magicznym lustrem”.\NPierwszy raz to widzę.
Dialogue: 0,0:12:53.22,0:12:54.29,Default,Jinshi,0,0,0,,Magiczne?
Dialogue: 0,0:12:54.64,0:13:01.45,Default,Maomao,0,0,0,,Jest to specjalne lusterko, które odbija\Nświatło i zamienia je w obraz lub tekst.
Dialogue: 0,0:13:01.80,0:13:06.91,Default,Maomao,0,0,0,,Ponoć powstaje przez nałożenie\Nwypukłości na powierzchnię lustra.
Dialogue: 0,0:13:07.52,0:13:11.74,Default,Maomao,0,0,0,,Słyszałam od mojego tatka, że stworzenie\Ngo wymaga nie lada umiejętności.
Dialogue: 0,0:13:15.72,0:13:20.23,Default,Maomao,0,0,0,,Dobrze wypolerowane lustro\Nukazuje twarz w świetle księżyca.
Dialogue: 0,0:13:20.95,0:13:24.66,Default,Maomao,0,0,0,,Gorąca para powoduje,\Nże zasłonka się porusza.
Dialogue: 0,0:13:26.14,0:13:31.86,Default,Maomao,0,0,0,,A „duch” powstał w efekcie\Nzbiegu okoliczności.
Dialogue: 0,0:13:32.91,0:13:37.36,Default,Lishu,0,0,0,,Ta twarz... Przypomina\Nmoją zmarłą matkę.
Dialogue: 0,0:13:38.65,0:13:43.84,Default,Lishu,0,0,0,,Czy zezłościła się, bo\Nprzestałam z niego korzystać?
Dialogue: 0,0:13:44.30,0:13:46.26,Default,Lishu,0,0,0,,Przyszła, by mnie zbesztać?
Dialogue: 0,0:13:47.01,0:13:49.01,Default,Maomao,0,0,0,,To tylko przypadek.
Dialogue: 0,0:13:49.51,0:13:51.98,Default,Lishu,0,0,0,,Podobno uwielbiała tańczyć.
Dialogue: 0,0:13:51.98,0:13:54.62,Default,Lishu,0,0,0,,Kiedy mnie urodziła,\Nwszystko się skończyło.
Dialogue: 0,0:13:54.62,0:13:57.70,Default,Lishu,0,0,0,,Nie mogła już tańczyć\Ni niedługo potem zmarła.
Dialogue: 0,0:13:58.20,0:14:01.11,Default,Lishu,0,0,0,,Może właśnie dlatego\Nteraz tańczy jako duch?
Dialogue: 0,0:14:01.77,0:14:03.07,Default,Maomao,0,0,0,,Duchy nie...
Dialogue: 0,0:14:12.90,0:14:17.14,Default,Maomao,0,0,0,,Zasługuje na bardziej\Nbeztroskie życie jak na swój wiek.
Dialogue: 0,0:14:17.14,0:14:20.05,Default,Maomao,0,0,0,,Pewnie, by poradzić sobie\Nz samotnością w wewnętrznym pałacu,
Dialogue: 0,0:14:20.05,0:14:23.19,Default,Maomao,0,0,0,,codziennie dbała o pamiątkę po matce.
Dialogue: 0,0:14:24.51,0:14:27.80,Default,Maomao,0,0,0,,Szczerze mówiąc, sama nie rozumiem,\Njak to jest ciepło myśleć o matce.
Dialogue: 0,0:14:28.43,0:14:34.06,Default,Maomao,0,0,0,,Ale dla niej musiała być całym światem,\Nskoro darzyła ją takimi uczuciami.
Dialogue: 0,0:14:39.70,0:14:44.11,Default,Former Head Lady-In-Waiting,0,0,0,,Przepraszam. Herbatka gotowa.
Dialogue: 0,0:14:48.28,0:14:52.69,Default,Former Head Lady-In-Waiting,0,0,0,,Na litość boską, pani Li Shu,\Nczemu pani płacze?
Dialogue: 0,0:14:52.69,0:14:55.16,Default,Former Head Lady-In-Waiting,0,0,0,,Nie uważasz, że to żenujące?
Dialogue: 0,0:14:55.63,0:14:59.53,Default,Maomao,0,0,0,,Na pierwszy rzut oka wydaje się\Nsurową, ale troskliwą dwórką.
Dialogue: 0,0:14:59.53,0:15:02.29,Default,Maomao,0,0,0,,Ale czasami jej prawdziwa natura\Nwymyka się spod kontroli.
Dialogue: 0,0:15:02.29,0:15:04.21,Default,Maomao,0,0,0,,Za późno już na udawanie.
Dialogue: 0,0:15:04.57,0:15:09.40,Default,Former Head Lady-In-Waiting,0,0,0,,Nadal trzymasz to badziewie?
Dialogue: 0,0:15:10.68,0:15:15.81,Default,Former Head Lady-In-Waiting,0,0,0,,Dostałaś lustro od specjalnych\Nwysłanniczek, więc to jest ci zbędne.
Dialogue: 0,0:15:16.36,0:15:19.06,Default,Former Head Lady-In-Waiting,0,0,0,,—  Czemu nie oddasz go\Nktórejś ze swych służek?
Dialogue: 0,0:15:17.89,0:15:18.72,top,Lishu,0,0,0,,{\an8}— Oddaj...
Dialogue: 0,0:15:19.39,0:15:20.77,Default,Former Head Lady-In-Waiting,0,0,0,,Co proszę?
Dialogue: 0,0:15:21.33,0:15:25.10,Default,Lishu,0,0,0,,Oddawaj! Oddawaj!
Dialogue: 0,0:15:27.48,0:15:28.78,Default,Former Head Lady-In-Waiting,0,0,0,,Co to miało znaczyć?
Dialogue: 0,0:15:29.40,0:15:31.97,Default,Former Head Lady-In-Waiting,0,0,0,,Ośmieszasz się przed gośćmi!
Dialogue: 0,0:15:31.97,0:15:35.41,Default,Jinshi,0,0,0,,To cenna rzecz dla konkubiny Li Shu.
Dialogue: 0,0:15:35.81,0:15:39.66,Default,Jinshi,0,0,0,,Myślę, że zabieranie jej\Nbez pytania to nietakt.
Dialogue: 0,0:15:49.92,0:15:52.05,Default,Jinshi,0,0,0,,To też ci podarowała?
Dialogue: 0,0:15:54.32,0:15:58.12,Default,Jinshi,0,0,0,,Nawet jeśli był to prezent\Ndla ciebie, pospolitej dwórki,
Dialogue: 0,0:15:58.12,0:16:01.39,Default,Jinshi,0,0,0,,to noszenie ozdoby z wygrawerowanym\Nherbem konkubiny wysokiej rangi...
Dialogue: 0,0:16:03.19,0:16:05.86,Default,Jinshi,0,0,0,,jest bardzo nie na miejscu.\NNie przyszło ci to do głowy?
Dialogue: 0,0:16:09.22,0:16:12.77,Default,Maomao,0,0,0,,Pan Jinshi wiedział, że służki\Nkonkubiny Li Shu
Dialogue: 0,0:16:12.77,0:16:14.74,Default,Maomao,0,0,0,,źle ją traktują.
Dialogue: 0,0:16:15.41,0:16:17.33,Default,Maomao,0,0,0,,Nie mógł powiedzieć tego wprost,
Dialogue: 0,0:16:17.33,0:16:19.87,Default,Maomao,0,0,0,,bowiem mogłoby to źle\Nświadczyć o konkubinie Li Shu.
Dialogue: 0,0:16:20.51,0:16:24.46,Default,Maomao,0,0,0,,Ale teraz, gdy ma namacalne dowody,\Nma prawo bez przeszkód wyrazić swoje racje.
Dialogue: 0,0:16:25.64,0:16:30.16,Default,Jinshi,0,0,0,,Prosiłbym o zaprzestanie działań,\Nktóre są niezgodne z twoją pozycją.
Dialogue: 0,0:16:41.86,0:16:44.10,Default,Maomao,0,0,0,,Rany. Powiało chłodem.
Dialogue: 0,0:16:48.73,0:16:50.24,Default,Court Lady 1,0,0,0,,Czyż to nie on?
Dialogue: 0,0:16:50.24,0:16:51.23,Default,Court Lady 2,0,0,0,,Ale przystojniak!
Dialogue: 0,0:16:51.62,0:16:54.11,Default,Elder Eunuch,0,0,0,,Znowu przychodzą\Ngapić się na nowego, co?
Dialogue: 0,0:16:55.61,0:16:58.63,Default,Guen,0,0,0,,Tak, tak, wiem, Maomao.
Dialogue: 0,0:16:56.11,0:16:59.49,Default,Text,0,0,0,,{\an8}MAOMAO
Dialogue: 0,0:17:00.01,0:17:04.38,Default,Guen,0,0,0,,Panienko, czyżbyś szukała leku, który można\Nwykorzystać jako środek znieczulający?
Dialogue: 0,0:17:04.38,0:17:05.22,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:17:05.22,0:17:09.17,Default,Guen,0,0,0,,Nie ma sensu, bo nie\Nbędzie więcej eunuchów.
Dialogue: 0,0:17:09.64,0:17:13.63,Default,Maomao,0,0,0,,Ciekawi mnie, w jaki sposób eunuchowie\Nwchodzą do wewnętrznego pałacu.
Dialogue: 0,0:17:13.63,0:17:15.65,Default,Guen,0,0,0,,Oczywiście przez\Npoddanie się operacji.
Dialogue: 0,0:17:15.65,0:17:19.80,Default,Maomao,0,0,0,,Nie, chodzi mi o to,\Njak udowadniają, że są eunuchami?
Dialogue: 0,0:17:19.80,0:17:23.72,Default,Guen,0,0,0,,A. Wcześniej był to dokument,\Nktóry można było pokazać.
Dialogue: 0,0:17:23.72,0:17:25.85,Default,Guen,0,0,0,,Ale było wiele fałszywych.
Dialogue: 0,0:17:26.73,0:17:28.52,Default,Guen,0,0,0,,Tak więc teraz jest badanie fizyczne.
Dialogue: 0,0:17:29.01,0:17:29.90,Default,Maomao,0,0,0,,Czyli złapali cię?
Dialogue: 0,0:17:29.90,0:17:32.44,Default,Guen,0,0,0,,Możesz być mniej\Nbezpośrednia, panienko?
Dialogue: 0,0:17:33.08,0:17:34.53,Default,Guen,0,0,0,,Aby zapobiec oszustwom,
Dialogue: 0,0:17:34.53,0:17:37.73,Default,Guen,0,0,0,,są sprawdzani przez trzech\Nurzędników z różnych działów.
Dialogue: 0,0:17:37.73,0:17:39.63,Default,Guen,0,0,0,,Jeżeli niczego nie ma, są wpuszczani.
Dialogue: 0,0:17:39.63,0:17:41.70,Default,Maomao,0,0,0,,Tylko za pierwszym razem?
Dialogue: 0,0:17:41.70,0:17:44.41,Default,Guen,0,0,0,,Odbywa się to za każdym razem,\Ngdy wchodzą i wychodzą.
Dialogue: 0,0:17:44.73,0:17:46.24,Default,Maomao,0,0,0,,Pomijając eunuchów,
Dialogue: 0,0:17:46.24,0:17:50.18,Default,Maomao,0,0,0,,jedynymi facetami, którzy mogą wejść do\Nwewnętrznego pałacu, są cesarz i jego krewni.
Dialogue: 0,0:17:50.18,0:17:52.27,Default,Maomao,0,0,0,,Co czyni pana Jinshiego...
Dialogue: 0,0:17:52.67,0:17:54.92,Default,Maomao,0,0,0,,Nie, to niemożliwe.
Dialogue: 0,0:17:55.31,0:17:59.59,Default,Guen,0,0,0,,Skoro mowa o eunuchach,\Nsłyszałaś o nowych nabytkach?
Dialogue: 0,0:18:00.00,0:18:03.72,Default,Maomao,0,0,0,,A, tak. Xiaolan i Shisui mówiły o nich.
Dialogue: 0,0:18:04.10,0:18:07.77,Default,Maomao,0,0,0,,Słyszałam plotki, że jest\Nich około trzydziestu.
Dialogue: 0,0:18:08.08,0:18:13.27,Default,Guen,0,0,0,,Tak! Wszyscy są młodzi i przystojni,\Nwięc niektórzy są podekscytowani!
Dialogue: 0,0:18:13.70,0:18:16.19,Default,Guen,0,0,0,,Pewnego dnia wszyscy\Nzostali zaatakowani
Dialogue: 0,0:18:16.19,0:18:19.74,Default,Guen,0,0,0,,przez konkubiny niższej rangi,\Ngdy przygotowywali kąpiele.
Dialogue: 0,0:18:19.74,0:18:22.24,Default,Maomao,0,0,0,,I poszedłeś tam, żeby popatrzeć?
Dialogue: 0,0:18:22.91,0:18:24.99,Default,Gaoshun,0,0,0,,Kiedy jej to powiesz?
Dialogue: 0,0:18:25.37,0:18:26.96,Default,Jinshi,0,0,0,,W odpowiednim momencie.
Dialogue: 0,0:18:26.96,0:18:30.71,Default,Gaoshun,0,0,0,,Wiem, że się niepokoisz,\Nwidać to po tobie. {Twoje podejście jest zbyt jasne,\Nwręcz nienaturalne.}
Dialogue: 0,0:18:31.18,0:18:34.84,Default,Gaoshun,0,0,0,,Xiaomao patrzyła na\Nciebie jak na padlinę.
Dialogue: 0,0:18:36.03,0:18:38.22,Default,Jinshi,0,0,0,,Zamknij się. Wiem o tym.
Dialogue: 0,0:18:39.01,0:18:42.80,Default,Gaoshun,0,0,0,,Musisz szybko podjąć\Ndecyzję, bo będą kłopoty.
Dialogue: 0,0:18:42.80,0:18:46.16,Default,Jinshi,0,0,0,,Chcesz, żeby od razu\Nbyła po naszej stronie.
Dialogue: 0,0:18:46.16,0:18:49.06,Default,Jinshi,0,0,0,,Nasz strateg będzie się jednak wtrącał.
Dialogue: 0,0:18:49.06,0:18:51.55,Default,Gaoshun,0,0,0,,Zwalczaj truciznę trucizną.
Dialogue: 0,0:18:53.43,0:18:55.66,Default,Jinshi,0,0,0,,Wielki Dowódca Kan Lakan.
Dialogue: 0,0:18:55.66,0:18:58.86,Default,Jinshi,0,0,0,,Przejął obowiązki głowy rodziny siłą
Dialogue: 0,0:18:58.86,0:19:00.78,Default,Jinshi,0,0,0,,od swojego ojca i przyrodniego brata.
Dialogue: 0,0:19:01.34,0:19:03.64,Default,Jinshi,0,0,0,,Jest teraz kimś, kogo\Nszanuje nawet sam cesarz.
Dialogue: 0,0:19:04.78,0:19:08.72,Default,Jinshi,0,0,0,,Chociaż jest wielkim strategiem,\Nnie należy do żadnej konkretnej grupy,
Dialogue: 0,0:19:08.72,0:19:10.48,Default,Jinshi,0,0,0,,włócząc się między ludźmi do woli.
Dialogue: 0,0:19:11.25,0:19:13.81,Default,Jinshi,0,0,0,,Wielu próbowało go ujarzmić,\Nnim zaczął sprawiać kłopoty,
Dialogue: 0,0:19:13.81,0:19:17.77,Default,Jinshi,0,0,0,,ale wszyscy zostali pokonani, płacąc za to\Nwięcej niż kilkoma lekkimi poparzeniami.
Dialogue: 0,0:19:19.05,0:19:23.39,Default,Jinshi,0,0,0,,Nikt nie wie, co mu chodzi po głowie.
Dialogue: 0,0:19:23.39,0:19:28.09,Default,Jinshi,0,0,0,,Niepisaną zasadą w pałacu jest:\N„Nie wchodź mu w drogę bez potrzeby”.
Dialogue: 0,0:19:28.66,0:19:34.06,Default,Jinshi,0,0,0,,Lecz, aby sprowadzić Maomao\Ndo nas, trzeba zająć się także nim.
Dialogue: 0,0:19:34.87,0:19:36.98,Default,Jinshi,0,0,0,,Chcę powiedzieć jej prawdę.
Dialogue: 0,0:19:36.98,0:19:43.05,Default,Jinshi,0,0,0,,Chcę, żeby wiedziała, czemu znajduję się\Nw takiej sytuacji i dlaczego ukrywam swoje „ja”.
Dialogue: 0,0:19:43.57,0:19:47.08,Default,Jinshi,0,0,0,,Jak zareaguje, gdy pozna prawdę?
Dialogue: 0,0:19:50.65,0:19:53.91,Default,Jinshi,0,0,0,,Więcej interesów dla\Nwewnętrznego pałacu. Sporo.
Dialogue: 0,0:19:54.42,0:19:57.36,Default,Gaoshun,0,0,0,,Prawie połowa dotyczy\Nkonkubiny Loulan.
Dialogue: 0,0:19:57.77,0:20:00.77,Default,Gaoshun,0,0,0,,Ma za dużo służby,\Njej strój jest zbyt krzykliwy,
Dialogue: 0,0:20:00.77,0:20:04.43,Default,Gaoshun,0,0,0,,psuje klimat wewnętrznego pałacu i tak dalej.
Dialogue: 0,0:20:04.72,0:20:06.34,Default,Jinshi,0,0,0,,Więc to samo, co zawsze.
Dialogue: 0,0:20:06.77,0:20:09.99,Default,Gaoshun,0,0,0,,A tu świeżynka.
Dialogue: 0,0:20:12.46,0:20:16.91,Default,Jinshi,0,0,0,,Dwórka flirtuje z nowymi eunuchami.
Dialogue: 0,0:20:16.91,0:20:18.86,Default,Jinshi,0,0,0,,To było do przewidzenia.
Dialogue: 0,0:20:18.86,0:20:22.32,Default,Gaoshun,0,0,0,,Szczególnie, że wykonują\Nwiele prac fizycznych.
Dialogue: 0,0:20:22.71,0:20:26.47,Default,Gaoshun,0,0,0,,Planowaliśmy przenieść ich do innych\Nwydziałów na podstawie ich umiejętności,
Dialogue: 0,0:20:26.47,0:20:29.89,Default,Gaoshun,0,0,0,,ale wszyscy są byłymi\Nniewolnikami z innych krajów.
Dialogue: 0,0:20:29.89,0:20:31.83,Default,Gaoshun,0,0,0,,Musimy być bardzo ostrożni.
Dialogue: 0,0:20:31.83,0:20:36.73,Default,Jinshi,0,0,0,,Tak. Chyba muszę się temu przyjrzeć,\Nnawet jeśli to tylko formalność.
Dialogue: 0,0:20:36.73,0:20:37.59,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:20:38.19,0:20:39.65,Default,Jinshi,0,0,0,,Utrapienie.
Dialogue: 0,0:20:39.65,0:20:41.46,Default,Gaoshun,0,0,0,,Nie masz wyboru.
Dialogue: 0,0:20:43.39,0:20:45.68,Default,Gaoshun,0,0,0,,Ci, których szukamy,\Nnoszą białe pasy.
Dialogue: 0,0:20:46.38,0:20:49.06,Default,Jinshi,0,0,0,,Są chudzi i wydają się\Nnieco przestraszeni.
Dialogue: 0,0:20:49.88,0:20:52.75,Default,Jinshi,0,0,0,,Byli niewolnicy nawet po uwolnieniu
Dialogue: 0,0:20:52.75,0:20:56.33,Default,Jinshi,0,0,0,,mają trudności z życiem\Njak normalni cywile.
Dialogue: 0,0:20:56.33,0:21:00.11,Default,Jinshi,0,0,0,,Przydzielenie ich do wewnętrznego pałacu\Nbyło w pewnym sensie dobrą decyzją.
Dialogue: 0,0:21:04.33,0:21:06.21,Default,Jinshi,0,0,0,,A to musi być ten z pogłosek.
Dialogue: 0,0:21:06.85,0:21:08.80,Default,Jinshi,0,0,0,,Co jest nie tak z jego lewą ręką?
Dialogue: 0,0:21:08.80,0:21:13.82,Default,Gaoshun,0,0,0,,Był mocno maltretowany, co doprowadziło\Ndo bezwładności lewej strony jego ciała.
Dialogue: 0,0:21:14.27,0:21:17.65,Default,Gaoshun,0,0,0,,Nie chce pokazywać swojego\Nciała, bo wszędzie ma blizny.
Dialogue: 0,0:21:17.65,0:21:18.79,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:21:20.50,0:21:22.91,Default,Jinshi,0,0,0,,Jednak naprawdę jest popularny.
Dialogue: 0,0:21:22.91,0:21:25.28,Default,Gaoshun,0,0,0,,Owszem. Wydaje się,\Nże jest bardzo inteligentny
Dialogue: 0,0:21:25.28,0:21:27.64,Default,Gaoshun,0,0,0,,i troskliwy w stosunku do kobiet.
Dialogue: 0,0:21:29.34,0:21:30.46,Default,Jinshi,0,0,0,,Co takiego?
Dialogue: 0,0:21:30.46,0:21:32.45,Default,Gaoshun,0,0,0,,I ty to mówisz?
Dialogue: 0,0:21:41.99,0:21:43.89,Default,Jinshi,0,0,0,,Jak radzą sobie nowi?
Dialogue: 0,0:21:43.89,0:21:45.12,Default,Elder Eunuch,0,0,0,,Pan Jinshi.
Dialogue: 0,0:21:49.49,0:21:51.24,Default,Jinshi,0,0,0,,Nadal mogą potrzebować pomocy,
Dialogue: 0,0:21:51.24,0:21:54.76,Default,Jinshi,0,0,0,,ale obiecujemy, że znajdziemy pracę\Nbardziej dostosowaną do ich umiejętności.
Dialogue: 0,0:21:54.76,0:21:55.56,Default,Senior Eunuch,0,0,0,,Tak jest.
Dialogue: 0,0:21:57.86,0:21:59.47,Default,Eunuch A,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:21:59.90,0:22:03.46,Default,Eunuch A,0,0,0,,Ten lód był dla konkubiny wysokiej rangi!
Dialogue: 0,0:22:05.21,0:22:08.55,Default,Eunuch A,0,0,0,,Do diabła... To koniec!
Dialogue: 0,0:22:09.85,0:22:10.55,Default,Xiaolan,0,0,0,,Prze...
Dialogue: 0,0:22:11.75,0:22:13.29,Default,Xiaolan,0,0,0,,Przepraszam...
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Lód”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
