Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:33.75,0:01:38.31,Default,Jinshi,0,0,0,,{\an8}Tym razem jest więcej kupców\Ni towarów niż poprzednio.
Dialogue: 0,0:01:35.69,0:01:38.70,Default,Text,0,0,0,,{\pos(320.885,308.739)\an2}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:38.89,0:01:41.82,Default,Gaoshun,0,0,0,,To chyba jest uroczystość\Ndla specjalnego wysłannika.
Dialogue: 0,0:01:41.82,0:01:46.74,Default,Gaoshun,0,0,0,,Przez to jest ona obszerniejsza\Ni zaplanowana na dłużej.
Dialogue: 0,0:01:47.19,0:01:48.83,Default,Jinshi,0,0,0,,Jak idzie przygotowanie\Nbankietu powitalnego?
Dialogue: 0,0:01:49.42,0:01:52.42,Default,Gaoshun,0,0,0,,Zajmuje się tym urzędnik\Nodpowiedzialny za przyjęcia.
Dialogue: 0,0:01:52.42,0:01:53.21,Default,Jinshi,0,0,0,,Dobrze.
Dialogue: 0,0:01:54.26,0:01:57.17,Default,Jinshi,0,0,0,,To ważny sojusznik\Ndyplomatyczny. Kontynuujcie.
Dialogue: 0,0:01:57.88,0:01:58.68,Default,Gaoshun,0,0,0,,Zrozumiano.
Dialogue: 0,0:01:59.97,0:02:03.93,Default,Text,0,0,0,,{\an8}ODCINEK 26: KARAWANA
Dialogue: 0,0:02:01.43,0:02:06.18,Default,Hongniang,0,0,0,,Robi się coraz cieplej.\NChyba czas na przegląd garderoby.
Dialogue: 0,0:02:06.64,0:02:08.73,Default,Hongniang,0,0,0,,Najpierw zorganizujemy nasz strój.
Dialogue: 0,0:02:08.73,0:02:11.52,Default,Hongniang,0,0,0,,Yinghua, Ailan, Maomao.
Dialogue: 0,0:02:11.52,0:02:12.31,Default,Yinghua & Ailan,0,0,0,,Tak.
Dialogue: 0,0:02:12.31,0:02:13.69,Default,Maomao,0,0,0,,Tak, pani Hongniang.
Dialogue: 0,0:02:14.28,0:02:17.03,Default,Hongniang,0,0,0,,Guiyuan, zaopiekuj się\Nksiężniczką Ling Li.
Dialogue: 0,0:02:17.03,0:02:18.20,Default,Guiyuan,0,0,0,,Oczywiście.
Dialogue: 0,0:02:20.78,0:02:24.03,Default,Yinghua,0,0,0,,Część wzorów wyszła już z mody.
Dialogue: 0,0:02:24.03,0:02:26.50,Default,Yinghua,0,0,0,,Ten jeszcze się nada.
Dialogue: 0,0:02:27.62,0:02:30.88,Default,Yinghua,0,0,0,,O, ten przez jakiś czas był popularny,
Dialogue: 0,0:02:30.88,0:02:35.42,Default,Yinghua,0,0,0,,ale moda szybko się zmienia, nie?
Dialogue: 0,0:02:37.21,0:02:39.34,Default,Maomao,0,0,0,,Co się dzieje ze starymi ubraniami?
Dialogue: 0,0:02:39.34,0:02:41.09,Default,Yinghua,0,0,0,,Niektórzy rzemieślnicy je przerabiają
Dialogue: 0,0:02:41.09,0:02:44.93,Default,Yinghua,0,0,0,,i są rozdawane w rodzinnym\Nregionie pani Gyokuyou.
Dialogue: 0,0:02:44.93,0:02:50.19,Default,Maomao,0,0,0,,Rozumiem. To dodam\Ntrochę ziół owadobójczych.
Dialogue: 0,0:02:50.19,0:02:51.31,Default,Yinghua,0,0,0,,Dziękuję.
Dialogue: 0,0:02:51.31,0:02:55.32,Default,Ailan,0,0,0,,A tak w ogóle wkrótce\Npojawi się nowa służka.
Dialogue: 0,0:02:55.98,0:02:57.40,Default,Maomao,0,0,0,,Nowa służka?
Dialogue: 0,0:02:58.07,0:03:03.37,Default,Ailan,0,0,0,,Teraz, gdy pani Gyokuyou jest w ciąży,\Nprzyda nam się kolejna para rąk.
Dialogue: 0,0:03:03.78,0:03:06.41,Default,Yinghua,0,0,0,,Jest jeszcze jeden powód.
Dialogue: 0,0:03:06.41,0:03:11.08,Default,Yinghua,0,0,0,,Nowej konkubinie\Ntowarzyszyło ponad 50 służek.
Dialogue: 0,0:03:11.54,0:03:13.79,Default,Yinghua,0,0,0,,Pani Gyokuyou też powinna\Nmieć jeszcze kilka, wiesz?
Dialogue: 0,0:03:13.79,0:03:15.21,Default,Maomao,0,0,0,,{\i0}Pewnie konkubina Loulan.
Dialogue: 0,0:03:15.96,0:03:18.92,Default,Maomao,0,0,0,,{\i0}To ma sens. Pani Gyokuyou\Nmając tylko pięć służek,
Dialogue: 0,0:03:18.92,0:03:22.09,Default,Maomao,0,0,0,,{\i0}choć jest ulubienicą cesarza,\Ndaje złą wróżbę.
Dialogue: 0,0:03:22.55,0:03:27.39,Default,Yinghua,0,0,0,,Kryształowy Pałac pani Li Hua\Nliczy trzydzieści osób, wliczając służki.
Dialogue: 0,0:03:27.39,0:03:30.43,Default,Yinghua,0,0,0,,Granatowy Pałac ma dwa\Nrazy więcej! To nie fair, co nie?
Dialogue: 0,0:03:30.81,0:03:35.69,Default,Ailan,0,0,0,,Yinghua, nie mów tak.\NPani Hongniang cię ochrzani.
Dialogue: 0,0:03:35.69,0:03:36.94,Default,Yinghua,0,0,0,,Ale...
Dialogue: 0,0:03:37.44,0:03:41.15,Default,Ailan,0,0,0,,Cóż, poczyniliśmy spore postępy.
Dialogue: 0,0:03:41.15,0:03:43.36,Default,Maomao,0,0,0,,Niewielka ilość jest w porządku?
Dialogue: 0,0:03:43.36,0:03:47.03,Default,Ailan,0,0,0,,Jest dobrze. Zamówiliśmy\Njuż kilka nowych i...
Dialogue: 0,0:03:47.37,0:03:49.95,Default,Yinghua,0,0,0,,Zresztą karawana wkrótce przybędzie!
Dialogue: 0,0:03:50.58,0:03:51.58,Default,Maomao,0,0,0,,Karawana?
Dialogue: 0,0:03:51.58,0:03:55.25,Default,Ailan,0,0,0,,Maomao nie było tutaj\Npoprzednim razem, prawda?
Dialogue: 0,0:03:55.92,0:03:59.46,Default,Yinghua,0,0,0,,Ta jest większa niż zwykle!
Dialogue: 0,0:03:59.92,0:04:02.47,Default,Maomao,0,0,0,,{\i0}Rozrywki w dzielnicy uciech\Njest pod dostatkiem,
Dialogue: 0,0:04:02.47,0:04:04.47,Default,Maomao,0,0,0,,{\i0}ale tutaj nie ma ich zbyt wiele,
Dialogue: 0,0:04:04.47,0:04:07.47,Default,Maomao,0,0,0,,{\i0}więc zakupy muszą\Nbyć czymś ekscytującym.
Dialogue: 0,0:04:07.47,0:04:11.23,Default,Yinghua,0,0,0,,Dopilnuję, byś też mogła\Nto sprawdzić, Maomao.
Dialogue: 0,0:04:11.23,0:04:15.00,Default,Yinghua,0,0,0,,Pani Gyokuyou zawsze\Ndaje nam kieszonkowe...
Dialogue: 0,0:04:15.53,0:04:16.66,Default,Yinghua,0,0,0,,Co się dzieje?
Dialogue: 0,0:04:18.48,0:04:22.82,Default,Hongniang,0,0,0,,Mniej gadania, więcej działania!
Dialogue: 0,0:04:25.32,0:04:29.41,Default,Gyokuyou,0,0,0,,Muszę uważać,\Nby nie rozgniewać Hongniang!
Dialogue: 0,0:04:29.41,0:04:32.71,Default,Hongniang,0,0,0,,Pani Gyokuyou, nie wygłupiaj się.
Dialogue: 0,0:04:49.18,0:04:51.72,Default,Shin,0,0,0,,Wzywałaś mnie, pani?
Dialogue: 0,0:04:52.06,0:04:54.59,Default,Lihua,0,0,0,,Shin, rozdaj to wszystkim.
Dialogue: 0,0:04:56.81,0:05:01.82,Default,Shin,0,0,0,,Zakupy w karawanach?\N Każę jednej ze służek się tym zająć.
Dialogue: 0,0:05:02.53,0:05:04.19,Default,Lihua,0,0,0,,Tak, dziękuję.
Dialogue: 0,0:05:19.04,0:05:22.80,Default,Susu,0,0,0,,Pani Shin, wiadomość z kliniki.
Dialogue: 0,0:05:23.51,0:05:25.38,Default,Shin,0,0,0,,Wiadomość z kliniki...?
Dialogue: 0,0:05:33.64,0:05:36.19,Default,Maomao,0,0,0,,{\i0}Karawana zatrzyma się na pięć dni.
Dialogue: 0,0:05:39.69,0:05:42.27,Default,Maomao,0,0,0,,{\i0}Służki takie jak ja
Dialogue: 0,0:05:42.27,0:05:45.74,Default,Maomao,0,0,0,,{\i0}nie mogą wpychać się przed razowca.
Dialogue: 0,0:05:46.07,0:05:50.57,Default,Xiaolan,0,0,0,,Zazdroszczę!\NTeż chcę jakieś nowe ciuszki!
Dialogue: 0,0:05:50.57,0:05:52.08,Default,Maomao,0,0,0,,I tak nie mamy okazji, by je założyć.
Dialogue: 0,0:05:52.08,0:05:53.79,Default,Xiaolan,0,0,0,,Wiem, ale i tak chcę!
Dialogue: 0,0:05:54.95,0:05:58.92,Default,Maomao,0,0,0,,{\i0}Wewnętrzny pałac to\Nnaprawdę specyficzne miejsce.
Dialogue: 0,0:05:58.92,0:06:01.75,Default,Maomao,0,0,0,,{\i0}Tyle ludzi, ale żadnych sklepów.
Dialogue: 0,0:06:01.75,0:06:04.55,Default,Maomao,0,0,0,,{\i0}Żadnych lekarzy\Npoza tym konowałem...
Dialogue: 0,0:06:05.05,0:06:08.51,Default,Maomao,0,0,0,,{\i0}Gdyby wybuchła choroba,\Nrozniosłaby się w trymiga,
Dialogue: 0,0:06:08.51,0:06:12.51,Default,Maomao,0,0,0,,{\i0}ale tak się nie stanie, bo higiena\Njest na najwyższym poziomie.
Dialogue: 0,0:06:13.06,0:06:15.14,Default,Maomao,0,0,0,,{\i0}Podziemna kanalizacja\Nodprowadzająca odpady
Dialogue: 0,0:06:15.14,0:06:18.02,Default,Maomao,0,0,0,,{\i0}prowadzi prosto do rzeki\Nz pominięciem fosy.
Dialogue: 0,0:06:18.39,0:06:20.40,Default,Maomao,0,0,0,,{\i0}To zachodnia technologia\Nuzdatniania wody,
Dialogue: 0,0:06:20.40,0:06:22.48,Default,Maomao,0,0,0,,{\i0}mądrze wykorzystana przez cesarzową.
Dialogue: 0,0:06:23.11,0:06:27.53,Default,Maomao,0,0,0,,{\i0}Dopóki przestrzega się właściwej higieny,\Nmożna zapobiec wielu chorobom.
Dialogue: 0,0:06:27.53,0:06:31.66,Default,Maomao,0,0,0,,{\i0}Osoby, które zachorują na poważną\Nchorobę, odsyła się do domu, ale...
Dialogue: 0,0:06:31.99,0:06:33.37,Default,Xiaolan,0,0,0,,Ej, Maomao.
Dialogue: 0,0:06:33.70,0:06:34.54,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:06:35.20,0:06:39.96,Default,Xiaolan,0,0,0,,Chyba uda mi się dostać\Nwolne ostatniego dnia.
Dialogue: 0,0:06:42.84,0:06:45.21,Default,Maomao,0,0,0,,{\i0}Mordka sama się cieszy,\Ngdy ktoś cię gdzieś zaprasza.
Dialogue: 0,0:06:53.60,0:06:55.89,Default,Gyokuyou,0,0,0,,Nie za dużo wydałam?
Dialogue: 0,0:06:56.43,0:06:59.73,Default,Hongniang,0,0,0,,Nie, mogłaś kupić więcej.
Dialogue: 0,0:06:59.73,0:07:02.56,Default,Hongniang,0,0,0,,Pozostałe konkubiny pewnie kupiły więcej.
Dialogue: 0,0:07:03.07,0:07:04.06,Default,Maomao,0,0,0,,{\i0}Prawda.
Dialogue: 0,0:07:04.77,0:07:08.90,Default,Maomao,0,0,0,,{\i0}Kobiety w Kryształowym Pałacu\Npewnie pójdą na całość.
Dialogue: 0,0:07:08.90,0:07:11.32,Default,Maomao,0,0,0,,{\i0}Konkubina Li Hua jest też dosyć hojna.
Dialogue: 0,0:07:11.78,0:07:13.14,Default,Maomao,0,0,0,,{\i0}W Diamentowym Pałacu
Dialogue: 0,0:07:13.14,0:07:18.08,Default,Maomao,0,0,0,,{\i0}służki na bank podlizują się pani Li Shu,\Nby kupiła im to, co zechcą.
Dialogue: 0,0:07:18.70,0:07:20.16,Default,Maomao,0,0,0,,{\i0}A jeśli chodzi o Granatowy Pałac,
Dialogue: 0,0:07:20.16,0:07:23.25,Default,Maomao,0,0,0,,{\i0}sprawa jest jasna, wiedząc,\Njak ekstrawagancka jest konkubina Loulan.
Dialogue: 0,0:07:24.08,0:07:27.71,Default,Maomao,0,0,0,,{\i0}W porównaniu z nimi konkubina Gyokuyou,\Nwydaje się oszczędna.
Dialogue: 0,0:07:28.17,0:07:30.67,Default,Hongniang,0,0,0,,Karawana kupców przybędzie również jutro,
Dialogue: 0,0:07:30.67,0:07:32.68,Default,Hongniang,0,0,0,,więc zostawmy to na później.
Dialogue: 0,0:07:32.68,0:07:33.51,Default,Yinghua,0,0,0,,Tak.
Dialogue: 0,0:07:38.02,0:07:39.06,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:07:39.93,0:07:41.02,Default,Guiyuan,0,0,0,,Stało się coś?
Dialogue: 0,0:07:42.06,0:07:46.98,Default,Maomao,0,0,0,,{\i0}Jest kilka szat z rękawami i spódnic\Nz pasami biegnącymi tuż pod klatką piersiową.
Dialogue: 0,0:07:47.65,0:07:50.28,Default,Maomao,0,0,0,,To były jedyne dostępne typy ubrań?
Dialogue: 0,0:07:50.28,0:07:52.24,Default,Guiyuan,0,0,0,,Te były wszędzie.
Dialogue: 0,0:07:52.24,0:07:54.87,Default,Ailan,0,0,0,,Podobno to ostatni krzyk mody.
Dialogue: 0,0:07:57.49,0:08:01.25,Default,Maomao,0,0,0,,{\i0}O ciąży pani Gyokuyou\Nnikt jeszcze nie wie.
Dialogue: 0,0:08:01.79,0:08:05.58,Default,Maomao,0,0,0,,{\i0}Z reguły sprowadzają ubrania,\Nktóre spodobają się klientom.
Dialogue: 0,0:08:05.58,0:08:09.09,Default,Maomao,0,0,0,,{\i0}W przypadku pani Gyokuyou będą\Nto sukienki z paskami wokół talii.
Dialogue: 0,0:08:09.09,0:08:14.01,Default,Maomao,0,0,0,,{\i0}Jednak gdyby jej brzuch urósł,\Nzdecydowałaby się na mniej opięte stroje.
Dialogue: 0,0:08:14.64,0:08:20.47,Default,Maomao,0,0,0,,{\i0}Czyżby świadomie przywieźli\Nte modele? Jeśli tak...
Dialogue: 0,0:08:21.02,0:08:23.56,Default,Maomao,0,0,0,,{\i0}Chcę myśleć, że przesadzam, ale...
Dialogue: 0,0:08:25.98,0:08:31.90,Default,Maomao,0,0,0,,Niech zapyta pani jutro, czy mają\Nwersje z ciasnymi paskami w talii.
Dialogue: 0,0:08:34.74,0:08:38.83,Default,Gyokuyou,0,0,0,,Zgoda, warto mieć\Nw zanadrzu różne wersje.
Dialogue: 0,0:08:39.66,0:08:42.62,Default,Gyokuyou,0,0,0,,Hongniang, zamień słówko z kupcami.
Dialogue: 0,0:08:42.62,0:08:43.46,Default,Hongniang,0,0,0,,Dobrze.
Dialogue: 0,0:08:45.00,0:08:48.21,Default,Maomao,0,0,0,,{\i0}Chyba obydwie dobrze zrozumiały\Nzaproponowaną aluzję.
Dialogue: 0,0:08:53.22,0:08:56.22,Default,Maomao,0,0,0,,{\i0}Widzę, że zostały same\Nresztki z poprzedniego dnia.
Dialogue: 0,0:08:56.55,0:08:59.56,Default,Xiaolan,0,0,0,,Rany! Ale super!
Dialogue: 0,0:09:07.65,0:09:10.94,Default,Maomao,0,0,0,,{\i0}Dostałam trochę kieszonkowego\Nod pani Gyokuyou, ale...
Dialogue: 0,0:09:14.07,0:09:15.20,Default,Maomao,0,0,0,,Wezmę to.
Dialogue: 0,0:09:17.74,0:09:18.62,Default,Maomao,0,0,0,,Pasuje ci.
Dialogue: 0,0:09:23.20,0:09:26.25,Default,Xiaolan,0,0,0,,Dzięki, Maomao!
Dialogue: 0,0:09:26.25,0:09:30.34,Default,Maomao,0,0,0,,{\i0}Gdybym miała młodszą siostrę,\Nteż byłaby taką bestyjką?
Dialogue: 0,0:09:30.71,0:09:33.92,Default,Xiaolan,0,0,0,,Są jakieś stragany, które chcesz\Nzobaczyć, Maomao? Pójdę z tobą!
Dialogue: 0,0:09:34.59,0:09:38.05,Default,Maomao,0,0,0,,Chciałabym się nieco rozejrzeć.
Dialogue: 0,0:09:40.47,0:09:45.48,Default,Maomao,0,0,0,,{\i0}Rzecz jasna nie ma tu leków,\Nsą za to herbaty i przyprawy.
Dialogue: 0,0:09:46.48,0:09:49.98,Default,Maomao,0,0,0,,{\i0}Jest jeszcze jeden powód,\N dla którego przyszłam ostatniego dnia.
Dialogue: 0,0:09:51.02,0:09:52.32,Default,Maomao,0,0,0,,{\i0}Wyprzedaże.
Dialogue: 0,0:09:53.07,0:09:55.07,Default,Maomao,0,0,0,,{\i0}Nie wierzę, że ceny za towary są uczciwe
Dialogue: 0,0:09:55.07,0:09:58.07,Default,Maomao,0,0,0,,{\i0}w takim miejscu,\Njak wewnętrzny pałac.
Dialogue: 0,0:09:58.07,0:10:00.66,Default,Maomao,0,0,0,,{\i0}Nie myślcie, że zrobicie mnie w bambuko!
Dialogue: 0,0:10:20.05,0:10:21.55,Default,Maomao,0,0,0,,{\i0}Jaśminowa herbata.
Dialogue: 0,0:10:22.85,0:10:24.14,Default,Maomao & Shisui,0,0,0,,— Poproszę to.
Dialogue: 0,0:10:24.47,0:10:25.14,Default,Maomao,0,0,0,,{\i0}Co?
Dialogue: 0,0:10:27.68,0:10:29.44,Default,Shisui,0,0,0,,Jak tam kotka?
Dialogue: 0,0:10:29.44,0:10:32.15,Default,Maomao,0,0,0,,{\i0}A, to ona...
Dialogue: 0,0:10:33.52,0:10:36.23,Default,Maomao,0,0,0,,Ma się dobrze.\NZamieszkała w klinice.
Dialogue: 0,0:10:36.23,0:10:37.99,Default,Shisui,0,0,0,,Czaję! Miło to słyszeć!
Dialogue: 0,0:10:38.45,0:10:41.32,Default,Xiaolan,0,0,0,,Też masz wolne, Shisui?
Dialogue: 0,0:10:41.32,0:10:43.84,Default,Shisui,0,0,0,,Tak! Ty widzę też, Xiaolan!
Dialogue: 0,0:10:43.84,0:10:45.24,Default,Shisui,0,0,0,,Co kupiłaś?
Dialogue: 0,0:10:45.24,0:10:47.12,Default,Xiaolan,0,0,0,,Tylko się rozglądam.
Dialogue: 0,0:10:47.12,0:10:50.71,Default,Xiaolan,0,0,0,,Maomao kupiła mi\Nwstążeczki do włosów!
Dialogue: 0,0:10:50.71,0:10:52.71,Default,Shisui,0,0,0,,Słodziaszne!
Dialogue: 0,0:10:52.71,0:10:54.59,Default,Maomao,0,0,0,,{\i0}Widzę, że się znają.
Dialogue: 0,0:10:54.59,0:10:58.13,Default,Maomao,0,0,0,,{\i0}Patrząc na to, że nosi\Ntaki sam strój jak Xiaolan,
Dialogue: 0,0:10:58.13,0:11:01.18,Default,Maomao,0,0,0,,{\i0}pewnie jest dwórką\Nkorzystającą z tej samej pralni.
Dialogue: 0,0:11:02.01,0:11:04.85,Default,Maomao,0,0,0,,Nie blokujmy przejścia.\NChodźmy gdzie indziej.
Dialogue: 0,0:11:05.35,0:11:06.93,Default,Maomao,0,0,0,,Poproszę trzy.
Dialogue: 0,0:11:08.43,0:11:11.81,Default,Guen,0,0,0,,Nie sądziłem,\Nże masz przyjaciół, panienko!
Dialogue: 0,0:11:12.23,0:11:17.44,Default,Maomao,0,0,0,,{\i0}Doktorek czasem potrafi wbić\Nszpilę i do tego się nie myli.
Dialogue: 0,0:11:19.49,0:11:21.07,Default,Xiaolan,0,0,0,,Ale słodziutka!
Dialogue: 0,0:11:21.07,0:11:22.45,Default,Shisui,0,0,0,,Jak się wabi?
Dialogue: 0,0:11:22.45,0:11:23.82,Default,Maomao,0,0,0,,Pogromca Złodziei.
Dialogue: 0,0:11:23.82,0:11:26.33,Default,Xiaolan,0,0,0,,Co? Dziwne imię!
Dialogue: 0,0:11:26.83,0:11:29.33,Default,Maomao,0,0,0,,{\i0}Mniej dziwaczne niż „Maomao”.
Dialogue: 0,0:11:30.21,0:11:31.87,Default,Guen,0,0,0,,Napijecie się herbaty?
Dialogue: 0,0:11:31.87,0:11:33.50,Default,Maomao,0,0,0,,Przyniosłam swoją.
Dialogue: 0,0:11:33.92,0:11:35.67,Default,Guen,0,0,0,,To ja przyniosę przekąski.
Dialogue: 0,0:11:48.60,0:11:50.68,Default,Shisui,0,0,0,,Ale ładnie pachnie.
Dialogue: 0,0:11:50.68,0:11:52.23,Default,Maomao,0,0,0,,Kwitnąca herbata jaśminowa.
Dialogue: 0,0:11:52.69,0:11:56.57,Default,Maomao,0,0,0,,Należy ją umieścić w nagrzanej\Nmiseczce i powoli wlewać letnią wodę,
Dialogue: 0,0:11:56.57,0:11:58.23,Default,Maomao,0,0,0,,i wtedy otwiera się pączek.
Dialogue: 0,0:11:58.65,0:12:01.19,Default,Maomao,0,0,0,,Pewnie nie będę miała\Nkiedy jej parzyć, ale...
Dialogue: 0,0:12:01.19,0:12:04.82,Default,Guen,0,0,0,,Drogie dziewczęta,\Ndziś mamy coś specjalnego.
Dialogue: 0,0:12:04.82,0:12:07.78,Default,Xiaolan,0,0,0,,Ciasteczka księżycowe!\NDziękujemy!
Dialogue: 0,0:12:10.45,0:12:15.04,Default,Shisui,0,0,0,,Zawsze tu tak jest?\NWielka uczta każdego dnia?
Dialogue: 0,0:12:15.04,0:12:17.88,Default,Maomao,0,0,0,,{\i0}Dla Shisui to też pierwsza karawana.
Dialogue: 0,0:12:17.88,0:12:20.88,Default,Maomao,0,0,0,,{\i0}Skoro przybyła w tym samym\Nczasie co konkubina Loulan,
Dialogue: 0,0:12:20.88,0:12:22.76,Default,Maomao,0,0,0,,{\i0}to jest tu od około sześciu miesięcy.
Dialogue: 0,0:12:23.30,0:12:26.85,Default,Xiaolan,0,0,0,,Tym razem jest dłużej niż zazwyczaj.
Dialogue: 0,0:12:27.14,0:12:31.73,Default,Guen,0,0,0,,Podobno dlatego, że wkrótce przybędzie\Nspecjalny wysłannik z innego kraju.
Dialogue: 0,0:12:31.73,0:12:34.44,Default,Xiaolan,0,0,0,,Pewnie to ktoś ważny.
Dialogue: 0,0:12:34.81,0:12:37.27,Default,Maomao,0,0,0,,{\i0}Pozwolono ci o tym gadać?
Dialogue: 0,0:12:37.27,0:12:38.94,Default,Shisui,0,0,0,,Swoją drogą,
Dialogue: 0,0:12:39.27,0:12:43.53,Default,Shisui,0,0,0,,ostatnio w północnej części miasta\Nunosi się dziwny zapach. Wiecie o tym?
Dialogue: 0,0:12:44.36,0:12:45.32,Default,Maomao,0,0,0,,W północnej części?
Dialogue: 0,0:12:45.32,0:12:46.87,Default,Xiaolan,0,0,0,,Nic a nic.
Dialogue: 0,0:12:46.87,0:12:48.91,Default,Guen,0,0,0,,Dziwny zapach?
Dialogue: 0,0:12:48.91,0:12:53.25,Default,Guen,0,0,0,,W tym rejonie jest nieco brudno.\NMoże jakiś kanał jest zatkany.
Dialogue: 0,0:12:53.25,0:12:55.79,Default,Maomao,0,0,0,,{\i0}Jeśli doszło do zatkania\Npodziemnej kanalizacji,
Dialogue: 0,0:12:55.79,0:12:58.38,Default,Maomao,0,0,0,,{\i0}smród mógłby dotrzeć na powierzchnię.
Dialogue: 0,0:12:58.96,0:13:01.46,Default,Xiaolan,0,0,0,,Tam pracujesz, Shisui?
Dialogue: 0,0:13:02.55,0:13:05.05,Default,Shisui,0,0,0,,Tak naprawdę są tam dobre krzewy.
Dialogue: 0,0:13:08.60,0:13:09.64,Default,Maomao,0,0,0,,Dobra jesteś.
Dialogue: 0,0:13:10.10,0:13:14.98,Default,Shisui,0,0,0,,Tak, sporo tu robali,\Nwięc jest co rysować!
Dialogue: 0,0:13:15.44,0:13:18.61,Default,Maomao,0,0,0,,{\i0}Robale to też świetne\Nskładniki do leków.
Dialogue: 0,0:13:18.61,0:13:21.44,Default,Maomao,0,0,0,,{\i0}Z kokonów modliszek\Nmożna stworzyć afrodyzjak,
Dialogue: 0,0:13:21.44,0:13:23.15,Default,Maomao,0,0,0,,{\i0}a dżdżownice pomagają obniżyć gorączkę.
Dialogue: 0,0:13:23.69,0:13:27.86,Default,Shisui,0,0,0,,Owocowy ogród na południowej stronie jest\Nbardzo zadbany, więc nie ma ich tam dużo.
Dialogue: 0,0:13:27.86,0:13:30.33,Default,Shisui,0,0,0,,A ruiny na północnej stronie\Nsą naprawdę zajefajne!
Dialogue: 0,0:13:30.33,0:13:32.29,Default,Shisui,0,0,0,,Są tam nawet ogromniaste pająki!
Dialogue: 0,0:13:32.29,0:13:36.96,Default,Maomao,0,0,0,,Pająki?! Jeszcze ich nie\Npróbowałam, bo trudno je znaleźć,
Dialogue: 0,0:13:36.96,0:13:39.75,Default,Maomao,0,0,0,,ale podobno nici pajęcze\Nmogą zatamować krew.
Dialogue: 0,0:13:39.75,0:13:41.75,Default,Shisui,0,0,0,,Chcesz iść i zobaczyć?
Dialogue: 0,0:13:41.75,0:13:43.09,Default,Maomao,0,0,0,,Jasne, że tak.
Dialogue: 0,0:13:43.09,0:13:46.13,Default,Shisui,0,0,0,,Patrz! Ten ma piękne kolory,\Njest pulchniutki i uroczy.
Dialogue: 0,0:13:46.13,0:13:48.76,Default,Shisui,0,0,0,,Palce lizać. Na pewno\Nci zasmakują! Poza tym...
Dialogue: 0,0:14:08.66,0:14:10.66,Default,Maomao,0,0,0,,{\i0}Kilka dni po wyjeździe karawany...
Dialogue: 0,0:14:11.07,0:14:14.37,Default,Maomao,0,0,0,,{\i0}Olejki zapachowe zrobiły\Nfurorę w wewnętrznym pałacu.
Dialogue: 0,0:14:16.54,0:14:17.96,Default,Xiaolan,0,0,0,,Ale cuchnie...
Dialogue: 0,0:14:19.42,0:14:21.04,Default,Maomao,0,0,0,,Wali, aż nos odpada.
Dialogue: 0,0:14:21.71,0:14:24.46,Default,Maomao,0,0,0,,{\i0}Produkty sprowadzane\Nz zachodu mają silną woń.
Dialogue: 0,0:14:24.46,0:14:27.92,Default,Maomao,0,0,0,,{\i0}Pojedynczo może i ładnie pachną,\Nale zmieszane razem są okropne.
Dialogue: 0,0:14:30.26,0:14:31.85,Default,Servant girl,0,0,0,,Przepraszam!
Dialogue: 0,0:14:36.22,0:14:37.73,Default,Maomao,0,0,0,,{\i0}Róża, co?
Dialogue: 0,0:14:37.73,0:14:41.94,Default,Maomao,0,0,0,,{\i0}Gdybym sprzedała wodę różaną, którą\Nwcześniej zrobiłam, to bym coś zarobiła.
Dialogue: 0,0:14:42.40,0:14:48.15,Default,Maomao,0,0,0,,{\i0}Nie, zbyt mocny zapach róż\Nma negatywny wpływ na ciążę.
Dialogue: 0,0:14:48.15,0:14:50.03,Default,Maomao,0,0,0,,{\i0}Obecnie Jadeitowy Pałac nie może...
Dialogue: 0,0:14:55.83,0:14:57.00,Default,Maomao,0,0,0,,Ten zapach też...
Dialogue: 0,0:15:08.05,0:15:09.17,Default,Maomao,0,0,0,,{\i0}Muszę iść.
Dialogue: 0,0:15:09.43,0:15:11.43,Default,Maomao,0,0,0,,{\i0}Do miejsca, gdzie trendy\Nwywierają największy wpływ...
Dialogue: 0,0:15:11.97,0:15:13.35,Default,Maomao,0,0,0,,{\i0}Do Kryształowego Pałacu!
Dialogue: 0,0:15:24.48,0:15:27.03,Default,Shin,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:15:30.20,0:15:34.12,Default,Jinshi,0,0,0,,Główna służka w Kryształowym\NPałacu, Shin, złożyła oficjalną skargę.
Dialogue: 0,0:15:34.66,0:15:37.87,Default,Jinshi,0,0,0,,Sądziłem, że jesteście mądrzejsze.
Dialogue: 0,0:15:37.87,0:15:43.25,Default,Maomao,0,0,0,,Przepraszam. Zdenerwowałam\Nsię i postąpiłam bezmyślnie.
Dialogue: 0,0:15:43.25,0:15:45.96,Default,Jinshi,0,0,0,,Gadasz jak zboczeniec\Nszukający wymówek.
Dialogue: 0,0:15:45.96,0:15:47.96,Default,Maomao,0,0,0,,Następnym razem poproszę\No pozwolenie, nim kogoś obniucham.
Dialogue: 0,0:15:47.96,0:15:48.88,Default,Jinshi,0,0,0,,{\an8}Po co w ogóle je wąchać?!
Dialogue: 0,0:15:48.88,0:15:49.88,Default,Gyokuyou,0,0,0,,O rany.
Dialogue: 0,0:15:53.22,0:15:55.10,Default,Maomao,0,0,0,,{\i0}Starczy już tych przeprosin.
Dialogue: 0,0:15:55.80,0:15:57.51,Default,Maomao,0,0,0,,Miałam ku temu powód.
Dialogue: 0,0:15:58.06,0:15:59.98,Default,Jinshi,0,0,0,,A był on jakiś dobry?
Dialogue: 0,0:16:01.02,0:16:01.85,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:16:03.59,0:16:08.32,Default,Maomao,0,0,0,,Panie Jinshi, czy możesz\Nprzeczytać tę listę na głos?
Dialogue: 0,0:16:08.32,0:16:08.94,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:16:09.23,0:16:13.66,Default,Jinshi,0,0,0,,Róża, benzoes, parasol chiński,\Nkadzidłowiec, cynamon?
Dialogue: 0,0:16:13.99,0:16:16.16,Default,Gyokuyou,0,0,0,,To chyba nazwy zapachów.
Dialogue: 0,0:16:16.45,0:16:22.25,Default,Maomao,0,0,0,,Tak. Są to nazwy zapachów i olejków,\Nktóre wyczułam dziś na dworskich damach.
Dialogue: 0,0:16:22.71,0:16:24.42,Default,Jinshi,0,0,0,,Co z nimi?
Dialogue: 0,0:16:24.42,0:16:26.84,Default,Maomao,0,0,0,,Każdy z nich może mieć\Nszkodliwy wpływ na ciężarne kobiety.
Dialogue: 0,0:16:32.13,0:16:33.01,Default,Gyokuyou,0,0,0,,Mów dalej.
Dialogue: 0,0:16:33.43,0:16:38.39,Default,Maomao,0,0,0,,Prócz olejków zapachowych karawana\Nsprzedawała także przyprawy i herbaty.
Dialogue: 0,0:16:38.72,0:16:41.02,Default,Maomao,0,0,0,,Kupiłam właśnie te.
Dialogue: 0,0:16:41.85,0:16:45.74,Default,Maomao,0,0,0,,Jaśmin ma działanie zwężające macicę.
Dialogue: 0,0:16:45.74,0:16:50.07,Default,Maomao,0,0,0,,Gorczycę często stosuje się jako element\Nleków poronnych dla kurtyzan.
Dialogue: 0,0:16:50.65,0:16:55.66,Default,Jinshi,0,0,0,,Więc stosując je, wzrasta ryzyko poronienia?
Dialogue: 0,0:16:55.99,0:16:59.20,Default,Maomao,0,0,0,,W małych ilościach\Nnie stanowią one problemu.
Dialogue: 0,0:16:59.20,0:17:02.91,Default,Maomao,0,0,0,,Szkodzą wtedy, gdy są używane w zbyt\Ndużych dawkach lub w niewłaściwy sposób.
Dialogue: 0,0:17:03.37,0:17:06.04,Default,Maomao,0,0,0,,{\i0}Powinnam była zauważyć to wcześniej.
Dialogue: 0,0:17:06.04,0:17:08.96,Default,Maomao,0,0,0,,{\i0}Chyba ta świąteczna atmosfera\Nprzyćmiła mój móżdżek.
Dialogue: 0,0:17:11.76,0:17:14.17,Default,Maomao,0,0,0,,Możesz ustalić, kim byli kupcy?
Dialogue: 0,0:17:14.17,0:17:20.31,Default,Jinshi,0,0,0,,Tak, ale wątpię, by mieli spis\Nwszystkich sprzedanych przedmiotów.
Dialogue: 0,0:17:21.73,0:17:24.43,Default,Jinshi,0,0,0,,Sprawdziliśmy przecież każdego...
Dialogue: 0,0:17:26.27,0:17:28.69,Default,Maomao,0,0,0,,Nie przypomina to innego zdarzenia?
Dialogue: 0,0:17:28.69,0:17:29.81,Default,Jinshi,0,0,0,,O czym mówisz?
Dialogue: 0,0:17:30.34,0:17:32.82,Default,Maomao,0,0,0,,Coś, czego skutków ubocznych nikt nie zna.
Dialogue: 0,0:17:33.80,0:17:36.28,Default,Maomao,0,0,0,,Coś, co nie jest niczym nowym\Nw wewnętrznym pałacu.
Dialogue: 0,0:17:37.09,0:17:40.60,Default,Maomao,0,0,0,,Czy to nie to samo, co doprowadziło\Ndo choroby księżniczki Ling Li?
Dialogue: 0,0:17:40.60,0:17:42.95,Default,Maomao,0,0,0,,I doprowadziło do śmierci\Ndziecka konkubiny Li Hua?
Dialogue: 0,0:17:43.58,0:17:45.66,Default,Gyokuyou,0,0,0,,Toksyczny puder do...
Dialogue: 0,0:17:48.46,0:17:51.21,Default,Maomao,0,0,0,,Dokładnie. Chodzi o puder\Ndo twarzy, który zawierał ołów.
Dialogue: 0,0:17:52.46,0:17:58.51,Default,Jinshi,0,0,0,,Zatem można założyć, że ktoś próbował\Nprzemycić truciznę do wewnętrznego pałacu?
Dialogue: 0,0:17:59.63,0:18:02.68,Default,Maomao,0,0,0,,Wiem jedynie, że sprowadzono tutaj
Dialogue: 0,0:18:02.68,0:18:06.10,Default,Maomao,0,0,0,,dość sporo rzeczy,\Nz których można zrobić trucizny.
Dialogue: 0,0:18:06.81,0:18:10.27,Default,Maomao,0,0,0,,Przy normalnym użytkowaniu\Nnie są one uważane za toksyczne.
Dialogue: 0,0:18:10.90,0:18:14.15,Default,Maomao,0,0,0,,Powinniśmy ostrzec pozostałe konkubiny.
Dialogue: 0,0:18:16.19,0:18:17.15,Default,Jinshi,0,0,0,,Gaoshun.
Dialogue: 0,0:18:17.15,0:18:18.61,Default,Gaoshun,0,0,0,,Tak, panie Jinshi.
Dialogue: 0,0:18:19.53,0:18:20.82,Default,Maomao,0,0,0,,{\i0}Sytuacja przypomina tamten przypadek,
Dialogue: 0,0:18:20.82,0:18:23.54,Default,Maomao,0,0,0,,{\i0}a zbiegi okoliczności łączą się ze sobą.
Dialogue: 0,0:18:24.45,0:18:26.08,Default,Gyokuyou,0,0,0,,Hongniang, proszę.
Dialogue: 0,0:18:26.08,0:18:27.37,Default,Hongniang,0,0,0,,Tak, pani Gyokuyou.
Dialogue: 0,0:18:27.87,0:18:32.42,Default,Hongniang,0,0,0,,Guiyuan, przejrzyj olejki zapachowe,\Nprzyprawy i herbaty w Jadeitowym Pałacu.
Dialogue: 0,0:18:32.42,0:18:33.38,Default,Guiyuan,0,0,0,,Tak!
Dialogue: 0,0:18:34.09,0:18:40.30,Default,Maomao,0,0,0,,{\i0}Nadal nie odnaleziono Suirei,\Ndwórki, która ożyła i zbiegła.
Dialogue: 0,0:18:44.47,0:18:49.89,Default,Maomao,0,0,0,,{\i0}W próbie zamachu podczas ceremonii\Nteż na pewno sporo osób maczało paluchy.
Dialogue: 0,0:18:50.98,0:18:53.73,Default,Maomao,0,0,0,,{\i0}Jak daleko mogą\Nsięgać te ich paluchy?
Dialogue: 0,0:18:57.19,0:19:00.91,Default,Maomao,0,0,0,,{\i0}Co jest domysłem, a co prawdą?
Dialogue: 0,0:19:01.20,0:19:03.94,Default,Luomen,0,0,0,,{\i0}Nie powinnaś opierać się na domysłach.
Dialogue: 0,0:19:09.41,0:19:11.37,Default,Maomao,0,0,0,,{\i0}Gdybym nie pracowała dla konkubiny,
Dialogue: 0,0:19:11.37,0:19:15.30,Default,Maomao,0,0,0,,{\i0}nie zarobiłabym tyle,\Nby kupić coś u karawany.
Dialogue: 0,0:19:16.09,0:19:19.59,Default,Maomao,0,0,0,,{\i0}Gdyby olejki zapachowe nie były\Ntak popularne, nie zorientowałabym się.
Dialogue: 0,0:19:20.05,0:19:23.05,Default,Maomao,0,0,0,,{\i0}Może to jedyny raz,\Nkiedy sprowadzono ich tak dużo.
Dialogue: 0,0:19:23.80,0:19:27.64,Default,Maomao,0,0,0,,Co z tego jest przypadkiem,\Na co zostało zaplanowane?
Dialogue: 0,0:19:27.64,0:19:29.81,Default,Maomao,0,0,0,,Nie potrafię tego określić.
Dialogue: 0,0:19:33.06,0:19:34.56,Default,Maomao,0,0,0,,Jestem zmęczona.
Dialogue: 0,0:19:36.77,0:19:38.57,Default,Maomao,0,0,0,,Tęsknię za czasami,
Dialogue: 0,0:19:38.57,0:19:44.07,Default,Maomao,0,0,0,,gdy moje siostrzyczki pozwalały mi pić,\Nkiedy nie było w pobliżu klientów...
Dialogue: 0,0:19:51.04,0:19:53.14,Default,Jinshi,0,0,0,,Myślałem, że to trucizna.
Dialogue: 0,0:19:55.88,0:19:59.21,Default,Maomao,0,0,0,,W niewielkich ilościach\Ntrucizny mogą być lekami.
Dialogue: 0,0:19:59.21,0:20:03.84,Default,Maomao,0,0,0,,Zresztą nie jest ona na tyle\Nsilna w tak małej ilości herbaty.
Dialogue: 0,0:20:03.84,0:20:06.01,Default,Maomao,0,0,0,,I nie jestem w ciąży.
Dialogue: 0,0:20:06.43,0:20:08.18,Default,Jinshi,0,0,0,,To prawda.
Dialogue: 0,0:20:08.18,0:20:13.23,Default,Maomao,0,0,0,,Co więcej, to jest kuchnia.\NNie jest to miejsce dla ciebie.
Dialogue: 0,0:20:13.23,0:20:15.02,Default,Jinshi,0,0,0,,Nie bądź taka ostra.
Dialogue: 0,0:20:15.69,0:20:17.73,Default,Maomao,0,0,0,,Gdzie pan Gaoshun?
Dialogue: 0,0:20:18.27,0:20:19.86,Default,Jinshi,0,0,0,,Przekazuje wiadomości.
Dialogue: 0,0:20:20.44,0:20:22.15,Default,Jinshi,0,0,0,,Zrobisz mi też herbaty?
Dialogue: 0,0:20:22.61,0:20:24.53,Default,Maomao,0,0,0,,Jaką sobie życzysz?
Dialogue: 0,0:20:24.53,0:20:26.12,Default,Jinshi,0,0,0,,Taką jak ty.
Dialogue: 0,0:20:26.12,0:20:27.37,Default,Maomao,0,0,0,,Więcej nie mam.
Dialogue: 0,0:20:27.95,0:20:30.79,Default,Maomao,0,0,0,,Po kolejnym zaparzeniu będzie wodnista.
Dialogue: 0,0:20:30.79,0:20:31.66,Default,Jinshi,0,0,0,,W porządku.
Dialogue: 0,0:20:32.66,0:20:34.50,Default,Maomao,0,0,0,,{\i0}Może dla ciebie...
Dialogue: 0,0:20:37.21,0:20:39.30,Default,Jinshi,0,0,0,,Jakie właściwości ma ta herbata?
Dialogue: 0,0:20:39.80,0:20:41.55,Default,Maomao,0,0,0,,Uspokaja umysł.
Dialogue: 0,0:20:42.17,0:20:45.93,Default,Maomao,0,0,0,,Poprawia jakość snu\Ni pomaga się rozbudzić.
Dialogue: 0,0:20:45.93,0:20:49.18,Default,Maomao,0,0,0,,Nie jest dobra dla kobiet w ciąży,
Dialogue: 0,0:20:49.18,0:20:52.93,Default,Maomao,0,0,0,,ale słyszałam, że pomaga przy porodzie.
Dialogue: 0,0:20:53.39,0:20:55.44,Default,Jinshi,0,0,0,,Zatem ma więcej dobrych\Nniż złych działań.
Dialogue: 0,0:20:55.44,0:20:59.36,Default,Maomao,0,0,0,,Tak. Dlatego tak trudno\Njest pamiętać te złe skutki.
Dialogue: 0,0:21:06.13,0:21:07.49,Default,Maomao,0,0,0,,Biała herbata.
Dialogue: 0,0:21:07.49,0:21:09.16,Default,Jinshi,0,0,0,,Przecież mówiłem, że chcę tamtą.
Dialogue: 0,0:21:10.74,0:21:14.62,Default,Maomao,0,0,0,,Z tego, co słyszałam,\Njaśmin ma też inne działanie.
Dialogue: 0,0:21:14.96,0:21:15.62,Default,Jinshi,0,0,0,,Jakie?
Dialogue: 0,0:21:15.62,0:21:19.09,Default,Maomao,0,0,0,,Obniżona płodność,\Nszczególnie u mężczyzn.
Dialogue: 0,0:21:21.80,0:21:25.46,Default,Maomao,0,0,0,,{\i0}Rany, chyba przesadziłam z tym żartem.
Dialogue: 0,0:21:25.46,0:21:26.76,Default,Maomao,0,0,0,,{\i0}Przyniosę jakąś przekąskę...
Dialogue: 0,0:21:35.56,0:21:38.19,Default,Jinshi,0,0,0,,Paskudna. Wychodzę.
Dialogue: 0,0:21:40.23,0:21:41.73,Default,Maomao,0,0,0,,{\i0}Nawaliłam!
Dialogue: 0,0:21:47.64,0:21:48.78,Default,Gaoshun,0,0,0,,Panie Jinshi.
Dialogue: 0,0:21:49.20,0:21:50.66,Default,Jinshi,0,0,0,,Przekazałeś wiadomości?
Dialogue: 0,0:21:50.66,0:21:52.04,Default,Gaoshun,0,0,0,,Tak. Ponadto
Dialogue: 0,0:21:52.79,0:21:55.41,Default,Gaoshun,0,0,0,,zmarła konkubina średniej rangi, Jin.
Dialogue: 0,0:21:55.41,0:21:56.43,Default,Jinshi,0,0,0,,Konkubina Jin?
Dialogue: 0,0:22:00.92,0:22:01.88,Default,Jinshi,0,0,0,,Trucizna?
Dialogue: 0,0:22:02.75,0:22:03.77,Default,Jinshi,0,0,0,,Czyżby?
Dialogue: 0,0:23:45.07,0:23:48.00,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.35,0:24:00.00,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Trupi grzyb”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
