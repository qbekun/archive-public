Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:31.02,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:37.67,0:01:38.90,Default,Luomen,0,0,0,,Maomao.
Dialogue: 0,0:01:39.32,0:01:40.35,Default,Maomao,0,0,0,,Tak?
Dialogue: 0,0:01:41.16,0:01:44.44,Default,Luomen,0,0,0,,Czy mogłabyś dostarczyć lekarstwa\Ndo Grynszpanowego Pawilonu?
Dialogue: 0,0:01:44.85,0:01:46.87,Default,Maomao,0,0,0,,Jasne, tato.
Dialogue: 0,0:01:48.38,0:01:52.57,Default,Luomen,0,0,0,,Ostatnio wzrosła liczba\Nporwań, więc uważaj na siebie.
Dialogue: 0,0:01:52.57,0:01:55.63,Default,Maomao,0,0,0,,Nic mi nie będzie. Wracając,\Nnazrywam trochę ziół.
Dialogue: 0,0:01:56.01,0:01:57.88,Default,Luomen,0,0,0,,Dobrze, skoro chcesz.
Dialogue: 0,0:01:58.37,0:01:59.51,Default,Maomao,0,0,0,,To lecę!
Dialogue: 0,0:02:15.36,0:02:17.86,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:02:22.83,0:02:25.20,Default,Old Lady,0,0,0,,To wszystko, co masz?
Dialogue: 0,0:02:25.20,0:02:27.72,Default,Customer,0,0,0,,To oszczędności mojego życia. \NMiej litość!
Dialogue: 0,0:02:31.58,0:02:34.55,Default,Old Lady,0,0,0,,Cudów się nie spodziewaj.
Dialogue: 0,0:02:34.55,0:02:38.64,Default,Customer,0,0,0,,To na pewno Pairin, jedna z Trzech\NKsiężniczek Grynszpanowego Pawilonu!
Dialogue: 0,0:02:38.64,0:02:40.51,Default,Old Lady,0,0,0,,Jak chcesz się pogapić, dawaj hajs!
Dialogue: 0,0:02:49.03,0:02:51.64,Default,Maomao,0,0,0,,Gojenie trwa zbyt długo.
Dialogue: 0,0:02:51.64,0:02:52.97,Default,Maomao,0,0,0,,Przerobię trochę przepis.
Dialogue: 0,0:02:52.97,0:02:54.73,Default,Pairin,0,0,0,,O, Maomao!
Dialogue: 0,0:02:55.21,0:02:56.80,Default,Maomao,0,0,0,,Siemka, Pairin.
Dialogue: 0,0:02:56.80,0:02:59.03,Default,Pairin,0,0,0,,Znowu coś sobie zrobiłaś?
Dialogue: 0,0:03:00.39,0:03:02.41,Default,Maomao,0,0,0,,Tylko takie tam moje eksperymenty.
Dialogue: 0,0:03:03.62,0:03:05.32,Default,Pairin,0,0,0,,Dobrze się odżywiasz?
Dialogue: 0,0:03:05.32,0:03:08.06,Default,Maomao,0,0,0,,Na pewno gorzej niż ty.
Dialogue: 0,0:03:08.06,0:03:09.29,Default,Old Lady,0,0,0,,Maomao!
Dialogue: 0,0:03:09.29,0:03:14.00,Default,Old Lady,0,0,0,,Tylko żeby te twoje ekperymenciki\Nnie wysadziły nas w powietrze!
Dialogue: 0,0:03:16.34,0:03:19.09,Default,Old Lady,0,0,0,,A może chciałabyś zostać kurtyzaną?
Dialogue: 0,0:03:20.79,0:03:22.81,Default,Maomao,0,0,0,,Staruszko, zostawiłam ci leki!
Dialogue: 0,0:03:22.81,0:03:25.94,Default,Old Lady,0,0,0,,Pozdrów ode mnie swojego staruszka.
Dialogue: 0,0:03:25.94,0:03:27.79,Default,Joka,0,0,0,,Czy ja słyszałam głos Maomao?
Dialogue: 0,0:03:27.79,0:03:29.42,Default,Meimei,0,0,0,,Maomao tu była?
Dialogue: 0,0:03:29.42,0:03:31.06,Default,Pairin,0,0,0,,Poszła już.
Dialogue: 0,0:03:31.06,0:03:34.81,Default,Maomao,0,0,0,,Ta walnięta starucha ciągle\Npróbuje zrobić ze mnie kurtyzanę…
Dialogue: 0,0:03:50.82,0:03:52.54,Default,Maomao,0,0,0,,Porywacze? Na serio?!
Dialogue: 0,0:03:58.63,0:04:01.30,Default,Maomao,0,0,0,,Ojczulek będzie się martwił…
Dialogue: 0,0:04:18.90,0:04:20.84,Default,Guen,0,0,0,,Książę się narodził!
Dialogue: 0,0:04:20.84,0:04:23.07,Default,Guen,0,0,0,,Gratulacje, pani Li Hua!
Dialogue: 0,0:04:30.98,0:04:33.54,Default,Hongniang,0,0,0,,Książę bezpiecznie przyszedł na świat.
Dialogue: 0,0:04:33.54,0:04:35.67,Default,Gyokuyou,0,0,0,,Tak? Całe szczęście.
Dialogue: 0,0:04:40.67,0:04:43.88,Default,Text,0,0,0,,{\an8}TRZY MIESIĄCE PÓŹNIEJ
Dialogue: 0,0:04:44.17,0:04:48.18,Default,Episode Title,0,0,0,,{\an8}ODCINEK 1: MAOMAO
Dialogue: 0,0:04:48.75,0:04:51.89,Default,Maomao,0,0,0,,Zjadłabym sobie szaszłyczka.
Dialogue: 0,0:04:52.71,0:04:55.64,Default,Maomao,0,0,0,,Ciekawe, czy ojczulek \Ndobrze się odżywia.
Dialogue: 0,0:04:57.11,0:05:03.18,Default,Maomao,0,0,0,,Nie wiem, czy mnie sprzedano, czy\Nkupiono, ale mijają trzy miesiące.
Dialogue: 0,0:05:04.19,0:05:07.50,Default,Maomao,0,0,0,,Cesarski dwór czy dzielnica uciech,\Nżadna różnica.
Dialogue: 0,0:05:07.50,0:05:11.41,Default,Maomao,0,0,0,,Gdybym mogła, nie chciałabym mieć\Nz tym miejscem nic wspólnego, ale…
Dialogue: 0,0:05:12.63,0:05:15.41,Default,Maomao,0,0,0,,No cóż. Co mam poradzić?
Dialogue: 0,0:05:15.94,0:05:19.84,Default,Maomao,0,0,0,,Żyło mi się całkiem dobrze\Njako zielarka, a teraz…
Dialogue: 0,0:05:21.15,0:05:25.50,Default,Maomao,0,0,0,,Wewnętrzny pałac to ogród kobiet,\Nktóre mają rodzić potomstwo cesarzowi.
Dialogue: 0,0:05:25.50,0:05:27.99,Default,Maomao,0,0,0,,Mężczyźni nie mają tu wstępu.
Dialogue: 0,0:05:28.74,0:05:33.22,Default,Maomao,0,0,0,,Jedynie cesarz i jego rodzina\Nmogą tam przebywać,
Dialogue: 0,0:05:33.54,0:05:38.85,Default,Maomao,0,0,0,,a także eunochowie, czyli ci,\Nktórzy utracili swoją męskość.
Dialogue: 0,0:05:39.40,0:05:42.62,Default,Maomao,0,0,0,,To pokaźna zbieranina dwóch tysięcy\Nkonkubin i służących,
Dialogue: 0,0:05:42.62,0:05:44.97,Default,Maomao,0,0,0,,a także tysiąca eunuchów.
Dialogue: 0,0:05:45.67,0:05:49.37,Default,Maomao,0,0,0,,W przeciwieństwie do konkubin\Nnajwyższej, pośredniej i niskiej rangi,
Dialogue: 0,0:05:49.37,0:05:54.37,Default,Maomao,0,0,0,,my, służki, jesteśmy zbędne\Ni w każdej chwili mogą nas zabić.
Dialogue: 0,0:05:56.05,0:05:58.96,Default,Maomao,0,0,0,,Następne w kolejce\Nsą konkubiny o niskiej randze.
Dialogue: 0,0:05:58.96,0:06:02.40,Default,Maomao,0,0,0,,Przynajmniej mi za to zapłacą.
Dialogue: 0,0:06:02.40,0:06:04.60,Default,Xiaolan,0,0,0,,Hej, Maomao…
Dialogue: 0,0:06:04.60,0:06:07.34,Default,Xiaolan,0,0,0,,Wiesz może, do którego\Npokoju jest ta tabliczka?
Dialogue: 0,0:06:07.34,0:06:11.43,Default,Maomao,0,0,0,,A, Wisteria 9, o tam.
Dialogue: 0,0:06:11.81,0:06:13.43,Default,Xiaolan,0,0,0,,Dziękuję!
Dialogue: 0,0:06:14.07,0:06:16.85,Default,Maomao,0,0,0,,Wiele służek nie umie czytać ani pisać.
Dialogue: 0,0:06:17.45,0:06:19.10,Default,Maomao,0,0,0,,Aby mogły pracować w pałacu,
Dialogue: 0,0:06:19.10,0:06:22.01,Default,Maomao,0,0,0,,uczy się je jedynie podstaw etykiety.
Dialogue: 0,0:06:22.01,0:06:24.74,Default,Maomao,0,0,0,,Czytanie i pisanie to\Nzupełnie inna historia.
Dialogue: 0,0:06:25.31,0:06:31.62,Default,Maomao,0,0,0,,Za znajomość pisma dostałabym podwyżkę,\Nale porywacze by mi ją zabrali.
Dialogue: 0,0:06:32.53,0:06:36.67,Default,Maomao,0,0,0,,Nawet takie służki jak my mogą kiedyś\Nstać się konkubinami niskiej rangi.
Dialogue: 0,0:06:36.67,0:06:37.72,Default,Maomao,0,0,0,,Najważniejsze to…
Dialogue: 0,0:06:39.99,0:06:41.38,Default,Maomao,0,0,0,,Wygląd.
Dialogue: 0,0:06:41.38,0:06:42.63,Default,Maomao,0,0,0,,Piegowata
Dialogue: 0,0:06:42.89,0:06:43.98,Default,Maomao,0,0,0,,deska.
Dialogue: 0,0:06:44.26,0:06:48.06,Default,Maomao,0,0,0,,Więc nie mam się czym martwić,\Nmi to nie grozi.
Dialogue: 0,0:06:53.48,0:06:58.14,Default,Maomao,0,0,0,,Gdybym się wyróżniała, moje życie byłoby\Nzagrożone. Lepiej się nie wychylać.
Dialogue: 0,0:06:59.44,0:07:02.46,Default,Maomao,0,0,0,,Dzięki ciężkiej harówce\Nuwolnię się za dwa lata.
Dialogue: 0,0:07:04.33,0:07:06.39,Default,Maomao,0,0,0,,Pić mi się chcę.
Dialogue: 0,0:07:09.22,0:07:11.20,Default,Xiaolan,0,0,0,,— Ej, słyszałaś?\N— Co?
Dialogue: 0,0:07:11.20,0:07:15.18,Default,Xiaolan,0,0,0,,Podobno w okolicy pojawił\Nsię jakiś przystojny eunuch.
Dialogue: 0,0:07:15.18,0:07:18.50,Default,Xiaolan,0,0,0,,Wszyscy o nim gadają.
Dialogue: 0,0:07:18.50,0:07:19.98,Default,Maomao,0,0,0,,Aha.
Dialogue: 0,0:07:19.98,0:07:23.28,Default,Xiaolan,0,0,0,,Chętnie bym się przyjrzała,\Nczy jest taki przystojny!
Dialogue: 0,0:07:23.28,0:07:24.37,Default,Xiaolan,0,0,0,,A ty?
Dialogue: 0,0:07:25.09,0:07:26.95,Default,Maomao,0,0,0,,Eunuch, ta?
Dialogue: 0,0:07:55.21,0:07:57.45,Default,Gaoshun,0,0,0,,Bardzo mocno schudła.
Dialogue: 0,0:07:57.45,0:07:58.53,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:08:04.91,0:08:06.34,Default,Gyokuyou,0,0,0,,Xiaoling…
Dialogue: 0,0:08:06.34,0:08:11.88,Default,Jinshi,0,0,0,,Przykro mi, lekarz zajmuje się księciem.
Dialogue: 0,0:08:13.87,0:08:15.09,Default,Gyokuyou,0,0,0,,Rozumiem.
Dialogue: 0,0:08:17.01,0:08:19.73,Default,Servant A,0,0,0,,Jedno ma trzy,\Na drugie sześć miesięcy, prawda?
Dialogue: 0,0:08:19.73,0:08:23.40,Default,Servant B,0,0,0,,Tak, zarówno książę,\Njak i księżniczka Ling Li…
Dialogue: 0,0:08:24.09,0:08:26.10,Default,Xiaolan,0,0,0,,Może to naprawdę klątwa?!
Dialogue: 0,0:08:27.17,0:08:28.36,Default,Maomao,0,0,0,,O czym ty gadasz?
Dialogue: 0,0:08:28.36,0:08:30.80,Default,Xiaolan,0,0,0,,Nie słyszałaś, Maomao?
Dialogue: 0,0:08:30.80,0:08:34.25,Default,Xialoan,0,0,0,,Cały pałac huczy od tych plotek.
Dialogue: 0,0:08:34.66,0:08:37.85,Default,Xiaolan,0,0,0,,W pałacu umierają kolejni dziedzice!
Dialogue: 0,0:08:38.37,0:08:43.97,Default,Xiaolan,0,0,0,,Trójka dzieci cesarza\Nzmarła chwilę po urodzeniu!
Dialogue: 0,0:08:43.97,0:08:45.58,Default,Xiaolan,0,0,0,,Czy to nie dziwne?!
Dialogue: 0,0:08:45.58,0:08:46.97,Default,Maomao,0,0,0,,Trójka?
Dialogue: 0,0:08:46.97,0:08:49.37,Default,Xiaolan,0,0,0,,I widocznie historia zatoczy koło.
Dialogue: 0,0:08:49.37,0:08:50.75,Default,Maomao,0,0,0,,Te dzieci też zachorowały?
Dialogue: 0,0:08:50.75,0:08:57.89,Default,Xiaolan,0,0,0,,Tak! I tym razem lekarz złożył wizytę\Npani Gyokuyou, jak i pani Li Hua!
Dialogue: 0,0:08:59.60,0:09:02.80,Default,Xiaolan,0,0,0,,Cesarz nie ma małżonki,\Nwięc to pani Li Hua,
Dialogue: 0,0:09:02.80,0:09:05.31,Default,Xiaolan,0,0,0,,matka księcia, może nią być, prawda?!
Dialogue: 0,0:09:05.93,0:09:07.94,Default,Maomao,0,0,0,,Chyba tak.
Dialogue: 0,0:09:07.94,0:09:10.17,Default,Maomao,0,0,0,,Jeśli nie ma cesarzowej,
Dialogue: 0,0:09:10.17,0:09:11.98,Default,Maomao,0,0,0,,a konkubina Li Hua urodziła księcia,
Dialogue: 0,0:09:11.98,0:09:14.56,Default,Maomao,0,0,0,,to powinna mieć największe\Nwpływy w wewnętrznym pałacu.
Dialogue: 0,0:09:14.56,0:09:19.47,Default,Xiaolan,0,0,0,,Ale plotki głoszą, że cesarz\Ndarzy sympatią panią Gyokuyou.
Dialogue: 0,0:09:19.47,0:09:23.45,Default,Xiaolan,0,0,0,,Ponoć wiąże się to również z klątwą.
Dialogue: 0,0:09:23.45,0:09:26.04,Default,Maomao,0,0,0,,Walka o władzę…
Dialogue: 0,0:09:26.41,0:09:32.73,Default,Xiaolan,0,0,0,,Z panią Li Hua chyba też nie jest\Nnajlepiej, ciągle jest u niej doktor.
Dialogue: 0,0:09:32.73,0:09:34.33,Default,Maomao,0,0,0,,Pani Li Hua też jest chora?
Dialogue: 0,0:09:34.33,0:09:37.85,Default,Xiaolan,0,0,0,,Tak, matka i dziecko cierpią\Nna bóle głowy i brzucha.
Dialogue: 0,0:09:37.85,0:09:40.30,Default,Xiaolan,0,0,0,,Chyba mają też mdłości.
Dialogue: 0,0:09:41.36,0:09:45.10,Default,Maomao,0,0,0,,Ból głowy, brzucha, nudności…
Dialogue: 0,0:09:45.10,0:09:48.23,Default,Xiaolan,0,0,0,,To na pewno jest klątwa!
Dialogue: 0,0:09:49.90,0:09:52.25,Default,Maomao,0,0,0,,Klątwy to głupota.
Dialogue: 0,0:09:52.25,0:09:53.90,Default,Xiaolan,0,0,0,,Co?
Dialogue: 0,0:09:58.05,0:10:01.10,Default,Maomao,0,0,0,,Ból głowy, brzucha, nudności…
Dialogue: 0,0:10:01.10,0:10:03.70,Default,Maomao,0,0,0,,Może to zatrucie?
Dialogue: 0,0:10:03.70,0:10:05.69,Default,Maomao,0,0,0,,Nie, jeśli chodzi o następcę tronu,
Dialogue: 0,0:10:05.69,0:10:07.90,Default,Maomao,0,0,0,,ściganie księżniczki nie ma sensu.
Dialogue: 0,0:10:07.90,0:10:10.97,Default,Maomao,0,0,0,,Umyślne zatrucie \Njest mało prawdopodobne.
Dialogue: 0,0:10:10.97,0:10:13.29,Default,Maomao,0,0,0,,Może to jakieś choróbsko?
Dialogue: 0,0:10:14.50,0:10:16.66,Default,Maomao,0,0,0,,A może coś dziedzicznego?
Dialogue: 0,0:10:18.49,0:10:22.22,Default,Maomao,0,0,0,,Czemu tak poważnie traktuję te pogłoski?
Dialogue: 0,0:10:22.86,0:10:25.78,Default,Maomao,0,0,0,,To tylko domysły.
Dialogue: 0,0:10:26.51,0:10:28.67,Default,Maomao,0,0,0,,Ale jednak…
Dialogue: 0,0:10:29.99,0:10:32.10,Default,Maomao,0,0,0,,Myślę, że mogę rzucić okiem.
Dialogue: 0,0:10:36.59,0:10:39.94,Default,Maomao,0,0,0,,To tutaj znajdują się pawilony\Nwszystkich konkubin wysokiej rangi.
Dialogue: 0,0:10:39.94,0:10:44.73,Default,Maomao,0,0,0,,Każdy budynek jest piękny,\Nnawet pojedyncze filary.
Dialogue: 0,0:10:47.42,0:10:48.87,Default,Lihua,0,0,0,,To twoja wina!
Dialogue: 0,0:10:48.87,0:10:50.33,Default,Yinghua,0,0,0,,Pani Gyokuyou!
Dialogue: 0,0:10:50.73,0:10:54.96,Default,Lihua,0,0,0,,Usiłujesz przekląć mego syna\Ntylko dlatego, że urodziłaś córkę!
Dialogue: 0,0:10:54.96,0:10:58.30,Default,Gyokuyou,0,0,0,,Wiesz, że to nonsens!
Dialogue: 0,0:10:58.30,0:11:01.09,Default,Gyokuyou,0,0,0,,Moja Xiaoling też jest chora!
Dialogue: 0,0:11:01.58,0:11:04.11,Default,Eunuch A,0,0,0,,Pani Li Hua jest wściekła.
Dialogue: 0,0:11:04.11,0:11:06.18,Default,Eunuch B,0,0,0,,Współczuję pani Gyokuyou.
Dialogue: 0,0:11:06.46,0:11:07.53,Default,Gaoshun,0,0,0,,Panie Jinshi…
Dialogue: 0,0:11:10.48,0:11:14.22,Default,Gyokuyou,0,0,0,,Właśnie dlatego chcę, aby zbadał\Npan także stan mojej córki.
Dialogue: 0,0:11:14.22,0:11:16.65,Default,Guen,0,0,0,,Dobrze… więc…
Dialogue: 0,0:11:16.65,0:11:20.51,Default,Maomao,0,0,0,,Ten roztrzęsiony eunuch\Nna środku ma być medykiem?
Dialogue: 0,0:11:20.51,0:11:22.24,Default,Maomao,0,0,0,,Głupi konował.
Dialogue: 0,0:11:22.57,0:11:26.74,Default,Maomao,0,0,0,,Tyle czasu spędził przy konkubinach\Ni dalej niczego nie zauważył?
Dialogue: 0,0:11:27.23,0:11:28.28,Default,Maomao,0,0,0,,Lub raczej…
Dialogue: 0,0:11:28.45,0:11:30.50,Default,Maomao,0,0,0,,Może on naprawdę tego nie wie?
Dialogue: 0,0:11:31.14,0:11:35.23,Default,Maomao,0,0,0,,Zgony niemowląt.\NBól głowy, brzucha, nudności.
Dialogue: 0,0:11:35.23,0:11:39.32,Default,Maomao,0,0,0,,I przede wszystkim,\Npani Li Hua wygląda na wymęczoną.
Dialogue: 0,0:11:39.32,0:11:42.76,Default,Maomao,0,0,0,,Tak jak myślałam,\Nto wcale nie jest klątwa.
Dialogue: 0,0:11:43.15,0:11:45.02,Default,Maomao,0,0,0,,Tylko jak im to powiedzieć?
Dialogue: 0,0:11:46.22,0:11:48.18,Default,Maomao,0,0,0,,Gdybym tylko znalazła coś do pisania…
Dialogue: 0,0:12:31.27,0:12:34.94,Default,Maomao,0,0,0,,Upłynął nie cały miesiąc,\Nodkąd świat obiegła
Dialogue: 0,0:12:34.94,0:12:37.57,Default,Maomao,0,0,0,,wieść o śmierci księcia.
Dialogue: 0,0:12:41.82,0:12:44.61,Default,Gyokuyou,0,0,0,,Widzę, że chcesz mnie o coś zapytać.
Dialogue: 0,0:12:45.19,0:12:46.57,Default,Jinshi,0,0,0,,Czy to…
Dialogue: 0,0:12:47.09,0:12:52.02,Default,Gyokuyou,0,0,0,,Gdy poszłam do Głównego Pawilonu,\Nby poprosić o zbadanie mojej córki,
Dialogue: 0,0:12:52.56,0:12:56.98,Default,Gyokuyou,0,0,0,,znalazłam to na parapecie,\Nprzyczepione do tej gałęzi.
Dialogue: 0,0:12:58.06,0:12:59.85,Default,Jinshi,0,0,0,,Azalia japońska.
Dialogue: 0,0:13:00.95,0:13:04.55,Default,Gyokuyou,0,0,0,,„Puder do twarzy jest trujący.\NNie wolno dziecku go dotykać”.
Dialogue: 0,0:13:05.63,0:13:07.68,Default,Gyokuyou,0,0,0,,Niewiedza to grzech.
Dialogue: 0,0:13:08.29,0:13:12.75,Default,Jinshi,0,0,0,,Pałacowy medyk nie podjąłby się\Ntakiego okrężnego rozwiązania.
Dialogue: 0,0:13:12.75,0:13:17.62,Default,Gyokuyou,0,0,0,,Tak. Do samego końca\Nnie umiał pomóc księciu.
Dialogue: 0,0:13:17.62,0:13:19.94,Default,Jinshi,0,0,0,,Od kogo więc jest ten liścik?
Dialogue: 0,0:13:20.55,0:13:22.94,Default,Gyokuyou,0,0,0,,Chcę, byś się tego dowiedział.
Dialogue: 0,0:13:27.25,0:13:29.45,Default,Jinshi,0,0,0,,Jak teraz o tym myślę,\Nto wtedy…
Dialogue: 0,0:13:30.83,0:13:33.14,Default,Maomao,0,0,0,,Gdybym tylko znalazła coś do pisania…
Dialogue: 0,0:13:37.68,0:13:38.96,Default,Jinshi,0,0,0,,Zrozumiałem.
Dialogue: 0,0:13:39.37,0:13:42.30,Default,Jinshi,0,0,0,,Czy mogę na razie to zatrzymać?
Dialogue: 0,0:13:48.47,0:13:51.85,Default,Xiaolan,0,0,0,,Ponoć cesarz regularnie\Nodwiedza panią Gyokuyou,
Dialogue: 0,0:13:51.85,0:13:54.39,Default,Xiaolan,0,0,0,,by pokazać swoją miłość do księżniczki.
Dialogue: 0,0:13:54.78,0:13:56.59,Default,Maomao,0,0,0,,A co z panią Li Huą?
Dialogue: 0,0:13:56.59,0:13:59.09,Default,Xiaolan,0,0,0,,Nic o niej nie mówią.
Dialogue: 0,0:13:59.63,0:14:01.47,Default,Maomao,0,0,0,,Jakże to wygodne.
Dialogue: 0,0:14:01.47,0:14:03.67,Default,Eunuch C,0,0,0,,O, tutaj jesteś.
Dialogue: 0,0:14:04.11,0:14:07.65,Default,Eunuch C,0,0,0,,Niezwłocznie udaj się do zarządcy.
Dialogue: 0,0:14:08.65,0:14:09.85,Default,Xiaolan,0,0,0,,Wezwanie?
Dialogue: 0,0:14:10.27,0:14:12.16,Default,Maomao,0,0,0,,Ciekawe po co?
Dialogue: 0,0:14:12.98,0:14:16.91,Default,Eunuch C,0,0,0,,Dobrze, zapraszam was \Nwszystkie do środka.
Dialogue: 0,0:14:17.25,0:14:22.09,Default,Maomao,0,0,0,,Wezwanie służek przez tych wysoko\Npostawionych nie wróży niczego dobrego.
Dialogue: 0,0:14:23.54,0:14:25.26,Default,Maomao,0,0,0,,Może potrzebują więcej rąk do pracy?
Dialogue: 0,0:14:36.97,0:14:39.48,Default,Jinshi,0,0,0,,Dziękuję wszystkim za przybycie.
Dialogue: 0,0:14:43.98,0:14:46.74,Default,Maomao,0,0,0,,Co to za arogantka?
Dialogue: 0,0:14:49.27,0:14:52.29,Default,Jinshi,0,0,0,,Jestem Jinshi,\Nzarządca wewnętrznego pałacu.
Dialogue: 0,0:14:57.13,0:14:58.94,Default,Maomao,0,0,0,,Facet?
Dialogue: 0,0:14:58.94,0:15:04.88,Default,Maomao,0,0,0,,To musi być ten przystojny eunuch,\No którym mówiła Xiaolan.
Dialogue: 0,0:15:04.88,0:15:09.88,Default,Maomao,0,0,0,,Ale szkoda. Taki przystojny,\Nale nie może mieć dzieci.
Dialogue: 0,0:15:11.89,0:15:15.89,Default,Text,0,0,0,,{\an8}PIEGUSKA ZOSTAJE.
Dialogue: 0,0:15:12.78,0:15:15.89,Default,Maomao,0,0,0,,Co? Pieguska zostaje?
Dialogue: 0,0:15:16.69,0:15:17.74,Default,Maomao,0,0,0,,O nie!
Dialogue: 0,0:15:20.13,0:15:23.72,Default,Jinshi,0,0,0,,Na tym koniec.\NMożecie wrócić do siebie.
Dialogue: 0,0:15:23.72,0:15:24.53,Default,Servant 1,0,0,0,,Co?
Dialogue: 0,0:15:24.53,0:15:25.65,Default,Servant 2,0,0,0,,O co tu chodziło?
Dialogue: 0,0:15:26.02,0:15:29.07,Default,Maomao,0,0,0,,Jakim cudem zwróciłam na siebie uwagę?!
Dialogue: 0,0:15:29.07,0:15:31.18,Default,Maomao,0,0,0,,Czyżby chodziło o ten liścik…
Dialogue: 0,0:15:32.28,0:15:33.11,Default,Maomao,0,0,0,,Właśnie!
Dialogue: 0,0:15:33.11,0:15:36.30,Default,Maomao,0,0,0,,Tylko ja tu umiem czytać!
Dialogue: 0,0:15:36.30,0:15:39.75,Default,Maomao,0,0,0,,Właśnie dlatego to napisał!
Dialogue: 0,0:15:39.75,0:15:41.50,Default,Maomao,0,0,0,,Muszę stąd spadać!
Dialogue: 0,0:15:41.75,0:15:45.96,Default,Jinshi,0,0,0,,Poczekaj, kazałem ci zostać.
Dialogue: 0,0:15:46.57,0:15:48.34,Default,Jinshi,0,0,0,,Bądź cicho i chodź za mną.
Dialogue: 0,0:15:54.05,0:15:56.01,Default,Maomao,0,0,0,,Wpadłam w pułapkę…
Dialogue: 0,0:15:56.30,0:16:01.51,Default,Jinshi,0,0,0,,Dziwna sprawa. Księgi\Ngłoszą, że nie umiesz czytać.
Dialogue: 0,0:16:02.20,0:16:07.40,Default,Maomao,0,0,0,,Pochodzę z ubogiej rodziny.\NTo musi być pomyłka.
Dialogue: 0,0:16:08.03,0:16:13.41,Default,Maomao,0,0,0,,Nie zamierzam się do tego przyznawać.\NRżnięcie głupa to najlepsze rozwiązanie.
Dialogue: 0,0:16:13.41,0:16:17.69,Default,Maomao,0,0,0,,Poza tym skąd ten facet\Ndowiedział się o wiadomości?
Dialogue: 0,0:16:17.69,0:16:20.66,Default,Maomao,0,0,0,,Dokładnie pilnowałam,\Nby nikogo nie było w pobliżu…
Dialogue: 0,0:16:24.26,0:16:26.13,Default,Maomao,0,0,0,,Ale jest podejrzliwy!
Dialogue: 0,0:16:27.27,0:16:29.66,Default,Maomao,0,0,0,,Chyba nie ma nic lepszego do roboty!
Dialogue: 0,0:16:30.87,0:16:31.74,Default,Hongniang,0,0,0,,Zapraszam.
Dialogue: 0,0:16:31.74,0:16:33.09,Default,Jinshi,0,0,0,,Dziękuję.
Dialogue: 0,0:16:33.49,0:16:35.96,Default,Maomao,0,0,0,,Za co będę ukarana?
Dialogue: 0,0:16:35.96,0:16:38.26,Default,Maomao,0,0,0,,Obym wyszła z tego cało.
Dialogue: 0,0:16:42.32,0:16:44.30,Default,Jinshi,0,0,0,,Przyprowadziłem ją.
Dialogue: 0,0:16:44.77,0:16:45.83,Default,Gyokuyou,0,0,0,,Wejdź.
Dialogue: 0,0:16:51.06,0:16:52.90,Default,Gyokuyou,0,0,0,,Przepraszam za problem.
Dialogue: 0,0:16:57.70,0:16:58.95,Default,Maomao,0,0,0,,Całe szczęście.
Dialogue: 0,0:17:00.15,0:17:01.45,Default,Gyokuyou,0,0,0,,A więc to ty.
Dialogue: 0,0:17:02.34,0:17:06.96,Default,Gyokuyou,0,0,0,,Dziękuję za ocalenie życia Ling Li.
Dialogue: 0,0:17:06.96,0:17:10.46,Default,Maomao,0,0,0,,Nie jestem godna tych słów!
Dialogue: 0,0:17:11.26,0:17:14.81,Default,Gyokuyou,0,0,0,,Jestem ci niezmiernie wdzięczna.
Dialogue: 0,0:17:15.45,0:17:17.97,Default,Gyokuyou,0,0,0,,Jesteś wybawicielką mego dzieciątka.
Dialogue: 0,0:17:17.97,0:17:20.75,Default,Maomao,0,0,0,,Chyba zaszła tu jakaś pomyłka, pani!
Dialogue: 0,0:17:20.75,0:17:23.06,Default,Maomao,0,0,0,,To musi być nieporozumienie.
Dialogue: 0,0:17:23.51,0:17:25.80,Default,Maomao,0,0,0,,Co prawda nie powieszą mnie za kłamstwo,
Dialogue: 0,0:17:25.80,0:17:28.02,Default,Maomao,0,0,0,,ale nie chcę być w to zamieszana!
Dialogue: 0,0:17:31.54,0:17:35.11,Default,Jinshi,0,0,0,,Konkubina Gyokuyou coś mi pokazała.
Dialogue: 0,0:17:37.07,0:17:53.09,Default,Text,0,0,0,,{\an8}PUDER DO TWARZY JEST TRUJĄCY.\NNIE WOLNO DZIECKU GO DOTYKAĆ.
Dialogue: 0,0:17:37.51,0:17:41.89,Default,Jinshi,0,0,0,,Czy wiesz, że ten materiał używany\Njest do produkcji ubiorów dla służby?
Dialogue: 0,0:17:42.54,0:17:45.05,Default,Maomao,0,0,0,,Wygląda znajomo… chyba…
Dialogue: 0,0:17:45.05,0:17:48.99,Default,Jinshi,0,0,0,,Zgadza się. Dla tych,\Nktórzy zajmują się ubraniami.
Dialogue: 0,0:17:48.99,0:17:53.09,Default,Jinshi,0,0,0,,Szczególnie dla praczki, którą jesteś.
Dialogue: 0,0:17:53.09,0:17:56.84,Default,Jinshi,0,0,0,,Czyżbyś rozdarła spódnicę?
Dialogue: 0,0:17:59.59,0:18:01.97,Default,Maomao,0,0,0,,Więc już się tego domyślił…
Dialogue: 0,0:18:02.43,0:18:07.27,Default,Jinshi,0,0,0,,Wytłumacz, dlaczego położyłaś\Nten kwiat na parapecie.
Dialogue: 0,0:18:18.03,0:18:21.60,Default,Maomao,0,0,0,,Ponieważ tego dnia\Nodkryłam, co jest nie tak.
Dialogue: 0,0:18:21.60,0:18:23.33,Default,Maomao,0,0,0,,Przyczyną był puder do makijażu.
Dialogue: 0,0:18:24.71,0:18:26.96,Default,Maomao,0,0,0,,Wiele kurtyzan używało\Nwysokiej jakości pudru
Dialogue: 0,0:18:26.96,0:18:30.33,Default,Maomao,0,0,0,,w dzielnicy uciech, w której dorastałam.
Dialogue: 0,0:18:30.91,0:18:37.63,Default,Maomao,0,0,0,,Wiele z nich otruło się nim i zmarło.
Dialogue: 0,0:18:39.79,0:18:44.97,Default,Maomao,0,0,0,,Starały się przełożyć piękno\Nponad życie i straciły wszystko.
Dialogue: 0,0:18:53.45,0:18:59.07,Default,Maomao,0,0,0,,Byłam zielarką,\Nwięc wiem co nieco o truciznach.
Dialogue: 0,0:19:07.20,0:19:09.04,Default,Jinshi,0,0,0,,Puder do twarzy…
Dialogue: 0,0:19:09.04,0:19:12.04,Default,Gyokuyou,0,0,0,,Używała go pielęgniarka dziecka.
Dialogue: 0,0:19:12.04,0:19:16.67,Default,Gyokuyou,0,0,0,,Mówiła, że działa lepiej niż inne pudry.
Dialogue: 0,0:19:17.01,0:19:22.80,Default,Gyokuyou,0,0,0,,Widać było, że choruje, więc odpuściłam \Ni odpowiednio ją wynagrodziłam.
Dialogue: 0,0:19:23.67,0:19:24.86,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:19:25.72,0:19:27.51,Default,Gyokuyou,0,0,0,,Niewiedza to grzech.
Dialogue: 0,0:19:27.97,0:19:32.10,Default,Gyokuyou,0,0,0,,Powinnam bardziej uważać na rzeczy,\Nz którymi dziecko ma styczność.
Dialogue: 0,0:19:32.65,0:19:34.41,Default,Jinshi,0,0,0,,Też jestem winny.
Dialogue: 0,0:19:34.41,0:19:39.19,Default,Jinshi,0,0,0,,Gdybym wcześniej to zauważył,\Nzdołałbym uratować niejedno życie.
Dialogue: 0,0:19:39.66,0:19:40.74,Default,Jinshi,0,0,0,,Księcia również…
Dialogue: 0,0:19:42.35,0:19:47.67,Default,Gyokuyou,0,0,0,,Gdy zobaczyłam tę wiadomość,\Npowiadomiłam również konkubinę Li Huę.
Dialogue: 0,0:19:51.03,0:19:55.00,Default,Gyokuyou,0,0,0,,Jednak wszystko, co powiedziałam, tylko \Npogorszyło jej zdanie na mój temat.
Dialogue: 0,0:19:56.45,0:19:57.78,Default,Maomao,0,0,0,,Więc…
Dialogue: 0,0:19:59.30,0:20:02.76,Default,Maomao,0,0,0,,W czym mogę pomóc?
Dialogue: 0,0:20:09.56,0:20:12.94,Default,Gyokuyou,0,0,0,,Od dziś jesteś moją osobistą służącą!
Dialogue: 0,0:20:14.15,0:20:15.21,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:20:16.59,0:20:19.02,Default,Narrator,0,0,0,,Pewnych rzeczy\NMaomao nie powstrzyma.
Dialogue: 0,0:20:19.02,0:20:22.06,Default,Narrator,0,0,0,,Ciekawość, łaknienie wiedzy…
Dialogue: 0,0:20:22.06,0:20:25.87,Default,Narrator,0,0,0,,oraz odrobinę poczucia sprawiedliwości.
Dialogue: 0,0:20:30.27,0:20:34.26,Default,Mao,0,0,0,,O rany, rany, rany…
Dialogue: 0,0:20:34.26,0:20:37.63,Default,Maomao,0,0,0,,— Jeżeli zachowam dyskrecję,\Nto nie powinno mieć znaczenia, gdzie…
Dialogue: 0,0:20:34.75,0:20:36.21,Default,Xiaolan,0,0,0,,{\an8}— O, Maomao!
Dialogue: 0,0:20:36.21,0:20:39.39,Default,Xiaolan,0,0,0,,{\an8}— Hej, Maomao! Jak było?
Dialogue: 0,0:20:39.84,0:20:44.52,Default,Narrator,0,0,0,,W ten sposób Maomao została\Nosobistą służką konkubiny Gyokuyou,
Dialogue: 0,0:20:44.52,0:20:46.90,Default,Narrator,0,0,0,,ukochanej cesarza.
Dialogue: 0,0:20:46.90,0:20:49.81,Default,Narrator,0,0,0,,Mówiąc wprost, był to spory awans.
Dialogue: 0,0:20:57.98,0:20:59.57,Default,Soldier A,0,0,0,,Ej!
Dialogue: 0,0:21:01.48,0:21:02.84,Default,Soldier A,0,0,0,,To trucizna!
Dialogue: 0,0:22:34.95,0:22:36.95,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.46,0:22:48.14,Default,Episode Title,0,0,0,,W kolejnym odcinku:\N„Obojętna zielarka”.
Dialogue: 0,0:22:48.58,0:22:50.58,Default,Episode Title,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
