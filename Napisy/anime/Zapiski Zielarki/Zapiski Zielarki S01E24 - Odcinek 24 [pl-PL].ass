Dialogue: 1,0:00:08.27,0:00:12.07,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.27,0:00:12.69,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:31.49,0:01:32.68,Default,Lakan,0,0,0,,Fengxian...
Dialogue: 0,0:01:33.85,0:01:36.19,Default,Lakan,0,0,0,,{\an8}Chciałem być przy córce,\Nktórą zostawiłaś.
Dialogue: 0,0:01:34.49,0:01:37.49,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:36.65,0:01:39.12,Default,Lakan,0,0,0,,{\an8}Tylko tego pragnąłem.
Dialogue: 0,0:01:41.08,0:01:43.20,Default,Lakan,0,0,0,,Ale to oczywiste,\Nże mnie nienawidzi.
Dialogue: 0,0:01:44.01,0:01:46.33,Default,Lakan,0,0,0,,Mimo to nadal\Nchcę mieć ją blisko siebie.
Dialogue: 0,0:01:52.39,0:01:57.38,Default,Lakan,0,0,0,,Jednak zakład to zakład.\NMoże innym razem mi się uda.
Dialogue: 0,0:01:57.77,0:01:59.89,Default,Lakan,0,0,0,,Ale ten typek...
Dialogue: 0,0:02:00.63,0:02:01.92,Default,Lakan,0,0,0,,Nigdy mu nie wybaczę.
Dialogue: 0,0:02:01.92,0:02:05.90,Default,Lakan,0,0,0,,Podczas gry miał czelność trzy razy\Npołożyć swoją łapę na mojej córeczce.
Dialogue: 0,0:02:05.90,0:02:08.62,Default,Lakan,0,0,0,,Muszę wymyślić jakąś zemstę...
Dialogue: 0,0:02:09.54,0:02:09.92,Default,Lakan,0,0,0,,Co?
Dialogue: 0,0:02:09.92,0:02:11.40,Default,Old Lady,0,0,0,,Wstałeś wreszcie?
Dialogue: 0,0:02:11.96,0:02:14.74,Default,Old Lady,0,0,0,,Ponoć chcesz wykupić\Njedną z naszych kurtyzan.
Dialogue: 0,0:02:14.74,0:02:19.08,Default,Old Lady,0,0,0,,Wiesz, że będzie cię\Nto słono kosztować, prawda?
Dialogue: 0,0:02:19.08,0:02:24.46,Default,Lakan,0,0,0,,Wiem. Jeśli 10 tysięcy to mało,\Nto dam 20 czy 30. Ile tylko chcesz.
Dialogue: 0,0:02:24.46,0:02:26.87,Default,Lakan,0,0,0,,Sto tysięcy może być przesadą.
Dialogue: 0,0:02:27.12,0:02:30.19,Default,Old Lady,0,0,0,,Doprawdy? Rusz dupę.
Dialogue: 0,0:02:30.19,0:02:32.11,Default,Old Lady,0,0,0,,Dam ci wybrać.
Dialogue: 0,0:02:34.30,0:02:35.94,Default,Lakan,0,0,0,,Rany, rany.
Dialogue: 0,0:02:59.19,0:03:02.54,Default,Lakan,0,0,0,,Jesteś pewna, że twoje trzy\Nskarby też powinny tu być?
Dialogue: 0,0:03:02.54,0:03:05.23,Default,Old Lady,0,0,0,,Mówiłam, że daję ci wybór.
Dialogue: 0,0:03:05.23,0:03:07.63,Default,Old Lady,0,0,0,,Rzecz jasna, musisz słono zapłacić.
Dialogue: 0,0:03:08.66,0:03:10.62,Default,Lakan,0,0,0,,Co za utrapienie.
Dialogue: 0,0:03:11.48,0:03:15.55,Default,Lakan,0,0,0,,Niezależnie jak dobrze się ubiorą,\Nwszystkie wyglądają dla mnie jak pionki.
Dialogue: 0,0:03:16.34,0:03:21.97,Default,Lakan,0,0,0,,Myślę, że w tym wypadku mogę pomóc\NMeimei, która była dla mnie dobra.
Dialogue: 0,0:03:30.86,0:03:32.13,Default,Meimei,0,0,0,,Panie Lakan.
Dialogue: 0,0:03:34.27,0:03:38.15,Default,Meimei,0,0,0,,Praca kurtyzany napawa mnie dumą.
Dialogue: 0,0:03:38.15,0:03:41.89,Default,Meimei,0,0,0,,Jeśli chcesz mnie, przystanę na to.
Dialogue: 0,0:03:46.38,0:03:47.41,Default,Meimei,0,0,0,,Ale...
Dialogue: 0,0:03:51.93,0:03:54.71,Default,Meimei,0,0,0,,Jeśli masz wybrać, wybierz mądrze.
Dialogue: 0,0:04:00.91,0:04:06.94,Default,Fengxian,0,0,0,,{\an8}Ach, śpij kochanie... śpij...
Dialogue: 0,0:04:07.99,0:04:15.73,Default,Fengxian,0,0,0,,{\an8}- Jeśli gwiazdkę\Nz nieba chcesz, dostaniesz...
Dialogue: 0,0:04:09.08,0:04:11.35,Default,Old Lady,0,0,0,,- Meimei! Miałaś nie otwierać okna!
Dialogue: 0,0:04:13.10,0:04:14.60,Default,Old Lady,0,0,0,,- Co ty wyprawiasz?
Dialogue: 0,0:04:16.73,0:04:18.45,Default,Old Lady,0,0,0,,Czekaj!
Dialogue: 0,0:04:23.16,0:04:25.59,Default,Lakan,0,0,0,,Kwiat, który nawet po\Nuschnięciu pozostaje piękny!
Dialogue: 0,0:04:28.51,0:04:31.00,Default,Lakan,0,0,0,,Jeśli to miał być znak...
Dialogue: 0,0:04:32.34,0:04:33.50,Default,Lakan,0,0,0,,Czy to możliwe?!
Dialogue: 0,0:04:34.37,0:04:37.50,Default,Fengxian,0,0,0,,{\i1}Ach, śpij kochanie... śpij...
Dialogue: 0,0:04:38.59,0:04:45.48,Default,Fengxian,0,0,0,,{\i1}Jeśli gwiazdkę\Nz nieba chcesz, dostaniesz...
Dialogue: 0,0:04:46.34,0:04:53.98,Default,Fengxian,0,0,0,,{\i1}Czego pragniesz, daj mi znać,
Dialogue: 0,0:04:54.73,0:05:01.75,Default,Fengxian,0,0,0,,{\i1}ja ci wszystko mogę dać.
Dialogue: 0,0:05:03.22,0:05:10.07,Default,Fengxian,0,0,0,,{\i1}Ach, śpij kochanie... śpij...
Dialogue: 0,0:05:10.93,0:05:18.29,Default,Fengxian,0,0,0,,{\i1}Śpij już, jutro się widzimy.{\i0}
Dialogue: 0,0:05:20.21,0:05:23.32,Default,Old Lady,0,0,0,,Co ty odwalasz?! To pokój chorej!
Dialogue: 0,0:05:23.32,0:05:24.85,Default,Old Lady,0,0,0,,Wynocha stąd, ale już!
Dialogue: 0,0:05:24.85,0:05:27.43,Default,Old Lady,0,0,0,,Pośpiesz się i wybieraj z tamtych!
Dialogue: 0,0:05:28.19,0:05:31.68,Default,Lakan,0,0,0,,Tak. Muszę wybrać, prawda?
Dialogue: 0,0:05:32.33,0:05:33.52,Default,Old Lady,0,0,0,,Słuchasz mnie?!
Dialogue: 0,0:05:43.17,0:05:45.13,Default,Lakan,0,0,0,,Chcę tę kobietę.
Dialogue: 0,0:05:46.93,0:05:48.53,Default,Old Lady,0,0,0,,Przestań chrzanić!
Dialogue: 0,0:05:48.53,0:05:51.78,Default,Lakan,0,0,0,,Sama powiedziałaś,\Nże mogę wybrać kogo chcę.
Dialogue: 0,0:05:51.78,0:05:56.96,Default,Lakan,0,0,0,,Dam ci tyle, ile chcesz.\NSto tysięcy, dwieście tysięcy, nieważne.
Dialogue: 0,0:05:57.21,0:05:58.98,Default,Old Lady,0,0,0,,O czym ty gadasz...
Dialogue: 0,0:06:32.42,0:06:33.96,Default,Lakan,0,0,0,,Grajmy dalej.
Dialogue: 0,0:06:48.67,0:06:51.22,Default,Lakan,0,0,0,,A więc to jest twój ruch?
Dialogue: 0,0:06:51.77,0:06:54.89,Default,Lakan,0,0,0,,Twoje posunięcia zawsze były\Ngwałtowne i nieoczekiwane.
Dialogue: 0,0:06:54.89,0:06:57.72,Default,Lakan,0,0,0,,Maomao na pewno ma to po tobie.
Dialogue: 0,0:07:03.77,0:07:08.90,Default,Meimei,0,0,0,,Siostrzyczko, od samego początku\Npowinnaś była być szczera.
Dialogue: 0,0:07:10.15,0:07:12.60,Default,Meimei,0,0,0,,Dlaczego tak późno...
Dialogue: 0,0:07:17.18,0:07:21.02,Default,Lakan,0,0,0,,Wykupię tę kurtyzanę.
Dialogue: 0,0:07:23.99,0:07:30.18,Default,Lakan,0,0,0,,Tę kobietę, piękną jak kwiat niecierpka.
Dialogue: 0,0:07:37.31,0:07:41.31,Default,Text,0,0,0,,{\an8}ODCINEK 24: JINSHI I MAOMAO
Dialogue: 0,0:07:39.90,0:07:45.47,Default,Maomao,0,0,0,,{\an1}To właśnie Basen towarzyszył mi\Nw drodze do Grynszpanowego Pawilonu.
Dialogue: 0,0:07:46.95,0:07:48.70,Default,Maomao,0,0,0,,Padam z nóg.
Dialogue: 0,0:07:50.43,0:07:52.85,Default,Basen,0,0,0,,Do diabła, złośliwy duet ojca i córki.
Dialogue: 0,0:07:55.70,0:07:57.85,Default,Maomao,0,0,0,,To konkubina Loulan.
Dialogue: 0,0:07:58.30,0:08:01.25,Default,Maomao,0,0,0,,Zgaduję, że zostali\Njeszcze tutaj po przyjęciu.
Dialogue: 0,0:08:01.98,0:08:03.26,Default,Maomao,0,0,0,,To musi być jej ojciec,
Dialogue: 0,0:08:03.26,0:08:07.42,Default,Maomao,0,0,0,,który mocno nalegał, by jego córka\Ntrafiła do wewnętrznego pałacu.
Dialogue: 0,0:08:08.67,0:08:10.13,Default,Maomao,0,0,0,,Tak czy siak...
Dialogue: 0,0:08:10.95,0:08:14.91,Default,Maomao,0,0,0,,Wolałabym, żeby ten facet nie obrzucał\Nbłotem urzędników wysokiej rangi.
Dialogue: 0,0:08:15.78,0:08:20.18,Default,Maomao,0,0,0,,Gdyby ktoś podsłuchał\Nto i ja bym oberwała.
Dialogue: 0,0:08:20.99,0:08:22.75,Default,Maomao,0,0,0,,Młody i głupi.
Dialogue: 0,0:08:22.75,0:08:23.48,Default,Basen,0,0,0,,Ej.
Dialogue: 0,0:08:24.90,0:08:26.69,Default,Basen,0,0,0,,Pan Jinshi chce cię widzieć.
Dialogue: 0,0:08:30.70,0:08:31.94,Default,Jinshi,0,0,0,,Pewnie jesteś zmęczona.
Dialogue: 0,0:08:32.25,0:08:34.07,Default,Maomao,0,0,0,,Nie za specjalnie.
Dialogue: 0,0:08:34.66,0:08:35.82,Default,Suiren,0,0,0,,Rany!
Dialogue: 0,0:08:36.36,0:08:39.73,Default,Suiren,0,0,0,,Ojej, ale schudłaś!
Dialogue: 0,0:08:39.73,0:08:40.58,Default,Maomao,0,0,0,,Dobzie jest.
Dialogue: 0,0:08:42.08,0:08:45.42,Default,Suiren,0,0,0,,Proszę bardzo, Xiaomao. Zajadaj.
Dialogue: 0,0:08:46.05,0:08:48.55,Default,Suiren,0,0,0,,Mamy tego więcej.
Dialogue: 0,0:08:52.13,0:08:56.93,Default,Jinshi,0,0,0,,Myślałem, że go nienawidzisz.
Dialogue: 0,0:08:57.95,0:08:59.43,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:09:00.41,0:09:02.13,Default,Maomao,0,0,0,,To nie tak, że go nienawidzę.
Dialogue: 0,0:09:02.13,0:09:07.04,Default,Maomao,0,0,0,,Bądź co bądź, jestem tutaj,\Nbo celnie trafił.
Dialogue: 0,0:09:07.04,0:09:09.31,Default,Jinshi,0,0,0,,Nie mogłaś tego inaczej ująć?
Dialogue: 0,0:09:09.31,0:09:13.46,Default,Maomao,0,0,0,,Taka prawda. Nie wiem,\Njak sobie to wyobraziłeś,
Dialogue: 0,0:09:13.46,0:09:16.42,Default,Maomao,0,0,0,,ale nie zaszłaby w ciążę,\Ngdyby nie chciała.
Dialogue: 0,0:09:18.06,0:09:20.70,Default,Maomao,0,0,0,,Są leki zapobiegające ciąży\Nlub ją przerywające.
Dialogue: 0,0:09:20.70,0:09:23.03,Default,Maomao,0,0,0,,Łatwo mogła ukrócić\Nwszystko w zarodku.
Dialogue: 0,0:09:23.62,0:09:26.58,Default,Maomao,0,0,0,,Urodziła, bo tego chciała.
Dialogue: 0,0:09:27.94,0:09:30.88,Default,Maomao,0,0,0,,Bardziej możliwe,\Nże to właśnie on został oszukany.
Dialogue: 0,0:09:31.38,0:09:32.92,Default,Jinshi,0,0,0,,Nasz strateg?
Dialogue: 0,0:09:33.33,0:09:35.79,Default,Maomao,0,0,0,,Kobiety są przebiegłe.
Dialogue: 0,0:09:35.79,0:09:39.64,Default,Maomao,0,0,0,,Nie jest trudno określić, kiedy jest\Nnajwiększa szansa na zajście w ciążę,
Dialogue: 0,0:09:39.64,0:09:41.81,Default,Maomao,0,0,0,,gdy śledzi się okres.
Dialogue: 0,0:09:41.81,0:09:46.27,Default,Maomao,0,0,0,,Jako kurtyzana mogła regulować\Nczęstotliwość jego wizyt listami.
Dialogue: 0,0:09:47.30,0:09:52.42,Default,Maomao,0,0,0,,Pewnie dlatego oszalała,\Ngdy sprawy nie potoczyły się po jej myśli.
Dialogue: 0,0:09:53.75,0:09:57.30,Default,Maomao,0,0,0,,Na tyle, że była zdolna\Nzrobić sobie krzywdę.
Dialogue: 0,0:09:58.03,0:10:03.07,Default,Maomao,0,0,0,,Co więcej, wysłała również\Nmały palec dziecka.
Dialogue: 0,0:10:05.74,0:10:11.64,Default,Maomao,0,0,0,,Panie Jinshi, ten facet nigdy nie rozmawiał\Nz tobą poza gabinetem, prawda?
Dialogue: 0,0:10:12.09,0:10:13.61,Default,Jinshi,0,0,0,,Jak o tym wspominasz...
Dialogue: 0,0:10:13.61,0:10:16.89,Default,Maomao,0,0,0,,Ten osobnik nie potrafi\Nrozpoznawać ludzkich twarzy.
Dialogue: 0,0:10:16.89,0:10:19.13,Default,Jinshi,0,0,0,,Nie rozpoznaje twarzy?\NCo masz na myśli?
Dialogue: 0,0:10:19.77,0:10:22.21,Default,Maomao,0,0,0,,Potrafi rozróżnić kształt oczu i ust,
Dialogue: 0,0:10:22.21,0:10:24.49,Default,Maomao,0,0,0,,ale nie potrafi postrzegać ich\Njako całości.
Dialogue: 0,0:10:24.49,0:10:27.02,Default,Maomao,0,0,0,,Dla niego wszystkie twarze\Nwyglądają tak samo.
Dialogue: 0,0:10:27.51,0:10:29.73,Default,Jinshi,0,0,0,,A to pech.
Dialogue: 0,0:10:30.04,0:10:34.61,Default,Maomao,0,0,0,,Dokładnie to samo powiedział\Nmi tatko, gdy mi to tłumaczył.
Dialogue: 0,0:10:35.21,0:10:40.70,Default,Luomen,0,0,0,,Ma pecha. Dręczyło go to\Nprzez całe życie.
Dialogue: 0,0:10:40.70,0:10:41.99,Default,Maomao,0,0,0,,Aha...
Dialogue: 0,0:10:43.59,0:10:44.95,Default,Maomao,0,0,0,,Ale z jakiegoś powodu,
Dialogue: 0,0:10:45.49,0:10:48.97,Default,Maomao,0,0,0,,potrafi rozpoznać twarze\Nmoją i mojego tatka.
Dialogue: 0,0:10:49.45,0:10:53.09,Default,Maomao,0,0,0,,To właśnie dlatego\Ntak dziwnie się do mnie przyczepił.
Dialogue: 0,0:10:54.62,0:10:55.87,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:10:55.87,0:11:00.57,Default,Maomao,0,0,0,,Co byś zrobił, gdyby ten okularnik podszedł\Ndo ciebie i powiedział: „Mów mi tato!”?
Dialogue: 0,0:11:02.53,0:11:04.81,Default,Jinshi,0,0,0,,Zgniótłbym mu ten monokl.
Dialogue: 0,0:11:04.81,0:11:05.68,Default,Maomao,0,0,0,,Prawda?
Dialogue: 0,0:11:07.98,0:11:12.97,Default,Maomao,0,0,0,,Stale powtarza, że jest moim ojcem,\Nale co najwyżej jest ogierem.
Dialogue: 0,0:11:15.57,0:11:19.57,Default,Maomao,0,0,0,,Ciekawi mnie, czy zrozumiał\Nprzekaz kryjący się za uschniętą różą.
Dialogue: 0,0:11:20.03,0:11:22.97,Default,Maomao,0,0,0,,Jeśli nie skumał, mówi się trudno.
Dialogue: 0,0:11:25.34,0:11:27.95,Default,Maomao,0,0,0,,Nie lubię go, ale nie nienawidzę.
Dialogue: 0,0:11:28.69,0:11:32.98,Default,Maomao,0,0,0,,Cieszę się, że zostałam córką Luomena.
Dialogue: 0,0:11:32.98,0:11:36.21,Default,Jinshi,0,0,0,,Wydawałaś się zniesmaczona,\Ngdy go zobaczyłaś.
Dialogue: 0,0:11:36.90,0:11:39.97,Default,Maomao,0,0,0,,Panie Jinshi, jeszcze dużo\Nmusisz się nauczyć.
Dialogue: 0,0:11:40.54,0:11:45.34,Default,Maomao,0,0,0,,Gdy chciałam przerwać\Nceremonię, pomógł mi.
Dialogue: 0,0:11:45.34,0:11:49.16,Default,Maomao,0,0,0,,Chyba przeczuwał, że coś się wydarzy.
Dialogue: 0,0:11:49.16,0:11:53.49,Default,Jinshi,0,0,0,,Że on? Nie sądziłem,\Nże cokolwiek o tym wiedział.
Dialogue: 0,0:11:53.49,0:11:57.82,Default,Maomao,0,0,0,,Nie szuka dowodów,\Nby mieć pewność tak jak ja.
Dialogue: 0,0:11:57.82,0:12:02.38,Default,Maomao,0,0,0,,Wyczuwa, że coś jest nie tak\Ni rzadko się myli.
Dialogue: 0,0:12:05.71,0:12:10.16,Default,Maomao,0,0,0,,Wkurza mnie to, że jest\Nza leniwy, by samemu coś zrobić.
Dialogue: 0,0:12:11.54,0:12:15.55,Default,Maomao,0,0,0,,Gdyby ten facet rzeczywiście coś zrobił,
Dialogue: 0,0:12:15.55,0:12:21.13,Default,Maomao,0,0,0,,miałabym teraz w rękach\Nlek przywracający życie!
Dialogue: 0,0:12:23.73,0:12:26.81,Default,Maomao,0,0,0,,To zwykła zazdrość.
Dialogue: 0,0:12:26.81,0:12:29.48,Default,Maomao,0,0,0,,Ma taki talent, że nawet tata\Npochwaliłby go.
Dialogue: 0,0:12:29.48,0:12:33.29,Default,Maomao,0,0,0,,I on nie zdaje sobie z tego sprawy.
Dialogue: 0,0:12:36.38,0:12:40.73,Default,Maomao,0,0,0,,Nie będzie on twoim sojusznikiem, ale też\Nnie powinieneś robić sobie z niego wroga.
Dialogue: 0,0:12:41.50,0:12:42.99,Default,Jinshi,0,0,0,,Dobrze.
Dialogue: 0,0:12:44.58,0:12:46.09,Default,Maomao,0,0,0,,Coś się stało?
Dialogue: 0,0:12:46.09,0:12:48.60,Default,Gaoshun,0,0,0,,Nic, po prostu...
Dialogue: 0,0:12:49.17,0:12:53.00,Default,Gaoshun,0,0,0,,Pamiętaj, że żaden ojciec\Nnie chciałby być nielubiany.
Dialogue: 0,0:13:00.52,0:13:02.84,Default,Maomao,0,0,0,,Kilka dni po powrocie\Ndo wewnętrznego pałacu,
Dialogue: 0,0:13:02.84,0:13:05.30,Default,Maomao,0,0,0,,Meimei przysłała mi paczkę.
Dialogue: 0,0:13:06.19,0:13:10.68,Default,Maomao,0,0,0,,W środku był list z informacją,\Nkto został wykupiony
Dialogue: 0,0:13:10.97,0:13:13.01,Default,Maomao,0,0,0,,oraz piękny szal.
Dialogue: 0,0:13:13.81,0:13:15.63,Default,Meimei,0,0,0,,Posłuchaj, Maomao.
Dialogue: 0,0:13:15.63,0:13:19.26,Default,Meimei,0,0,0,,Kiedy ktoś mnie wykupi,\Nzatańczysz dla mnie.
Dialogue: 0,0:13:27.39,0:13:31.51,Default,Maomao,0,0,0,,Prawdę mówiąc, chciałam jej go odesłać.
Dialogue: 0,0:13:33.72,0:13:38.01,Default,Maomao,0,0,0,,To kurtyzana, milsza niż ktokolwiek inny...
Dialogue: 0,0:15:51.89,0:15:54.90,Default,Maomao,0,0,0,,Sama się dziwię, że wciąż\Nto wszystko pamiętam.
Dialogue: 0,0:15:56.70,0:15:57.22,Default,Jinshi,0,0,0,,Ej.
Dialogue: 0,0:15:58.56,0:15:59.18,Default,Jinshi,0,0,0,,Co...
Dialogue: 0,0:16:08.01,0:16:09.52,Default,Jinshi,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:16:09.52,0:16:12.65,Default,Maomao,0,0,0,,Panie Jinshi? Co ty tu robisz?
Dialogue: 0,0:16:13.56,0:16:17.36,Default,Jinshi,0,0,0,,Doniesiono mi, że kolejna\Ndziwaczka wspięła się na mur.
Dialogue: 0,0:16:17.36,0:16:18.91,Default,Jinshi,0,0,0,,Musiałem przyjść i sprawdzić.
Dialogue: 0,0:16:19.25,0:16:21.57,Default,Maomao,0,0,0,,Myślałam, że cichaczem mi się uda, ale...
Dialogue: 0,0:16:21.57,0:16:22.94,Default,Maomao,0,0,0,,Jasne, że mnie złapią.
Dialogue: 0,0:16:24.57,0:16:26.21,Default,Jinshi,0,0,0,,Nie sprawiaj więcej kłopotów.
Dialogue: 0,0:16:26.59,0:16:31.33,Default,Maomao,0,0,0,,Ale czemu to ty musisz to sprawdzać?\NPrzecież mogli wysłać kogoś innego.
Dialogue: 0,0:16:32.52,0:16:37.68,Default,Jinshi,0,0,0,,Miły strażnik rozpoznał twoją\Ntwarz i od razu do mnie przyszedł.
Dialogue: 0,0:16:38.33,0:16:42.93,Default,Jinshi,0,0,0,,Może myślisz, że nie rzucasz się w oczy,\Nale inni sądzą inaczej. Pamiętaj o tym.
Dialogue: 0,0:16:42.93,0:16:43.94,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:16:44.43,0:16:48.36,Default,Jinshi,0,0,0,,Twoja kolej. Co ty tu robisz?
Dialogue: 0,0:16:50.29,0:16:54.30,Default,Maomao,0,0,0,,W dzielnicy uciech, kiedy\Nwykupiona kurtyzana odchodzi,
Dialogue: 0,0:16:54.30,0:16:56.70,Default,Maomao,0,0,0,,jest zwyczaj, że pozostałe tańczą.
Dialogue: 0,0:16:58.18,0:16:59.38,Default,Maomao,0,0,0,,O co chodzi?
Dialogue: 0,0:16:59.38,0:17:02.98,Default,Jinshi,0,0,0,,Jestem zaskoczony,\Nże umiesz tańczyć.
Dialogue: 0,0:17:05.66,0:17:08.99,Default,Maomao,0,0,0,,Nauka tańca była absolutnym minimum.
Dialogue: 0,0:17:09.42,0:17:14.59,Default,Jinshi,0,0,0,,Pojawiły się plotki, że ten\Ndziwak wykupił kurtyzanę.
Dialogue: 0,0:17:15.10,0:17:16.43,Default,Maomao,0,0,0,,Z pewnością tak było.
Dialogue: 0,0:17:16.80,0:17:19.25,Default,Jinshi,0,0,0,,Porzucił również swoje stanowisko.
Dialogue: 0,0:17:19.25,0:17:21.57,Default,Jinshi,0,0,0,,Ma zamiar wyjechać na dziesięć dni.
Dialogue: 0,0:17:22.21,0:17:24.43,Default,Maomao,0,0,0,,Ale upierdliwiec.
Dialogue: 0,0:17:24.43,0:17:26.91,Default,Maomao,0,0,0,,Siostrzyczka powiedziała mi,\Nże urządzają przyjęcie
Dialogue: 0,0:17:26.91,0:17:28.61,Default,Maomao,0,0,0,,nie przez trzy dni i trzy noce,
Dialogue: 0,0:17:28.61,0:17:31.40,Default,Maomao,0,0,0,,ale przez calutki tydzień.
Dialogue: 0,0:17:32.23,0:17:35.40,Default,Maomao,0,0,0,,Nie wiem, ile zapłacił za wykup,
Dialogue: 0,0:17:35.82,0:17:37.98,Default,Maomao,0,0,0,,ale po liczbie świecących się lamp
Dialogue: 0,0:17:37.98,0:17:40.51,Default,Maomao,0,0,0,,łatwo się domyślić,\Nże nie jest to zwykła kurtyzana.
Dialogue: 0,0:17:41.09,0:17:46.01,Default,Maomao,0,0,0,,Jednakże wykupiona kurtyzana\Nnie została nigdy pokazana publicznie.
Dialogue: 0,0:17:48.53,0:17:51.59,Default,Maomao,0,0,0,,Plotki o Grynszpanowym\NPawilonie stale rosną.
Dialogue: 0,0:17:52.36,0:17:54.55,Default,Maomao,0,0,0,,Wszystko zgodnie z planem staruchy.
Dialogue: 0,0:17:55.57,0:17:59.94,Default,Jinshi,0,0,0,,Swoją drogą, kogo on wykupił?
Dialogue: 0,0:17:59.94,0:18:02.15,Default,Maomao,0,0,0,,Kto wie?
Dialogue: 0,0:18:02.83,0:18:04.30,Default,Jinshi,0,0,0,,Ty.
Dialogue: 0,0:18:04.30,0:18:07.98,Default,Maomao,0,0,0,,Żadna piękność\Nnie może się z tobą równać.
Dialogue: 0,0:18:07.98,0:18:09.60,Default,Jinshi,0,0,0,,To nie jest odpowiedź na pytanie.
Dialogue: 0,0:18:10.03,0:18:11.53,Default,Maomao,0,0,0,,Ale i tak nie zaprzeczyłeś.
Dialogue: 0,0:18:12.92,0:18:17.26,Default,Maomao,0,0,0,,Kobieta, którą wykupił\Nmężczyzna, nie pożyje zbyt długo.
Dialogue: 0,0:18:18.38,0:18:23.58,Default,Maomao,0,0,0,,Gdy mieszkałam w dzielnicy uciech, nikt nie\Nmówił mi o kobiecie, która mnie urodziła.
Dialogue: 0,0:18:24.41,0:18:27.33,Default,Maomao,0,0,0,,Pewnie starucha\Nkazała im siedzieć cicho.
Dialogue: 0,0:18:28.03,0:18:32.59,Default,Maomao,0,0,0,,Jednak takie rzeczy szybko\Nwychodzą na światło dzienne.
Dialogue: 0,0:18:33.18,0:18:37.34,Default,Maomao,0,0,0,,To przeze mnie Grynszpanowy\NPawilon prawie zbankrutował.
Dialogue: 0,0:18:38.41,0:18:44.85,Default,Maomao,0,0,0,,Zawsze gdy mnie widziała, kazała mi się\Nwynosić, zawstydzona utratą swojej dumy.
Dialogue: 0,0:18:45.93,0:18:49.60,Default,Maomao,0,0,0,,Ten koszmar naprawdę wydarzył się\Nw przeszłości.
Dialogue: 0,0:18:52.54,0:18:55.25,Default,Maomao,0,0,0,,Nie pamięta, że była matką.
Dialogue: 0,0:18:55.66,0:18:58.32,Default,Maomao,0,0,0,,Wszystko, co zostało,\Nto krzywy mały palec.
Dialogue: 0,0:19:01.34,0:19:03.86,Default,Maomao,0,0,0,,Dla mnie nie ma to już znaczenia.
Dialogue: 0,0:19:04.35,0:19:07.55,Default,Maomao,0,0,0,,Cieszę się, że jestem córką Luomena.
Dialogue: 0,0:19:09.17,0:19:10.44,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:19:10.44,0:19:11.49,Default,Jinshi,0,0,0,,O co chodzi?
Dialogue: 0,0:19:13.49,0:19:16.90,Default,Maomao,0,0,0,,Można odciąć czubek palca,\Nale on odrośnie.
Dialogue: 0,0:19:18.51,0:19:20.27,Default,Jinshi,0,0,0,,Czy to odpowiedni moment na to?
Dialogue: 0,0:19:23.60,0:19:25.33,Default,Jinshi,0,0,0,,Co się stało?!
Dialogue: 0,0:19:25.33,0:19:27.60,Default,Maomao,0,0,0,,Chyba moja rana się otworzyła.
Dialogue: 0,0:19:27.60,0:19:29.23,Default,Jinshi,0,0,0,,Żadne chyba!
Dialogue: 0,0:19:29.64,0:19:33.21,Default,Maomao,0,0,0,,Zgaduję, że taniec\Nrozgrzał moje ciało.
Dialogue: 0,0:19:33.21,0:19:37.44,Default,Maomao,0,0,0,,Zapewne dzięki eksperymentom z truciznami,\Nmam wysoką tolerancję na ból.
Dialogue: 0,0:19:38.93,0:19:40.90,Default,Maomao,0,0,0,,Spokojnie, zaraz ją zszyję.
Dialogue: 0,0:19:43.86,0:19:46.04,Default,Maomao,0,0,0,,Panie Jinshi, tak nie da się pracować.
Dialogue: 0,0:19:46.04,0:19:47.37,Default,Jinshi,0,0,0,,Nie rób tego tutaj!
Dialogue: 0,0:19:56.78,0:19:59.17,Default,Maomao,0,0,0,,Panie Jinshi...
Dialogue: 0,0:20:01.45,0:20:02.84,Default,Maomao,0,0,0,,Puść mnie, proszę.
Dialogue: 0,0:20:03.41,0:20:05.34,Default,Jinshi,0,0,0,,Rana jeszcze bardziej się otworzy.
Dialogue: 0,0:20:05.87,0:20:08.50,Default,Maomao,0,0,0,,A jeśli ktoś nas zobaczy?
Dialogue: 0,0:20:09.06,0:20:11.24,Default,Jinshi,0,0,0,,Ciemno jest, nikt nie zobaczy.
Dialogue: 0,0:20:12.05,0:20:15.19,Default,Jinshi,0,0,0,,{\an8}To już kolejny raz,\Nkiedy niosę cię na rękach.
Dialogue: 0,0:20:15.75,0:20:19.05,Default,Maomao,0,0,0,,{\an8}Poprzednim razem chyba byłam\Nnieprzytomna z powodu kontuzji.
Dialogue: 0,0:20:20.49,0:20:21.44,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:20:22.36,0:20:24.90,Default,Maomao,0,0,0,,Może nie jest to odpowiedni moment,
Dialogue: 0,0:20:24.90,0:20:27.79,Default,Maomao,0,0,0,,ale jest coś,\Nco od dawna chciałam powiedzieć.
Dialogue: 0,0:20:27.79,0:20:30.20,Default,Jinshi,0,0,0,,Wszystko z tobą w porządku?
Dialogue: 0,0:20:30.99,0:20:35.21,Default,Maomao,0,0,0,,{\an8}Muszę powiedzieć,\Nto bardzo ważna rzecz.
Dialogue: 0,0:20:42.07,0:20:44.19,Default,Jinshi,0,0,0,,Wyrzuć to z siebie.
Dialogue: 0,0:20:46.93,0:20:48.28,Default,Maomao,0,0,0,,Panie Jinshi...
Dialogue: 0,0:20:55.14,0:20:57.06,Default,Maomao,0,0,0,,Poproszę mój bezoar.
Dialogue: 0,0:21:03.19,0:21:06.04,Default,Maomao,0,0,0,,Chwila, zapomniałeś o nim?!
Dialogue: 0,0:21:06.04,0:21:07.95,Default,Jinshi,0,0,0,,Nie bądź głupia!
Dialogue: 0,0:21:08.77,0:21:10.20,Default,Jinshi,0,0,0,,Nawet nie...
Dialogue: 0,0:21:10.83,0:21:13.58,Default,Maomao,0,0,0,,{\an8}Co za brak ogłady, tak mi walnąć.
Dialogue: 0,0:21:15.98,0:21:21.96,Default,Maomao,0,0,0,,Ale chyba najłatwiej się z nim\Nrozmawia, gdy jest dziecinny.
Dialogue: 0,0:21:41.42,0:21:42.61,Default,Yinghua,0,0,0,,Maomao!
Dialogue: 0,0:21:43.50,0:21:45.78,Default,Yinghua,0,0,0,,Pan Jinshi przyszedł się\Nz tobą zobaczyć!
Dialogue: 0,0:21:46.46,0:21:47.45,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:21:50.54,0:21:51.87,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:21:55.19,0:21:57.18,Default,Jinshi,0,0,0,,Lepiej się czujesz?
Dialogue: 0,0:21:58.18,0:22:02.44,Default,Maomao,0,0,0,,Tak. Wszyscy w Jadeitowym Pałacu\Nsą bajdzio mili.
Dialogue: 0,0:22:06.09,0:22:08.68,Default,Maomao,0,0,0,,Czym mogę służyć?
Dialogue: 0,0:22:10.57,0:22:15.90,Default,Jinshi,0,0,0,,Mam coś interesującego.
Dialogue: 0,0:22:17.77,0:22:19.77,Default,Jinshi,0,0,0,,Chciałbym cię o coś poprosić.
Dialogue: 0,0:22:20.42,0:22:22.89,Default,Maomao,0,0,0,,Znowu to samo.
Dialogue: 0,0:22:26.59,0:22:31.42,Default,Maomao,0,0,0,,Więc co chcesz, żebym zrobiła?
Dialogue: 0,0:22:36.58,0:22:39.98,Default,Narrator,0,0,0,,Historia Maomao dopiero się rozpoczyna.
Dialogue: 0,0:22:41.03,0:22:45.08,Default,Narrator,0,0,0,,Ciekawe, co jeszcze ją spotka w życiu.
Dialogue: 0,0:22:45.71,0:22:50.05,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:22:50.05,0:22:55.06,Default,Text,0,0,0,,{\an8}DO ZOBACZENIA W DRUGIM SEZONIE!
Dialogue: 0,0:22:53.05,0:22:55.06,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
