Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:07.61,0:00:14.49,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:28.27,0:01:29.98,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:36.26,0:01:38.66,Default,Maomao,0,0,0,,{\i1}Brzmi jak dźwięk robali.
Dialogue: 0,0:01:39.38,0:01:43.76,Default,Shisui,0,0,0,,Maomao, też musisz założyć maskę lisa.\NWeź tę, którą niedawno pomalowałaś.
Dialogue: 0,0:01:39.62,0:01:43.62,Default,Text,0,0,0,,{\an8}ODCINEK 43: FESTIWAL
Dialogue: 0,0:01:43.76,0:01:44.62,Default,Maomao,0,0,0,,Jasne.
Dialogue: 0,0:01:49.07,0:01:54.58,Default,Maomao,0,0,0,,{\i1}Z reguły ludzie malują maski na czerwono.\NZielony wygląda dziwnie.
Dialogue: 0,0:01:55.67,0:01:57.38,Default,Maomao,0,0,0,,Wyglądasz trochę jak tanuki.
Dialogue: 0,0:01:57.38,0:02:00.89,Default,Shisui,0,0,0,,Co? A ty jak kot, Maomao.
Dialogue: 0,0:02:03.21,0:02:04.65,Default,Maomao,0,0,0,,Włosy mi przeszkadzają.
Dialogue: 0,0:02:06.60,0:02:10.02,Default,Shisui,0,0,0,,Zwiążę je ponownie. Siadaj.
Dialogue: 0,0:02:15.11,0:02:17.39,Default,Shisui,0,0,0,,Mam wrażenie, że czegoś brakuje.
Dialogue: 0,0:02:17.39,0:02:19.66,Default,Shisui,0,0,0,,Sama wstążka nie oddaje efektu, nie sądzisz?
Dialogue: 0,0:02:19.66,0:02:21.22,Default,Maomao,0,0,0,,Nie przeszkadza mi to.
Dialogue: 0,0:02:21.22,0:02:23.37,Default,Shisui,0,0,0,,Pożyczę ci jedną z moich\Nszpilek do włosów.
Dialogue: 0,0:02:23.37,0:02:26.57,Default,Shisui,0,0,0,,Jest w kształcie pajęczyny!\NSłodziaszna.
Dialogue: 0,0:02:27.70,0:02:31.42,Default,Maomao,0,0,0,,Właściwie, to mam jedną na zbyciu.
Dialogue: 0,0:02:32.30,0:02:35.71,Default,Shisui,0,0,0,,Łał, Maomao. Jest prześliczna.
Dialogue: 0,0:02:35.71,0:02:37.53,Default,Maomao,0,0,0,,To prezent.
Dialogue: 0,0:02:38.07,0:02:38.86,Default,Shisui,0,0,0,,Ej,
Dialogue: 0,0:02:40.25,0:02:42.55,Default,Shisui,0,0,0,,dałabyś mi ją,\Ngdybym o to poprosiła?
Dialogue: 0,0:02:47.56,0:02:48.40,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:02:48.86,0:02:49.89,Default,Shisui,0,0,0,,Sknera.
Dialogue: 0,0:02:50.53,0:02:52.59,Default,Maomao,0,0,0,,{\i1}Nie muszę chyba wspominać,
Dialogue: 0,0:02:52.59,0:02:56.65,Default,Maomao,0,0,0,,{\i1}że pan Jinshi doskonale\Npotrafi czytać mimikę twarzy.
Dialogue: 0,0:02:57.53,0:03:03.62,Default,Maomao,0,0,0,,{\i1}Z drugiej strony nie wiem nawet,\Nczy zdołam w ogóle wrócić do pałacu.
Dialogue: 0,0:03:06.22,0:03:07.80,Default,Shisui,0,0,0,,Zrobione.
Dialogue: 0,0:03:07.80,0:03:08.81,Default,Maomao,0,0,0,,Dzięki.
Dialogue: 0,0:03:09.40,0:03:12.46,Default,Shisui,0,0,0,,Festiwal odbywa się\Nw świątyni poza wioską.
Dialogue: 0,0:03:13.00,0:03:14.44,Default,Shisui,0,0,0,,Chodźmy.
Dialogue: 0,0:03:31.11,0:03:35.80,Default,Maomao,0,0,0,,{\i1}Możliwe, że przez światła pochodni\Nprzypominają prawdziwą gromadę lisów.
Dialogue: 0,0:03:40.29,0:03:42.44,Default,Shisui,0,0,0,,Jakbyśmy były w innym świecie, prawda?
Dialogue: 0,0:03:42.44,0:03:43.20,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:03:43.59,0:03:45.04,Default,Shisui,0,0,0,,Upiorne, prawda?
Dialogue: 0,0:03:45.04,0:03:46.10,Default,Maomao,0,0,0,,Może.
Dialogue: 0,0:03:46.85,0:03:49.89,Default,Maomao,0,0,0,,{\i1}Choć towarzyszy mi zielony tanuki.
Dialogue: 0,0:03:50.89,0:03:55.97,Default,Maomao,0,0,0,,{\i1}Niektórzy, jak Shisui,\Nużywają zielonego koloru.
Dialogue: 0,0:03:55.97,0:03:59.21,Default,Maomao,0,0,0,,{\i1}Głównie mężczyźni.\NCiekawe, jakie to ma znaczenie.
Dialogue: 0,0:04:02.98,0:04:05.21,Default,Shisui,0,0,0,,W tym roku widzę\Ndużo pasikoników.
Dialogue: 0,0:04:05.21,0:04:09.18,Default,Shisui,0,0,0,,Dlatego podobno tegoroczny\Nfestiwal ma być z rozmachem.
Dialogue: 0,0:04:09.18,0:04:10.64,Default,Maomao,0,0,0,,Takie buty.
Dialogue: 0,0:04:10.64,0:04:13.23,Default,Maomao,0,0,0,,Chyba po to, by odpędzić złe duchy.
Dialogue: 0,0:04:17.17,0:04:19.79,Default,Maomao,0,0,0,,Owoce miechunki rozdętej są paskudne.
Dialogue: 0,0:04:19.79,0:04:21.24,Default,Shisui,0,0,0,,Wiem.
Dialogue: 0,0:04:21.24,0:04:23.95,Default,Maomao,0,0,0,,Są trujące.\NW dzielnicy rozkoszy kurtyzany...
Dialogue: 0,0:04:23.95,0:04:25.37,Default,Shisui,0,0,0,,Wiem.
Dialogue: 0,0:04:27.65,0:04:28.58,Default,Maomao,0,0,0,,Ohydne.
Dialogue: 0,0:04:28.96,0:04:30.22,Default,Shisui,0,0,0,,Wybacz!
Dialogue: 0,0:04:33.59,0:04:35.98,Default,Shisui,0,0,0,,Świątynia jest na górze.
Dialogue: 0,0:04:36.54,0:04:42.84,Default,Shisui,0,0,0,,Wiesz, dlaczego tutejszy bóg jest lisem\Ni uważa się go za boga dobrych zbiorów?
Dialogue: 0,0:04:43.19,0:04:44.47,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:04:44.77,0:04:49.00,Default,Shisui,0,0,0,,Dawniej okolica ta była zamieszkiwana\Nprzez pewną grupę ludzi.
Dialogue: 0,0:04:51.03,0:04:54.48,Default,Shisui,0,0,0,,Potem przybyła kolejna grupa\Nz innego kraju. Z zachodu.
Dialogue: 0,0:04:55.66,0:04:59.42,Default,Shisui,0,0,0,,Większość wiosek przepędziła przybyszów,
Dialogue: 0,0:04:59.42,0:05:02.74,Default,Shisui,0,0,0,,ale kilka z nich ich zaakceptowało.
Dialogue: 0,0:05:03.37,0:05:06.70,Default,Shisui,0,0,0,,Dlatego, że posiadali\Ncoś cennego. Wiedzę.
Dialogue: 0,0:05:07.15,0:05:09.50,Default,Shisui,0,0,0,,Jak dobrze użyźnić glebę.
Dialogue: 0,0:05:09.50,0:05:11.52,Default,Shisui,0,0,0,,Jak się pozbyć szkodników.
Dialogue: 0,0:05:12.06,0:05:15.37,Default,Shisui,0,0,0,,Niektórzy mieszkańcy dostrzegli\Nw tym prawdziwą wartość.
Dialogue: 0,0:05:16.50,0:05:21.53,Default,Shisui,0,0,0,,Jednak potem wkroczyli inni,\Nusiłując przejąć żyzne tereny.
Dialogue: 0,0:05:22.86,0:05:28.26,Default,Shisui,0,0,0,,Przez powtarzające się ataki zaczęli\Nprzenosić swoją wioskę w głąb lasu.
Dialogue: 0,0:05:29.73,0:05:32.25,Default,Shisui,0,0,0,,Po cichutku, ukradkiem.
Dialogue: 0,0:05:39.19,0:05:41.61,Default,Maomao,0,0,0,,A co z tym lisim bogiem?
Dialogue: 0,0:05:41.97,0:05:45.31,Default,Shisui,0,0,0,,Lis symbolizuje przybyszów z Zachodu,\Nktórzy wnieśli wiedzę
Dialogue: 0,0:05:45.31,0:05:47.20,Default,Shisui,0,0,0,,i są przodkami tej wioski.
Dialogue: 0,0:05:47.94,0:05:50.78,Default,Shisui,0,0,0,,Tutejsze lisy są podobno białe.
Dialogue: 0,0:05:50.78,0:05:52.66,Default,Shisui,0,0,0,,Z początku maski były białe, prawda?
Dialogue: 0,0:05:53.40,0:05:55.05,Default,Shisui,0,0,0,,Namalowanie masek kolorami pokazuje,
Dialogue: 0,0:05:55.05,0:05:58.46,Default,Shisui,0,0,0,,jak osiedlili się przybysze i kolory regionów.
Dialogue: 0,0:05:59.17,0:06:00.57,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:06:01.69,0:06:06.07,Default,Maomao,0,0,0,,{\i1}Czy biały lis symbolizuje bladą skórę?
Dialogue: 0,0:06:06.61,0:06:09.35,Default,Maomao,0,0,0,,{\i1}I poprzez małżeństwo\Nkolory się zmieniają...
Dialogue: 0,0:06:10.13,0:06:10.68,Default,Maomao,0,0,0,,{\i1}Co?
Dialogue: 0,0:06:12.34,0:06:14.95,Default,Maomao,0,0,0,,{\i1}Skąd ja to już znam?
Dialogue: 0,0:06:15.27,0:06:20.21,Default,Shisui,0,0,0,,Wielu facetów tutaj ma problemy\Nz rozróżnianiem kolorów.
Dialogue: 0,0:06:20.21,0:06:21.07,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:06:21.07,0:06:23.26,Default,Shisui,0,0,0,,Wśród kobiet to dużo rzadsze.
Dialogue: 0,0:06:24.66,0:06:29.91,Default,Maomao,0,0,0,,{\i1}To dlatego malują oczy\Nna zielono zamiast na czerwono.
Dialogue: 0,0:06:31.51,0:06:32.67,Default,Maomao,0,0,0,,{\i1}Shisui także.
Dialogue: 0,0:06:33.79,0:06:36.21,Default,Maomao,0,0,0,,{\i1}Cesarzowa Matka,\Nktóra przybyła do miasta,
Dialogue: 0,0:06:36.21,0:06:41.42,Default,Maomao,0,0,0,,{\i1}i naród białego lisa, który stworzył\Nwioskę ukrytą głęboko w lesie.
Dialogue: 0,0:06:42.62,0:06:47.34,Default,Maomao,0,0,0,,{\i1}Prawdopodobnie pochodzą z jednej\Ngrupy przybyłej z zachodu...
Dialogue: 0,0:06:54.27,0:06:57.18,Default,Shisui,0,0,0,,Maomao, tu możesz\Nzostawić swoją maskę.
Dialogue: 0,0:06:57.96,0:06:59.81,Default,Maomao,0,0,0,,Co się dzieje z tymi maskami?
Dialogue: 0,0:06:59.81,0:07:02.10,Default,Shisui,0,0,0,,Przez rok są przechowywane,\Na potem palone.
Dialogue: 0,0:07:03.65,0:07:05.61,Default,Shisui,0,0,0,,A teraz tędy!
Dialogue: 0,0:07:14.26,0:07:17.79,Default,Vendor,0,0,0,,Zapraszamy serdecznie!
Dialogue: 0,0:07:18.22,0:07:20.00,Default,Maomao,0,0,0,,— Są stragany z jedzeniem?\N— Dobrze, dziękuję!
Dialogue: 0,0:07:20.00,0:07:22.57,Default,Shisui,0,0,0,,Tak. Chcesz coś przekąsić?
Dialogue: 0,0:07:22.57,0:07:24.13,Default,Maomao,0,0,0,,Jak stawiasz, to czemu nie.
Dialogue: 0,0:07:24.49,0:07:26.67,Default,Shisui,0,0,0,,Więc może mięsne szaszłyczki?
Dialogue: 0,0:07:27.90,0:07:30.36,Default,Maomao,0,0,0,,{\i1}Żaby i szarańcze...
Dialogue: 0,0:07:30.92,0:07:32.82,Default,Shisui,0,0,0,,Którą chcesz, Maomao?
Dialogue: 0,0:07:32.82,0:07:34.36,Default,Shisui,0,0,0,,Wezmę szarańczę!
Dialogue: 0,0:07:34.36,0:07:37.06,Default,Shisui,0,0,0,,Szarańcza o tej porze roku\Njest taka soczysta i pyszna!
Dialogue: 0,0:07:38.55,0:07:40.39,Default,Maomao,0,0,0,,Zostanę przy kurczaku.
Dialogue: 0,0:07:40.39,0:07:41.39,Default,Shisui,0,0,0,,A może żabkę?
Dialogue: 0,0:07:41.91,0:07:44.38,Default,Maomao,0,0,0,,Nie chcę widzieć na razie żadnej żaby...
Dialogue: 0,0:07:46.31,0:07:47.94,Default,Kids,0,0,0,,Szybko!
Dialogue: 0,0:07:48.90,0:07:51.42,Default,Shisui,0,0,0,,Nigdy wcześniej nie jadłaś robaków?
Dialogue: 0,0:07:51.42,0:07:53.84,Default,Maomao,0,0,0,,Na straganach\Nw dzielnicy uciech ich nie było.
Dialogue: 0,0:07:58.57,0:08:00.12,Default,Maomao,0,0,0,,Poza tym są paskudne.
Dialogue: 0,0:08:00.59,0:08:04.09,Default,Shisui,0,0,0,,Fuj, to był pasikonik!
Dialogue: 0,0:08:04.09,0:08:05.78,Default,Maomao,0,0,0,,Dla mnie jeden kij.
Dialogue: 0,0:08:05.78,0:08:07.66,Default,Shisui,0,0,0,,Różnią się totalnie!
Dialogue: 0,0:08:08.66,0:08:10.26,Default,Shisui,0,0,0,,Te są pyszniutkie.
Dialogue: 0,0:08:11.53,0:08:13.16,Default,Maomao,0,0,0,,{\i1}Nie widzę różnicy...
Dialogue: 0,0:08:15.53,0:08:17.69,Default,Shisui,0,0,0,,Popatrz, wewnątrz świątyni!
Dialogue: 0,0:08:19.17,0:08:20.14,Default,Maomao,0,0,0,,Dziecko?
Dialogue: 0,0:08:20.64,0:08:21.96,Default,Shisui,0,0,0,,To pewnie Kyou.
Dialogue: 0,0:08:21.96,0:08:25.24,Default,Shisui,0,0,0,,Każdego roku rolę bóstwa\Nodgrywa dziecko.
Dialogue: 0,0:08:25.24,0:08:26.02,Default,Maomao,0,0,0,,Aha.
Dialogue: 0,0:08:26.57,0:08:31.22,Default,Maomao,0,0,0,,Jak sobie przypomnę,\Nten gnojek stworzył ładną maskę.
Dialogue: 0,0:08:32.18,0:08:35.61,Default,Maomao,0,0,0,,Aż dziwi mnie, że umie\Ntak usiedzieć na dupie.
Dialogue: 0,0:08:35.61,0:08:39.85,Default,Shisui,0,0,0,,Zmieniają się tak przez całą noc.\NKażdy zgłasza się na ochotnika.
Dialogue: 0,0:08:40.73,0:08:42.68,Default,Shisui,0,0,0,,To świetne wspomnienie.
Dialogue: 0,0:08:43.74,0:08:46.25,Default,Shisui,0,0,0,,Chyba nadszedł czas na zmianę.
Dialogue: 0,0:08:46.25,0:08:48.00,Default,Shisui,0,0,0,,Zaczekajmy tu na niego.
Dialogue: 0,0:08:50.42,0:08:52.46,Default,Kids,0,0,0,,Sprawdź to!
Dialogue: 0,0:08:53.49,0:08:55.40,Default,Kids,0,0,0,,Co to takiego?
Dialogue: 0,0:08:55.40,0:08:56.55,Default,Shisui,0,0,0,,Co się dzieje?
Dialogue: 0,0:08:57.31,0:09:01.01,Default,Boy 1,0,0,0,,Ten kłos ryżu jest pusty.\NDostaliśmy go od starszego wioski.
Dialogue: 0,0:09:01.01,0:09:04.98,Default,Boy 2,0,0,0,,Na tym polu nigdy nic nie rośnie.
Dialogue: 0,0:09:04.98,0:09:08.68,Default,Girl 1,0,0,0,,A starszy daje nam ryż tylko z tego pola.
Dialogue: 0,0:09:08.68,0:09:09.48,Default,Boy 1,0,0,0,,Rany.
Dialogue: 0,0:09:09.48,0:09:11.85,Default,Shisui,0,0,0,,Powodzenia w przyszłym roku.
Dialogue: 0,0:09:12.83,0:09:14.41,Default,Maomao,0,0,0,,Czy ten będzie lepszy?
Dialogue: 0,0:09:15.00,0:09:16.74,Default,Boy 1,0,0,0,,Co? Jesteś pewna?
Dialogue: 0,0:09:17.83,0:09:19.91,Default,Boy 1,0,0,0,,Rety, dzięki!
Dialogue: 0,0:09:21.45,0:09:22.48,Default,Kids,0,0,0,,To nie fair!
Dialogue: 0,0:09:22.48,0:09:24.58,Default,Shisui,0,0,0,,Miła z ciebie osóbka, Maomao.
Dialogue: 0,0:09:24.58,0:09:27.62,Default,Maomao,0,0,0,,Nie do końca. Nie ma sensu,\Nbym się tego trzymała.
Dialogue: 0,0:09:28.19,0:09:29.08,Default,Kyou-u,0,0,0,,Siostrzyczko!
Dialogue: 0,0:09:30.84,0:09:32.14,Default,Kyou-u,0,0,0,,Jak mi poszło?
Dialogue: 0,0:09:32.14,0:09:34.18,Default,Shisui,0,0,0,,Byłeś zajefajny.
Dialogue: 0,0:09:35.91,0:09:38.86,Default,Kyou-u,0,0,0,,Gdyby tylko matka mogła to zobaczyć.
Dialogue: 0,0:09:41.68,0:09:44.56,Default,Maomao,0,0,0,,{\i1}Nie mieszka z matką?
Dialogue: 0,0:09:45.18,0:09:49.15,Default,Shisui,0,0,0,,No dalej, popatrzmy,\Njak palą maski z zeszłego roku.
Dialogue: 0,0:10:02.24,0:10:04.99,Default,Kyou-u,0,0,0,,Hej, o czym marzysz?
Dialogue: 0,0:10:04.99,0:10:06.32,Default,Maomao,0,0,0,,Marzę?
Dialogue: 0,0:10:06.32,0:10:08.76,Default,Kyou-u,0,0,0,,Mówi się, że gdy napiszesz\Nswoje życzenie na masce,
Dialogue: 0,0:10:08.76,0:10:12.25,Default,Kyou-u,0,0,0,,a potem ją spalisz,\Nto życzenie się spełni.
Dialogue: 0,0:10:12.25,0:10:13.72,Default,Kyou-u,0,0,0,,Nic nie napisałaś?
Dialogue: 0,0:10:13.72,0:10:14.83,Default,Maomao,0,0,0,,Teraz mnie oświeciłeś.
Dialogue: 0,0:10:14.83,0:10:18.51,Default,Shisui,0,0,0,,Maomao, nie wiedziałam,\Nże wierzysz w takie głupotki.
Dialogue: 0,0:10:18.89,0:10:22.40,Default,Kyou-u,0,0,0,,Żadna głupotka!\NŻyczenia się spełniają!
Dialogue: 0,0:10:22.40,0:10:26.52,Default,Kyou-u,0,0,0,,Właśnie dlatego sporo czasu poświęciłem\Nna pomalowanie maski i napisanie życzeń.
Dialogue: 0,0:10:26.90,0:10:28.14,Default,Maomao,0,0,0,,Czego sobie życzyłeś?
Dialogue: 0,0:10:28.55,0:10:30.17,Default,Kyou-u,0,0,0,,Tajemnica!
Dialogue: 0,0:10:30.17,0:10:31.61,Default,Maomao,0,0,0,,Jak se chcesz.
Dialogue: 0,0:10:31.61,0:10:33.02,Default,Shisui,0,0,0,,Patrzcie, nadchodzą!
Dialogue: 0,0:10:42.06,0:10:44.94,Default,Shisui,0,0,0,,Kyou, nie chciałeś grać tej roli?
Dialogue: 0,0:10:45.93,0:10:49.93,Default,Kyou-u,0,0,0,,Nie jestem dzieciakiem,\Nwięc niech inni to robią!
Dialogue: 0,0:10:49.93,0:10:51.50,Default,Shisui,0,0,0,,Dorosłeś, nie?
Dialogue: 0,0:10:51.50,0:10:53.09,Default,Maomao,0,0,0,,{\i1}Przynajmniej się stara.
Dialogue: 0,0:11:24.98,0:11:27.14,Default,Shisui,0,0,0,,Gdzie twoja maska, Kyou?
Dialogue: 0,0:11:27.14,0:11:28.54,Default,Kyou-u,0,0,0,,Nie wiem.
Dialogue: 0,0:11:29.81,0:11:32.02,Default,Kyou-u,0,0,0,,Liczę na to, że spłonie jak należy.
Dialogue: 0,0:11:47.21,0:11:52.31,Default,Shisui,0,0,0,,Niespełnione życzenia spadają\Nna dno, by zasilić kolejne zbiory.
Dialogue: 0,0:11:54.45,0:11:59.48,Default,Shisui,0,0,0,,Owady nie przeżywają zimy.\NZostawiają po sobie tylko potomstwo.
Dialogue: 0,0:12:09.53,0:12:11.16,Default,Shisui,0,0,0,,Już jesteśmy!
Dialogue: 0,0:12:16.57,0:12:19.42,Default,Suirei,0,0,0,,Dobrze. Chcecie coś zjeść?
Dialogue: 0,0:12:19.42,0:12:20.72,Default,Shisui,0,0,0,,Pewka!
Dialogue: 0,0:12:26.97,0:12:28.66,Default,Suirei,0,0,0,,Jak było na festiwalu?
Dialogue: 0,0:12:29.06,0:12:33.31,Default,Shisui,0,0,0,,Cóż, gdy tam dotarłyśmy,\NKyou był w środku i...
Dialogue: 0,0:12:33.81,0:12:34.99,Default,Suirei,0,0,0,,Co?
Dialogue: 0,0:12:36.25,0:12:39.06,Default,Maomao,0,0,0,,Coś mi obiecałaś.
Dialogue: 0,0:12:39.50,0:12:41.92,Default,Suirei,0,0,0,,Zioło życia.
Dialogue: 0,0:12:41.92,0:12:42.82,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:12:43.12,0:12:45.78,Default,Suirei,0,0,0,,Rozumiesz swoją obecną sytuację?
Dialogue: 0,0:12:47.37,0:12:52.67,Default,Maomao,0,0,0,,{\i1}Jestem zakładniczką,\Nale nie mam żadnych ograniczeń.
Dialogue: 0,0:12:52.67,0:12:56.75,Default,Maomao,0,0,0,,{\i1}Myślą, że nie będę próbowała uciec?\NA może jest inny powód?
Dialogue: 0,0:12:57.51,0:13:00.53,Default,Maomao,0,0,0,,{\i1}Zachowanie tej dwójki rodzi wiele pytań.
Dialogue: 0,0:13:00.53,0:13:03.17,Default,Maomao,0,0,0,,{\i1}Ale najbardziej niepokojące jest to, że...
Dialogue: 0,0:13:04.33,0:13:05.18,Default,Suirei,0,0,0,,Dobrze.
Dialogue: 0,0:13:05.18,0:13:07.79,Default,Maomao,0,0,0,,Czy to bieluń i rozdymka?!\NW jakich dawkach?
Dialogue: 0,0:13:08.46,0:13:09.76,Default,Maomao,0,0,0,,Coś jeszcze?
Dialogue: 0,0:13:09.76,0:13:11.77,Default,Maomao,0,0,0,,Jakie są dobre ilości?
Dialogue: 0,0:13:11.77,0:13:14.75,Default,Maomao,0,0,0,,Jak wyglądało twoje\Nciało po ożywieniu?!
Dialogue: 0,0:13:14.75,0:13:17.65,Default,Maomao,0,0,0,,Jak długo trwało odzyskanie przytomności?\NCzy od razu mogłaś się ruszać?
Dialogue: 0,0:13:18.94,0:13:20.94,Default,Suirei,0,0,0,,Bieluń raczej jest zbędny.
Dialogue: 0,0:13:20.94,0:13:21.78,Default,Maomao,0,0,0,,Zbędny?
Dialogue: 0,0:13:22.19,0:13:26.99,Default,Suirei,0,0,0,,Był on zawarty w obcej recepturze,\Nale służy do przedłużenia efektu śmierci.
Dialogue: 0,0:13:26.99,0:13:31.92,Default,Suirei,0,0,0,,Zapewne dodali go, by pozbawić ludzi\Nprzytomności i ułatwić ich ujarzmienie.
Dialogue: 0,0:13:31.92,0:13:34.04,Default,Suirei,0,0,0,,Do tego właśnie pierwotnie służył.
Dialogue: 0,0:13:34.90,0:13:39.79,Default,Suirei,0,0,0,,Mi się to udało, ale porażka\Npowoduje utratę pamięci.
Dialogue: 0,0:13:39.79,0:13:43.39,Default,Suirei,0,0,0,,Zanim wypróbujemy to na ludziach,\Ntrzeba jeszcze wiele poprawić...
Dialogue: 0,0:13:43.39,0:13:44.71,Default,Maomao,0,0,0,,Wykorzystaj mnie!
Dialogue: 0,0:13:44.71,0:13:46.36,Default,Suirei,0,0,0,,Nie zamierzam.
Dialogue: 0,0:13:46.36,0:13:48.42,Default,Maomao,0,0,0,,Dlaczego nie?! Nie krępuj się!
Dialogue: 0,0:13:48.42,0:13:49.76,Default,Suirei,0,0,0,,Jesteś zakładniczką...
Dialogue: 0,0:13:51.19,0:13:53.10,Default,Suirei,0,0,0,,Dobrze, że się dogadujecie.
Dialogue: 0,0:13:53.71,0:13:56.99,Default,Suirei,0,0,0,,Żadna z was nie ma wielu przyjaciół.
Dialogue: 0,0:13:56.99,0:13:57.86,Default,Maomao,0,0,0,,Zamknij się.
Dialogue: 0,0:13:57.86,0:13:58.79,Default,Suirei,0,0,0,,Zamilcz.
Dialogue: 0,0:14:03.25,0:14:05.45,Default,Maomao,0,0,0,,Za to ty i Shisui jesteście dość blisko.
Dialogue: 0,0:14:05.45,0:14:06.85,Default,Suirei,0,0,0,,Tak to wygląda?
Dialogue: 0,0:14:06.85,0:14:07.53,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:14:08.20,0:14:11.07,Default,Maomao,0,0,0,,{\i1}Mam tak wiele pytań do Shisui...
Dialogue: 0,0:14:11.52,0:14:16.25,Default,Maomao,0,0,0,,{\i1}Dlaczego mnie tu przyprowadziła?\NJaki jest tego cel?
Dialogue: 0,0:14:17.77,0:14:20.89,Default,Maomao,0,0,0,,{\i1}I... kim one tak naprawdę są?
Dialogue: 0,0:14:29.22,0:14:32.18,Default,Maomao,0,0,0,,To wszystko są zioła...?!
Dialogue: 0,0:14:32.55,0:14:34.81,Default,Suirei,0,0,0,,Tak, chwilę mnie nie będzie.
Dialogue: 0,0:14:34.81,0:14:38.36,Default,Suirei,0,0,0,,Na zewnątrz są strażnicy,\Nwięc nie myśl o ucieczce.
Dialogue: 0,0:14:40.99,0:14:43.51,Default,Shisui,0,0,0,,Wątpię, by chciała!
Dialogue: 0,0:14:43.51,0:14:47.05,Default,Kyou-u,0,0,0,,Po co cię pilnują? Co zrobiłaś?
Dialogue: 0,0:14:50.66,0:14:53.71,Default,Shisui,0,0,0,,Maomao, śniadanie stygnie.
Dialogue: 0,0:14:53.71,0:14:54.81,Default,Maomao,0,0,0,,Zjem później.
Dialogue: 0,0:14:56.76,0:14:59.21,Default,Shisui,0,0,0,,Ja ci dam „później”!
Dialogue: 0,0:14:59.56,0:15:02.83,Default,Shisui,0,0,0,,Przebierz się. Pomogę ci.
Dialogue: 0,0:15:02.83,0:15:07.20,Default,Kyou-u,0,0,0,,Rany, ale leń.\NUparta jak osioł, nie?
Dialogue: 0,0:15:07.20,0:15:08.42,Default,Kyou-u,0,0,0,,Zupełnie jak pani Shenmei.
Dialogue: 0,0:15:09.23,0:15:10.40,Default,Maomao,0,0,0,,Shenmei?
Dialogue: 0,0:15:12.59,0:15:13.89,Default,Shisui,0,0,0,,No i gotowe!
Dialogue: 0,0:15:14.50,0:15:17.74,Default,Shisui,0,0,0,,Kyou, zmywasz naczynia.
Dialogue: 0,0:15:17.74,0:15:19.39,Default,Kyou-u,0,0,0,,Co?!
Dialogue: 0,0:15:21.59,0:15:24.06,Default,Maomao,0,0,0,,Czy on nie jest z jakiejś bogatej rodziny?
Dialogue: 0,0:15:24.71,0:15:29.60,Default,Shisui,0,0,0,,Dobrobyt uderza do głowy.\NKto wie, jak długo taki zostanie.
Dialogue: 0,0:15:29.60,0:15:31.19,Default,Maomao,0,0,0,,W sumie racja.
Dialogue: 0,0:15:32.20,0:15:35.01,Default,Shisui,0,0,0,,Maomao, gdzie masz\Ntę szpilkę do włosów?
Dialogue: 0,0:15:35.01,0:15:36.67,Default,Maomao,0,0,0,,Leży przy łóżku.
Dialogue: 0,0:15:36.67,0:15:39.68,Default,Shisui,0,0,0,,Naprawdę masz wywalone.
Dialogue: 0,0:15:41.07,0:15:46.32,Default,Shisui,0,0,0,,To naprawdę piękna szpilka,\Npowinnaś ją pilnować, bo ci ktoś zajuma.
Dialogue: 0,0:15:46.32,0:15:48.13,Default,Maomao,0,0,0,,A dużo bym na niej zarobiła?
Dialogue: 0,0:15:48.13,0:15:49.91,Default,Shisui,0,0,0,,Możliwe, ale...
Dialogue: 0,0:15:49.91,0:15:53.87,Default,Shisui,0,0,0,,Misterne wzory i cała reszta nadają\Njej naprawdę wytworny wygląd.
Dialogue: 0,0:15:53.87,0:15:57.92,Default,Shisui,0,0,0,,Myślę, że ktoś z dobrym okiem\Nmógłby stwierdzić, kto to zamówił.
Dialogue: 0,0:15:58.38,0:16:00.30,Default,Maomao,0,0,0,,Więc chyba nie mogę jej opylić.
Dialogue: 0,0:16:01.08,0:16:05.00,Default,Maomao,0,0,0,,{\i1}Wiedząc, jaką ma obsesję na tym\Npunkcie, może ona zaraz wrócić.
Dialogue: 0,0:16:05.65,0:16:08.62,Default,Shisui,0,0,0,,Musiałabyś stopić ją\Nz powrotem do metalu.
Dialogue: 0,0:16:08.62,0:16:10.71,Default,Maomao,0,0,0,,To chyba marnotrawstwo.
Dialogue: 0,0:16:12.34,0:16:14.67,Default,Shisui,0,0,0,,Brakuje czegoś jeszcze.
Dialogue: 0,0:16:18.87,0:16:20.41,Default,Shisui,0,0,0,,No i gitarka.
Dialogue: 0,0:16:21.42,0:16:23.18,Default,Maomao,0,0,0,,Dobra w tym jesteś.
Dialogue: 0,0:16:23.18,0:16:26.24,Default,Shisui,0,0,0,,Nom. Biją mnie,\Njeśli jestem za wolna.
Dialogue: 0,0:16:26.86,0:16:27.79,Default,Maomao,0,0,0,,Biją?
Dialogue: 0,0:16:28.19,0:16:32.22,Default,Shisui,0,0,0,,Muszę też dobrze masować,\Nbo inaczej zostanę oblana gorącą wodą.
Dialogue: 0,0:16:32.22,0:16:34.25,Default,Shisui,0,0,0,,Dlatego szybko się uczę.
Dialogue: 0,0:16:34.25,0:16:37.61,Default,Maomao,0,0,0,,Straszne. Miałaś okropną panią.
Dialogue: 0,0:16:38.31,0:16:42.14,Default,Shisui,0,0,0,,Nie panią. To była moja matka.
Dialogue: 0,0:16:44.94,0:16:49.48,Default,Shisui,0,0,0,,Maomao, nie chcę, byś miała kłopoty,\Nwięc siedź na dupie, dobrze?
Dialogue: 0,0:16:50.43,0:16:52.40,Default,Shisui,0,0,0,,Też muszę dziś na chwilę wyjść.
Dialogue: 0,0:17:16.76,0:17:18.93,Default,Maomao,0,0,0,,{\i1}Minęło już prawie sześć godzin?
Dialogue: 0,0:17:23.47,0:17:27.27,Default,Maomao,0,0,0,,{\i1}Niesamowite. Widzę wszystko poza wioską.
Dialogue: 0,0:17:30.28,0:17:33.78,Default,Maomao,0,0,0,,{\i1}Ryż nie jest zbierany tylko w tej części.
Dialogue: 0,0:17:34.26,0:17:36.52,Default,Maomao,0,0,0,,{\i1}Czyżby nadal był zielony?
Dialogue: 0,0:17:36.94,0:17:39.41,Default,Maomao,0,0,0,,{\i1}Czy obok znajduje się magazyn ryżu?
Dialogue: 0,0:17:40.03,0:17:41.28,Default,Maomao,0,0,0,,{\i1}Tak sobie myślę...
Dialogue: 0,0:17:41.28,0:17:45.21,Default,Boy 2,0,0,0,,{\i1}Na tym polu nigdy nic nie rośnie.
Dialogue: 0,0:17:45.64,0:17:49.58,Default,Maomao,0,0,0,,{\i1}Czy to o tym polu mówił?
Dialogue: 0,0:17:49.58,0:17:51.71,Default,Maomao,0,0,0,,{\i1}Taki idealny kwadrat.
Dialogue: 0,0:17:52.20,0:17:53.16,Default,Maomao,0,0,0,,{\i1}Czy to możliwe...
Dialogue: 0,0:17:53.16,0:17:54.30,Default,Kyou-u,0,0,0,,Hej, siostrzyczko!
Dialogue: 0,0:17:56.93,0:17:58.82,Default,Kyou-u,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:18:00.10,0:18:03.29,Default,Maomao,0,0,0,,Nie wchodź jak do obory.
Dialogue: 0,0:18:04.56,0:18:06.28,Default,Kyou-u,0,0,0,,Gdzie jest siostrzyczka?
Dialogue: 0,0:18:06.28,0:18:06.98,Default,Maomao,0,0,0,,Nie wiem.
Dialogue: 0,0:18:08.04,0:18:10.98,Default,Maomao,0,0,0,,Wiesz, co to za budynek?
Dialogue: 0,0:18:10.98,0:18:14.93,Default,Kyou-u,0,0,0,,Co? A, to stary magazyn\Nstarszego wioski.
Dialogue: 0,0:18:14.93,0:18:19.46,Default,Kyou-u,0,0,0,,Zbudowali nowy budynek na podwyższeniu,\Nby szczury nie wchodziły do środka,
Dialogue: 0,0:18:19.46,0:18:20.95,Default,Kyou-u,0,0,0,,więc wątpię, by nadal go używali.
Dialogue: 0,0:18:21.77,0:18:22.68,Default,Maomao,0,0,0,,Takie buty.
Dialogue: 0,0:18:23.72,0:18:25.59,Default,Maomao,0,0,0,,Mogę tam pójść?
Dialogue: 0,0:18:26.05,0:18:28.41,Default,Kyou-u,0,0,0,,Ale oni cię pilnują, prawda?
Dialogue: 0,0:18:29.05,0:18:31.16,Default,Kyou-u,0,0,0,,Znaczy, myślę,\Nże to możliwe, ale...
Dialogue: 0,0:18:31.16,0:18:32.88,Default,Maomao,0,0,0,,Naprawdę?! Jak?
Dialogue: 0,0:18:33.59,0:18:36.88,Default,Kyou-u,0,0,0,,Dobra. Pokażę ci.
Dialogue: 0,0:18:36.88,0:18:40.89,Default,Kyou-u,0,0,0,,Moje tajne przejście,\Ndzięki któremu uciekam od nauki!
Dialogue: 0,0:18:41.39,0:18:43.08,Default,Maomao,0,0,0,,{\i1}To faktycznie mały zasraniec.
Dialogue: 0,0:18:56.79,0:18:58.11,Default,Kyou-u,0,0,0,,Co robisz?
Dialogue: 0,0:18:58.11,0:19:00.86,Default,Maomao,0,0,0,,Chcę coś sprawdzić.
Dialogue: 0,0:19:01.21,0:19:03.74,Default,Kyou-u,0,0,0,,To pole nie jest wydaje, nie?
Dialogue: 0,0:19:03.74,0:19:04.78,Default,Maomao,0,0,0,,Nie sądzę, by to było to.
Dialogue: 0,0:19:04.78,0:19:06.24,Default,Kyou-u,0,0,0,,Skąd to wiesz?
Dialogue: 0,0:19:07.24,0:19:12.08,Default,Maomao,0,0,0,,Szerokość tego okna i tej partii\Nniedojrzałego ryżu jest mniej więcej podobna.
Dialogue: 0,0:19:12.74,0:19:17.84,Default,Maomao,0,0,0,,Ta część jest oświetlana\Nprzez całą noc przez to okno.
Dialogue: 0,0:19:18.20,0:19:21.09,Default,Kyou-u,0,0,0,,Światło hamuje dojrzewanie?
Dialogue: 0,0:19:21.09,0:19:24.69,Default,Maomao,0,0,0,,Z reguły rośliny rosną lepiej\Nw dobrym świetle słonecznym.
Dialogue: 0,0:19:24.69,0:19:27.16,Default,Maomao,0,0,0,,Ale gdy rośliny są stale\Nwystawione na działanie światła,
Dialogue: 0,0:19:27.16,0:19:29.22,Default,Maomao,0,0,0,,czasami zakłóca to ich dojrzewanie.
Dialogue: 0,0:19:29.22,0:19:30.69,Default,Kyou-u,0,0,0,,Rany.
Dialogue: 0,0:19:31.02,0:19:32.98,Default,Maomao,0,0,0,,{\i1}Tak samo, jak zmieniając otoczenie,
Dialogue: 0,0:19:32.98,0:19:36.48,Default,Maomao,0,0,0,,{\i1}mogłam uzyskać kwiaty\Nkwitnące poza sezonem.
Dialogue: 0,0:19:37.91,0:19:40.17,Default,Maomao,0,0,0,,Mówiłeś, że są tu szczury, prawda?
Dialogue: 0,0:19:40.17,0:19:43.89,Default,Kyou-u,0,0,0,,Tak. Podobno nawet zastawienie\Nwielu pułapek nie pomogło.
Dialogue: 0,0:19:43.89,0:19:46.78,Default,Maomao,0,0,0,,A więc spora ilość szczurów.
Dialogue: 0,0:19:46.78,0:19:52.71,Default,Maomao,0,0,0,,{\i1}Suirei mówiła, że lek wymaga poprawek\Nprzed testowaniem go na ludziach.
Dialogue: 0,0:19:53.63,0:19:58.22,Default,Maomao,0,0,0,,{\i1}Zgaduję więc, że testowała\Ngo na zwierzętach, które łatwo złapać.
Dialogue: 0,0:20:03.16,0:20:04.67,Default,Maomao,0,0,0,,{\i1}Upierdliwy bachor.
Dialogue: 0,0:20:06.61,0:20:08.78,Default,Kyou-u,0,0,0,,Jak myślisz, co jest w środku?
Dialogue: 0,0:20:08.78,0:20:11.64,Default,Maomao,0,0,0,,Cóż, mam kilka przypuszczeń.
Dialogue: 0,0:20:21.19,0:20:23.07,Default,Kyou-u,0,0,0,,Fuj, szczury.
Dialogue: 0,0:20:23.42,0:20:26.28,Default,Maomao,0,0,0,,{\i1}To musi być miejscówka,\Ngdzie robiła testy.
Dialogue: 0,0:20:26.28,0:20:29.68,Default,Maomao,0,0,0,,{\i1}Z chęcią zabrałabym\Nto wszystko ze sobą!
Dialogue: 0,0:20:29.68,0:20:32.10,Default,Maomao,0,0,0,,{\i1}Nie, nie czas na to!
Dialogue: 0,0:20:32.10,0:20:33.41,Default,Kyou-u,0,0,0,,Co to jest?
Dialogue: 0,0:20:35.17,0:20:38.41,Default,Kyou-u,0,0,0,,Metalowe rurki? Jest ich mnóstwo.
Dialogue: 0,0:20:42.01,0:20:43.38,Default,Maomao,0,0,0,,{\i1}Co to tu robi?
Dialogue: 0,0:20:46.59,0:20:48.51,Default,Maomao,0,0,0,,{\i1}Tego się nie spodziewałam.
Dialogue: 0,0:20:49.17,0:20:51.39,Default,Maomao,0,0,0,,{\i1}Rany. To jest jak...
Dialogue: 0,0:20:53.08,0:20:55.30,Default,Maomao,0,0,0,,{\i1}Warsztat eruptatora pełną gębą.
Dialogue: 0,0:20:57.83,0:21:02.72,Default,Maomao,0,0,0,,{\i1}Te same, których napastnicy\Nużyli na panu Jinshim...
Dialogue: 0,0:21:10.16,0:21:14.16,Default,Shenmei,0,0,0,,Rany, a czemu drzwi są otwarte?
Dialogue: 0,0:21:14.71,0:21:17.07,Default,Shenmei,0,0,0,,Czyżby ktoś zapomniał je zamknąć?
Dialogue: 0,0:21:17.07,0:21:18.85,Default,Man,0,0,0,,Nie, to niemożliwe.
Dialogue: 0,0:21:18.85,0:21:22.88,Default,Shenmei,0,0,0,,A jednak były otwarte. Kto był\Nodpowiedzialny za ich zamknięcie?
Dialogue: 0,0:21:23.27,0:21:26.01,Default,Kyou-u,0,0,0,,O nie, to pani Shenmei...
Dialogue: 0,0:21:26.51,0:21:28.47,Default,Shenmei,0,0,0,,Jakie to dziwne.
Dialogue: 0,0:21:29.70,0:21:32.28,Default,Ayla,0,0,0,,Jakiś problem?
Dialogue: 0,0:21:32.28,0:21:34.86,Default,Maomao,0,0,0,,{\i1}To specjalna wysłanniczka.
Dialogue: 0,0:21:34.86,0:21:38.35,Default,Shenmei,0,0,0,,Skądże, pani Aylo. To nic takiego.
Dialogue: 0,0:21:38.76,0:21:40.49,Default,Shenmei,0,0,0,,Przywidziało mi się.
Dialogue: 0,0:21:54.04,0:21:59.37,Default,Shenmei,0,0,0,,Choć wygląda na to, że dwa\Nszczury wślizgnęły się do środka.
Dialogue: 0,0:22:00.66,0:22:04.99,Default,Kyou-u,0,0,0,,P-pani Shenmei...
Dialogue: 0,0:22:06.77,0:22:08.01,Default,Maomao,0,0,0,,{\i1}A więc to...
Dialogue: 0,0:22:09.72,0:22:10.93,Default,Maomao,0,0,0,,{\i1}jest Shenmei.
Dialogue: 0,0:23:45.02,0:23:47.02,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.03,0:23:59.95,Default,Text,0,0,0,,{\an8}W kolejnym odcinku:\N„Twierdza”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
