Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:31.52,0:01:34.53,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:53.92,0:01:57.84,Default,Text,0,0,0,,{\an8}ODCINEK 5: TAJNE DZIAŁANIA
Dialogue: 0,0:02:18.21,0:02:19.88,Default,Basen,0,0,0,,Poddaję się.
Dialogue: 0,0:02:23.43,0:02:25.48,Default,Jinshi,0,0,0,,Poprawiłeś się, Basen.
Dialogue: 0,0:02:25.84,0:02:26.88,Default,Basen,0,0,0,,Nie…
Dialogue: 0,0:02:27.27,0:02:32.13,Default,Basen,0,0,0,,Jeszcze dużo mi brakuje,\Nby cię pokonać, mistrzu Jinshi.
Dialogue: 0,0:02:32.13,0:02:36.84,Default,Jinshi,0,0,0,,Twoja potęga jest imponująca. W końcu \Njak przystało na potomka klanu Ma.
Dialogue: 0,0:02:40.61,0:02:43.64,Default,Jinshi,0,0,0,,Gaoshun, jak sobie radzi \Nnasza zielareczka?
Dialogue: 0,0:02:44.14,0:02:46.22,Default,Gaoshun,0,0,0,,O co dokładnie pytasz?
Dialogue: 0,0:02:46.80,0:02:48.69,Default,Jinshi,0,0,0,,Czy nabrała trochę ciałka?
Dialogue: 0,0:02:48.69,0:02:50.94,Default,Gaoshun,0,0,0,,Sądzę, że trochę odżyła.
Dialogue: 0,0:02:51.76,0:02:54.27,Default,Jinshi,0,0,0,,Dobrze. Więc…
Dialogue: 0,0:02:54.64,0:02:57.86,Default,Maomao,0,0,0,,Rozumiesz, czemu zostało to zakazane?!
Dialogue: 0,0:02:57.86,0:02:59.45,Default,Maomao,0,0,0,,Mówiłam ci już, to trucizna.
Dialogue: 0,0:02:59.79,0:03:02.47,Default,Jinshi,0,0,0,,Nie spodziewałem się\Nzobaczyć jej od tej strony.
Dialogue: 0,0:03:03.56,0:03:04.73,Default,Gaoshun,0,0,0,,Wszystko w porządku?
Dialogue: 0,0:03:04.73,0:03:06.49,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:03:06.82,0:03:09.08,Default,Gaoshun,0,0,0,,Wyglądasz, jakbyś czymś się przejął.
Dialogue: 0,0:03:13.29,0:03:15.82,Default,Gaoshun,0,0,0,,Zapomnij, że pytałem.
Dialogue: 0,0:03:25.48,0:03:26.76,Default,Maomao,0,0,0,,Wiedziałam, że się uda!
Dialogue: 0,0:03:28.68,0:03:30.63,Default,Maomao,0,0,0,,Tak!
Dialogue: 0,0:03:31.94,0:03:33.69,Default,Maomao,0,0,0,,O rany! Tu jest!
Dialogue: 0,0:03:33.69,0:03:35.19,Default,Maomao,0,0,0,,I tu też!
Dialogue: 0,0:03:36.55,0:03:39.24,Default,Maomao,0,0,0,,Gdzie by to zjeść? Może w kuchni?
Dialogue: 0,0:03:39.24,0:03:42.01,Default,Maomao,0,0,0,,Ale tam będą pytać skąd to mam…
Dialogue: 0,0:03:42.01,0:03:44.16,Default,Maomao,0,0,0,,Jednak wcześniej…
Dialogue: 0,0:03:45.17,0:03:47.53,Default,Xiaolan,0,0,0,,Rany, jak to pysznie wygląda!
Dialogue: 0,0:03:47.53,0:03:50.20,Default,Xiaolan,0,0,0,,Jak zawsze dzięki, Maomao!
Dialogue: 0,0:03:50.20,0:03:56.50,Default,Xiaolan,0,0,0,,To miło z ich strony, że przy każdym\Nprzyjęciu dzielą się z tobą przekąskami.
Dialogue: 0,0:03:57.16,0:03:58.81,Default,Yinghua,0,0,0,,Powinnaś więcej jeść!
Dialogue: 0,0:03:58.81,0:04:00.56,Default,Guiyuan,0,0,0,,Jesteś taka wychudzona!
Dialogue: 0,0:04:00.56,0:04:02.41,Default,Ailan,0,0,0,,Nie krępuj się!
Dialogue: 0,0:04:04.80,0:04:06.89,Default,Xiaolan,0,0,0,,Słyszałaś nowe pogłoski?
Dialogue: 0,0:04:06.89,0:04:07.99,Default,Maomao,0,0,0,,Jakie?
Dialogue: 0,0:04:07.99,0:04:09.50,Default,Xiaolan,0,0,0,,Ponoć pewna służka
Dialogue: 0,0:04:09.50,0:04:13.44,Default,Xiaolan,0,0,0,,uwiodła wojskowego oficera,\Nznanego ze swojej nienawiści do kobiet.
Dialogue: 0,0:04:13.44,0:04:14.89,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:04:14.89,0:04:16.83,Default,Xiaolan,0,0,0,,Zgadnij, jak to zrobiła.
Dialogue: 0,0:04:16.83,0:04:17.90,Default,Maomao,0,0,0,,Ciekawe…
Dialogue: 0,0:04:18.02,0:04:20.19,Default,Xiaolan,0,0,0,,Podobno użyła afrodyzjaku!
Dialogue: 0,0:04:20.95,0:04:22.19,Default,Maomao,0,0,0,,Afrody… zjaku?
Dialogue: 0,0:04:27.09,0:04:29.80,Default,Maomao,0,0,0,,- Aha.\N- Co się stało, Maomao?
Dialogue: 0,0:04:29.80,0:04:33.75,Default,Maomao,0,0,0,,N-nic takiego.\NTo na pewno przypadek.
Dialogue: 0,0:04:36.77,0:04:38.29,Default,Maomao,0,0,0,,Dzieńdoberek.
Dialogue: 0,0:04:38.69,0:04:42.00,Default,Guen,0,0,0,,Hej, panienko!\NCo dzisiaj słychać?
Dialogue: 0,0:04:42.00,0:04:44.94,Default,Maomao,0,0,0,,Chciałabym ci o czymś powiedzieć.
Dialogue: 0,0:04:44.94,0:04:45.96,Default,Guen,0,0,0,,O czym?
Dialogue: 0,0:04:46.61,0:04:47.82,Default,Maomao,0,0,0,,O tym.
Dialogue: 0,0:04:49.08,0:04:51.18,Default,Guen,0,0,0,,To pyszniutkie gąski sosnowe!
Dialogue: 0,0:04:51.64,0:04:53.73,Default,Maomao,0,0,0,,Widzę, żeś bardzo zadowolony.
Dialogue: 0,0:04:53.73,0:04:58.16,Default,Guen,0,0,0,,Idę po węgiel! Wezmę od razu\Ntrochę pasty sojowej i soli!
Dialogue: 0,0:04:58.16,0:05:03.74,Default,Maomao,0,0,0,,Jakoś tak wyszło, że zostałam\Nkumpelą tego konowała.
Dialogue: 0,0:05:07.16,0:05:09.72,Default,Guen,0,0,0,,Palce lizać!
Dialogue: 0,0:05:09.72,0:05:11.49,Default,Maomao,0,0,0,,Chyba już są gotowe.
Dialogue: 0,0:05:11.49,0:05:14.63,Default,Maomao,0,0,0,,Dodać trochę pasty sojowej i soli…
Dialogue: 0,0:05:16.28,0:05:17.28,Default,Maomao,0,0,0,,Proszę.
Dialogue: 0,0:05:21.17,0:05:22.55,Default,Guen,0,0,0,,Niebo w gębie!
Dialogue: 0,0:05:22.55,0:05:24.41,Default,Maomao,0,0,0,,Witaj w klubie, wspólniku.
Dialogue: 0,0:05:25.55,0:05:28.43,Default,Maomao & Guen,0,0,0,,Pychota!
Dialogue: 0,0:05:28.72,0:05:30.18,Default,Eunuch A,0,0,0,,Medyku!
Dialogue: 0,0:05:31.35,0:05:33.22,Default,Eunuch A,0,0,0,,Kl-klątwa…
Dialogue: 0,0:05:33.56,0:05:36.48,Default,Eunuch A,0,0,0,,Czy umiesz wyczarować lek,\Nktóry uleczy klątwę?
Dialogue: 0,0:05:36.48,0:05:37.48,Default,Maomao,0,0,0,,Klątwę?
Dialogue: 0,0:05:38.24,0:05:39.60,Default,Guen,0,0,0,,Co masz na myśli?
Dialogue: 0,0:05:39.60,0:05:40.67,Default,Eunuch A,0,0,0,,To.
Dialogue: 0,0:05:43.84,0:05:48.14,Default,Maomao,0,0,0,,Paskudna wysypka.\NMoże lepiej zastosować jakąś maść?
Dialogue: 0,0:05:48.14,0:05:50.14,Default,Guen,0,0,0,,Mogłabyś ją zrobić?
Dialogue: 0,0:05:50.14,0:05:51.45,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:05:52.36,0:05:54.87,Default,Guen,0,0,0,,Na czym polega owa klątwa?
Dialogue: 0,0:05:55.43,0:05:59.12,Default,Eunuch A,0,0,0,,Wszystko zaczęło się przedwczoraj.
Dialogue: 0,0:05:59.70,0:06:01.79,Default,Eunuch A,0,0,0,,Byłem odpowiedzialny\Nza spalanie śmieci
Dialogue: 0,0:06:01.79,0:06:03.96,Default,Eunuch A,0,0,0,,na zachodniej stronie miasta.
Dialogue: 0,0:06:04.38,0:06:07.13,Default,Eunuch A,0,0,0,,Jak zawsze wykonywałem\Nswoje obowiązki.
Dialogue: 0,0:06:09.19,0:06:10.25,Default,Eunuch A,0,0,0,,Co to takiego?
Dialogue: 0,0:06:13.41,0:06:16.81,Default,Eunuch A,0,0,0,,Kobieca sukienka?\NRękawy są częściowo spalone.
Dialogue: 0,0:06:17.49,0:06:19.00,Default,Eunuch A,0,0,0,,Drewniane tabliczki do pisania?
Dialogue: 0,0:06:19.69,0:06:25.19,Default,Eunuch A,0,0,0,,Zaintrygowało mnie to, co znalazłem,\Nale wrzuciłem to do ognia. I wtedy…
Dialogue: 0,0:06:39.70,0:06:42.79,Default,Eunuch A,0,0,0,,Bez dwóch zdań, to klątwa!\NMoje bidne ręce!
Dialogue: 0,0:06:44.71,0:06:48.09,Default,Maomao,0,0,0,,Czy płomienie miały taki kolor?
Dialogue: 0,0:06:51.24,0:06:53.19,Default,Maomao,0,0,0,,A może taki?
Dialogue: 0,0:06:55.46,0:06:57.14,Default,Maomao,0,0,0,,Wynik będzie taki sam.
Dialogue: 0,0:06:58.76,0:07:01.34,Default,Guen,0,0,0,,Panienko, co to za czary?
Dialogue: 0,0:07:01.34,0:07:03.63,Default,Maomao,0,0,0,,Na pewno słyszałeś o fajerwerkach.
Dialogue: 0,0:07:03.63,0:07:06.73,Default,Maomao,0,0,0,,Niektóre rzeczy zmieniają\Nkolor podczas spalania.
Dialogue: 0,0:07:07.14,0:07:09.03,Default,Eunuch A,0,0,0,,Co w takim razie z moimi rękami?
Dialogue: 0,0:07:09.56,0:07:12.87,Default,Maomao,0,0,0,,Najpewniej drewniane tabliczki\Nzostały pokryte jakąś substancją.
Dialogue: 0,0:07:13.73,0:07:16.54,Default,Maomao,0,0,0,,Prawdopodobnie doszło\Ndo reakcji alergicznej.
Dialogue: 0,0:07:16.81,0:07:19.69,Default,Maomao,0,0,0,,Ta maść powinna złagodzić stan zapalny.
Dialogue: 0,0:07:19.69,0:07:21.61,Default,Eunuch A,0,0,0,,Dziękuję bardzo.
Dialogue: 0,0:07:21.61,0:07:24.11,Default,Guen,0,0,0,,Lekarstwa tej panienki są magiczne!
Dialogue: 0,0:07:24.11,0:07:25.67,Default,Guen,0,0,0,,W mgnieniu oka wrócisz do zdrowia!
Dialogue: 0,0:07:27.13,0:07:29.88,Default,Jinshi,0,0,0,,Jak zawsze dobra robota, zielareczko.
Dialogue: 0,0:07:30.37,0:07:31.97,Default,Guen,0,0,0,,Pan Jinshi!
Dialogue: 0,0:07:33.40,0:07:35.61,Default,Guen,0,0,0,,Zaparzę panu herbaty.
Dialogue: 0,0:07:37.60,0:07:41.48,Default,Maomao,0,0,0,,Witam, panie Jinshi.\NCo cię dzisiaj do mnie sprowadza?
Dialogue: 0,0:07:41.91,0:07:45.44,Default,Jinshi,0,0,0,,Czyżbyś sugerowała, że odzywam\Nsię tylko dlatego, że coś chcę?
Dialogue: 0,0:07:45.44,0:07:47.82,Default,Maomao,0,0,0,,Gdzieżbym śmiała.
Dialogue: 0,0:07:49.70,0:07:51.20,Default,Jinshi,0,0,0,,Przejdźmy się.
Dialogue: 0,0:07:52.48,0:07:54.45,Default,Guen,0,0,0,,Dziękuję za cierpliwość, panie Jinshi…
Dialogue: 0,0:08:01.12,0:08:02.89,Default,Jinshi,0,0,0,,Ile jest kolorów?
Dialogue: 0,0:08:03.35,0:08:05.83,Default,Maomao,0,0,0,,Dokładnie to nie wiem.
Dialogue: 0,0:08:05.83,0:08:09.46,Default,Jinshi,0,0,0,,W jaki sposób możemy użyć tych kolorów?
Dialogue: 0,0:08:09.46,0:08:12.78,Default,Maomao,0,0,0,,Z rozpuszczoną w wodzie solą.
Dialogue: 0,0:08:12.78,0:08:17.16,Default,Maomao,0,0,0,,Czasami niektóre wymagają innego\Nrozpuszczalnika, na przykład oleju.
Dialogue: 0,0:08:17.16,0:08:19.47,Default,Maomao,0,0,0,,Ale na tym się nie znam.
Dialogue: 0,0:08:20.13,0:08:21.31,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:08:22.05,0:08:24.65,Default,Maomao,0,0,0,,Jeśli to wszystko, pójdę już.
Dialogue: 0,0:08:25.04,0:08:26.11,Default,Jinshi,0,0,0,,Czekaj.
Dialogue: 0,0:08:27.83,0:08:29.07,Default,Maomao,0,0,0,,Co znowu?
Dialogue: 0,0:08:29.72,0:08:30.94,Default,Jinshi,0,0,0,,Gotowanie na parze.
Dialogue: 0,0:08:34.22,0:08:36.33,Default,Jinshi,0,0,0,,Liczę na ciebie, zielareczko.
Dialogue: 0,0:08:36.92,0:08:38.70,Default,Maomao,0,0,0,,Dowiedział się.
Dialogue: 0,0:08:39.22,0:08:42.84,Default,Maomao,0,0,0,,Zobaczę, może jutro znajdę więcej.
Dialogue: 0,0:08:50.34,0:08:53.88,Default,Jinshi,0,0,0,,Znajdź wszystkich,\Nktórzy doznali poparzeń rąk.
Dialogue: 0,0:08:54.40,0:08:55.40,Default,Gaoshun,0,0,0,,Robi się.
Dialogue: 0,0:08:56.72,0:09:00.12,Default,Maomao,0,0,0,,Te drewniane tabliczki\Nmuszą coś w sobie kryć.
Dialogue: 0,0:09:00.88,0:09:05.72,Default,Maomao,0,0,0,,Czegoś takiego używa się tylko do…\Njakichś podejrzanych spraw?
Dialogue: 0,0:09:05.72,0:09:07.30,Default,Maomao,0,0,0,,O co tu chodzi?
Dialogue: 0,0:09:09.65,0:09:14.20,Default,Maomao,0,0,0,,Bez jaj, to nie moja działka.\NJestem tylko testerką.
Dialogue: 0,0:09:17.32,0:09:21.45,Default,Hongniang,0,0,0,,Dziękuję.\NProszę, zabierz to tam.
Dialogue: 0,0:09:22.20,0:09:23.75,Default,Maomao,0,0,0,,Wróciłam.
Dialogue: 0,0:09:24.12,0:09:25.69,Default,Hongniang,0,0,0,,Witaj.
Dialogue: 0,0:09:26.28,0:09:28.38,Default,Yinghua,0,0,0,,- Maomao, w samą porę.
Dialogue: 0,0:09:27.32,0:09:29.48,Default,Hongniang,0,0,0,,{\an8}- O, tutaj, dziękuję.
Dialogue: 0,0:09:29.09,0:09:31.18,Default,Yinghua,0,0,0,,Przymierz to, dobrze?
Dialogue: 0,0:09:31.18,0:09:33.38,Default,Maomao,0,0,0,,Co? Mam złe przeczucia…
Dialogue: 0,0:09:37.24,0:09:38.76,Default,Maomao,0,0,0,,Na jaką to okazję?
Dialogue: 0,0:09:39.17,0:09:42.60,Default,Yinghua,0,0,0,,A jak myślisz?\NNa przyjęcie, rzecz jasna!
Dialogue: 0,0:09:42.60,0:09:44.09,Default,Maomao,0,0,0,,Przyjęcie?
Dialogue: 0,0:09:44.09,0:09:48.77,Default,Yinghua,0,0,0,,Dwa razy w roku do cesarskich\Nogrodów przybywają ważni goście.
Dialogue: 0,0:09:48.77,0:09:50.94,Default,Yinghua,0,0,0,,Będą różne występy\Ni mnóstwo jedzenia.
Dialogue: 0,0:09:51.34,0:09:55.90,Default,Hongniang,0,0,0,,Cesarz nie zawarł jeszcze małżeństwa,\Nwięc nie ma cesarzowej, prawda?
Dialogue: 0,0:09:56.79,0:10:01.32,Default,Hongniang,0,0,0,,Zgodnie z tradycją przyprowadza się\Nkonkubiny najwyższej rangi.
Dialogue: 0,0:10:01.32,0:10:03.61,Default,Maomao,0,0,0,,Najwyższej rangi?
Dialogue: 0,0:10:03.16,0:10:08.08,Default,Text,0,0,0,,{\an8}CESARZ
Dialogue: 0,0:10:03.16,0:10:08.08,Default,Text,0,0,0,,{\an8}(KANDYDATKA NA CESARZOWĄ)
Dialogue: 0,0:10:03.16,0:10:10.88,Default,Text,0,0,0,,{\an8}KONKUBINA NAJWYŻSZEJ RANGI
Dialogue: 0,0:10:03.61,0:10:12.34,Default,Hongniang,0,0,0,,Pierwszeństwo mają konkubiny\No najwyższej randze. Są to:
Dialogue: 0,0:10:12.68,0:10:14.86,Default,Hongniang,0,0,0,,Szlachetna dama Gyokuyou.
Dialogue: 0,0:10:14.86,0:10:17.06,Default,Hongniang,0,0,0,,Mądra dama Li Hua.
Dialogue: 0,0:10:17.06,0:10:19.20,Default,Hongniang,0,0,0,,Cnotliwa dama Li Shu.
Dialogue: 0,0:10:19.20,0:10:21.18,Default,Hongniang,0,0,0,,Czysta dama A Duo.
Dialogue: 0,0:10:22.02,0:10:24.41,Default,Hongniang,0,0,0,,Ostatnio panie Gyokuyou\Ni Li Hua były nieobecne.
Dialogue: 0,0:10:24.41,0:10:26.65,Default,Hongniang,0,0,0,,ze względu na narodziny dzieci.
Dialogue: 0,0:10:26.65,0:10:29.60,Default,Hongniang,0,0,0,,Dlatego tym razem zaproszono\Nwszystkie cztery konkubiny.
Dialogue: 0,0:10:29.60,0:10:32.09,Default,Maomao,0,0,0,,A po co my mamy tam iść?
Dialogue: 0,0:10:32.09,0:10:35.02,Default,Hongniang,0,0,0,,W zasadzie to po nic.
Dialogue: 0,0:10:38.07,0:10:43.37,Default,Gyokuyou,0,0,0,,Naszą rolą jest\Npokazanie się u boku cesarza.
Dialogue: 0,0:10:43.88,0:10:46.17,Default,Hongniang,0,0,0,,Urzędnicy przybywają\Nz wyrazami szacunku.
Dialogue: 0,0:10:46.17,0:10:48.41,Default,Hongniang,0,0,0,,Nie zapominaj więc o uśmiechu.
Dialogue: 0,0:10:48.41,0:10:49.47,Default,Maomao,0,0,0,,Co…
Dialogue: 0,0:10:51.78,0:10:53.96,Default,Maomao,0,0,0,,Obecność jest obowiązkowa?
Dialogue: 0,0:10:53.96,0:10:55.84,Default,Yinghua,0,0,0,,Jeszcze jak!
Dialogue: 0,0:10:56.27,0:10:58.48,Default,Yinghua,0,0,0,,To pierwszy występ\Nksiężniczki Ling Li,
Dialogue: 0,0:10:58.48,0:11:01.09,Default,Yinghua,0,0,0,,dlatego też wszystkie\Ncztery konkubiny biorą udział!
Dialogue: 0,0:11:01.44,0:11:04.72,Default,Yinghua,0,0,0,,To wojna!\NNie możemy się poddać!
Dialogue: 0,0:11:05.00,0:11:07.56,Default,Yinghua,0,0,0,,Lecimy z koksem!
Dialogue: 0,0:11:08.90,0:11:11.92,Default,Maomao,0,0,0,,Pani Gyokuyou nie ma wielu służek.
Dialogue: 0,0:11:11.92,0:11:14.75,Default,Maomao,0,0,0,,Nowicjuszka nie może dać nogi.
Dialogue: 0,0:11:14.75,0:11:18.99,Default,Maomao,0,0,0,,Ponadto podczas przyjęcia\Npotrzebna będzie testerka.
Dialogue: 0,0:11:18.99,0:11:22.65,Default,Yinghua,0,0,0,,Tak myślałam,\Ntrzeba będzie wypchać ci cycki.
Dialogue: 0,0:11:22.65,0:11:25.53,Default,Yinghua,0,0,0,,Z biodrami jest podobnie.\NDobrze?
Dialogue: 0,0:11:25.53,0:11:26.79,Default,Maomao,0,0,0,,Rób, co chcesz.
Dialogue: 0,0:11:28.35,0:11:30.41,Default,Yinghua,0,0,0,,Makijaż też ci zrobimy!
Dialogue: 0,0:11:31.81,0:11:34.52,Default,Yinghua,0,0,0,,Zamaskujemy te piegi!
Dialogue: 0,0:11:36.82,0:11:39.00,Default,Maomao,0,0,0,,Przyjęcie na zewnątrz\Nw lodowatym wietrze,
Dialogue: 0,0:11:39.00,0:11:41.88,Default,Maomao,0,0,0,,podziwianie występów,\Nspożywanie posiłków i…
Dialogue: 0,0:11:41.88,0:11:45.30,Default,Maomao,0,0,0,,głupie uśmiechanie się do urzędasów.
Dialogue: 0,0:11:45.93,0:11:49.62,Default,Maomao,0,0,0,,Definitywnie potrzebny\Nmi będzie żelazny pęcherz.
Dialogue: 0,0:11:50.08,0:11:51.31,Default,Maomao,0,0,0,,W takim razie…
Dialogue: 0,0:12:01.82,0:12:03.67,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:12:03.67,0:12:05.62,Default,Hongniang,0,0,0,,Ale ładny zapach.
Dialogue: 0,0:12:06.00,0:12:08.04,Default,Hongniang,0,0,0,,Co robisz?
Dialogue: 0,0:12:08.04,0:12:10.17,Default,Maomao,0,0,0,,Cukierki na bazie imbiru i pomarańczy.
Dialogue: 0,0:12:10.17,0:12:11.22,Default,Hongniang,0,0,0,,Cukierki?
Dialogue: 0,0:12:11.54,0:12:17.45,Default,Maomao,0,0,0,,Skórka pomarańczy poprawia przepływ \Nkrwi, a imbir rozgrzewa organizm.
Dialogue: 0,0:12:17.91,0:12:20.24,Default,Hongniang,0,0,0,,Czy to na przyjęcie w ogrodzie?!
Dialogue: 0,0:12:20.24,0:12:24.30,Default,Maomao,0,0,0,,Tak. Zrobiłam to na zaś.
Dialogue: 0,0:12:24.77,0:12:27.18,Default,Maomao,0,0,0,,Naszyłam też kieszonki na bieliźnie.
Dialogue: 0,0:12:27.18,0:12:30.81,Default,Maomao,0,0,0,,Włożę do nich rozgrzane kamienie,\Nktóre pomogą przetrwać zimno.
Dialogue: 0,0:12:30.81,0:12:32.12,Default,Hongniang,0,0,0,,Maomao!
Dialogue: 0,0:12:32.75,0:12:36.02,Default,Hongniang,0,0,0,,Błagam cię, dla nas też takie zrób!
Dialogue: 0,0:12:36.77,0:12:38.42,Default,Maomao,0,0,0,,J-jasne…
Dialogue: 0,0:12:42.44,0:12:47.37,Default,Maomao,0,0,0,,Chyba zbytnie przyzwyczajenie się\Ndo tradycji tłamsi najprostsze pomysły.
Dialogue: 0,0:12:48.37,0:12:52.49,Default,Maomao,0,0,0,,Trochę sprytu jeszcze\Nnikomu nie zaszkodziło.
Dialogue: 0,0:12:53.22,0:12:54.22,Default,Maomao,0,0,0,,Proszę.
Dialogue: 0,0:12:54.38,0:12:56.96,Default,Jinshi,0,0,0,,Dla mnie też zrobisz?
Dialogue: 0,0:12:56.96,0:12:58.50,Default,Gaoshun,0,0,0,,Też bym prosił…
Dialogue: 0,0:12:58.50,0:12:59.58,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:13:00.31,0:13:02.76,Default,Seamstress,0,0,0,,Proszę, naucz mnie,\Njak to zrobić.
Dialogue: 0,0:13:02.76,0:13:04.20,Default,Cook,0,0,0,,Prosimy.
Dialogue: 0,0:13:04.20,0:13:07.89,Default,Maomao,0,0,0,,Cesarska krawcowa i sługa\Nodpowiedzialny za cesarski stół też?
Dialogue: 0,0:13:36.98,0:13:38.44,Default,Yinghua,0,0,0,,Ale zimnica!
Dialogue: 0,0:13:53.40,0:13:54.98,Default,Maomao,0,0,0,,Nareszcie koniec.
Dialogue: 0,0:13:56.82,0:13:58.70,Default,Maomao,0,0,0,,To już jutro.
Dialogue: 0,0:14:01.56,0:14:05.11,Default,Maomao,0,0,0,,Przezorny zawsze ubezpieczony.\NZrobię jeszcze kilka.
Dialogue: 0,0:14:06.07,0:14:09.11,Default,Gaoshun,0,0,0,,Jeśli chodzi o kwestię osób,\Nktóre poparzyły sobie ręce…
Dialogue: 0,0:14:09.91,0:14:11.70,Default,Jinshi,0,0,0,,Dalej nic nie ma?
Dialogue: 0,0:14:13.83,0:14:15.19,Default,Gaoshun,0,0,0,,Przykro mi.
Dialogue: 0,0:14:15.62,0:14:20.39,Default,Jinshi,0,0,0,,Przyjęcie tuż, tuż.\NOby nie było żadnych problemów.
Dialogue: 0,0:14:39.85,0:14:42.19,Default,Ladies-in-Waiting Trio,0,0,0,,Łał…
Dialogue: 0,0:14:42.19,0:14:44.14,Default,Yinghua,0,0,0,,Przepięknie wyglądasz, pani!
Dialogue: 0,0:14:44.14,0:14:46.70,Default,Guiyuan,0,0,0,,W czerwieni ci do twarzy!
Dialogue: 0,0:14:46.70,0:14:48.90,Default,Ailan,0,0,0,,Zapierasz dech w piersi…
Dialogue: 0,0:14:49.18,0:14:52.74,Default,Maomao,0,0,0,,Teraz już wiem, że nikt nigdy\Nnie wyglądał lepiej w czerwieni.
Dialogue: 0,0:14:52.74,0:14:55.96,Default,Hongniang,0,0,0,,Zgadza się,\Njesteś najpiękniejsza ze wszystkich.
Dialogue: 0,0:14:56.98,0:15:00.38,Default,Gyokuyou,0,0,0,,Dziękuję. Dla was też coś mam.
Dialogue: 0,0:15:01.46,0:15:05.95,Default,Gyokuyou,0,0,0,,Dzięki tej biżuterii niepożądani\Ngoście będą trzymani na dystans.
Dialogue: 0,0:15:07.86,0:15:09.06,Default,Gyokuyou,0,0,0,,Maomao.
Dialogue: 0,0:15:10.08,0:15:14.76,Default,Gyokuyou,0,0,0,,Pamiętaj, Maomao.\NJesteś jedną z moich osobistych służek.
Dialogue: 0,0:15:17.92,0:15:20.49,Default,Maomao,0,0,0,,Ja, dziękuję.
Dialogue: 0,0:15:21.27,0:15:22.27,Default,Yinghua,0,0,0,,Mam ją!
Dialogue: 0,0:15:24.04,0:15:25.45,Default,Maomao,0,0,0,,Chwila moment.
Dialogue: 0,0:15:25.45,0:15:27.43,Default,Guiyuan; Ailan,0,0,0,,Czas na makijaż.
Dialogue: 0,0:15:28.08,0:15:30.28,Default,Gyokuyou,0,0,0,,Zafundujcie jej metamorfozę!
Dialogue: 0,0:15:30.28,0:15:32.57,Default,Yinghua,0,0,0,,Umyjemy ci twarzyczkę\Ni nałożymy balsam.
Dialogue: 0,0:15:32.57,0:15:34.16,Default,Yinghua,0,0,0,,Czas zająć się piegami…
Dialogue: 0,0:15:34.52,0:15:35.53,Default,Guiyuan,0,0,0,,Hop!
Dialogue: 0,0:15:38.69,0:15:39.69,Default,Ailan,0,0,0,,Co?
Dialogue: 0,0:15:39.69,0:15:40.97,Default,Guiyuan,0,0,0,,Maomao?
Dialogue: 0,0:15:40.97,0:15:43.24,Default,Yinghua,0,0,0,,- No nie…\N- Dlaczego?
Dialogue: 0,0:15:43.24,0:15:44.92,Default,Gyokuyou,0,0,0,,Maomao, ty…
Dialogue: 0,0:15:46.08,0:15:47.46,Default,Maomao,0,0,0,,Rety…
Dialogue: 0,0:15:47.46,0:15:49.08,Default,Maomao,0,0,0,,Mają mnie.
Dialogue: 0,0:15:50.80,0:15:52.86,Default,Gyokuyou,0,0,0,,Dobrze, idziemy.
Dialogue: 0,0:16:12.40,0:16:15.74,Default,Jinshi,0,0,0,,Konkubino Li Shu,\Ndo zobaczenia na przyjęciu.
Dialogue: 0,0:16:16.01,0:16:19.91,Default,Lishu,0,0,0,,Dobrze, panie Jinshi.
Dialogue: 0,0:16:26.25,0:16:29.66,Default,Jinshi,0,0,0,,Na koniec została Szlachetna Dama,\Npani Gyokuyou.
Dialogue: 0,0:16:32.07,0:16:35.18,Default,Gaoshun,0,0,0,,Upodobał sobie konkubinę Gyokuyou,
Dialogue: 0,0:16:35.18,0:16:38.38,Default,Gaoshun,0,0,0,,bo znalazł sobie zabaweczkę,\Nktóra mu się podoba.
Dialogue: 0,0:16:39.44,0:16:41.50,Default,Gaoshun,0,0,0,,Same z nim problemy.
Dialogue: 0,0:16:45.68,0:16:48.44,Default,Gyokuyou,0,0,0,,Maomao, bardzo mi pomogłaś.
Dialogue: 0,0:16:48.44,0:16:50.78,Default,Maomao,0,0,0,,Cieszę się, że mogłam pomóc.
Dialogue: 0,0:16:50.78,0:16:52.92,Default,Jinshi,0,0,0,,Witaj, konkubino Gyokuyou.
Dialogue: 0,0:16:52.92,0:16:54.28,Default,Gyokuyou,0,0,0,,Witaj.
Dialogue: 0,0:16:54.68,0:16:57.74,Default,Jinshi,0,0,0,,Pani, zdecydowanie\Nw czerwieni ci do twarzy.
Dialogue: 0,0:16:58.55,0:17:05.03,Default,Jinshi,0,0,0,,Twój olśniewający, pełen tajemniczości \Nurok wynika zapewne z jadeitowych oczu.
Dialogue: 0,0:17:06.47,0:17:07.54,Default,Gyokuyou,0,0,0,,Dziękuję.
Dialogue: 0,0:17:12.55,0:17:14.92,Default,Jinshi,0,0,0,,A jak się ma nasza mała…
Dialogue: 0,0:17:24.40,0:17:26.44,Default,Maomao,0,0,0,,Witaj, panie Jinshi.
Dialogue: 0,0:17:30.19,0:17:32.44,Default,Jinshi,0,0,0,,A, to ty, zielareczko.
Dialogue: 0,0:17:32.93,0:17:34.32,Default,Jinshi,0,0,0,,Zrobiłaś sobie makijaż?
Dialogue: 0,0:17:34.32,0:17:36.07,Default,Maomao,0,0,0,,Nie, wręcz przeciwnie.
Dialogue: 0,0:17:36.41,0:17:37.99,Default,Jinshi,0,0,0,,Twoje piegi zniknęły.
Dialogue: 0,0:17:38.36,0:17:39.99,Default,Maomao,0,0,0,,Bo je zmyłam.
Dialogue: 0,0:17:40.35,0:17:41.95,Default,Jinshi,0,0,0,,Znaczy ukryłaś pod makijażem?
Dialogue: 0,0:17:41.95,0:17:44.41,Default,Maomao,0,0,0,,Zmyłam makijaż. Dlatego zniknęły.
Dialogue: 0,0:17:46.41,0:17:50.76,Default,Jinshi,0,0,0,,To, co mówisz, nie ma sensu.\NSama sobie zaprzeczasz.
Dialogue: 0,0:17:50.76,0:17:55.26,Default,Maomao,0,0,0,,Jezu, ale półgłówek.\NTrzeba było przytaknąć.
Dialogue: 0,0:17:55.52,0:18:00.25,Default,Maomao,0,0,0,,Każdego dnia dorysowuję\Nte piegi przy użyciu gliny.
Dialogue: 0,0:18:00.25,0:18:04.28,Default,Maomao,0,0,0,,Za każdym razem, gdy mnie widziałeś,\Nmiałam na sobie makijaż.
Dialogue: 0,0:18:04.81,0:18:08.27,Default,Maomao,0,0,0,,Makijaż nie służy wyłącznie\Ndo poprawy urody.
Dialogue: 0,0:18:08.93,0:18:10.81,Default,Jinshi,0,0,0,,Dlaczego miałabyś to robić?
Dialogue: 0,0:18:12.40,0:18:13.91,Default,Maomao,0,0,0,,Naprawdę chcesz to wiedzieć?
Dialogue: 0,0:18:15.30,0:18:18.36,Default,Maomao,0,0,0,,Aby odstraszyć każdego\Nod zaciągnięcia mnie w ciemny zaułek.
Dialogue: 0,0:18:20.13,0:18:24.00,Default,Maomao,0,0,0,,Mieszkałam obok burdeli, ale nie każdy \Nklient wychodził zaspokojony.
Dialogue: 0,0:18:24.00,0:18:27.46,Default,Maomao,0,0,0,,Damscy bokserzy bez grosza przy\Nduszy z chorobami wenerycznymi.
Dialogue: 0,0:18:28.40,0:18:33.21,Default,Maomao,0,0,0,,Niska, chuda i brzydka dziewczyna\Nrzadko kiedy bywa ich celem.
Dialogue: 0,0:18:34.07,0:18:35.53,Default,Jinshi,0,0,0,,Zaciągnął cię ktoś kiedyś?
Dialogue: 0,0:18:35.53,0:18:39.97,Default,Maomao,0,0,0,,Było blisko. Ostatecznie\Nzostałam porwana i sprzedana.
Dialogue: 0,0:18:43.16,0:18:49.32,Default,Maomao,0,0,0,,Właśnie wtedy mój makijaż był słaby.\NPewnie dlatego byłam atrakcyjniejsza.
Dialogue: 0,0:18:49.32,0:18:50.98,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:18:51.97,0:18:55.48,Default,Jinshi,0,0,0,,Przykro mi to słyszeć.\NPo części to moja wina.
Dialogue: 0,0:18:55.48,0:18:57.84,Default,Maomao,0,0,0,,Co się stało, to się nie odstanie.
Dialogue: 0,0:18:57.84,0:19:04.08,Default,Maomao,0,0,0,,Kupiec nie wie, czy ofiarę porwano,\Nczy sprzedała ją biedna rodzina.
Dialogue: 0,0:19:05.38,0:19:07.00,Default,Jinshi,0,0,0,,Nie złości cię to?
Dialogue: 0,0:19:07.33,0:19:13.17,Default,Maomao,0,0,0,,Oczywiście, że tak.\NAle to nie twoja wina.
Dialogue: 0,0:19:16.69,0:19:18.41,Default,Jinshi,0,0,0,,Naprawdę mi przykro.
Dialogue: 0,0:19:20.42,0:19:22.41,Default,Maomao,0,0,0,,Chociaż raz jest szczery.
Dialogue: 0,0:19:30.18,0:19:31.19,Default,Maomao,0,0,0,,Bolało.
Dialogue: 0,0:19:32.16,0:19:34.39,Default,Jinshi,0,0,0,,Przepraszam. To dla ciebie.
Dialogue: 0,0:19:37.07,0:19:39.44,Default,Jinshi,0,0,0,,Do zobaczenia na przyjęciu.
Dialogue: 0,0:19:50.78,0:19:54.56,Default,Maomao,0,0,0,,Męska spinka do włosów?\NPo co mi ona?
Dialogue: 0,0:19:54.96,0:19:57.21,Default,Yinghua,0,0,0,,Rany, piękna!
Dialogue: 0,0:19:57.21,0:19:58.49,Default,Guiyuan,0,0,0,,Zazdroszczę!
Dialogue: 0,0:19:58.49,0:20:00.52,Default,Ailan,0,0,0,,Ja też chcę!
Dialogue: 0,0:20:00.52,0:20:03.34,Default,Maomao,0,0,0,,Mogłabym ją oddać tylko komu?
Dialogue: 0,0:20:03.34,0:20:06.66,Default,Gyokuyou,0,0,0,,Już złamałaś swoją obietnicę.
Dialogue: 0,0:20:10.32,0:20:13.42,Default,Gyokuyou,0,0,0,,Nie jesteś już tylko moja.
Dialogue: 0,0:20:16.45,0:20:19.07,Default,Maomao,0,0,0,,Nie bardzo wiem, o co chodzi…
Dialogue: 0,0:20:21.07,0:20:22.42,Default,Gyokuyou,0,0,0,,Zaczyna się.
Dialogue: 0,0:20:49.17,0:20:52.06,Default,Maomao,0,0,0,,Zaczyna się przyjęcie w ogrodzie.
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.21,0:22:48.78,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Przyjęcie w ogrodzie”.
Dialogue: 0,0:22:48.81,0:22:50.45,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
