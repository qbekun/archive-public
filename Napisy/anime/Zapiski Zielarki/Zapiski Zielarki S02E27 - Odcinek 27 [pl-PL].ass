Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\pos(320.885,308.739)\an2}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:36.49,0:01:37.95,Default,Jinshi,0,0,0,,Idę do Jadeitowego Pałacu.
Dialogue: 0,0:01:38.53,0:01:39.24,Default,Gaoshun,0,0,0,,Dobrze.
Dialogue: 0,0:01:41.87,0:01:43.33,Default,Gyokuyou,0,0,0,,Zmarła?
Dialogue: 0,0:01:44.37,0:01:47.04,Default,Gyokuyou,0,0,0,,Rozumiem. Konkubina Jin...
Dialogue: 0,0:01:47.41,0:01:50.50,Default,Hongniang,0,0,0,,Podobno to było zatrucie pokarmowe.\NTaką dostaliśmy informację.
Dialogue: 0,0:01:51.63,0:01:55.38,Default,Gyokuyou,0,0,0,,Słyszałam, że była\Nprzykuta do łóżka od roku.
Dialogue: 0,0:01:58.97,0:02:01.01,Default,Yinghua,0,0,0,,Przyszedł pan Jinshi.
Dialogue: 0,0:02:01.80,0:02:03.01,Default,Gyokuyou,0,0,0,,Wpuść go.
Dialogue: 0,0:02:03.89,0:02:07.85,Default,Text,0,0,0,,{\an8}ODCINEK 27: TRUPI GRZYB
Dialogue: 0,0:02:04.85,0:02:06.23,Default,Maomao,0,0,0,,Z góry dzięki.
Dialogue: 0,0:02:06.23,0:02:07.23,Default,Laundry Servant 1,0,0,0,,Jasne.
Dialogue: 0,0:02:12.06,0:02:13.65,Default,Maomao,0,0,0,,{\i1}Nic tu po mnie.
Dialogue: 0,0:02:14.48,0:02:16.53,Default,Maomao,0,0,0,,Jakaś służka zaginęła?
Dialogue: 0,0:02:16.53,0:02:19.45,Default,Guen,0,0,0,,Tak, nazywa się Tao.
Dialogue: 0,0:02:19.45,0:02:22.32,Default,Guen,0,0,0,,Dobra i pracowita dziewuszka.
Dialogue: 0,0:02:22.32,0:02:26.58,Default,Guen,0,0,0,,Jej praca dobiegała końca,\Na niebawem miała wyjść za mąż.
Dialogue: 0,0:02:27.12,0:02:28.46,Default,Maomao,0,0,0,,Za mąż?
Dialogue: 0,0:02:28.46,0:02:31.50,Default,Guen,0,0,0,,Ponoć na przyjęciu w ogrodzie\Ndostała spinkę do włosów.
Dialogue: 0,0:02:31.50,0:02:35.46,Default,Guen,0,0,0,,I to od wschodzącego urzędnika.
Dialogue: 0,0:02:36.05,0:02:38.51,Default,Guen,0,0,0,,Pani chciała jednak, by została.
Dialogue: 0,0:02:38.88,0:02:39.97,Default,Maomao,0,0,0,,Aha...
Dialogue: 0,0:02:40.51,0:02:46.10,Default,Maomao,0,0,0,,{\i1}Zatem tak zdolna służka\Nznika bez słowa.
Dialogue: 0,0:02:48.31,0:02:50.85,Default,Maomao,0,0,0,,Masz pomysł, dokąd poszła?
Dialogue: 0,0:02:50.85,0:02:53.23,Default,Guen,0,0,0,,Niestety nie.
Dialogue: 0,0:02:53.23,0:02:56.15,Default,Guen,0,0,0,,Tego typu rzeczy nie są jednak rzadkością.
Dialogue: 0,0:02:56.69,0:02:59.99,Default,Guen,0,0,0,,Wiele kobiet ma problemy\Nz relacjami międzyludzkimi.
Dialogue: 0,0:02:59.99,0:03:00.91,Default,Maomao,0,0,0,,Zauważyłam.
Dialogue: 0,0:03:03.37,0:03:06.33,Default,Maomao,0,0,0,,{\i1}Czasami zapominam,
Dialogue: 0,0:03:06.99,0:03:08.83,Default,Maomao,0,0,0,,{\i1}że jest to wewnętrzny pałac.
Dialogue: 0,0:03:08.83,0:03:11.71,Default,Maomao,0,0,0,,{\i1}Kwiatowy ogród wypełniony\Ndwoma tysiącami kobiet.
Dialogue: 0,0:03:15.00,0:03:16.09,Default,Gyokuyou,0,0,0,,Czyżby?
Dialogue: 0,0:03:16.09,0:03:17.76,Default,Maomao,0,0,0,,{\i1}Dzisiaj herbatka na świeżym powietrzu.
Dialogue: 0,0:03:18.30,0:03:21.01,Default,Maomao,0,0,0,,{\i1}Gdyby nie wychodziła,\Nludzie podejrzewaliby, że jest w ciąży.
Dialogue: 0,0:03:21.68,0:03:23.93,Default,Maomao,0,0,0,,{\i1}Przywiązuje wagę\Ndo miejsca i swojego stroju,
Dialogue: 0,0:03:23.93,0:03:26.89,Default,Maomao,0,0,0,,{\i1}ale zapewne niektórzy\Njuż to zauważyli.
Dialogue: 0,0:03:26.89,0:03:31.73,Default,Maomao,0,0,0,,{\i1}Sęk w tym, czy ten ktoś\Nma dobre, czy złe intencje?
Dialogue: 0,0:03:31.73,0:03:33.35,Default,Gyokuyou,0,0,0,,O, już wróciłaś.
Dialogue: 0,0:03:36.11,0:03:37.90,Default,Gyokuyou,0,0,0,,Podejdź tu, Maomao.
Dialogue: 0,0:03:42.20,0:03:43.66,Default,Maomao,0,0,0,,Mogę jakoś pomóc?
Dialogue: 0,0:03:43.66,0:03:45.20,Default,Gyokuyou,0,0,0,,Tak, jemu.
Dialogue: 0,0:03:46.87,0:03:49.08,Default,Jinshi,0,0,0,,To przenieśmy się gdzie indziej.
Dialogue: 0,0:03:49.95,0:03:53.87,Default,Gyokuyou,0,0,0,,Nie mam nic przeciwko.\NMoże pogadacie tutaj?
Dialogue: 0,0:03:54.38,0:03:58.80,Default,Jinshi,0,0,0,,Nie mogę spędzać tyle czasu\Nz ukochaną konkubiną cesarza.
Dialogue: 0,0:03:58.80,0:04:00.21,Default,Jinshi,0,0,0,,Poza tym... Słyszysz?
Dialogue: 0,0:04:02.68,0:04:03.51,Default,Gyokuyou,0,0,0,,Rany.
Dialogue: 0,0:04:03.51,0:04:06.47,Default,Hongniang,0,0,0,,Pani Gyokuyou, proszę.
Dialogue: 0,0:04:09.77,0:04:12.18,Default,Maomao,0,0,0,,Więc czego ci trzeba?
Dialogue: 0,0:04:12.77,0:04:17.90,Default,Jinshi,0,0,0,,Zapewne wiesz, że cesarz\Nrozdaje powieści konkubinom?
Dialogue: 0,0:04:17.90,0:04:21.94,Default,Maomao,0,0,0,,Tak. Po ich przeczytaniu\Ndają je swoim służkom.
Dialogue: 0,0:04:21.94,0:04:25.57,Default,Maomao,0,0,0,,A także innym służkom dookoła.
Dialogue: 0,0:04:25.99,0:04:29.74,Default,Maomao,0,0,0,,Powstają kopie, co zachęca\Nniektóre do nauki czytania i pisania.
Dialogue: 0,0:04:30.04,0:04:31.16,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:04:32.37,0:04:34.71,Default,Jinshi,0,0,0,,To wciąż jeszcze wstępny plan,
Dialogue: 0,0:04:34.71,0:04:37.38,Default,Jinshi,0,0,0,,ale myślałem o budowie czegoś takiego.
Dialogue: 0,0:04:37.75,0:04:41.01,Default,Jinshi,0,0,0,,To chyba nazywa się szkołą pisania.
Dialogue: 0,0:04:41.38,0:04:43.67,Default,Maomao,0,0,0,,{\i1}Szkoła dla służek.
Dialogue: 0,0:04:43.67,0:04:48.01,Default,Maomao,0,0,0,,{\i1}Wiedziałam, że coś knuje,\Nale działa szybciej, niż myślałam.
Dialogue: 0,0:04:49.31,0:04:50.35,Default,Maomao,0,0,0,,Świetny pomysł.
Dialogue: 0,0:04:52.18,0:04:53.98,Default,Jinshi,0,0,0,,A gdzie to twoje popisowe spojrzenie?!
Dialogue: 0,0:04:53.98,0:04:56.40,Default,Gaoshun,0,0,0,,Źle się czujesz?!
Dialogue: 0,0:04:56.40,0:04:58.19,Default,Maomao,0,0,0,,Co was tak zaskoczyło?
Dialogue: 0,0:04:58.69,0:05:01.44,Default,Jinshi,0,0,0,,To trochę niepokojące.
Dialogue: 0,0:05:05.24,0:05:06.24,Default,Maomao,0,0,0,,{\i1}Masochista.
Dialogue: 0,0:05:08.95,0:05:10.91,Default,Jinshi,0,0,0,,Co o tym myślisz?
Dialogue: 0,0:05:10.91,0:05:14.71,Default,Maomao,0,0,0,,Niektórzy już próbują się uczyć,\Nwięc myślę, że to dobry pomysł.
Dialogue: 0,0:05:15.46,0:05:18.67,Default,Maomao,0,0,0,,Dzięki temu łatwiej będzie znaleźć\Nnową pracę po zakończeniu kontraktu.
Dialogue: 0,0:05:18.67,0:05:19.46,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:05:20.13,0:05:21.17,Default,Maomao,0,0,0,,Ale...
Dialogue: 0,0:05:21.59,0:05:22.42,Default,Jinshi,0,0,0,,Wyduś to z siebie.
Dialogue: 0,0:05:23.13,0:05:27.43,Default,Maomao,0,0,0,,Południowy dziedziniec jest wygodnym\Npunktem dla dostaw towarów,
Dialogue: 0,0:05:27.43,0:05:28.80,Default,Maomao,0,0,0,,ale jest blisko głównej bramy.
Dialogue: 0,0:05:28.80,0:05:31.31,Default,Maomao,0,0,0,,To popularne miejsce spotkań\Nkonkubin wysokiej i średniej rangi.
Dialogue: 0,0:05:31.89,0:05:34.18,Default,Maomao,0,0,0,,Niektóre z nich są bardzo dumne.
Dialogue: 0,0:05:34.18,0:05:38.65,Default,Maomao,0,0,0,,Może im się nie spodobać\Nwizja edukowania służby.
Dialogue: 0,0:05:39.94,0:05:42.15,Default,Jinshi,0,0,0,,Może lepiej zbudować\Ngo po północnej stronie.
Dialogue: 0,0:05:42.48,0:05:45.74,Default,Maomao,0,0,0,,Tak. Ponoć północna strona\Nnie jest najlepiej zarządzana
Dialogue: 0,0:05:45.74,0:05:48.36,Default,Maomao,0,0,0,,i jest tam kilka opuszczonych budynków.
Dialogue: 0,0:05:48.78,0:05:51.12,Default,Maomao,0,0,0,,Wystarczy tam zrobić lekki remont.
Dialogue: 0,0:05:51.74,0:05:56.29,Default,Maomao,0,0,0,,Warto też nazwać to\Nkształceniem zawodowym.
Dialogue: 0,0:05:56.29,0:05:59.42,Default,Maomao,0,0,0,,Jeśli pokażesz, że jest to sposób\Nna zarobek, przyciągniesz więcej osób.
Dialogue: 0,0:06:00.42,0:06:01.75,Default,Jinshi,0,0,0,,Myślisz, że to zadziała?
Dialogue: 0,0:06:02.13,0:06:04.67,Default,Maomao,0,0,0,,Sporadyczne przekąski też nie zaszkodzą.
Dialogue: 0,0:06:04.67,0:06:05.71,Default,Jinshi,0,0,0,,Sporadyczne?
Dialogue: 0,0:06:05.71,0:06:09.26,Default,Maomao,0,0,0,,Tak. Od hazardu też się nie uzależnisz,\Njeśli cały czas wygrywasz.
Dialogue: 0,0:06:10.22,0:06:11.68,Default,Jinshi,0,0,0,,Czyżby?
Dialogue: 0,0:06:12.60,0:06:15.39,Default,Maomao,0,0,0,,{\i1}Ma głowę na karku,\Nale nie zastanawia się nad wszystkim.
Dialogue: 0,0:06:15.39,0:06:17.35,Default,Maomao,0,0,0,,{\i1}Pewnie przez swoje zamożne pochodzenie.
Dialogue: 0,0:06:17.35,0:06:20.19,Default,Maomao,0,0,0,,{\i1}Zgaduję, że pyta mnie,\Nbo jest tego świadomy.
Dialogue: 0,0:06:20.65,0:06:22.65,Default,Maomao,0,0,0,,Takie jest moje zdanie.
Dialogue: 0,0:06:23.82,0:06:25.57,Default,Maomao,0,0,0,,To wszystko?
Dialogue: 0,0:06:25.90,0:06:28.07,Default,Jinshi,0,0,0,,Jeszcze jedno.
Dialogue: 0,0:06:28.07,0:06:30.41,Default,Jinshi,0,0,0,,Znasz się na grzybach?
Dialogue: 0,0:06:31.41,0:06:36.16,Default,Maomao,0,0,0,,używa się ich przy gotowaniu\Ni w medycynie, więc poniekąd tak.
Dialogue: 0,0:06:36.50,0:06:39.54,Default,Jinshi,0,0,0,,O tej porze roku niektóre dwórki
Dialogue: 0,0:06:39.54,0:06:42.38,Default,Jinshi,0,0,0,,zbierają grzyby bez pozwolenia\Ni nabawiają się zatrucia pokarmowego.
Dialogue: 0,0:06:42.38,0:06:45.46,Default,Maomao,0,0,0,,Myślę, że żarłoków nigdzie nie brakuje.
Dialogue: 0,0:06:45.80,0:06:50.51,Default,Jinshi,0,0,0,,Istotnie. Kiedyś ktoś jadł gąskę\Nsosnową z doktorem w klinice.
Dialogue: 0,0:06:51.01,0:06:53.51,Default,Jinshi,0,0,0,,Ponoć owoce z sadu też często giną.
Dialogue: 0,0:06:54.05,0:06:56.14,Default,Maomao,0,0,0,,{\i1}Nie są to trujące grzyby.
Dialogue: 0,0:06:56.47,0:06:59.81,Default,Maomao,0,0,0,,{\i1}Ja tylko leciutko przerzedzałam sady.
Dialogue: 0,0:06:59.81,0:07:04.19,Default,Jinshi,0,0,0,,Dlatego chciałbym, byś znalazła\Ni pozbyła się tych, które nie są jadalne.
Dialogue: 0,0:07:04.19,0:07:07.57,Default,Jinshi,0,0,0,,Zwróć również uwagę na rodzaje\Ntrujących grzybów, które znajdziesz.
Dialogue: 0,0:07:08.28,0:07:09.78,Default,Jinshi,0,0,0,,Proszę, byś przerwała\Nswoje obowiązki
Dialogue: 0,0:07:09.78,0:07:12.45,Default,Jinshi,0,0,0,,w Jadeitowym Pałacu\Ni zajęła się testowaniem.
Dialogue: 0,0:07:12.91,0:07:13.53,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:07:14.24,0:07:19.04,Default,Maomao,0,0,0,,{\i1}To chyba trzeba\Nwytłumaczyć pani Gyokuyou.
Dialogue: 0,0:07:21.08,0:07:23.38,Default,Maomao,0,0,0,,{\i1}Co on się tak na mnie gapi?
Dialogue: 0,0:07:24.63,0:07:25.63,Default,Jinshi,0,0,0,,Liczę na ciebie.
Dialogue: 0,0:07:26.71,0:07:27.92,Default,Maomao,0,0,0,,Przyjęłam.
Dialogue: 0,0:07:28.67,0:07:31.30,Default,Maomao,0,0,0,,{\i1}Coś może być na rzeczy...
Dialogue: 0,0:07:31.30,0:07:32.72,Default,Maomao,0,0,0,,{\i1}ale chyba będzie fajnie.
Dialogue: 0,0:07:34.51,0:07:37.10,Default,Maomao,0,0,0,,{\i1}Gdzie mam się udać...?
Dialogue: 0,0:07:37.64,0:07:40.23,Default,Maomao,0,0,0,,{\i1}Ogrody, sady, sosny...
Dialogue: 0,0:07:40.60,0:07:43.60,Default,Maomao,0,0,0,,{\i1}Jest wiele miejsc,\Nw których mogą rosnąć grzyby.
Dialogue: 0,0:07:43.60,0:07:46.02,Default,Maomao,0,0,0,,{\i1}Sezon na grzyby trwa w najlepsze.
Dialogue: 0,0:07:46.82,0:07:48.69,Default,Maomao,0,0,0,,{\i1}Jeśli dwórki szukają ich w tajemnicy,
Dialogue: 0,0:07:48.69,0:07:53.61,Default,Maomao,0,0,0,,{\i1}to mogę pominąć zatłoczone\Nmiejsca i całą południową stronę.
Dialogue: 0,0:07:54.99,0:07:56.16,Default,Maomao,0,0,0,,{\i1}Koniec końców...
Dialogue: 0,0:07:56.49,0:07:58.16,Default,Maomao,0,0,0,,{\i1}Północna strona.
Dialogue: 0,0:08:10.13,0:08:11.97,Default,Maomao,0,0,0,,{\i1}Hmm? Co to za zapach?
Dialogue: 0,0:08:11.97,0:08:14.68,Default,Maomao,0,0,0,,{\i1}Trochę kłuje...
Dialogue: 0,0:08:16.80,0:08:19.85,Default,Maomao,0,0,0,,{\i1}To ten dziwny zapach,\No którym wspomniała Shisui?
Dialogue: 0,0:08:20.60,0:08:25.10,Default,Maomao,0,0,0,,{\i1}Może właśnie nieszczelne ścieki\Nsą pożywką dla grzybów.
Dialogue: 0,0:08:27.06,0:08:28.57,Default,Maomao,0,0,0,,Wróciłam.
Dialogue: 0,0:08:29.19,0:08:31.44,Default,Yinghua,0,0,0,,Dobrze cię widzie...
Dialogue: 0,0:08:33.53,0:08:35.70,Default,Yinghua,0,0,0,,Ani kroku dalej!\N Obrzydzasz mnie!
Dialogue: 0,0:08:35.70,0:08:36.53,Default,Maomao,0,0,0,,{\i1}Obrzydzam...
Dialogue: 0,0:08:36.53,0:08:40.16,Default,Yinghua,0,0,0,,Maomao, cuchniesz jak skunks!\NCoś ty robiła cały dzień?
Dialogue: 0,0:08:40.99,0:08:44.12,Default,Maomao,0,0,0,,To był bardzo udany dzień.
Dialogue: 0,0:08:44.75,0:08:47.63,Default,Maomao,0,0,0,,{\i1}Znalazłam trochę grzybów leczniczych.
Dialogue: 0,0:08:48.21,0:08:52.46,Default,Maomao,0,0,0,,{\i1}Powiedziałam, że wszystkie są trujące,\Nżeby nawet ten konował ich nie zjadł.
Comment: 0,0:08:48.71,0:08:53.30,Default,Guen,0,0,0,,{\an8}— Czy naprawdę są trujące?\NMoże gdybym spróbował, wiedziałbym...
Dialogue: 0,0:08:53.80,0:08:58.22,Default,Yinghua,0,0,0,,Prędko, przebierz się. \NZaraz będzie kolacja dla pani Gyokuyou.
Dialogue: 0,0:08:58.22,0:08:59.14,Default,Maomao,0,0,0,,Jasne.
Dialogue: 0,0:09:02.14,0:09:04.69,Default,Maomao,0,0,0,,Przepraszam za spóźnienie.
Dialogue: 0,0:09:07.10,0:09:08.90,Default,Hongniang,0,0,0,,Przepraszam za pośpiech.
Dialogue: 0,0:09:09.44,0:09:10.27,Default,Maomao,0,0,0,,W porządku.
Dialogue: 0,0:09:10.86,0:09:13.74,Default,Maomao,0,0,0,,{\i1}Czarna tasiemka na nadgarstkach...
Dialogue: 0,0:09:15.11,0:09:17.24,Default,Hongniang,0,0,0,,Wychodzę po kolacji.
Dialogue: 0,0:09:17.24,0:09:19.70,Default,Hongniang,0,0,0,,Chodź ze mną.
Dialogue: 0,0:09:19.70,0:09:20.66,Default,Maomao,0,0,0,,Oczywiście.
Dialogue: 0,0:09:21.74,0:09:26.16,Default,Maomao,0,0,0,,{\i1}A więc ktoś wysoko postawiony\Nzmarł w wewnętrznym pałacu...
Dialogue: 0,0:09:29.67,0:09:32.30,Default,Hongniang,0,0,0,,To konkubina Jin,
Dialogue: 0,0:09:32.30,0:09:36.76,Default,Hongniang,0,0,0,,konkubina średniej rangi\Ni córka wysoko postawionego urzędnika.
Dialogue: 0,0:09:37.34,0:09:41.68,Default,Hongniang,0,0,0,,Od roku chorowała i cały czas\Nprzebywała w swoim pokoju.
Dialogue: 0,0:09:41.68,0:09:44.60,Default,Hongniang,0,0,0,,Podobno zatruła się jedzeniem\Ni nie doszła już do siebie.
Dialogue: 0,0:09:45.60,0:09:50.98,Default,Hongniang,0,0,0,,Cesarz przecież jej nie odwiedzał.\NPowinna była wrócić do domu.
Dialogue: 0,0:09:52.48,0:09:56.49,Default,Maomao,0,0,0,,Rzadko mówisz o kimś w ten sposób.
Dialogue: 0,0:10:00.45,0:10:05.33,Default,Hongniang,0,0,0,,Konkubina Jin była trochę... trudną osobą.
Dialogue: 0,0:10:05.33,0:10:08.17,Default,Hongniang,0,0,0,,Była bardzo zazdrosna o inne kobiety.
Dialogue: 0,0:10:08.75,0:10:12.54,Default,Hongniang,0,0,0,,Raniła ich słowami, a czasem\Nnawet biła, jeśli były niższej rangi.
Dialogue: 0,0:10:12.96,0:10:18.68,Default,Hongniang,0,0,0,,To właśnie wtedy pani Gyokuyou została\Notruta, kiedy była w ciąży z księżniczką.
Dialogue: 0,0:10:21.18,0:10:26.14,Default,Hongniang,0,0,0,,Rzecz jasna, nie zaatakowała jawnie\Nwysoko postawionych konkubin.
Dialogue: 0,0:10:26.56,0:10:33.14,Default,Hongniang,0,0,0,,Niemniej ze względu na jej charakter\Npan Jinshi musiał pójść i zapytać.
Dialogue: 0,0:10:33.65,0:10:34.43,Default,Hongniang,0,0,0,,Jednakże...
Dialogue: 0,0:10:36.40,0:10:39.24,Default,Jin,0,0,0,,{\i0}Masz jakieś dowody?
Dialogue: 0,0:10:40.78,0:10:44.20,Default,Hongniang,0,0,0,,Tak więc pozostało to tylko podejrzeniem.
Dialogue: 0,0:10:44.20,0:10:46.33,Default,Hongniang,0,0,0,,Było wiele nerwowych sytuacji
Dialogue: 0,0:10:46.33,0:10:50.96,Default,Hongniang,0,0,0,,i nawet jej służki\Nprzeżywały ciężkie chwile.
Dialogue: 0,0:10:50.96,0:10:54.80,Default,Hongniang,0,0,0,,Prawdę mówiąc,\Ntrochę mi ulżyło, że tak się stało.
Dialogue: 0,0:10:54.80,0:10:57.21,Default,Hongniang,0,0,0,,Gdyby znowu coś się stało pani Gyokuyou...
Dialogue: 0,0:11:00.18,0:11:03.89,Default,Maomao,0,0,0,,{\i1}Chyba to całkiem szczera\Nopinia pani Hongniang.
Dialogue: 0,0:11:03.89,0:11:04.43,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:11:04.93,0:11:07.68,Default,Hongniang,0,0,0,,{\i0}Cesarz przecież jej nie odwiedzał.\NPowinna była wrócić do domu.
Dialogue: 0,0:11:08.06,0:11:11.10,Default,Jinshi,0,0,0,,{\i0}Zwróć również uwagę na rodzaje\Ntrujących grzybów, które znajdziesz.
Dialogue: 0,0:11:11.98,0:11:16.07,Default,Maomao,0,0,0,,{\i1}Po co pan Jinshi poprosił\Nmnie o zbadanie grzybów?
Dialogue: 0,0:11:16.82,0:11:21.24,Default,Maomao,0,0,0,,{\i1}Czemu unikał rozmowy na ten temat\Nw Jadeitowym Pałacu przy pani Gyokuyou?
Dialogue: 0,0:11:21.74,0:11:26.08,Default,Maomao,0,0,0,,{\i1}Może ma jakieś podejrzenia\Nwobec personelu Jadeitowego Pałacu?
Dialogue: 0,0:11:26.83,0:11:29.83,Default,Maomao,0,0,0,,{\i1}Ktoś od nas zabił konkubinę\NJin trującym grzybem.
Dialogue: 0,0:11:30.58,0:11:34.04,Default,Maomao,0,0,0,,{\i1}Myślałam, że jest zdecydowanie\Nza panią Gyokuyou,
Dialogue: 0,0:11:34.04,0:11:36.59,Default,Maomao,0,0,0,,{\i1}ale w gruncie rzeczy wszystkich\Ntraktuje chyba sprawiedliwie.
Dialogue: 0,0:11:37.30,0:11:42.59,Default,Maomao,0,0,0,,{\i1}Zgaduję, że gdyby jego podejście\Nbyłoby inne, odbiłoby się to na zaufaniu.
Dialogue: 0,0:11:43.39,0:11:47.18,Default,Maomao,0,0,0,,{\i1}Tak czy siak,\Npani Gyokuyou nie jest sprawcą.
Dialogue: 0,0:11:47.18,0:11:49.43,Default,Maomao,0,0,0,,{\i1}Otrucie to zbyt poważne ryzyko,
Dialogue: 0,0:11:49.43,0:11:53.06,Default,Maomao,0,0,0,,{\i1}a są lepsze sposoby na pozbycie\Nsię konkubiny średniej rangi.
Dialogue: 0,0:11:53.06,0:11:56.73,Default,Maomao,0,0,0,,{\i1}Pozostałe służki nie byłyby\Nzdolne do takich podstępów.
Dialogue: 0,0:11:56.73,0:11:59.15,Default,Maomao,0,0,0,,{\i1}Więc głównym podejrzanym...
Dialogue: 0,0:12:00.24,0:12:01.11,Default,Maomao,0,0,0,,Jestem ja.
Dialogue: 0,0:12:01.95,0:12:06.95,Default,Maomao,0,0,0,,{\i1}Jeśli zadanie z grzybami było\Ntylko próbą, by mnie sprawdzić,
Dialogue: 0,0:12:06.95,0:12:09.62,Default,Maomao,0,0,0,,{\i1}to jestem pod wrażeniem.\NZero rozczarowania.
Dialogue: 0,0:12:10.41,0:12:11.46,Default,Jin's Lady-in-waiting 1,0,0,0,,Proszę.
Dialogue: 0,0:12:13.17,0:12:16.38,Default,Maomao,0,0,0,,{\i1}Momento. Czy to służka konkubiny Jin?
Dialogue: 0,0:12:16.84,0:12:18.21,Default,Maomao,0,0,0,,{\i1}Czyżby dostała od czegoś wysypki?
Dialogue: 0,0:12:18.80,0:12:19.34,Default,Jin's Lady-in-waiting 1,0,0,0,,Proszę.
Dialogue: 0,0:12:19.34,0:12:21.17,Default,Maomao,0,0,0,,{\i1}Ale ten stan zapalny...
Dialogue: 0,0:12:26.85,0:12:31.31,Default,Maomao,0,0,0,,{\i1}Gdybym jeszcze wiedziała,\Njakie miała objawy przed śmiercią...
Dialogue: 0,0:12:43.32,0:12:46.03,Default,Jin's Lady-in-waiting 1,0,0,0,,Konkubino Son! Proszę, przestań!
Dialogue: 0,0:13:01.55,0:13:03.59,Default,Son,0,0,0,,Masz to, na co zasłużyłaś!
Dialogue: 0,0:13:05.72,0:13:07.43,Default,Maomao,0,0,0,,{\i1}Stan zapalny na twarzy...
Dialogue: 0,0:13:07.73,0:13:09.76,Default,Jinshi,0,0,0,,{\i0}Znasz się na grzybach?
Dialogue: 0,0:13:09.76,0:13:11.68,Default,Hongniang,0,0,0,,{\i0}Było wiele nerwowych sytuacji
Dialogue: 0,0:13:11.68,0:13:13.31,Default,Hongniang,0,0,0,,{\i0}i nawet jej służki\Nprzeżywały ciężkie chwile.
Dialogue: 0,0:13:15.14,0:13:17.10,Default,Maomao,0,0,0,,{\i1}Teraz już rozumiem.
Dialogue: 0,0:13:18.56,0:13:21.32,Default,Maomao,0,0,0,,{\i1}Tego właśnie szukał pan Jinshi.
Dialogue: 0,0:13:25.90,0:13:27.95,Default,Maomao,0,0,0,,{\i1}Kobieta, która wczoraj urządziła dramę,
Dialogue: 0,0:13:27.95,0:13:30.91,Default,Maomao,0,0,0,,{\i1}to konkubina niskiej\Nrangi imieniem Son.
Dialogue: 0,0:13:30.91,0:13:33.91,Default,Maomao,0,0,0,,{\i1}Pochodziła z bogatej rodziny kupieckiej\Ni miała niesamowity charakter.
Dialogue: 0,0:13:33.91,0:13:36.79,Default,Maomao,0,0,0,,{\i1}Nawet cesarz odwiedzał ją\Nod czasu do czasu.
Dialogue: 0,0:13:37.21,0:13:40.21,Default,Maomao,0,0,0,,{\i1}Jednak niecałe dwa lata temu...
Dialogue: 0,0:13:42.17,0:13:45.09,Default,Son,0,0,0,,{\i0}Dlaczego... Dlaczego do tego doszło?!
Dialogue: 0,0:13:45.92,0:13:47.68,Default,Maomao,0,0,0,,{\i1}Zachorowała na nieznaną chorobę
Dialogue: 0,0:13:47.68,0:13:50.14,Default,Maomao,0,0,0,,{\i1}i pojawiły się plotki,\Nby usunąć ją jako konkubinę.
Dialogue: 0,0:13:50.55,0:13:54.64,Default,Maomao,0,0,0,,{\i1}Jednakże gdyby wróciła do domu,\Nnie mogłaby wyjść za mąż.
Dialogue: 0,0:13:55.18,0:13:57.06,Default,Maomao,0,0,0,,{\i1}Pozwolono jej pozostać\Nw wewnętrznym pałacu,
Dialogue: 0,0:13:57.06,0:13:58.65,Default,Maomao,0,0,0,,{\i1}zapewne ze względu\Nna wyrozumiałość cesarza.
Dialogue: 0,0:14:00.65,0:14:05.65,Default,Maomao,0,0,0,,{\i1}Zatem dlaczego tak się zachowywała\Nna pogrzebie konkubiny Jin?
Dialogue: 0,0:14:06.07,0:14:11.41,Default,Maomao,0,0,0,,{\i1}Bułka z masłem. Wierzyła, że winę\Nza jej chorobę ponosi konkubina Jin.
Dialogue: 0,0:14:15.37,0:14:16.41,Default,Maomao,0,0,0,,{\i1}Mam cię.
Dialogue: 0,0:14:20.83,0:14:22.46,Default,Maomao,0,0,0,,Panie Jinshi, załóż to.
Dialogue: 0,0:14:23.13,0:14:25.01,Default,Jinshi,0,0,0,,Dość poważnie.
Dialogue: 0,0:14:25.01,0:14:26.97,Default,Maomao,0,0,0,,Tak, jest bardzo trujący.
Dialogue: 0,0:14:39.60,0:14:41.69,Default,Jinshi,0,0,0,,Gdzie to znalazłaś?
Dialogue: 0,0:14:42.06,0:14:44.11,Default,Maomao,0,0,0,,W lesie na północnej stronie.
Dialogue: 0,0:14:44.11,0:14:46.78,Default,Maomao,0,0,0,,Teren nie był zadbany,
Dialogue: 0,0:14:46.78,0:14:49.70,Default,Maomao,0,0,0,,co stworzyło najlepsze\Nwarunki dla tego grzyba.
Dialogue: 0,0:14:49.70,0:14:54.99,Default,Maomao,0,0,0,,To rzadki i niezwykle niebezpieczny okaz.
Dialogue: 0,0:14:54.99,0:15:00.21,Default,Maomao,0,0,0,,Zjedzenie choćby kawałka jest śmiertelne\Ni może wyrządzić krzywdę samym dotykiem.
Dialogue: 0,0:15:00.21,0:15:02.54,Default,Maomao,0,0,0,,Proszę, nie zbliżaj się.
Dialogue: 0,0:15:02.54,0:15:05.17,Default,Maomao,0,0,0,,Bo skończysz tak,\Njak konkubiny Jin i Son.
Dialogue: 0,0:15:08.76,0:15:11.76,Default,Maomao,0,0,0,,Już kiedyś widziałam tego grzyba,
Dialogue: 0,0:15:11.76,0:15:13.72,Default,Maomao,0,0,0,,kiedy zbierałam zioła z tatkiem.
Dialogue: 0,0:15:13.72,0:15:14.93,Default,Jinshi,0,0,0,,Dotknęłaś go?
Dialogue: 0,0:15:14.93,0:15:18.52,Default,Maomao,0,0,0,,Tak. Od razu umyłam\Nręce, ale tu masz efekt.
Dialogue: 0,0:15:19.52,0:15:22.77,Default,Jinshi,0,0,0,,Pod tymi bandażami jest więcej blizn?
Dialogue: 0,0:15:22.77,0:15:26.40,Default,Maomao,0,0,0,,Nie, reszta to wynik eksperymentów,\Nktóre robiłam na sobie.
Dialogue: 0,0:15:26.40,0:15:28.07,Default,Jinshi,0,0,0,,Chwila, jakie eksperymenty?
Dialogue: 0,0:15:28.07,0:15:28.78,Default,Maomao,0,0,0,,Mój bakcyl.
Dialogue: 0,0:15:28.78,0:15:30.40,Default,Jinshi,0,0,0,,Jaki bakcyl, do cholery?!
Dialogue: 0,0:15:30.90,0:15:33.41,Default,Maomao,0,0,0,,{\i1}Chyba nigdy mu o tym nie wspominałam.
Dialogue: 0,0:15:33.41,0:15:35.74,Default,Maomao,0,0,0,,Nie ma to teraz większego znaczenia.
Dialogue: 0,0:15:35.74,0:15:37.04,Default,Jinshi,0,0,0,,Naprawdę?
Dialogue: 0,0:15:38.20,0:15:43.17,Default,Maomao,0,0,0,,Konkubina Jin straciła sporo włosów,\Na jej ciało pokrywała wysypka.
Dialogue: 0,0:15:43.75,0:15:47.63,Default,Maomao,0,0,0,,Panie Jinshi, szukałeś źródła tej trucizny?
Dialogue: 0,0:15:48.34,0:15:50.26,Default,Gaoshun,0,0,0,,{\i1}Bystra jak zawsze.
Dialogue: 0,0:15:53.05,0:15:56.76,Default,Jinshi,0,0,0,,Dwa lata temu konkubina Son\Nzachorowała na nieznaną chorobę,
Dialogue: 0,0:15:56.76,0:15:59.02,Default,Jinshi,0,0,0,,a za jej przyczynę\Npodejrzewano truciznę.
Dialogue: 0,0:15:59.47,0:16:01.56,Default,Jinshi,0,0,0,,Mówi się, że winowajcą była...
Dialogue: 0,0:16:02.31,0:16:03.35,Default,Maomao,0,0,0,,Konkubina Jin.
Dialogue: 0,0:16:03.69,0:16:09.69,Default,Jinshi,0,0,0,,Tak, ale finalnie nie udało\Nnam się tego potwierdzić.
Dialogue: 0,0:16:09.69,0:16:15.12,Default,Jinshi,0,0,0,,Rok temu te podobne objawy\Npojawiły się również u konkubiny Jin.
Dialogue: 0,0:16:15.62,0:16:19.37,Default,Jinshi,0,0,0,,Prawdopodobnie chciała użyć tej samej\Ntrucizny na kimś i przypadkowo jej dotknęła.
Dialogue: 0,0:16:20.04,0:16:21.96,Default,Jinshi,0,0,0,,Od tego czasu konkubina Jin\Nwpadła w depresję
Dialogue: 0,0:16:21.96,0:16:23.83,Default,Jinshi,0,0,0,,i stała się zupełnie inną osobą.
Dialogue: 0,0:16:25.00,0:16:30.09,Default,Jinshi,0,0,0,,Odwiedzałem ją przynajmniej raz\Nw miesiącu, lecz ona ledwo mówiła.
Dialogue: 0,0:16:30.96,0:16:33.26,Default,Jinshi,0,0,0,,Była bardzo dumną kobietą.
Dialogue: 0,0:16:33.80,0:16:36.26,Default,Jinshi,0,0,0,,Nie była w stanie tego znieść,\Nzażyła truciznę i popełniła samobójstwo.
Dialogue: 0,0:16:36.68,0:16:40.06,Default,Jinshi,0,0,0,,Tak przynajmniej twierdzą jej służki.
Dialogue: 0,0:16:40.77,0:16:44.23,Default,Maomao,0,0,0,,{\i1}Ta historia ma nawet sens, ale...
Dialogue: 0,0:16:45.10,0:16:48.23,Default,Maomao,0,0,0,,Konkubina Jin zmarła po zjedzeniu\Ntrującego grzyba, prawda?
Dialogue: 0,0:16:48.61,0:16:49.52,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:16:49.52,0:16:51.48,Default,Maomao,0,0,0,,To nie ma sensu.
Dialogue: 0,0:16:52.03,0:16:53.45,Default,Jinshi,0,0,0,,Co masz na myśli?
Dialogue: 0,0:16:54.36,0:16:59.28,Default,Maomao,0,0,0,,Spożycie tego grzyba wywołuje\Nbóle brzucha, wymioty i paraliż.
Dialogue: 0,0:16:59.62,0:17:02.20,Default,Maomao,0,0,0,,Spowodowałoby to stan\Nzapalny w jamie ustnej,
Dialogue: 0,0:17:02.20,0:17:04.87,Default,Maomao,0,0,0,,ale nigdy nie słyszałam,\Nby przeniosło się to na resztę twarzy.
Dialogue: 0,0:17:05.33,0:17:06.12,Default,Jinshi,0,0,0,,Naprawdę?
Dialogue: 0,0:17:06.58,0:17:11.71,Default,Maomao,0,0,0,,Tak. Infekcja na jej twarzy\Npojawiła się niedawno.
Dialogue: 0,0:17:11.71,0:17:15.30,Default,Maomao,0,0,0,,Jak gdyby ktoś wysmarował\Njej twarz trującym grzybem.
Dialogue: 0,0:17:15.30,0:17:18.26,Default,Maomao,0,0,0,,{\i1}Z kolei jej ręce były całkiem zdrowe.
Dialogue: 0,0:17:18.26,0:17:19.60,Default,Maomao,0,0,0,,{\i1}Stan zapalny powstał...
Dialogue: 0,0:17:24.52,0:17:26.44,Default,Jinshi,0,0,0,,Mów do końca, a nie przerywasz.
Dialogue: 0,0:17:32.15,0:17:33.78,Default,Maomao,0,0,0,,Dasz mi kilka dni?
Dialogue: 0,0:17:34.40,0:17:38.87,Default,Maomao,0,0,0,,Potrzebowałabym też kilku pracowitych\Neunuchów, potrafiących trzymać język za zębami.
Dialogue: 0,0:17:40.87,0:17:42.54,Default,Maomao,0,0,0,,Nie mam pewności.
Dialogue: 0,0:17:43.12,0:17:44.12,Default,Jinshi,0,0,0,,I tak to zrób.
Dialogue: 0,0:17:45.83,0:17:49.13,Default,Maomao,0,0,0,,{\i1}Skoro to rozkaz, będzie łatwiej.
Dialogue: 0,0:17:50.21,0:17:51.71,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:17:54.51,0:17:59.05,Default,Gaoshun,0,0,0,,Ciekawi mnie, czego\NXiaomao chce się dowiedzieć.
Dialogue: 0,0:17:59.05,0:18:01.30,Default,Jinshi,0,0,0,,Nie wiem, ale...
Dialogue: 0,0:18:01.76,0:18:05.85,Default,Jinshi,0,0,0,,W tym stanie nasza Zielareczka\Nszuka ostatecznego dowodu.
Dialogue: 0,0:18:26.25,0:18:27.41,Default,Maomao,0,0,0,,Jesteśmy.
Dialogue: 0,0:18:29.58,0:18:30.58,Default,Gaoshun,0,0,0,,Grzyby...
Dialogue: 0,0:18:31.42,0:18:33.75,Default,Maomao,0,0,0,,Możecie tu kopać?
Dialogue: 0,0:18:33.75,0:18:34.59,Default,Gaoshun,0,0,0,,Oczywiście.
Dialogue: 0,0:18:46.72,0:18:47.93,Default,Gaoshun,0,0,0,,Ten zapach...
Dialogue: 0,0:19:00.61,0:19:02.78,Default,Gaoshun,0,0,0,,Więc to jest twój dowód.
Dialogue: 0,0:19:03.53,0:19:06.95,Default,Maomao,0,0,0,,Choć nie sądziłam, że znajdę\Ngo za pierwszym razem.
Dialogue: 0,0:19:09.04,0:19:12.58,Default,Jinshi,0,0,0,,Potwierdzono, że to rzeczywiście\Nbyła konkubina Jin.
Dialogue: 0,0:19:12.58,0:19:14.79,Default,Jinshi,0,0,0,,Na akcesoriach, które nosiła,\Nwidniały jej emblematy.
Dialogue: 0,0:19:15.25,0:19:17.96,Default,Maomao,0,0,0,,Nie wiem, czy to było\Nmorderstwo, czy wypadek,
Dialogue: 0,0:19:17.96,0:19:20.18,Default,Maomao,0,0,0,,ale musiała zginąć rok temu.
Dialogue: 0,0:19:20.72,0:19:22.97,Default,Jinshi,0,0,0,,Wtedy, gdy zachorowała?
Dialogue: 0,0:19:22.97,0:19:25.64,Default,Maomao,0,0,0,,Tak. Prawdziwa konkubina Jin\Nzostała pochowana w lesie,
Dialogue: 0,0:19:26.06,0:19:28.60,Default,Maomao,0,0,0,,a jej miejsce zajęła oszustka.
Dialogue: 0,0:19:28.98,0:19:31.14,Default,Gaoshun,0,0,0,,Zatem ciało na pogrzebie było...
Dialogue: 0,0:19:32.52,0:19:34.77,Default,Maomao,0,0,0,,Słyszałeś o zaginionej służce?
Dialogue: 0,0:19:35.52,0:19:39.61,Default,Maomao,0,0,0,,Kobiecie imieniem Tao,\Nktóra zaginęła przed ślubem?
Dialogue: 0,0:19:40.53,0:19:42.78,Default,Maomao,0,0,0,,Nie uważasz, że wygląda\Njak konkubina Jin?
Dialogue: 0,0:19:43.91,0:19:47.29,Default,Maomao,0,0,0,,Wypytałam ludzi i okazało się,\N że były do siebie podobne.
Dialogue: 0,0:19:47.87,0:19:51.08,Default,Maomao,0,0,0,,Dzięki zakrywaniu twarzy nikt\Nnie byłby w stanie tego zauważyć,
Dialogue: 0,0:19:51.08,0:19:52.79,Default,Maomao,0,0,0,,z wyjątkiem jej najbliższych służek.
Dialogue: 0,0:19:53.21,0:19:56.92,Default,Maomao,0,0,0,,Oszukanie comiesięcznego\Ngościa nie było trudne.
Dialogue: 0,0:19:57.38,0:20:02.68,Default,Jinshi,0,0,0,,Czyli ta kobieta Tao spiskowała\Nze służącymi konkubiny Jin?
Dialogue: 0,0:20:03.05,0:20:06.39,Default,Maomao,0,0,0,,Możliwe, ale nie mam\Nżadnych dowodów.
Dialogue: 0,0:20:09.85,0:20:11.77,Default,Maomao,0,0,0,,{\i1}Rzecz jasna mam swoje przypuszczenia.
Dialogue: 0,0:20:12.39,0:20:14.02,Default,Maomao,0,0,0,,{\i1}Wszystko to było spowodowane zazdrością.
Dialogue: 0,0:20:14.31,0:20:16.44,Default,Maomao,0,0,0,,{\i1}Konkubinie Jin zapewne\Nnie spodobało się to,
Dialogue: 0,0:20:16.44,0:20:19.19,Default,Maomao,0,0,0,,{\i1}że służka, podobna do niej,\Nznalazła miłość.
Dialogue: 0,0:20:20.40,0:20:24.03,Default,Maomao,0,0,0,,{\i1}Gdzie w swoim przypadku nie mogła\Nliczyć nawet na wizytę cesarza.
Dialogue: 0,0:20:24.49,0:20:27.83,Default,Maomao,0,0,0,,{\i1}Tao była regularnie maltretowana.
Dialogue: 0,0:20:27.83,0:20:30.29,Default,Maomao,0,0,0,,{\i1}Być może doszło do kłótni.
Dialogue: 0,0:20:30.29,0:20:33.04,Default,Maomao,0,0,0,,{\i1}Wypadek... lub coś, co doprowadziło\N do śmierci konkubiny Jin.
Dialogue: 0,0:20:33.62,0:20:36.83,Default,Maomao,0,0,0,,{\i1}Służki prawdopodobnie w trosce\No siebie i ze współczucia dla Tao
Dialogue: 0,0:20:36.83,0:20:39.46,Default,Maomao,0,0,0,,{\i1}zasugerowały, by zatuszować\Nśmierć konkubiny Jin.
Dialogue: 0,0:20:39.80,0:20:42.30,Default,Maomao,0,0,0,,{\i1}Tao nie mogła odmówić.
Dialogue: 0,0:20:43.84,0:20:46.14,Default,Maomao,0,0,0,,{\i1}Gdy rozmowy na temat jej małżeństwa\Nstawały się coraz poważniejsze,
Dialogue: 0,0:20:46.14,0:20:49.26,Default,Maomao,0,0,0,,{\i1}udawanie stało się dużo trudniejsze.
Dialogue: 0,0:20:52.64,0:20:57.36,Default,Maomao,0,0,0,,{\i1}Wystarczy. Niech wyżsi urzędnicy\Nwymyślają sobie własne motywy.
Dialogue: 0,0:20:57.94,0:21:01.82,Default,Jinshi,0,0,0,,Skąd się dowiedziałaś,\Ngdzie zakopano ciało?
Dialogue: 0,0:21:01.82,0:21:04.24,Default,Maomao,0,0,0,,Zostawiono za sobą dowody.
Dialogue: 0,0:21:04.24,0:21:05.32,Default,Jinshi,0,0,0,,Dowody?
Dialogue: 0,0:21:07.32,0:21:08.32,Default,Maomao,0,0,0,,Grzybki!
Dialogue: 0,0:21:08.74,0:21:10.41,Default,Maomao,0,0,0,,Wszystkie grzyby w okolicy to te,
Dialogue: 0,0:21:10.41,0:21:13.58,Default,Maomao,0,0,0,,które uwielbiają rosnąć\Nna padlinie i gównie!
Dialogue: 0,0:21:13.58,0:21:16.42,Default,Maomao,0,0,0,,Dlatego nic dziwnego, że unosił się\Ntam specyficzny zapach zgnilizny!
Dialogue: 0,0:21:16.42,0:21:20.55,Default,Maomao,0,0,0,,I pomyśleć, że spodobało mi się\Nszukanie grzybków wśród zwłok!
Dialogue: 0,0:21:23.09,0:21:25.30,Default,Jinshi,0,0,0,,Co zamierzasz zrobić z grzybami?
Dialogue: 0,0:21:28.30,0:21:30.85,Default,Maomao,0,0,0,,To są naprawdę mega\Nfascynujące grzybki.
Dialogue: 0,0:21:30.85,0:21:32.64,Default,Jinshi,0,0,0,,Grzyby rosnące na trupach?
Dialogue: 0,0:21:32.64,0:21:36.06,Default,Maomao,0,0,0,,Cóż, nie rosną bezpośrednio na\Nzwłokach, jak kordyceps chiński...
Dialogue: 0,0:21:37.56,0:21:40.65,Default,Maomao,0,0,0,,Gdyby tak było, nazywano\Nby je trupimi grzybami.
Dialogue: 0,0:21:40.65,0:21:41.73,Default,Jinshi,0,0,0,,Zabieram je!
Dialogue: 0,0:21:49.20,0:21:51.74,Default,Maomao,0,0,0,,{\i1}To tylko niewinna ciekawość...
Dialogue: 0,0:21:59.58,0:22:02.59,Default,Maomao,0,0,0,,{\i1}Grzyby rosnące na zwłokach...
Dialogue: 0,0:22:05.13,0:22:06.67,Default,Maomao,0,0,0,,{\i1}Gdyby coś takiego istniało,
Dialogue: 0,0:22:07.88,0:22:09.47,Default,Maomao,0,0,0,,{\i1}jak by to wyglądało
Dialogue: 0,0:22:10.22,0:22:12.64,Default,Maomao,0,0,0,,{\i1}i jakie miałoby skutki?
Dialogue: 0,0:23:45.07,0:23:48.00,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.35,0:24:00.00,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Lustra”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
