Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.48,0:01:33.53,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:37.49,0:01:45.80,Default,Fengxian,0,0,0,,{\i1}Ach, śpij kochanie... śpij...
Dialogue: 0,0:01:45.80,0:01:54.91,Default,Fengxian,0,0,0,,{\i1}Jeśli gwiazdkę\Nz nieba chcesz, dostaniesz...  {Dałam teskt kołysanki, w kolejnym odcinku będzie śpieać dziecku}
Dialogue: 0,0:01:57.68,0:02:01.64,Default,Text,0,0,0,,{\an8}ODCINEK 23: NIECIERPEK I SZCZAWIK
Dialogue: 0,0:02:06.22,0:02:07.94,Default,Maomao,0,0,0,,Chcesz zagrać\Nze mną parę partyjek?
Dialogue: 0,0:02:10.45,0:02:16.57,Default,Lakan,0,0,0,,Jak mógłbym odrzucić\Nprośbę mojej ślicznej córeczki?
Dialogue: 0,0:02:17.71,0:02:20.45,Default,Maomao,0,0,0,,Rozegrajmy pięć rund\Nbez zawiłych zasad.
Dialogue: 0,0:02:20.45,0:02:23.88,Default,Maomao,0,0,0,,Krótko mówiąc, wygrywa ten,\Nkto jako pierwszy wygra trzy rundy.
Dialogue: 0,0:02:24.20,0:02:28.60,Default,Lakan,0,0,0,,Dać ci jakieś fory?\NMoże odrzucę wieżę lub skoczka?
Dialogue: 0,0:02:28.60,0:02:29.96,Default,Maomao,0,0,0,,Nie ma takiej potrzeby.
Dialogue: 0,0:02:30.44,0:02:32.59,Default,Jinshi,0,0,0,,Mogła przyjąć jego propozycję.
Dialogue: 0,0:02:32.85,0:02:36.00,Default,Maomao,0,0,0,,Co więcej, możemy się o coś założyć.
Dialogue: 0,0:02:36.00,0:02:37.97,Default,Lakan,0,0,0,,Świetnie. Nie ma co tracić czasu!
Dialogue: 0,0:02:38.99,0:02:42.60,Default,Lakan,0,0,0,,Jeśli wygram,\Nzamieszkasz ze mną, dobrze?
Dialogue: 0,0:02:45.33,0:02:47.58,Default,Gaoshun,0,0,0,,Obiecałeś nie ingerować.
Dialogue: 0,0:02:47.58,0:02:48.66,Default,Jinshi,0,0,0,,Ale...
Dialogue: 0,0:02:51.61,0:02:52.88,Default,Maomao,0,0,0,,Niech będzie.
Dialogue: 0,0:02:52.88,0:02:55.34,Default,Maomao,0,0,0,,Jednakże obecnie jestem na służbie.
Dialogue: 0,0:02:55.34,0:02:57.19,Default,Maomao,0,0,0,,Musi pan poczekać, aż umowa wygaśnie.
Dialogue: 0,0:02:57.19,0:03:01.32,Default,Lakan,0,0,0,,Na służbie? Ale tak poważnie?
Dialogue: 0,0:03:01.32,0:03:02.16,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:03:02.16,0:03:05.68,Default,Lakan,0,0,0,,Aha...
Dialogue: 0,0:03:06.16,0:03:08.91,Default,Maomao,0,0,0,,Natomiast, jeśli ja wygram,
Dialogue: 0,0:03:09.58,0:03:13.42,Default,Maomao,0,0,0,,chcę, by wykupił pan kurtyzanę\Nz Grynszpanowego Pawilonu, dobrze?
Dialogue: 0,0:03:15.29,0:03:17.63,Default,Lakan,0,0,0,,Ze wszystkiego,\No co można się założyć...
Dialogue: 0,0:03:17.95,0:03:23.30,Default,Maomao,0,0,0,,Rajfurka chce niedługo pozbyć\Nsię pewnej starej kurtyzany.
Dialogue: 0,0:03:23.73,0:03:25.95,Default,Lakan,0,0,0,,Naprawdę?
Dialogue: 0,0:03:26.93,0:03:31.37,Default,Lakan,0,0,0,,Myślę, że mogę się na to zgodzić.
Dialogue: 0,0:03:31.37,0:03:33.58,Default,Lakan,0,0,0,,Czy to już wszystko?
Dialogue: 0,0:03:33.58,0:03:35.94,Default,Maomao,0,0,0,,Chcę wprowadzić\Njeszcze dwie zasady.
Dialogue: 0,0:03:42.17,0:03:45.07,Default,Jinshi,0,0,0,,Po zapachu wnioskuję,\Nże to chyba alkohol?
Dialogue: 0,0:03:51.17,0:03:53.33,Default,Jinshi,0,0,0,,Coś mi tu nie gra.
Dialogue: 0,0:03:53.58,0:03:55.29,Default,Lakan,0,0,0,,Co to jest?
Dialogue: 0,0:03:55.80,0:03:57.81,Default,Maomao,0,0,0,,W niewielkich ilościach lek.
Dialogue: 0,0:03:57.81,0:04:00.84,Default,Maomao,0,0,0,,Jednak po trzech łykach\Nstaje się śmiertelną trucizną.
Dialogue: 0,0:04:01.49,0:04:04.83,Default,Maomao,0,0,0,,Dodam go do trzech z pięciu czarek.
Dialogue: 0,0:04:05.81,0:04:08.64,Default,Maomao,0,0,0,,Pomieszam czarki, żeby nie było wiadomo,\Nktóra jest która.
Dialogue: 0,0:04:09.03,0:04:15.51,Default,Maomao,0,0,0,,Po każdej grze wygrany wybiera czarkę,\Na przegrany pije na hejnał.
Dialogue: 0,0:04:15.51,0:04:17.52,Default,Maomao,0,0,0,,To najważniejsza zasada.
Dialogue: 0,0:04:17.87,0:04:20.23,Default,Jinshi,0,0,0,,Co ona kombinuje...
Dialogue: 0,0:04:20.66,0:04:24.45,Default,Maomao,0,0,0,,Kolejna zasada mówi,\Nże bez względu na powód,
Dialogue: 0,0:04:24.45,0:04:28.41,Default,Maomao,0,0,0,,Jeśli gracz zrezygnuje\Nz udziału, przegrywa.
Dialogue: 0,0:04:29.32,0:04:30.53,Default,Maomao,0,0,0,,Zgadzasz się?
Dialogue: 0,0:04:35.42,0:04:36.88,Default,Lakan,0,0,0,,Oczywiście.
Dialogue: 0,0:04:37.18,0:04:38.77,Default,Jinshi,0,0,0,,Chce go wytrącić z równowagi?
Dialogue: 0,0:04:39.40,0:04:42.42,Default,Jinshi,0,0,0,,Przeciętny gracz może by i to kupił.
Dialogue: 0,0:04:42.42,0:04:43.13,Default,Jinshi,0,0,0,,Ale...
Dialogue: 0,0:04:44.14,0:04:47.25,Default,Jinshi,0,0,0,,Mowa tu o cwanym lisie,\Na zarazem świetnym strategu.
Dialogue: 0,0:04:47.25,0:04:50.64,Default,Jinshi,0,0,0,,Wątpię, by takie coś go przestraszyło.
Dialogue: 0,0:04:53.37,0:04:55.70,Default,Jinshi,0,0,0,,Co ona sobie myśli?
Dialogue: 0,0:05:42.33,0:05:43.69,Default,Jinshi,0,0,0,,Znowu przegrała!
Dialogue: 0,0:05:44.33,0:05:46.20,Default,Jinshi,0,0,0,,Dwie gry z rzędu.
Dialogue: 0,0:05:46.82,0:05:50.21,Default,Jinshi,0,0,0,,Skoro wyzwała\Nniepokonanego mistrza w Xiangoi,
Dialogue: 0,0:05:50.21,0:05:52.95,Default,Jinshi,0,0,0,,myślałem, że potrafi w to grać.
Dialogue: 0,0:05:53.37,0:05:57.71,Default,Jinshi,0,0,0,,Zdaje się, że ona tylko zna zasady,\Nale nigdy wcześniej nie grała.
Dialogue: 0,0:05:58.75,0:06:00.18,Default,Jinshi,0,0,0,,Dwie czarki...
Dialogue: 0,0:06:00.77,0:06:04.76,Default,Jinshi,0,0,0,,Wyżłopała je tak chętnie,\Nże nie wiem, czy były zatrute, czy nie.
Dialogue: 0,0:06:05.40,0:06:08.47,Default,Maomao,0,0,0,,Czy w trzeciej grze\Nrównież mogę zacząć?
Dialogue: 0,0:06:08.47,0:06:10.55,Default,Lakan,0,0,0,,Jasne, w porządku.
Dialogue: 0,0:06:12.10,0:06:14.33,Default,Jinshi,0,0,0,,Co ona sobie myśli?
Dialogue: 0,0:06:14.86,0:06:17.23,Default,Jinshi,0,0,0,,Wątpię, by wygrała trzecią grę.
Dialogue: 0,0:06:17.73,0:06:21.06,Default,Jinshi,0,0,0,,Jeśli dwie wyżłopane czarki były zatrute,
Dialogue: 0,0:06:21.43,0:06:23.73,Default,Jinshi,0,0,0,,wypicie kolejnej będzie niebezpieczne.
Dialogue: 0,0:06:24.61,0:06:28.34,Default,Jinshi,0,0,0,,Czyżby Lakan się tego spodziewał?
Dialogue: 0,0:06:31.12,0:06:32.25,Default,Maomao,0,0,0,,I szach.
Dialogue: 0,0:06:34.17,0:06:35.70,Default,Lakan,0,0,0,,Poddaję się.
Dialogue: 0,0:06:36.44,0:06:39.62,Default,Maomao,0,0,0,,Wygrana to wygrana, mimo że\Npozwolił mi pan wygrać, prawda?
Dialogue: 0,0:06:39.92,0:06:45.84,Default,Lakan,0,0,0,,Oczywiście, przecież nie mogę\Npozwolić, by moja córcia się otruła.
Dialogue: 0,0:06:46.27,0:06:48.50,Default,Lakan,0,0,0,,Którą wybierasz?
Dialogue: 0,0:06:48.50,0:06:50.34,Default,Maomao,0,0,0,,Niech pan bierze, którą chce.
Dialogue: 0,0:06:50.62,0:06:54.04,Default,Lakan,0,0,0,,Ten lek ma specyficzny smak?
Dialogue: 0,0:06:54.04,0:06:57.35,Default,Maomao,0,0,0,,Już po pierwszym łyku\Nbędzie pan wiedział.
Dialogue: 0,0:06:58.09,0:07:00.83,Default,Jinshi,0,0,0,,Lakan musiałby przegrać jeszcze dwa razy.
Dialogue: 0,0:07:01.27,0:07:03.85,Default,Jinshi,0,0,0,,Jeśli choć jedna czarka\Nbędzie miała inny smak,
Dialogue: 0,0:07:03.85,0:07:06.61,Default,Jinshi,0,0,0,,będzie wiedział,\Nże jego córka uniknie trucizny.
Dialogue: 0,0:07:07.08,0:07:12.11,Default,Jinshi,0,0,0,,Dokładnie wie, co robi\Ni dlatego celowo przegrywa.
Dialogue: 0,0:07:12.59,0:07:14.25,Default,Lakan,0,0,0,,Niech będzie ta.
Dialogue: 0,0:07:29.32,0:07:31.13,Default,Lakan,0,0,0,,Co za paskudztwo.
Dialogue: 0,0:07:32.89,0:07:37.76,Default,Jinshi,0,0,0,,Czyli zatrute! Teraz już nie muszę się\Nmartwić, że zielareczka wypije trutkę.
Dialogue: 0,0:07:38.39,0:07:42.99,Default,Jinshi,0,0,0,,To znaczy, że nie musi\Njuż specjalnie przegrywać.
Dialogue: 0,0:07:44.29,0:07:46.52,Default,Jinshi,0,0,0,,Zielareczka teraz już nie wygra.
Dialogue: 0,0:07:47.06,0:07:50.36,Default,Lakan,0,0,0,,Jeśli wygram,\Nzamieszkasz ze mną, dobrze?
Dialogue: 0,0:07:51.90,0:07:54.36,Default,Lakan,0,0,0,,Rany, ale jest gorąco.
Dialogue: 0,0:08:09.32,0:08:10.88,Default,Jinshi,0,0,0,,Co jest grane?
Dialogue: 0,0:08:11.27,0:08:13.78,Default,Jinshi,0,0,0,,Mówiłaś, że jedna to lekarstwo.
Dialogue: 0,0:08:13.78,0:08:16.91,Default,Jinshi,0,0,0,,Naprawdę go otrułaś?!\NAż tak go nienawidzisz?
Dialogue: 0,0:08:16.91,0:08:21.05,Default,Maomao,0,0,0,,To lekarstwo. Toż alkohol jest\Nlekarstwem na wszystko, prawda?
Dialogue: 0,0:08:21.05,0:08:23.41,Default,Jinshi,0,0,0,,Alkohol? Co masz na myśli?
Dialogue: 0,0:08:23.87,0:08:27.65,Default,Gaoshun,0,0,0,,Panie Jinshi, on jest po prostu pijany.
Dialogue: 0,0:08:28.04,0:08:28.62,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:08:34.94,0:08:37.45,Default,Maomao,0,0,0,,On nie może pić.
Dialogue: 0,0:08:38.12,0:08:39.54,Default,Jinshi,0,0,0,,Jak o tym pomyślę...
Dialogue: 0,0:08:40.49,0:08:44.52,Default,Jinshi,0,0,0,,Zawsze pił tylko sok owocowy,\Nnie widziałem, by sięgał po alkohol.
Dialogue: 0,0:08:45.42,0:08:47.72,Default,Jinshi,0,0,0,,Więc czym było to wcześniej?
Dialogue: 0,0:08:47.72,0:08:49.10,Default,Maomao,0,0,0,,Alkohol.
Dialogue: 0,0:08:49.51,0:08:50.87,Default,Maomao,0,0,0,,Tak czy inaczej...
Dialogue: 0,0:08:52.47,0:08:57.89,Default,Maomao,0,0,0,,Zabierzmy go do Grynszpanowego\NPawilonu, niech zerwie kwiat.
Dialogue: 0,0:09:04.58,0:09:08.56,Default,Lakan,0,0,0,,Od urodzenia nie rozróżniałem ludzi.
Dialogue: 0,0:09:09.45,0:09:12.03,Default,Lakan,0,0,0,,Myliłem nie tylko mamkę z matką,
Dialogue: 0,0:09:12.41,0:09:14.68,Default,Lakan,0,0,0,,nie umiałem też odróżnić\Nkobiet od mężczyzn.
Dialogue: 0,0:09:15.72,0:09:22.14,Default,Lakan,0,0,0,,Ojciec uważał mnie za śmiecia\Ni uciekł z oburzenia do swojej kochanki.
Dialogue: 0,0:09:23.22,0:09:26.92,Default,Lakan,0,0,0,,Moja matka rozpaczliwie prosiła, by wrócił.
Dialogue: 0,0:09:28.12,0:09:31.98,Default,Lakan,0,0,0,,Dlatego właśnie,\Nchoć byłem najstarszym synem,
Dialogue: 0,0:09:31.98,0:09:35.42,Default,Lakan,0,0,0,,zamiast się uczyć,\Npoświęcałem na grę w go i Xiangqi,
Dialogue: 0,0:09:35.42,0:09:37.96,Default,Lakan,0,0,0,,cały swój czas wolny.
Dialogue: 0,0:09:38.99,0:09:44.43,Default,Luomen,0,0,0,,Nie musisz pamiętać twarzy. Wystarczy\Nzapamiętać ich głos, sylwetkę, czy gesty.
Dialogue: 0,0:09:45.17,0:09:47.48,Default,Luomen,0,0,0,,Powiedzmy, jak z figurkami do Xiangqi.
Dialogue: 0,0:09:48.15,0:09:51.98,Default,Lakan,0,0,0,,Mój stryj był jedynym,\Nktóry mnie rozumiał.
Dialogue: 0,0:09:52.67,0:09:56.38,Default,Lakan,0,0,0,,Dzięki pomocy\Nnieudolnego stryja stopniowo
Dialogue: 0,0:09:56.38,0:09:59.99,Default,Lakan,0,0,0,,zacząłem postrzegać ludzkie\Ntwarze jako bierki do gry.
Dialogue: 0,0:10:02.28,0:10:04.67,Default,Lakan,0,0,0,,Dopiero kiedy stał się Wieżą,
Dialogue: 0,0:10:04.67,0:10:08.39,Default,Lakan,0,0,0,,przekonałem się, że to\Nnaprawdę wybitny człowiek.
Dialogue: 0,0:10:09.94,0:10:13.42,Default,Lakan,0,0,0,,Gdy podrosłem,\Ndzięki swojemu nazwisku,
Dialogue: 0,0:10:13.42,0:10:16.53,Default,Lakan,0,0,0,,zostałem mianowany oficerem,\Nchoć nie miałem za grosz talentu.
Dialogue: 0,0:10:17.01,0:10:18.81,Default,Lakan,0,0,0,,Pomimo że byłem słaby,
Dialogue: 0,0:10:18.81,0:10:21.75,Default,Lakan,0,0,0,,nadrobiłem to skutecznie,\Nwykorzystując swoich podwładnych.
Dialogue: 0,0:10:23.30,0:10:28.35,Default,Lakan,0,0,0,,Gra w Xiangqi z ludzkimi bierkami była\Nnajlepszą grą, w jaką kiedykolwiek grałem.
Dialogue: 0,0:10:28.35,0:10:32.61,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:10:29.33,0:10:32.61,Default,Lakan,0,0,0,,Zarówno w pracy,\Njak i w grach byłem niepokonany.
Dialogue: 0,0:10:33.34,0:10:37.99,Default,Lakan,0,0,0,,A później trafiłem do domu uciech,\Nby zmierzyć się z jedną kurtyzaną.
Dialogue: 0,0:10:39.16,0:10:45.47,Default,Lakan,0,0,0,,W świecie pełnym czerni i bieli,\Ntylko ona emanowała innymi kolorami.
Dialogue: 0,0:10:46.61,0:10:49.12,Default,Lakan,0,0,0,,Nazywała się Fengxian.
Dialogue: 0,0:10:49.77,0:10:52.09,Default,Lakan,0,0,0,,Niepokonana kurtyzana z domu uciech,
Dialogue: 0,0:10:52.09,0:10:53.97,Default,Lakan,0,0,0,,kontra ja, niezwyciężony oficer.
Dialogue: 0,0:10:54.43,0:10:58.13,Default,Lakan,0,0,0,,Widzowie świetnie się bawili\Nbez względu na to, kto przegrał.
Dialogue: 0,0:10:58.97,0:11:04.09,Default,Lakan,0,0,0,,Choć jest silna, walczy jedynie\Nw swoim małym świecie...
Dialogue: 0,0:11:06.22,0:11:07.67,Default,Lakan,0,0,0,,Przegrałem.
Dialogue: 0,0:11:08.30,0:11:10.50,Default,Lakan,0,0,0,,Zostałem doszczętnie zmiażdżony.
Dialogue: 0,0:11:10.50,0:11:13.36,Default,Lakan,0,0,0,,Kiedy ostatni raz\Ntak sromotnie przegrałem?
Dialogue: 0,0:11:22.06,0:11:28.02,Default,Lakan,0,0,0,,Zatem tak wygląda ludzka twarz.
Dialogue: 0,0:11:30.34,0:11:38.25,Default,Lakan,0,0,0,,Oczy niczym niecierpek, gotowe rozpaść\Nsię przy każdym dotknięciu...
Dialogue: 0,0:11:46.83,0:11:48.64,Default,Lakan,0,0,0,,Następnym razem nie przegram.
Dialogue: 0,0:11:49.38,0:11:55.98,Default,Lakan,0,0,0,,Od tego czasu przez kilka lat\Nspotykaliśmy się, by grać w go i Xiangqi.
Dialogue: 0,0:12:01.31,0:12:03.63,Default,Lakan,0,0,0,,Fengxian, która urodziła się\Nw domu uciech,
Dialogue: 0,0:12:03.63,0:12:06.66,Default,Lakan,0,0,0,,skrzętnie pilnowała\Nswojego skarbu, dumy.
Dialogue: 0,0:12:07.42,0:12:11.66,Default,Fengxian,0,0,0,,Nie mam matki.\NWprawdzie urodziła mnie kobieta,
Dialogue: 0,0:12:12.38,0:12:15.50,Default,Fengxian,0,0,0,,ale w dzielnicy uciech kurtyzana\Nnigdy nie może zostać matką.
Dialogue: 0,0:12:18.70,0:12:24.76,Default,Lakan,0,0,0,,Wraz ze wzrostem popularności kurtyzany,\Ndom uciech niechętnie chce ją sprzedać.
Dialogue: 0,0:12:25.82,0:12:28.01,Default,Lakan,0,0,0,,Fengxian idealnie się dopasowała.
Dialogue: 0,0:12:29.35,0:12:33.34,Default,Lakan,0,0,0,,Jej szorstka postawa\Nnie wszystkim przypadała do gustu,
Dialogue: 0,0:12:33.34,0:12:36.17,Default,Lakan,0,0,0,,ale mimo to miała kilku adoratorów.
Dialogue: 0,0:12:37.35,0:12:39.78,Default,Lakan,0,0,0,,Jej cena stopniowo rosła,
Dialogue: 0,0:12:40.42,0:12:43.64,Default,Lakan,0,0,0,,więc mogliśmy spotykać się\Ntylko raz na trzy miesiące.
Dialogue: 0,0:12:50.86,0:12:54.63,Default,Lakan,0,0,0,,Kwiat niecierpka i... Co to takiego?
Dialogue: 0,0:12:54.63,0:12:58.38,Default,Fengxian,0,0,0,,Szczawik, znany również jako kocia łapka.
Dialogue: 0,0:12:58.38,0:13:01.32,Default,Fengxian,0,0,0,,Ponoć pomaga on leczyć trucizny\Ni ukąszenia owadów.
Dialogue: 0,0:13:03.07,0:13:09.02,Default,Fengxian,0,0,0,,Podobnie jak niecierpek, po dotknięciu\Ndojrzałych owoców, puszcza on sok.
Dialogue: 0,0:13:10.53,0:13:11.97,Default,Lakan,0,0,0,,Interesujące.
Dialogue: 0,0:13:13.57,0:13:15.91,Default,Fengxian,0,0,0,,Kiedy znowu przyjedziesz?
Dialogue: 0,0:13:20.50,0:13:22.61,Default,Lakan,0,0,0,,Jak zwykle, za trzy miesiące.
Dialogue: 0,0:13:23.97,0:13:25.24,Default,Fengxian,0,0,0,,Rozumiem.
Dialogue: 0,0:13:27.34,0:13:31.18,Default,Lakan,0,0,0,,I wtedy dowiedziałem się,\Nże ktoś chcę ją wykupić.
Dialogue: 0,0:13:32.58,0:13:37.38,Default,Lakan,0,0,0,,Jej wielbiciele toczyli zażartą walkę,\Nwięc jej wartość diametralnie wzrosła.
Dialogue: 0,0:13:38.88,0:13:41.15,Default,Lakan,0,0,0,,Moja kariera oficerska\Nprzebiegała pomyślnie,
Dialogue: 0,0:13:41.15,0:13:45.06,Default,Lakan,0,0,0,,ale odkąd straciłem tytuł dziedzica\Nna rzecz przyrodniego brata,
Dialogue: 0,0:13:45.06,0:13:48.49,Default,Lakan,0,0,0,,jej kwota przekraczała moje możliwości.
Dialogue: 0,0:13:50.18,0:13:52.35,Default,Fengxian,0,0,0,,Może dla odmiany założymy się o coś?
Dialogue: 0,0:13:53.58,0:13:57.00,Default,Fengxian,0,0,0,,Jeśli wygrasz, dam ci wszystko,\Nczego pragniesz.
Dialogue: 0,0:13:57.67,0:14:01.20,Default,Fengxian,0,0,0,,Jeśli ja wygram,\Nwezmę wszystko, czego zapragnę.
Dialogue: 0,0:14:02.67,0:14:04.79,Default,Fengxian,0,0,0,,Wybierz planszę.
Dialogue: 0,0:14:06.26,0:14:09.32,Default,Lakan,0,0,0,,Przeszła mi przez głowę okropna myśl.
Dialogue: 0,0:14:11.66,0:14:13.37,Default,Fengxian,0,0,0,,Go, prawda?
Dialogue: 0,0:14:13.37,0:14:14.33,Default,Lakan,0,0,0,,Tak.
Dialogue: 0,0:14:15.15,0:14:18.63,Default,Fengxian,0,0,0,,Meimei, chcę skupić się na tej grze.
Dialogue: 0,0:14:19.09,0:14:19.83,Default,Meimei,0,0,0,,Dobrze.
Dialogue: 0,0:14:58.02,0:15:01.65,Default,Lakan,0,0,0,,Nim się spostrzegłem,\Nnasze dłonie się złączyły.
Dialogue: 0,0:15:03.74,0:15:07.19,Default,Lakan,0,0,0,,Z jej ust nie padły\Nżadne słodkie słówka.
Dialogue: 0,0:15:08.10,0:15:10.57,Default,Lakan,0,0,0,,Zresztą ja też\Nnie byłem zbyt wylewny.
Dialogue: 0,0:15:10.57,0:15:13.86,Default,Lakan,0,0,0,,Pod tym względem\Nbyliśmy do siebie podobni.
Dialogue: 0,0:15:15.46,0:15:16.89,Default,Fengxian,0,0,0,,Chcę zagrać w go.
Dialogue: 0,0:15:17.59,0:15:21.61,Default,Lakan,0,0,0,,Natomiast ja wolałem grać w Xiangqi.
Dialogue: 0,0:15:22.52,0:15:29.32,Default,Fengxian,0,0,0,,{\i1}Ach, śpij kochanie... śpij... {dubel z lin. 4}
Dialogue: 0,0:15:30.12,0:15:37.58,Default,Fengxian,0,0,0,,{\i1}Jeśli gwiazdkę\Nz nieba chcesz, dostaniesz... {dubel z lin. 5} {Dałam teskt kołysanki jakoś bardziej mi pasował 185-188}
Dialogue: 0,0:15:38.24,0:15:45.18,Default,Fengxian,0,0,0,,{\i1}Czego pragniesz, daj mi znać,
Dialogue: 0,0:15:45.89,0:15:53.47,Default,Fengxian,0,0,0,,{\i1}ja ci wszystko mogę dać.
Dialogue: 0,0:15:54.23,0:15:58.87,Default,Lakan,0,0,0,,Trzy miesiące później mój pozornie\Nbystry stryj stracił swoją pozycję.
Dialogue: 0,0:15:59.22,0:16:02.94,Default,Father,0,0,0,,Zostałeś medykiem w wewnętrznym\Npałacu, a teraz cię wygnali?!
Dialogue: 0,0:16:02.94,0:16:04.60,Default,Father,0,0,0,,To hańba dla naszej rodziny!
Dialogue: 0,0:16:05.72,0:16:09.19,Default,Lakan,0,0,0,,Choć był naprawdę pojętny,\Nokazał się niezdarą.
Dialogue: 0,0:16:09.63,0:16:12.54,Default,Father,0,0,0,,Dobrze się dogadywaliście, co?
Dialogue: 0,0:16:12.54,0:16:15.26,Default,Father,0,0,0,,Wyjeżdżasz studiować zagranicę!
Dialogue: 0,0:16:15.26,0:16:16.65,Default,Lakan,0,0,0,,Studiować zagranicą?
Dialogue: 0,0:16:16.65,0:16:18.16,Default,Father,0,0,0,,Na wszelki wypadek.
Dialogue: 0,0:16:18.61,0:16:19.41,Default,Lakan,0,0,0,,Ale...
Dialogue: 0,0:16:19.89,0:16:20.79,Default,Father,0,0,0,,Co?
Dialogue: 0,0:16:21.21,0:16:23.86,Default,Lakan,0,0,0,,Nie, nic takiego.
Dialogue: 0,0:16:24.81,0:16:29.63,Default,Lakan,0,0,0,,Nie mogłem w żaden sposób sprzeciwić się\Nojcu, który zarazem był moim przełożonym.
Dialogue: 0,0:16:30.77,0:16:32.11,Default,Lakan,0,0,0,,Mniej więcej wtedy.
Dialogue: 0,0:16:32.11,0:16:35.89,Default,Lakan,0,0,0,,Fengxian powiadomiła mnie,\Nże jej wykup nie doszedł do skutku.
Dialogue: 0,0:16:36.70,0:16:41.49,Default,Lakan,0,0,0,,Odpisałem jej, że wrócę\Nza jakieś sześć miesięcy.
Dialogue: 0,0:16:43.35,0:16:44.44,Default,Lakan,0,0,0,,Ale wtedy...
Dialogue: 0,0:16:50.87,0:16:56.03,Default,Lakan,0,0,0,,Nie wiedziałem,\Nże powrót zajmie mi aż trzy lata.
Dialogue: 0,0:16:59.42,0:17:02.07,Default,Lakan,0,0,0,,Tyle listów od Fengxian...
Dialogue: 0,0:17:16.82,0:17:20.50,Default,Lakan,0,0,0,,Błoto? Nie, gałązka?
Dialogue: 0,0:17:20.98,0:17:22.67,Default,Lakan,0,0,0,,A może jedno i drugie?
Dialogue: 0,0:17:25.54,0:17:28.19,Default,Lakan,0,0,0,,Nie, to jest...
Dialogue: 0,0:17:30.49,0:17:31.82,Default,Lakan,0,0,0,,Obcięcie palca...
Dialogue: 0,0:17:31.82,0:17:34.94,Default,Lakan,0,0,0,,Ostatnio to była dość\Npopularna forma klątwy.
Dialogue: 0,0:17:35.55,0:17:38.16,Default,Lakan,0,0,0,,Powodem, dlaczego jej wykup\Nnie doszedł do skutku...
Dialogue: 0,0:17:38.65,0:17:42.45,Default,Lakan,0,0,0,,Drugi malutki paluszek w sakiewce...
Dialogue: 0,0:17:42.86,0:17:44.62,Default,Lakan,0,0,0,,Jak mogłem tego nie zauważyć?!
Dialogue: 0,0:17:45.46,0:17:47.87,Default,Lakan,0,0,0,,Wszystko, o czym myślałem,\Nto gra w Xiangqi.
Dialogue: 0,0:17:49.88,0:17:54.45,Default,Lakan,0,0,0,,Nie zadałem nawet tak\Noczywistego pytania!
Dialogue: 0,0:17:57.06,0:17:58.84,Default,Lakan,0,0,0,,Gdzie jest Fengxian?!
Dialogue: 0,0:17:59.20,0:18:00.22,Default,Old Lady,0,0,0,,To ty!
Dialogue: 0,0:18:00.54,0:18:02.56,Default,Old Lady,0,0,0,,Fengxian już nie ma!
Dialogue: 0,0:18:02.56,0:18:04.48,Default,Old Lady,0,0,0,,Gdzie się włóczyłeś\Ncały ten czas?!
Dialogue: 0,0:18:04.48,0:18:06.70,Default,Old Lady,0,0,0,,Porzuciłeś ją na całe trzy lata!
Dialogue: 0,0:18:06.70,0:18:10.90,Default,Old Lady,0,0,0,,W dupie miałeś to, co stanie się\Nz bezużyteczną kurtyzaną, prawda?!
Dialogue: 0,0:18:13.51,0:18:16.83,Default,Lakan,0,0,0,,Gdybym tylko pomyślał o tym wcześniej!
Dialogue: 0,0:18:16.83,0:18:20.14,Default,Lakan,0,0,0,,Powód, dla którego\Nnie została wykupiona...
Dialogue: 0,0:18:20.66,0:18:22.45,Default,Lakan,0,0,0,,Powód krył się w niej...
Dialogue: 0,0:18:23.31,0:18:29.08,Default,Lakan,0,0,0,,Splamiła dobre imię domu uciech,\Nwięc jej reputacja spadła do zera!
Dialogue: 0,0:18:30.59,0:18:33.16,Default,Lakan,0,0,0,,Zostało jej tylko przyjmowanie\Nklientów na ulicy.
Dialogue: 0,0:18:34.97,0:18:36.09,Default,Lakan,0,0,0,,i...
Dialogue: 0,0:18:44.38,0:18:48.38,Default,Lakan,0,0,0,,Bez względu na to, ile rozpaczałem,\Nnie mogłem cofnąć czasu.
Dialogue: 0,0:18:49.90,0:18:54.53,Default,Lakan,0,0,0,,Wszystko przez to,\Nże byłem tak ślepy.
Dialogue: 0,0:19:06.84,0:19:10.76,Default,Lakan,0,0,0,,Czy to... Grynszpanowy Pawilon?
Dialogue: 0,0:19:12.75,0:19:14.23,Default,Meimei,0,0,0,,Obudziłeś się?
Dialogue: 0,0:19:16.22,0:19:17.51,Default,Lakan,0,0,0,,Meimei.
Dialogue: 0,0:19:18.02,0:19:21.86,Default,Meimei,0,0,0,,Przyprowadził cię tu sługa\Njakiegoś arystokraty.
Dialogue: 0,0:19:22.24,0:19:27.00,Default,Meimei,0,0,0,,Wyglądasz okropnie. Nie wiem, czy jest\Nbardziej czerwona, czy niebieska.
Dialogue: 0,0:19:27.00,0:19:30.28,Default,Lakan,0,0,0,,Nie planowałem tego.
Dialogue: 0,0:19:30.28,0:19:33.78,Default,Lakan,0,0,0,,Nie spodziewałem się,\Nże to taki mocny trunek.
Dialogue: 0,0:19:35.51,0:19:39.96,Default,Lakan,0,0,0,,Meimei była niegdyś\Nczeladniczką Fengxian.
Dialogue: 0,0:19:41.09,0:19:43.62,Default,Lakan,0,0,0,,Często się z nią droczyłem.
Dialogue: 0,0:19:44.69,0:19:48.20,Default,Lakan,0,0,0,,Kiedy ją pochwaliłem,\Nsprawiała wrażenie zawstydzonej.
Dialogue: 0,0:19:48.98,0:19:50.25,Default,Lakan,0,0,0,,Tak sobie myślę...
Dialogue: 0,0:19:50.68,0:19:52.58,Default,Meimei,0,0,0,,O co chodzi?
Dialogue: 0,0:19:53.25,0:19:55.17,Default,Lakan,0,0,0,,Nie, nic takiego.
Dialogue: 0,0:19:58.07,0:19:59.55,Default,Meimei,0,0,0,,Proszę bardzo.
Dialogue: 0,0:19:59.55,0:20:00.60,Default,Lakan,0,0,0,,Dziękuję.
Dialogue: 0,0:20:04.43,0:20:05.89,Default,Lakan,0,0,0,,Ale gorzkie!
Dialogue: 0,0:20:05.89,0:20:07.52,Default,Lakan,0,0,0,,Co to ma być?!
Dialogue: 0,0:20:07.52,0:20:09.56,Default,Meimei,0,0,0,,Maomao to zrobiła.
Dialogue: 0,0:20:10.56,0:20:13.76,Default,Maomao,0,0,0,,{\an8}Mieszu, mieszu, mieszu, mieszu, mieszu.
Dialogue: 0,0:20:11.58,0:20:15.06,Default,Lakan,0,0,0,,Więc to jej sprawka...
Dialogue: 0,0:20:15.50,0:20:18.32,Default,Maomao,0,0,0,,Ponadto zostawiła dla ciebie tę szkatułkę.
Dialogue: 0,0:20:28.02,0:20:29.88,Default,Lakan,0,0,0,,Uschnięta róża?
Dialogue: 0,0:20:30.44,0:20:34.96,Default,Meimei,0,0,0,,Nawet gdy uschnie,\Nmoże zachowywać swój wygląd.
Dialogue: 0,0:20:41.21,0:20:42.59,Default,Servant Girl,0,0,0,,Siostrzyczko, Meimei.
Dialogue: 0,0:20:43.96,0:20:45.34,Default,Meimei,0,0,0,,Pójdę już.
Dialogue: 0,0:22:35.04,0:22:50.05,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.59,0:22:50.05,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Jinshi i Maomao”.
Dialogue: 0,0:22:48.05,0:22:50.05,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
