Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:32.86,0:01:35.86,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:44.93,0:01:45.83,Default,Young Jinshi,0,0,0,,{\i1}Mamo?
Dialogue: 0,0:01:57.73,0:02:01.22,Default,Jinshi,0,0,0,,{\i1}Czemu moja matka\Ntak na mnie patrzyła?
Dialogue: 0,0:02:04.43,0:02:06.81,Default,Empress Dowager,0,0,0,,{\i1}A teraz wracaj do siebie.
Dialogue: 0,0:02:07.23,0:02:08.34,Default,Previous Emperor,0,0,0,,{\i1}Dobrze.
Dialogue: 0,0:02:13.16,0:02:19.10,Default,Jinshi,0,0,0,,{\i1}Ten staruszek... Ta staruszka...\NKim oni byli?
Dialogue: 0,0:02:23.95,0:02:25.77,Default,Jinshi,0,0,0,,{\i1}Nie mogę sobie przypomnieć...
Dialogue: 0,0:02:37.07,0:02:38.84,Default,Jinshi,0,0,0,,Co za koszmar.
Dialogue: 0,0:02:46.84,0:02:52.00,Default,Jinshi,0,0,0,,{\i1}Wtedy jeszcze nie wiedziałem,\Nkim byli staruszkowie.
Dialogue: 0,0:02:52.00,0:02:53.52,Default,Jinshi,0,0,0,,{\i1}Później mnie oświecili.
Dialogue: 0,0:02:53.97,0:02:57.07,Default,Jinshi,0,0,0,,{\i1}Ten starzec był moim ojcem,\Na kobieta babką.
Dialogue: 0,0:02:57.47,0:02:58.57,Default,Jinshi,0,0,0,,{\i1}Dodatkowo...
Dialogue: 0,0:02:59.00,0:03:03.07,Default,Jinshi,0,0,0,,{\i1}Okazało się, że osoba, którą zawsze\Nuważałem za ojca, to mój brat.
Dialogue: 0,0:03:07.70,0:03:10.14,Default,Jinshi,0,0,0,,{\i1}Ta pannica bywa tępa\Nw niektórych momentach,
Dialogue: 0,0:03:10.14,0:03:11.71,Default,Jinshi,0,0,0,,{\i1}ale wkrótce się zorientuje.
Dialogue: 0,0:03:12.71,0:03:14.03,Default,Jinshi,0,0,0,,{\i1}A może już wie...
Dialogue: 0,0:03:15.16,0:03:17.24,Default,Jinshi,0,0,0,,{\i1}Uspokoiłoby mnie to.
Dialogue: 0,0:03:17.57,0:03:20.83,Default,Jinshi,0,0,0,,Nie mogę wiecznie tego ukrywać.
Dialogue: 0,0:03:28.57,0:03:32.56,Default,Old Eunuch,0,0,0,,Dawno temu ziemie\Nte należały do innej społeczności.
Dialogue: 0,0:03:33.27,0:03:37.23,Default,Text,0,0,0,,{\an8}ODCINEK: 31: CHRAM WYBORU
Dialogue: 0,0:03:33.57,0:03:40.21,Default,Old Eunuch,0,0,0,,Lud ten nie miał przywódcy,\Nale z daleka przybyła pewna szlachcianka.
Dialogue: 0,0:03:40.21,0:03:43.14,Default,Old Eunuch,0,0,0,,Kobieta ta dostąpiła\Nniepokalanego poczęcia.
Dialogue: 0,0:03:43.76,0:03:47.20,Default,Old Eunuch,0,0,0,,Później dziecię to zostało\Npierwszym cesarzem Li.
Dialogue: 0,0:03:47.71,0:03:51.08,Default,Old Eunuch,0,0,0,,Kobieta, której oczy potrafiły\Nwidzieć w ciemnościach,
Dialogue: 0,0:03:51.08,0:03:53.00,Default,Old Eunuch,0,0,0,,znana była później jako Cesarzowa Matka.
Dialogue: 0,0:03:53.00,0:03:57.00,Default,Old Eunuch,0,0,0,,Niektórzy wierzą, że była czarodziejką,\Npochodzącą z krainy czarnoksiężników.
Dialogue: 0,0:03:57.55,0:04:00.51,Default,Maomao,0,0,0,,{\i1}Legenda o stworzeniu narodu, ta?
Dialogue: 0,0:04:00.51,0:04:02.08,Default,Jinshi,0,0,0,,Jak leci, zielareczko?
Dialogue: 0,0:04:02.08,0:04:04.64,Default,Maomao,0,0,0,,Uważaj, paniczu Jinshi,\Nbo jeszcze ujrzą twe lico.
Dialogue: 0,0:04:05.02,0:04:06.10,Default,Jinshi,0,0,0,,Ups.
Dialogue: 0,0:04:06.10,0:04:08.46,Default,Maomao,0,0,0,,{\i1}Obecnie są skupione na nauce.
Dialogue: 0,0:04:08.46,0:04:11.99,Default,Maomao,0,0,0,,{\i1}Pojawienie się tego elegancika\Nskradłoby ich zainteresowanie.
Dialogue: 0,0:04:11.99,0:04:13.89,Default,Maomao,0,0,0,,Zatem mamy około\Ndwudziestu uczestniczek?
Dialogue: 0,0:04:14.75,0:04:17.37,Default,Jinshi,0,0,0,,Liczyłem, że będzie ich więcej.
Dialogue: 0,0:04:17.37,0:04:20.40,Default,Gaoshun,0,0,0,,Na początku było dziesięć,\Nwięc i tak mamy wzrost.
Dialogue: 0,0:04:20.40,0:04:24.15,Default,Maomao,0,0,0,,{\i1}Cóż, chyba jest git.\NNiemniej jednak...
Dialogue: 0,0:04:24.77,0:04:29.50,Default,Maomao,0,0,0,,{\i1}Jeśli plan pana Jinshiego się powiedzie\Ni więcej służek zacznie czytać,
Dialogue: 0,0:04:29.50,0:04:31.91,Default,Maomao,0,0,0,,{\i1}sytuacja w wewnętrznym pałacu\Npowinna się zmienić.
Dialogue: 0,0:04:32.46,0:04:37.75,Default,Maomao,0,0,0,,{\i1}W zasadzie Xiaolan sama\Npotrafi już czytać proste historie.
Dialogue: 0,0:04:38.56,0:04:40.93,Default,Gaoshun,0,0,0,,Panie Jinshi, czas na nas.
Dialogue: 0,0:04:40.93,0:04:43.05,Default,Jinshi,0,0,0,,Jasne. A co z tobą?
Dialogue: 0,0:04:43.85,0:04:46.75,Default,Maomao,0,0,0,,Zostanę i poobserwuję trochę.
Dialogue: 0,0:04:46.75,0:04:50.29,Default,Jinshi,0,0,0,,Dobrze. Jeśli coś zauważysz,\Npowiadom mnie.
Dialogue: 0,0:04:50.29,0:04:51.31,Default,Maomao,0,0,0,,Oczywiście.
Dialogue: 0,0:04:52.92,0:04:53.86,Default,Maomao,0,0,0,,Xiaolan.
Dialogue: 0,0:04:54.45,0:04:57.31,Default,Xiaolan,0,0,0,,O, Maomao! Nie zauważyłam cię!
Dialogue: 0,0:04:57.74,0:05:00.27,Default,Maomao,0,0,0,,I jak? Nauczyłaś się jakichś znaków?
Dialogue: 0,0:05:01.27,0:05:05.24,Default,Xiaolan,0,0,0,,Tylko kilku! O niektóre\Nmuszę zapytać nauczyciela.
Dialogue: 0,0:05:05.24,0:05:06.45,Default,Xiaolan,0,0,0,,Chodź ze mną, Maomao!
Dialogue: 0,0:05:06.45,0:05:07.07,Default,Maomao,0,0,0,,Jasne.
Dialogue: 0,0:05:07.42,0:05:12.00,Default,Xiaolan,0,0,0,,Nauczyciel jest w budynku obok.\NCzasami wpadam do niego z pytaniami.
Dialogue: 0,0:05:12.55,0:05:15.58,Default,Maomao,0,0,0,,{\i1}Czyżby jakaś stara świątynia?
Dialogue: 0,0:05:15.58,0:05:19.19,Default,Xiaolan,0,0,0,,Dzieńdoberek! Przepraszam za najście!
Dialogue: 0,0:05:19.19,0:05:23.67,Default,Old Eunuch,0,0,0,,Już idę. Chyba pierwszy raz\Nwidzę tamtą młodą damę.
Dialogue: 0,0:05:31.14,0:05:34.85,Default,Maomao,0,0,0,,{\i1}Jest dziwnie smukła i długa,\Nale chyba jest dość głęboka.
Dialogue: 0,0:05:35.54,0:05:40.31,Default,Maomao,0,0,0,,{\i1}Dystans między filarami jest niewielki.\NMusi być podzielona na kilka pomieszczeń.
Dialogue: 0,0:05:41.49,0:05:43.40,Default,Old Eunuch,0,0,0,,Interesuje cię ten chram?
Dialogue: 0,0:05:43.82,0:05:48.02,Default,Maomao,0,0,0,,Tak, budynek ma dziwny wygląd.
Dialogue: 0,0:05:48.02,0:05:52.46,Default,Old Eunuch,0,0,0,,Chram został wzniesiony przez ludzi,\Nktórzy pierwotnie tu mieszkali.
Dialogue: 0,0:05:52.46,0:05:57.70,Default,Old Eunuch,0,0,0,,Kiedy Cesarzowa Matka rządziła tym\Nmiejscem, nie potępiała żadnej religii.
Dialogue: 0,0:05:57.70,0:05:59.58,Default,Xiaolan,0,0,0,,Cesarzowa Matka,\No której była wcześniej mowa,
Dialogue: 0,0:05:59.58,0:06:01.38,Default,Xiaolan,0,0,0,,to matka pierwszego cesarza?
Dialogue: 0,0:06:02.11,0:06:05.94,Default,Old Eunuch,0,0,0,,Tak. Swojemu synowi powiedziała:
Dialogue: 0,0:06:06.51,0:06:11.69,Default,Old Eunuch,0,0,0,,„Ten, który zechce władać tą ziemią,\Nmusi przebrnąć przez ten chram.
Dialogue: 0,0:06:11.69,0:06:16.62,Default,Old Eunuch,0,0,0,,Tylko ci, którzy wybiorą słuszną drogę,\Nmogą zostać władcami tej krainy”.
Dialogue: 0,0:06:16.62,0:06:21.27,Default,Old Eunuch,0,0,0,,Jej synowi udało się przejść\Nprzez chram i został cesarzem.
Dialogue: 0,0:06:21.90,0:06:25.73,Default,Old Eunuch,0,0,0,,Również z jego powodu stolica\Nzostała przeniesiona właśnie tutaj.
Dialogue: 0,0:06:25.73,0:06:26.82,Default,Xiaolan,0,0,0,,Łał!
Dialogue: 0,0:06:26.82,0:06:29.94,Default,Old Eunuch,0,0,0,,Jednak chram od wielu dekad nie był używany.
Dialogue: 0,0:06:29.94,0:06:32.76,Default,Old Eunuch,0,0,0,,Zastanawiam się, czy kiedykolwiek\Njeszcze ktoś z niego skorzysta.
Dialogue: 0,0:06:33.46,0:06:35.09,Default,Maomao,0,0,0,,Co masz na myśli?
Dialogue: 0,0:06:35.09,0:06:40.75,Default,Old Eunuch,0,0,0,,Wszyscy starsi bracia poprzedniego\Ncesarza zmarli z powodu epidemii.
Dialogue: 0,0:06:41.62,0:06:44.21,Default,Old Eunuch,0,0,0,,Przeżył tylko poprzedni cesarz.
Dialogue: 0,0:06:44.21,0:06:48.01,Default,Maomao,0,0,0,,{\i1}Krótko mówiąc, obyło się\Nbez ustalania spadkobiercy.
Dialogue: 0,0:06:48.51,0:06:54.32,Default,Old Eunuch,0,0,0,,Cieszy mnie, że ktoś zainteresował się\Nchramem. Trochę czasu minęło.
Dialogue: 0,0:06:54.32,0:06:57.32,Default,Maomao,0,0,0,,Dawniej przyciągał więcej uwagi?
Dialogue: 0,0:06:57.32,0:07:01.40,Default,Old Eunuch,0,0,0,,Tak. Pracował tu kiedyś szalony doktorek.
Dialogue: 0,0:07:01.40,0:07:05.26,Default,Old Eunuch,0,0,0,,Wałęsał się po wewnętrznym\Npałacu, kiedy tylko miał czas.
Dialogue: 0,0:07:05.26,0:07:08.02,Default,Old Eunuch,0,0,0,,Wypytywał o niego,\Ntak jak ty przed chwilą...
Dialogue: 0,0:07:08.02,0:07:09.63,Default,Maomao,0,0,0,,Nazywał się Luomen?
Dialogue: 0,0:07:09.63,0:07:10.86,Default,Old Eunuch,0,0,0,,Znasz go?
Dialogue: 0,0:07:11.32,0:07:13.35,Default,Maomao,0,0,0,,{\i1}Cholera, nie chciałam...
Dialogue: 0,0:07:13.84,0:07:15.02,Default,Maomao,0,0,0,,To mój przybrany ojciec.
Dialogue: 0,0:07:15.02,0:07:16.37,Default,Maomao,0,0,0,,Po opuszczeniu wewnętrznego pałacu
Dialogue: 0,0:07:16.37,0:07:18.84,Default,Maomao,0,0,0,,zaczął pracować jako zielarz\Nw dzielnicy uciech.
Dialogue: 0,0:07:18.84,0:07:21.46,Default,Old Eunuch,0,0,0,,Rozumiem. Jesteś\Nprzybraną Luomena...
Dialogue: 0,0:07:22.20,0:07:26.01,Default,Maomao,0,0,0,,{\i1}Ciekawe, czy przyjaźnił się\Nz moim tatkiem.
Dialogue: 0,0:07:26.01,0:07:26.84,Default,Xiaolan,0,0,0,,Maomao!
Dialogue: 0,0:07:27.32,0:07:29.01,Default,Xiaolan,0,0,0,,Zobacz, napisałam coś!
Dialogue: 0,0:07:29.44,0:07:30.28,Default,Maomao,0,0,0,,Łał.
Dialogue: 0,0:07:33.15,0:07:34.67,Default,Maomao,0,0,0,,Nie jest zatrute.
Dialogue: 0,0:07:36.59,0:07:38.16,Default,Maomao,0,0,0,,Pójdę sobie.
Dialogue: 0,0:07:38.16,0:07:39.48,Default,Emperor,0,0,0,,Czekaj, zielareczko.
Dialogue: 0,0:07:39.84,0:07:42.80,Default,Emperor,0,0,0,,Po kolacji idę w jedno miejsce\Ni chcę, żebyś mi towarzyszyła.
Dialogue: 0,0:07:43.40,0:07:44.48,Default,Maomao,0,0,0,,Dokąd?
Dialogue: 0,0:07:44.80,0:07:46.71,Default,Emperor,0,0,0,,Do Chramu Wyboru.
Dialogue: 0,0:07:48.74,0:07:51.07,Default,Jinshi,0,0,0,,Skąd ta nagła potrzeba?
Dialogue: 0,0:07:51.07,0:07:53.52,Default,Maomao,0,0,0,,{\i1}Co on knuje?
Dialogue: 0,0:07:54.67,0:07:56.58,Default,Maomao,0,0,0,,{\i1}To ten budynek,\Nktóry dziś widziałam.
Dialogue: 0,0:07:57.50,0:07:58.66,Default,Maomao,0,0,0,,{\i1}I...
Dialogue: 0,0:07:58.66,0:08:00.78,Default,Maomao,0,0,0,,{\i1}Nauczyciel z wcześniej?
Dialogue: 0,0:08:00.78,0:08:02.62,Default,Old Eunuch,0,0,0,,Czekałem na wasze przybycie.
Dialogue: 0,0:08:02.91,0:08:05.79,Default,Emperor,0,0,0,,Mogę spróbować jeszcze raz?
Dialogue: 0,0:08:06.08,0:08:10.34,Default,Old Eunuch,0,0,0,,Wynik może się nie zmienić,\Nwięc jak ci to pasuje, to droga wolna.
Dialogue: 0,0:08:10.80,0:08:14.10,Default,Maomao,0,0,0,,{\i1}Nie pieprzy się nawet z cesarzem.
Dialogue: 0,0:08:14.10,0:08:15.86,Default,Old Eunuch,0,0,0,,Kto będzie ci towarzyszył?
Dialogue: 0,0:08:15.86,0:08:18.51,Default,Emperor,0,0,0,,Ta dwójka.
Dialogue: 0,0:08:18.80,0:08:19.55,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:08:19.55,0:08:22.46,Default,Maomao,0,0,0,,A nie jest to zakazane dla kobiet?
Dialogue: 0,0:08:23.41,0:08:25.94,Default,Old Eunuch,0,0,0,,Cesarzowa Matka i Cesarzowa\NWdowa również były kobietami.
Dialogue: 0,0:08:26.98,0:08:27.97,Default,Old Eunuch,0,0,0,,Śmiało.
Dialogue: 0,0:08:27.97,0:08:29.69,Default,Emperor,0,0,0,,No to do dzieła.
Dialogue: 0,0:08:35.54,0:08:37.32,Default,Maomao,0,0,0,,{\i1}Trzy przejścia?
Dialogue: 0,0:08:37.37,0:08:42.20,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ CZERWONE DRZWI.
Dialogue: 0,0:08:38.11,0:08:41.18,Default,Maomao,0,0,0,,{\i1}Nie wolno przechodzić przez czerwone drzwi?
Dialogue: 0,0:08:41.18,0:08:44.71,Default,Maomao,0,0,0,,{\i1}Drzwi są niebieskie, czerwone i zielone.
Dialogue: 0,0:08:45.14,0:08:47.52,Default,Maomao,0,0,0,,{\i1}Które zatem należałoby wybrać?
Dialogue: 0,0:08:47.52,0:08:50.04,Default,Old Eunuch,0,0,0,,Które drzwi wybierzesz?
Dialogue: 0,0:08:50.04,0:08:53.74,Default,Emperor,0,0,0,,Tym razem postawmy na niebieskie,\Nskoro poprzednio wybrałem zielone.
Dialogue: 0,0:08:53.74,0:08:57.20,Default,Old Eunuch,0,0,0,,Zgadza się. Tędy proszę.
Dialogue: 0,0:09:01.28,0:09:04.48,Default,Old Eunuch,0,0,0,,Obyś tym razem zwracał większą uwagę na tych,\Nktórym zlecono opiekę nad tym miejscem.
Dialogue: 0,0:09:04.48,0:09:09.70,Default,Old Eunuch,0,0,0,,Stoi odłogiem przez dłuższy czas,\Nby nagle ktoś zechciał z niej skorzystać.
Dialogue: 0,0:09:09.70,0:09:11.73,Default,Emperor,0,0,0,,Haha, daruj panie słudze swemu.
Dialogue: 0,0:09:13.65,0:09:17.97,Default,Maomao,0,0,0,,{\i1}Znowu trzy przejścia...\NZielone, brązowe, jasnoniebieskie.
Dialogue: 0,0:09:17.97,0:09:21.03,Default,Maomao,0,0,0,,{\i1}Kolejny znak mówi: „Nie\Nprzechodź przez brązowe drzwi”.
Dialogue: 0,0:09:18.66,0:09:21.03,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ BRĄZOWE DRZWI
Dialogue: 0,0:09:21.38,0:09:23.05,Default,Emperor,0,0,0,,Gram w zielone.
Dialogue: 0,0:09:23.05,0:09:24.16,Default,Maomao,0,0,0,,{\i1}Nie mówcie, że...
Dialogue: 0,0:09:26.03,0:09:29.54,Default,Maomao,0,0,0,,{\i1}Będzie się to ciągnąć do usranej śmierci?
Dialogue: 0,0:09:35.03,0:09:38.41,Default,Maomao,0,0,0,,{\i1}I do przodu, do tyłu,\Nw górę i w dół.
Dialogue: 0,0:09:38.41,0:09:40.72,Default,Maomao,0,0,0,,{\i1}Totalnie się pogubiłam.
Dialogue: 0,0:09:40.72,0:09:43.94,Default,Maomao,0,0,0,,{\i1}Wydaje mi się, że chodzimy w kółko.
Dialogue: 0,0:09:44.38,0:09:47.35,Default,Maomao,0,0,0,,{\i1}Dlaczego cesarz zabrał mnie ze sobą?
Dialogue: 0,0:09:48.45,0:09:50.54,Default,Maomao,0,0,0,,{\i1}Niech to się szybko skończy...
Dialogue: 0,0:09:55.75,0:09:57.53,Default,Emperor,0,0,0,,To już ostatnie drzwi.
Dialogue: 0,0:09:58.45,0:10:02.54,Default,Maomao,0,0,0,,{\i1}Do wyboru mamy niebieskie,\Nfioletowe i żółte drzwi.
Dialogue: 0,0:10:03.16,0:10:05.66,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ NIEBIESKIE DRZWI
Dialogue: 0,0:10:03.16,0:10:05.66,Default,Maomao,0,0,0,,{\i1}„Nie przechodź przez niebieskie drzwi”.
Dialogue: 0,0:10:06.44,0:10:10.22,Default,Maomao,0,0,0,,{\i1}Są tu też drugie drzwi\Nwiodące do tego miejsca.
Dialogue: 0,0:10:10.22,0:10:12.96,Default,Maomao,0,0,0,,{\i1}Zgaduję, że biegnie tędy osobna ścieżka.
Dialogue: 0,0:10:12.96,0:10:14.42,Default,Emperor,0,0,0,,Postanowiłem.
Dialogue: 0,0:10:15.19,0:10:16.13,Default,Emperor,0,0,0,,Wybieram żółte.
Dialogue: 0,0:10:18.74,0:10:20.45,Default,Old Eunuch,0,0,0,,Jesteś pewien?
Dialogue: 0,0:10:20.45,0:10:21.26,Default,Emperor,0,0,0,,Proszę.
Dialogue: 0,0:10:24.70,0:10:26.18,Default,Maomao,0,0,0,,{\i1}Ślepy zaułek.
Dialogue: 0,0:10:26.18,0:10:30.19,Default,Text,0,0,0,,{\an8}DZIECKO RODZINY KRÓLEWSKIEJ,\NALE NIE CESARZOWEJ MATKI
Dialogue: 0,0:10:26.84,0:10:30.19,Default,Maomao,0,0,0,,{\i1}„Dziecko rodziny królewskiej,\Nale nie Cesarzowej Matki”?
Dialogue: 0,0:10:30.69,0:10:34.06,Default,Maomao,0,0,0,,{\i1}Pojęcia nie mam, co to znaczy,\Nale chyba to jawne odrzucenie.
Dialogue: 0,0:10:34.06,0:10:36.49,Default,Emperor,0,0,0,,Ten sam wynik co poprzednio.
Dialogue: 0,0:10:41.26,0:10:43.72,Default,Maomao,0,0,0,,{\i1}Czemu jest taki poważny?
Dialogue: 0,0:10:44.08,0:10:47.23,Default,Emperor,0,0,0,,Chyba nie potrafię\Nrozszyfrować woli nieba.
Dialogue: 0,0:10:47.23,0:10:49.49,Default,Old Eunuch,0,0,0,,Nie zgadzam się z tym.
Dialogue: 0,0:10:49.49,0:10:52.96,Default,Old Eunuch,0,0,0,,Kiedy przyłączyłeś ten chram\Ndo wewnętrznego pałacu,
Dialogue: 0,0:10:52.96,0:10:56.70,Default,Old Eunuch,0,0,0,,jestem jedyną osobą\Nzarządzającą tym miejscem.
Dialogue: 0,0:10:56.70,0:10:59.34,Default,Old Eunuch,0,0,0,,Co cennego może być w woli niebios?
Dialogue: 0,0:10:59.66,0:11:03.47,Default,Maomao,0,0,0,,{\i1}Ten stary eunuch musiał\Nzarządzać tym miejscem
Dialogue: 0,0:11:03.93,0:11:06.16,Default,Maomao,0,0,0,,{\i1}na długo przed powstaniem\Nwewnętrznego pałacu.
Dialogue: 0,0:11:06.61,0:11:11.06,Default,Maomao,0,0,0,,{\i1}Zgodził się nawet na\Nkastrację, by móc tu pozostać...
Dialogue: 0,0:11:12.78,0:11:14.94,Default,Old Eunuch,0,0,0,,Wyjście jest tutaj.
Dialogue: 0,0:11:20.02,0:11:25.48,Default,Maomao,0,0,0,,{\i1}Cesarz podążał w każdym kierunku.\NNie wyglądało no to, by popełnił jakikolwiek błąd.
Dialogue: 0,0:11:25.48,0:11:27.99,Default,Maomao,0,0,0,,{\i1}A jednak nie zdołał\Nznaleźć prawidłowej odpowiedzi.
Dialogue: 0,0:11:28.94,0:11:31.62,Default,Maomao,0,0,0,,{\i1}Czy stał za tym jakiś inny zamiar?
Dialogue: 0,0:11:31.62,0:11:35.01,Default,Maomao,0,0,0,,{\i1}Liczba pokoi? Wybrany kolor drzwi?
Dialogue: 0,0:11:35.01,0:11:38.70,Default,Old Eunuch,0,0,0,,Luomen prawdopodobnie by to rozgryzł.
Dialogue: 0,0:11:38.70,0:11:40.70,Default,Maomao,0,0,0,,{\i1}Tatko by to zrobił?
Dialogue: 0,0:11:40.70,0:11:43.20,Default,Maomao,0,0,0,,Sugerujesz, że mój tatko by tego dokonał?
Dialogue: 0,0:11:43.20,0:11:45.47,Default,Old Eunuch,0,0,0,,Cóż, tego nie mogę potwierdzić.
Dialogue: 0,0:11:46.12,0:11:48.68,Default,Maomao,0,0,0,,{\i1}To prawda, że tatko ma niesamowitą wiedzę.
Dialogue: 0,0:11:49.31,0:11:52.85,Default,Maomao,0,0,0,,{\i1}Niemniej mówienie mi, że nie mogę\Ntego zrobić, jest nieco irytujące.
Dialogue: 0,0:11:53.41,0:11:57.71,Default,Maomao,0,0,0,,{\i1}Wiedza tatka jest bardzo\Nobszerna z zakresu medycyny.
Dialogue: 0,0:11:57.71,0:11:59.74,Default,Maomao,0,0,0,,{\i1}Ma to jakiś związek z tą sprawą?
Dialogue: 0,0:12:09.04,0:12:11.88,Default,Maomao,0,0,0,,{\i1}Trzy wejścia, trzy kolory.
Dialogue: 0,0:12:11.08,0:12:16.21,Default,Text,0,0,0,,{\an8}DZIECKO RODZINY KRÓLEWSKIEJ,\NALE NIE CESARZOWEJ MATKI
Dialogue: 0,0:12:12.15,0:12:15.71,Default,Maomao,0,0,0,,{\i1}„Dziecko rodziny królewskiej,\Nale nie Cesarzowej Matki”?
Dialogue: 0,0:12:15.71,0:12:18.76,Default,Maomao,0,0,0,,{\i1}Co to oznacza?
Dialogue: 0,0:12:23.66,0:12:27.64,Default,Emperor,0,0,0,,Wiesz może, co znaczy\N„nie jest dzieckiem Cesarzowej Matki”?
Dialogue: 0,0:12:28.45,0:12:29.51,Default,Maomao,0,0,0,,{\i1}Teraz, gdy o tym myślę,
Dialogue: 0,0:12:29.96,0:12:37.27,Default,Maomao,0,0,0,,{\i1}w historii jest tylko Cesarzowa.\NMatka, a nie ojciec.
Dialogue: 0,0:12:37.27,0:12:38.73,Default,Maomao,0,0,0,,{\i1}Można by zatem uznać,
Dialogue: 0,0:12:38.73,0:12:40.78,Default,Maomao,0,0,0,,{\i1}że przyjmiemy system,\Nktóry ceni matczyną linię krwi,
Dialogue: 0,0:12:40.78,0:12:44.68,Default,Maomao,0,0,0,,{\i1}a jednak nasz kraj opiera się\Nna ojcowskim systemie dziedziczenia.
Dialogue: 0,0:12:44.68,0:12:48.28,Default,Maomao,0,0,0,,{\i1}Zatem jeśli ktoś znalazłby sposób\Nna kontynuowanie linii krwi Cesarzowej Matki...
Dialogue: 0,0:12:48.58,0:12:52.75,Default,Old Eunuch,0,0,0,,{\i1}Wszyscy starsi bracia poprzedniego\Ncesarza zmarli z powodu epidemii.
Dialogue: 0,0:12:53.46,0:12:54.57,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:12:55.02,0:12:56.66,Default,Jinshi,0,0,0,,Zauważyłaś coś?
Dialogue: 0,0:12:57.13,0:13:00.50,Default,Maomao,0,0,0,,Wszystkie dzieci poprzedniego\Ncesarza miały tę samą matkę?
Dialogue: 0,0:13:01.02,0:13:06.65,Default,Emperor,0,0,0,,Nie wszyscy, ale podobno matki,\Nktóre urodziły chłopców, były siostrami.
Dialogue: 0,0:13:06.65,0:13:09.76,Default,Maomao,0,0,0,,Krótko mówiąc,\Nłączyły ich bliskie więzy krwi.
Dialogue: 0,0:13:10.92,0:13:15.37,Default,Maomao,0,0,0,,Może zabrzmi to niegrzecznie,\Nale czy mogę być szczera?
Dialogue: 0,0:13:15.37,0:13:17.10,Default,Emperor,0,0,0,,Zgoda. Kontynuuj.
Dialogue: 0,0:13:18.03,0:13:24.07,Default,Maomao,0,0,0,,Czy poprzedni cesarze\Nmieli problem ze wzrokiem?
Dialogue: 0,0:13:26.11,0:13:29.69,Default,Emperor,0,0,0,,Podobno wielu z nich miało słaby wzrok.
Dialogue: 0,0:13:29.69,0:13:32.33,Default,Emperor,0,0,0,,Jednak poprzedni cesarz miał sokoli wzrok.
Dialogue: 0,0:13:32.33,0:13:33.56,Default,Maomao,0,0,0,,{\i1}Wiedziałam.
Dialogue: 0,0:13:34.17,0:13:37.42,Default,Maomao,0,0,0,,Możemy jeszcze raz\Nprzejść przez świątynię?
Dialogue: 0,0:13:37.88,0:13:41.13,Default,Old Eunuch,0,0,0,,Myślisz, że jesteś tego godna, panienko?
Dialogue: 0,0:13:42.10,0:13:46.30,Default,Old Eunuch,0,0,0,,Poprzednim razem dałem ci szansę,\Nale co za dużo, to niezdrowo.
Dialogue: 0,0:13:46.84,0:13:50.90,Default,Old Eunuch,0,0,0,,Szczególnie jeśli chcesz\Ndecydować o wyborze drzwi.
Dialogue: 0,0:13:50.90,0:13:54.31,Default,Old Eunuch,0,0,0,,Nie jesteś konkubiną\Nani księżniczką, prawda?
Dialogue: 0,0:13:54.67,0:13:56.56,Default,Maomao,0,0,0,,{\i1}Niestety nie, smutek.
Dialogue: 0,0:13:56.56,0:14:00.38,Default,Emperor,0,0,0,,Chyba mogę ją przyjąć jako konkubinę.
Dialogue: 0,0:14:00.38,0:14:03.07,Default,Emperor,0,0,0,,Trudno tylko byłoby przekonać Lakana.
Dialogue: 0,0:14:03.07,0:14:04.97,Default,Maomao,0,0,0,,{\i1}Chyba żartujesz...
Dialogue: 0,0:14:04.97,0:14:08.15,Default,Jinshi,0,0,0,,Chyba żartujesz... Nie wiemy,\Nco pomyślą sobie inne konkubiny!
Dialogue: 0,0:14:09.72,0:14:10.97,Default,Emperor,0,0,0,,Dobra uwaga.
Dialogue: 0,0:14:11.64,0:14:14.36,Default,Emperor,0,0,0,,Więc może ty ją przygarnij.
Dialogue: 0,0:14:15.91,0:14:17.71,Default,Emperor,0,0,0,,Czy tak będzie w porządku?
Dialogue: 0,0:14:17.71,0:14:20.54,Default,Old Eunuch,0,0,0,,Jeśli takie jest twoje życzenie.
Dialogue: 0,0:14:20.99,0:14:22.88,Default,Emperor,0,0,0,,No to do dzieła.
Dialogue: 0,0:14:23.88,0:14:26.26,Default,Maomao,0,0,0,,{\i1}Dowciapny bardziej niż zwykle.
Dialogue: 0,0:14:27.98,0:14:31.32,Default,Maomao,0,0,0,,Na początek niebieskie,\Nczerwone i zielone drzwi.
Dialogue: 0,0:14:31.64,0:14:34.39,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ CZERWONE DRZWI
Dialogue: 0,0:14:32.09,0:14:34.39,Default,Maomao,0,0,0,,{\i1}„Nie przechodź przez czerwone drzwi”.
Dialogue: 0,0:14:34.74,0:14:36.13,Default,Jinshi,0,0,0,,Które byś wybrała?
Dialogue: 0,0:14:36.13,0:14:36.89,Default,Maomao,0,0,0,,Niebieskie.
Dialogue: 0,0:14:37.47,0:14:40.46,Default,Maomao,0,0,0,,{\i1}To samo co cesarz,\Nprzynajmniej na razie.
Dialogue: 0,0:14:42.27,0:14:45.81,Default,Jinshi,0,0,0,,Następnie zielone,\Nbrązowe i jasnoniebieskie.
Dialogue: 0,0:14:45.28,0:14:47.78,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ BRĄZOWE DRZWI
Dialogue: 0,0:14:45.81,0:14:47.40,Default,Jinshi,0,0,0,,„Nie przechodź przez brązowe drzwi”.
Dialogue: 0,0:14:48.35,0:14:49.65,Default,Maomao,0,0,0,,Jasnoniebieskie drzwi.
Dialogue: 0,0:14:51.63,0:14:55.29,Default,Emperor,0,0,0,,To nie te, które wybrałem.
Dialogue: 0,0:14:56.42,0:14:59.23,Default,Maomao,0,0,0,,{\i1}Nie potrafię określić,\Nkiedy przez to przechodziłam.
Dialogue: 0,0:14:59.23,0:15:02.04,Default,Maomao,0,0,0,,{\i1}Jeśli istnieją drzwi, które mogą\Nwybrać tylko dzieci Cesarzowej Matki...
Dialogue: 0,0:15:03.69,0:15:07.02,Default,Maomao,0,0,0,,{\i1}Kluczem będą kolory drzwi.
Dialogue: 0,0:15:09.87,0:15:14.55,Default,Maomao,0,0,0,,{\i1}To dziesiąte. Białe,\Nfioletowe i zielone drzwi...
Dialogue: 0,0:15:14.55,0:15:17.93,Default,Text,0,0,0,,{\an8}WYBIERZ CZERWONE DRZWI
Dialogue: 0,0:15:15.24,0:15:17.55,Default,Maomao,0,0,0,,„Wybierz czerwone drzwi”.
Dialogue: 0,0:15:19.15,0:15:22.40,Default,Jinshi,0,0,0,,Nie ma czerwonych. Co to oznacza?
Dialogue: 0,0:15:22.83,0:15:24.40,Default,Maomao,0,0,0,,Zielone drzwi.
Dialogue: 0,0:15:25.25,0:15:26.19,Default,Jinshi,0,0,0,,Zielone?
Dialogue: 0,0:15:27.54,0:15:28.82,Default,Maomao,0,0,0,,Przekonasz się, kiedy przejdziemy.
Dialogue: 0,0:15:32.32,0:15:33.46,Default,Jinshi,0,0,0,,To jest...
Dialogue: 0,0:15:39.53,0:15:43.83,Default,Old Eunuch,0,0,0,,Gratulacje. Obrałeś właściwą ścieżkę.
Dialogue: 0,0:15:44.79,0:15:49.78,Default,Old Eunuch,0,0,0,,W przeszłości ten, którego wybrała Cesarzowa\NMatka, stawał się następnym władcą.
Dialogue: 0,0:15:49.78,0:15:54.78,Default,Old Eunuch,0,0,0,,Stał w tym miejscu i zwiastował ludziom.
Dialogue: 0,0:15:54.78,0:15:58.53,Default,Old Eunuch,0,0,0,,Gdy nikt nie potrafił\Nwybrać właściwej ścieżki,
Dialogue: 0,0:15:58.53,0:16:04.85,Default,Old Eunuch,0,0,0,,odwiedzał ten chram z konkubiną,\Nktóra potrafiła to zrobić.
Dialogue: 0,0:16:04.85,0:16:09.94,Default,Old Eunuch,0,0,0,,W dawnych czasach robili to ci,\Nktórzy mieli odpowiednie predyspozycje.
Dialogue: 0,0:16:09.94,0:16:14.41,Default,Old Eunuch,0,0,0,,Jednak tym razem ktoś inny\Nwskazał właściwą odpowiedź.
Dialogue: 0,0:16:14.89,0:16:18.49,Default,Maomao,0,0,0,,{\i1}Ej, sprowokowałeś mnie.\NCo jest z tym staruchem?
Dialogue: 0,0:16:18.74,0:16:24.12,Default,Emperor,0,0,0,,Co ważniejsze, możesz to\Nwyjaśnić, bym to zrozumiał?
Dialogue: 0,0:16:24.12,0:16:28.13,Default,Old Eunuch,0,0,0,,Może powinieneś zapytać tę dziewczynę.
Dialogue: 0,0:16:28.91,0:16:32.42,Default,Maomao,0,0,0,,{\i1}A teraz jeszcze ten staruch\Nnajtrudniejszą robotę zrzuca na mnie?!
Dialogue: 0,0:16:32.72,0:16:33.80,Default,Emperor,0,0,0,,Słyszałaś go.
Dialogue: 0,0:16:37.52,0:16:39.28,Default,Maomao,0,0,0,,W legendzie o powstaniu
Dialogue: 0,0:16:39.28,0:16:44.03,Default,Maomao,0,0,0,,mówi się, że Cesarzowa Matka ma oczy,\Nktóre widzą w ciemnościach.
Dialogue: 0,0:16:44.46,0:16:47.07,Default,Maomao,0,0,0,,Oznacza to, że ci, którzy zostali\Nwybrani przez ten chram,
Dialogue: 0,0:16:47.07,0:16:48.69,Default,Maomao,0,0,0,,posiadają krew Cesarzowej Matki
Dialogue: 0,0:16:49.07,0:16:52.44,Default,Maomao,0,0,0,,i nie potrafią rozróżniać kolorów.
Dialogue: 0,0:16:52.86,0:16:54.41,Default,Jinshi,0,0,0,,Rozróżniać kolorów?
Dialogue: 0,0:16:54.91,0:16:56.11,Default,Emperor,0,0,0,,Co to znaczy?
Dialogue: 0,0:16:56.66,0:17:01.24,Default,Maomao,0,0,0,,Wyjaśnię, jak wybrałam wcześniejsze drzwi.
Dialogue: 0,0:17:01.68,0:17:04.75,Default,Maomao,0,0,0,,Najpierw były trzy wejścia:\Nniebieskie, czerwone i zielone,
Dialogue: 0,0:17:04.75,0:17:07.75,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ CZERWONA DRZWI
Dialogue: 0,0:17:05.31,0:17:07.75,Default,Maomao,0,0,0,,z napisem „Nie przechodź przez czerwone drzwi”.
Dialogue: 0,0:17:08.19,0:17:11.48,Default,Maomao,0,0,0,,Niebieskie i zielone powinny być prawidłowe,
Dialogue: 0,0:17:11.48,0:17:14.83,Default,Maomao,0,0,0,,ale dziecię Cesarzowej Matki\Nwybrałoby niebieskie.
Dialogue: 0,0:17:14.83,0:17:18.38,Default,Maomao,0,0,0,,Dlatego, że nie byłyby w stanie\Nodróżnić koloru czerwonego od zielonego,
Dialogue: 0,0:17:18.38,0:17:21.01,Default,Maomao,0,0,0,,wybraliby drzwi, które\Nna pewno nie są czerwone.
Dialogue: 0,0:17:21.48,0:17:24.66,Default,Emperor,0,0,0,,Brak odróżnienia czerwonego od zielonego...
Dialogue: 0,0:17:24.66,0:17:27.71,Default,Maomao,0,0,0,,To rzadkość w naszym kraju,\Nale w regionie zachodnim
Dialogue: 0,0:17:27.71,0:17:33.03,Default,Maomao,0,0,0,,mówi się, że jeden na dziesięciu\Nmężczyzn jest daltonistą.
Dialogue: 0,0:17:33.03,0:17:35.40,Default,Old Eunuch,0,0,0,,{\i1}Luomen prawdopodobnie by to rozgryzł.
Dialogue: 0,0:17:35.90,0:17:40.16,Default,Maomao,0,0,0,,{\i1}Ponieważ tatko studiował\Nza granicą, to wiedziałby o tym.
Dialogue: 0,0:17:40.76,0:17:43.04,Default,Maomao,0,0,0,,{\i1}A więc to miał na myśli.
Dialogue: 0,0:17:43.49,0:17:45.00,Default,Maomao,0,0,0,,To samo dotyczy kolejnych drzwi.
Dialogue: 0,0:17:45.00,0:17:47.33,Default,Text,0,0,0,,{\an8}NIE PRZECHODŹ PRZEZ BRĄZOWE DRZWI
Dialogue: 0,0:17:45.48,0:17:47.33,Default,Maomao,0,0,0,,Polecenie nakazywało unikać koloru brązowego.
Dialogue: 0,0:17:47.87,0:17:50.38,Default,Maomao,0,0,0,,Gdyby brązowy i zielony\Nwyglądały tak samo,
Dialogue: 0,0:17:50.38,0:17:52.84,Default,Maomao,0,0,0,,w procesie eliminacji wybraliby jasnoniebieski.
Dialogue: 0,0:17:53.24,0:17:58.92,Default,Maomao,0,0,0,,Przy ostatnich drzwiach widniał napis\N„wybierz czerwone”, ale nie było takich.
Dialogue: 0,0:17:54.51,0:17:56.88,Default,Text,0,0,0,,{\an8}WYBIERZ CZERWONE DRZWI
Dialogue: 0,0:17:59.43,0:18:04.74,Default,Maomao,0,0,0,,Gdyby jednak zobaczyli białe i fioletowe drzwi,
Dialogue: 0,0:18:04.74,0:18:07.39,Default,Maomao,0,0,0,,osoba ta założyłaby,\Nże ostatnie drzwi muszą być czerwone.
Dialogue: 0,0:18:07.87,0:18:11.11,Default,Maomao,0,0,0,,Innymi słowy, choć pozornie\Nistniały dwie prawidłowe opcje,
Dialogue: 0,0:18:11.61,0:18:15.00,Default,Maomao,0,0,0,,to odpowiedź była tylko jedna.
Dialogue: 0,0:18:15.36,0:18:21.60,Default,Emperor,0,0,0,,Gdyby każdy cesarz posiadał taką\Ncechę, wiedzielibyśmy o tym, prawda?
Dialogue: 0,0:18:21.60,0:18:25.93,Default,Maomao,0,0,0,,Słyszałam od mojego tatka,\Nże chociaż nie potrafią rozróżnić kolorów,
Dialogue: 0,0:18:25.93,0:18:28.64,Default,Maomao,0,0,0,,kiedy już do tego przywykną,\Nżyją jakby nigdy nic.
Dialogue: 0,0:18:28.64,0:18:31.38,Default,Maomao,0,0,0,,W rzeczywistości innym\Njest to trudniej dostrzec.
Dialogue: 0,0:18:31.74,0:18:34.59,Default,Maomao,0,0,0,,Co więcej, twierdzi się,\Nże w zamian za tę wadę
Dialogue: 0,0:18:34.59,0:18:36.84,Default,Maomao,0,0,0,,osoby te lepiej widzą w ciemności.
Dialogue: 0,0:18:36.84,0:18:40.63,Default,Maomao,0,0,0,,Być może właśnie to stało się\Npóźniej legendą o wzroku Cesarzowej Matki.
Dialogue: 0,0:18:41.07,0:18:46.57,Default,Jinshi,0,0,0,,Więc tylko ci, którzy mieli takie same\Nzdolności jak Cesarzowa Matka, mogli to przejść.
Dialogue: 0,0:18:46.57,0:18:50.76,Default,Maomao,0,0,0,,Niektórzy pewnie przebrnęli\Nprzez to przypadkiem.
Dialogue: 0,0:18:50.76,0:18:54.61,Default,Maomao,0,0,0,,Jednak szansa na dotarcie\Ndo ostatniego pokoju jest bardzo niska.
Dialogue: 0,0:18:55.71,0:19:00.55,Default,Maomao,0,0,0,,W tej historii mówi się, że Cesarzowa\NMatka przybyła z odległej krainy.
Dialogue: 0,0:19:01.59,0:19:05.71,Default,Maomao,0,0,0,,Cechowała ją niezdolność\Ndo rozróżniania niektórych kolorów.
Dialogue: 0,0:19:05.71,0:19:09.87,Default,Maomao,0,0,0,,Przybyła tu z zachodu z liczną służbą.
Dialogue: 0,0:19:10.18,0:19:14.16,Default,Maomao,0,0,0,,Przeprowadzka do nowego\Nkraju nigdy nie jest łatwa.
Dialogue: 0,0:19:14.16,0:19:18.09,Default,Maomao,0,0,0,,Dlatego poślubiła władcę tej ziemi.
Dialogue: 0,0:19:18.37,0:19:22.93,Default,Jinshi,0,0,0,,Czekaj, zielareczko. Legenda głosi,\Nże Cesarzowa Matka nigdy nie miała męża.
Dialogue: 0,0:19:22.93,0:19:25.93,Default,Maomao,0,0,0,,To była mądra decyzja\NCesarzowej Matki i jej rodziny.
Dialogue: 0,0:19:26.77,0:19:28.64,Default,Maomao,0,0,0,,Często zdarza się brać\Nżonę z odległego kraju,
Dialogue: 0,0:19:28.64,0:19:32.19,Default,Maomao,0,0,0,,by zapobiec nadmiernemu\Nzagęszczeniu linii krwi.
Dialogue: 0,0:19:32.67,0:19:34.30,Default,Maomao,0,0,0,,Mimo że Cesarzowa Matka jest pierworodną,
Dialogue: 0,0:19:34.30,0:19:37.09,Default,Maomao,0,0,0,,tron obejmuje się po ojcu.
Dialogue: 0,0:19:37.09,0:19:40.86,Default,Maomao,0,0,0,,Zapewne zostało to ustalone w celu\Noddania czci pierwszemu władcy tych ziem.
Dialogue: 0,0:19:41.35,0:19:48.41,Default,Maomao,0,0,0,,Jednakże rodzina Cesarzowej Matki\Nnie chciała, by ich ród zniknął.
Dialogue: 0,0:19:48.91,0:19:52.46,Default,Maomao,0,0,0,,Jak zapewnić, by podtrzymana\Nzostała linia krwi Cesarzowej Matki?
Dialogue: 0,0:19:52.46,0:19:55.21,Default,Maomao,0,0,0,,Tu właśnie pojawił się Chram Wyboru.
Dialogue: 0,0:19:56.19,0:19:59.02,Default,Maomao,0,0,0,,{\i1}Jeśli żaden spadkobierca nie był daltonistą,
Dialogue: 0,0:19:59.02,0:20:03.72,Default,Maomao,0,0,0,,{\i1}przyprowadzana jest konkubina z pokrewnego\Nrodu, by towarzyszyła mu w chramie.
Dialogue: 0,0:20:04.61,0:20:08.41,Default,Maomao,0,0,0,,{\i1}Z tego powodu dodano zasadę\Npozwalającą konkubinom na wejście.
Dialogue: 0,0:20:08.41,0:20:12.60,Default,Maomao,0,0,0,,{\i1}W ten sposób stopniowo\Nprzenikali do środka kraju.
Dialogue: 0,0:20:13.16,0:20:16.48,Default,Maomao,0,0,0,,{\i1}Na tyle głęboko, że pierwotny\Nwładca został wyparty z historii,
Dialogue: 0,0:20:16.48,0:20:18.47,Default,Maomao,0,0,0,,{\i1}a Cesarzowa Matka stała się jej bohaterką.
Dialogue: 0,0:20:18.96,0:20:24.35,Default,Maomao,0,0,0,,{\i1}Gdy nikt nie dysponuje faktyczną\Nwersją, historia staje się prawdą.
Dialogue: 0,0:20:24.35,0:20:28.74,Default,Maomao,0,0,0,,{\i1}To było bardzo pokojowe,\Numyślne przejęcie.
Dialogue: 0,0:20:28.74,0:20:31.86,Default,Maomao,0,0,0,,{\i1}Choć na głos tego nie powiem.
Dialogue: 0,0:20:31.86,0:20:36.00,Default,Emperor,0,0,0,,Chcesz powiedzieć, że nie ma\Nwe mnie krwi Cesarzowej Matki?
Dialogue: 0,0:20:36.41,0:20:40.80,Default,Maomao,0,0,0,,Ten chram jest najlepszą metodą,\Naby się tego dowiedzieć.
Dialogue: 0,0:20:40.80,0:20:45.17,Default,Maomao,0,0,0,,Niekiedy cecha ta nie przechodzi\Nz rodzica na dziecko.
Dialogue: 0,0:20:45.17,0:20:49.08,Default,Maomao,0,0,0,,Również zbyt mocne linie krwi\Nmogą powodować problemy.
Dialogue: 0,0:20:49.08,0:20:53.85,Default,Maomao,0,0,0,,Możliwe, że z tego powodu rodzeństwo\Npoprzedniego cesarza zachorowało podczas epidemii.
Dialogue: 0,0:20:54.98,0:21:00.83,Default,Old Eunuch,0,0,0,,Nie sądziłem, że ta mała\Ndziecinka to rozgryzie.
Dialogue: 0,0:21:00.83,0:21:02.14,Default,Maomao,0,0,0,,{\i1}Mała dziecinka?
Dialogue: 0,0:21:02.14,0:21:04.66,Default,Old Eunuch,0,0,0,,Mówi się, że Cesarzowa Matka
Dialogue: 0,0:21:04.66,0:21:08.84,Default,Old Eunuch,0,0,0,,rządziła tą ziemią,\Nbo posiadała niezwykły intelekt.
Dialogue: 0,0:21:08.84,0:21:14.46,Default,Old Eunuch,0,0,0,,Jeśli chcesz przerzedzić linię krwi,\Nto czemu nie dodasz do niej jej?
Dialogue: 0,0:21:14.77,0:21:15.46,Default,Maomao,0,0,0,,{\i1}Co?
Dialogue: 0,0:21:16.61,0:21:19.20,Default,Maomao,0,0,0,,{\i1}O czym ten staruch bredzi?
Dialogue: 0,0:21:19.20,0:21:23.40,Default,Emperor,0,0,0,,To byłoby interesujące,\Nale nie chcę rozzłościć Lakana.
Dialogue: 0,0:21:23.40,0:21:27.42,Default,Emperor,0,0,0,,Co więcej, brakuje jej co najmniej\Nz 15 centymetrów tu i tam.
Dialogue: 0,0:21:27.42,0:21:28.80,Default,Maomao,0,0,0,,Mniejsza z tym.
Dialogue: 0,0:21:29.29,0:21:31.26,Default,Old Eunuch,0,0,0,,Zachowaj jednak ostrożność.
Dialogue: 0,0:21:31.26,0:21:35.95,Default,Old Eunuch,0,0,0,,Jest wiele osób, które nie popierają\Nwprowadzenia świeżej krwi.
Dialogue: 0,0:21:35.95,0:21:37.48,Default,Emperor,0,0,0,,Wiem o tym.
Dialogue: 0,0:21:37.48,0:21:41.14,Default,Old Eunuch,0,0,0,,Tego jestem pewien, Wasza Wysokość.
Dialogue: 0,0:21:41.80,0:21:43.91,Default,Old Eunuch,0,0,0,,Bądź ostrożny.
Dialogue: 0,0:21:46.14,0:21:47.34,Default,Jinshi,0,0,0,,Wiem.
Dialogue: 0,0:21:57.87,0:22:00.04,Default,Maomao,0,0,0,,{\i1}Kim on naprawdę jest?
Dialogue: 0,0:22:00.81,0:22:06.08,Default,Maomao,0,0,0,,{\i1}Tylko „ulubiony eunuch cesarza”?\NTo się nie trzyma kupy...
Dialogue: 0,0:22:08.89,0:22:10.39,Default,Maomao,0,0,0,,{\i1}Kogo to obchodzi?
Dialogue: 0,0:22:10.91,0:22:14.44,Default,Maomao,0,0,0,,{\i1}Czasem niewiedza jest zbawienna.\NTak właśnie jest.
Dialogue: 0,0:23:45.07,0:23:47.07,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.35,0:24:00.00,Default,Narrator,0,0,0,,{\an8}ODCINEK: 32: CESARZOWA WDOWA
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
