Dialogue: 0,0:00:04.56,0:00:08.28,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:34.07,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:35.40,0:01:39.41,Default,Text,0,0,0,,{\an8}ODCINEK 11: DWA W JEDNYM
Dialogue: 0,0:01:44.52,0:01:46.33,Default,Fengming,0,0,0,,List od konkubiny Gyokuyou?
Dialogue: 0,0:01:46.64,0:01:49.45,Default,Maomao,0,0,0,,Tak. Kazano mi osobiście go doręczyć.
Dialogue: 0,0:01:49.53,0:01:52.65,Default,Fengming,0,0,0,,Pani A Duo jest na przyjęciu herbacianym.
Dialogue: 0,0:01:56.34,0:01:59.68,Default,Maomao,0,0,0,,Jest coś, o czym chciałam z tobą\Nporozmawiać, pani Fengming.
Dialogue: 0,0:02:00.50,0:02:01.78,Default,Fengming,0,0,0,,Rozumiem.
Dialogue: 0,0:02:11.36,0:02:15.23,Default,Maomao,0,0,0,,{\i1}Bagaże spakowane.\NCzyli jest tak jak myślałam…
Dialogue: 0,0:02:15.52,0:02:16.65,Default,Fengming,0,0,0,,Proszę.
Dialogue: 0,0:02:22.53,0:02:25.74,Default,Fengming,0,0,0,,Więc co cię dziś tu sprowadza?
Dialogue: 0,0:02:25.82,0:02:28.09,Default,Fengming,0,0,0,,Skończyliśmy już sprzątać.
Dialogue: 0,0:02:28.17,0:02:30.00,Default,Maomao,0,0,0,,Kiedy się wyprowadzasz?
Dialogue: 0,0:02:32.93,0:02:34.71,Default,Fengming,0,0,0,,Bystra jesteś.
Dialogue: 0,0:02:35.07,0:02:37.75,Default,Maomao,0,0,0,,Sprzątanie było wymówką.
Dialogue: 0,0:02:38.22,0:02:42.73,Default,Maomao,0,0,0,,Wraz z nadejściem nowego roku wprowadzi\Nsię tu nowa konkubina wysokiej rangi,
Dialogue: 0,0:02:42.81,0:02:46.06,Default,Maomao,0,0,0,,konkubina A Duo musi opuścić ten pałac.
Dialogue: 0,0:02:47.86,0:02:50.77,Default,Maomao,0,0,0,,Konkubina A Duo nie może\Nmieć już więcej dzieci, prawda?
Dialogue: 0,0:02:53.08,0:02:55.53,Default,Maomao,0,0,0,,Co się wydarzyło podczas porodu?
Dialogue: 0,0:02:55.61,0:02:58.94,Default,Fengming,0,0,0,,To raczej nie jest twój interes.
Dialogue: 0,0:02:59.99,0:03:01.91,Default,Maomao,0,0,0,,A właśnie, że jest.
Dialogue: 0,0:03:04.27,0:03:07.79,Default,Maomao,0,0,0,,Lekarzem, który przyjmował poród,\Nbył mój ojciec.
Dialogue: 0,0:03:10.04,0:03:12.62,Default,Maomao,0,0,0,,Zgaduję, że pech polegał\Nna tym, iż konkubina A Duo,
Dialogue: 0,0:03:12.70,0:03:14.25,Default,Maomao,0,0,0,,ówczesna konkubina księcia,
Dialogue: 0,0:03:14.33,0:03:18.05,Default,Maomao,0,0,0,,urodziła w tym samym\Nczasie co Cesarzowa Wdowa.
Dialogue: 0,0:03:27.22,0:03:29.23,Default,Fengming,0,0,0,,Kiedy wróci doktor?!
Dialogue: 0,0:03:29.31,0:03:30.92,Default,Lady-in-Waiting,0,0,0,,Wciąż jest u cesarzowej.
Dialogue: 0,0:03:31.00,0:03:32.06,Default,Fengming,0,0,0,,Pani A Duo!
Dialogue: 0,0:03:32.14,0:03:35.61,Default,Fengming,0,0,0,,Pani A Duo, będzie dobrze!\NJestem przy tobie!
Dialogue: 0,0:03:35.69,0:03:38.08,Default,Maomao,0,0,0,,Cesarzowa Wdowa była ważniejsza
Dialogue: 0,0:03:38.16,0:03:40.95,Default,Maomao,0,0,0,,i poród konkubiny A Duo musiał zaczekać.
Dialogue: 0,0:03:47.63,0:03:48.83,Default,Fengming,0,0,0,,Pani A Duo.
Dialogue: 0,0:03:49.86,0:03:53.71,Default,Maomao,0,0,0,,Wtedy właśnie\Nkonkubina A Duo straciła macicę.
Dialogue: 0,0:03:54.87,0:04:00.09,Default,Maomao,0,0,0,,Niedługo potem dziecko,\Nktóre urodziła, zmarło.
Dialogue: 0,0:04:01.38,0:04:05.00,Default,Maomao,0,0,0,,Pani Fengming, winisz się za to?
Dialogue: 0,0:04:05.47,0:04:12.56,Default,Maomao,0,0,0,,To ty musiałaś opiekować się\Ndzieckiem, zamiast konkubiny A Duo.
Dialogue: 0,0:04:15.19,0:04:17.43,Default,Fengming,0,0,0,,Rozgryzłaś wszystko,
Dialogue: 0,0:04:17.88,0:04:21.57,Default,Fengming,0,0,0,,mimo że jesteś córką zwykłego znachora,\Nktóry nie pomógł pani A Duo.
Dialogue: 0,0:04:23.86,0:04:25.20,Default,Maomao,0,0,0,,Masz rację.
Dialogue: 0,0:04:25.28,0:04:26.28,Default,Text,0,0,0,,{\an8}LUOMEN, WYRZUCONY
Dialogue: 0,0:04:28.03,0:04:30.56,Default,Maomao,0,0,0,,Mówią, że ówczesną\Nprzyczyną śmierci dziecka
Dialogue: 0,0:04:30.64,0:04:33.54,Default,Maomao,0,0,0,,był ten sam trujący puder co i teraz.
Dialogue: 0,0:04:34.56,0:04:36.13,Default,Maomao,0,0,0,,Ale to nie jest prawda, co?
Dialogue: 0,0:04:38.00,0:04:42.84,Default,Maomao,0,0,0,,Ten znachor na pewno\Nzakazałby używania tego pudru.
Dialogue: 0,0:04:43.15,0:04:47.68,Default,Maomao,0,0,0,,Jesteś mądrą kobietą. Nie dopuściłabyś\Ndo śmierci dziecka z tego powodu.
Dialogue: 0,0:04:47.76,0:04:51.40,Default,Maomao,0,0,0,,Prawdziwą przyczyną śmierci było to.
Dialogue: 0,0:04:52.72,0:04:56.08,Default,Maomao,0,0,0,,Są kwiaty zawierające truciznę,
Dialogue: 0,0:04:56.16,0:04:58.72,Default,Maomao,0,0,0,,takie jak tojad czy azalia.
Dialogue: 0,0:04:58.80,0:05:01.11,Default,Maomao,0,0,0,,Ponadto ich nektar może być trujący.
Dialogue: 0,0:05:02.05,0:05:03.53,Default,Fengming,0,0,0,,Wiem o tym.
Dialogue: 0,0:05:03.61,0:05:05.35,Default,Maomao,0,0,0,,Ale w tamtym czasie…
Dialogue: 0,0:05:06.08,0:05:07.32,Default,Maomao,0,0,0,,nie wiedziałaś.
Dialogue: 0,0:05:07.61,0:05:10.33,Default,Maomao,0,0,0,,Nie zdawałaś sobie sprawy,\Nże zwykły miód,
Dialogue: 0,0:05:10.80,0:05:13.66,Default,Maomao,0,0,0,,lekarstwo, które uważałaś\Nza dobre dla zdrowia,
Dialogue: 0,0:05:14.68,0:05:16.79,Default,Maomao,0,0,0,,może być śmiertelne dla noworodka.
Dialogue: 0,0:05:21.08,0:05:23.48,Default,Ah-Duo,0,0,0,,Dziękuję za pomoc,\Njak zawsze, Fengming.
Dialogue: 0,0:05:23.56,0:05:26.64,Default,Fengming,0,0,0,,To żaden kłopot, pani A Duo.
Dialogue: 0,0:05:26.72,0:05:28.80,Default,Fengming,0,0,0,,Odpoczywaj i wracaj szybko do zdrowia.
Dialogue: 0,0:05:33.27,0:05:36.46,Default,Maomao,0,0,0,,I tym sposobem dziecko\Nkonkubiny A Duo zmarło.
Dialogue: 0,0:05:38.53,0:05:40.73,Default,Maomao,0,0,0,,Przyczyna została utajniona.
Dialogue: 0,0:05:40.81,0:05:43.72,Default,Maomao,0,0,0,,Mój przybrany ojciec,\NLuomen, ówczesny lekarz,
Dialogue: 0,0:05:43.80,0:05:47.72,Default,Maomao,0,0,0,,obwiniono go za błędy przy porodzie\Ni późniejszej opiece nad chorą.
Dialogue: 0,0:05:47.80,0:05:49.74,Default,Maomao,0,0,0,,Został wyrzucony z pałacu.
Dialogue: 0,0:05:50.45,0:05:55.83,Default,Maomao,0,0,0,,Dopiero później przypadkiem poznałaś\Nprawdziwą przyczynę śmierci dziecka.
Dialogue: 0,0:05:57.51,0:06:02.04,Default,Maomao,0,0,0,,Ktoś powiedział ci, że miód może\Nbyć trujący dla niemowląt, prawda?
Dialogue: 0,0:06:04.17,0:06:07.13,Default,Maomao,0,0,0,,Musiałaś się upewnić,\Nże konkubina A Duo się o tym nie dowie.
Dialogue: 0,0:06:07.18,0:06:10.30,Default,Maomao,0,0,0,,Przecież nie mogła dowiedzieć się,\Nże to ty zabiłaś jej dziecko.
Dialogue: 0,0:06:11.28,0:06:14.31,Default,Maomao,0,0,0,,Dlatego chciałaś ją wyeliminować.
Dialogue: 0,0:06:15.01,0:06:16.56,Default,Maomao,0,0,0,,Tą osobą jest…
Dialogue: 0,0:06:18.72,0:06:20.14,Default,Maomao,0,0,0,,Konkubina Li Shu.
Dialogue: 0,0:06:22.28,0:06:23.74,Default,Maomao,0,0,0,,Za poprzedniego cesarza,
Dialogue: 0,0:06:23.82,0:06:27.90,Default,Maomao,0,0,0,,konkubina Li Shu\Nbyła bardzo blisko z konkubiną A Duo.
Dialogue: 0,0:06:28.32,0:06:31.07,Default,Maomao,0,0,0,,I była to obustronna relacja.
Dialogue: 0,0:06:31.63,0:06:34.33,Default,Maomao,0,0,0,,Młoda dziewczynka odebrana rodzicom
Dialogue: 0,0:06:34.92,0:06:37.78,Default,Maomao,0,0,0,,i kobieta, która nie mogła\Njuż mieć więcej dzieci.
Dialogue: 0,0:06:38.96,0:06:41.93,Default,Maomao,0,0,0,,Te sytuacje sprawiły, że obie\Npotrzebowały siebie nawzajem.
Dialogue: 0,0:06:42.58,0:06:44.91,Default,Maomao,0,0,0,,Wtedy dowiedziałaś się\Nod konkubiny Li Shu,
Dialogue: 0,0:06:44.99,0:06:48.09,Default,Maomao,0,0,0,,że prawie umarła,\Nspożywając miód w dzieciństwie.
Dialogue: 0,0:06:49.92,0:06:52.50,Default,Maomao,0,0,0,,Aby konkubina A Duo\Nnigdy nie usłyszała tej historii,
Dialogue: 0,0:06:52.50,0:06:55.51,Default,Maomao,0,0,0,,postanowiłaś przepędzić konkubinę\NLi Shu z Granatowego Pałacu.
Dialogue: 0,0:06:56.48,0:06:59.32,Default,Maomao,0,0,0,,Niebawem zmarł poprzedni cesarz,
Dialogue: 0,0:06:59.40,0:07:03.65,Default,Maomao,0,0,0,,a konkubina Li Shu musiała opuścić\Nwewnętrzny pałac, nie wiedząc dlaczego.
Dialogue: 0,0:07:06.11,0:07:09.15,Default,Maomao,0,0,0,,Wtedy właśnie ci ulżyło.
Dialogue: 0,0:07:09.23,0:07:12.82,Default,Maomao,0,0,0,,Lecz konkubina Li Shu, której myślałaś,\Nże już nigdy więcej nie ujrzysz,
Dialogue: 0,0:07:13.26,0:07:15.08,Default,Maomao,0,0,0,,wróciła do wewnętrznego pałacu.
Dialogue: 0,0:07:16.33,0:07:18.44,Default,Maomao,0,0,0,,Jako konkubina wysokiej rangi
Dialogue: 0,0:07:18.52,0:07:21.06,Default,Maomao,0,0,0,,stała się zagrożeniem\Ndla konkubiny A Duo.
Dialogue: 0,0:07:22.08,0:07:26.04,Default,Maomao,0,0,0,,Ta bezczelna dziewucha wielokrotnie\Npróbowała odwiedzać konkubinę A Duo,
Dialogue: 0,0:07:26.12,0:07:28.38,Default,Maomao,0,0,0,,jakby odwiedzała własną matkę.
Dialogue: 0,0:07:29.78,0:07:32.75,Default,Maomao,0,0,0,,By chronić bezdzietną konkubinę A Duo,
Dialogue: 0,0:07:32.83,0:07:35.85,Default,Maomao,0,0,0,,i by ukryć sprawę z miodem…
Dialogue: 0,0:07:36.32,0:07:39.89,Default,Maomao,0,0,0,,Dodałaś truciznę\Ndo zupy konkubiny Li Shu.
Dialogue: 0,0:07:43.84,0:07:45.61,Default,Fengming,0,0,0,,Czego chcesz?
Dialogue: 0,0:07:46.32,0:07:47.94,Default,Maomao,0,0,0,,Niczego.
Dialogue: 0,0:07:50.16,0:07:51.98,Default,Fengming,0,0,0,,Proś, o co chcesz.
Dialogue: 0,0:07:59.11,0:08:02.66,Default,Maomao,0,0,0,,Powinnaś wiedzieć, że to bez sensu.
Dialogue: 0,0:08:21.98,0:08:28.69,Default,Fengming,0,0,0,,Wiesz, co jest najlepsze dla osoby,\Nktóra jest dla ciebie całym światem?
Dialogue: 0,0:08:31.07,0:08:33.92,Default,Fengming,0,0,0,,Kiedy poznałam panią A Duo,
Dialogue: 0,0:08:34.00,0:08:37.66,Default,Fengming,0,0,0,,od razu wiedziałam, że nikomu\Ninnemu nie chcę już służyć.
Dialogue: 0,0:08:38.21,0:08:39.58,Default,Fengming,0,0,0,,Chociaż była kobietą,
Dialogue: 0,0:08:39.66,0:08:43.37,Default,Fengming,0,0,0,,miała silną wolę i potrafiła rozmawiać\Nz księciem bez żadnych ograniczeń.
Dialogue: 0,0:08:44.28,0:08:47.13,Default,Fengming,0,0,0,,Darzę panią A Duo ogromnym szacunkiem.
Dialogue: 0,0:08:47.58,0:08:52.20,Default,Fengming,0,0,0,,Dla dziewczyny zawsze posłusznej rodzicom,\Nktóra dla nich została dwórką,
Dialogue: 0,0:08:52.28,0:08:54.84,Default,Fengming,0,0,0,,była tak niesamowitą osobą.
Dialogue: 0,0:08:56.29,0:08:57.74,Default,Fengming,0,0,0,,Mimo to…
Dialogue: 0,0:08:58.82,0:09:03.11,Default,Fengming,0,0,0,,Własnymi rękami odebrałam to,\Nco było dla niej najcenniejsze…
Dialogue: 0,0:09:03.68,0:09:05.55,Default,Fengming,0,0,0,,Odebrałam jej go!
Dialogue: 0,0:09:05.63,0:09:09.02,Default,Fengming,0,0,0,,Dziecko, które było jej oczkiem w głowie!
Dialogue: 0,0:09:10.23,0:09:11.48,Default,Fengming,0,0,0,,Tymi rękami!
Dialogue: 0,0:09:12.15,0:09:13.27,Default,Fengming,0,0,0,,Ale wtedy…
Dialogue: 0,0:09:14.13,0:09:16.45,Default,Fengming,0,0,0,,Pani A Duo powiedziała…
Dialogue: 0,0:09:17.01,0:09:19.35,Default,Ah-Duo,0,0,0,,Nie obwiniajcie się za to.
Dialogue: 0,0:09:19.72,0:09:22.66,Default,Ah-Duo,0,0,0,,Do siódmego roku życia\Nlosy dzieci nie są pewne.
Dialogue: 0,0:09:23.06,0:09:26.12,Default,Ah-Duo,0,0,0,,Byle przeziębienie może je zabić.
Dialogue: 0,0:09:26.56,0:09:30.31,Default,Ah-Duo,0,0,0,,Mój synek spełnił po prostu boską wolę.
Dialogue: 0,0:09:36.08,0:09:42.15,Default,Fengming,0,0,0,,Jednak wiedziałam, że każdej\Nnocy wylewała morze łez!
Dialogue: 0,0:09:50.36,0:09:54.94,Default,Maomao,0,0,0,,Jak mogła tak żyć przez\Nszesnaście długich lat?
Dialogue: 0,0:09:55.94,0:10:00.70,Default,Maomao,0,0,0,,Poświęciła całe swoje życie,\Nsłużąc konkubinie A Duo…
Dialogue: 0,0:10:01.96,0:10:03.06,Default,Maomao,0,0,0,,{\i1}Nie rozumiem.
Dialogue: 0,0:10:03.14,0:10:07.96,Default,Maomao,0,0,0,,{\i1}Ja… nigdy nie kochałam\Nnikogo tak mocno.
Dialogue: 0,0:10:09.37,0:10:14.04,Default,Maomao,0,0,0,,{\i1}Pan Jinshi każe ją aresztować,\Ngdy dowie się prawdy.
Dialogue: 0,0:10:14.48,0:10:17.54,Default,Maomao,0,0,0,,{\i1}Bez wątpienia grozi jej stryczek.
Dialogue: 0,0:10:18.00,0:10:21.82,Default,Maomao,0,0,0,,{\i1}Na pewno doskonale\Nzdaje sobie z tego sprawę.
Dialogue: 0,0:10:24.34,0:10:26.39,Default,Maomao,0,0,0,,Mam pewną propozycję.
Dialogue: 0,0:10:30.10,0:10:34.86,Default,Maomao,0,0,0,,Jedyne, co mogę zrobić,\Nto połączyć oba motywy w jeden.
Dialogue: 0,0:10:35.57,0:10:37.18,Default,Maomao,0,0,0,,Wynik będzie ten sam.
Dialogue: 0,0:10:37.84,0:10:41.24,Default,Maomao,0,0,0,,Jeśli odpowiada ci takie rozwiązanie,\Nwysłuchaj mnie.
Dialogue: 0,0:10:53.21,0:10:54.57,Default,Maomao,0,0,0,,Padam z nóg…
Dialogue: 0,0:10:55.62,0:10:58.73,Default,Maomao,0,0,0,,Wykąpałabym się…\Nale trochę na to za późno.
Dialogue: 0,0:10:58.81,0:11:00.43,Default,Maomao,0,0,0,,Przebiorę się tylko.
Dialogue: 0,0:11:02.75,0:11:06.30,Default,Maomao,0,0,0,,Koniec końców, te wszystkie warstwy\Nnawoskowanego papieru
Dialogue: 0,0:11:06.38,0:11:08.14,Default,Maomao,0,0,0,,nie przydały się.
Dialogue: 0,0:11:08.56,0:11:10.89,Default,Maomao,0,0,0,,Oberwanie nożem, by zabolało.
Dialogue: 0,0:11:13.75,0:11:17.82,Default,Jinshi,0,0,0,,Zatem Fengming sama się przyznała.
Dialogue: 0,0:11:17.90,0:11:19.07,Default,Jinshi,0,0,0,,Wiesz coś na ten temat?
Dialogue: 0,0:11:19.34,0:11:20.87,Default,Maomao,0,0,0,,O czym mówisz?
Dialogue: 0,0:11:20.95,0:11:23.98,Default,Jinshi,0,0,0,,Podobno kazałaś Gaoshunowi\Nznaleźć pewne informacje.
Dialogue: 0,0:11:24.06,0:11:28.62,Default,Maomao,0,0,0,,Tak. Liczyłam, że coś\Nznajdę, ale się nie udało.
Dialogue: 0,0:11:30.16,0:11:34.40,Default,Jinshi,0,0,0,,Jak mówiłaś, motywem Fengming\Nbyło dopilnowanie,
Dialogue: 0,0:11:34.48,0:11:37.75,Default,Jinshi,0,0,0,,by konkubina A Duo utrzymała pozycję\Njednej z czterech konkubin.
Dialogue: 0,0:11:38.32,0:11:39.51,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:11:39.84,0:11:44.22,Default,Jinshi,0,0,0,,Jednak Konkubina A Duo dobrze wiedziała,\Nże musi opuścić wewnętrzny pałac.
Dialogue: 0,0:11:44.30,0:11:48.01,Default,Jinshi,0,0,0,,Zamieszka w cesarskiej willi na południu.
Dialogue: 0,0:11:48.61,0:11:51.20,Default,Maomao,0,0,0,,To z powodu tego skandalu?
Dialogue: 0,0:11:51.28,0:11:53.52,Default,Jinshi,0,0,0,,Nie, decyzja zapadła już jakiś czas temu.
Dialogue: 0,0:11:54.24,0:11:56.41,Default,Jinshi,0,0,0,,To był rozkaz cesarza.
Dialogue: 0,0:11:56.49,0:11:57.52,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:11:59.25,0:12:00.25,Default,Maomao,0,0,0,,Ten kwiatek.
Dialogue: 0,0:12:01.12,0:12:03.53,Default,Jinshi,0,0,0,,Przed chwilą Hongniang je przyniosła.
Dialogue: 0,0:12:05.38,0:12:07.86,Default,Maomao,0,0,0,,Zakwitły poza sezonem.
Dialogue: 0,0:12:17.52,0:12:18.61,Default,Jinshi,0,0,0,,Słodkie.
Dialogue: 0,0:12:18.69,0:12:19.79,Default,Maomao,0,0,0,,I trujące.
Dialogue: 0,0:12:21.49,0:12:24.38,Default,Maomao,0,0,0,,Ta dawka cię nie zabije.
Dialogue: 0,0:12:26.40,0:12:29.06,Default,Maomao,0,0,0,,Moją propozycją dla Fengming było…
Dialogue: 0,0:12:31.04,0:12:34.70,Default,Maomao,0,0,0,,Próba otrucia i śmierć dziecka.
Dialogue: 0,0:12:34.78,0:12:36.96,Default,Maomao,0,0,0,,Dzięki połączeniu tych dwóch motywów
Dialogue: 0,0:12:37.04,0:12:41.40,Default,Maomao,0,0,0,,mogła zataić przed konkubiną A Duo\Nprawdziwą przyczynę śmierci dziecka.
Dialogue: 0,0:12:42.34,0:12:44.55,Default,Maomao,0,0,0,,Nawet jeśli jej śmierć jest nieunikniona…
Dialogue: 0,0:12:45.34,0:12:50.49,Default,Maomao,0,0,0,,To wszystko, co mogła zrobić\Nzwykła pospolita służka jak ja.
Dialogue: 0,0:13:04.21,0:13:05.55,Default,Maomao,0,0,0,,Nie mogę zasnąć.
Dialogue: 0,0:13:07.51,0:13:09.51,Default,Maomao,0,0,0,,Może się przejdę.
Dialogue: 0,0:13:30.82,0:13:33.05,Default,Maomao,0,0,0,,Fengming szybko została ukarana.
Dialogue: 0,0:13:33.61,0:13:36.79,Default,Maomao,0,0,0,,Konkubina A Duo jutro\Nopuszcza wewnętrzny pałac.
Dialogue: 0,0:13:37.62,0:13:39.58,Default,Ah-Duo,0,0,0,,Widzę, że ktoś mnie wyprzedził.
Dialogue: 0,0:13:42.60,0:13:46.26,Default,Ah-Duo,0,0,0,,To ty niedawno pomagałaś przy sprzątaniu.
Dialogue: 0,0:13:46.34,0:13:48.16,Default,Maomao,0,0,0,,Już stąd uciekam.
Dialogue: 0,0:13:48.24,0:13:49.28,Default,Ah-Duo,0,0,0,,Nie musisz.
Dialogue: 0,0:13:49.74,0:13:51.51,Default,Ah-Duo,0,0,0,,Chcesz się ze mną napić?
Dialogue: 0,0:13:52.26,0:13:54.22,Default,Maomao,0,0,0,,O! Gorzałka!
Dialogue: 0,0:13:55.52,0:13:57.16,Default,Maomao,0,0,0,,Dziękuję bardzo.
Dialogue: 0,0:14:06.85,0:14:08.44,Default,Ah-Duo,0,0,0,,Wyglądam jak facet, prawda?
Dialogue: 0,0:14:08.88,0:14:11.82,Default,Maomao,0,0,0,,Z grzeczności nie zaprzeczę.
Dialogue: 0,0:14:13.43,0:14:15.25,Default,Ah-Duo,0,0,0,,Nie owijasz w bawełnę.
Dialogue: 0,0:14:16.68,0:14:24.15,Default,Ah-Duo,0,0,0,,Po stracie synka stałam się bardziej\Nprzyjaciółką cesarza niż konkubiną.
Dialogue: 0,0:14:24.69,0:14:28.34,Default,Ah-Duo,0,0,0,,A raczej wróciłam\Ndo bycia jego przyjaciółką.
Dialogue: 0,0:14:29.91,0:14:33.06,Default,Ah-Duo,0,0,0,,Nigdy nie sądziłam,\Nże zostanę konkubiną.
Dialogue: 0,0:14:34.50,0:14:37.78,Default,Ah-Duo,0,0,0,,Konkubiną byłam tylko z nazwy,\Nnadano mi tę rangę z litości.
Dialogue: 0,0:14:38.36,0:14:41.11,Default,Ah-Duo,0,0,0,,Marzyłam, żeby przejął ją ktoś inny.
Dialogue: 0,0:14:42.64,0:14:45.36,Default,Ah-Duo,0,0,0,,I po co tak kurczowo się tego trzymałam?
Dialogue: 0,0:14:45.97,0:14:51.35,Default,Maomao,0,0,0,,Pewnie powiedziałaby to samo\Nkażdemu, kogo by tu spotkała.
Dialogue: 0,0:14:56.85,0:14:59.42,Default,Ah-Duo,0,0,0,,Na pewno woda była lodowata.
Dialogue: 0,0:15:00.92,0:15:03.00,Default,Ah-Duo,0,0,0,,Musiała straszliwie cierpieć.
Dialogue: 0,0:15:07.70,0:15:08.92,Default,Maomao,0,0,0,,Pewnie masz rację.
Dialogue: 0,0:15:09.92,0:15:11.51,Default,Ah-Duo,0,0,0,,Głupia była, prawda?
Dialogue: 0,0:15:13.24,0:15:14.87,Default,Maomao,0,0,0,,Możliwe.
Dialogue: 0,0:15:16.60,0:15:18.33,Default,Ah-Duo,0,0,0,,Wszyscy jesteśmy głupi.
Dialogue: 0,0:15:25.40,0:15:27.16,Default,Maomao,0,0,0,,Możliwe.
Dialogue: 0,0:15:36.55,0:15:38.39,Default,Maomao,0,0,0,,Chyba już rozumiem.
Dialogue: 0,0:15:40.04,0:15:43.43,Default,Maomao,0,0,0,,Służąca naprawdę się zabiła.
Dialogue: 0,0:15:44.09,0:15:46.49,Default,Maomao,0,0,0,,Konkubina A Duo również to zauważyła.
Dialogue: 0,0:15:47.13,0:15:50.58,Default,Maomao,0,0,0,,Może Fengming wpłynęła na jej decyzję.
Dialogue: 0,0:15:51.70,0:15:54.28,Default,Maomao,0,0,0,,Ale, by odwrócić podejrzenia\Nod konkubiny A Duo,
Dialogue: 0,0:15:54.36,0:15:56.94,Default,Maomao,0,0,0,,służąca wolała rzucić się do zimnej wody.
Dialogue: 0,0:15:57.60,0:15:59.87,Default,Maomao,0,0,0,,Fengming również wybrała śmierć
Dialogue: 0,0:15:59.95,0:16:02.65,Default,Maomao,0,0,0,,i zabrała swój sekret razem ze sobą.
Dialogue: 0,0:16:04.12,0:16:06.64,Default,Maomao,0,0,0,,Bez względu na to,\Nczego pragnęła konkubina A Duo,
Dialogue: 0,0:16:06.72,0:16:09.88,Default,Maomao,0,0,0,,są ludzie, którzy dla niej\Npoświęcili swe życie.
Dialogue: 0,0:16:11.83,0:16:14.20,Default,Maomao,0,0,0,,Też powinnam się już zbierać.
Dialogue: 0,0:16:17.88,0:16:19.20,Default,Jinshi,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:16:23.09,0:16:25.24,Default,Maomao,0,0,0,,Kto chce, bym na zawał padła.
Dialogue: 0,0:16:25.32,0:16:27.02,Default,Jinshi,0,0,0,,Moja wina.
Dialogue: 0,0:16:28.92,0:16:30.88,Default,Maomao,0,0,0,,Panie Jinshi? Co ty tu robisz?
Dialogue: 0,0:16:31.20,0:16:33.34,Default,Jinshi,0,0,0,,O to samo mogę zapytać ciebie.
Dialogue: 0,0:16:33.68,0:16:36.34,Default,Maomao,0,0,0,,Wybacz, już sobie pójdę…
Dialogue: 0,0:16:37.75,0:16:39.77,Default,Maomao,0,0,0,,Mógłbyś mnie puścić?
Dialogue: 0,0:16:40.43,0:16:42.07,Default,Maomao,0,0,0,,No puszczaj, ale już.
Dialogue: 0,0:16:43.48,0:16:44.85,Default,Jinshi,0,0,0,,Nie chcę, bo jest zimno.
Dialogue: 0,0:16:45.51,0:16:49.40,Default,Maomao,0,0,0,,Przeziębisz się bez płaszcza.\NWracaj do swojego pokoju.
Dialogue: 0,0:16:50.07,0:16:52.02,Default,Maomao,0,0,0,,Upiłeś się?
Dialogue: 0,0:16:52.42,0:16:54.61,Default,Jinshi,0,0,0,,Musiałem. Nie miałem wyboru.
Dialogue: 0,0:16:54.91,0:16:56.63,Default,Maomao,0,0,0,,Czyżby?
Dialogue: 0,0:16:57.13,0:16:59.56,Default,Jinshi,0,0,0,,Zaprosili mnie na drinka,
Dialogue: 0,0:16:59.64,0:17:01.36,Default,Jinshi,0,0,0,,kazali pić jednego po drugim
Dialogue: 0,0:17:01.44,0:17:03.53,Default,Jinshi,0,0,0,,i sobie poszli.
Dialogue: 0,0:17:04.20,0:17:06.42,Default,Jinshi,0,0,0,,A jak gospodarz w końcu wrócił,
Dialogue: 0,0:17:06.72,0:17:09.72,Default,Jinshi,0,0,0,,powiedział, że wrócił mu humor\Ni odprawił mnie z kwitkiem.
Dialogue: 0,0:17:10.49,0:17:15.80,Default,Maomao,0,0,0,,Ciekawe, co za głupiec\Nodważył się tak z nim postąpić.
Dialogue: 0,0:17:15.88,0:17:18.96,Default,Maomao,0,0,0,,Ale to już nie moja sprawa!
Dialogue: 0,0:17:19.04,0:17:22.31,Default,Maomao,0,0,0,,Nie zamierzam męczyć się\Nz taką moczymordą.
Dialogue: 0,0:17:22.71,0:17:28.54,Default,Maomao,0,0,0,,Chwila… Czy on czasem nie uratował\Nmojego zadka przed upadkiem?
Dialogue: 0,0:17:28.62,0:17:33.03,Default,Maomao,0,0,0,,Jeśli tak, to muszę mu jednak\Npodziękować, a nie uciec bez słowa.
Dialogue: 0,0:17:33.57,0:17:34.87,Default,Maomao,0,0,0,,Panie Jinshi…
Dialogue: 0,0:17:45.11,0:17:46.79,Default,Jinshi,0,0,0,,Jeszcze troszeczkę.
Dialogue: 0,0:17:47.51,0:17:50.70,Default,Jinshi,0,0,0,,Ogrzej mnie jeszcze troszeczkę.
Dialogue: 0,0:18:07.59,0:18:11.06,Default,Maomao,0,0,0,,Nie wygląda na skacowanego.
Dialogue: 0,0:18:11.36,0:18:13.40,Default,Maomao,0,0,0,,Aby konkubina A Duo mogła opuścić pałac,
Dialogue: 0,0:18:13.48,0:18:15.61,Default,Maomao,0,0,0,,musi zwrócić diadem,\Nsymbol Czystej Damy.
Dialogue: 0,0:18:16.47,0:18:22.12,Default,Maomao,0,0,0,,Przekaże go innej pannie, która wkrótce\Ndołączy do wewnętrznego pałacu.
Dialogue: 0,0:18:28.41,0:18:30.28,Default,Maomao,0,0,0,,No właśnie.
Dialogue: 0,0:18:30.36,0:18:32.46,Default,Maomao,0,0,0,,Wiedziałam, że kogoś przypomina.
Dialogue: 0,0:18:33.12,0:18:35.46,Default,Maomao,0,0,0,,Chodziło o pana Jinshiego.
Dialogue: 0,0:18:36.84,0:18:40.47,Default,Maomao,0,0,0,,Lepiej by wyglądali,\Ngdyby zamienili się strojami…
Dialogue: 0,0:18:41.16,0:18:42.47,Default,Maomao,0,0,0,,Zamiana…
Dialogue: 0,0:18:43.32,0:18:46.48,Default,Ah-Duo,0,0,0,,Gdy mój synek mnie opuścił…
Dialogue: 0,0:18:46.56,0:18:50.56,Default,Maomao,0,0,0,,„Opuścił” to nie to samo, co „umarł”.
Dialogue: 0,0:18:51.17,0:18:54.43,Default,Maomao,0,0,0,,Te słowa można zrozumieć dwojako.
Dialogue: 0,0:18:54.51,0:18:59.13,Default,Maomao,0,0,0,,Syn konkubiny A Duo\Ni syn ówczesnej cesarzowej…
Dialogue: 0,0:18:59.21,0:19:02.23,Default,Maomao,0,0,0,,A jeśli ktoś ich podmienił?
Dialogue: 0,0:19:03.20,0:19:07.25,Default,Maomao,0,0,0,,Konkubina A Duo doskonale zdawała\Nsobie sprawę ze swojej pozycji.
Dialogue: 0,0:19:07.53,0:19:09.96,Default,Luomen,0,0,0,,Co ty wyprawiasz?\NMuszę zająć się konkubiną A Duo…
Dialogue: 0,0:19:10.04,0:19:11.66,Default,Eunuch,0,0,0,,Cesarzowa jest ważniejsza!
Dialogue: 0,0:19:11.74,0:19:13.53,Default,Fengming,0,0,0,,Nie!
Dialogue: 0,0:19:13.61,0:19:18.52,Default,Maomao,0,0,0,,Była jedynie namiastką cesarskiej mamki,\Nprzyjaciółką cesarza z dzieciństwa.
Dialogue: 0,0:19:18.60,0:19:23.80,Default,Maomao,0,0,0,,Doskonale wiedziała, które dziecko\Nbędzie dużo lepiej traktowane.
Dialogue: 0,0:19:24.93,0:19:29.27,Default,Maomao,0,0,0,,Nie była w stanie ocenić,\Nco jest dobre, a co złe.
Dialogue: 0,0:19:29.76,0:19:33.19,Default,Maomao,0,0,0,,A jeśli miałoby to zapewnić\Nlepszą przyszłość jej dziecku,
Dialogue: 0,0:19:33.94,0:19:37.02,Default,Maomao,0,0,0,,było to wszystko, czego pragnęła.
Dialogue: 0,0:19:37.72,0:19:41.22,Default,Maomao,0,0,0,,Tylko co by było, gdyby ludzie\Nodkryli, że dzieci zostały zamienione?
Dialogue: 0,0:19:41.76,0:19:44.36,Default,Maomao,0,0,0,,Skoro zmarło jedyne dziecko cesarzowej,
Dialogue: 0,0:19:44.44,0:19:50.12,Default,Maomao,0,0,0,,to tłumaczyłoby, dlaczego mój ojczulek\Nzostał wygnany i okaleczony.
Dialogue: 0,0:19:51.59,0:19:53.04,Default,Maomao,0,0,0,,A jeśli tak by było,
Dialogue: 0,0:19:53.12,0:19:56.54,Default,Maomao,0,0,0,,to wyjaśnia, dlaczego cesarz\Njest w trudnej sytuacji,
Dialogue: 0,0:19:57.26,0:20:00.16,Default,Maomao,0,0,0,,a bezpłodna konkubina A Duo
Dialogue: 0,0:20:00.24,0:20:02.90,Default,Maomao,0,0,0,,wytrwała tak długo w pałacu…
Dialogue: 0,0:20:06.10,0:20:09.55,Default,Maomao,0,0,0,,To bez sensu.\NPoniosła mnie fantazja.
Dialogue: 0,0:20:09.63,0:20:10.77,Default,Lishu,0,0,0,,Proszę poczekać!
Dialogue: 0,0:20:10.85,0:20:12.19,Default,Kanan,0,0,0,,Pani Li Shu!
Dialogue: 0,0:20:15.88,0:20:17.73,Default,Maomao,0,0,0,,A te jak zwykle.
Dialogue: 0,0:20:18.96,0:20:23.13,Default,Maomao,0,0,0,,Przynajmniej w końcu zyskała\Nzaufaną towarzyszkę.
Dialogue: 0,0:20:24.00,0:20:27.24,Default,Maomao,0,0,0,,Ma kogoś, komu może zaufać.
Dialogue: 0,0:20:29.24,0:20:30.25,Default,Kanan,0,0,0,,Pani Li Shu!
Dialogue: 0,0:20:38.23,0:20:44.86,Default,Maomao,0,0,0,,W tym momencie na androgynicznej twarzy\Npani A Duo dostrzegłam matczyny wyraz.
Dialogue: 0,0:20:52.99,0:20:56.01,Default,Gaoshun,0,0,0,,Oto lista osób z rodziny Fengming\Ni osób z nią związanych.
Dialogue: 0,0:20:57.35,0:21:00.74,Default,Jinshi,0,0,0,,Słyszałem, że została porwana\Ni sprzedana, ale…
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.48,0:22:48.18,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Eunuch i Kurtyzana”.
Dialogue: 0,0:22:48.45,0:22:50.07,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
