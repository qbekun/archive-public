Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:35.36,0:01:38.36,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:37.56,0:01:39.49,Default,Maomao,0,0,0,,{\an8}Zapach drzewa sandałowego...
Dialogue: 0,0:01:40.51,0:01:42.98,Default,Maomao,0,0,0,,Sypialnia pana Jinshiego...
Dialogue: 0,0:01:43.41,0:01:45.73,Default,Maomao,0,0,0,,Jak tu trafiłam?
Dialogue: 0,0:01:53.09,0:01:55.51,Default,Suiren,0,0,0,,O, obudziłaś się.
Dialogue: 0,0:01:57.58,0:01:59.16,Default,Suiren,0,0,0,,Nie forsuj się.
Dialogue: 0,0:01:59.16,0:02:01.18,Default,Suiren,0,0,0,,Masz piętnaście szwów.
Dialogue: 0,0:02:01.88,0:02:06.64,Default,Suiren,0,0,0,,Pan Jinshi przyniósł cię tutaj.\NJest tu lepiej niż w infirmerii.
Dialogue: 0,0:02:07.35,0:02:09.10,Default,Suiren,0,0,0,,Proszę.
Dialogue: 0,0:02:09.70,0:02:11.37,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:02:15.89,0:02:19.55,Default,Suiren,0,0,0,,Wybacz, że kłopoczę cię po przebudzeniu,\Nale czy mogłabyś się ubrać?
Dialogue: 0,0:02:19.55,0:02:21.16,Default,Suiren,0,0,0,,Będziesz miała gości.
Dialogue: 0,0:02:22.83,0:02:23.95,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:02:24.94,0:02:26.66,Default,Basen,0,0,0,,Co tu się dzieje?!
Dialogue: 0,0:02:27.31,0:02:28.12,Default,Gaoshun,0,0,0,,Basen!
Dialogue: 0,0:02:29.79,0:02:33.79,Default,Text,0,0,0,,{\an8}ODCINEK 20: BIELUŃ
Dialogue: 0,0:02:29.89,0:02:33.08,Default,Maomao,0,0,0,,{\an1}Życie jego pana było zagrożone.
Dialogue: 0,0:02:33.89,0:02:37.63,Default,Maomao,0,0,0,,Mimo to nie zasłużyłam,\Nby na mnie wrzeszczeć.
Dialogue: 0,0:02:39.93,0:02:41.51,Default,Maomao,0,0,0,,Przepraszam za mój brak manier.
Dialogue: 0,0:02:42.14,0:02:43.53,Default,Jinshi,0,0,0,,Nie martw się.
Dialogue: 0,0:02:43.53,0:02:47.61,Default,Jinshi,0,0,0,,Niemniej jak się tam znalazłaś
Dialogue: 0,0:02:47.61,0:02:50.36,Default,Jinshi,0,0,0,,i skąd wiedziałaś,\Nże słup zaraz spadnie?
Dialogue: 0,0:02:50.36,0:02:51.69,Default,Jinshi,0,0,0,,Wyjaśnij to.
Dialogue: 0,0:02:54.25,0:02:55.36,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:02:56.79,0:03:00.41,Default,Maomao,0,0,0,,To był wypadek związany\Nz wieloma zbiegami okoliczności.
Dialogue: 0,0:03:00.41,0:03:04.84,Default,Maomao,0,0,0,,Lecz te zbiegi okoliczności\Nzostały dobrane celowo.
Dialogue: 0,0:03:04.84,0:03:08.60,Default,Maomao,0,0,0,,To spisek, a nie przypadek.
Dialogue: 0,0:03:09.45,0:03:11.90,Default,Maomao,0,0,0,,Pierwszym przypadkiem\Nbyła śmierć pana Kounena,
Dialogue: 0,0:03:11.90,0:03:15.41,Default,Maomao,0,0,0,,urzędnika wysokiej rangi z zeszłego roku.
Dialogue: 0,0:03:18.55,0:03:21.85,Default,Maomao,0,0,0,,Następnie pożar magazynu,
Dialogue: 0,0:03:21.85,0:03:24.68,Default,Maomao,0,0,0,,i kradzież rytualnych\Nprzedmiotów z innego magazynu.
Dialogue: 0,0:03:27.66,0:03:30.64,Default,Maomao,0,0,0,,I trzeci to zarządca\Nrytualnych przedmiotów,
Dialogue: 0,0:03:30.64,0:03:33.81,Default,Maomao,0,0,0,,który zatruł się jedzeniem\Nmniej więcej w tym samym czasie.
Dialogue: 0,0:03:37.40,0:03:41.20,Default,Jinshi,0,0,0,,To wszystko zostało umyślnie\Nprzez kogoś spowodowane?
Dialogue: 0,0:03:41.80,0:03:42.92,Default,Maomao,0,0,0,,Prawdopodobnie.
Dialogue: 0,0:03:43.49,0:03:46.96,Default,Maomao,0,0,0,,Jest jeszcze jeden ważny aspekt.
Dialogue: 0,0:03:46.96,0:03:47.65,Default,Jinshi,0,0,0,,Co takiego?
Dialogue: 0,0:03:48.21,0:03:49.91,Default,Maomao,0,0,0,,Kradzież rytualnych przedmiotów.
Dialogue: 0,0:03:50.92,0:03:54.92,Default,Maomao,0,0,0,,Słup nad ołtarzem przymocowano do sufitu\Nsznurem biegnącym przez metalowe bloczki,
Dialogue: 0,0:03:54.92,0:03:57.51,Default,Maomao,0,0,0,,a do podłogi za pomocą\Nmetalowych elementów.
Dialogue: 0,0:03:58.21,0:04:00.97,Default,Maomao,0,0,0,,Jeżeli celem było upozorowanie\Nnieszczęśliwego wypadku,
Dialogue: 0,0:04:00.97,0:04:03.43,Default,Maomao,0,0,0,,wówczas należało celować\Nw te metalowe części.
Dialogue: 0,0:04:04.06,0:04:07.51,Default,Basen,0,0,0,,Jeżeli ktoś by je ukradł,\Npo prostu stworzono by nowe!
Dialogue: 0,0:04:07.82,0:04:10.27,Default,Maomao,0,0,0,,Naturalnie, że tak.
Dialogue: 0,0:04:11.05,0:04:15.62,Default,Maomao,0,0,0,,Jako że są one używane podczas ceremonii,\Nz pewnością ich wygląd był dopracowany.
Dialogue: 0,0:04:15.62,0:04:18.44,Default,Maomao,0,0,0,,Znam jednego fachowca,\Nktóry mógłby to zrobić.
Dialogue: 0,0:04:19.16,0:04:20.94,Default,Jinshi,0,0,0,,Czyżby cyzelator, który zmarł?
Dialogue: 0,0:04:21.43,0:04:27.05,Default,Maomao,0,0,0,,Tak. Skradzione przedmioty rytualne\Nzostały odtworzone przez cyzelatora.
Dialogue: 0,0:04:28.79,0:04:33.64,Default,Maomao,0,0,0,,Co jeśli te metalowe części\Nzaprojektowano tak, by pękły po rozgrzaniu?
Dialogue: 0,0:04:36.58,0:04:40.35,Default,Basen,0,0,0,,Bzdury! To przecież metal.\NOn się nie pali...
Dialogue: 0,0:04:44.05,0:04:47.95,Default,Maomao,0,0,0,,Dzięki sekretnej technice\Nzmarłego cyzelatora
Dialogue: 0,0:04:47.95,0:04:51.17,Default,Maomao,0,0,0,,metal mógł zostać stopiony przez\Nsamo przebywanie w pobliżu ognia.
Dialogue: 0,0:04:53.37,0:04:56.77,Default,Jinshi,0,0,0,,Chcesz powiedzieć,\Nże cyzelator był częścią tego spisku?
Dialogue: 0,0:04:57.14,0:05:00.02,Default,Maomao,0,0,0,,Wydaje mi się,\Nże o niczym nie wiedział
Dialogue: 0,0:05:00.02,0:05:03.11,Default,Maomao,0,0,0,,i po prostu wykonał\Nzamówione metalowe części.
Dialogue: 0,0:05:04.09,0:05:09.78,Default,Maomao,0,0,0,,Możliwe, że ktoś zlecił mu wykonanie\Npodobnych części ze specjalnego metalu.
Dialogue: 0,0:05:10.20,0:05:14.42,Default,Maomao,0,0,0,,Gdyby podczas ceremonii doszło do wypadku,\Ncyzelator mógłby coś podejrzewać.
Dialogue: 0,0:05:15.17,0:05:17.26,Default,Maomao,0,0,0,,Jeśli twórca zniknąłby przed wypadkiem,
Dialogue: 0,0:05:17.26,0:05:19.61,Default,Maomao,0,0,0,,to zabrałby ze sobą do grobu
Dialogue: 0,0:05:19.61,0:05:22.17,Default,Maomao,0,0,0,,tożsamość sprawcy\Ni tajemnicę swojej sztuki.
Dialogue: 0,0:05:22.46,0:05:24.54,Default,Maomao,0,0,0,,Takie rozwiązanie byłoby na rękę.
Dialogue: 0,0:05:25.03,0:05:27.01,Default,Jinshi,0,0,0,,Sądzisz, że go zamordowano?
Dialogue: 0,0:05:27.69,0:05:29.30,Default,Maomao,0,0,0,,Tego nie wiem.
Dialogue: 0,0:05:30.19,0:05:33.89,Default,Maomao,0,0,0,,Niewykluczone, że było to przestępstwo\Nupozorowane jako wypadek.
Dialogue: 0,0:05:35.06,0:05:39.81,Default,Maomao,0,0,0,,Osoba, która zamówiła te nowe części,
Dialogue: 0,0:05:39.81,0:05:42.44,Default,Maomao,0,0,0,,znała technikę,\Ndzięki której było to możliwe.
Dialogue: 0,0:05:43.50,0:05:45.94,Default,Maomao,0,0,0,,Na razie tyle mogę powiedzieć.
Dialogue: 0,0:05:46.68,0:05:47.78,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:05:48.44,0:05:52.70,Default,Maomao,0,0,0,,Swoją drogą, kto by pomyślał,\Nże pan Jinshi będzie na tej ceremonii?
Dialogue: 0,0:05:53.74,0:05:56.41,Default,Maomao,0,0,0,,Gdyby ceremonia\Nnie została przerwana...
Dialogue: 0,0:05:58.19,0:06:00.21,Default,Maomao,0,0,0,,Kim jest ten facet?
Dialogue: 0,0:06:00.95,0:06:06.49,Default,Maomao,0,0,0,,Skoro ktoś chciał go zabić\Nw tak zawiły sposób...
Dialogue: 0,0:06:08.59,0:06:11.25,Default,Maomao,0,0,0,,Prawda wpędziłaby mnie\Nw jeszcze większe kłopoty.
Dialogue: 0,0:06:17.49,0:06:20.07,Default,Maomao,0,0,0,,Nie mam już z tym nic wspólnego.
Dialogue: 0,0:06:29.71,0:06:31.37,Default,Suiren,0,0,0,,Xiaomao.
Dialogue: 0,0:06:31.37,0:06:32.18,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:06:33.63,0:06:35.02,Default,Suiren,0,0,0,,Masz gościa.
Dialogue: 0,0:06:37.88,0:06:41.79,Default,Lihaku,0,0,0,,Jeżeli chodzi o tamten incydent.\NNiejaka Suirei miała z tym coś wspólnego...
Dialogue: 0,0:06:42.28,0:06:44.04,Default,Maomao,0,0,0,,Suirei. Tak myślałam.
Dialogue: 0,0:06:44.49,0:06:45.96,Default,Lihaku,0,0,0,,Znaleźli jej ciało.
Dialogue: 0,0:06:47.82,0:06:48.47,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:06:51.13,0:06:53.30,Default,Lihaku,0,0,0,,Kiedy oficer śledczy\Nwszedł do jej pokoju,
Dialogue: 0,0:06:53.30,0:06:55.84,Default,Lihaku,0,0,0,,kobieta wypiła już truciznę\Ni leżała na podłodze.
Dialogue: 0,0:06:56.54,0:07:00.21,Default,Lihaku,0,0,0,,Zbadał ją medyk\Ni potwierdził jej zgon.
Dialogue: 0,0:07:01.32,0:07:02.67,Default,Maomao,0,0,0,,Co teraz?
Dialogue: 0,0:07:03.14,0:07:07.19,Default,Lihaku,0,0,0,,Pewnie jutro jej zwłoki\Nzostaną skremowane.
Dialogue: 0,0:07:07.48,0:07:08.90,Default,Maomao,0,0,0,,Miała jakichś wspólników?
Dialogue: 0,0:07:09.21,0:07:11.99,Default,Lihaku,0,0,0,,Nie. Była tylko ona.
Dialogue: 0,0:07:13.72,0:07:17.29,Default,Maomao,0,0,0,,Sama przeprowadziła tak\Nskomplikowaną operację?
Dialogue: 0,0:07:17.66,0:07:21.46,Default,Lihaku,0,0,0,,To byłoby na tyle.\NSprawa rozwiązana. Na razie.
Dialogue: 0,0:07:24.74,0:07:26.84,Default,Maomao,0,0,0,,Sama się otruła?
Dialogue: 0,0:07:27.46,0:07:29.84,Default,Maomao,0,0,0,,To naprawdę koniec?
Dialogue: 0,0:07:29.84,0:07:31.80,Default,Maomao,0,0,0,,Nie, co ważniejsze...
Dialogue: 0,0:07:32.59,0:07:35.64,Default,Maomao,0,0,0,,Czy Suirei była osobą,\Nktóra popełniłaby samobójstwo?
Dialogue: 0,0:07:36.52,0:07:42.17,Default,Maomao,0,0,0,,Była oschła i pozbawiona emocji,\Nbo wiedziała, jak wygląda jej przyszłość?
Dialogue: 0,0:07:43.26,0:07:46.44,Default,Maomao,0,0,0,,Jednak tamtego dnia czułam,\Njakby mnie wyzwała...
Dialogue: 0,0:07:47.18,0:07:49.41,Default,Suirei,0,0,0,,Za jakiś czas zasadzę tu kilka powojów.
Dialogue: 0,0:07:55.31,0:07:56.92,Default,Maomao,0,0,0,,Zioło życia...
Dialogue: 0,0:08:02.71,0:08:05.50,Default,Maomao,0,0,0,,Domysły to za mało.\NMuszę mieć pewność!
Dialogue: 0,0:08:06.23,0:08:07.34,Default,Maomao,0,0,0,,Panie Jinshi!
Dialogue: 0,0:08:08.23,0:08:09.99,Default,Maomao,0,0,0,,Mam do pana prośbę!
Dialogue: 0,0:08:10.57,0:08:12.01,Default,Jinshi,0,0,0,,O co chodzi?
Dialogue: 0,0:08:15.48,0:08:20.05,Default,Maomao,0,0,0,,Chciałabym porozmawiać\Nz medykiem, który badał ciało.
Dialogue: 0,0:08:20.05,0:08:21.40,Default,Maomao,0,0,0,,W kostnicy.
Dialogue: 0,0:08:21.40,0:08:23.35,Default,Jinshi,0,0,0,,Czemu mordka ci się cieszy?
Dialogue: 0,0:08:24.60,0:08:26.27,Default,Maomao,0,0,0,,Ciekawość wzięła górę.
Dialogue: 0,0:08:33.08,0:08:36.03,Default,Gaoshun,0,0,0,,Panie Jinshi,\Nnie powinieneś tam wchodzić...
Dialogue: 0,0:08:36.70,0:08:39.10,Default,Jinshi,0,0,0,,Jeśli zielareczka idzie, to ja też.
Dialogue: 0,0:08:40.76,0:08:42.11,Default,Gaohsun,0,0,0,,Dobrze.
Dialogue: 0,0:08:49.81,0:08:51.34,Default,Gaoshun,0,0,0,,Xiaomao, proszę.
Dialogue: 0,0:08:52.09,0:08:53.63,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:08:54.78,0:08:57.18,Default,Doctor,0,0,0,,Przepraszam za spóźnienie.
Dialogue: 0,0:08:57.82,0:09:00.39,Default,Maomao,0,0,0,,Tak myślałam,\Nże to on przeprowadził badanie.
Dialogue: 0,0:09:00.93,0:09:04.02,Default,Maomao,0,0,0,,Dwórka, z którą był blisko, nie żyje,
Dialogue: 0,0:09:04.02,0:09:06.82,Default,Maomao,0,0,0,,a na dodatek\Njest oskarżona o przestępstwo.
Dialogue: 0,0:09:06.82,0:09:08.27,Default,Maomao,0,0,0,,Nic dziwnego, że pada z sił.
Dialogue: 0,0:09:08.82,0:09:10.77,Default,Maomao,0,0,0,,Ale czy to na pewno koniec?
Dialogue: 0,0:09:11.41,0:09:13.55,Default,Maomao,0,0,0,,Bez owijania w bawełnę.
Dialogue: 0,0:09:13.55,0:09:17.74,Default,Maomao,0,0,0,,Czy w truciźnie wypitej\Nprzez dwórkę był bieluń?
Dialogue: 0,0:09:18.52,0:09:20.04,Default,Doctor,0,0,0,,To...
Dialogue: 0,0:09:20.04,0:09:22.24,Default,Maomao,0,0,0,,Niewielkie wzgórze w pobliżu stajni.
Dialogue: 0,0:09:23.16,0:09:26.11,Default,Maomao,0,0,0,,Czy nie rósł tam bieluń?
Dialogue: 0,0:09:27.06,0:09:31.73,Default,Maomao,0,0,0,,Ma silne działanie trujące, ale w pewnych\Nilościach działa jako środek znieczulający.
Dialogue: 0,0:09:32.25,0:09:34.67,Default,Maomao,0,0,0,,Na pewno w infirmerii go nie brakuje.
Dialogue: 0,0:09:36.27,0:09:39.99,Default,Maomao,0,0,0,,Bieluń z wyglądu\Nprzypomina powój koreański.
Dialogue: 0,0:09:41.00,0:09:42.60,Default,Doctor,0,0,0,,Nie mam co do tego pewności.
Dialogue: 0,0:09:43.01,0:09:47.39,Default,Doctor,0,0,0,,Zważywszy na objawy, istnieje takie\Nprawdopodobieństwo, ale nie ma pewności.
Dialogue: 0,0:09:48.27,0:09:51.09,Default,Maomao,0,0,0,,Przekonajmy się o tym na własne oczy.
Dialogue: 0,0:10:03.54,0:10:05.21,Default,Doctor,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:10:06.18,0:10:08.25,Default,Maomao,0,0,0,,Zamknij się i patrz!
Dialogue: 0,0:10:08.25,0:10:09.85,Default,Doctor,0,0,0,,Przestań!
Dialogue: 0,0:10:12.52,0:10:13.71,Default,Maomao,0,0,0,,I gotowe.
Dialogue: 0,0:10:18.45,0:10:20.84,Default,Doctor,0,0,0,,To... nie jest Suirei?!
Dialogue: 0,0:10:22.30,0:10:23.85,Default,Doctor,0,0,0,,Niemożliwe...
Dialogue: 0,0:10:25.49,0:10:29.02,Default,Doctor,0,0,0,,Na własne oczy widziałem Suirei...
Dialogue: 0,0:10:29.56,0:10:31.52,Default,Maomao,0,0,0,,Jesteś pewien, że to była ona?
Dialogue: 0,0:10:32.11,0:10:35.31,Default,Doctor,0,0,0,,Nie ma mowy, bym ją pomylił.
Dialogue: 0,0:10:37.51,0:10:40.53,Default,Doctor,0,0,0,,Nie wyczułem pulsu.\NJej serce też nie biło.
Dialogue: 0,0:10:41.29,0:10:42.86,Default,Doctor,0,0,0,,Była taka piękna.
Dialogue: 0,0:10:43.57,0:10:46.45,Default,Maomao,0,0,0,,Czyli jednym słowem, wykorzystano cię.
Dialogue: 0,0:10:47.34,0:10:52.86,Default,Maomao,0,0,0,,Nie wpadłeś na to, by zrobić sekcję zwłok\Ni sprawdzić, jakiej trucizny użyła.
Dialogue: 0,0:10:53.77,0:10:55.88,Default,Maomao,0,0,0,,Wszystko poszło zgodnie z jej planem.
Dialogue: 0,0:10:55.88,0:10:57.14,Default,Doctor,0,0,0,,Ty!
Dialogue: 0,0:10:57.62,0:11:01.17,Default,Maomao,0,0,0,,Suirei wzięła nie tylko bieluń.
Dialogue: 0,0:11:01.72,0:11:04.27,Default,Maomao,0,0,0,,Gdybyśmy sprawdzili zapasy leków,
Dialogue: 0,0:11:04.27,0:11:06.55,Default,Maomao,0,0,0,,moglibyśmy stwierdzić,\Nczego dokładnie użyła.
Dialogue: 0,0:11:07.70,0:11:09.82,Default,Maomao,0,0,0,,Jedyne, za co możemy\Nwinić tego medyka,
Dialogue: 0,0:11:09.82,0:11:13.08,Default,Maomao,0,0,0,,to brak właściwej kontroli nad lekami.
Dialogue: 0,0:11:13.08,0:11:14.60,Default,Jinshi,0,0,0,,O co chodzi...
Dialogue: 0,0:11:15.67,0:11:17.86,Default,Jinshi,0,0,0,,z tą pomyłką ze zwłokami?
Dialogue: 0,0:11:17.86,0:11:19.98,Default,Maomao,0,0,0,,Nawet gdyby trumna zostałaby spalona,
Dialogue: 0,0:11:19.98,0:11:22.38,Default,Maomao,0,0,0,,to brak ciała byłby nieco podejrzany.
Dialogue: 0,0:11:22.38,0:11:27.62,Default,Maomao,0,0,0,,Aby zastąpić swoje ciało, postanowiła\Numieścić inne zwłoki w trumnie.
Dialogue: 0,0:11:28.05,0:11:30.31,Default,Jinshi,0,0,0,,A co z ciałem Suirei?
Dialogue: 0,0:11:30.72,0:11:32.84,Default,Jinshi,0,0,0,,Przeniesienie trupa wywołałoby scenę.
Dialogue: 0,0:11:32.84,0:11:34.89,Default,Maomao,0,0,0,,Nie było to konieczne.
Dialogue: 0,0:11:35.32,0:11:36.29,Default,Jinshi,0,0,0,,Co masz na myśli?
Dialogue: 0,0:11:44.04,0:11:46.43,Default,Maomao,0,0,0,,Wyszła o własnych siłach.
Dialogue: 0,0:11:47.97,0:11:49.64,Default,Jinshi,0,0,0,,To ona nie umarła?!
Dialogue: 0,0:11:50.12,0:11:53.06,Default,Maomao,0,0,0,,Jest pewien lek, dzięki któremu\Nmożna udawać trupa.
Dialogue: 0,0:11:53.53,0:11:54.98,Default,Maomao,0,0,0,,Wiesz o tym?
Dialogue: 0,0:11:54.98,0:11:58.58,Default,Doctor,0,0,0,,Słyszałem o tym,\Nale myślałem, że to bajka.
Dialogue: 0,0:11:58.98,0:12:00.03,Default,Jinshi,0,0,0,,Co to jest?
Dialogue: 0,0:12:00.44,0:12:03.33,Default,Maomao,0,0,0,,Lek ten, rzekomo znany w odległej krainie,
Dialogue: 0,0:12:03.33,0:12:07.58,Default,Maoamo,0,0,0,,jest w stanie zabić człowieka,\Na następnie go wskrzesić.
Dialogue: 0,0:12:08.21,0:12:10.29,Default,Maomao,0,0,0,,Nie znam szczegółów,
Dialogue: 0,0:12:10.29,0:12:13.77,Default,Maomao,0,0,0,,ale podobno używa się do tego\Nbielunia i toksyny z ryby Fugu.
Dialogue: 0,0:12:18.09,0:12:19.31,Default,Gaoshun,0,0,0,,Xiaomao?
Dialogue: 0,0:12:19.31,0:12:23.52,Default,Maomao,0,0,0,,Panie Gaoshun,\Nsprawdziłbyś resztę trumien?
Dialogue: 0,0:12:23.52,0:12:24.13,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:12:32.35,0:12:33.56,Default,Gaoshun,0,0,0,,Ślady po gwoździach.
Dialogue: 0,0:12:34.79,0:12:38.15,Default,Maomao,0,0,0,,To w niej musiała leżeć Suiren.
Dialogue: 0,0:12:38.52,0:12:42.74,Default,Maomao,0,0,0,,Nim przybył jej wspólnik,\Nby ją uwolnić,
Dialogue: 0,0:12:43.10,0:12:44.99,Default,Maomao,0,0,0,,wróciła do życia.
Dialogue: 0,0:12:45.70,0:12:48.84,Default,Maomao,0,0,0,,Na jej miejsce wstawili\Ninną trumnę z innym ciałem,
Dialogue: 0,0:12:48.84,0:12:51.65,Default,Maomao,0,0,0,,a następnie przebrali ją\Nza służącego, by mogła wyjść.
Dialogue: 0,0:12:54.59,0:12:57.67,Default,Jinshi,0,0,0,,Zastosowałaby taką ryzykowną metodę?
Dialogue: 0,0:12:58.02,0:13:01.08,Default,Maomao,0,0,0,,Gdyby wpadła,\Nto i tak by ją stracono.
Dialogue: 0,0:13:01.08,0:13:03.17,Default,Maomao,0,0,0,,Ja tam bym się nie wahała.
Dialogue: 0,0:13:03.49,0:13:06.41,Default,Jinshi,0,0,0,,Ty to co innego.
Dialogue: 0,0:13:06.41,0:13:11.28,Default,Maomao,0,0,0,,Skoro nie ma ciała,\Nto opłaciło się zaryzykować.
Dialogue: 0,0:13:11.28,0:13:15.89,Default,Maomao,0,0,0,,Skoro zwłoki zostały podmienione\Ni spalone, wygrałaby tę rundę.
Dialogue: 0,0:13:17.66,0:13:19.77,Default,Maomao,0,0,0,,Ale nie na mojej warcie.
Dialogue: 0,0:13:21.29,0:13:24.11,Default,Maomao,0,0,0,,Jeśli jeszcze żyje, chcę ją poznać.
Dialogue: 0,0:13:24.80,0:13:26.62,Default,Maomao,0,0,0,,Nie by ją schwytać.
Dialogue: 0,0:13:26.62,0:13:29.93,Default,Maomao,0,0,0,,Dzięki jej wiedzy wiele zbrodni\Nwyglądało na wypadki.
Dialogue: 0,0:13:29.93,0:13:32.04,Default,Maomao,0,0,0,,Odwaga, z jaką to wszystko zrobiła.
Dialogue: 0,0:13:32.68,0:13:38.50,Default,Maomao,0,0,0,,A przede wszystkim miała jaja,\Nby nas wszystkich zrobić w konia. {A przede wszystkim nerwy ze stali, których\Npotrzebowała, by oszukać nas wszystkich!}
Dialogue: 0,0:13:40.97,0:13:44.92,Default,Maomao,0,0,0,,Śmierć kogoś takiego\Nbyłoby wielką stratą!
Dialogue: 0,0:13:47.36,0:13:51.68,Default,Maomao,0,0,0,,Cudowne zioło życia!\NMusi mnie tego nauczyć!
Dialogue: 0,0:13:58.61,0:13:59.91,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:13:59.91,0:14:01.10,Default,Jinshi,0,0,0,,Co jest?!
Dialogue: 0,0:14:02.34,0:14:03.94,Default,Maomao,0,0,0,,Mogę prosić o nowe szwy?
Dialogue: 0,0:14:04.42,0:14:06.45,Default,Maomao,0,0,0,,Poprzednie chyba nie wytrzymały.
Dialogue: 0,0:14:06.90,0:14:08.99,Default,Jinshi,0,0,0,,Było mówić wcześniej!
Dialogue: 0,0:14:15.14,0:14:16.30,Default,Lady-in-Waiting,0,0,0,,Pani Loulan.
Dialogue: 0,0:14:32.94,0:14:36.74,Default,Jinshi,0,0,0,,Sprawa dotycząca Suirei\Nzostała rozwiązana po cichu.
Dialogue: 0,0:14:37.99,0:14:42.02,Default,Jinshi,0,0,0,,Nadal wiele rzeczy pozostaje\Nniejasnych w sprawie tej dwórki.
Dialogue: 0,0:14:42.81,0:14:47.28,Default,Jinshi,0,0,0,,Zdaniem medyka\Nwspierał ją jego nauczyciel.
Dialogue: 0,0:14:47.81,0:14:52.76,Default,Jinshi,0,0,0,,Mężczyzna zauważył jej zdolności kilka lat\Ntemu i sprowadził ją jako adoptowaną córkę.
Dialogue: 0,0:14:52.76,0:14:55.08,Default,Jinshi,0,0,0,,Nikt wcześniej nie znał jej przeszłości.
Dialogue: 0,0:14:56.62,0:14:58.58,Default,Jinshi,0,0,0,,To jeszcze nie koniec tej sprawy.
Dialogue: 0,0:15:01.48,0:15:04.27,Default,Gaoshun,0,0,0,,Pomogłem Xiaomao dotrzeć do domu.
Dialogue: 0,0:15:04.27,0:15:05.70,Default,Jinshi,0,0,0,,Przepraszam za kłopot.
Dialogue: 0,0:15:06.29,0:15:09.59,Default,Gaoshun,0,0,0,,Nie możemy pozwolić,\Nby rana znowu się otworzyła.
Dialogue: 0,0:15:10.31,0:15:11.05,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:15:11.81,0:15:15.01,Default,Jinshi,0,0,0,,Ale nie tylko jej rana mnie martwi.
Dialogue: 0,0:15:15.53,0:15:18.10,Default,Jinshi,0,0,0,,Problemem jest również ten dziwak, Lakan.
Dialogue: 0,0:15:20.44,0:15:23.21,Default,Jinshi,0,0,0,,Wiadomo, że jest jej ojcem,
Dialogue: 0,0:15:23.21,0:15:26.52,Default,Jinshi,0,0,0,,ale widząc jej reakcje,\Ncoś musi być na rzeczy.
Dialogue: 0,0:15:30.10,0:15:31.66,Default,Jinshi,0,0,0,,Jutro wewnętrzny pałac, tak?
Dialogue: 0,0:15:32.27,0:15:32.98,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:15:36.44,0:15:39.51,Default,Gaoshun,0,0,0,,Nie powinno być\Nżadnych problemów. Jak zawsze.
Dialogue: 0,0:15:40.13,0:15:42.50,Default,Jinshi,0,0,0,,Znowu ten paskudny smak.
Dialogue: 0,0:15:46.34,0:15:49.15,Default,Gaoshun,0,0,0,,Nikt cię nie zmusza, byś to pił.
Dialogue: 0,0:15:49.15,0:15:52.30,Default,Jinshi,0,0,0,,Robiąc za eunucha, nie mam wyjścia.
Dialogue: 0,0:15:52.30,0:15:56.13,Default,Gaoshun,0,0,0,,Przy ludziach też\Nnie powinieneś zakrywać nosa.
Dialogue: 0,0:15:56.78,0:15:58.97,Default,Gaoshun,0,0,0,,Dzięki temu wyglądasz bardzo młodo.
Dialogue: 0,0:15:58.97,0:16:00.27,Default,Jinshi,0,0,0,,Wiem o tym.
Dialogue: 0,0:16:00.81,0:16:05.52,Default,Jinshi,0,0,0,,Doskonałe maniery, niebiański\Nuśmiech i głos słodki jak miód.
Dialogue: 0,0:16:06.38,0:16:10.54,Default,Jinshi,0,0,0,,Gdy obecny cesarz wszedł na tron\Ni otrzymał wewnętrzny pałac,
Dialogue: 0,0:16:10.54,0:16:12.52,Default,Jinshi,0,0,0,,pewien 24-latek został eunuchem.
Dialogue: 0,0:16:12.83,0:16:14.53,Default,Jinshi,0,0,0,,To właśnie „Jinshi”.
Dialogue: 0,0:16:15.14,0:16:17.67,Default,Jinshi,0,0,0,,Od momentu, gdy postanowiłem\Nprzywdziać tę maskę,
Dialogue: 0,0:16:18.36,0:16:22.54,Default,Jinshi,0,0,0,,każdego dnia piję ten lek,\Nktóry tłamsi mój popęd seksualny.
Dialogue: 0,0:16:22.89,0:16:25.25,Default,Gaoshun,0,0,0,,Pewnego dnia naprawdę\Nstaniesz się impotentem.
Dialogue: 0,0:16:28.25,0:16:30.12,Default,Jinshi,0,0,0,,I kto to mówi!
Dialogue: 0,0:16:30.12,0:16:35.34,Default,Gaoshun,0,0,0,,Moje dzieci są dorosłe.\NDoczekałem się nawet wnuka.
Dialogue: 0,0:16:36.15,0:16:38.56,Default,Jinshi,0,0,0,,Wnuka? Od starszego syna?
Dialogue: 0,0:16:39.09,0:16:44.01,Default,Gaoshun,0,0,0,,Tak. Mój najmłodszy też\Njest gotowy do ślubu, ale...
Dialogue: 0,0:16:44.01,0:16:47.40,Default,Jinshi,0,0,0,,Masz na myśli Basena?\NTo zaledwie dziewiętnastolatek.
Dialogue: 0,0:16:48.09,0:16:52.57,Default,Gaoshun,0,0,0,,Tak. Tak samo jak i ty.
Dialogue: 0,0:16:53.79,0:16:56.25,Default,Jinshi,0,0,0,,„Eunuch Jinshi” ma dwadzieścia cztery lata.
Dialogue: 0,0:16:58.37,0:17:03.75,Default,Jinshi,0,0,0,,Twoim zdaniem powinienem znaleźć\Nsobie żonę i skończyć z tą harówką.
Dialogue: 0,0:17:04.43,0:17:06.67,Default,Gaoshun,0,0,0,,Chciałbym spędzić trochę\Nczasu z moim wnukiem.
Dialogue: 0,0:17:07.74,0:17:08.95,Default,Jinshi,0,0,0,,Dam z siebie wszystko.
Dialogue: 0,0:17:22.54,0:17:25.27,Default,Loulan,0,0,0,,Witamy, panie Jinshi.
Dialogue: 0,0:17:25.27,0:17:28.02,Default,Jinshi,0,0,0,,Widzę kolejna wspaniała stylizacja.
Dialogue: 0,0:17:28.94,0:17:30.52,Default,Loulan,0,0,0,,Dziękuję.
Dialogue: 0,0:17:31.35,0:17:32.05,Default,Loulan,0,0,0,,Jinshi...
Dialogue: 0,0:17:32.05,0:17:34.96,Default,Jinshi,0,0,0,,Co prawda cesarz często\Nodwiedza konkubinę Loulan,
Dialogue: 0,0:17:34.96,0:17:37.07,Default,Jinshi,0,0,0,,ale chyba nie pociąga go za bardzo.
Dialogue: 0,0:17:37.77,0:17:42.49,Default,Jinshi,0,0,0,,Konkubina Loulan uwielbia modę,\Nczęsto zmieniając uczesanie i makijaże.
Dialogue: 0,0:17:42.95,0:17:47.36,Default,Jinshi,0,0,0,,Za każdym razem, gdy ją odwiedza,\Nnie umie jej rozpoznać i jest skołowany.
Dialogue: 0,0:17:48.34,0:17:51.75,Default,Jinshi,0,0,0,,Mimo to odwiedza\Nją raz na dziesięć dni.
Dialogue: 0,0:17:52.39,0:17:55.69,Default,Jinshi,0,0,0,,Ojciec konkubiny Loulan jest ważnym\Nurzędnikiem wysokiej rangi,
Dialogue: 0,0:17:55.69,0:17:57.56,Default,Jinshi,0,0,0,,ulubieniec poprzedniej cesarzowej.
Dialogue: 0,0:17:57.56,0:18:00.01,Default,Jinshi,0,0,0,,Musi przy niej uważać.
Dialogue: 0,0:18:02.13,0:18:05.18,Default,Jinshi,0,0,0,,Podobnie jest w przypadku\Nkonkubiny Li Shu.
Dialogue: 0,0:18:05.86,0:18:09.63,Default,Jinshi,0,0,0,,Obecny cesarz gardzi gustem swojego\Nojca pod względem młodszych panienek.
Dialogue: 0,0:18:10.04,0:18:12.37,Default,Jinshi,0,0,0,,Nie tknie palcem konkubiny Li Shu.
Dialogue: 0,0:18:13.18,0:18:14.56,Default,Jinshi,0,0,0,,Gdy rodziła Cesarzowa Wdowa,
Dialogue: 0,0:18:14.56,0:18:16.67,Default,Jinshi,0,0,0,,była jeszcze nastolatką,
Dialogue: 0,0:18:16.67,0:18:20.35,Default,Jinshi,0,0,0,,a kilkanaście lat później\Nurodziła kolejne dziecko.
Dialogue: 0,0:18:21.49,0:18:25.02,Default,Jinshi,0,0,0,,Wtedy lekarz poświęcił cały\Nswój czas na opiekę nad cesarzową,
Dialogue: 0,0:18:25.69,0:18:28.83,Default,Jinshi,0,0,0,,dlatego poród odbył się bez komplikacji.
Dialogue: 0,0:18:29.22,0:18:35.93,Default,Jinshi,0,0,0,,Niemniej jednak konkubina A Duo,\Nrodząca mniej więcej w tym samym czasie,
Dialogue: 0,0:18:35.93,0:18:39.24,Default,Jinshi,0,0,0,,nie otrzymała żadnej pomocy,\Nw wyniku czego straciła macicę.
Dialogue: 0,0:18:39.24,0:18:43.07,Default,Jinshi,0,0,0,,Niedługo później pierworodny\Npotomek cesarza zmarł.
Dialogue: 0,0:18:44.29,0:18:47.47,Default,Jinshi,0,0,0,,Gdyby to dziecko przeżyło...
Dialogue: 0,0:18:49.90,0:18:51.53,Default,Jinshi,0,0,0,,Nie, nie ma co gdybać.
Dialogue: 0,0:18:55.22,0:18:59.15,Default,Jinshi,0,0,0,,Niech spłodzi sobie\Nszybko nowego dziedzica.
Dialogue: 0,0:19:00.30,0:19:02.49,Default,Gyokuyou,0,0,0,,O, już jesteś.
Dialogue: 0,0:19:03.05,0:19:05.69,Default,Jinshi,0,0,0,,Wyglądasz na wyczerpaną.
Dialogue: 0,0:19:05.69,0:19:08.75,Default,Hongniang,0,0,0,,Dobra, wracamy do pracy.
Dialogue: 0,0:19:08.75,0:19:10.48,Default,Yinghua; Guiyuan; Ailan,0,0,0,,Tak.
Dialogue: 0,0:19:11.72,0:19:12.94,Default,Gyokuyou,0,0,0,,Szczerze mówiąc...
Dialogue: 0,0:19:17.37,0:19:18.76,Default,Maomao,0,0,0,,Wewnętrzny pałac?
Dialogue: 0,0:19:18.76,0:19:22.80,Default,Jinshi,0,0,0,,Tak. Konkubina Gyokuyou\Nnie dostała okresu.
Dialogue: 0,0:19:23.25,0:19:27.66,Default,Maomao,0,0,0,,Okresu? Krótko mówiąc,\Nmoże być w ciąży.
Dialogue: 0,0:19:28.47,0:19:29.98,Default,Maomao,0,0,0,,Od kiedy?
Dialogue: 0,0:19:30.41,0:19:31.98,Default,Jinshi,0,0,0,,Możesz zacząć od dzisiaj?
Dialogue: 0,0:19:32.28,0:19:33.24,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:19:33.24,0:19:34.17,Default,Jinshi,0,0,0,,Liczę na ciebie.
Dialogue: 0,0:19:36.73,0:19:38.78,Default,Maomao,0,0,0,,Dla mnie to dobra okazja.
Dialogue: 0,0:19:38.78,0:19:41.32,Default,Maomao,0,0,0,,Mężczyźni nie mają wstępu\Ndo wewnętrznego pałacu.
Dialogue: 0,0:19:41.32,0:19:45.41,Default,Maomao,0,0,0,,Nie ma mowy, że wpadnę na tego\Ntypa, którego nie chcę znać.
Dialogue: 0,0:19:46.54,0:19:49.75,Default,Maomao,0,0,0,,Czyżby pan Jinshi się\No mnie troszczył?
Dialogue: 0,0:19:49.75,0:19:53.02,Default,Maomao,0,0,0,,Tak czy siak,\Nznowu popróbuję trucizn!
Dialogue: 0,0:19:53.47,0:19:55.71,Default,Suiren,0,0,0,,No proszę,\Nkomuś tu humorek dopisuje.
Dialogue: 0,0:19:55.71,0:19:58.26,Default,Maomao,0,0,0,,Co? Wydaje ci się!
Dialogue: 0,0:19:58.26,0:20:03.85,Default,Suiren,0,0,0,,Jaka szkoda. Myślałam, że cieszysz\Nsię na kolejną ciężką harówkę.
Dialogue: 0,0:20:03.85,0:20:04.95,Default,Suiren,0,0,0,,Co nie?
Dialogue: 0,0:20:08.44,0:20:12.81,Default,Maomao,0,0,0,,Życie w wewnętrznym pałacu\Nnie zmieniło się od poprzedniego razu.
Dialogue: 0,0:20:12.81,0:20:15.10,Default,Maomao,0,0,0,,Ponownie całe dnie testuję żarełko.
Dialogue: 0,0:20:15.83,0:20:17.19,Default,Maomao,0,0,0,,Nie jest zatrute.
Dialogue: 0,0:20:17.57,0:20:21.50,Default,Maomao,0,0,0,,Poza przerwą w menstruacji,\Nnie ma żadnych konkretnych dowodów.
Dialogue: 0,0:20:25.19,0:20:27.49,Default,Maomao,0,0,0,,Myślałam o tym już przy\Nsprawie pani A Duo...
Dialogue: 0,0:20:27.79,0:20:30.74,Default,Maomao,0,0,0,,Może jednak cesarzowi,\Nnie tylko jedno w głowie.
Dialogue: 0,0:20:34.97,0:20:38.75,Default,Maomao,0,0,0,,Gdy służąca radą,\Nkonkubina A Duo odeszła z pałacu,
Dialogue: 0,0:20:39.09,0:20:45.26,Default,Maomao,0,0,0,,zastąpiła ją ekstrawagancka panienka,\Nzdolna namieszać w pałacu...
Dialogue: 0,0:20:45.55,0:20:49.75,Default,Maomao,0,0,0,,Nie wolno jej ignorować, a jednak mogłaby\Nnarobić kłopotów, gdyby urodziła dziecko...
Dialogue: 0,0:20:50.55,0:20:52.78,Default,Maomao,0,0,0,,Bólu głowy można od tego dostać.
Dialogue: 0,0:20:53.23,0:20:54.85,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:20:54.29,0:20:55.81,Default,Servant Girl B,0,0,0,,Ej, słyszałaś?
Dialogue: 0,0:20:56.09,0:20:58.19,Default,Servant Girl A,0,0,0,,Co? Jedna z Trzech Księżniczek?
Dialogue: 0,0:20:58.19,0:21:00.73,Default,Servant Girl B,0,0,0,,Tak! Będzie wykupiona!
Dialogue: 0,0:21:01.51,0:21:03.98,Default,Lihaku,0,0,0,,Wykupiona?
Dialogue: 0,0:22:34.95,0:22:49.97,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.30,0:22:49.97,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Jak wykupić kurtyzanę?”.
Dialogue: 0,0:22:46.59,0:22:49.97,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
