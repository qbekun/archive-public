Dialogue: 0,0:00:04.56,0:00:08.36,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:34.55,0:01:37.30,Default,Lady-in-Waiting 1,0,0,0,,Nie ma za grosz przyzwoitości.
Dialogue: 0,0:01:37.89,0:01:39.87,Default,Lady-in-Waiting 2,0,0,0,,Jest bardzo wybredna.
Dialogue: 0,0:01:41.54,0:01:43.69,Default,Kanan,0,0,0,,Przecież to jej nie zabije ani nic.
Dialogue: 0,0:01:46.71,0:01:50.54,Default,Text,0,0,0,,{\an8}ODCINEK 6: PRZYJĘCIE W OGRODZIE
Dialogue: 0,0:01:48.00,0:01:48.87,Default,Yinghua,0,0,0,,Ale zimnica!
Dialogue: 0,0:01:48.87,0:01:51.60,Default,Ailan,0,0,0,,Ogrzewacze\Nbez wątpienia pomagają, ale…
Dialogue: 0,0:01:51.60,0:01:56.07,Default,Maomao,0,0,0,,Brak zajęcia przy takim\Nmrozie to prawdziwa udręka.
Dialogue: 0,0:01:56.47,0:01:59.40,Default,Guiyuan,0,0,0,,Zimne wietrzysko!
Dialogue: 0,0:02:00.08,0:02:04.09,Default,Maomao,0,0,0,,Nie dałoby się załatwić \Njakiegoś namiotu?
Dialogue: 0,0:02:42.42,0:02:45.85,Default,Maomao,0,0,0,,To ustawienie ma na celu podsycenie\Nrywalizacji między czterema konkubinami.
Dialogue: 0,0:02:51.14,0:02:54.41,Default,Guiyuan,0,0,0,,Spójrz, to Cesarzowa Wdowa.
Dialogue: 0,0:02:54.41,0:02:57.00,Default,Maomao,0,0,0,,Wygląda bardzo młodo.
Dialogue: 0,0:02:57.00,0:03:01.82,Default,Guiyuan,0,0,0,,Jest młoda.\NUrodziła cesarza, gdy miała…
Dialogue: 0,0:03:03.44,0:03:05.78,Default,Maomao,0,0,0,,Nieźle musiała się napracować…
Dialogue: 0,0:03:05.78,0:03:12.29,Default,Guiyuan,0,0,0,,Cesarzowa ma dwoje dzieci,\Ncesarza i jego młodszego brata.
Dialogue: 0,0:03:12.29,0:03:18.30,Default,Guiyuan,0,0,0,,Plotka głosi, że brat cesarza\Njest chory i nie może opuścić domu.
Dialogue: 0,0:03:18.30,0:03:21.82,Default,Guiyuan,0,0,0,,Wydaje mi się, że był tu\Njeszcze przed chwilą…
Dialogue: 0,0:03:21.82,0:03:22.89,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:03:22.89,0:03:24.01,Default,Yinghua,0,0,0,,Co?!
Dialogue: 0,0:03:24.01,0:03:25.51,Default,Yinghua,0,0,0,,Kogo nazywasz prostaczką?!
Dialogue: 0,0:03:25.92,0:03:28.38,Default,Yinghua,0,0,0,,My, służki, służymy naszym paniom!
Dialogue: 0,0:03:28.38,0:03:30.31,Default,Yinghua,0,0,0,,Jaki jest sens przebierania się?!
Dialogue: 0,0:03:30.71,0:03:33.61,Default,Lihua's Lady-in-Waiting 2,0,0,0,,Słyszałaś to?
Dialogue: 0,0:03:33.61,0:03:38.48,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Brzydkie służące\Nto krzywda dla konkubiny.
Dialogue: 0,0:03:38.48,0:03:40.36,Default,Yinghua,0,0,0,,Ubije!
Dialogue: 0,0:03:41.40,0:03:44.82,Default,Maomao,0,0,0,,To służki pani Li Hua.
Dialogue: 0,0:03:44.82,0:03:49.80,Default,Guiyuan,0,0,0,,Och, Yinghua.\NWojna właśnie się rozpoczęła.
Dialogue: 0,0:03:49.80,0:03:51.50,Default,Guiyuan,0,0,0,,Chodźmy.
Dialogue: 0,0:03:51.50,0:03:55.79,Default,Lihua's Lady-in-Waiting 2,0,0,0,,Nic na to nie poradzicie,\Nskoro zabrałyście tę brzydulę.
Dialogue: 0,0:03:55.79,0:03:58.75,Default,Maomao,0,0,0,,„Brzydulę”? O mnie mówi?
Dialogue: 0,0:03:58.75,0:04:01.30,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Doprawdy to wstyd\Nmieć kogoś takiego.
Dialogue: 0,0:04:01.64,0:04:04.26,Default,Yinghua,0,0,0,,Coś ty powiedziała?!
Dialogue: 0,0:04:04.26,0:04:05.60,Default,Ailan,0,0,0,,Yinghua!
Dialogue: 0,0:04:05.60,0:04:07.82,Default,Guiyuan,0,0,0,,Uspokój się!
Dialogue: 0,0:04:07.82,0:04:13.10,Default,Maomao,0,0,0,,Nie zauważyły? Po całej frajdzie,\Nktórą przeżyłyśmy w Kryształowym Pałacu…
Dialogue: 0,0:04:13.56,0:04:18.06,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Jak nadal będziesz się tak zachowywać,\Ndoniosę na ciebie mojemu ojcu!
Dialogue: 0,0:04:21.40,0:04:25.11,Default,Maomao,0,0,0,,Wtedy zrobię z twoim ciałem rzeczy,\No których wolałabyś mu nie wspominać.
Dialogue: 0,0:04:26.87,0:04:29.87,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Nieee!
Dialogue: 0,0:04:31.76,0:04:34.54,Default,Maomao,0,0,0,,Taki żarcik w stylu kurtyzany.
Dialogue: 0,0:04:37.44,0:04:40.64,Default,Yinghua,0,0,0,,Przeproś Maomao!
Dialogue: 0,0:04:50.56,0:04:52.64,Default,Yinghua,0,0,0,,Co? Nagle ci mowę odjęło?
Dialogue: 0,0:04:52.64,0:04:55.68,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Na razie chyba wystarczy!
Dialogue: 0,0:04:57.40,0:04:59.75,Default,Lihua's Lady-in-Waiting 3,0,0,0,,Powinnaś być mi wdzięczna!
Dialogue: 0,0:05:00.61,0:05:02.64,Default,Yinghua,0,0,0,,Co ją ugryzło?
Dialogue: 0,0:05:02.64,0:05:05.15,Default,Yinghua,0,0,0,,Hej, Maomao, w porządku?
Dialogue: 0,0:05:05.15,0:05:08.33,Default,Yinghua,0,0,0,,Masz taką ładną buźkę,\Na te tyranki…
Dialogue: 0,0:05:08.33,0:05:12.83,Default,Maomao,0,0,0,,Nie obchodzi mnie to. Czy nie czas\Nna wymianę kamieni w ogrzewaczach?
Dialogue: 0,0:05:14.29,0:05:16.30,Default,Ailan,0,0,0,,Nie dość, że dorastała w biedzie,
Dialogue: 0,0:05:16.30,0:05:19.78,Default,Ailan,0,0,0,,to jeszcze jej nieufność wobec\Nmężczyzn szkodzi jej urodzie…
Dialogue: 0,0:05:20.24,0:05:25.46,Default,Guiyuan,0,0,0,,I do tego przez dwa miesiące cierpiała\Nkatusze w Kryształowym Pałacu…
Dialogue: 0,0:05:25.76,0:05:30.18,Default,Yinghua,0,0,0,,A jednak w ogóle nie narzeka,\Na nawet troszczy się o nas…
Dialogue: 0,0:05:30.68,0:05:35.56,Default,Ailan; Yinghua; Guiyuan,0,0,0,,To oczywiste, że dobrotliwy\Npan Jinshi się o nią troszczy!
Dialogue: 0,0:05:36.12,0:05:39.02,Default,Maomao,0,0,0,,Znowu śnią na jawie.
Dialogue: 0,0:05:43.36,0:05:47.49,Default,Ah-Duo's Lady-in-Waiting 1,0,0,0,,Za grosz w was godności.\NSukienka w takim kolorze?
Dialogue: 0,0:05:47.84,0:05:50.16,Default,Maomao,0,0,0,,Wojna trwa dalej.
Dialogue: 0,0:05:50.16,0:05:52.24,Default,Yinghua,0,0,0,,To służki Cnotliwej i Dobrej Damy.
Dialogue: 0,0:05:52.54,0:05:55.00,Default,Yinghua,0,0,0,,One też się nie dogadują.
Dialogue: 0,0:05:55.80,0:05:58.70,Default,Yinghua,0,0,0,,Nic dziwnego, że między 14-letnią\NCnotliwą Damą
Dialogue: 0,0:05:58.70,0:06:01.69,Default,Yinghua,0,0,0,,a 35-letnią Czystą Damą,\Nktóra jest tu od wielu lat
Dialogue: 0,0:06:01.69,0:06:03.72,Default,Yinghua,0,0,0,,dochodzi do wielu spięć.
Dialogue: 0,0:06:03.72,0:06:06.47,Default,Guiyuan,0,0,0,,Co więcej, były synową i teściową.
Dialogue: 0,0:06:06.84,0:06:08.32,Default,Maomao,0,0,0,,Synową i teściową?
Dialogue: 0,0:06:08.32,0:06:11.55,Default,Guiyuan,0,0,0,,To nieco skomplikowane.
Dialogue: 0,0:06:11.96,0:06:14.89,Default,Guiyuan,0,0,0,,Jedna z nich była\Nkonkubiną poprzedniego cesarza,
Dialogue: 0,0:06:14.89,0:06:18.25,Default,Guiyuan,0,0,0,,a druga konkubiną obecnego cesarza.
Dialogue: 0,0:06:18.25,0:06:21.45,Default,Guiyuan,0,0,0,,Jednakże poprzedni\Ncesarz umarł, czyż nie?
Dialogue: 0,0:06:21.45,0:06:24.36,Default,Yinghua,0,0,0,,Zgodnie z tradycją, po jego śmierci\Nrozpoczęła żałobę,
Dialogue: 0,0:06:24.36,0:06:28.06,Default,Yinghua,0,0,0,,by następnie wrócić do obecnego cesarza.
Dialogue: 0,0:06:28.06,0:06:30.80,Default,Maomao,0,0,0,,Poprzedni cesarz zmarł pięć lat temu.
Dialogue: 0,0:06:30.80,0:06:34.56,Default,Maomao,0,0,0,,Jeśli się nie mylę, pani A Duo\Nmiała trzydziechę na karku,
Dialogue: 0,0:06:33.62,0:06:38.04,Default,Text,0,0,0,,{\an8}30 LAT
Dialogue: 0,0:06:34.56,0:06:38.04,Default,Maomao,0,0,0,,a konkubina Li Shu zaledwie dziewięć.
Dialogue: 0,0:06:36.87,0:06:38.04,Default,Text,0,0,0,,{\an8}9 LAT
Dialogue: 0,0:06:38.04,0:06:41.24,Default,Maomao,0,0,0,,Związek polityczny czy nie,\Nprzyprawia mnie o dreszcze.
Dialogue: 0,0:06:41.24,0:06:45.68,Default,Yinghua,0,0,0,,Nieprawdopodobne, prawda?\NZostać teściową w wieku dziewięciu lat.
Dialogue: 0,0:06:45.68,0:06:48.60,Default,Maomao,0,0,0,,Dziewięć… Teścio…
Dialogue: 0,0:06:49.77,0:06:51.54,Default,Maomao,0,0,0,,Teściową?!
Dialogue: 0,0:06:54.55,0:06:59.19,Default,Maomao,0,0,0,,Więc konkubiną byłego\Ncesarza była pani Li Shu?
Dialogue: 0,0:07:16.60,0:07:18.83,Default,Maomao,0,0,0,,Więc to ona jest tą słynną teściową?
Dialogue: 0,0:07:19.36,0:07:25.13,Default,Hongniang,0,0,0,,Pewnie zauważyłaś, że pani Li Shu\Njest jeszcze dość młoda.
Dialogue: 0,0:07:25.13,0:07:26.59,Default,Maomao,0,0,0,,Nie da się ukryć.
Dialogue: 0,0:07:27.06,0:07:30.86,Default,Maomao,0,0,0,,Naturalnie, że do Cnotliwej\NDamy pasowałaby biała suknia,
Dialogue: 0,0:07:30.86,0:07:32.86,Default,Maomao,0,0,0,,ale róż, który nosi…
Dialogue: 0,0:07:32.86,0:07:36.05,Default,Maomao,0,0,0,,Jest podobny do czerwieni\Npani Gyokuyou, Szlachetnej Damy.
Dialogue: 0,0:07:36.48,0:07:38.94,Default,Maomao,0,0,0,,Chyba jest na bakier z etykietą.
Dialogue: 0,0:07:42.08,0:07:45.77,Default,Hongniang,0,0,0,,Te gorące kamienie to zbawienie.\NDziękuję bardzo.
Dialogue: 0,0:07:45.77,0:07:46.80,Default,Maomao,0,0,0,,Jasne.
Dialogue: 0,0:07:49.91,0:07:50.94,Default,Lihua's Ladies-in-Waiting,0,0,0,,Ale zimnica…
Dialogue: 0,0:07:56.89,0:07:59.08,Default,Maomao,0,0,0,,Weźcie je, rozgrzeją was.
Dialogue: 0,0:08:03.41,0:08:04.48,Default,Maomao,0,0,0,,Macie.
Dialogue: 0,0:08:05.38,0:08:06.40,Default,Maomao,0,0,0,,No bierzcie!
Dialogue: 0,0:08:14.71,0:08:16.14,Default,Yinghua,0,0,0,,Nie chowasz urazy.
Dialogue: 0,0:08:16.14,0:08:20.08,Default,Yinghua,0,0,0,,Chciałaś nawet podzielić się naszymi\Nkamieniami z tymi żmijami…
Dialogue: 0,0:08:20.08,0:08:23.15,Default,Ailan,0,0,0,,I pani Gyokuyou nie oponowała.
Dialogue: 0,0:08:23.15,0:08:24.35,Default,Maomao,0,0,0,,No cóż…
Dialogue: 0,0:08:27.77,0:08:29.16,Default,Maomao,0,0,0,,Spinka?
Dialogue: 0,0:08:29.16,0:08:34.28,Default,Yinghua,0,0,0,,Dzięki temu werbują do siebie\Nutalentowane służki z kwiatowego ogrodu.
Dialogue: 0,0:08:34.28,0:08:35.52,Default,Maomao,0,0,0,,Aha.
Dialogue: 0,0:08:35.52,0:08:38.24,Default,Yinghua,0,0,0,,Posiada jednak\Njeszcze ukryte znaczenie.
Dialogue: 0,0:08:38.72,0:08:40.32,Default,Maomao,0,0,0,,Rozumiem.
Dialogue: 0,0:08:40.32,0:08:42.41,Default,Yinghua,0,0,0,,Mówię, że jest jeszcze inne znaczenie!
Dialogue: 0,0:08:44.87,0:08:47.00,Default,Maomao,0,0,0,,Znaczenie?
Dialogue: 0,0:08:53.14,0:08:55.47,Default,Lihaku,0,0,0,,Proszę, weź to, młoda damo.
Dialogue: 0,0:09:00.98,0:09:05.30,Default,Maomao,0,0,0,,Zgaduję, że rozdaje je każdemu,\Naby nikt nie czuł się urażony.
Dialogue: 0,0:09:08.56,0:09:13.19,Default,Maomao,0,0,0,,— Dziękuję.\N— Jestem Lihaku! Miło mi!
Dialogue: 0,0:09:15.76,0:09:16.92,Default,Maomao,0,0,0,,Dobry piesek.
Dialogue: 0,0:09:16.92,0:09:18.00,Default,Lihaku,0,0,0,,Hafo! Hafo!
Dialogue: 0,0:09:18.11,0:09:20.28,Default,Yinghua,0,0,0,,Dostałaś coś? Pokaż, pokaż!
Dialogue: 0,0:09:20.79,0:09:22.66,Default,Maomao,0,0,0,,Nagroda pocieszenia.
Dialogue: 0,0:09:23.13,0:09:25.25,Default,Lihua,0,0,0,,Myślę, że zasługujesz na więcej.
Dialogue: 0,0:09:30.04,0:09:31.38,Default,Lihua,0,0,0,,Dawno się nie widziałyśmy.
Dialogue: 0,0:09:31.38,0:09:33.38,Default,Maomao,0,0,0,,Zgadza się, moja pani.
Dialogue: 0,0:09:40.21,0:09:42.26,Default,Lihua,0,0,0,,To wszystko na dzisiaj.
Dialogue: 0,0:09:42.26,0:09:43.58,Default,Lihua's Lady-in-Waiting 2,0,0,0,,Pani Li Hua?!
Dialogue: 0,0:09:44.61,0:09:47.66,Default,Lihua,0,0,0,,Chodźmy. Miłego dnia.
Dialogue: 0,0:09:51.36,0:09:53.32,Default,Guiyuan,0,0,0,,Pani Gyokuyou się to nie spodoba.
Dialogue: 0,0:09:54.32,0:09:56.40,Default,Yinghua,0,0,0,,To mało powiedziane.
Dialogue: 0,0:09:57.74,0:09:59.62,Default,Ailan,0,0,0,,Co zrobisz z tymi wszystkimi spinkami?
Dialogue: 0,0:10:11.97,0:10:13.21,Default,Maomao,0,0,0,,Oł.
Dialogue: 0,0:10:15.24,0:10:17.91,Default,Maomao,0,0,0,,Całkiem nieźle to wygląda.
Dialogue: 0,0:10:19.12,0:10:21.99,Default,Maomao,0,0,0,,Chyba jest wyżej, niż myślałam.
Dialogue: 0,0:10:21.99,0:10:25.27,Default,Maomao,0,0,0,,Doskonale wtapia się w tłum oficerów.
Dialogue: 0,0:10:26.53,0:10:29.16,Default,Maomao,0,0,0,,O, to ten oficer z wcześniej.
Dialogue: 0,0:10:29.16,0:10:32.77,Default,Maomao,0,0,0,,To najmłodszy z gości w pierwszych\Nrzędach, a i tak robi wrażenie.
Dialogue: 0,0:10:34.10,0:10:38.71,Default,Maomao,0,0,0,,To żadna strata,\Nże nasz piękniś się nie pojawił.
Dialogue: 0,0:10:44.98,0:10:46.87,Default,Maomao,0,0,0,,Ważniejsze jest próbowanie jedzonka.
Dialogue: 0,0:10:50.24,0:10:52.63,Default,Maomao,0,0,0,,Ścianki nie mętnieją po nalaniu.
Dialogue: 0,0:10:55.04,0:10:56.76,Default,Maomao,0,0,0,,Żadnych dziwnych zapachów.
Dialogue: 0,0:10:58.13,0:11:02.55,Default,Maomao,0,0,0,,Połykanie to część pracy testerki…
Dialogue: 0,0:11:05.64,0:11:09.21,Default,Maomao,0,0,0,,Teraz przepłukać usta wodą… Co?
Dialogue: 0,0:11:20.29,0:11:24.39,Default,Maomao,0,0,0,,Życie testerki jest bezcenne.
Dialogue: 0,0:11:24.92,0:11:28.02,Default,Maomao,0,0,0,,Chyba tylko mnie się to podoba.
Dialogue: 0,0:11:28.02,0:11:30.70,Default,Maomao,0,0,0,,Ryba rozdymka byłaby pyszna.
Dialogue: 0,0:11:30.70,0:11:33.50,Default,Maomao,0,0,0,,Wrzucić trochę wnętrzności do zupy…
Dialogue: 0,0:11:34.00,0:11:38.21,Default,Maomao,0,0,0,,To szczypanie na języku\Njest takie cudowne.
Dialogue: 0,0:11:43.46,0:11:44.93,Default,Maomao,0,0,0,,Skup się.
Dialogue: 0,0:11:44.93,0:11:48.18,Default,Maomao,0,0,0,,Ta surowa ryba w occie\Njest ulubionym daniem cesarza.
Dialogue: 0,0:11:48.61,0:11:50.73,Default,Maomao,0,0,0,,Parę razy widziałam\Nto w wewnętrznym pałacu.
Dialogue: 0,0:11:50.73,0:11:55.69,Default,Maomao,0,0,0,,Zazwyczaj jest to tłusta rybka,\Nale dziś dali meduzy.
Dialogue: 0,0:11:56.00,0:11:58.52,Default,Maomao,0,0,0,,Kucharz przygotowujący\Nposiłki dla cesarza
Dialogue: 0,0:11:58.52,0:12:01.19,Default,Maomao,0,0,0,,nigdy nie pomyliłby\Njego ulubionego składnika.
Dialogue: 0,0:12:01.80,0:12:04.84,Default,Maomao,0,0,0,,Pani Gyokuyou też nie ma\Nspecjalnych preferencji.
Dialogue: 0,0:12:05.33,0:12:08.20,Default,Maomao,0,0,0,,Danie to chyba\Nnie jest przeznaczone dla niego.
Dialogue: 0,0:12:24.61,0:12:27.34,Default,Maomao,0,0,0,,Zgaduję, że nie lubi ryb.
Dialogue: 0,0:12:27.77,0:12:31.73,Default,Maomao,0,0,0,,W obecności cesarza nie może\Nodmówić spożycia posiłku.
Dialogue: 0,0:12:38.29,0:12:40.19,Default,Maomao,0,0,0,,Żałuję, że to widziałam.
Dialogue: 0,0:12:42.94,0:12:44.73,Default,Military Official 1,0,0,0,,Widziałeś to, Lihaku?
Dialogue: 0,0:12:44.73,0:12:47.31,Default,Military Official 1,0,0,0,,Jedna z testerek \Njest naprawdę podniecona.
Dialogue: 0,0:12:47.31,0:12:52.17,Default,Lihaku,0,0,0,,Nie wiem, co fajnego jest w patrzeniu,\Njak jedzą ze ściśniętym żołądkiem.
Dialogue: 0,0:12:52.17,0:12:54.09,Default,Military Official 1,0,0,0,,No weź, tylko spójrz.
Dialogue: 0,0:12:55.70,0:13:00.04,Default,Lihaku,0,0,0,,Co? Ta testerka…\Nto dziewczyna z wcześniej.
Dialogue: 0,0:13:23.75,0:13:26.07,Default,Lihaku,0,0,0,,Jak bardzo musi to być pyszne?
Dialogue: 0,0:13:35.01,0:13:37.75,Default,Maomao,0,0,0,,To jest zatrute.
Dialogue: 0,0:13:43.42,0:13:45.12,Default,Crowd,0,0,0,,Zupa Damy jest zatruta?!
Dialogue: 0,0:13:45.12,0:13:47.09,Default,Minister,0,0,0,,- Zatruta?! Jesteś pewna?
Dialogue: 0,0:13:45.39,0:13:47.09,Default,Crowd,0,0,0,,{\an8}- Konkubinę Gyokuyou?!
Dialogue: 0,0:13:47.09,0:13:49.34,Default,Minister,0,0,0,,Testerka to połknęła!
Dialogue: 0,0:13:49.34,0:13:50.52,Default,Crowd,0,0,0,,Ministrze!
Dialogue: 0,0:13:50.52,0:13:51.72,Default,Crowd,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:13:52.00,0:13:54.30,Default,Jinshi,0,0,0,,Ten strój jest bardzo krępujący.
Dialogue: 0,0:13:56.34,0:13:59.48,Default,Lihaku,0,0,0,,Ej! Minister zjadł zupę i padł!
Dialogue: 0,0:14:03.68,0:14:05.00,Default,Jinshi,0,0,0,,Zielareczka…
Dialogue: 0,0:14:10.37,0:14:11.45,Default,Jinshi,0,0,0,,Zielareczko!
Dialogue: 0,0:14:12.28,0:14:14.87,Default,Maomao,0,0,0,,Dzień dobry, panie Jinshi.
Dialogue: 0,0:14:15.37,0:14:17.29,Default,Jinshi,0,0,0,,Widzę lepszy niż mój.
Dialogue: 0,0:14:18.12,0:14:21.96,Default,Maomao,0,0,0,,Rany, podnieciłam się trucizną i wyszło,\Njakbym się do niego wyszczerzyła.
Dialogue: 0,0:14:25.73,0:14:27.34,Default,Maomao,0,0,0,,Co ty robisz?
Dialogue: 0,0:14:27.34,0:14:28.90,Default,Jinshi,0,0,0,,Zabieram cię do medyka!
Dialogue: 0,0:14:29.38,0:14:33.26,Default,Maomao,0,0,0,,Wyplułam truciznę. Dobrze się czuję.
Dialogue: 0,0:14:34.18,0:14:37.82,Default,Maomao,0,0,0,,Z chęcią bym ją połknęła.
Dialogue: 0,0:14:37.82,0:14:42.02,Default,Maomao,0,0,0,,Gdybym to zrobiła, trucizna już\Ndawno przeszyłaby moje ciało i…
Dialogue: 0,0:14:42.02,0:14:44.41,Default,Maomao,0,0,0,,Panie Jinshi, ja…
Dialogue: 0,0:14:45.17,0:14:48.39,Default,Jinshi,0,0,0,,— Co jest?\N— Mogę dojeść zupkę?
Dialogue: 0,0:14:50.14,0:14:52.24,Default,Jinshi,0,0,0,,Ty idiotko.
Dialogue: 0,0:14:52.24,0:14:55.02,Default,Maomao,0,0,0,,Chcę dopiąć sprawę do końca.
Dialogue: 0,0:14:56.61,0:15:01.98,Default,Jinshi,0,0,0,,Gdy wyszłaś, ktoś sprawdził,\Nczy zupa jest zatruta, i zasłabł.
Dialogue: 0,0:15:01.98,0:15:04.49,Default,Maomao,0,0,0,,Co to za głupiec?
Dialogue: 0,0:15:04.49,0:15:08.09,Default,Jinshi,0,0,0,,Minister. Zrobiła się z tego \Nniezła jatka.
Dialogue: 0,0:15:09.76,0:15:12.12,Default,Maomao,0,0,0,,Użyj tego.
Dialogue: 0,0:15:12.47,0:15:13.77,Default,Maomao,0,0,0,,To środek wymiotny.
Dialogue: 0,0:15:13.77,0:15:17.15,Default,Maomao,0,0,0,,Wywar, od którego skręca cię w żołądku.
Dialogue: 0,0:15:17.15,0:15:18.60,Default,Jinshi,0,0,0,,Czy to też trucizna?
Dialogue: 0,0:15:27.35,0:15:29.36,Default,Maomao,0,0,0,,Nowa spinka?
Dialogue: 0,0:15:29.96,0:15:32.92,Default,Maomao,0,0,0,,Więc eunuchowie też dostają spinki?
Dialogue: 0,0:15:32.92,0:15:38.07,Default,Maomao,0,0,0,,Jego kołnierz też jest trochę potargany.\NPoza tym zniknął jego typowy urok.
Dialogue: 0,0:15:39.52,0:15:43.29,Default,Maomao,0,0,0,,To dlatego nie było go na przyjęciu?
Dialogue: 0,0:15:44.00,0:15:47.80,Default,Maomao,0,0,0,,Teraz jednak bardziej\Nzachowuje się jak na swój wiek…
Dialogue: 0,0:15:48.85,0:15:52.34,Default,Maomao,0,0,0,,Tak jakby trochę odmłodniał.
Dialogue: 0,0:15:54.63,0:15:57.00,Default,Maomao,0,0,0,,Taki mi bardziej odpowiada.
Dialogue: 0,0:16:03.16,0:16:04.32,Default,Maomao,0,0,0,,Naprawdę działa!
Dialogue: 0,0:16:04.32,0:16:07.27,Default,Maomao,0,0,0,,Leki z pałacu cesarskiego są wybitne!
Dialogue: 0,0:16:08.93,0:16:10.24,Default,Jinshi,0,0,0,,Nic ci nie jest?
Dialogue: 0,0:16:12.80,0:16:15.07,Default,Maomao,0,0,0,,Tak, jestem pusta.
Dialogue: 0,0:16:17.14,0:16:23.36,Default,Jinshi,0,0,0,,Pomówmy o tym, kto chciał\Notruć konkubinę Gyokuyou.
Dialogue: 0,0:16:23.36,0:16:26.42,Default,Maomao,0,0,0,,Chciałabym z kimś o tym porozmawiać.
Dialogue: 0,0:16:27.30,0:16:28.37,Default,Jinshi,0,0,0,,Z kim?
Dialogue: 0,0:16:28.72,0:16:33.09,Default,Maomao,0,0,0,,Z Cnotliwą Damą, panią Li Shu.
Dialogue: 0,0:16:34.00,0:16:37.51,Default,Lishu,0,0,0,,Panie Jinshi, w czym mogę pomóc?
Dialogue: 0,0:16:37.94,0:16:40.97,Default,Jinshi,0,0,0,,Wybacz, że ściągnąłem cię\Ndo takiego obskurnego miejsca.
Dialogue: 0,0:16:40.97,0:16:44.50,Default,Jinshi,0,0,0,,Ta służka chciała z tobą porozmawiać.
Dialogue: 0,0:16:45.86,0:16:46.89,Default,Lishu,0,0,0,,Co?!
Dialogue: 0,0:16:47.73,0:16:50.33,Default,Lishu,0,0,0,,Zwykła służka?
Dialogue: 0,0:16:53.07,0:16:54.54,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:16:58.34,0:16:59.34,Default,Maomao,0,0,0,,Wiedziałam.
Dialogue: 0,0:17:01.17,0:17:03.04,Default,Maomao,0,0,0,,Nie możesz jeść ryb?
Dialogue: 0,0:17:06.50,0:17:08.08,Default,Jinshi,0,0,0,,Co to ma być?
Dialogue: 0,0:17:08.08,0:17:11.88,Default,Maomao,0,0,0,,Niektórzy ludzie\Nnie mogą jeść pewnych rzeczy.
Dialogue: 0,0:17:11.88,0:17:15.24,Default,Maomao,0,0,0,,Ja nie mogę jeść mąki gryczanej.
Dialogue: 0,0:17:15.24,0:17:17.63,Default,Jinshi,0,0,0,,A mimo to jesz truciznę?
Dialogue: 0,0:17:17.63,0:17:21.77,Default,Maomao,0,0,0,,Daj mi spokój.\NChciałam się uodpornić.
Dialogue: 0,0:17:22.36,0:17:27.03,Default,Maomao,0,0,0,,Jednak moje gardło napuchło\Ni ciężko było mi oddychać.
Dialogue: 0,0:17:27.61,0:17:32.32,Default,Maomao,0,0,0,,Nawet odrobina powodowała wysypkę,\Nwięc trudno było ustalić właściwe dawki,
Dialogue: 0,0:17:32.32,0:17:33.86,Default,Maomao,0,0,0,,a leczenie zajęło mi dużo czasu.
Dialogue: 0,0:17:34.36,0:17:36.86,Default,Maomao,0,0,0,,To rozumiem przez „nie możesz jeść”.
Dialogue: 0,0:17:37.32,0:17:40.87,Default,Maomao,0,0,0,,Pani Li Shu, co z twoim żołądkiem?
Dialogue: 0,0:17:41.30,0:17:42.92,Default,Maomao,0,0,0,,Dam ci ten lek, jeśli…
Dialogue: 0,0:17:47.30,0:17:48.83,Default,Lishu,0,0,0,,Skąd o tym wiesz?
Dialogue: 0,0:17:49.20,0:17:54.12,Default,Maomao,0,0,0,,Jedzenie na przyjęcie zostało \Nprzygotowane w wewnętrznym pałacu.
Dialogue: 0,0:17:54.12,0:17:58.05,Default,Maomao,0,0,0,,Jednakże danie z octem składało się\Nz innego składnika niż zwykle.
Dialogue: 0,0:17:58.05,0:18:04.05,Default,Maomao,0,0,0,,Wygląda na to, że danie pani Li Shu\Npomylono z posiłkiem pani Gyokuyou.
Dialogue: 0,0:18:04.05,0:18:05.21,Default,Lishu,0,0,0,,Rozumiem.
Dialogue: 0,0:18:05.75,0:18:08.35,Default,Maomao,0,0,0,,Czy to makreli nie możesz jeść?
Dialogue: 0,0:18:10.81,0:18:12.24,Default,Lishu,0,0,0,,Tak…
Dialogue: 0,0:18:15.50,0:18:18.68,Default,Maomao,0,0,0,,Alergie to nie kaprys.
Dialogue: 0,0:18:18.68,0:18:24.58,Default,Maomao,0,0,0,,Tym razem to tylko pokrzywka, może \Nczasem powodować trudności w oddychaniu.
Dialogue: 0,0:18:25.55,0:18:27.86,Default,Maomao,0,0,0,,Gdyby to było świadome,
Dialogue: 0,0:18:28.63,0:18:31.59,Default,Maomao,0,0,0,,byłoby to równoznaczne z otruciem jej.
Dialogue: 0,0:18:39.05,0:18:41.95,Default,Maomao,0,0,0,,Jesteś jej testerką jedzenia, prawda?
Dialogue: 0,0:18:42.68,0:18:44.52,Default,Kanan,0,0,0,,T-tak!
Dialogue: 0,0:18:45.22,0:18:49.82,Default,Maomao,0,0,0,,Opisałam szczegółowo kroki, które należy\Npodjąć w razie spożycia alergenu.
Dialogue: 0,0:18:51.56,0:18:55.07,Default,Maomao,0,0,0,,Byłoby najlepiej\Nnie dopuścić do tego ponownie.
Dialogue: 0,0:18:57.72,0:18:59.30,Default,Maomao,0,0,0,,Zapoznaj się z tym.
Dialogue: 0,0:19:02.12,0:19:04.12,Default,Maomao,0,0,0,,To nic trudnego.
Dialogue: 0,0:19:04.76,0:19:10.08,Default,Maomao,0,0,0,,Jeśli coś pójdzie nie tak, nawet\Nmedyk z pałacu tu nie pomoże.
Dialogue: 0,0:19:11.46,0:19:14.59,Default,Maomao,0,0,0,,A skutek będzie śmiertelny.
Dialogue: 0,0:19:15.60,0:19:19.70,Default,Maomao,0,0,0,,Pamiętaj o tym.
Dialogue: 0,0:19:22.92,0:19:24.85,Default,Maomao,0,0,0,,To powinno do niej dotrzeć.
Dialogue: 0,0:19:33.61,0:19:35.24,Default,Jinshi,0,0,0,,Co to było?
Dialogue: 0,0:19:36.81,0:19:41.13,Default,Maomao,0,0,0,,Jestem nisko urodzona.\NCzy mógłbyś trzymać ręce przy sobie?
Dialogue: 0,0:19:41.13,0:19:43.93,Default,Jinshi,0,0,0,,Tylko ty mi to mówisz.
Dialogue: 0,0:19:43.93,0:19:46.62,Default,Maomao,0,0,0,,Cóż, wszyscy są dla ciebie\Npo prostu mili.
Dialogue: 0,0:19:48.70,0:19:52.10,Default,Maomao,0,0,0,,Muszę złożyć raport pani Gyokuyou, więc…
Dialogue: 0,0:19:53.16,0:19:57.80,Default,Jinshi,0,0,0,,Czekaj. Dlaczego wezwałaś też testerkę?
Dialogue: 0,0:19:59.33,0:20:00.92,Default,Maomao,0,0,0,,Co masz na myśli?
Dialogue: 0,0:20:00.92,0:20:03.47,Default,Jinshi,0,0,0,,Nie zgrywaj głupiej.\NSama kazałaś ją przyprowadzić.
Dialogue: 0,0:20:03.47,0:20:06.25,Default,Maomao,0,0,0,,Aby powiedzieć jej, na co ma uważać.
Dialogue: 0,0:20:06.25,0:20:09.89,Default,Jinshi,0,0,0,,Myślisz, że naczynia zostały\Nzamienione przez pomyłkę?
Dialogue: 0,0:20:11.67,0:20:14.31,Default,Maomao,0,0,0,,Jestem tylko zwykłą służką.
Dialogue: 0,0:20:17.76,0:20:19.86,Default,Jinshi,0,0,0,,Odpowiedz mi chociaż na to pytanie.
Dialogue: 0,0:20:21.09,0:20:25.45,Default,Jinshi,0,0,0,,Celem była Cnotliwa\NDama Li Shu, prawda?
Dialogue: 0,0:20:26.55,0:20:29.29,Default,Maomao,0,0,0,,Zakładając, że nie zatruto \Npozostałych dań.
Dialogue: 0,0:20:29.80,0:20:31.03,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:20:48.18,0:20:49.72,Default,Maomao,0,0,0,,Co za dzień.
Dialogue: 0,0:20:50.77,0:20:55.95,Default,Gaoshun,0,0,0,,Czy jest to powiązane\Nze sprawą drewnianych tabliczek?
Dialogue: 0,0:20:55.95,0:21:00.02,Default,Gaoshun,0,0,0,,Służka, która przyszła wcześniej,\Nnie miała żadnych oparzeń.
Dialogue: 0,0:21:01.65,0:21:04.30,Default,Jinshi,0,0,0,,Kto to może być?
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.52,0:22:49.10,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Powrót do domu”.
Dialogue: 0,0:22:49.12,0:22:50.72,Default,,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
