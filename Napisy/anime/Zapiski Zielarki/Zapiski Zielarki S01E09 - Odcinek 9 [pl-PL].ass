Dialogue: 0,0:00:04.56,0:00:08.28,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:32.78,0:01:35.78,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:38.44,0:01:39.69,Default,Bureaucrats,0,0,0,,Takiemu nie można ufać!
Dialogue: 0,0:01:39.07,0:01:40.22,Default,Text,0,0,0,,{\an8}ODCINEK 9:\NSAMOBÓJSTWO CZY ZABÓJSTWO?
Dialogue: 0,0:01:40.30,0:01:43.37,Default,Bureaucrats,0,0,0,,To z kolei stwarza inne problemy.
Dialogue: 0,0:01:49.50,0:01:52.42,Default,Kounen,0,0,0,,Alkohol! Przynieś więcej alkoholu…
Dialogue: 0,0:01:52.75,0:01:55.48,Default,Bureaucrat A,0,0,0,,Rany, mocno się zmienił.
Dialogue: 0,0:01:55.56,0:01:59.00,Default,Bureaucrat A,0,0,0,,Patrzenie na jego gębę\Npsuje mi smak drinka.
Dialogue: 0,0:01:59.08,0:02:00.97,Default,Bureaucrat B,0,0,0,,Z tym się zgadzam.
Dialogue: 0,0:02:07.88,0:02:11.00,Default,Kounen,0,0,0,,Ej… dzięki.
Dialogue: 0,0:02:19.95,0:02:22.28,Default,Gaoshun,0,0,0,,Jak długo jeszcze będziesz się dąsał?
Dialogue: 0,0:02:22.36,0:02:23.74,Default,Jinshi,0,0,0,,Wcale się nie dąsam.
Dialogue: 0,0:02:24.00,0:02:27.08,Default,Gaoshun,0,0,0,,Proszę, nie zapominać,\Nże masz robotę do zrobienia.
Dialogue: 0,0:02:27.16,0:02:28.37,Default,Jinshi,0,0,0,,Wiem o tym.
Dialogue: 0,0:02:29.96,0:02:31.46,Default,Gaoshun,0,0,0,,A wcale, że nie.
Dialogue: 0,0:02:32.18,0:02:36.71,Default,Gaoshun,0,0,0,,Pan Jinshi nie zachowuje się\Nw tak dziecinny sposób.
Dialogue: 0,0:02:37.35,0:02:41.05,Default,Gaoshun,0,0,0,,Nigdy nie przywiązywał\Nsię tak mocno do zabawek.
Dialogue: 0,0:02:42.45,0:02:44.47,Default,Gaoshun,0,0,0,,Mam coś na rozgrzewkę.
Dialogue: 0,0:02:48.76,0:02:50.64,Default,Gaoshun,0,0,0,,Tamtego dnia sporo się namęczyłem,
Dialogue: 0,0:02:50.72,0:02:53.86,Default,Gaoshun,0,0,0,,aby pani Gyokuyou przestała się śmiać\Ni wszystko wyjaśniła.
Dialogue: 0,0:02:55.94,0:02:58.41,Default,Jinshi,0,0,0,,Nieporozumienie…?
Dialogue: 0,0:02:58.49,0:03:00.97,Default,Gaoshun,0,0,0,,Nagrodą za poręczenie
Dialogue: 0,0:03:01.05,0:03:02.62,Default,Gaoshun,0,0,0,,spotkanie z drogą kurtyzaną.
Dialogue: 0,0:03:02.70,0:03:05.55,Default,Gaoshun,0,0,0,,Nie wiedziałem,\Nże ma takie znajomości.
Dialogue: 0,0:03:05.63,0:03:08.86,Default,Gaoshun,0,0,0,,Kto wie, co on sobie wyobraził.
Dialogue: 0,0:03:10.32,0:03:11.87,Default,Gaoshun,0,0,0,,Młodość jest straszna.
Dialogue: 0,0:03:13.76,0:03:17.59,Default,Gaoshun,0,0,0,,Jednakże zasuwał jak dziki wół,\Nby skończyć pracę…
Dialogue: 0,0:03:18.07,0:03:19.80,Default,Gaoshun,0,0,0,,i iść się z nią spotkać…
Dialogue: 0,0:03:21.35,0:03:24.05,Default,Gaoshun,0,0,0,,Tylko po to, by usłyszeć,\Nże poszła z innym do domu…
Dialogue: 0,0:03:24.61,0:03:27.56,Default,Gaoshun,0,0,0,,Z pewnością był to spory cios.
Dialogue: 0,0:03:34.64,0:03:37.90,Default,Gaoshun,0,0,0,,Powinni bardziej się\Nnad tym zastanowić…
Dialogue: 0,0:03:38.39,0:03:42.92,Default,Gaoshun,0,0,0,,Wielu urzędników składa projekty ustaw,\Nktóre przyniosą im osobiste korzyści.
Dialogue: 0,0:03:43.52,0:03:48.16,Default,Gaoshun,0,0,0,,Szkoda mi mojego pana, który za te\Npsie pieniądze wykonuje dodatkową pracę.
Dialogue: 0,0:03:55.22,0:03:56.30,Default,Subordinate,0,0,0,,Panie Jinshi!
Dialogue: 0,0:03:56.38,0:03:59.47,Default,Gaoshun,0,0,0,,Pora odwiedzin skończona.\NPrzyjdź jutro.
Dialogue: 0,0:03:59.55,0:04:03.51,Default,Subordinate,0,0,0,,Nie chodzi o pracę… Cóż…
Dialogue: 0,0:04:08.45,0:04:09.60,Default,Jinshi,0,0,0,,Pan Kounen?!
Dialogue: 0,0:04:09.92,0:04:11.00,Default,Gaoshun,0,0,0,,Panie Jinshi!
Dialogue: 0,0:04:11.08,0:04:12.15,Default,Jinshi,0,0,0,,Chodźmy!
Dialogue: 0,0:04:15.46,0:04:17.86,Default,Gyokuyou,0,0,0,,To straszne wieści…
Dialogue: 0,0:04:18.31,0:04:21.36,Default,Maomao,0,0,0,,Umarł ktoś wysoko postawiony.
Dialogue: 0,0:04:21.72,0:04:25.08,Default,Maomao,0,0,0,,Może jestem bez serca,\Nale nie umiem współczuć komuś,
Dialogue: 0,0:04:25.16,0:04:27.49,Default,Maomao,0,0,0,,kogo nigdy na oczy nie widziałam.
Dialogue: 0,0:04:27.90,0:04:32.17,Default,Maomao,0,0,0,,Podobno to alkohol odebrał życie\Ntemu pięćdziesięcioletniemu facetowi.
Dialogue: 0,0:04:32.25,0:04:34.04,Default,Maomao,0,0,0,,Bez wątpienia z własnej woli.
Dialogue: 0,0:04:36.54,0:04:42.17,Default,Maomao,0,0,0,,Ten jaśnie pan dał przełożonej tyle pracy,\Nże muszę tu z nim zostać…
Dialogue: 0,0:04:42.55,0:04:45.88,Default,Jinshi,0,0,0,,Zielareczko, naprawdę myślisz,\Nże to alkohol go zabił?
Dialogue: 0,0:04:46.64,0:04:47.96,Default,Maomao,0,0,0,,No wiedziałam.
Dialogue: 0,0:04:49.76,0:04:54.42,Default,Maomao,0,0,0,,Każdy miłośnik mocnych trunków powinien\Nwiedzieć, że w nadmiarze są one trucizną.
Dialogue: 0,0:04:54.94,0:04:58.17,Default,Maomao,0,0,0,,Regularne picie może prowadzić\Ndo uszkodzenia narządów,
Dialogue: 0,0:04:58.25,0:05:02.09,Default,Maomao,0,0,0,,a spożycie zbyt dużej ilości naraz\Nmoże doprowadzić do śmierci.
Dialogue: 0,0:05:02.17,0:05:05.91,Default,Jinshi,0,0,0,,To była impreza dla grupy pracowników\Ni podobno sobie nie żałowali.
Dialogue: 0,0:05:05.99,0:05:07.61,Default,Maomao,0,0,0,,Mogło go to zabić.
Dialogue: 0,0:05:08.31,0:05:10.86,Default,Jinshi,0,0,0,,Ale pan Kounen\Ndoskonale znał swój umiar.
Dialogue: 0,0:05:10.94,0:05:12.70,Default,Jinshi,0,0,0,,Nie sądzę, że to nadmiar go zabił.
Dialogue: 0,0:05:16.15,0:05:18.33,Default,Maomao,0,0,0,,Człowiek, który umarł,\Nnazywał się Kounen.
Dialogue: 0,0:05:18.88,0:05:21.85,Default,Maomao,0,0,0,,Był potężnym wojownikiem,\Npochłaniał całe dzbany alkoholu
Dialogue: 0,0:05:21.93,0:05:23.76,Default,Maomao,0,0,0,,i był lubianą personą.
Dialogue: 0,0:05:23.84,0:05:25.00,Default,Jinshi,0,0,0,,Gaoshun.
Dialogue: 0,0:05:25.08,0:05:26.12,Default,Gaoshun,0,0,0,,Tak jest.
Dialogue: 0,0:05:26.47,0:05:29.06,Default,Jinshi,0,0,0,,To jest trunek z owego wieczoru.
Dialogue: 0,0:05:31.39,0:05:33.14,Default,Maomao,0,0,0,,O, gorzałka!
Dialogue: 0,0:05:33.22,0:05:35.52,Default,Jinshi,0,0,0,,Dzban, z którego pił pan Kounen,
Dialogue: 0,0:05:35.60,0:05:38.27,Default,Jinshi,0,0,0,,rozbił się, a zawartość szlag trafił.
Dialogue: 0,0:05:39.96,0:05:44.10,Default,Maomao,0,0,0,,Zatem jeśli to w dzbanie była trucizna,\Nmielibyśmy się o tym nie dowiedzieć.
Dialogue: 0,0:05:44.44,0:05:45.98,Default,Jinshi,0,0,0,,W rzeczy samej…
Dialogue: 0,0:05:46.65,0:05:51.04,Default,Maomao,0,0,0,,To było za łatwe. Zdaje sobie\Nsprawę, że prosi o niemożliwe.
Dialogue: 0,0:05:51.12,0:05:54.39,Default,Maomao,0,0,0,,Zdecydowanie wolę go jako\Naroganta wydającego rozkazy.
Dialogue: 0,0:05:54.91,0:05:59.58,Default,Maomao,0,0,0,,Od pewnego czasu pan Jinshi zachowuje się\No wiele dziecinniej niż dotychczas.
Dialogue: 0,0:06:04.76,0:06:07.85,Default,Maomao,0,0,0,,Jest słodkie i słone zarazem.
Dialogue: 0,0:06:07.93,0:06:11.51,Default,Maomao,0,0,0,,Jakby ktoś wziął słodki\Ntrunek i dosypał soli…
Dialogue: 0,0:06:12.04,0:06:13.14,Default,Jinshi,0,0,0,,Co jest?
Dialogue: 0,0:06:13.22,0:06:15.14,Default,Maomao,0,0,0,,Ma wyraźny smak.
Dialogue: 0,0:06:15.22,0:06:19.88,Default,Jinshi,0,0,0,,Jest słodkie, prawda?\NPan Kounen właśnie takie lubił.
Dialogue: 0,0:06:19.96,0:06:21.34,Default,Jinshi,0,0,0,,Prawdziwy łakomczuch,
Dialogue: 0,0:06:21.42,0:06:26.09,Default,Jinshi,0,0,0,,który stronił od wędzonych\Nmięs czy słonych potraw.
Dialogue: 0,0:06:26.17,0:06:27.31,Default,Maomao,0,0,0,,Aha…
Dialogue: 0,0:06:27.39,0:06:32.33,Default,Jinshi,0,0,0,,Podobno kiedyś uwielbiał pikantne potrawy,\Njednak pewnego dnia zmienił mu się gust.
Dialogue: 0,0:06:32.91,0:06:35.41,Default,Jinshi,0,0,0,,Jego posiłki musiały być słodkie.
Dialogue: 0,0:06:35.49,0:06:37.29,Default,Maomao,0,0,0,,Czyżby cukrzyca?
Dialogue: 0,0:06:37.37,0:06:40.01,Default,Jinshi,0,0,0,,Nie psuj moich\Nwspomnień rzeczywistością.
Dialogue: 0,0:06:40.72,0:06:41.79,Default,Jinshi,0,0,0,,Jeszcze ci mało?
Dialogue: 0,0:06:42.06,0:06:44.73,Default,Maomao,0,0,0,,Od ostrego do słodkiego, co?
Dialogue: 0,0:06:46.07,0:06:48.34,Default,Maomao,0,0,0,,Czy na wydarzeniu była sól?
Dialogue: 0,0:06:48.62,0:06:53.60,Default,Jinshi,0,0,0,,Tak. Sól kamienna, ciastka\Nksiężycowe i suszone mięso.
Dialogue: 0,0:06:54.18,0:06:56.06,Default,Jinshi,0,0,0,,Przynieść ci je?
Dialogue: 0,0:06:56.14,0:06:59.08,Default,Maomao,0,0,0,,Nie, nie będzie już do czego.
Dialogue: 0,0:06:59.16,0:07:00.89,Default,Jinshi,0,0,0,,Nie o to mi chodziło…
Dialogue: 0,0:07:01.20,0:07:04.72,Default,Maomao,0,0,0,,Możesz przynieść dzban,\Nz którego pił pan Kounen?
Dialogue: 0,0:07:04.80,0:07:07.08,Default,Jinshi,0,0,0,,Jest rozbity na kawałeczki.
Dialogue: 0,0:07:07.16,0:07:08.24,Default,Maomao,0,0,0,,Nie szkodzi.
Dialogue: 0,0:07:14.87,0:07:19.80,Default,Maomao,0,0,0,,Chciałabym się przyjrzeć jednej rzeczy.
Dialogue: 0,0:07:24.16,0:07:25.50,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:07:29.78,0:07:31.36,Default,Gaoshun,0,0,0,,Raport.
Dialogue: 0,0:07:31.44,0:07:32.93,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:07:37.88,0:07:39.00,Default,Maomao,0,0,0,,Wiedziałam.
Dialogue: 0,0:07:40.89,0:07:41.96,Default,Jinshi,0,0,0,,Oto dzban.
Dialogue: 0,0:07:49.67,0:07:50.94,Default,Jinshi,0,0,0,,Musiałaś to lizać?
Dialogue: 0,0:07:51.36,0:07:53.26,Default,Maomao,0,0,0,,Nie ma tu trucizny.
Dialogue: 0,0:07:59.56,0:08:00.66,Default,Jinshi,0,0,0,,Sól?
Dialogue: 0,0:08:00.74,0:08:08.11,Default,Maomao,0,0,0,,Panie Jinshi, wspominałeś, że pan Kounen\Nnagle nabrał ochoty na słodycze, prawda?
Dialogue: 0,0:08:08.19,0:08:10.67,Default,Maomao,0,0,0,,I później jadł tylko same słodycze?
Dialogue: 0,0:08:10.75,0:08:11.82,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:08:11.82,0:08:17.30,Default,Maomao,0,0,0,,A jednak trunek w dzbanie był tak słony,\Nże pozostawił osad na ściankach.
Dialogue: 0,0:08:19.22,0:08:24.01,Default,Maomao,0,0,0,,Sól jest niezbędna dla naszego organizmu,\Nale jej nadmiar bywa również trujący.
Dialogue: 0,0:08:24.09,0:08:26.06,Default,Jinshi,0,0,0,,Więc przyczyną jego śmierci jest…
Dialogue: 0,0:08:26.53,0:08:30.76,Default,Maomao,0,0,0,,Biorąc pod uwagę ilość alkoholu,\Njaką wypił, i dodaną sól,
Dialogue: 0,0:08:30.84,0:08:33.49,Default,Maomao,0,0,0,,łatwo dojść do wniosku,\Nże to było przyczyną.
Dialogue: 0,0:08:33.57,0:08:38.06,Default,Jinshi,0,0,0,,To prawda, ale powinien rozpoznać,\Nczy coś jest słone…
Dialogue: 0,0:08:38.14,0:08:41.29,Default,Maomao,0,0,0,,Nie mógł tego wyczuć.\NSpójrz na to.
Dialogue: 0,0:08:42.61,0:08:46.06,Default,Maomao,0,0,0,,To raport na temat\Nstylu życia pana Kounena.
Dialogue: 0,0:08:47.44,0:08:48.96,Default,Maomao,0,0,0,,Sądząc po tych informacjach,
Dialogue: 0,0:08:49.04,0:08:53.31,Default,Maomao,0,0,0,,pan Kounen stracił zdolność\Ndo rozpoznawaniu słonego smaku.
Dialogue: 0,0:08:53.39,0:08:54.47,Default,Jinshi,0,0,0,,Niemożliwe…
Dialogue: 0,0:08:55.24,0:08:59.16,Default,Maomao,0,0,0,,Kounen wydawał się poważnym\Ni wykwalifikowanym urzędnikiem
Dialogue: 0,0:08:59.24,0:09:00.93,Default,Maomao,0,0,0,,o stoickiej osobowości.
Dialogue: 0,0:09:05.93,0:09:10.61,Default,Maomao,0,0,0,,Lata temu stracił żonę\Ni dziecko w wyniku epidemii.
Dialogue: 0,0:09:11.62,0:09:13.97,Default,Maomao,0,0,0,,Od tego dnia cały czas pracował.
Dialogue: 0,0:09:14.05,0:09:17.99,Default,Maomao,0,0,0,,Jego jedyną rozrywką\Nbyło picie i słodycze.
Dialogue: 0,0:09:19.38,0:09:21.49,Default,Maomao,0,0,0,,Pewna choroba powoduje\Nutratę smaku.
Dialogue: 0,0:09:22.00,0:09:25.23,Default,Maomao,0,0,0,,Jej powodem może być\Nniezrównoważona dieta lub stres.
Dialogue: 0,0:09:25.28,0:09:27.90,Default,Maomao,0,0,0,,Czasami brzemię staje się\Nzbyt ciężkie do udźwignięcia
Dialogue: 0,0:09:27.90,0:09:30.25,Default,Maomao,0,0,0,,i objawia się w postaci choroby.
Dialogue: 0,0:09:30.62,0:09:34.34,Default,Jinshi,0,0,0,,Kto więc wsypał sól do dzbana?
Dialogue: 0,0:09:35.72,0:09:39.09,Default,Maomao,0,0,0,,To już nie leży w mojej gestii.
Dialogue: 0,0:09:39.52,0:09:44.10,Default,Maomao,0,0,0,,Jednak we wczorajszym\Ntrunku również była sól.
Dialogue: 0,0:09:44.85,0:09:47.69,Default,Maomao,0,0,0,,Widocznie ktoś,\Nkto nie lubi słodkiego alkoholu,
Dialogue: 0,0:09:47.77,0:09:50.15,Default,Maomao,0,0,0,,musiał dodać sól kamienną.
Dialogue: 0,0:09:50.80,0:09:55.26,Default,Maomao,0,0,0,,Pracoholicy często\Nnie cieszą się dobrą opinią.
Dialogue: 0,0:09:55.80,0:09:58.86,Default,Maomao,0,0,0,,Może dosypali trochę soli do alkoholu,
Dialogue: 0,0:09:58.94,0:10:02.24,Default,Maomao,0,0,0,,ponieważ go nie lubili\Ni chcieli zrobić małego psikusa.
Dialogue: 0,0:10:03.56,0:10:06.92,Default,Maomao,0,0,0,,Dowcipniś stopniowo zwiększał dawkę,
Dialogue: 0,0:10:07.00,0:10:10.18,Default,Maomao,0,0,0,,licząc na to,\Nże koniec końców zauważy.
Dialogue: 0,0:10:12.67,0:10:13.68,Default,Jinshi,0,0,0,,Gaoshun.
Dialogue: 0,0:10:13.76,0:10:14.86,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:10:15.45,0:10:16.48,Default,Gaoshun,0,0,0,,Przyjąłem.
Dialogue: 0,0:10:18.45,0:10:20.36,Default,Maomao,0,0,0,,Tchórz ze mnie.
Dialogue: 0,0:10:20.76,0:10:25.50,Default,Maomao,0,0,0,,Biorąc pod uwagę ilość wskazówek,\Npodałam mu winowajcę na srebrnej tacy.
Dialogue: 0,0:10:26.90,0:10:30.87,Default,Maomao,0,0,0,,Nie chcę być jednak powodem czyjejś kary.
Dialogue: 0,0:10:31.69,0:10:34.46,Default,Jinshi,0,0,0,,Przepraszamy za zamieszanie. Dziękuję.
Dialogue: 0,0:10:34.54,0:10:35.55,Default,Maomao,0,0,0,,Nie szkodzi.
Dialogue: 0,0:10:36.08,0:10:38.15,Default,Maomao,0,0,0,,Frędzel z obsydianu…
Dialogue: 0,0:10:38.83,0:10:40.82,Default,Maomao,0,0,0,,Jest w żałobie.
Dialogue: 0,0:10:41.37,0:10:43.41,Default,Maomao,0,0,0,,Czy darzyłeś go wielkim szacunkiem?
Dialogue: 0,0:10:44.26,0:10:46.91,Default,Jinshi,0,0,0,,Tak, bardzo mi pomógł,\Nkiedy byłem dzieckiem.
Dialogue: 0,0:10:52.08,0:10:54.52,Default,Maomao,0,0,0,,Wygląda tak jakoś normalnie…
Dialogue: 0,0:10:55.62,0:10:58.41,Default,Maomao,0,0,0,,W końcu jest tylko człowiekiem.
Dialogue: 0,0:11:00.93,0:11:02.00,Default,Jinshi,0,0,0,,A, racja.
Dialogue: 0,0:11:02.73,0:11:03.76,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:11:05.62,0:11:06.62,Default,Jinshi,0,0,0,,Oto nagroda.
Dialogue: 0,0:11:06.97,0:11:08.05,Default,Maomao,0,0,0,,Tykwa?
Dialogue: 0,0:11:08.13,0:11:10.39,Default,Jinshi,0,0,0,,Tak. Nie jest to\Nto samo, co wczoraj.
Dialogue: 0,0:11:11.03,0:11:12.12,Default,Maomao,0,0,0,,Gorzałka!
Dialogue: 0,0:11:12.69,0:11:14.41,Default,Jinshi,0,0,0,,Nie daj się przyłapać.
Dialogue: 0,0:11:14.75,0:11:17.38,Default,Maomao,0,0,0,,Tak! Dziękuję!
Dialogue: 0,0:11:23.06,0:11:25.34,Default,Jinshi,0,0,0,,Nie widzę ani krzty wdzięczności.
Dialogue: 0,0:11:25.42,0:11:30.12,Default,Maomao,0,0,0,,Doprawdy? Może powinieneś\Nwrócić do swojej pracy.
Dialogue: 0,0:11:31.56,0:11:33.75,Default,Maomao,0,0,0,,Ta reakcja…\NNa pewno się obija.
Dialogue: 0,0:11:33.83,0:11:36.48,Default,Maomao,0,0,0,,Może warto to skończyć,\Nnim się zakopiesz w papierach.
Dialogue: 0,0:11:36.56,0:11:37.97,Default,Jinshi,0,0,0,,Zawsze daję z siebie 100%…
Dialogue: 0,0:11:38.05,0:11:39.30,Default,Maomao,0,0,0,,W której pracy?
Dialogue: 0,0:11:39.38,0:11:43.14,Default,Jinshi,0,0,0,,Na przykład,\Njest pewien projekt edyktu.
Dialogue: 0,0:11:43.22,0:11:46.44,Default,Jinshi,0,0,0,,Chodzi o ustanowienie ograniczeń\Nwiekowych na spożywanie alkoholu,
Dialogue: 0,0:11:46.52,0:11:49.00,Default,Jinshi,0,0,0,,aby uchronić młodych ludzi\Nprzed uzależnieniem.
Dialogue: 0,0:11:49.08,0:11:50.10,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:11:50.49,0:11:53.86,Default,Jinshi,0,0,0,,Projekt proponuje zakaz picia\Nalkoholu do dwudziestego roku życia.
Dialogue: 0,0:11:59.19,0:12:00.50,Default,Maomao,0,0,0,,Panie Jinshi…
Dialogue: 0,0:12:01.61,0:12:04.03,Default,Maomao,0,0,0,,Proszę, nie uchwalaj tego!
Dialogue: 0,0:12:08.29,0:12:11.52,Default,Jinshi,0,0,0,,Cóż. Nie mogę o tym\Ndecydować samodzielnie.
Dialogue: 0,0:12:11.60,0:12:13.04,Default,Maomao,0,0,0,,Panie Jinshi!
Dialogue: 0,0:12:45.22,0:12:46.34,Default,Eunuch A,0,0,0,,Medyku!
Dialogue: 0,0:12:49.79,0:12:50.79,Default,Eunuch A,0,0,0,,Tutaj!
Dialogue: 0,0:12:55.37,0:12:56.98,Default,Guen,0,0,0,,O nie!
Dialogue: 0,0:13:02.34,0:13:04.60,Default,Maomao,0,0,0,,Dobrze, że jest zima.
Dialogue: 0,0:13:04.68,0:13:07.34,Default,Maomao,0,0,0,,Jak na topielicę,\Ncałkiem dobrze się trzyma.
Dialogue: 0,0:13:07.42,0:13:09.56,Default,Guen,0,0,0,,Jak możesz na nią patrzeć?
Dialogue: 0,0:13:09.64,0:13:11.01,Default,Maomao,0,0,0,,Gdzie ją znaleziono?
Dialogue: 0,0:13:11.26,0:13:13.10,Default,Eunuch 1,0,0,0,,Dryfowała w zewnętrznej fosie.
Dialogue: 0,0:13:13.18,0:13:15.94,Default,Eunuch 1,0,0,0,,Po jej ubiorze sądzimy,\Nże służyła w wewnętrznym pałacu.
Dialogue: 0,0:13:16.28,0:13:19.40,Default,Maomao,0,0,0,,Rozumiem.\NTo dlatego wezwali naszego medyka.
Dialogue: 0,0:13:19.89,0:13:21.93,Default,Maomao,0,0,0,,Patrząc jednak na medyka\Nod autopsji,
Dialogue: 0,0:13:22.01,0:13:23.57,Default,Maomao,0,0,0,,to jego fach jest zagrożony.
Dialogue: 0,0:13:23.65,0:13:26.09,Default,Guen,0,0,0,,Panienko, mogłabyś się tym zająć?
Dialogue: 0,0:13:26.17,0:13:27.20,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:13:27.85,0:13:30.49,Default,Maomao,0,0,0,,Zakazano mi dotykania zwłok.
Dialogue: 0,0:13:30.86,0:13:32.59,Default,Jinshi,0,0,0,,Co za widok.
Dialogue: 0,0:13:32.67,0:13:33.75,Default,Guen,0,0,0,,Panie Jinshi!
Dialogue: 0,0:13:34.03,0:13:36.15,Default,Maomao,0,0,0,,Witaj, panie Jinshi.
Dialogue: 0,0:13:37.14,0:13:39.10,Default,Jinshi,0,0,0,,Nie czujesz się nieswojo w pobliżu trupa?
Dialogue: 0,0:13:39.15,0:13:41.05,Default,Maomao,0,0,0,,Ich widok nie jest dla mnie nowością.
Dialogue: 0,0:13:41.13,0:13:44.51,Default,Maomao,0,0,0,,Pozorny przepych dzielnicy uciech\Nto tylko złudzenie.
Dialogue: 0,0:13:44.89,0:13:46.99,Default,Jinshi,0,0,0,,Dlaczego nie możesz dotykać zwłok?
Dialogue: 0,0:13:47.07,0:13:49.43,Default,Maomao,0,0,0,,Mój nauczyciel mi tego zabronił.
Dialogue: 0,0:13:49.80,0:13:51.63,Default,Jinshi,0,0,0,,Z obawy przed zakażeniem?
Dialogue: 0,0:13:51.71,0:13:52.78,Default,Maomao,0,0,0,,Nie…
Dialogue: 0,0:13:53.16,0:13:56.23,Default,Maomao,0,0,0,,Bo są tacy, co uważają\Nzwłoki za źródło składników.
Dialogue: 0,0:13:57.02,0:13:59.29,Default,Lakan,0,0,0,,Zważywszy na twoją ciekawość,
Dialogue: 0,0:13:59.37,0:14:02.64,Default,Lakan,0,0,0,,gdy raz spróbujesz,\Nniedługo zaczniesz rozkopywać groby.
Dialogue: 0,0:14:02.72,0:14:05.40,Default,Lakan,0,0,0,,Trzymaj się z dala od trupów!
Dialogue: 0,0:14:05.48,0:14:06.82,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:14:07.07,0:14:08.28,Default,Jinshi,0,0,0,,Tak myślałem.
Dialogue: 0,0:14:09.12,0:14:10.70,Default,Maomao,0,0,0,,Co za chamska odpowiedź.
Dialogue: 0,0:14:11.02,0:14:14.07,Default,Jinshi,0,0,0,,Doktorze, czy możesz\Nprzeprowadzić sekcję zwłok?
Dialogue: 0,0:14:14.76,0:14:15.95,Default,Guen,0,0,0,,Oczywiście…
Dialogue: 0,0:14:19.58,0:14:21.26,Default,Maomao,0,0,0,,Rany, rany…
Dialogue: 0,0:14:23.40,0:14:29.57,Default,Maomao,0,0,0,,Wysoka. Drewniane buty…\NBandaże na jednej stopie…
Dialogue: 0,0:14:29.65,0:14:31.48,Default,Maomao,0,0,0,,Palce są całe czerwone.
Dialogue: 0,0:14:33.68,0:14:37.21,Default,Maomao,0,0,0,,Woda musiała być bardzo zimna.
Dialogue: 0,0:14:42.19,0:14:46.68,Default,Jinshi,0,0,0,,Kobieta była służącą i jeszcze\Nwczoraj normalnie pracowała.
Dialogue: 0,0:14:47.20,0:14:52.12,Default,Jinshi,0,0,0,,Według strażnika zeszłej nocy\Nwspięła się na mur i się z niego rzuciła.
Dialogue: 0,0:14:52.20,0:14:54.28,Default,Jinshi,0,0,0,,Samobójstwo.
Dialogue: 0,0:14:54.68,0:14:56.75,Default,Maomao,0,0,0,,Samobójstwo…
Dialogue: 0,0:14:57.17,0:14:58.20,Default,Jinshi,0,0,0,,Co o tym myślisz?
Dialogue: 0,0:14:58.52,0:15:00.84,Default,Maomao,0,0,0,,Nie wiem, czy zrobiła to umyślnie,
Dialogue: 0,0:15:00.92,0:15:03.69,Default,Maomao,0,0,0,,ale nie mogła tego zrobić sama.
Dialogue: 0,0:15:03.77,0:15:05.09,Default,Jinshi,0,0,0,,To znaczy?
Dialogue: 0,0:15:05.45,0:15:10.80,Default,Maomao,0,0,0,,Na murze nie ma żadnych drabin\Nczy narzędzi do wspinaczki.
Dialogue: 0,0:15:10.88,0:15:14.35,Default,Maomao,0,0,0,,Mur wewnętrznego pałacu jest co najmniej\Ncztery razy wyższy ode mnie.
Dialogue: 0,0:15:14.67,0:15:16.93,Default,Jinshi,0,0,0,,Zatem nie mogła się tam wspiąć\Nbez narzędzi.
Dialogue: 0,0:15:17.49,0:15:18.98,Default,Maomao,0,0,0,,Szczerze mówiąc…
Dialogue: 0,0:15:19.98,0:15:24.30,Default,Maomao,0,0,0,,Istnieje sposób,\Naby wspinać się bez sprzętu.
Dialogue: 0,0:15:24.96,0:15:28.25,Default,Maomao,0,0,0,,Pamiętasz sprawę ducha?
Dialogue: 0,0:15:28.33,0:15:29.69,Default,Maomao,0,0,0,,Konkubina Fuyou?
Dialogue: 0,0:15:29.77,0:15:30.86,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:15:30.96,0:15:34.67,Default,Maomao,0,0,0,,Byłam ciekawa,\Njak wspięła się na mur,
Dialogue: 0,0:15:34.75,0:15:37.66,Default,Maomao,0,0,0,,dlatego zbadałam ten temat dogłębnie.
Dialogue: 0,0:15:38.09,0:15:43.08,Default,Maomao,0,0,0,,No i zauważyłam tam kilka wystających\Nelementów, używanych przez rzemieślników.
Dialogue: 0,0:15:44.21,0:15:47.79,Default,Maomao,0,0,0,,Niemniej jednak, byłoby to\Ntrudne dla normalnych kobiet,
Dialogue: 0,0:15:47.87,0:15:51.09,Default,Maomao,0,0,0,,a zwłaszcza tych ze związanymi\Nstopami, jak ta służąca.
Dialogue: 0,0:15:52.12,0:15:56.44,Default,Maomao,0,0,0,,Wiązanie stóp to zwyczaj, zgodnie\Nz którym małe stopy uważa się za piękne.
Dialogue: 0,0:15:57.06,0:16:00.09,Default,Maomao,0,0,0,,Nie wszystkie kobiety to robią,
Dialogue: 0,0:16:00.17,0:16:04.15,Default,Maomao,0,0,0,,od czasu do czasu widzę\Nten charakterystyczny styl chodzenia.
Dialogue: 0,0:16:04.61,0:16:06.34,Default,Jinshi,0,0,0,,Jeśli to nie samobójstwo,
Dialogue: 0,0:16:07.20,0:16:08.70,Default,Jinshi,0,0,0,,to mówimy o morderstwie?
Dialogue: 0,0:16:08.78,0:16:10.68,Default,Maomao,0,0,0,,Tego nie wiem.
Dialogue: 0,0:16:11.15,0:16:15.16,Default,Maomao,0,0,0,,Wydaje mi się dość pewne,\Nże żyła, gdy wpadła do fosy.
Dialogue: 0,0:16:16.37,0:16:19.38,Default,Maomao,0,0,0,,Rozpaczliwie szukała czegoś,\Nczego mogłaby się przytrzymać.
Dialogue: 0,0:16:19.85,0:16:23.04,Default,Maomao,0,0,0,,Dowodem na to\Nsą jej zakrwawione palce.
Dialogue: 0,0:16:25.14,0:16:26.14,Default,Jinshi,0,0,0,,Tak…
Dialogue: 0,0:16:27.30,0:16:30.10,Default,Maomao,0,0,0,,Samobójstwo czy zabójstwo?
Dialogue: 0,0:16:38.78,0:16:43.18,Default,Maomao,0,0,0,,Nigdy nie myślałam,\Nby odebrać sobie życie.
Dialogue: 0,0:16:43.80,0:16:46.39,Default,Maomao,0,0,0,,Nie chciałabym też, by mnie zabili.
Dialogue: 0,0:16:47.29,0:16:50.48,Default,Maomao,0,0,0,,Jak umrę, nie będę już mogła\Ntestować żadnych leków ani trucizn.
Dialogue: 0,0:16:53.49,0:16:57.13,Default,Maomao,0,0,0,,Ale gdybym miała umrzeć…
Dialogue: 0,0:16:58.66,0:17:00.33,Default,Jinshi,0,0,0,,O czym myślisz?
Dialogue: 0,0:17:00.63,0:17:02.95,Default,Maomao,0,0,0,,O truciźnie, którą wybrałabym,\Nby się zabić.
Dialogue: 0,0:17:03.45,0:17:04.46,Default,Jinshi,0,0,0,,Chcesz umrzeć?!
Dialogue: 0,0:17:05.01,0:17:09.79,Default,Maomao,0,0,0,,Nie, ale nikt nie wie,\Nkiedy nadejdzie jego pora.
Dialogue: 0,0:17:11.50,0:17:15.50,Default,Maomao,0,0,0,,Złośliwa osoba może\Nspowodować niechcianą śmierć,
Dialogue: 0,0:17:15.58,0:17:18.06,Default,Maomao,0,0,0,,nawet wbrew ich woli.
Dialogue: 0,0:17:18.63,0:17:19.89,Default,Maomao,0,0,0,,Zupełnie jak pan Kounen.
Dialogue: 0,0:17:22.63,0:17:26.10,Default,Maomao,0,0,0,,Nikt nie wie, kiedy to nastąpi.
Dialogue: 0,0:17:26.50,0:17:29.73,Default,Maomao,0,0,0,,Nie ma sposobu,\Nby sprzeciwić się losowi…
Dialogue: 0,0:18:42.69,0:18:43.98,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:18:44.98,0:18:45.99,Default,Jinshi,0,0,0,,O co chodzi?
Dialogue: 0,0:18:48.04,0:18:52.61,Default,Maomao,0,0,0,,Jeśli rozkażą ci kiedyś mnie stracić,\Nmógłbyś podać mi truciznę?
Dialogue: 0,0:18:53.19,0:18:54.36,Default,Jinshi,0,0,0,,Co to za pytanie?!
Dialogue: 0,0:18:54.79,0:18:59.95,Default,Maomao,0,0,0,,Jeśli popełnię błąd,\Nto ty prawdopodobnie wydasz rozkaz.
Dialogue: 0,0:19:10.36,0:19:13.21,Default,Maomao,0,0,0,,Oto i on, mój straszny błąd.
Dialogue: 0,0:19:13.61,0:19:16.22,Default,Maomao,0,0,0,,Przepraszam, chyba się zagalopowałam.
Dialogue: 0,0:19:16.82,0:19:19.47,Default,Maomao,0,0,0,,Nie będę narzekać\Nna powieszenie czy ścięcie głowy.
Dialogue: 0,0:19:19.55,0:19:21.82,Default,Jinshi,0,0,0,,Naprawdę. Po co to wszystko mówisz?!
Dialogue: 0,0:19:23.61,0:19:25.74,Default,Maomao,0,0,0,,Bo jestem zwykłym człowiekiem.
Dialogue: 0,0:19:25.82,0:19:28.56,Default,Maomao,0,0,0,,Najmniejszy błąd z łatwością\Nmoże pozbawić mnie życia.
Dialogue: 0,0:19:28.64,0:19:30.19,Default,Jinshi,0,0,0,,Nigdy bym tego nie zrobił.
Dialogue: 0,0:19:30.27,0:19:34.48,Default,Maomao,0,0,0,,Tu nie chodzi o to, czego byś chciał,\Ntylko, co możesz zrobić.
Dialogue: 0,0:19:36.13,0:19:38.54,Default,Maomao,0,0,0,,Powinnam była\Ntrzymać buzię na kłódkę.
Dialogue: 0,0:19:40.11,0:19:43.10,Default,Maomao,0,0,0,,Jeśli nie jestem już potrzebna, odejdę.
Dialogue: 0,0:20:00.76,0:20:04.24,Default,Maomao,0,0,0,,Resztę historii poznałam później.
Dialogue: 0,0:20:04.32,0:20:08.84,Default,Maomao,0,0,0,,Utopiona kobietą okazała się trucicielką,\Nktóra była na bankiecie.
Dialogue: 0,0:20:09.70,0:20:11.96,Default,Maomao,0,0,0,,Odkryto testament z odpowiednią treścią,
Dialogue: 0,0:20:12.04,0:20:14.87,Default,Maomao,0,0,0,,więc sprawę zamknięto jako samobójstwo.
Dialogue: 0,0:20:22.28,0:20:25.16,Default,Gaoshun,0,0,0,,Raport z tamtego dnia jest już gotowy.
Dialogue: 0,0:20:25.50,0:20:29.41,Default,Jinshi,0,0,0,,Minęły dwa miesiące, od kiedy prosiłem\No znalezienie kogoś z poparzonymi rękami.
Dialogue: 0,0:20:30.29,0:20:31.83,Default,Jinshi,0,0,0,,To trwało zbyt długo.
Dialogue: 0,0:20:31.91,0:20:33.58,Default,Gaoshun,0,0,0,,Bardzo mi przykro.
Dialogue: 0,0:20:33.66,0:20:35.58,Default,Jinshi,0,0,0,,Więc wiemy kto to?
Dialogue: 0,0:20:36.01,0:20:39.21,Default,Gaoshun,0,0,0,,Tak. Jest wyżej, niż myślałem.
Dialogue: 0,0:20:40.39,0:20:42.47,Default,Gaoshun,0,0,0,,Fengming z Granatowego Pałacu.
Dialogue: 0,0:20:47.93,0:20:51.22,Default,Gaoshun,0,0,0,,Główna służąca konkubiny A Duo.
Dialogue: 0,0:20:53.25,0:20:54.33,Default,Jinshi,0,0,0,,Rozumiem.
Dialogue: 0,0:20:55.41,0:20:56.49,Default,Jinshi,0,0,0,,Możesz odejść.
Dialogue: 0,0:21:02.53,0:21:03.80,Default,Jinshi,0,0,0,,Konkubina A Duo…
Dialogue: 0,0:22:34.99,0:22:36.99,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.68,0:22:48.16,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Miód”.
Dialogue: 0,0:22:48.70,0:22:50.28,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
