Dialogue: 0,0:00:04.56,0:00:08.28,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:08.36,0:00:15.41,Default,Title,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:29.98,0:01:31.98,Default,Text,0,0,0,,{\an8}JADEITOWY PAŁAC\NMAOMAO
Dialogue: 0,0:01:33.59,0:01:35.19,Default,Jinshi,0,0,0,,Co powinienem zrobić…
Dialogue: 0,0:01:35.88,0:01:36.95,Default,Gaoshun,0,0,0,,{\an8}Co powinniśmy robić?
Dialogue: 0,0:01:36.03,0:01:39.03,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:39.70,0:01:41.16,Default,Jinshi,0,0,0,,{\i1}Po egzekucji Fengming
Dialogue: 0,0:01:41.62,0:01:44.28,Default,Jinshi,0,0,0,,{\i1}majątek jej rodziny\Nzostał skonfiskowany,
Dialogue: 0,0:01:44.36,0:01:47.85,Default,Jinshi,0,0,0,,{\i1}a całą rodzinę poddano\Nróżnym karom cielesnym.
Dialogue: 0,0:01:49.43,0:01:52.41,Default,Jinshi,0,0,0,,{\i1}Fengming z determinacją\Nmówiła, że jest jedyną sprawczynią,
Dialogue: 0,0:01:52.83,0:01:56.47,Default,Jinshi,0,0,0,,{\i1}więc jej ukochana konkubina A Duo\Nnie została obarczona winą.
Dialogue: 0,0:01:58.44,0:02:03.98,Default,Jinshi,0,0,0,,{\i1}Oto lista członków rodziny\NFengming i osób z nimi związanych.
Dialogue: 0,0:02:04.62,0:02:08.63,Default,Gaoshun,0,0,0,,Na liście znajdują się osoby,\Nktóre prowadziły z nimi interesy.
Dialogue: 0,0:02:08.71,0:02:11.61,Default,Gaoshun,0,0,0,,Pszczelarstwo nie było\Nich jedynym zajęciem.
Dialogue: 0,0:02:11.69,0:02:15.61,Default,Gaoshun,0,0,0,,W wewnętrznym pałacu przebywa około\Nosiemdziesięcioro dzieci z tych rodzin.
Dialogue: 0,0:02:15.93,0:02:18.31,Default,Jinshi,0,0,0,,Osiemdziesiąt z dwóch tysięcy, tak?
Dialogue: 0,0:02:18.92,0:02:20.97,Default,Jinshi,0,0,0,,To całkiem niezły wynik.
Dialogue: 0,0:02:21.05,0:02:23.80,Default,Text,0,0,0,,{\an8}JADEITOWY PAŁAC\NMAOMAO
Dialogue: 0,0:02:24.37,0:02:29.37,Default,Jinshi,0,0,0,,{\i1}Rodzina, przez którą trafiła tu\Nzielareczka,też miała z nimi do czynienia.
Dialogue: 0,0:02:30.09,0:02:32.59,Default,Gaoshun,0,0,0,,Jeśli chcesz, możemy to zataić.
Dialogue: 0,0:02:32.98,0:02:34.82,Default,Jinshi,0,0,0,,Jeśli ja bym chciał…
Dialogue: 0,0:02:35.46,0:02:37.01,Default,Jinshi,0,0,0,,W rzeczy samej.
Dialogue: 0,0:02:37.86,0:02:40.17,Default,Jinshi,0,0,0,,{\i1}Nie ma znaczenia,\Nczy to słuszne, czy nie.
Dialogue: 0,0:02:40.25,0:02:42.36,Default,Jinshi,0,0,0,,{\i1}Zrobią to, co im każę.
Dialogue: 0,0:02:43.27,0:02:46.48,Default,Jinshi,0,0,0,,{\i1}Biorąc pod uwagę, że lubi oddzielać\Nzwykłych ludzi od arystokratów,
Dialogue: 0,0:02:46.56,0:02:49.39,Default,Jinshi,0,0,0,,{\i1}wypełni każdy rozkaz bez żadnego ale.
Dialogue: 0,0:02:54.19,0:02:56.44,Default,Jinshi,0,0,0,,{\i1}Wydanie rozkazu byłoby banalne.
Dialogue: 0,0:02:56.52,0:02:58.44,Default,Jinshi,0,0,0,,{\i1}Wystarczy po prostu go wydać.
Dialogue: 0,0:02:59.11,0:03:02.87,Default,Jinshi,0,0,0,,{\i1}Jeśli ukryję prawdę,\Nwtedy ona zostanie w pałacu.
Dialogue: 0,0:03:03.56,0:03:07.99,Default,Jinshi,0,0,0,,{\i1}A może ona wcale tego nie chce…
Dialogue: 0,0:03:08.54,0:03:14.49,Default,Jinshi,0,0,0,,{\i1}Jak by się czuła, zmuszona do życia\Nw miejscu, którego tak nie lubi?
Dialogue: 0,0:03:18.42,0:03:23.30,Default,Jinshi,0,0,0,,{\i1}Boję się, że przepaść między\Nnami pogłębi się jeszcze bardziej.
Dialogue: 0,0:03:24.97,0:03:26.10,Default,Gaoshun,0,0,0,,Panie Jinshi.
Dialogue: 0,0:03:27.36,0:03:30.23,Default,Gaoshun,0,0,0,,Wydawało mi się,\Nże była tylko zwykłym pionkiem.
Dialogue: 0,0:03:34.64,0:03:35.78,Default,Maomao,0,0,0,,Masowe zwolnienia?
Dialogue: 0,0:03:35.86,0:03:36.92,Default,Xiaolan,0,0,0,,Tak.
Dialogue: 0,0:03:36.90,0:03:38.18,Default,Text,0,0,0,,{\an8}ODCINEK 12: EUNUCH I KURTYZANA
Dialogue: 0,0:03:37.26,0:03:42.53,Default,Xiaolan,0,0,0,,Wszystkie osoby, które prowadziły interesy\Nz rodziną Fengming, zostały zwolnione.
Dialogue: 0,0:03:42.61,0:03:45.84,Default,Xiaolan,0,0,0,,I jest ich podobno całkiem sporo.
Dialogue: 0,0:03:45.92,0:03:47.25,Default,Maomao,0,0,0,,Aha…
Dialogue: 0,0:03:47.33,0:03:51.50,Default,Xiaolan,0,0,0,,Wiele dziewczyn musi nagle odejść\Nz pałacu i nie ma gdzie się podziać.
Dialogue: 0,0:03:51.58,0:03:54.38,Default,Xiaolan,0,0,0,,Chyba ta rodzina\Nprowadziła wiele interesów.
Dialogue: 0,0:03:55.51,0:03:57.67,Default,Maomao,0,0,0,,{\i1}Mam co do tego złe przeczucia.
Dialogue: 0,0:03:58.16,0:04:01.04,Default,Maomao,0,0,0,,{\i1}Jeśli mnie teraz wyleją,\Nmam przechlapane.
Dialogue: 0,0:04:01.12,0:04:02.41,Default,Maomao,0,0,0,,{\i1}To zły moment.
Dialogue: 0,0:04:02.49,0:04:07.74,Default,Maomao,0,0,0,,{\i1}Po wizycie Lihaku nie wysłałam\Ntej wiedźmie żadnych klientów.
Dialogue: 0,0:04:07.82,0:04:09.18,Default,Maomao,0,0,0,,{\i1}Jeśli teraz wrócę…
Dialogue: 0,0:04:09.63,0:04:10.86,Default,Maomao,0,0,0,,Wróciłam.
Dialogue: 0,0:04:11.44,0:04:13.56,Default,Maomao,0,0,0,,To twój klient!
Dialogue: 0,0:04:14.26,0:04:16.56,Default,Maomao,0,0,0,,{\i1}Nie daruje mi tego!
Dialogue: 0,0:04:17.88,0:04:18.96,Default,Xiaolan,0,0,0,,Maomao?!
Dialogue: 0,0:04:25.45,0:04:32.62,Default,Maomao,0,0,0,,{\i1}Kiedy ostatnio sprawdzałam,\Nmoi porywacze też robili z nimi interesy.
Dialogue: 0,0:04:40.58,0:04:42.97,Default,Maomao,0,0,0,,{\i1}Jeśli rodzina Fengming prowadziła pasiekę,
Dialogue: 0,0:04:43.52,0:04:46.68,Default,Maomao,0,0,0,,{\i1}może to mieć jakiś związek…
Dialogue: 0,0:05:30.13,0:05:31.35,Default,Maomao,0,0,0,,Panie Jinshi!
Dialogue: 0,0:05:42.89,0:05:45.24,Default,Jinshi,0,0,0,,Rzadko się zdarza, że brakuje ci tchu.
Dialogue: 0,0:05:46.10,0:05:47.14,Default,Maomao,0,0,0,,Ten tego…
Dialogue: 0,0:05:47.22,0:05:49.28,Default,Jinshi,0,0,0,,Spokojnie. Jesteś cała czerwona.
Dialogue: 0,0:05:49.82,0:05:51.78,Default,Maomao,0,0,0,,Muszę z tobą porozmawiać!
Dialogue: 0,0:05:52.48,0:05:55.54,Default,Jinshi,0,0,0,,Dobrze, pomówmy w środku.
Dialogue: 0,0:05:57.59,0:05:59.71,Default,Jinshi,0,0,0,,Zapewne chodzi o redukcję personelu?
Dialogue: 0,0:05:59.79,0:06:03.73,Default,Maomao,0,0,0,,Tak. Co się ze mną stanie?
Dialogue: 0,0:06:03.81,0:06:04.98,Default,Jinshi,0,0,0,,Masz tu listę.
Dialogue: 0,0:06:05.09,0:06:07.51,Default,Text,0,0,0,,{\an8}JADEITOWY PAŁAC\NMAOMAO
Dialogue: 0,0:06:08.20,0:06:11.01,Default,Maomao,0,0,0,,Więc muszę odejść.
Dialogue: 0,0:06:12.77,0:06:13.82,Default,Jinshi,0,0,0,,Chcesz tego?
Dialogue: 0,0:06:18.90,0:06:21.23,Default,Gaoshun,0,0,0,,{\i1}Wydawało mi się,\Nże była tylko zwykłym pionkiem.
Dialogue: 0,0:06:26.16,0:06:28.33,Default,Maomao,0,0,0,,{\i1}Jako służąca pani Gyokuyou
Dialogue: 0,0:06:28.41,0:06:31.76,Default,Maomao,0,0,0,,{\i1}mogę testować trucizny\Ni przebywać w gabinecie lekarskim.
Dialogue: 0,0:06:31.84,0:06:34.76,Default,Maomao,0,0,0,,{\i1}Przyznam, że lubię swoje obecne życie.
Dialogue: 0,0:06:35.96,0:06:38.49,Default,Maomao,0,0,0,,{\i1}Ale mimo wszystko\Njestem tylko służką.
Dialogue: 0,0:06:38.95,0:06:42.33,Default,Maomao,0,0,0,,{\i1}Nie mogę prosić,\Nby mnie nie zwalniano.
Dialogue: 0,0:06:43.12,0:06:45.64,Default,Maomao,0,0,0,,{\i1}Muszę się postarać,\Nby nie wyjść na żebraczkę.
Dialogue: 0,0:06:47.24,0:06:49.51,Default,Maomao,0,0,0,,Jestem tylko służącą.
Dialogue: 0,0:06:49.87,0:06:56.52,Default,Maomao,0,0,0,,Zrobię, co mi każesz. Mogę gotować,\Nsprzątać i dalej sprawdzać jedzenie.
Dialogue: 0,0:06:57.48,0:06:58.89,Default,Jinshi,0,0,0,,{\i1}Co rozkażę…
Dialogue: 0,0:06:59.34,0:07:03.58,Default,Maomao,0,0,0,,{\i1}Zrobię wszystko, co w mojej mocy,\Njeżeli taki będzie rozkaz.
Dialogue: 0,0:07:03.66,0:07:06.36,Default,Maomao,0,0,0,,{\i1}Jeśli obniżysz moje zarobki,\Nto niech tak będzie.
Dialogue: 0,0:07:06.76,0:07:10.65,Default,Maomao,0,0,0,,{\i1}Najważniejsze, by jak najdłużej odwlec\Nswój rychły powrót do dzielnicy uciech.
Dialogue: 0,0:07:12.99,0:07:15.45,Default,Maomao,0,0,0,,{\i1}Więc proszę, nie zwalniaj mnie!
Dialogue: 0,0:07:18.20,0:07:19.54,Default,Jinshi,0,0,0,,Zrozumiałem.
Dialogue: 0,0:07:19.87,0:07:20.96,Default,Maomao,0,0,0,,Czy to znaczy…
Dialogue: 0,0:07:21.83,0:07:23.42,Default,Jinshi,0,0,0,,Dostaniesz sowitą odprawę.
Dialogue: 0,0:07:25.44,0:07:26.51,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:07:26.59,0:07:30.72,Default,Narrator,0,0,0,,{\i1}Negocjacje zawiodły.\NMaomao zostaje zwolniona.
Dialogue: 0,0:07:32.66,0:07:34.34,Default,Maomao,0,0,0,,No i już.
Dialogue: 0,0:07:42.77,0:07:45.42,Default,Gaoshun,0,0,0,,Jak długo zamierzasz tak siedzieć?
Dialogue: 0,0:07:46.87,0:07:49.59,Default,Gaoshun,0,0,0,,Trzeba było kazać jej zostać.
Dialogue: 0,0:07:49.67,0:07:50.86,Default,Jinshi,0,0,0,,Ani słowa więcej.
Dialogue: 0,0:07:53.22,0:07:55.32,Default,Gaoshun,0,0,0,,Po tygodniu od zwolnienia,
Dialogue: 0,0:07:55.64,0:07:58.38,Default,Gaoshun,0,0,0,,Xiaomao wróciła do domu,\Ndo dzielnicy uciech.
Dialogue: 0,0:07:59.49,0:08:01.04,Default,Gaoshun,0,0,0,,Z tego co słyszałem,
Dialogue: 0,0:08:01.12,0:08:05.14,Default,Gaoshun,0,0,0,,grzecznie pożegnała się\Nze wszystkimi, którym pomagała.
Dialogue: 0,0:08:06.21,0:08:08.25,Default,Gyokuyou,0,0,0,,Będziesz tego żałować.
Dialogue: 0,0:08:09.09,0:08:15.81,Default,Gaoshun,0,0,0,,Wybór nowej zabawki, która zastąpi\Npoprzednią, to zawsze nie lada wyzwanie.
Dialogue: 0,0:08:15.89,0:08:18.89,Default,Young Jinshi,0,0,0,,Ja chcę tamtą!
Dialogue: 0,0:08:19.83,0:08:20.84,Default,Gaoshun,0,0,0,,A może…
Dialogue: 0,0:08:21.28,0:08:25.15,Default,Gaoshun,0,0,0,,to czas, kiedy ta dziewczyna\Nprzestała być zabawką.
Dialogue: 0,0:08:25.88,0:08:29.77,Default,Gaoshun,0,0,0,,Zwolnił ją tylko dlatego,\Nże nie chciał jej dalej tak traktować.
Dialogue: 0,0:08:30.60,0:08:33.86,Default,Gaoshun,0,0,0,,Cóż to za upierdliwy pan.
Dialogue: 0,0:08:34.39,0:08:36.28,Default,Gaoshun,0,0,0,,Znalezienie zastępstwa nie wystarczy…
Dialogue: 0,0:08:36.92,0:08:39.37,Default,Gaoshun,0,0,0,,Może uda mi się\Nporozmawiać z tym oficerem.
Dialogue: 0,0:08:40.22,0:08:44.04,Default,Jinshi,0,0,0,,Amba fatima, było i ni ma…
Dialogue: 0,0:08:50.55,0:08:53.47,Default,Meimei,0,0,0,,Bez piegów wyglądasz znacznie lepiej.
Dialogue: 0,0:08:53.55,0:08:56.38,Default,Pairin,0,0,0,,Możesz użyć mojej szminki.
Dialogue: 0,0:08:56.46,0:09:00.26,Default,Joka,0,0,0,,Nie myślałam, że kiedykolwiek\NMaomao pójdzie z nami na imprezę.
Dialogue: 0,0:09:00.62,0:09:05.23,Default,Maomao,0,0,0,,Dziś wieczorem będziemy zabawiać\Ngości na imprezie poza domem uciech.
Dialogue: 0,0:09:05.31,0:09:08.75,Default,Maomao,0,0,0,,Wynajęcie kurtyzany do własnej\Nrezydencji kosztuje niezłą sumkę.
Dialogue: 0,0:09:08.83,0:09:09.87,Default,Maomao,0,0,0,,Dodatkowo…
Dialogue: 0,0:09:10.34,0:09:12.54,Default,Maomao,0,0,0,,Noc z jedną z tutejszych księżniczek
Dialogue: 0,0:09:12.62,0:09:14.20,Default,Maomao,0,0,0,,to koszt rocznego zarobku.
Dialogue: 0,0:09:14.28,0:09:17.78,Default,Maomao,0,0,0,,A co dopiero wezwanie\Nwszystkich trzech naraz…
Dialogue: 0,0:09:18.14,0:09:21.29,Default,Maomao,0,0,0,,Jak to mówią:\N„kto bogatemu zabroni?”.
Dialogue: 0,0:09:21.83,0:09:26.36,Default,Maomao,0,0,0,,Idę z wami tylko po to,\Nbyście lepiej wypadły.
Dialogue: 0,0:09:26.44,0:09:27.92,Default,Meimei,0,0,0,,Proszę, Maomao.
Dialogue: 0,0:09:28.68,0:09:32.36,Default,Maomao,0,0,0,,Dzięki sowitej odprawie z powodu\Nzwolnienia z wewnętrznego pałacu,
Dialogue: 0,0:09:32.44,0:09:34.95,Default,Maomao,0,0,0,,zdołałam zapobiec mojemu sprzedaniu.
Dialogue: 0,0:09:36.68,0:09:39.05,Default,Joka,0,0,0,,To również ważne zadanie.
Dialogue: 0,0:09:39.13,0:09:40.96,Default,Meimei,0,0,0,,Nie możemy się doczekać, Maomao.
Dialogue: 0,0:09:41.04,0:09:43.73,Default,Pairin,0,0,0,,Jeju, jaka słodka.
Dialogue: 0,0:09:43.81,0:09:46.39,Default,Old Lady,0,0,0,,Czas nas goni! Ruszajcie się!
Dialogue: 0,0:09:49.40,0:09:52.14,Default,Old Lady,0,0,0,,No cóż, nie jest źle.
Dialogue: 0,0:09:52.22,0:09:54.86,Default,Old Lady,0,0,0,,Mogłabyś też przyjąć własnych klientów.
Dialogue: 0,0:09:57.83,0:10:01.99,Default,Maomao,0,0,0,,Staruszka naprawdę chce,\Nbym została kurtyzaną.
Dialogue: 0,0:10:03.09,0:10:04.70,Default,Old Lady,0,0,0,,Przynieście górę szmalu!
Dialogue: 0,0:10:05.44,0:10:08.30,Default,Maomao,0,0,0,,Nie umiem recytować poezji\Nani grać na erhu.
Dialogue: 0,0:10:08.38,0:10:10.63,Default,Maomao,0,0,0,,Do tańca również mam dwie lewe nogi.
Dialogue: 0,0:10:10.71,0:10:14.65,Default,Maomao,0,0,0,,Jestem tylko zielarką i córką zielarza,\Nnic poza tym mnie nie interesuje.
Dialogue: 0,0:10:14.73,0:10:18.22,Default,Maomao,0,0,0,,Pytanie tylko, dlaczego tak nalega,\Nzwłaszcza w ostatnim czasie?
Dialogue: 0,0:10:38.42,0:10:41.49,Default,Maomao,0,0,0,,Bogactwo aż kipi.
Dialogue: 0,0:10:42.17,0:10:45.20,Default,Maomao,0,0,0,,Każdy mebelek musiał kosztować fortunę.
Dialogue: 0,0:10:45.28,0:10:48.25,Default,Maomao,0,0,0,,Z pewnością nie zauważą,\Njak jedną wezmę sobie na pamiątkę…
Dialogue: 0,0:10:48.82,0:10:50.00,Default,Maomao,0,0,0,,Nie! Nie wolno.
Dialogue: 0,0:10:50.08,0:10:52.58,Default,Guide,0,0,0,,To tutaj. Zapraszam.
Dialogue: 0,0:11:01.09,0:11:04.60,Default,Maomao,0,0,0,,Podobno to pan Lihaku zaprosił tu\Ntych wysoko postawionych urzędników.
Dialogue: 0,0:11:05.19,0:11:07.43,Default,Maomao,0,0,0,,Są młodsi, niż myślałam.
Dialogue: 0,0:11:07.82,0:11:08.94,Default,Pairin,0,0,0,,Mniam.
Dialogue: 0,0:11:09.73,0:11:11.78,Default,Meimei,0,0,0,,No to ruszajmy.
Dialogue: 0,0:11:14.48,0:11:19.34,Default,Maomao,0,0,0,,Skoro zna tylu bogaczy,\Nmógł mi ich wcześniej przedstawić.
Dialogue: 0,0:11:19.42,0:11:23.47,Default,Maomao,0,0,0,,Z jego kontaktami mogłabym\Nnieco obniżyć kwotę spłaty.
Dialogue: 0,0:11:24.77,0:11:26.74,Default,Maomao,0,0,0,,Tak czy inaczej, do roboty.
Dialogue: 0,0:12:25.02,0:12:28.97,Default,Maomao,0,0,0,,Praca pracą, ale szczerzenie się\Ncały czas to ciężkie zadanie.
Dialogue: 0,0:12:29.52,0:12:31.73,Default,Maomao,0,0,0,,Czyżby się znudził?
Dialogue: 0,0:12:33.08,0:12:34.91,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:12:34.99,0:12:36.63,Default,Jinshi,0,0,0,,Zostaw mnie.
Dialogue: 0,0:12:37.83,0:12:39.74,Default,Jinshi,0,0,0,,Chcę zostać sam.
Dialogue: 0,0:12:39.82,0:12:43.57,Default,Maomao,0,0,0,,Co? Skąd ja znam ten głos?
Dialogue: 0,0:12:49.10,0:12:50.24,Default,Maomao,0,0,0,,Pan Jinshi?
Dialogue: 0,0:12:53.17,0:12:54.65,Default,Jinshi,0,0,0,,Dlaczego mnie unikasz?
Dialogue: 0,0:12:54.73,0:12:56.80,Default,Maomao,0,0,0,,Nie dotykaj kurtyzan.
Dialogue: 0,0:12:56.88,0:13:00.76,Default,Jinshi,0,0,0,,Czy ktoś ci kiedyś mówił,\Nże w makijażu jesteś kimś innym? {ta i następna wzięta z 7 odc}
Dialogue: 0,0:13:00.84,0:13:02.54,Default,Maomao,0,0,0,,A bo to raz.
Dialogue: 0,0:13:02.62,0:13:04.81,Default,Jinshi,0,0,0,,Swoją drogą.\NCzemu się tak wystroiłaś?
Dialogue: 0,0:13:04.89,0:13:06.54,Default,Maomao,0,0,0,,Pracuję na część etatu.
Dialogue: 0,0:13:06.62,0:13:07.94,Default,Jinshi,0,0,0,,Jako kurtyzana?
Dialogue: 0,0:13:08.02,0:13:09.09,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:13:09.51,0:13:10.81,Default,Jinshi,0,0,0,,Czy to znaczy, że jesteś…
Dialogue: 0,0:13:11.25,0:13:15.48,Default,Maomao,0,0,0,,Ten facet naprawdę ma skłonności\Ndo podważania mojej cnoty.
Dialogue: 0,0:13:15.56,0:13:18.40,Default,Maomao,0,0,0,,Nie biorę indywidualnych klientów.
Dialogue: 0,0:13:19.09,0:13:20.14,Default,Maomao,0,0,0,,Jeszcze.
Dialogue: 0,0:13:20.74,0:13:21.76,Default,Jinshi,0,0,0,,Jeszcze…
Dialogue: 0,0:13:22.69,0:13:25.27,Default,Jinshi,0,0,0,,A gdybym cię wykupił?
Dialogue: 0,0:13:25.86,0:13:27.85,Default,Maomao,0,0,0,,Co? To jakiś żart…
Dialogue: 0,0:13:29.46,0:13:31.24,Default,Maomao,0,0,0,,W sumie niegłupi pomysł.
Dialogue: 0,0:13:32.96,0:13:36.62,Default,Maomao,0,0,0,,Powrót do wewnętrznego\Npałacu nie brzmi źle.
Dialogue: 0,0:13:38.12,0:13:40.80,Default,Jinshi,0,0,0,,Sądziłem, że odeszłaś,\Nbo nienawidziłaś tego miejsca.
Dialogue: 0,0:13:40.88,0:13:43.95,Default,Maomao,0,0,0,,Co? Nigdy tak nie mówiłam.
Dialogue: 0,0:13:44.03,0:13:47.63,Default,Maomao,0,0,0,,Starałam cię przekonać, byś pozwolił mi\Nzostać, ale i tak mnie zwolniłeś.
Dialogue: 0,0:13:48.82,0:13:51.39,Default,Maomao,0,0,0,,Owszem, nie obyło się bez kłopotów.
Dialogue: 0,0:13:51.78,0:13:55.72,Default,Maomao,0,0,0,,Ale gdzie indziej mogłabym\Npracować jako testerka?
Dialogue: 0,0:13:55.80,0:13:59.40,Default,Maomao,0,0,0,,Jedyną rzeczą, której mi brakowało,\Nto moje eksperymenty z truciznami.
Dialogue: 0,0:14:02.27,0:14:04.78,Default,Jinshi,0,0,0,,Naprawdę powinnaś\Nprzestać bawić się nimi.
Dialogue: 0,0:14:05.07,0:14:08.62,Default,Maomao,0,0,0,,Dziś jest bardziej dziecinny niż zwykle.
Dialogue: 0,0:14:09.02,0:14:12.65,Default,Jinshi,0,0,0,,Właśnie. Ten typ tak już ma.
Dialogue: 0,0:14:12.73,0:14:13.81,Default,Maomao,0,0,0,,Co to znaczy?
Dialogue: 0,0:14:13.89,0:14:16.59,Default,Jinshi,0,0,0,,Czy ktoś mówił, że nie potrafisz\Nwyrażać się jasno?
Dialogue: 0,0:14:16.67,0:14:18.00,Default,Maomao,0,0,0,,A bo to raz.
Dialogue: 0,0:14:21.53,0:14:23.05,Default,Jinshi,0,0,0,,Czemu się wzdrygasz?
Dialogue: 0,0:14:23.13,0:14:24.46,Default,Maomao,0,0,0,,Zasady to zasady.
Dialogue: 0,0:14:24.54,0:14:26.03,Default,Jinshi,0,0,0,,Nie można ich nieco nagiąć?
Dialogue: 0,0:14:26.11,0:14:27.13,Default,Maomao,0,0,0,,Nie.
Dialogue: 0,0:14:27.21,0:14:28.33,Default,Jinshi,0,0,0,,Przecież ci nie ubędzie.
Dialogue: 0,0:14:28.41,0:14:29.60,Default,Maomao,0,0,0,,Ubędzie chęci życia.
Dialogue: 0,0:14:29.68,0:14:31.64,Default,Jinshi,0,0,0,,Jedną ręką.\NI tylko małym maluszkiem.
Dialogue: 0,0:14:32.21,0:14:35.64,Default,Maomao,0,0,0,,Ten facet naprawdę\Npotrafi być natrętny.
Dialogue: 0,0:14:37.51,0:14:39.44,Default,Maomao,0,0,0,,Dobra, tylko paluszkiem.
Dialogue: 0,0:14:52.88,0:14:54.14,Default,Maomao,0,0,0,,Ten koleś!
Dialogue: 0,0:14:54.22,0:14:56.03,Default,Maomao,0,0,0,,Szminka się trzyma!
Dialogue: 0,0:14:57.06,0:14:58.76,Default,Meimei,0,0,0,,O rajuśku, a to co?
Dialogue: 0,0:14:59.41,0:15:00.65,Default,Pairin,0,0,0,,Oj, Maomao.
Dialogue: 0,0:15:00.73,0:15:01.80,Default,Joka,0,0,0,,Nie mogę się napatrzeć.
Dialogue: 0,0:15:01.88,0:15:03.69,Default,Maomao,0,0,0,,No wiecie!
Dialogue: 0,0:15:03.77,0:15:06.55,Default,Maomao,0,0,0,,Pan Gaoshun?!
Dialogue: 0,0:15:07.00,0:15:09.76,Default,Maomao,0,0,0,,Wszystko było bez sensu.
Dialogue: 0,0:15:09.84,0:15:12.47,Default,Maomao,0,0,0,,Niewiele pamiętam z tego,\Nco wydarzyło się później.
Dialogue: 0,0:15:12.55,0:15:13.72,Default,Joka,0,0,0,,Więc kto to był?
Dialogue: 0,0:15:13.80,0:15:15.05,Default,Meimei,0,0,0,,Skąd go znasz?
Dialogue: 0,0:15:15.13,0:15:16.81,Default,Pairin,0,0,0,,Niezła jesteś!
Dialogue: 0,0:15:16.89,0:15:22.82,Default,Maomao,0,0,0,,Wiem jedynie, że ciężko było\Nodpowiadać na wszystkie ich pytania.
Dialogue: 0,0:15:22.90,0:15:25.16,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:15:27.15,0:15:28.57,Default,Maomao,0,0,0,,I…
Dialogue: 0,0:15:28.65,0:15:30.81,Default,Maomao,0,0,0,,Może zrobię kilka na wszelki wypadek.
Dialogue: 0,0:15:30.89,0:15:33.66,Default,Maomao,0,0,0,,Wałęsanie się bez moich piegów\Nnie wróży niczego dobrego.
Dialogue: 0,0:15:34.64,0:15:36.91,Default,Maomao,0,0,0,,Zimą zeszłego roku…
Dialogue: 0,0:15:40.12,0:15:42.06,Default,Maomao,0,0,0,,Wystarczy mi już to porwanie…
Dialogue: 0,0:15:42.14,0:15:44.79,Default,Maomao,0,0,0,,żeby sprzedano mnie akurat\Ndo wewnętrznego pałacu…
Dialogue: 0,0:15:47.93,0:15:50.76,Default,Maomao,0,0,0,,Potem otrzymałam awans\Nna osobistą służkę.
Dialogue: 0,0:15:54.51,0:15:58.71,Default,Maomao,0,0,0,,Zamierzałam nie wychylać się\Ndo końca mojej służby, ale…
Dialogue: 0,0:15:58.79,0:16:01.24,Default,Old Lady,0,0,0,,Maomao. Gotowe?
Dialogue: 0,0:16:01.32,0:16:02.86,Default,Maomao,0,0,0,,Tak, trzymaj.
Dialogue: 0,0:16:04.02,0:16:07.28,Default,Old Lady,0,0,0,,Chcę, żebyś się komuś przypatrzyła.\NPozwolisz na chwilę?
Dialogue: 0,0:16:07.36,0:16:08.44,Default,Maomao,0,0,0,,Robi się.
Dialogue: 0,0:16:22.74,0:16:24.46,Default,Maomao,0,0,0,,Wewnętrzny pałac, co?
Dialogue: 0,0:16:24.54,0:16:27.75,Default,Maomao,0,0,0,,Za wszelką cenę chciałam omijać\Nto miejsce szerokim łukiem.
Dialogue: 0,0:16:32.92,0:16:35.51,Default,Maomao,0,0,0,,Ciekawe, czy u wszystkich w porządku.
Dialogue: 0,0:16:39.51,0:16:40.94,Default,Maomao,0,0,0,,Już wychodzę.
Dialogue: 0,0:16:41.02,0:16:44.47,Default,Old Lady,0,0,0,,Nie spiesz się. Przecież nie będziesz\Ntu przychodzić bez przerwy.
Dialogue: 0,0:16:45.33,0:16:46.35,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:16:51.86,0:16:53.95,Default,Old Lady,0,0,0,,Czym będziesz się teraz zajmować?
Dialogue: 0,0:16:54.03,0:16:55.84,Default,Maomao,0,0,0,,Spłacę swoje długi, obiecuję.
Dialogue: 0,0:16:55.92,0:16:57.64,Default,Old Lady,0,0,0,,Wiadomo!
Dialogue: 0,0:16:59.64,0:17:02.10,Default,Old Lady,0,0,0,,Wracasz do wewnętrznego pałacu?
Dialogue: 0,0:17:03.89,0:17:05.14,Default,Maomao,0,0,0,,Nie wiem.
Dialogue: 0,0:17:06.88,0:17:11.60,Default,Maomao,0,0,0,,Ale wewnętrzny pałac\Nnie różni się zbytnio od burdelu.
Dialogue: 0,0:17:11.68,0:17:13.38,Default,Old Lady,0,0,0,,Ta.
Dialogue: 0,0:17:25.96,0:17:27.83,Default,Luomen,0,0,0,,Masz problemy ze snem?
Dialogue: 0,0:17:28.47,0:17:30.57,Default,Maomao,0,0,0,,Pójdę się przewietrzyć.
Dialogue: 0,0:17:30.65,0:17:32.22,Default,Luomen,0,0,0,,Uważaj na siebie.
Dialogue: 0,0:17:32.30,0:17:33.33,Default,Maomao,0,0,0,,Jasne.
Dialogue: 0,0:18:04.85,0:18:08.60,Default,Maomao,0,0,0,,Wewnętrzny pałac i burdel\Nwcale się od siebie nie różnią.
Dialogue: 0,0:18:08.68,0:18:11.45,Default,Maomao,0,0,0,,Ogród i klatka.
Dialogue: 0,0:20:16.36,0:20:19.69,Default,Maomao,0,0,0,,Co będzie dalej?
Dialogue: 0,0:20:26.39,0:20:27.47,Default,Maomao,0,0,0,,Ale zimnica.
Dialogue: 0,0:20:31.20,0:20:32.63,Default,Text,0,0,0,,{\an8}GRYNSZPANOWY PAWILON
Dialogue: 0,0:20:32.71,0:20:38.46,Default,Narrator,0,0,0,,Parę dni później do dzielnicy\Nuciech przybywa piękny arystokrata.
Dialogue: 0,0:20:41.46,0:20:44.43,Default,Narrator,0,0,0,,Przywozi ze sobą tyle forsy,\Nże staruszce oczy wyszły z orbit,
Dialogue: 0,0:20:44.51,0:20:46.26,Default,Narrator,0,0,0,,i z jakiegoś powodu…
Dialogue: 0,0:20:49.36,0:20:53.14,Default,Narrator,0,0,0,,Dziwne zielsko powstałe z owada…
Dialogue: 0,0:20:57.43,0:21:00.26,Default,Narrator,0,0,0,,Oczekuje w zamian pewnej dziewczyny.
Dialogue: 0,0:21:02.99,0:21:04.99,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:22:34.99,0:22:36.99,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.66,0:22:48.83,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku:\N„Służba na zewnętrznym dworze”.
Dialogue: 0,0:22:48.92,0:22:50.92,Default,,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
