Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.48,0:01:33.53,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:33.37,0:01:35.99,Default,Maomao,0,0,0,,Wraz z nadejściem wiosny\Nzyskaliśmy pewność,
Dialogue: 0,0:01:36.45,0:01:39.99,Default,Maomao,0,0,0,,że pani Gyokuyou\Nrzeczywiście jest w ciąży.
Dialogue: 0,0:01:46.15,0:01:49.42,Default,Maomao,0,0,0,,Ciekawe, czy wyczuła,\Nże będzie miała rodzeństwo.
Dialogue: 0,0:01:54.58,0:01:56.80,Default,Yinghua; Guiyuan; Ailan,0,0,0,,Ale uroczo!
Dialogue: 0,0:01:56.80,0:01:59.07,Default,Hongniang,0,0,0,,Może to i na mnie pora...
Dialogue: 0,0:02:03.32,0:02:05.22,Default,Maomao,0,0,0,,Nawet gdyby otrzymała propozycję,
Dialogue: 0,0:02:05.22,0:02:07.31,Default,Maomao,0,0,0,,zapewne nie pozwoliliby jej odejść.
Dialogue: 0,0:02:08.12,0:02:10.62,Default,Maomao,0,0,0,,Bycie niezastąpionym\Nto czasem przekleństwo.
Dialogue: 0,0:02:16.14,0:02:20.91,Default,Maomao,0,0,0,,Jak się robi to co się lubi,\Nto czas szybko mija.
Dialogue: 0,0:02:21.23,0:02:25.02,Default,Maomao,0,0,0,,Te dwa miesiące spędzone u pana\NJinshiego dłużyły mi się w cholerę.
Dialogue: 0,0:02:30.34,0:02:31.92,Default,Maomao,0,0,0,,Chciałabyś znowu coś narysować?
Dialogue: 0,0:02:32.79,0:02:33.67,Default,Lingli,0,0,0,,Tak!
Dialogue: 0,0:02:38.98,0:02:41.65,Default,Maomao,0,0,0,,To mleczaj wełnianka,\Ntrujący grzybek...
Dialogue: 0,0:02:43.11,0:02:45.14,Default,Hongniang,0,0,0,,Rysuj jakieś zwykłe kwiaty.
Dialogue: 0,0:02:45.83,0:02:48.06,Default,Maomao,0,0,0,,Zwykłe kwiaty, ta?
Dialogue: 0,0:02:50.64,0:02:52.31,Default,Jinshi,0,0,0,,{\an1}Niebieskie róże?
Dialogue: 0,0:02:50.64,0:02:54.57,Default,Text,0,0,0,,{\an8}ODCINEK 22: NIEBIESKIE RÓŻE
Dialogue: 0,0:02:52.57,0:02:55.57,Default,Lakan,0,0,0,,{\an1}Tak. Możliwe, że jeszcze\Nnigdy ich nie widziałeś?
Dialogue: 0,0:02:56.28,0:03:01.71,Default,Lakan,0,0,0,,Ich niebieskie płatki są przepiękne.
Dialogue: 0,0:03:01.71,0:03:05.28,Default,Lakan,0,0,0,,Często widywałem je w pałacu.
Dialogue: 0,0:03:05.77,0:03:07.63,Default,Jinshi,0,0,0,,A może to był sen?
Dialogue: 0,0:03:07.63,0:03:10.03,Default,Jinshi,0,0,0,,Błękitne róże nie istnieją.
Dialogue: 0,0:03:11.65,0:03:13.90,Default,Lakan,0,0,0,,Niemożliwe, a jednak.
Dialogue: 0,0:03:15.83,0:03:19.16,Default,Lakan,0,0,0,,Wspaniale byłoby móc je\Nznowu podziwiać ze wszystkimi.
Dialogue: 0,0:03:19.59,0:03:22.84,Default,Lakan,0,0,0,,Jak sądzisz?\NDałoby się to załatwić?
Dialogue: 0,0:03:23.32,0:03:27.17,Default,Lakan,0,0,0,,Mając taką władzę,\Nnie ma rzeczy niemożliwych.
Dialogue: 0,0:03:27.86,0:03:33.05,Default,Jinshi,0,0,0,,Oczywiście. Jeśli taka odmiana\Nistnieje, też chciałbym je zobaczyć.
Dialogue: 0,0:03:33.05,0:03:34.61,Default,Lakan,0,0,0,,Zatem postanowione.
Dialogue: 0,0:03:35.01,0:03:37.82,Default,Lakan,0,0,0,,Nie mogę się doczekać!
Dialogue: 0,0:03:39.02,0:03:40.32,Default,Lakan,0,0,0,,Na mnie pora.
Dialogue: 0,0:03:44.44,0:03:46.83,Default,Lakan,0,0,0,,Widzimy się na kolejnym\Nogrodowym przyjęciu.
Dialogue: 0,0:03:49.98,0:03:54.29,Default,Gaoshun,0,0,0,,I tak masz już pełno na głowie.\NTrzeba było nie brać kolejnej roboty.
Dialogue: 0,0:03:54.29,0:03:58.84,Default,Jinshi,0,0,0,,Nie wkurzaj mnie.\NWypytaj każdego florystę o tę różę.
Dialogue: 0,0:04:04.58,0:04:09.31,Default,Gaoshun,0,0,0,,Floryści zgodnie stwierdzili,\Nże to nie jest sezon na róże.
Dialogue: 0,0:04:12.69,0:04:15.15,Default,Jinshi,0,0,0,,Przepraszam, że wezwałem cię tak nagle.
Dialogue: 0,0:04:16.94,0:04:21.24,Default,Jinshi,0,0,0,,Na spotkaniu padła propozycja,\Nżeby podziwiać niebieskie róże.
Dialogue: 0,0:04:21.65,0:04:23.45,Default,Maomao,0,0,0,,Niebieskie róże?
Dialogue: 0,0:04:23.45,0:04:25.72,Default,Maomao,0,0,0,,Wiesz, że jestem tylko zielarką.
Dialogue: 0,0:04:25.72,0:04:27.62,Default,Jinshi,0,0,0,,Tak, wiem...
Dialogue: 0,0:04:28.52,0:04:32.26,Default,Maomao,0,0,0,,Ciekawe, skąd ten pomysł.\NWygląda na bardzo zmęczonego.
Dialogue: 0,0:04:33.25,0:04:37.21,Default,Maomao,0,0,0,,Róże, tak?\NCoś niecoś o nich wiem.
Dialogue: 0,0:04:38.19,0:04:43.22,Default,Maomao,0,0,0,,Zdarzało mi się je sprzedawać,\Nby dorobić z kurtyzanami, ale...
Dialogue: 0,0:04:44.34,0:04:46.72,Default,Maomao,0,0,0,,Naprawdę chcą zobaczyć niebieskie róże?
Dialogue: 0,0:04:47.00,0:04:47.83,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:04:49.94,0:04:52.10,Default,Maomao,0,0,0,,Czyżby to jakiś nowy halucynogen czy...
Dialogue: 0,0:04:52.42,0:04:54.60,Default,Jinshi,0,0,0,,To by zrujnowało cały nasz kraj!
Dialogue: 0,0:04:54.60,0:04:56.33,Default,Gaoshun,0,0,0,,Panie Jinshi.
Dialogue: 0,0:04:59.25,0:05:00.57,Default,Jinshi,0,0,0,,To niemożliwe?
Dialogue: 0,0:05:04.71,0:05:07.03,Default,Maomao,0,0,0,,Czego dokładnie chcesz?
Dialogue: 0,0:05:07.62,0:05:10.20,Default,Jinshi,0,0,0,,Uda ci się je zdobyć na\Nbankiet w przyszłym miesiącu?
Dialogue: 0,0:05:10.65,0:05:15.50,Default,Maomao,0,0,0,,W przyszłym miesiącu? Róże zakwitną\Nnajszybciej za dwa miesiące.
Dialogue: 0,0:05:15.90,0:05:17.04,Default,Jinshi,0,0,0,,Wiem...
Dialogue: 0,0:05:18.20,0:05:20.42,Default,Jinshi,0,0,0,,Jakoś będę musiał mu odmówić.
Dialogue: 0,0:05:22.29,0:05:28.43,Default,Maomao,0,0,0,,Reakcja pana Jinshiego i to\Nzmuszanie ludzi do niemożliwego...
Dialogue: 0,0:05:28.97,0:05:33.43,Default,Maomao,0,0,0,,Wspomniał o tym\Nmoże pewien strateg?
Dialogue: 0,0:05:35.59,0:05:36.39,Default,Jinshi,0,0,0,,Tak.
Dialogue: 0,0:05:37.05,0:05:39.90,Default,Maomao,0,0,0,,Dobrze. Zajmę się tym.
Dialogue: 0,0:05:40.39,0:05:41.63,Default,Jinshi,0,0,0,,Poważnie?
Dialogue: 0,0:05:41.63,0:05:44.57,Default,Maomao,0,0,0,,Nie wiem, czy dam radę,\Nale postaram się.
Dialogue: 0,0:05:45.61,0:05:48.03,Default,Maomao,0,0,0,,Nie będę uciekać przed tym typkiem.
Dialogue: 0,0:05:51.06,0:05:54.75,Default,Maomao,0,0,0,,Najchętniej rozwaliłabym\Nmu ten jego paskudny monokl.
Dialogue: 0,0:05:56.15,0:06:00.33,Default,Maomao,0,0,0,,Panie Jinshi,\Nmogę prosić o parę rzeczy?
Dialogue: 0,0:06:01.74,0:06:06.84,Default,Maomao,0,0,0,,Dziękuję za zgodę\Nna skorzystanie z niej, pani Li Hua.
Dialogue: 0,0:06:06.84,0:06:11.35,Default,Lihua,0,0,0,,Nie ma sprawy.\NW końcu to ty ją zbudowałaś.
Dialogue: 0,0:06:12.83,0:06:14.35,Default,Maomao,0,0,0,,Upłynęło trochę czasu.
Dialogue: 0,0:06:14.97,0:06:18.24,Default,Maomao,0,0,0,,Pamiętam, że zleciłam wykonanie\Nsauny dla pani Li Hua,
Dialogue: 0,0:06:18.24,0:06:20.27,Default,Maomao,0,0,0,,by usunąć toksynę z jej ciała.
Dialogue: 0,0:06:20.62,0:06:25.28,Default,Maomao,0,0,0,,Trochę głupio się czuję,\Nże za darmo mogę z niej skorzystać.
Dialogue: 0,0:06:26.01,0:06:28.57,Default,Maomao,0,0,0,,Proszę, ulubiona książka dla cesarza.
Dialogue: 0,0:06:29.18,0:06:31.37,Default,Lihua,0,0,0,,Dziękuję.
Dialogue: 0,0:06:32.86,0:06:35.87,Default,Maomao,0,0,0,,Dobrze, że dostałam ją z domu uciech.
Dialogue: 0,0:06:40.75,0:06:42.12,Default,Jinshi,0,0,0,,Po tej stronie.
Dialogue: 0,0:06:42.12,0:06:42.79,Default,Eunuchs,0,0,0,,Tak!
Dialogue: 0,0:06:43.25,0:06:44.31,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:06:44.76,0:06:46.38,Default,Jinshi,0,0,0,,A, jesteś już.
Dialogue: 0,0:06:46.38,0:06:48.86,Default,Jinshi,0,0,0,,Zleciłem budowę tak,\Njak chciałaś, ale...
Dialogue: 0,0:06:48.86,0:06:50.01,Default,Jinshi,0,0,0,,Po co to jest?
Dialogue: 0,0:06:50.99,0:06:52.68,Default,Maomao,0,0,0,,By róże rosły jak na drożdżach.
Dialogue: 0,0:06:52.97,0:06:54.43,Default,Jinshi,0,0,0,,Rosły jak na drożdżach?
Dialogue: 0,0:06:54.76,0:06:56.68,Default,Jinshi,0,0,0,,Co to znaczy, zielareczko?
Dialogue: 0,0:07:03.56,0:07:07.73,Default,Maomao,0,0,0,,Górą wpuścimy trochę słońca,\Na przez to ciepłe powietrze.
Dialogue: 0,0:07:09.65,0:07:12.85,Default,Maomao,0,0,0,,W tak ogrzanym pomieszczeniu\Nróże zaczną rosnąć.
Dialogue: 0,0:07:12.85,0:07:16.87,Default,Maomao,0,0,0,,Dzięki temu kwiaty pomyślą,\Nże nadszedł czas kwitnienia.
Dialogue: 0,0:07:17.61,0:07:20.16,Default,Jinshi,0,0,0,,A więc o to chodzi z drożdżami.
Dialogue: 0,0:07:20.16,0:07:22.21,Default,Maomao,0,0,0,,Ale gwarancji nie daję.
Dialogue: 0,0:07:33.97,0:07:36.01,Default,Xiaolan,0,0,0,,Maomao!
Dialogue: 0,0:07:36.01,0:07:37.37,Default,Maomao,0,0,0,,Xiaolan?
Dialogue: 0,0:07:37.37,0:07:38.97,Default,Xiaolan,0,0,0,,Pomogę ci!
Dialogue: 0,0:07:39.56,0:07:41.56,Default,Xiaolan,0,0,0,,Z nogą w porządku?
Dialogue: 0,0:07:43.26,0:07:45.31,Default,Maomao,0,0,0,,Czyżby poprosił, by mnie pilnowała?
Dialogue: 0,0:07:48.28,0:07:52.86,Default,Maomao,0,0,0,,Niejednokrotnie mówili,\Nbym nie przeginała.
Dialogue: 0,0:07:53.10,0:07:55.33,Default,Maomao,0,0,0,,Dobrze jest. Sorki za fatygę.
Dialogue: 0,0:07:55.33,0:07:57.87,Default,Xiaolan,0,0,0,,Nie ma sprawy.\NDawno razem nie pracowałyśmy, co?
Dialogue: 0,0:07:59.71,0:08:01.62,Default,Maomao,0,0,0,,Tak, to prawda.
Dialogue: 0,0:08:05.64,0:08:07.88,Default,Maomao,0,0,0,,Kupiliśmy ponad sto róż.
Dialogue: 0,0:08:11.30,0:08:13.08,Default,Maomao,0,0,0,,To już ostatnia.
Dialogue: 0,0:08:14.18,0:08:17.05,Default,Xiaolan,0,0,0,,Rety, sporo tego!
Dialogue: 0,0:08:17.05,0:08:21.23,Default,Maomao,0,0,0,,Wybrałam te gatunki krzewów,\Nktóre najszybciej zakwitają.
Dialogue: 0,0:08:21.23,0:08:22.64,Default,Xiaolan,0,0,0,,Wszystkie zakwitną?
Dialogue: 0,0:08:23.22,0:08:25.38,Default,Maomao,0,0,0,,Mam nadzieję.
Dialogue: 0,0:08:37.96,0:08:40.91,Default,Maomao,0,0,0,,Utrzymanie temperatury\Nto nie lada wyzwanie.
Dialogue: 0,0:08:41.75,0:08:47.17,Default,Maomao,0,0,0,,Poprosiłabym o pomoc, ale to niełatwe\Nzadanie, by komuś je powierzyć.
Dialogue: 0,0:08:48.17,0:08:51.97,Default,Maomao,0,0,0,,Jeśli popełnimy błąd, to zabijemy\Nje wszystkie i będzie po ptokach.
Dialogue: 0,0:08:56.93,0:09:00.60,Default,Maomao,0,0,0,,W ładne dni wynosimy je na świeże\Npowietrze, by mogły złapać trochę słońca.
Dialogue: 0,0:09:02.43,0:09:04.69,Default,Xiaolan,0,0,0,,Jakie to przyjemne uczucie!
Dialogue: 0,0:09:05.14,0:09:05.89,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:09:06.44,0:09:08.02,Default,Gaoshun,0,0,0,,Jak wam idzie?
Dialogue: 0,0:09:09.19,0:09:10.52,Default,Gaoshun,0,0,0,,A to dla was.
Dialogue: 0,0:09:14.53,0:09:16.15,Default,Maomao,0,0,0,,Dziękujemy bardzo.
Dialogue: 0,0:09:17.22,0:09:22.25,Default,Xiaolan,0,0,0,,Mogę zwolnić i coś przekąsić?\NRewelacja!
Dialogue: 0,0:09:22.25,0:09:24.62,Default,Maomao,0,0,0,,To też praca.
Dialogue: 0,0:09:27.24,0:09:29.00,Default,Xiaolan,0,0,0,,A tym co?
Dialogue: 0,0:09:29.00,0:09:31.30,Default,Maomao,0,0,0,,Nie wiem. Pewnie zwykła ciekawość.
Dialogue: 0,0:09:32.17,0:09:34.46,Default,Maomao,0,0,0,,Albo zwyczajnie się boją.
Dialogue: 0,0:09:37.98,0:09:39.80,Default,Xiaolan,0,0,0,,Co teraz będziemy robić?
Dialogue: 0,0:09:40.31,0:09:43.64,Default,Maomao,0,0,0,,Mogłabyś wybrać te sadzonki,\Nktóre mają kilka pędów?
Dialogue: 0,0:09:44.22,0:09:49.21,Default,Maomao,0,0,0,,Koncentrują one wartości odżywcze\Nw pędach i zapobiegają chorobom.
Dialogue: 0,0:09:55.14,0:09:57.08,Default,Xiaolan,0,0,0,,W porządku.
Dialogue: 0,0:10:01.14,0:10:02.40,Default,Eunuchs,0,0,0,,Dziękuję.
Dialogue: 0,0:10:02.40,0:10:03.24,Default,Xiaolan,0,0,0,,Luzik!
Dialogue: 0,0:10:06.93,0:10:08.10,Default,Maomao,0,0,0,,Szybko!
Dialogue: 0,0:10:16.01,0:10:19.30,Default,Xiaolan,0,0,0,,Proces zakwitania trochę trwa.
Dialogue: 0,0:10:24.82,0:10:26.48,Default,Maomao,0,0,0,,W chłodniejsze dni...
Dialogue: 0,0:10:31.81,0:10:33.82,Default,Maomao,0,0,0,,całe noce spędzam w szopie.
Dialogue: 0,0:10:41.03,0:10:42.95,Default,Maomao,0,0,0,,Pogodą nie można sterować.
Dialogue: 0,0:10:55.65,0:10:57.62,Default,Xiaolan,0,0,0,,Znowu zarwałaś nockę?
Dialogue: 0,0:10:58.26,0:11:00.45,Default,Maomao,0,0,0,,Usnęłam przed świtem.
Dialogue: 0,0:11:00.45,0:11:02.74,Default,Xiaolan,0,0,0,,Przecież to było przed chwilą!
Dialogue: 0,0:11:02.74,0:11:06.42,Default,Xiaolan,0,0,0,,Zrobię, co mogę,\Nwięc może pójdź się zdrzemnąć?
Dialogue: 0,0:11:06.42,0:11:08.43,Default,Maomao,0,0,0,,Nie mogę tego tak zostawić.
Dialogue: 0,0:11:10.53,0:11:12.36,Default,Xiaolan,0,0,0,,Znowu się na nas gapią.
Dialogue: 0,0:11:13.61,0:11:16.49,Default,Maomao,0,0,0,,I tak w kółko.\NJeszcze im się nie znudziło?
Dialogue: 0,0:11:16.85,0:11:18.46,Default,Maomao,0,0,0,,To naprawdę wkurzające.
Dialogue: 0,0:11:19.29,0:11:21.63,Default,Maomao,0,0,0,,Ciekawe, czy mogę odwrócić ich uwagę...
Dialogue: 0,0:11:26.87,0:11:31.71,Default,Xiaolan,0,0,0,,Rany! A więc tak wygląda manikiur!
Dialogue: 0,0:11:31.71,0:11:34.25,Default,Maomao,0,0,0,,W dzielnicy uciech wszyscy to robią.
Dialogue: 0,0:11:34.25,0:11:36.21,Default,Xiaolan,0,0,0,,Naprawdę ładny!
Dialogue: 0,0:11:47.01,0:11:49.22,Default,Guiyuan,0,0,0,,Też go robiłaś, Maomao?
Dialogue: 0,0:11:49.53,0:11:51.15,Default,Guiyuan,0,0,0,,Śliczne!
Dialogue: 0,0:11:51.43,0:11:54.21,Default,Ailan,0,0,0,,To ostatni krzyk mody.
Dialogue: 0,0:11:54.21,0:11:55.65,Default,Maomao,0,0,0,,W rzeczy samej.
Dialogue: 0,0:11:57.65,0:12:02.86,Default,Maomao,0,0,0,,Konkubiny wysokiej rangi\Nzawsze znajdują się na szczycie.
Dialogue: 0,0:12:08.17,0:12:09.63,Default,Hongniang,0,0,0,,To chyba strata czasu.
Dialogue: 0,0:12:12.14,0:12:15.13,Default,Maomao,0,0,0,,Pani Hongniang stawia\Npracę na pierwszym miejscu.
Dialogue: 0,0:12:16.90,0:12:20.65,Default,Maomao,0,0,0,,Skończyłam, więc wracam\Ndo Kryształowego Pałacu.
Dialogue: 0,0:12:20.65,0:12:21.89,Default,Gyokuyou,0,0,0,,Już?
Dialogue: 0,0:12:21.89,0:12:24.14,Default,Maomao,0,0,0,,Bankiet zbliża się wielkimi krokami.
Dialogue: 0,0:12:24.62,0:12:26.05,Default,Gyokuyou,0,0,0,,Prawda...
Dialogue: 0,0:12:26.47,0:12:31.62,Default,Hongniang,0,0,0,,Przy okazji, pani Gyokuyou\Ntym razem nie weźmie udziału.
Dialogue: 0,0:12:31.62,0:12:35.02,Default,Hongniang,0,0,0,,Głównym punktem tego przyjęcia\Nbędzie przedstawienie pani Loulan.
Dialogue: 0,0:12:35.57,0:12:37.73,Default,Maomao,0,0,0,,Chodzi o ukrycie ciąży.
Dialogue: 0,0:12:38.44,0:12:40.52,Default,Maomao,0,0,0,,Rozumiem. Proszę wybaczyć.
Dialogue: 0,0:12:41.18,0:12:43.82,Default,Yinghua,0,0,0,,Nic się nie dzieje\Nw Kryształowym Pałacu?
Dialogue: 0,0:12:44.16,0:12:46.42,Default,Guiyuan,0,0,0,,Każdego dnia wyglądasz gorzej.
Dialogue: 0,0:12:46.42,0:12:48.19,Default,Ailan,0,0,0,,Nie przemęczaj się za bardzo, dobrze?
Dialogue: 0,0:12:48.86,0:12:50.62,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:13:01.62,0:13:03.09,Default,Xiaolan,0,0,0,,Maomao!
Dialogue: 0,0:13:04.05,0:13:06.01,Default,Xiaolan,0,0,0,,Maomao, szybko!
Dialogue: 0,0:13:11.21,0:13:12.77,Default,Maomao,0,0,0,,Pączek...
Dialogue: 0,0:13:12.77,0:13:14.31,Default,Xiaolan,0,0,0,,Znalazłam go przed chwilą.
Dialogue: 0,0:13:14.86,0:13:18.10,Default,Xiaolan,0,0,0,,W końcu to mamy!
Dialogue: 0,0:13:18.49,0:13:23.25,Default,Maomao,0,0,0,,W tym tempie...\NMoże się wyrobimy na czas.
Dialogue: 0,0:13:23.66,0:13:26.51,Default,Xiaolan,0,0,0,,Maomao? Maomao!
Dialogue: 0,0:13:26.51,0:13:27.88,Default,Xiaolan,0,0,0,,Maomao!
Dialogue: 0,0:13:36.68,0:13:38.38,Default,Jinshi,0,0,0,,Jakieś wieści od zielareczki?
Dialogue: 0,0:13:38.67,0:13:40.53,Default,Gaoshun,0,0,0,,Nic a nic.
Dialogue: 0,0:13:40.53,0:13:43.46,Default,Gaoshun,0,0,0,,Przez ostatni czas\Nnie mogłem jej odwiedzić.
Dialogue: 0,0:13:43.46,0:13:46.63,Default,Jinshi,0,0,0,,Przez przygotowania do przyjęcia\Nobaj nie mieliśmy czasu.
Dialogue: 0,0:13:50.50,0:13:51.70,Default,Maomao,0,0,0,,Panie Jinshi.
Dialogue: 0,0:14:21.00,0:14:24.67,Default,Military Officer 1,0,0,0,,A więc to jest konkubina Loulan,\Ncórka pana Shishou.
Dialogue: 0,0:14:29.08,0:14:31.22,Default,Bureaucrat 1,0,0,0,,Przepiękna.
Dialogue: 0,0:14:44.07,0:14:45.69,Default,Shishou,0,0,0,,Jeśli chodzi o konkubinę Loulan,
Dialogue: 0,0:14:49.14,0:14:51.93,Default,Shishou,0,0,0,,czy są jakieś zastrzeżenia?
Dialogue: 0,0:14:53.91,0:14:56.16,Default,Shishou,0,0,0,,Proszę, bez owijania w bawełnę.
Dialogue: 0,0:14:59.93,0:15:01.39,Default,Loulan,0,0,0,,Proszę.
Dialogue: 0,0:15:01.39,0:15:02.45,Default,Empress Dowager,0,0,0,,Rany.
Dialogue: 0,0:15:14.28,0:15:15.95,Default,High Official 1,0,0,0,,Niebieskie róże?!
Dialogue: 0,0:15:15.95,0:15:16.77,Default,High Official 2,0,0,0,,To niemożliwe...
Dialogue: 0,0:15:22.38,0:15:23.86,Default,Jinshi,0,0,0,,Ciekawym przeżyciem będzie...
Dialogue: 0,0:15:25.05,0:15:29.36,Default,Jinshi,0,0,0,,rozkoszowanie się pięknem tych kwiatów\Ni myślenie o ich pełnym rozkwicie.
Dialogue: 0,0:15:30.38,0:15:33.30,Default,Emperor,0,0,0,,Tak, są przepiękne.
Dialogue: 0,0:15:34.91,0:15:38.41,Default,Jinshi,0,0,0,,Uwaga, jaką przykuwa „Jinshi”.
Dialogue: 0,0:15:39.74,0:15:42.36,Default,Jinshi,0,0,0,,Większość tych\Nbezużytecznych urzędników
Dialogue: 0,0:15:42.36,0:15:47.82,Default,Jinshi,0,0,0,,nie docenia młodego i pięknego\Neunucha przyciągającego całą uwagę.
Dialogue: 0,0:15:50.17,0:15:54.64,Default,Jinshi,0,0,0,,Żądza nie jest zła.\NZ łatwością można ją wykorzystać.
Dialogue: 0,0:15:57.10,0:15:59.56,Default,Jinshi,0,0,0,,Zazdrość też ma swoje plusy.\NMożna ją opanować.
Dialogue: 0,0:15:59.95,0:16:01.56,Default,Jinshi,0,0,0,,Największym problemem są...
Dialogue: 0,0:16:02.13,0:16:04.73,Default,Jinshi,0,0,0,,Twarze, które nie pokazują emocji.
Dialogue: 0,0:16:05.41,0:16:10.39,Default,Jinshi,0,0,0,,Shishou. Ojciec konkubiny Loulan, człowiek\Nuwielbiany przez matkę byłego cesarza...
Dialogue: 0,0:16:11.08,0:16:13.82,Default,Jinshi,0,0,0,,Nawet teraz cesarz nie potrafi\Nspojrzeć mu w oczy.
Dialogue: 0,0:16:14.54,0:16:17.90,Default,Jinshi,0,0,0,,I właśnie dlatego\Nnie mogę wypaść z roli.
Dialogue: 0,0:16:18.65,0:16:22.00,Default,Jinshi,0,0,0,,Zresztą, bardziej niż Shishou\Nmartwi mnie teraz...
Dialogue: 0,0:16:22.73,0:16:25.25,Default,Jinshi,0,0,0,,tamten facet, Lakan.
Dialogue: 0,0:16:35.10,0:16:37.09,Default,Lakan,0,0,0,,Wkurzające.
Dialogue: 0,0:16:44.11,0:16:45.29,Default,Yinghua,0,0,0,,Obudziłaś się?
Dialogue: 0,0:16:45.98,0:16:47.44,Default,Maomao,0,0,0,,Yinghua.
Dialogue: 0,0:16:47.44,0:16:49.93,Default,Yinghua,0,0,0,,Nie chodź więcej\Ndo Kryształowego Pałacu.
Dialogue: 0,0:16:49.93,0:16:52.57,Default,Yinghua,0,0,0,,Po powrocie zawsze jesteś wyczerpana.
Dialogue: 0,0:16:54.30,0:16:56.10,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:16:56.10,0:16:57.14,Default,Jinshi,0,0,0,,Wstałaś już.
Dialogue: 0,0:17:01.57,0:17:02.79,Default,Yinghua,0,0,0,,To ja już pójdę.
Dialogue: 0,0:17:05.86,0:17:07.38,Default,Jinshi,0,0,0,,Siedź na spokojnie.
Dialogue: 0,0:17:09.07,0:17:13.17,Default,Maomao,0,0,0,,Ciężko było. Nie udało mi się\Nsprawić, by rozkwitły całkowicie.
Dialogue: 0,0:17:14.15,0:17:18.17,Default,Jinshi,0,0,0,,Chyba mnie nie przepraszasz, prawda?
Dialogue: 0,0:17:19.65,0:17:22.31,Default,Jinshi,0,0,0,,Nieważne. Świetnie ci poszło.
Dialogue: 0,0:17:23.97,0:17:25.60,Default,Jinshi,0,0,0,,Jak ci się to udało?
Dialogue: 0,0:17:26.10,0:17:28.11,Default,Maomao,0,0,0,,Zabarwiłam je.
Dialogue: 0,0:17:28.11,0:17:30.90,Default,Jinshi,0,0,0,,Zabarwione?\NPrzecież nic na nich nie ma.
Dialogue: 0,0:17:31.39,0:17:35.32,Default,Maomao,0,0,0,,Nie na zewnątrz, lecz od środka.
Dialogue: 0,0:17:39.15,0:17:42.49,Default,Maomao,0,0,0,,Pierwotnie wszystkie te róże były białe.
Dialogue: 0,0:17:44.90,0:17:49.38,Default,Maomao,0,0,0,,Dodaliśmy do wody, której\Npotrzebują kwiaty, kilka barwników.
Dialogue: 0,0:17:49.72,0:17:53.34,Default,Jinshi,0,0,0,,To stąd tyle różnych kolorów,\Noprócz niebieskiego.
Dialogue: 0,0:17:53.34,0:17:58.89,Default,Maomao,0,0,0,,Tak. Liście stały się czarne,\Nwięc oberwaliśmy je.
Dialogue: 0,0:17:59.59,0:18:03.31,Default,Maomao,0,0,0,,Później wystarczyło przymocować do\Nłodyg nasączoną barwnikiem watę,
Dialogue: 0,0:18:03.31,0:18:07.34,Default,Maomao,0,0,0,,by nie straciły swojego koloru\Npodczas przyjęcia w ogrodzie.
Dialogue: 0,0:18:07.34,0:18:09.10,Default,Maomao,0,0,0,,To była prościzna.
Dialogue: 0,0:18:09.71,0:18:14.46,Default,Maomao,0,0,0,,Najtrudniejsze było sprawienie,\Nby róże w ogóle zakwitły.
Dialogue: 0,0:18:14.97,0:18:17.20,Default,Jinshi,0,0,0,,Doprawdy, prościzna.
Dialogue: 0,0:18:17.20,0:18:21.90,Default,Maomao,0,0,0,,Co więcej, niektórzy urzędnicy\Nmogli się o to wykłócać,
Dialogue: 0,0:18:22.50,0:18:25.66,Default,Maomao,0,0,0,,dlatego zdradziłam\Ntę sztuczkę cesarzowi.
Dialogue: 0,0:18:26.31,0:18:29.47,Default,Maomao,0,0,0,,Pewnie cieszy się, że jako pierwszy\Npoznał ten sekret.
Dialogue: 0,0:18:29.47,0:18:31.92,Default,Maomao,0,0,0,,i dobrze się bawił,\Nsłuchając moich wyjaśnień.
Dialogue: 0,0:18:32.58,0:18:36.86,Default,Jinshi,0,0,0,,Więc jeśli chodzi o historię\Nniebieskich róż ujrzanych w pałacu...
Dialogue: 0,0:18:36.86,0:18:42.26,Default,Maomao,0,0,0,,Zapewne ktoś, kto miał bardzo dużo wolnego\Nczasu, by karmić róże zabarwioną wodą.
Dialogue: 0,0:18:44.99,0:18:46.85,Default,Jinshi,0,0,0,,Kto mógłby zrobić coś takiego?
Dialogue: 0,0:18:47.98,0:18:51.98,Default,Maomao,0,0,0,,Kto wie. Może był to chwyt,\Nby przyciągnąć zainteresowanie kobiet.
Dialogue: 0,0:18:52.43,0:18:55.81,Default,Jinshi,0,0,0,,To ci niespodzianka.\NPomalowałaś paznokcie?
Dialogue: 0,0:18:55.81,0:18:57.50,Default,Maomao,0,0,0,,Jednak to nie w moim stylu.
Dialogue: 0,0:18:58.15,0:19:02.20,Default,Maomao,0,0,0,,Gdybym miała trochę niecierpka\Ni szczawika, mogłyby wyglądać lepiej.
Dialogue: 0,0:19:03.40,0:19:08.29,Default,Maomao,0,0,0,,Niecierpek nazywany jest „barwniczką\Ndo paznokci”, a szczawik „kocią łapką”.
Dialogue: 0,0:19:08.29,0:19:12.17,Default,Maomao,0,0,0,,Mieszanka ich soków pozwala uzyskać\Nintensywną czerwień na paznokciach.
Dialogue: 0,0:19:12.63,0:19:14.96,Default,Maomao,0,0,0,,Ale gdyby były ładniejsze...
Dialogue: 0,0:19:15.67,0:19:17.96,Default,Maomao,0,0,0,,I tak jest lepiej niż przedtem.
Dialogue: 0,0:19:19.61,0:19:22.37,Default,Maomao,0,0,0,,Panie Gaoshun.\NCo z przedmiotami, o które prosiłam?
Dialogue: 0,0:19:22.37,0:19:24.46,Default,Gaoshun,0,0,0,,Wszystko zgodnie z planem.
Dialogue: 0,0:19:25.08,0:19:26.97,Default,Maomao,0,0,0,,Dziękuję.
Dialogue: 0,0:19:28.10,0:19:30.64,Default,Maomao,0,0,0,,Czas wcielić plan w życie.
Dialogue: 0,0:19:30.99,0:19:36.60,Default,Maomao,0,0,0,,Wystarczy by wywaliło\Npewnego typka z kapci.
Dialogue: 0,0:19:39.19,0:19:43.93,Default,Lakan,0,0,0,,Nie sądziłem,\Nże moja prowokacja zawiedzie.
Dialogue: 0,0:19:51.79,0:19:55.66,Default,Lakan,0,0,0,,Dla mnie ludzie wyglądają jak bierki.
Dialogue: 0,0:19:55.66,0:19:58.92,Default,Lakan,0,0,0,,Mężczyźni są czarnymi,\Na kobiety białymi.
Dialogue: 0,0:19:58.92,0:20:11.31,Default,Text,0,0,0,,{\an8}PIONEK
Dialogue: 0,0:19:58.92,0:20:11.31,Default,Text,0,0,0,,{\an8}PIONEK
Dialogue: 0,0:19:58.92,0:20:11.31,Default,Text,0,0,0,,{\an8}PIONEK
Dialogue: 0,0:19:58.92,0:20:11.31,Default,Text,0,0,0,,{\an8}PIONEK
Dialogue: 1,0:19:59.33,0:20:03.70,Default,Lakan,0,0,0,,Nawet moi podwładni w armii\Nsą co najwyżej figurkami do Xiangqi.
Dialogue: 1,0:20:04.41,0:20:07.10,Default,Lakan,0,0,0,,Większość z nich to zwykłe pionki.
Dialogue: 1,0:20:07.10,0:20:11.31,Default,Lakan,0,0,0,,Tylko nieliczni zyskują rangę skoczków.
Dialogue: 1,0:20:11.31,0:20:16.40,Default,Text,0,0,0,,{\an8}RZEKA
Dialogue: 0,0:20:11.77,0:20:13.95,Default,Lakan,0,0,0,,Praca w wojsku to prościzna.
Dialogue: 0,0:20:14.44,0:20:16.98,Default,Lakan,0,0,0,,Trzeba tylko wiedzieć,\Ngdzie kogo umieścić.
Dialogue: 0,0:20:18.10,0:20:22.32,Default,Lakan,0,0,0,,Każdy na właściwym miejscu.\NTo klucz do wygrania wojny.
Dialogue: 0,0:20:22.95,0:20:27.17,Default,Lakan,0,0,0,,To prościzna. Nawet gdybym\Nbył kompletnie do niczego,
Dialogue: 0,0:20:27.17,0:20:31.45,Default,Lakan,0,0,0,,jeśli ustawię innych na właściwych\Nmiejscach, robota zrobi się sama.
Dialogue: 0,0:20:32.49,0:20:35.48,Default,Lakan,0,0,0,,Dziś oczy pieką mnie bardziej niż zwykle.
Dialogue: 0,0:20:35.48,0:20:37.85,Default,Lakan,0,0,0,,Ciągle widzę migoczący czerwony kolor.
Dialogue: 0,0:20:40.20,0:20:42.26,Default,Lakan,0,0,0,,Lakier do paznokci...
Dialogue: 0,0:20:42.85,0:20:47.16,Default,Lakan,0,0,0,,Ten manicure z moich wspomnień\Nnie był zbyt jaskrawy.
Dialogue: 0,0:20:48.06,0:20:51.85,Default,Lakan,0,0,0,,Przypominał bardziej kolor niecierpka.
Dialogue: 0,0:20:57.98,0:21:02.49,Default,Text,0,0,0,,{\an8}DORADCA
Dialogue: 0,0:20:57.98,0:21:02.49,Default,Text,0,0,0,,{\an8}PIESEK
Dialogue: 0,0:22:35.04,0:22:37.04,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:22:46.58,0:22:50.05,Default,Narrator,0,0,0,,W kolejnym odcinku:\N„Niecierpek i szczawik”.
Dialogue: 0,0:22:46.58,0:22:50.05,Default,Narrator,0,0,0,,Tłumaczenie: Sylwia Wolińska\NFORCE MEDIA
