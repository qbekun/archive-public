Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 1,0:00:13.74,0:00:19.45,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:33.98,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:36.31,0:01:39.77,Default,Maomao,0,0,0,,{\i1}Plotki żyją własnym życiem.
Dialogue: 0,0:01:39.77,0:01:42.85,Default,Maomao,0,0,0,,{\i1}Im szybciej się rozchodzą,\Ntym bardziej oddalają się od prawdy.
Dialogue: 0,0:01:42.85,0:01:45.79,Default,Maomao,0,0,0,,{\i1}Niekiedy plotki stają się\Nczymś zupełnie innym.
Dialogue: 0,0:01:47.06,0:01:51.54,Default,Maomao,0,0,0,,{\i1}Całkiem możliwe, że podobne\Nsą do bajek czy mitologii.
Dialogue: 0,0:01:51.79,0:01:55.76,Default,Text,0,0,0,,{\an8}ODCINEK 29: KSIĘŻYCOWA WRÓŻKA
Dialogue: 0,0:01:54.99,0:01:55.80,Default,Maomao,0,0,0,,Wychodzę.
Dialogue: 0,0:01:56.18,0:01:57.50,Default,Hongniang,0,0,0,,Powodzenia.
Dialogue: 0,0:01:58.78,0:02:01.47,Default,Maomao,0,0,0,,{\i1}Zniszczony sad brzoskwiniowy\Nna północnej stronie wewnętrznego pałacu...
Dialogue: 0,0:02:01.89,0:02:04.60,Default,Maomao,0,0,0,,{\i1}Obok niego stary budynek\Nprzypominający świątynię...
Dialogue: 0,0:02:04.97,0:02:06.40,Default,Maomao,0,0,0,,{\i1}I jeziorko.
Dialogue: 0,0:02:07.50,0:02:11.30,Default,Maomao,0,0,0,,{\i1}Kiedyś to miejsce\Nbyło domem dla innej ludności.
Dialogue: 0,0:02:11.30,0:02:14.58,Default,Maomao,0,0,0,,{\i1}Podobno wciąż korzystamy\Nz budynków, murów
Dialogue: 0,0:02:14.58,0:02:16.99,Default,Maomao,0,0,0,,{\i1}i podziemnej drogi wodnej,\Nktóre po sobie zostawili.
Dialogue: 0,0:02:19.03,0:02:20.27,Default,Shisui,0,0,0,,Zgaduj zgadula.
Dialogue: 0,0:02:20.98,0:02:21.98,Default,Maomao,0,0,0,,Shisui.
Dialogue: 0,0:02:22.85,0:02:25.41,Default,Shisui,0,0,0,,Bingo! Poznałaś po głosie?
Dialogue: 0,0:02:25.94,0:02:30.00,Default,Maomao,0,0,0,,{\i1}Jest sympatyczna. Nic dziwnego,\Nże Xiaolan się z nią zadaje.
Dialogue: 0,0:02:31.00,0:02:32.89,Default,Shisui,0,0,0,,Co porabiasz, Maomao?
Dialogue: 0,0:02:32.89,0:02:35.60,Default,Maomao,0,0,0,,O to samo mogę spytać ciebie.\NCo tu robisz?
Dialogue: 0,0:02:35.60,0:02:38.72,Default,Shisui,0,0,0,,Ja? Miałam tu coś do załatwienia.
Dialogue: 0,0:02:40.85,0:02:41.74,Default,Maomao,0,0,0,,Złodziejka?
Dialogue: 0,0:02:41.74,0:02:42.68,Default,Shisui,0,0,0,,Nie do końca.
Dialogue: 0,0:02:42.99,0:02:44.39,Default,Shisui,0,0,0,,Trzymaj!
Dialogue: 0,0:02:49.83,0:02:51.56,Default,Shisui,0,0,0,,Słodziaszek, nie?
Dialogue: 0,0:02:51.56,0:02:56.03,Default,Maomao,0,0,0,,Normalnie nazywają to\Nnękaniem, nie rób tego innym.
Dialogue: 0,0:02:56.03,0:02:59.94,Default,Shisui,0,0,0,,Co? Czemu?\NTo przecież słodziaszne!
Dialogue: 0,0:03:01.29,0:03:03.57,Default,Shisui,0,0,0,,Ta miejscówka jest świetna!
Dialogue: 0,0:03:03.57,0:03:06.17,Default,Shisui,0,0,0,,Pełno tu owadów,\Nktóre widziałam tylko w książkach!
Dialogue: 0,0:03:06.17,0:03:08.41,Default,Shisui,0,0,0,,Te okazy spotkałam tu po raz pierwszy!
Dialogue: 0,0:03:09.26,0:03:10.62,Default,Maomao,0,0,0,,Łapię.
Dialogue: 0,0:03:11.29,0:03:13.77,Default,Maomao,0,0,0,,{\i1}Od wieków ten teren\Nbył punktem handlowym.
Dialogue: 0,0:03:13.77,0:03:17.63,Default,Maomao,0,0,0,,{\i1}Zgaduję, że niektóre owady trafiły\Ntu z towarami na handel i zostały tutaj.
Dialogue: 0,0:03:18.22,0:03:19.52,Default,Maomao,0,0,0,,Może będą to motylki?
Dialogue: 0,0:03:19.52,0:03:21.32,Default,Shisui,0,0,0,,Nie, to ćmy!
Dialogue: 0,0:03:21.32,0:03:25.14,Default,Shisui,0,0,0,,Prowadzą nocny tryb życia, więc teraz\Nich nie zobaczysz, ale są przepiękne!
Dialogue: 0,0:03:27.64,0:03:30.33,Default,Maomao,0,0,0,,{\i1}Ciekawe, czy były tutaj,\Ngdy staruszka tańcowała.
Dialogue: 0,0:03:31.72,0:03:34.08,Default,Shisui,0,0,0,,Powinnaś zobaczyć je nocą, Maomao!
Dialogue: 0,0:03:34.08,0:03:36.48,Default,Shisui,0,0,0,,Latają i błyszczą w świetle księżyca...
Dialogue: 0,0:03:36.48,0:03:39.61,Default,Shisui,0,0,0,,Poczujesz się jak w raju!
Dialogue: 0,0:03:39.90,0:03:41.92,Default,Maomao,0,0,0,,To lekka przesada...
Dialogue: 0,0:03:43.03,0:03:45.49,Default,Maomao,0,0,0,,{\i1}Błyszczą w świetle księżyca?
Dialogue: 0,0:03:45.90,0:03:48.80,Default,Maomao,0,0,0,,Łączą się w pary zaraz po wylęgu?
Dialogue: 0,0:03:48.80,0:03:54.85,Default,Shisui,0,0,0,,Chyba tak? Podobno padają zaraz\Npo wyrośnięciu, bo nie mogą jeść.
Dialogue: 0,0:03:54.85,0:03:58.22,Default,Maomao,0,0,0,,Umiesz rozróżnić samicę od samca?
Dialogue: 0,0:03:58.22,0:04:00.21,Default,Shisui,0,0,0,,Chyba tak...
Dialogue: 0,0:04:00.49,0:04:01.22,Default,Maomao,0,0,0,,Shisui!
Dialogue: 0,0:04:01.22,0:04:01.81,Default,Shisui,0,0,0,,Co?
Dialogue: 0,0:04:01.81,0:04:03.72,Default,Maomao,0,0,0,,Potrzebuję twojej\Npomocy w jednej sprawie.
Dialogue: 0,0:04:06.74,0:04:09.31,Default,Maomao,0,0,0,,{\i1}To... To może się udać!
Dialogue: 0,0:04:10.29,0:04:11.82,Default,Shisui,0,0,0,,Czy to coś złego?
Dialogue: 0,0:04:45.58,0:04:49.74,Default,Maomao,0,0,0,,{\i1}Kilka dni później zorganizowano\Nbankiet dla wysłanniczek.
Dialogue: 0,0:04:50.31,0:04:54.60,Default,Maomao,0,0,0,,{\i1}Odbył się on w północnym ogrodzie,\Ngdzie 50 lat temu pojawiła się „Księżycowa Wróżka”.
Dialogue: 0,0:04:56.02,0:04:58.56,Default,Maomao,0,0,0,,{\i1}Zazwyczaj wewnętrzny pałac\Njest niedostępny dla facetów,
Dialogue: 0,0:04:58.56,0:05:01.84,Default,Maomao,0,0,0,,{\i1}ale zrobiono wyjątek,\Nby umożliwić udział męskim urzędnikom.
Dialogue: 0,0:05:01.84,0:05:04.36,Default,Maomao,0,0,0,,{\i1}Konkubiny wysokiej rangi\Ntakże się przyłączyły.
Dialogue: 0,0:05:05.29,0:05:08.31,Default,Maomao,0,0,0,,{\i1}Goście mogli podziwiać\Nwystępy w swoich powozach.
Dialogue: 0,0:05:09.61,0:05:11.30,Default,Maomao,0,0,0,,{\i1}Zrobiono to z troski o wysłanniczki,
Dialogue: 0,0:05:11.30,0:05:13.68,Default,Maomao,0,0,0,,{\i1}aby nie przyciągały zbędnej uwagi, ale...
Dialogue: 0,0:05:16.35,0:05:19.98,Default,Maomao,0,0,0,,Niebieskie oczy, złote włosy...\Nsą naprawdę piękne.
Dialogue: 0,0:05:19.98,0:05:22.17,Default,Maomao,0,0,0,,Wiedziałam. Zwykły występ\Nnie zrobiłby na nich wrażenia.
Dialogue: 0,0:05:23.11,0:05:27.26,Default,Maomao,0,0,0,,{\i1}Mają też uniesione rolety,\Npokazując cesarzowi swoje twarze.
Dialogue: 0,0:05:27.55,0:05:29.62,Default,Maomao,0,0,0,,{\i1}Naprawdę muszą być pewne siebie.
Dialogue: 0,0:05:30.62,0:05:33.96,Default,Maomao,0,0,0,,{\i1}Jedna z nich wygląda na cichą osóbkę,
Dialogue: 0,0:05:33.96,0:05:36.28,Default,Maomao,0,0,0,,{\i1}od drugiej zaś bije taka pewność siebie,
Dialogue: 0,0:05:36.28,0:05:38.81,Default,Maomao,0,0,0,,{\i1}jakby wiedziała, że jest\Nnajpiękniejszą laską na świecie.
Dialogue: 0,0:05:39.24,0:05:41.90,Default,Maomao,0,0,0,,{\i1}Z pewnością te dwie wysłanniczki
Dialogue: 0,0:05:41.90,0:05:45.32,Default,Maomao,0,0,0,,{\i1}nie ustępują urodą\Nkonkubinom wysokiej rangi.
Dialogue: 0,0:05:55.29,0:05:58.36,Default,Maomao,0,0,0,,{\i1}Muzyka i występy są bardziej\Nspektakularne niż zwykle.
Dialogue: 0,0:05:58.36,0:06:00.50,Default,Maomao,0,0,0,,{\i1}Zgaduję, że ma pasować do wysłanniczek.
Dialogue: 0,0:06:00.82,0:06:04.20,Default,Maomao,0,0,0,,{\i1}Ale... Chyba je to nudzi.
Dialogue: 0,0:06:04.20,0:06:06.51,Default,Maomao,0,0,0,,{\i1}Zdaję się, że widziały duże lepsze występy.
Dialogue: 0,0:06:07.17,0:06:09.26,Default,Maomao,0,0,0,,Naprawdę wyglądają identycznie.
Dialogue: 0,0:06:09.99,0:06:13.70,Default,Maomao,0,0,0,,Wiedziałam, że są kuzynkami,\Nale wyglądają jak bliźniaczki.
Dialogue: 0,0:06:14.10,0:06:18.83,Default,Maomao,0,0,0,,Tej dwójce udałaby się sztuczka\Nz lustrem z historii pana Gaoshuna.
Dialogue: 0,0:06:31.81,0:06:33.23,Default,Ayla,0,0,0,,Witaj.
Dialogue: 0,0:06:33.23,0:06:37.16,Default,Ayla,0,0,0,,Nie chcę siedzieć tak daleko\Npodczas tak wspaniałej imprezy.
Dialogue: 0,0:06:38.01,0:06:41.00,Default,Ayla,0,0,0,,Wolałabym być bliżej,\Nby móc z tobą porozmawiać.
Dialogue: 0,0:06:42.11,0:06:45.61,Default,Ayla,0,0,0,,Słyszałam, że twój brat\Nnie będzie dzisiaj obecny.
Dialogue: 0,0:06:45.61,0:06:48.05,Default,Ayla,0,0,0,,Chciałabym go poznać.
Dialogue: 0,0:06:50.81,0:06:53.89,Default,Maomao,0,0,0,,{\i1}Rany, żenada.\NŻenada do kwadratu.
Dialogue: 0,0:06:54.75,0:06:58.35,Default,Maomao,0,0,0,,{\i1}Prawdziwym celem wysłanniczek\Njest dotarcie do cesarza i jego brata...
Dialogue: 0,0:06:58.84,0:07:00.61,Default,Maomao,0,0,0,,{\i1}By zyskać ich sympatię.
Dialogue: 0,0:07:00.61,0:07:05.27,Default,Maomao,0,0,0,,{\i1}Polityczna intryga związana z małżeństwem.
Dialogue: 0,0:07:05.81,0:07:07.72,Default,Ayla,0,0,0,,Jeśli cię to zadowoli...
Dialogue: 0,0:07:07.72,0:07:08.63,Default,Aylin,0,0,0,,Ayla.
Dialogue: 0,0:07:09.87,0:07:15.53,Default,Aylin,0,0,0,,Wystarczy tego. Przygotowali dla nas świetne\Nwidowisko. Powinnyśmy się nim rozkoszować.
Dialogue: 0,0:07:17.90,0:07:19.71,Default,Ayla,0,0,0,,Proszę mi wybaczyć.
Dialogue: 0,0:07:27.24,0:07:28.17,Default,Gyokuyou,0,0,0,,Hongniang.
Dialogue: 0,0:07:28.48,0:07:31.43,Default,Maomao,0,0,0,,{\i1}Kryzys zażegnany. To było straszne.
Dialogue: 0,0:07:32.66,0:07:38.43,Default,Maomao,0,0,0,,{\i1}Te dwie chyba nie są zainteresowane\Nlegendarnym pięknem, które widział ich dziadek.
Dialogue: 0,0:07:39.23,0:07:43.86,Default,Maomao,0,0,0,,{\i1}„Nie ma nikogo piękniejszego od nas”.\NTo jest ich prawdziwe przekonanie.
Dialogue: 0,0:07:44.59,0:07:50.32,Default,Maomao,0,0,0,,{\i1}Może lustra, które wysłały do\Nkonkubin, były tylko prowokacją.
Dialogue: 0,0:07:51.05,0:07:55.78,Default,Maomao,0,0,0,,{\i1}Nieważne. Moim zadaniem jest\Npokazanie im „Księżycowej Wróżki”.
Dialogue: 0,0:08:00.78,0:08:03.96,Default,Maomao,0,0,0,,Bankiet dobiega końca. Jak idzie?
Dialogue: 0,0:08:04.57,0:08:08.00,Default,Gaoshun,0,0,0,,Zrobiłem, co mogłem.
Dialogue: 0,0:08:10.42,0:08:13.30,Default,Maomao,0,0,0,,{\i1}Myślę, że to normalna reakcja.
Dialogue: 0,0:08:15.55,0:08:17.48,Default,Maomao,0,0,0,,Dobra, idziemy.
Dialogue: 0,0:08:24.60,0:08:28.78,Default,Ayla,0,0,0,,Zdaje się, że muzyka stała\Nsię bardziej dopasowana do nas,
Dialogue: 0,0:08:28.78,0:08:32.04,Default,Ayla,0,0,0,,ale taniec tyłka nie urwał, Aylin.
Dialogue: 0,0:08:33.07,0:08:36.37,Default,Ayla,0,0,0,,Cztery słynne konkubiny są ukryte za żaluzjami.
Dialogue: 0,0:08:36.37,0:08:39.83,Default,Ayla,0,0,0,,Księżycowa Wróżka, którą widział nasz dziadek,\Nzapewne też nie była czymś wyjątkowym.
Dialogue: 0,0:08:39.83,0:08:43.11,Default,Aylin,0,0,0,,Ayla, nie mówmy teraz o tym.
Dialogue: 0,0:08:43.80,0:08:45.75,Default,Aylin,0,0,0,,Porozmawiamy o tym,\Ngdy wrócimy do pokoju.
Dialogue: 0,0:08:48.58,0:08:52.22,Default,Ayla,0,0,0,,A co, jeśli cesarz zechce nas od razu?
Dialogue: 0,0:09:09.55,0:09:10.80,Default,Maomao,0,0,0,,{\i1}Ten koleś...
Dialogue: 0,0:09:33.87,0:09:34.88,Default,Maomao,0,0,0,,{\i1}Pięćdziesiąt lat temu...
Dialogue: 0,0:09:35.77,0:09:40.26,Default,Maomao,0,0,0,,{\i1}Zgaduję, że to właśnie\Nwidział dziadek wysłanników.
Dialogue: 0,0:09:57.69,0:09:58.61,Default,Ayla,0,0,0,,Co jest grane?!
Dialogue: 0,0:09:58.61,0:09:59.64,Default,Ayla,0,0,0,,Gdzie ona się podziała?!
Dialogue: 0,0:09:59.64,0:10:00.75,Default,Ayla,0,0,0,,Kto to naprawdę był?!
Dialogue: 0,0:10:03.65,0:10:04.78,Default,Maomao,0,0,0,,Diana.
Dialogue: 0,0:10:08.22,0:10:11.96,Default,Maomao,0,0,0,,{\i1}Nie wiem, czy dobrze wymówiłam,\Nale chyba tak.
Dialogue: 0,0:10:15.46,0:10:19.06,Default,Maomao,0,0,0,,{\i1}Imię bogini księżyca z zachodniej legendy.
Dialogue: 0,0:10:21.51,0:10:22.76,Default,Gaoshun,0,0,0,,Wygląda na to, że się udało.
Dialogue: 0,0:10:22.76,0:10:26.39,Default,Maomao,0,0,0,,Tak, chyba udało nam\Nsię osiągnąć to, co chcieliśmy.
Dialogue: 0,0:10:26.81,0:10:28.89,Default,Maomao,0,0,0,,Ściąganie ciemnej szmatki w ciemności
Dialogue: 0,0:10:29.25,0:10:31.94,Default,Maomao,0,0,0,,zrobi pozory, że nagle ktoś pojawił się obok.
Dialogue: 0,0:10:31.94,0:10:34.67,Default,Maomao,0,0,0,,Jednak te ćmy są efektem końcowym.
Dialogue: 0,0:10:35.53,0:10:39.21,Default,Maomao,0,0,0,,{\i1}Świecące światła widoczne\Nna obrazie staruszki
Dialogue: 0,0:10:39.21,0:10:40.70,Default,Maomao,0,0,0,,{\i1}były w rzeczywistości dorosłymi ćmami.
Dialogue: 0,0:10:41.23,0:10:43.45,Default,Maomao,0,0,0,,{\i1}Staruszka mówiła, że to był żart.
Dialogue: 0,0:10:43.45,0:10:47.33,Default,Old Lady,0,0,0,,{\i1}Po tym wszystkim i tak znalazły się\Nidiotki, które uszkodziły mój kostium.
Dialogue: 0,0:10:47.33,0:10:50.33,Default,Old Lady,0,0,0,,{\i1}Natarły go truchłami owadów.
Dialogue: 0,0:10:51.34,0:10:55.09,Default,Maomao,0,0,0,,{\i1}Niektóre owady wydzielają zapachy,\Nktóre przyciągają płeć przeciwną.
Dialogue: 0,0:10:55.85,0:10:59.72,Default,Maomao,0,0,0,,{\i1}Samce ciem przyciągał do staruszki zapach.
Dialogue: 0,0:11:00.01,0:11:03.90,Default,Maomao,0,0,0,,{\i1}Ich blask sprawiał, że wyglądała\Njak księżycowa wróżka, tańcząca wśród świateł.
Dialogue: 0,0:11:03.90,0:11:05.94,Default,Maomao,0,0,0,,{\i1}Co za przypadek...
Dialogue: 0,0:11:05.94,0:11:09.86,Default,Maomao,0,0,0,,{\i1}Muszę podziękować\NShisui i Xiaolan za pomoc.
Dialogue: 0,0:11:11.65,0:11:15.86,Default,Maomao,0,0,0,,{\i1}Dopilnowanie, by zobaczyły\Nto tylko wysłanniczki, wymagało wiele pracy.
Dialogue: 0,0:11:16.74,0:11:20.43,Default,Maomao,0,0,0,,{\i1}Trzeba było upewnić się,\Nże woźnica nie spojrzy w tę stronę.
Dialogue: 0,0:11:20.43,0:11:22.82,Default,Maomao,0,0,0,,{\i1}Pan Gaoshun i kilka innych\Nosób było w pobliżu,
Dialogue: 0,0:11:22.82,0:11:25.12,Default,Maomao,0,0,0,,{\i1}więc gdyby coś się stało,\Nmogliby wkroczyć do akcji.
Dialogue: 0,0:11:26.51,0:11:29.12,Default,Maomao,0,0,0,,{\i1}Tego widoku nie powinien oglądać nikt inny.
Dialogue: 0,0:11:29.91,0:11:34.57,Default,Maomao,0,0,0,,{\i1}To naprawdę potężna scena,\Nwystarczająca do upadku narodów.
Dialogue: 0,0:11:35.23,0:11:36.13,Default,Jinshi,0,0,0,,Ej!
Dialogue: 0,0:11:36.91,0:11:39.13,Default,Jinshi,0,0,0,,Ignorujesz mnie po tym,\Njak zrobiłem to, co mi kazałaś?
Dialogue: 0,0:11:40.43,0:11:43.23,Default,Maomao,0,0,0,,Dziękuję bardzo, panie Jinshi,
Dialogue: 0,0:11:43.23,0:11:46.60,Default,Maomao,0,0,0,,za pływanie aż do przeciwległego\Nbrzegu w tym ciężkim stroju.
Dialogue: 0,0:11:47.13,0:11:49.21,Default,Jinshi,0,0,0,,Udało się?
Dialogue: 0,0:11:49.21,0:11:54.65,Default,Maomao,0,0,0,,Tak, myślę, że idealnie\Nspełniliśmy ich oczekiwania.
Dialogue: 0,0:11:55.25,0:11:58.15,Default,Jinshi,0,0,0,,Rozumiem. Cóż, nie mam już na to wpływu.
Dialogue: 0,0:11:58.15,0:11:59.65,Default,Jinshi,0,0,0,,Moje włosy same nie wyschną!
Dialogue: 0,0:12:07.91,0:12:10.25,Default,Maomao,0,0,0,,{\i1}Sam mógł to zrobić.
Dialogue: 0,0:12:19.43,0:12:21.95,Default,Ayla,0,0,0,,Dobrze więc.
Dialogue: 0,0:12:31.52,0:12:32.73,Default,Xiaolan,0,0,0,,O, Maomao!
Dialogue: 0,0:12:33.47,0:12:35.70,Default,Xiaolan,0,0,0,,Zaraz idę do szkółki!
Dialogue: 0,0:12:35.70,0:12:39.54,Default,Maomao,0,0,0,,A, faktycznie udało im się to zrealizować.
Dialogue: 0,0:12:39.90,0:12:42.46,Default,Xiaolan,0,0,0,,Jestem dumna, że należę\Ndo pierwszego pokolenia!
Dialogue: 0,0:12:42.46,0:12:43.99,Default,Xiaolan,0,0,0,,Dobra, lecę!
Dialogue: 0,0:12:44.82,0:12:45.95,Default,Maomao,0,0,0,,Powodzonka.
Dialogue: 0,0:12:56.84,0:12:58.32,Default,Maomao,0,0,0,,{\i1}Ale nudy.
Dialogue: 0,0:12:59.02,0:13:02.81,Default,Maomao,0,0,0,,{\i1}W Jadeitowym Pałacu\Nnie ma wiele do roboty.
Dialogue: 0,0:13:03.24,0:13:08.20,Default,Maomao,0,0,0,,{\i1}— Konował jest chyba zajęty\Nsprawą olejków zapachowych.
Dialogue: 0,0:13:04.07,0:13:07.47,Default,Guen,0,0,0,,{\an8}— Tutaj! Nie, tutaj!
Dialogue: 0,0:13:09.25,0:13:13.31,Default,Maomao,0,0,0,,{\i1}Kwestia ta nie została\Njeszcze całkowicie rozwiązana.
Dialogue: 0,0:13:14.10,0:13:18.31,Default,Maomao,0,0,0,,{\i1}Osobno są nieszkodliwe,\Nale w połączeniu mogą być trujące.
Dialogue: 0,0:13:18.91,0:13:22.82,Default,Maomao,0,0,0,,{\i1}Komu zależało, by je tu sprowadzić?
Dialogue: 0,0:13:23.67,0:13:25.22,Default,Jinshi,0,0,0,,{\i1}Zajmuję się tym.
Dialogue: 0,0:13:25.22,0:13:28.32,Default,Jinshi,0,0,0,,{\i1}Olejki kupowane były w dużych\Nilościach we wszystkich pałacach.
Dialogue: 0,0:13:28.93,0:13:31.20,Default,Jinshi,0,0,0,,{\i1}Łącznie z kobietami z Jadeitowego Pałacu.
Dialogue: 0,0:13:31.20,0:13:33.56,Default,Jinshi,0,0,0,,{\i1}Kazałem się pozbyć wszystkich,\Nktóre mogłyby stać się trujące, ale...
Dialogue: 0,0:13:33.99,0:13:38.21,Default,Jinshi,0,0,0,,{\i1}Czy jest możliwe,\Nże to sprawka wysłanniczek?
Dialogue: 0,0:13:38.21,0:13:39.71,Default,Maomao,0,0,0,,{\i1}Kto wie.
Dialogue: 0,0:13:39.71,0:13:45.38,Default,Maomao,0,0,0,,{\i1}Byłam pewna, że „zgarnięcie miejsca jako\Nkonkubina” było jednym z ich celów, ale...
Dialogue: 0,0:13:45.38,0:13:49.18,Default,Maomao,0,0,0,,{\i1}gdy ich duma została zniszczona,\Nmają lepsze zmartwienia na głowie.
Dialogue: 0,0:13:56.03,0:13:58.60,Default,Maomao,0,0,0,,{\i1}W wewnętrznych pałacu znajdują się\Ncztery konkubiny wysokiej rangi.
Dialogue: 0,0:13:59.24,0:14:01.02,Default,Maomao,0,0,0,,{\i1}Z uwagi na wpływ,\Njaki wywiera jej ojciec,
Dialogue: 0,0:14:01.62,0:14:04.58,Default,Maomao,0,0,0,,{\i1}konkubina Loulan\Npowinna być najważniejsza.
Dialogue: 0,0:14:05.41,0:14:08.50,Default,Maomao,0,0,0,,{\i1}Jej ojciec, Shishou, jest ulubionym\Nurzędnikiem, który pełni tę funkcję
Dialogue: 0,0:14:08.50,0:14:10.83,Default,Maomao,0,0,0,,{\i1}od czasów panowania\Npoprzedniego cesarza.
Dialogue: 0,0:14:10.83,0:14:13.58,Default,Maomao,0,0,0,,{\i1}Cesarz często ją odwiedza,
Dialogue: 0,0:14:14.11,0:14:16.68,Default,Maomao,0,0,0,,{\i1}chociaż nie sprawia wrażenia,\Nby go to interesowało.
Dialogue: 0,0:14:17.58,0:14:20.76,Default,Maomao,0,0,0,,{\i1}Konkubina Li Hua jest drugą\Npod względem władzy w rodzinie,
Dialogue: 0,0:14:20.76,0:14:23.64,Default,Maomao,0,0,0,,{\i1}ale ma to związek z faktu,\Nże są spokrewnieni z cesarzem.
Dialogue: 0,0:14:23.64,0:14:25.86,Default,Maomao,0,0,0,,{\i1}Dzięki temu nie jest tak żądna władzy.
Dialogue: 0,0:14:26.37,0:14:29.09,Default,Maomao,0,0,0,,{\i1}Po stracie księcia zachorowała,
Dialogue: 0,0:14:29.09,0:14:32.25,Default,Maomao,0,0,0,,{\i1}ale po powrocie do zdrowia\Nzyskała sympatię cesarza.
Dialogue: 0,0:14:33.50,0:14:37.98,Default,Maomao,0,0,0,,{\i1}Z kolei rodzina konkubiny Li Shu\Nzdobyła władzę w ostatnich pokoleniach.
Dialogue: 0,0:14:37.98,0:14:41.93,Default,Maomao,0,0,0,,{\i1}Są ambitni, wysłali nawet swoją\Nmłodą córkę do wcześniejszego cesarza.
Dialogue: 0,0:14:42.37,0:14:46.32,Default,Maomao,0,0,0,,{\i1}Ale, na ich nieszczęście,\Ncesarz lubi lubieżne kobiety.
Dialogue: 0,0:14:46.78,0:14:50.49,Default,Maomao,0,0,0,,{\i1}Podobno nawet po odejściu\Nkonkubiny A Duo nie tknął jej ani razu.
Dialogue: 0,0:14:51.62,0:14:55.40,Default,Maomao,0,0,0,,{\i1}Z drugiej strony, konkubina Gyokuyou\Ncieszy się największą sympatią cesarza.
Dialogue: 0,0:14:55.85,0:15:00.23,Default,Maomao,0,0,0,,{\i1}Oprócz księżniczki Ling Li\Nspodziewa się kolejnego dziecka cesarza.
Dialogue: 0,0:15:00.93,0:15:05.85,Default,Maomao,0,0,0,,{\i1}Zachodni kraj, z którego pochodzi,\Nrozkwita dzięki handlowi,
Dialogue: 0,0:15:05.85,0:15:09.55,Default,Maomao,0,0,0,,{\i1}ale w rzeczywistości podobno nie\Nsą aż tak bogaci z powodu słabej ziemi.
Dialogue: 0,0:15:10.54,0:15:14.60,Default,Maomao,0,0,0,,{\i1}Konkubina Gyokuyou\Nbyła dwukrotną ofiarą próby otrucia.
Dialogue: 0,0:15:15.90,0:15:18.75,Default,Maomao,0,0,0,,{\i1}Winowajczynią zeszłorocznego\Nincydentu na przyjęciu w ogrodzie
Dialogue: 0,0:15:18.75,0:15:20.81,Default,Maomao,0,0,0,,{\i1}była główna służka konkubiny A Duo,
Dialogue: 0,0:15:20.81,0:15:23.76,Default,Maomao,0,0,0,,{\i1}która uknuła spisek\Nprzeciwko konkubinie Li Shu.
Dialogue: 0,0:15:24.68,0:15:30.04,Default,Maomao,0,0,0,,{\i1}Nie robiono tego dla władzy,\Nale z bardziej ludzkiego, osobistego powodu.
Dialogue: 0,0:15:31.01,0:15:34.97,Default,Maomao,0,0,0,,{\i1}Kto jednak stał za poprzednią\Npróbą otrucia konkubiny Gyokuyou,
Dialogue: 0,0:15:34.97,0:15:37.41,Default,Maomao,0,0,0,,{\i1}gdy była w ciąży z księżniczką Ling Li?
Dialogue: 0,0:15:38.71,0:15:42.46,Default,Maomao,0,0,0,,{\i1}Jeśli przypuszczenia pani Hongniang\Nsą trafne, była to konkubina średniej rangi,
Dialogue: 0,0:15:42.46,0:15:44.99,Default,Maomao,0,0,0,,{\i1}która zginęła w wypadku\Nspowodowanym przez grzyby.
Dialogue: 0,0:15:45.63,0:15:50.47,Default,Maomao,0,0,0,,{\i1}Skąd ta konkubina wiedziała o truciznach?
Dialogue: 0,0:15:51.47,0:15:52.22,Default,Maomao,0,0,0,,{\i1}Suirei...
Dialogue: 0,0:15:53.79,0:15:56.10,Default,Maomao,0,0,0,,{\i1}Nie wiadomo, co się z nią stało.
Dialogue: 0,0:15:57.14,0:15:59.85,Default,Maomao,0,0,0,,{\i1}Dlaczego? Z jakiego powodu?
Dialogue: 0,0:15:59.85,0:16:02.60,Default,Maomao,0,0,0,,{\i1}Dlaczego ścigała pana Jinshi?
Dialogue: 0,0:16:04.40,0:16:08.23,Default,Maomao,0,0,0,,Jestem tylko testerką.\NNie powinnam zaprzątać sobie tym głowy.
Dialogue: 0,0:16:08.70,0:16:10.82,Default,Maomao,0,0,0,,Może przejdę się na spacer.
Dialogue: 0,0:16:15.31,0:16:17.83,Default,Maomao,0,0,0,,{\i1}Sezon na wiśnie dobiega końca.
Dialogue: 0,0:16:18.41,0:16:21.75,Default,Maomao,0,0,0,,{\i1}Hmm? To są dwórki\Nz Kryształowego Pałacu.
Dialogue: 0,0:16:26.76,0:16:29.59,Default,Maomao,0,0,0,,{\i1}Lekka przesada. Przecież tylko\Ndelikutaśnie utarłam im nosa.
Dialogue: 0,0:16:32.43,0:16:36.70,Default,Maomao,0,0,0,,{\i1}Jest to jedyna kobieta Kryształowym Pałacu,\Nktóra nie używała olejków zapachowych.
Dialogue: 0,0:16:41.21,0:16:43.17,Default,Maomao,0,0,0,,{\i1}To dość dziwne,\Nbiorąc pod uwagą fakt,
Dialogue: 0,0:16:43.17,0:16:45.08,Default,Maomao,0,0,0,,{\i1}że cały Kryształowy Pałac\Npodąża za trendami,
Dialogue: 0,0:16:45.51,0:16:47.26,Default,Maomao,0,0,0,,{\i1}ale wszędzie znajdzie się jakiś odmieniec.
Dialogue: 0,0:16:54.09,0:16:56.50,Default,Ailan,0,0,0,,Jest mi niedobrze.
Dialogue: 0,0:16:56.50,0:16:58.46,Default,Yinghua,0,0,0,,Przeziębienie? Daj spokój.
Dialogue: 0,0:16:58.46,0:17:01.57,Default,Yinghua,0,0,0,,Nie chcemy, by pani Gyokuyou\Nczy księżniczka się zaraziły.
Dialogue: 0,0:17:01.57,0:17:03.62,Default,Ailan,0,0,0,,Starałam się być ostrożna, ale...
Dialogue: 0,0:17:05.87,0:17:09.84,Default,Maomao,0,0,0,,Masz lekką gorączkę.\NMogę zrobić ci jakieś lekarstwo.
Dialogue: 0,0:17:10.32,0:17:12.93,Default,Yinghua,0,0,0,,Może po przygotowaniu leku,
Dialogue: 0,0:17:12.93,0:17:15.18,Default,Yinghua,0,0,0,,zabierzesz ją do kliniki?
Dialogue: 0,0:17:15.93,0:17:17.84,Default,Maomao,0,0,0,,Kliniki?
Dialogue: 0,0:17:18.30,0:17:20.34,Default,Yinghua,0,0,0,,Ale nie tej pałacowej.
Dialogue: 0,0:17:20.34,0:17:24.29,Default,Yinghua,0,0,0,,Ailan wie, gdzie iść,\Ntylko zabierz ją ze sobą.
Dialogue: 0,0:17:24.29,0:17:25.60,Default,Maomao,0,0,0,,Dobrze.
Dialogue: 0,0:17:30.02,0:17:33.40,Default,Maomao,0,0,0,,{\i1}Nie wiedziałam, że takie miejsce istnieje\Npo północnej stronie wewnętrznego pałacu.
Dialogue: 0,0:17:34.23,0:17:36.40,Default,Maomao,0,0,0,,{\i1}Jest blisko pralni.
Dialogue: 0,0:17:36.40,0:17:39.45,Default,Maomao,0,0,0,,{\i1}Takie rozwiązanie jest skuteczne.\NMożna często prać ubrania i dywany.
Dialogue: 0,0:17:39.79,0:17:42.41,Default,Ailan,0,0,0,,Przepraszam. Chyba się przeziębiłam.
Dialogue: 0,0:17:43.53,0:17:45.87,Default,Maomao,0,0,0,,{\i1}Służka w średnim wieku?\NNieczęsty widok.
Dialogue: 0,0:17:47.50,0:17:50.00,Default,Shenlü,0,0,0,,Lekka gorączka. Pokaż język.
Dialogue: 0,0:17:50.89,0:17:54.74,Default,Shenlü,0,0,0,,Hmm. Nie jest tak źle.
Dialogue: 0,0:17:55.26,0:17:58.68,Default,Shenlü,0,0,0,,Nic ci nie będzie, jeśli nie będziesz się\Nzbytnio forsować przez kilka następnych dni.
Dialogue: 0,0:17:58.68,0:17:59.86,Default,Shenlü,0,0,0,,Co ty na to?
Dialogue: 0,0:17:59.86,0:18:02.86,Default,Ailan,0,0,0,,Nie chcę, żeby konkubiny się zaraziły.
Dialogue: 0,0:18:02.86,0:18:05.45,Default,Ailan,0,0,0,,Mogłabym przenocować,\Ntak dla bezpieczeństwa?
Dialogue: 0,0:18:06.19,0:18:07.73,Default,Shenlü,0,0,0,,Chodź za mną.
Dialogue: 0,0:18:07.73,0:18:12.69,Default,Maomao,0,0,0,,{\i1}Wydaje się o wiele bardziej fachowa\Nniż ten konował, diagnoza też jest trafna.
Dialogue: 0,0:18:15.98,0:18:18.57,Default,Ailan,0,0,0,,Nie cierpię tego zapachu.
Dialogue: 0,0:18:18.57,0:18:22.58,Default,Maomao,0,0,0,,To alkohol. Co znaczy, że to miejsce\Njest utrzymywane w czystości.
Dialogue: 0,0:18:23.43,0:18:26.08,Default,Maomao,0,0,0,,Jest tu wiele okien,\Nco zapewnia dobrą wentylację.
Dialogue: 0,0:18:26.42,0:18:29.39,Default,Maomao,0,0,0,,Przestrzeń jest utrzymana w prostym stylu,\Nco ułatwia dokładne czyszczenie.
Dialogue: 0,0:18:29.39,0:18:31.75,Default,Maomao,0,0,0,,To idealne miejsce\Nna odzyskanie sił po chorobie.
Dialogue: 0,0:18:33.46,0:18:35.37,Default,Shenlü,0,0,0,,To pokój dla ciebie.
Dialogue: 0,0:18:35.37,0:18:37.26,Default,Ailan,0,0,0,,Dziękuję.
Dialogue: 0,0:18:37.26,0:18:40.40,Default,Ailan,0,0,0,,Maomao, powiedz reszcie,\Nże wrócę jutro.
Dialogue: 0,0:18:40.40,0:18:41.34,Default,Maomao,0,0,0,,Jasna sprawa.
Dialogue: 0,0:18:46.39,0:18:50.49,Default,Maomao,0,0,0,,{\i1}W ten sposób poddają kwarantannie\Nsłużki, które nie czują się najlepiej.
Dialogue: 0,0:18:51.19,0:18:53.39,Default,Shenlü,0,0,0,,A ty, wracaj do roboty.
Dialogue: 0,0:18:53.83,0:18:57.11,Default,Shenlü,0,0,0,,Nie myśl, że pomaganie chorej\Nzwalnia cię z obowiązków.
Dialogue: 0,0:18:57.11,0:19:01.91,Default,Shenlü,0,0,0,,A może chcesz poskładać to pranie?
Dialogue: 0,0:19:03.17,0:19:04.72,Default,Maomao,0,0,0,,Proszę wybaczyć!
Dialogue: 0,0:19:06.39,0:19:09.62,Default,Maomao,0,0,0,,{\i1}Naprawdę nie znoszę starych bab.
Dialogue: 0,0:19:09.62,0:19:11.62,Default,Maomao,0,0,0,,Ale w każdym razie...
Dialogue: 0,0:19:11.62,0:19:14.29,Default,Maomao,0,0,0,,Jest tu wiele starszych służek.
Dialogue: 0,0:19:14.65,0:19:16.28,Default,Maomao,0,0,0,,W wewnętrznym pałacu,\Ngdy kobieta osiąga pewien wiek,
Dialogue: 0,0:19:16.28,0:19:18.98,Default,Maomao,0,0,0,,jest zwykle zastępowana i wypędzana.
Dialogue: 0,0:19:18.98,0:19:22.11,Default,Maomao,0,0,0,,Zgaduję, że kliniki potrzebują\Npracowników z doświadczeniem i wiedzą,
Dialogue: 0,0:19:22.11,0:19:23.93,Default,Maomao,0,0,0,,więc mogą zostać dłużej...
Dialogue: 0,0:19:26.35,0:19:30.30,Default,Jinshi,0,0,0,,Nie spaceruj, kiedy gadasz\Ndo siebie. Potkniesz się.
Dialogue: 0,0:19:30.30,0:19:32.33,Default,Maomao,0,0,0,,Czy ja coś mówiłam?
Dialogue: 0,0:19:34.09,0:19:36.25,Default,Maomao,0,0,0,,W czym mogę pomóc?
Dialogue: 0,0:19:37.10,0:19:39.55,Default,Jinshi,0,0,0,,Cóż. Tym razem nie mam\Nżadnej sprawy dla ciebie.
Dialogue: 0,0:19:39.94,0:19:42.46,Default,Jinshi,0,0,0,,Nie mogę z tobą pogadać,\Nkiedy akurat przechodzę obok?
Dialogue: 0,0:19:46.05,0:19:47.41,Default,Jinshi,0,0,0,,Gdzie byłaś przed chwilą?
Dialogue: 0,0:19:47.41,0:19:51.33,Default,Maomao,0,0,0,,W klinice. Nie wiedziałam,\Nże takie miejsce istnieje.
Dialogue: 0,0:19:51.33,0:19:55.87,Default,Jinshi,0,0,0,,Kiedy tu przybyłaś,\Npowinni ci wszystko pokazać.
Dialogue: 0,0:19:55.87,0:19:56.88,Default,Jinshi,0,0,0,,Nie zrobili tego?
Dialogue: 0,0:19:57.23,0:20:00.37,Default,Maomao,0,0,0,,Może nie zwracałam na to uwagi,\Nbo byłam niezadowolona
Dialogue: 0,0:20:00.37,0:20:02.22,Default,Maomao,0,0,0,,z mojej nagłej sprzedaży.
Dialogue: 0,0:20:04.31,0:20:08.56,Default,Maomao,0,0,0,,{\i1}To chyba nie pierwszy raz, kiedy\Nwydaje się zasmucony, słysząc tę historię.
Dialogue: 0,0:20:09.96,0:20:13.58,Default,Maomao,0,0,0,,Jest lepiej zorganizowana,\Nniż się spodziewałam, dlatego byłam zaskoczona.
Dialogue: 0,0:20:13.58,0:20:16.65,Default,Maomao,0,0,0,,Może powinien tak też wyglądać\Noficjalny gabinet medyka?
Dialogue: 0,0:20:17.42,0:20:19.85,Default,Jinshi,0,0,0,,To nie takie proste.
Dialogue: 0,0:20:19.85,0:20:21.71,Default,Maomao,0,0,0,,Co masz na myśli?
Dialogue: 0,0:20:21.71,0:20:24.45,Default,Gaoshun,0,0,0,,Tylko mężczyźni mogą być medykami.
Dialogue: 0,0:20:24.92,0:20:26.98,Default,Gaoshun,0,0,0,,Opatrzenie paru zadrapań\Nnie stanowi problemu,
Dialogue: 0,0:20:26.98,0:20:29.99,Default,Gaoshun,0,0,0,,ale tylko medyk może\Nleczyć poważne obrażenia.
Dialogue: 0,0:20:30.37,0:20:34.00,Default,Gaoshun,0,0,0,,Ponadto tylko medycy\Nmogą produkować leki.
Dialogue: 0,0:20:34.62,0:20:38.76,Default,Maomao,0,0,0,,{\i1}To dlatego nie wyczułam\Ntam żadnych leków.
Dialogue: 0,0:20:39.77,0:20:41.55,Default,Maomao,0,0,0,,A co ze mną?
Dialogue: 0,0:20:42.65,0:20:44.88,Default,Jinshi,0,0,0,,Na ciebie przymykamy oko.
Dialogue: 0,0:20:45.63,0:20:49.39,Default,Maomao,0,0,0,,{\i1}Chyba chodzi o jakąś zawiłą historię.
Dialogue: 0,0:20:49.74,0:20:54.89,Default,Jinshi,0,0,0,,Na przyszłość musimy wymyślić\Nnowy sposób pozyskiwania medyków,
Dialogue: 0,0:20:55.87,0:20:58.06,Default,Jinshi,0,0,0,,by nie tylko eunuchowie\Nmogli zajmować się medycyną.
Dialogue: 0,0:20:59.54,0:21:01.07,Default,Maomao,0,0,0,,{\i1}Eunuchowie, co?
Dialogue: 0,0:21:02.05,0:21:07.15,Default,Maomao,0,0,0,,{\i1}Kiedy obecny cesarz doszedł do władzy,\Nzabronił operacji tworzących eunuchów.
Dialogue: 0,0:21:07.15,0:21:08.16,Default,Maomao,0,0,0,,{\i1}Innymi słowy,
Dialogue: 0,0:21:08.53,0:21:11.33,Default,Maomao,0,0,0,,{\i1}to tylko kwestia czasu,\Nnim zacznie brakować nam personelu.
Dialogue: 0,0:21:11.77,0:21:14.18,Default,Maomao,0,0,0,,{\i1}Biorąc pod uwagę\Nwiek pana Jinshiego
Dialogue: 0,0:21:14.18,0:21:17.83,Default,Maomao,0,0,0,,{\i1}zakaz musiał obowiązywać wtedy,\Ngdy sam poddał się operacji.
Dialogue: 0,0:21:18.33,0:21:22.13,Default,Maomao,0,0,0,,Szkoda. Gdyby tylko zaczekał kilka lat...
Dialogue: 0,0:21:23.01,0:21:24.13,Default,Jinshi,0,0,0,,Co znowu?
Dialogue: 0,0:21:24.60,0:21:26.38,Default,Maomao,0,0,0,,{\i1}Ups. Powiedziałam to na głos?
Dialogue: 0,0:21:28.17,0:21:30.85,Default,Gaoshun,0,0,0,,Panie Jinshi, jest wiele zadań do zrobienia.
Dialogue: 0,0:21:31.30,0:21:32.10,Default,Jinshi,0,0,0,,Jasne.
Dialogue: 0,0:21:34.84,0:21:35.94,Default,Jinshi,0,0,0,,A, zielareczko.
Dialogue: 0,0:21:37.08,0:21:40.94,Default,Jinshi,0,0,0,,Dopilnuj, by nikt nie odkrył,\Nże robisz lekarstwa.
Dialogue: 0,0:21:41.26,0:21:42.52,Default,Maomao,0,0,0,,Zrozumiano.
Dialogue: 0,0:21:47.47,0:21:50.50,Default,Maomao,0,0,0,,{\i1}Gdybym stworzyła lek, który sprawiłby,\Nże odrosną, stałabym się bogata?
Dialogue: 0,0:21:55.30,0:21:57.25,Default,Shenlü,0,0,0,,To lekarstwo, co nie?
Dialogue: 0,0:21:58.21,0:22:01.00,Default,Shenlü,0,0,0,,Ta służka śmierdziała lekami.
Dialogue: 0,0:22:02.71,0:22:07.11,Default,Shenlü,0,0,0,,Ta dziewucha...\NPotajemnie wytwarza leki, prawda?
Dialogue: 0,0:23:45.07,0:23:47.07,Default,Text,0,0,0,,{\an8}W NASTĘPNYM ODCINKU
Dialogue: 0,0:23:56.35,0:24:00.00,Default,Narrator,0,0,0,,{\an8}W kolejnym odcinku\N„Kryształowy Pałac po raz trzeci”.
Dialogue: 0,0:23:58.00,0:24:00.00,Default,Text,0,0,0,,Tłumaczenie: Sylwia Wolińska \NFORCE MEDIA
