Dialogue: 1,0:00:08.32,0:00:12.12,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:00:08.32,0:00:12.74,Default,Text,0,0,0,,{\an8}ZAPISKI ZIELARKI
Dialogue: 0,0:01:30.98,0:01:34.03,Default,Text,0,0,0,,{\an8}TA HISTORIA TO FIKCJA.\NPOSTACIE I WYDARZENIA SĄ ZMYŚLONE.
Dialogue: 0,0:01:32.98,0:01:34.43,Default,Jinshi,0,0,0,,{\an8}W takim razie...
Dialogue: 0,0:01:34.43,0:01:36.65,Default,Jinshi,0,0,0,,{\an8}Może mi go zrobisz?
Dialogue: 0,0:01:37.17,0:01:38.11,Default,Maomao,0,0,0,,Słucham?
Dialogue: 0,0:01:44.22,0:01:46.12,Default,Maomao,0,0,0,,Jest mu zbędna.
Dialogue: 0,0:01:48.72,0:01:52.04,Default,Maomao,0,0,0,,Było wiele głupich wojen w historii,
Dialogue: 0,0:01:52.04,0:01:56.57,Default,Maomao,0,0,0,,ale kilka z nich\Nspowodowały piękne kobiety.
Dialogue: 0,0:01:57.02,0:02:01.39,Default,Maomao,0,0,0,,Jeśli taki piękniś nałożyłby\Nmakijaż na swoją twarzyczkę...
Dialogue: 0,0:02:02.45,0:02:04.24,Default,Maomao,0,0,0,,Chcesz upadku kraju czy co?
Dialogue: 0,0:02:04.24,0:02:05.31,Default,Jinshi,0,0,0,,Skąd to masz?!
Dialogue: 0,0:02:05.85,0:02:08.58,Default,Jinshi,0,0,0,,Czemu masz tak\Nwybujałą wyobraźnię?
Dialogue: 0,0:02:09.81,0:02:12.52,Default,Jinshi,0,0,0,,Z czego robisz to coś na piegi?
Dialogue: 0,0:02:13.00,0:02:17.19,Default,Maomao,0,0,0,,A, on chce się trochę oszpecić,\Na nie upiększyć.
Dialogue: 0,0:02:17.73,0:02:20.20,Default,Maomao,0,0,0,,Przygotowuję proszek\Nz suszonej glinki,
Dialogue: 0,0:02:20.71,0:02:22.47,Default,Maomao,0,0,0,,a następnie mieszam go z olejem.
Dialogue: 0,0:02:23.18,0:02:25.15,Default,Jinshi,0,0,0,,Dałabyś radę zrobić go na już?
Dialogue: 0,0:02:25.15,0:02:27.33,Default,Maomao,0,0,0,,Przygotowanie tego\Nzajmie jedną noc.
Dialogue: 0,0:02:28.72,0:02:31.62,Default,Maomao,0,0,0,,Ten jest dla ciebie zbyt ciemny.
Dialogue: 0,0:02:31.62,0:02:34.67,Default,Jinshi,0,0,0,,Gdyby tylko istniał lek,\Nktóry mógłby zmienić twarz.
Dialogue: 0,0:02:35.04,0:02:38.11,Default,Maomao,0,0,0,,Co najwyżej możemy\Nwysmarować pana laką.
Dialogue: 0,0:02:38.11,0:02:40.05,Default,Maomao,0,0,0,,Ale to już by zostało.
Dialogue: 0,0:02:41.00,0:02:42.30,Default,Jinshi,0,0,0,,Niegłupie.
Dialogue: 0,0:02:42.30,0:02:45.72,Default,Maomao,0,0,0,,Jeśli chce pan być kimś z pospólstwa,
Dialogue: 0,0:02:46.18,0:02:48.27,Default,Maomao,0,0,0,,chyba muszę panu pomóc.
Dialogue: 0,0:02:48.80,0:02:50.83,Default,Jinshi,0,0,0,,W takim razie liczę na ciebie.
Dialogue: 0,0:02:50.83,0:02:54.20,Default,Jinshi,0,0,0,,Chcę wyglądać jak ktoś zupełnie inny.
Dialogue: 0,0:02:56.98,0:02:59.64,Default,Maomao,0,0,0,,Ciekawi mnie, co on kombinuje.
Dialogue: 0,0:03:01.97,0:03:03.03,Default,Maomao,0,0,0,,Niemniej...
Dialogue: 0,0:03:04.53,0:03:06.81,Default,Maomao,0,0,0,,Pójdę na całość!
Dialogue: 0,0:03:07.87,0:03:11.87,Default,Text,0,0,0,,{\an8}ODCINEK 17:\NWYCIECZKA PO MIEŚCIE
Dialogue: 0,0:03:09.87,0:03:12.00,Default,Maomao,0,0,0,,{\an1}Rany, ale zimnica.
Dialogue: 0,0:03:13.00,0:03:14.00,Default,Maomao,0,0,0,,Dzień dob...
Dialogue: 0,0:03:21.42,0:03:24.30,Default,Jinshi,0,0,0,,Czyżby ktoś tu wstał\Nlewą nogą z łóżka?
Dialogue: 0,0:03:24.30,0:03:28.80,Default,Maomao,0,0,0,,A skąd. Myślałam o tym,\Njak pięknie pan wygląda.
Dialogue: 0,0:03:28.80,0:03:30.18,Default,Jinshi,0,0,0,,Wyczuwam tu sarkazm?
Dialogue: 0,0:03:30.96,0:03:35.19,Default,Maomao,0,0,0,,Panie Jinshi. Naprawdę chcesz,\Nby nikt cię nie poznał?
Dialogue: 0,0:03:35.60,0:03:38.11,Default,Jinshi,0,0,0,,No przecież już to mówiłem.
Dialogue: 0,0:03:38.11,0:03:39.85,Default,Maomao,0,0,0,,W takim razie przepraszam.
Dialogue: 0,0:03:47.20,0:03:49.26,Default,Suiren,0,0,0,,Ojejku!
Dialogue: 0,0:03:49.26,0:03:51.25,Default,Jinshi,0,0,0,,A tobie co tak nagle odbiło?
Dialogue: 0,0:03:51.71,0:03:54.94,Default,Maomao,0,0,0,,Nikt normalny nie pali\Ntak drogich kadzideł.
Dialogue: 0,0:03:55.52,0:04:00.12,Default,Maomao,0,0,0,,Pana obecny strój w najlepszym\Nrazie pasuje do urzędnika niższej rangi.
Dialogue: 0,0:04:00.12,0:04:04.76,Default,Maomao,0,0,0,,Najlepsze zamorskie kadzidła\Nzwykli ludzie znają z bajek.
Dialogue: 0,0:04:05.09,0:04:07.08,Default,Jinshi,0,0,0,,Skąd to wiesz?
Dialogue: 0,0:04:07.08,0:04:11.59,Default,Maomao,0,0,0,,Mam wyczulony węch, by odróżniać\Nzioła lecznicze od trujących.
Dialogue: 0,0:04:12.00,0:04:14.89,Default,Maomao,0,0,0,,Wiesz, jak burdele\Nrozpoznają dobrych klientów?
Dialogue: 0,0:04:14.89,0:04:17.69,Default,Jinshi,0,0,0,,Chyba po sylwetce,\Nubraniach albo coś w tym stylu.
Dialogue: 0,0:04:17.69,0:04:21.40,Default,Maomao,0,0,0,,To też, jednak ważną\Nrzeczą jest zapach.
Dialogue: 0,0:04:21.82,0:04:28.63,Default,Maomao,0,0,0,,Ludzie pachnący ładnymi perfumami zwykle\Nsą bogaci, ale mają choroby weneryczne.
Dialogue: 0,0:04:28.63,0:04:32.71,Default,Maomao,0,0,0,,A ci, co cuchną jak świnie,\Nokreślani są jako brudasy.
Dialogue: 0,0:04:32.71,0:04:36.94,Default,Maomao,0,0,0,,Wielu nowych przybyszów jest\Nwypędzana z Grynszpanowego Pawilonu.
Dialogue: 0,0:04:38.96,0:04:43.92,Default,Lakan,0,0,0,,Najlepiej zapytać kogoś,\Nkto zna ten świat.
Dialogue: 0,0:04:45.49,0:04:49.47,Default,Maomao,0,0,0,,Panie Gaoshun. Czy mógłbyś\Nznaleźć jakieś nowe ubrania?
Dialogue: 0,0:04:49.47,0:04:53.63,Default,Maomao,0,0,0,,Najlepiej takie, które nie zostały\Njeszcze wyprane i wciąż śmierdzą.
Dialogue: 0,0:04:53.63,0:04:54.65,Default,Suiren,0,0,0,,Ojejku.
Dialogue: 0,0:04:55.12,0:04:56.14,Default,Gaoshun,0,0,0,,Zrozumiałem.
Dialogue: 0,0:04:56.14,0:04:56.65,Default,Jinshi,0,0,0,,Ej.
Dialogue: 0,0:04:57.33,0:04:59.27,Default,Maomao,0,0,0,,A w międzyczasie...
Dialogue: 0,0:05:03.16,0:05:04.30,Default,Suiren,0,0,0,,Co to takiego?
Dialogue: 0,0:05:04.30,0:05:05.70,Default,Maomao,0,0,0,,Olej i sól.
Dialogue: 0,0:05:06.68,0:05:10.83,Default,Maomao,0,0,0,,Pozbawimy włosy blasku\Ni nadamy kiepskiego wyglądu.
Dialogue: 0,0:05:12.04,0:05:13.66,Default,Maomao,0,0,0,,Przepraszam.
Dialogue: 0,0:05:26.32,0:05:27.93,Default,Maomao,0,0,0,,To powinno wystarczyć.
Dialogue: 0,0:05:29.89,0:05:33.77,Default,Suiren,0,0,0,,Na Boga, czy musiałaś użyć skrawka\Nmateriału, aby związać włosy?
Dialogue: 0,0:05:33.77,0:05:36.86,Default,Maomao,0,0,0,,Pospólstwo użyje wszystkiego,\Nco ma pod ręką, jeśli się nada.
Dialogue: 0,0:05:37.81,0:05:40.41,Default,Gaoshun,0,0,0,,Czy to będzie wystarczające?
Dialogue: 0,0:05:42.56,0:05:44.25,Default,Maomao,0,0,0,,Niuch, niuch, niuch, niuch.
Dialogue: 0,0:05:44.95,0:05:47.45,Default,Maomao,0,0,0,,Mogłoby bardziej cuchnąć,\Nale ujdzie.
Dialogue: 0,0:05:48.41,0:05:51.13,Default,Maomao,0,0,0,,Panie Jinshi, proszę się rozebrać.
Dialogue: 0,0:05:51.13,0:05:52.74,Default,Jinshi,0,0,0,,J-jasne.
Dialogue: 0,0:05:56.84,0:06:02.00,Default,Maomao,0,0,0,,Eunuch z buźką anielicy,\Nale klatę ma niczego sobie.
Dialogue: 0,0:06:04.00,0:06:06.61,Default,Maomao,0,0,0,,Mogę użyć tych ręczników?
Dialogue: 0,0:06:06.61,0:06:09.57,Default,Suiren,0,0,0,,Oczywiście, ale po co?
Dialogue: 0,0:06:09.57,0:06:12.01,Default,Maomao,0,0,0,,Muszę poprawić jego sylwetkę.
Dialogue: 0,0:06:12.01,0:06:15.27,Default,Maomao,0,0,0,,Moglibyście mi trochę pomóc?
Dialogue: 0,0:06:17.19,0:06:18.81,Default,Maomao,0,0,0,,Panie Gaoshun, tutaj, proszę.
Dialogue: 0,0:06:19.35,0:06:20.28,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:06:20.28,0:06:22.16,Default,Maomao,0,0,0,,Pani Suiren,\Nzłap go z tej strony.
Dialogue: 0,0:06:22.16,0:06:23.64,Default,Suiren,0,0,0,,Dobrze.
Dialogue: 0,0:06:23.64,0:06:25.48,Default,Maomao,0,0,0,,A teraz jeszcze ubrania...
Dialogue: 0,0:06:27.16,0:06:28.36,Default,Suiren,0,0,0,,Wielkie nieba.
Dialogue: 0,0:06:30.76,0:06:36.08,Default,Maomao,0,0,0,,Widok pana Jinshiego\Nw tym wydaniu jest bardzo dziwny.
Dialogue: 0,0:06:36.56,0:06:37.95,Default,Maomao,0,0,0,,Czas na makijaż.
Dialogue: 0,0:06:37.95,0:06:38.87,Default,Jinshi,0,0,0,,Co?
Dialogue: 0,0:06:39.92,0:06:42.67,Default,Maomao,0,0,0,,Wymieszałam kilka ciemnych odcieni.
Dialogue: 0,0:06:42.67,0:06:46.63,Default,Maomao,0,0,0,,Użyję ich, by uzyskać efekt opalonej\Ncery, jak u zwykłego człowieka.
Dialogue: 0,0:06:47.14,0:06:48.88,Default,Maomao,0,0,0,,Proszę, zamknij oczy.
Dialogue: 0,0:06:48.88,0:06:49.78,Default,Jinshi,0,0,0,,Dobrze.
Dialogue: 0,0:06:53.05,0:06:56.56,Default,Maomao,0,0,0,,Z bliska też jest piękny.
Dialogue: 0,0:06:56.83,0:06:59.39,Default,Maomao,0,0,0,,Ani śladu zarostu,\Nnawet żadnych porów.
Dialogue: 0,0:06:59.95,0:07:02.23,Default,Maomao,0,0,0,,Ciekawe, jak wyglądałby\Nw damskim makijażu...
Dialogue: 0,0:07:07.32,0:07:11.07,Default,Maomao,0,0,0,,Mam! W końcu na siostrzyczkę\NMeimei można liczyć.
Dialogue: 0,0:07:11.53,0:07:13.12,Default,Jinshi,0,0,0,,Długo to jeszcze potrwa?
Dialogue: 0,0:07:13.12,0:07:16.91,Default,Maomao,0,0,0,,Proszę, zamknij usta,\Nale nie zaciskaj ich zbyt mocno.
Dialogue: 0,0:07:16.91,0:07:18.55,Default,Jinshi,0,0,0,,Co? Jasne...
Dialogue: 0,0:07:27.32,0:07:28.67,Default,Jinshi,0,0,0,,Co się stało?
Dialogue: 0,0:07:29.22,0:07:31.48,Default,Maomao,0,0,0,,Dobrze, że tylko my to widzieliśmy.
Dialogue: 0,0:07:31.48,0:07:35.14,Default,Maomao,0,0,0,,Jeśli byłby tu ktoś inny,\Ndoszłoby do katastrofy.
Dialogue: 0,0:07:35.14,0:07:37.51,Default,Jinshi,0,0,0,,Ej, coś się stało?
Dialogue: 0,0:07:38.36,0:07:40.40,Default,Maomao,0,0,0,,A skądże znowu.
Dialogue: 0,0:07:40.40,0:07:42.43,Default,Jinshi,0,0,0,,Zabolało! Coś ty mi zrobiła?
Dialogue: 0,0:07:42.43,0:07:43.61,Default,Maomao,0,0,0,,Nic takiego.
Dialogue: 0,0:07:43.61,0:07:44.76,Default,Gaoshun,0,0,0,,Nic a nic.
Dialogue: 0,0:07:44.76,0:07:46.77,Default,Suiren,0,0,0,,Zgadza się, nic się nie stało.
Dialogue: 0,0:07:47.70,0:07:49.28,Default,Maomao,0,0,0,,Wracając do rzeczy.
Dialogue: 0,0:07:49.69,0:07:52.03,Default,Maomao,0,0,0,,Użyję tego, by namalować ci\Nplamy na twarzy.
Dialogue: 0,0:07:52.03,0:07:55.65,Default,Maomao,0,0,0,,A teraz pora zrobić ci\Ntrochę worów pod oczami.
Dialogue: 0,0:07:55.65,0:08:02.12,Default,Maomao,0,0,0,,Dodam też kilka pieprzyków\Ni zmienię trochę kształt brwi.
Dialogue: 0,0:08:02.72,0:08:06.63,Default,Maomao,0,0,0,,Resztki makijażu można rozprowadzić,\Nby nadać skórze rumieńców.
Dialogue: 0,0:08:07.05,0:08:10.63,Default,Maomao,0,0,0,,Paznokcie też wyglądają na czyściutkie,\Nwięc dodamy im trochę brudu.
Dialogue: 0,0:08:10.99,0:08:12.99,Default,Maomao,0,0,0,,Duże, męskie dłonie.
Dialogue: 0,0:08:12.99,0:08:15.26,Default,Maomao,0,0,0,,Przynajmniej one\Nnie wyglądają na kobiece...
Dialogue: 0,0:08:15.26,0:08:18.01,Default,Maomao,0,0,0,,Co? Ma odciski.
Dialogue: 0,0:08:18.01,0:08:21.64,Default,Maomao,0,0,0,,Myślałam, że nie używa niczego\Nwięcej niż pałeczek i pędzli.
Dialogue: 0,0:08:21.64,0:08:24.90,Default,Maomao,0,0,0,,Czyżby ćwiczył szermierkę\Nalbo coś innego?
Dialogue: 0,0:08:25.51,0:08:28.65,Default,Maomao,0,0,0,,Nie jest to coś, co eunuch\Nzazwyczaj musi robić, ale...
Dialogue: 0,0:08:28.65,0:08:33.15,Default,Maomao,0,0,0,,Nie ma sensu pytać o tak głupie rzeczy.
Dialogue: 0,0:08:33.15,0:08:35.57,Default,Jinshi,0,0,0,,Łał, wyglądają okropnie.
Dialogue: 0,0:08:36.37,0:08:37.34,Default,Maomao,0,0,0,,Proszę.
Dialogue: 0,0:08:38.46,0:08:39.58,Default,Jinshi,0,0,0,,Mam to wypić?
Dialogue: 0,0:08:43.60,0:08:44.96,Default,Jinshi,0,0,0,,Rany! Co to jest?
Dialogue: 0,0:08:45.32,0:08:49.21,Default,Maomao,0,0,0,,Popijaj powoli, oblizując\Nusta, jakbyś je zwilżał.
Dialogue: 0,0:08:49.21,0:08:52.14,Default,Maomao,0,0,0,,Dzięki temu wargi i gardło\Nspuchną, a głos ulegnie zmianie.
Dialogue: 0,0:08:52.14,0:08:53.88,Default,Suiren,0,0,0,,Z czego to zrobiłaś?
Dialogue: 0,0:08:53.88,0:08:56.12,Default,Maomao,0,0,0,,Kilku różnych środków drażniących.
Dialogue: 0,0:08:56.12,0:09:00.14,Default,Maomao,0,0,0,,Jest bardzo pikantny,\Nale bez obaw, nie jest trujący.
Dialogue: 0,0:09:05.89,0:09:07.65,Default,Maomao,0,0,0,,Pij do dna.
Dialogue: 0,0:09:11.16,0:09:12.89,Default,Maomao,0,0,0,,Jeszcze jedno.
Dialogue: 0,0:09:14.01,0:09:15.13,Default,Maomao,0,0,0,,Bawełna.
Dialogue: 0,0:09:15.13,0:09:18.03,Default,Maomao,0,0,0,,Wypełnij nią policzki,\Nby nadać twarzy inny kształt.
Dialogue: 0,0:09:22.76,0:09:24.41,Default,Maomao,0,0,0,,Skończyłam.
Dialogue: 0,0:09:29.54,0:09:31.96,Default,Suiren,0,0,0,,Rany, to naprawdę ty, paniczu?
Dialogue: 0,0:09:31.96,0:09:34.06,Default,Jinshi,0,0,0,,Nie nazywaj mnie tak.
Dialogue: 0,0:09:35.01,0:09:38.12,Default,Maomao,0,0,0,,Mimo wszystko nadal wygląda nieźle.
Dialogue: 0,0:09:38.12,0:09:40.35,Default,Maomao,0,0,0,,Posiadanie takiej urody nie może być łatwe.
Dialogue: 0,0:09:40.76,0:09:44.10,Default,Maomao,0,0,0,,Ale i tak zrobiłam, co mogłam.
Dialogue: 0,0:09:46.88,0:09:49.69,Default,Maomao,0,0,0,,Czas wracać do siebie!\NDługo się z tym zeszło.
Dialogue: 0,0:09:50.31,0:09:53.93,Default,Gaoshun,0,0,0,,Xiaomao, mówiłaś,\Nże wracasz dziś do domu, tak?
Dialogue: 0,0:09:53.93,0:09:56.74,Default,Maomao,0,0,0,,Tak. Mam wolne aż do jutra...
Dialogue: 0,0:09:57.75,0:10:01.19,Default,Maomao,0,0,0,,Ta mina nie wróży niczego dobrego.
Dialogue: 0,0:10:02.27,0:10:06.41,Default,Gaoshun,0,0,0,,To pan Jinshi może ci potowarzyszyć,\Nbo idzie w tę samą stronę.
Dialogue: 0,0:10:08.33,0:10:14.52,Default,Gaoshun,0,0,0,,Mimo przebrania, obecność jego\Nsłużących byłaby podejrzana.
Dialogue: 0,0:10:14.52,0:10:17.05,Default,Suiren,0,0,0,,To prawda.
Dialogue: 0,0:10:17.52,0:10:19.90,Default,Gaoshun,0,0,0,,Prawda, panie Jinshi?
Dialogue: 0,0:10:20.50,0:10:21.76,Default,Jinshi,0,0,0,,Masz rację.
Dialogue: 0,0:10:23.08,0:10:25.42,Default,Jinshi,0,0,0,,Fajnie by było,\Ngdybym mógł pójść z tobą.
Dialogue: 0,0:10:25.42,0:10:27.48,Default,Maomao,0,0,0,,Nie! Panu Jinshiemu\Nteż się to podoba!
Dialogue: 0,0:10:27.88,0:10:33.19,Default,Maomao,0,0,0,,Nie wydaje mi się, by moja\Nobecność poprawiła sytuację...
Dialogue: 0,0:10:33.64,0:10:38.88,Default,Maomao,0,0,0,,Na pewno nijaka służąca z nijakim\Npanem wglądałaby normalnie...
Dialogue: 0,0:10:38.88,0:10:42.45,Default,Maomao,0,0,0,,ale mnie też już znają jako\Nsłużącą pana Jinshiego...
Dialogue: 0,0:10:42.45,0:10:44.12,Default,Gaoshun,0,0,0,,Moim zdaniem będzie dobrze.
Dialogue: 0,0:10:44.12,0:10:47.53,Default,Suiren,0,0,0,,To może ty też założysz\Nprzebranie, Xiaomao?
Dialogue: 0,0:10:47.53,0:10:48.19,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:10:48.19,0:10:49.96,Default,Gaoshun,0,0,0,,Świetny pomysł!
Dialogue: 0,0:10:50.40,0:10:54.71,Default,Suiren,0,0,0,,Też posiadam wszystkie\Nprzybory do makijażu.
Dialogue: 0,0:10:55.08,0:10:56.25,Default,Maomao,0,0,0,,Ale...
Dialogue: 0,0:10:56.25,0:11:00.01,Default,Suiren,0,0,0,,Wystarczy, że będziesz prezentować się\Nz goła inaczej niż zwykle, prawda?
Dialogue: 0,0:11:00.97,0:11:02.59,Default,Suiren,0,0,0,,Prawda?
Dialogue: 0,0:11:02.59,0:11:05.07,Default,Maomao,0,0,0,,T-tak...
Dialogue: 0,0:11:05.07,0:11:07.64,Default,Maomao,0,0,0,,Mam co do tego bardzo złe przeczucia...
Dialogue: 0,0:11:14.02,0:11:17.03,Default,Maomao,0,0,0,,Panie Jinshi, zbyt wytwornie pan siedzi.
Dialogue: 0,0:11:18.36,0:11:20.62,Default,Jinshi,0,0,0,,Przestań zwracać się do mnie tak formalnie.
Dialogue: 0,0:11:20.62,0:11:23.64,Default,Jinshi,0,0,0,,Nie wymawiaj mojego imienia.\NTo wszystko zrujnuje.
Dialogue: 0,0:11:23.64,0:11:26.66,Default,Maomao,0,0,0,,Więc jak mam cię nazywać?
Dialogue: 0,0:11:26.66,0:11:28.12,Default,Jinshi,0,0,0,,Pomyślmy...
Dialogue: 0,0:11:28.95,0:11:33.75,Default,Jinshi,0,0,0,,Możesz mi mówić Jinka, panienko.
Dialogue: 0,0:11:33.75,0:11:35.00,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:11:35.34,0:11:38.39,Default,Jinshi,0,0,0,,Zważywszy na to, jak wyglądamy,\Nmyślę, że to najlepsze wyjście.
Dialogue: 0,0:11:39.97,0:11:44.12,Default,Maomao,0,0,0,,Prawda, ten strój należy\Ndo córki pani Suiren.
Dialogue: 0,0:11:44.12,0:11:47.88,Default,Maomao,0,0,0,,Materiał i wykonanie są pierwszorzędne.\NNie wyglądają też na babcine.
Dialogue: 0,0:11:47.88,0:11:51.77,Default,Maomao,0,0,0,,Zapewne mogę uchodzić\Nza panienkę z dobrej rodziny.
Dialogue: 0,0:11:55.68,0:11:57.94,Default,Maomao,0,0,0,,Czemu on się tak cieszy?
Dialogue: 0,0:12:01.50,0:12:04.51,Default,Gaoshun,0,0,0,,Tutaj jest mapa. Dla Xiaomao...
Dialogue: 0,0:12:05.34,0:12:08.58,Default,Jinshi,0,0,0,,Zaopiekuję się panienką.
Dialogue: 0,0:12:09.49,0:12:11.33,Default,Gaoshun,0,0,0,,Proszę.
Dialogue: 0,0:12:15.15,0:12:16.78,Default,Maomao,0,0,0,,Więc, panie Jinka...
Dialogue: 0,0:12:18.23,0:12:19.08,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:12:21.91,0:12:23.20,Default,Maomao,0,0,0,,Jinka.
Dialogue: 0,0:12:23.20,0:12:25.02,Default,Jinka,0,0,0,,Tak, panienko!
Dialogue: 0,0:12:26.66,0:12:28.50,Default,Maomao,0,0,0,,Przygarb się trochę.
Dialogue: 0,0:12:34.19,0:12:38.48,Default,Maomao,0,0,0,,„Jinka”, co?\NNiezbyt wyszukany przydomek.
Dialogue: 0,0:12:38.89,0:12:42.44,Default,Maomao,0,0,0,,Ale co on sobie myśli, dodając do\Nfałszywego imienia znak na kwiat?
Dialogue: 0,0:12:42.76,0:12:46.70,Default,Maomao,0,0,0,,Imię „Jinshi” też jest jakieś\Ndziwne i trochę takie mało męskie.
Dialogue: 0,0:12:47.12,0:12:50.04,Default,Maomao,0,0,0,,Chyba jednak powinnam\Nprzebrać go za kobietę.
Dialogue: 0,0:12:52.63,0:12:56.46,Default,Maomao,0,0,0,,Nie, nie mogę tego zrobić,\Njeżeli chcę zachować pokój na świecie.
Dialogue: 0,0:12:57.38,0:12:58.71,Default,Maomao,0,0,0,,Gdzie idziemy?
Dialogue: 0,0:13:00.29,0:13:02.86,Default,Jinshi,0,0,0,,Restauracja tuż obok dzielnicy uciech.
Dialogue: 0,0:13:02.86,0:13:04.93,Default,Jinshi,0,0,0,,Mam tam spotkanie ze znajomym.
Dialogue: 0,0:13:10.14,0:13:12.68,Default,Basen,0,0,0,,Dlaczego to ja muszę robić za ochroniarza?
Dialogue: 0,0:13:14.43,0:13:17.27,Default,Basen,0,0,0,,I to jeszcze w ukryciu? Dlaczego...
Dialogue: 0,0:13:27.21,0:13:30.83,Default,Maomao,0,0,0,,Służący kroczący przed panią?\NJeszcze wiele nauki przed nim.
Dialogue: 0,0:13:31.81,0:13:32.79,Default,Maomao,0,0,0,,Jinka.
Dialogue: 0,0:13:33.88,0:13:36.85,Default,Jinshi,0,0,0,,Wybacz, panienko.
Dialogue: 0,0:13:36.85,0:13:37.93,Default,Maomao,0,0,0,,Wybaczam.
Dialogue: 0,0:13:41.55,0:13:44.48,Default,Maomao,0,0,0,,Nie ma z byt wielu owoców o tej porze roku.
Dialogue: 0,0:13:44.48,0:13:45.05,Default,Maomao,0,0,0,,Co?
Dialogue: 0,0:13:47.51,0:13:49.58,Default,Maomao,0,0,0,,Skoro już dostałam trochę kasy,
Dialogue: 0,0:13:49.58,0:13:52.25,Default,Maomao,0,0,0,,to może zrobię sobie kurczaka z rzodkwią.
Dialogue: 0,0:13:52.25,0:13:53.52,Default,Jinshi,0,0,0,,Małe zakupy?
Dialogue: 0,0:13:54.31,0:13:56.23,Default,Jinshi,0,0,0,,W takim stroju?
Dialogue: 0,0:14:04.25,0:14:06.99,Default,Maomao,0,0,0,,A chciałam ugotować coś tatkowi.
Dialogue: 0,0:14:07.84,0:14:13.24,Default,Maomao,0,0,0,,Jest świetnym medykiem i zielarzem,\Nktóry nie ma sobie równych.
Dialogue: 0,0:14:14.12,0:14:18.75,Default,Maomao,0,0,0,,Ale w ogóle nie umie myśleć o sobie.
Dialogue: 0,0:14:18.75,0:14:22.59,Default,Maomao,0,0,0,,Z tego powodu mieszka\Nw tej nędznej ruderze,
Dialogue: 0,0:14:22.59,0:14:24.25,Default,Maomao,0,0,0,,mimo opłacalnego zawodu.
Dialogue: 0,0:14:26.55,0:14:28.56,Default,Maomao,0,0,0,,Prawdopodobnie gdyby umierał z głodu,
Dialogue: 0,0:14:28.56,0:14:32.80,Default,Maomao,0,0,0,,staruszka wcisnęłaby mu\Ndo gardła jakieś jedzenie, ale...
Dialogue: 0,0:14:42.31,0:14:43.40,Default,Maomao,0,0,0,,O co chodzi?
Dialogue: 0,0:14:43.40,0:14:44.98,Default,Jinshi,0,0,0,,Czemu milczysz?
Dialogue: 0,0:14:45.96,0:14:48.41,Default,Maomao,0,0,0,,Bo nie ma o czym rozmawiać?
Dialogue: 0,0:14:51.74,0:14:54.37,Default,Maomao,0,0,0,,To była zła odpowiedź?
Dialogue: 0,0:14:56.23,0:14:57.50,Default,Maomao,0,0,0,,Co? Ten zapach!
Dialogue: 0,0:14:57.91,0:14:59.25,Default,Maomao,0,0,0,,Szaszłyki z kurczaka!
Dialogue: 0,0:14:59.61,0:15:01.24,Default,Maomao,0,0,0,,Poczekaj chwilę!
Dialogue: 0,0:15:02.52,0:15:04.12,Default,Maomao,0,0,0,,Panie, dwa szaszłyki proszę!
Dialogue: 0,0:15:04.12,0:15:05.34,Default,Street Merchant,0,0,0,,Robi się!
Dialogue: 0,0:15:07.52,0:15:10.68,Default,Maomao,0,0,0,,Masz. Jedz, zanim wystygnie.
Dialogue: 0,0:15:14.61,0:15:15.50,Default,Jinshi,0,0,0,,Dobrze.
Dialogue: 0,0:15:20.31,0:15:23.72,Default,Maomao,0,0,0,,Pikantna skórka, pyszny tłuszczyk...
Dialogue: 0,0:15:23.72,0:15:26.27,Default,Maomao,0,0,0,,W pałacu próżno tego szukać.
Dialogue: 0,0:15:26.73,0:15:28.19,Default,Maomao,0,0,0,,Czemu nie jesz?
Dialogue: 0,0:15:28.19,0:15:30.62,Default,Maomao,0,0,0,,Jak widzisz, nie jest zatrute.
Dialogue: 0,0:15:31.52,0:15:32.67,Default,Jinshi,0,0,0,,Nie...
Dialogue: 0,0:15:34.88,0:15:35.88,Default,Maomao,0,0,0,,Proszę.
Dialogue: 0,0:15:45.32,0:15:46.34,Default,Maomao,0,0,0,,I jak?
Dialogue: 0,0:15:46.79,0:15:51.17,Default,Jinshi,0,0,0,,Bardziej słone\Nniż pamiętam z obozu. Ale dobre.
Dialogue: 0,0:15:51.50,0:15:56.68,Default,Maomao,0,0,0,,Obozu? Sądziłam, że takie rzeczy\Nsą dla żołnierzy, a nie eunuchów.
Dialogue: 0,0:15:58.28,0:16:00.68,Default,Maomao,0,0,0,,Chyba rzeczywiście mu smakuje.
Dialogue: 0,0:16:04.60,0:16:07.48,Default,Suiren,0,0,0,,Witaj z powrotem, Gaoshun.
Dialogue: 0,0:16:07.84,0:16:12.99,Default,Suiren,0,0,0,,Proszę, nie ruszaj tego. Przed\Nchwilą posmarowałam ją persymoną.
Dialogue: 0,0:16:13.38,0:16:17.15,Default,Suiren,0,0,0,,Zabawki naszego panicza\Nprzywołują wspomnienia, prawda?
Dialogue: 0,0:16:17.15,0:16:18.16,Default,Gaoshun,0,0,0,,Tak.
Dialogue: 0,0:16:18.72,0:16:21.24,Default,Suiren,0,0,0,,Więc jak było?
Dialogue: 0,0:16:21.24,0:16:23.29,Default,Gaoshun,0,0,0,,Był niezwykle zadowolony.
Dialogue: 0,0:16:25.19,0:16:28.42,Default,Suiren,0,0,0,,Była to zaskakująco dobra sugestia.
Dialogue: 0,0:16:30.13,0:16:35.47,Default,Suiren,0,0,0,,Kiedy panicz upodobał sobie którąś\Nzabawkę, nie odstępował jej na krok.
Dialogue: 0,0:16:37.24,0:16:41.64,Default,Suiren,0,0,0,,Jeśli się ją schowało,\Nto płakał, jakby świat się kończył.
Dialogue: 0,0:16:41.96,0:16:47.59,Default,Suiren,0,0,0,,Zawsze starałeś się znaleźć mu\Nnową zabawkę, by jakoś się uspokoił.
Dialogue: 0,0:16:50.41,0:16:52.76,Default,Gaoshun,0,0,0,,Skupienie się na jednej rzeczy...
Dialogue: 0,0:16:53.19,0:16:56.87,Default,Gaoshun,0,0,0,,Pana Jinshiego nie stać na taki luksus.
Dialogue: 0,0:16:58.99,0:17:01.45,Default,Jinshi,0,0,0,,Czy musisz tak się spieszyć?
Dialogue: 0,0:17:01.45,0:17:03.88,Default,Maomao,0,0,0,,Wydawało mi się,\Nże się z kimś spotykasz.
Dialogue: 0,0:17:03.88,0:17:06.71,Default,Maomao,0,0,0,,Nie lepiej przybyć wcześniej?
Dialogue: 0,0:17:07.72,0:17:11.15,Default,Jinshi,0,0,0,,Brzmisz, jakbyś chciała jak\Nnajszybciej się mnie pozbyć.
Dialogue: 0,0:17:11.15,0:17:12.46,Default,Maomao,0,0,0,,Naprawdę?
Dialogue: 0,0:17:12.96,0:17:18.30,Default,Maomao,0,0,0,,Bingo. Gdyby już sobie poszedł,\Nmogłabym wrócić po kurczaczka i rzodkiew.
Dialogue: 0,0:17:18.30,0:17:19.60,Default,Jinshi,0,0,0,,Czy...
Dialogue: 0,0:17:21.75,0:17:24.48,Default,Jinshi,0,0,0,,Czy życie w pałacu jest aż takie złe?
Dialogue: 0,0:17:26.23,0:17:29.82,Default,Jinshi,0,0,0,,Chyba lepsze niż życie w dzielnicy uciech.
Dialogue: 0,0:17:30.80,0:17:32.95,Default,Maomao,0,0,0,,Nie myli się pan.
Dialogue: 0,0:17:34.12,0:17:36.80,Default,Maomao,0,0,0,,Wyjechałam z własnej woli,
Dialogue: 0,0:17:36.80,0:17:39.57,Default,Maomao,0,0,0,,a pokój, który dostałam,\Njest niczego sobie.
Dialogue: 0,0:17:39.96,0:17:45.54,Default,Maomao,0,0,0,,Jednak martwię się\No mojego ojca, który został sam.
Dialogue: 0,0:17:46.95,0:17:48.40,Default,Maomao,0,0,0,,Co się stało?
Dialogue: 0,0:17:48.40,0:17:53.08,Default,Jinshi,0,0,0,,Nie spodziewałem się, że obchodzi cię\Ncoś innego niż lekarstwa czy trucizny.
Dialogue: 0,0:17:54.05,0:17:56.04,Default,Maomao,0,0,0,,Uczy mnie też zielarstwa.
Dialogue: 0,0:17:56.04,0:17:58.84,Default,Maomao,0,0,0,,Potrzebuję, by żył o wiele dłużej.
Dialogue: 0,0:17:59.41,0:18:02.60,Default,Jinshi,0,0,0,,Musi być całkiem uzdolnionym zielarzem.
Dialogue: 0,0:18:03.04,0:18:07.20,Default,Maomao,0,0,0,,Zna nie tylko tradycyjną medycynę,\Nale również medycyny z innych krajów.
Dialogue: 0,0:18:07.20,0:18:11.11,Default,Maomao,0,0,0,,Podobno w młodości studiował za granicą.
Dialogue: 0,0:18:11.76,0:18:14.98,Default,Jinshi,0,0,0,,Czyli to musi być jakiś sławny zielarz.
Dialogue: 0,0:18:15.62,0:18:19.15,Default,Jinshi,0,0,0,,Tylko wybrani przez cesarstwo\Nmogą studiować za granicą.
Dialogue: 0,0:18:19.15,0:18:21.55,Default,Maomao,0,0,0,,Jest niezwykle uzdolniony.
Dialogue: 0,0:18:21.55,0:18:23.98,Default,Maomao,0,0,0,,Ponoć bóg daje człowiekowi\Ntylko jeden talent,
Dialogue: 0,0:18:23.98,0:18:26.20,Default,Maomao,0,0,0,,ale zdarzają się wyjątki.
Dialogue: 0,0:18:26.20,0:18:28.75,Default,Jinshi,0,0,0,,Robi wrażenie.
Dialogue: 0,0:18:29.24,0:18:32.59,Default,Jinshi,0,0,0,,Czemu tak niezwykły człowiek\Npracuje jako zielarz w dzielnicy uciech?
Dialogue: 0,0:18:33.30,0:18:36.43,Default,Maomao,0,0,0,,Chyba dlatego,\Nże zabrakło mu szczęścia.
Dialogue: 0,0:18:36.43,0:18:40.84,Default,Maomao,0,0,0,,Otrzymał dwa talenty,\Nale przypłacił to męskością.
Dialogue: 0,0:18:42.15,0:18:46.22,Default,Jinshi,0,0,0,,Chcesz powiedzieć,\Nże twój ojciec jest eunuchem?
Dialogue: 0,0:18:46.22,0:18:47.90,Default,Maomao,0,0,0,,Tak.
Dialogue: 0,0:18:51.91,0:18:54.84,Default,Maomao,0,0,0,,Żart rodem z burdelu\Nchyba nie wypalił.
Dialogue: 0,0:18:55.72,0:18:58.44,Default,Maomao,0,0,0,,Najwidoczniej właśnie\Nz powodu studiów za granicą,
Dialogue: 0,0:18:58.44,0:19:03.90,Default,Maomao,0,0,0,,cesarzowa wdowa, matka poprzedniego\Ncesarza, zrobiła z niego eunucha.
Dialogue: 0,0:19:04.24,0:19:08.05,Default,Jinshi,0,0,0,,Eunuch, zielarz, medyk...
Dialogue: 0,0:19:08.05,0:19:09.70,Default,Maomao,0,0,0,,Nie wspomniałam o tym?
Dialogue: 0,0:19:11.28,0:19:13.76,Default,Maomao,0,0,0,,Czy to tu?
Dialogue: 0,0:19:13.76,0:19:16.17,Default,Maomao,0,0,0,,Na górze pokoje, na dole restauracja.
Dialogue: 0,0:19:16.17,0:19:18.28,Default,Middle-Aged Woman,0,0,0,,Zapraszamy!
Dialogue: 0,0:19:18.28,0:19:19.72,Default,Middle-aged Man,0,0,0,,Ej, ej, ej.
Dialogue: 0,0:19:20.08,0:19:25.39,Default,Maomao,0,0,0,,Rozumiem. Już kumam,\Npo co musiał się przebrać.
Dialogue: 0,0:19:26.44,0:19:29.60,Default,Maomao,0,0,0,,Mogłeś po prostu\Nprzyjechać do dzielnicy uciech.
Dialogue: 0,0:19:29.60,0:19:31.98,Default,Jinshi,0,0,0,,Co? Co masz na myśli?
Dialogue: 0,0:19:31.98,0:19:32.73,Default,Maomao,0,0,0,,Nic.
Dialogue: 0,0:19:34.95,0:19:39.24,Default,Jinshi,0,0,0,,Zielareczko, znasz stałych bywalców\NGrynszpanowego Pawilonu?
Dialogue: 0,0:19:39.24,0:19:42.99,Default,Maomao,0,0,0,,Na pewno tych co się wyróżniają.
Dialogue: 0,0:19:43.36,0:19:44.70,Default,Jinshi,0,0,0,,Co to za jedni?
Dialogue: 0,0:19:44.70,0:19:47.45,Default,Maomao,0,0,0,,Niestety nie mogę powiedzieć.\NTo tajne przez poufne.
Dialogue: 0,0:19:49.49,0:19:50.33,Default,Jinshi,0,0,0,,Więc...
Dialogue: 0,0:19:52.87,0:19:56.09,Default,Jinshi,0,0,0,,Jak obniża się cenę kurtyzany?
Dialogue: 0,0:19:57.80,0:19:59.88,Default,Maomao,0,0,0,,To niemiłe pytanie.
Dialogue: 0,0:20:04.60,0:20:08.39,Default,Maomao,0,0,0,,Jest na to wiele sposobów, zwłaszcza\Nwśród kurtyzan wysokiej rangi.
Dialogue: 0,0:20:09.03,0:20:10.44,Default,Maomao,0,0,0,,W Grynszpanowym Pawilonie
Dialogue: 0,0:20:10.44,0:20:13.55,Default,Maomao,0,0,0,,wszystkie czeladniczki\Nuczy się tańca i śpiewu.
Dialogue: 0,0:20:13.55,0:20:14.40,Default,Maomao,0,0,0,,Dzielą się na te,
Dialogue: 0,0:20:14.40,0:20:17.90,Default,Maomao,0,0,0,,które posiadają zniewalającą urodę\Ni te, które jej nie mają.
Dialogue: 0,0:20:18.68,0:20:23.40,Default,Maomao,0,0,0,,Te, które nie są zbytnio utalentowane,\Nod razu przyjmują klientów.
Dialogue: 0,0:20:23.77,0:20:24.92,Default,Maomao,0,0,0,,Inne...
Dialogue: 0,0:20:24.92,0:20:29.29,Default,Maomao,0,0,0,,uczą się parzenia herbaty\Ni umilają gościom czas przy herbatce.
Dialogue: 0,0:20:29.29,0:20:30.91,Default,Maomao,0,0,0,,Wtedy ich cena wzrasta.
Dialogue: 0,0:20:31.51,0:20:33.84,Default,Maomao,0,0,0,,Gdy zyskują sławę,\Npokazują się rzadziej.
Dialogue: 0,0:20:33.84,0:20:36.13,Default,Maomao,0,0,0,,Potem pojawia się\Nkurtyzana z najwyższej półki,
Dialogue: 0,0:20:36.13,0:20:37.92,Default,Maomao,0,0,0,,tam za herbatę\Noddasz roczną pensję.
Dialogue: 0,0:20:39.08,0:20:43.20,Default,Maomao,0,0,0,,Niektóre z nich zachowują czystość\Ndo czasu, aż zostaną wykupione.
Dialogue: 0,0:20:44.15,0:20:47.80,Default,Maomao,0,0,0,,Ich wartość opiera się na dziewictwie.
Dialogue: 0,0:20:47.80,0:20:51.31,Default,Maomao,0,0,0,,Jego utrata z łatwością\Nobniży jej wartość o połowę.
Dialogue: 0,0:20:51.31,0:20:52.18,Default,Maomao,0,0,0,,Dodatkowo...
Dialogue: 0,0:20:54.08,0:20:58.73,Default,Maomao,0,0,0,,Ciąża niemal całkowicie\Nobniżyłaby jej cenę.
