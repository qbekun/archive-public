Dialogue: 0,0:22:33.83,0:22:36.68,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.68,0:22:39.25,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.34,0:22:52.59,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.74,0:22:54.17,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.21,0:22:55.44,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.44,0:22:56.82,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:57.04,0:22:58.31,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.46,0:22:59.88,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.92,0:23:02.21,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.53,0:23:05.75,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.83,0:23:07.97,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.08,0:23:10.60,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.62,0:23:12.86,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.12,0:23:14.67,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.69,0:23:15.92,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:15.99,0:23:18.66,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.83,0:23:20.11,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.24,0:23:23.88,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.57,0:23:25.95,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:25.99,0:23:27.42,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.46,0:23:30.09,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.22,0:23:32.55,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.55,0:23:35.27,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.69,0:23:39.53,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.56,0:23:42.10,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.42,0:24:05.88,Introduction/Gauge,,0000,0000,0000,,{\fs75\c&H222D38&\fscx115\fscy115\pos(635,266)}{sign}Wskaźnik dzisiejszego krwawienia z nosa
Dialogue: 0,0:24:07.72,0:24:11.58,Default,,0000,0000,0000,,Jestem idolką, nawet jeśli się rozbiorę!
Dialogue: 0,0:24:12.47,0:24:27.49,Title,,0000,0000,0000,,{\pos(1043,191)}{sign}W następnym odcinku:\NNie odejdę\NNie pozwolę ci odejść
Dialogue: 0,0:24:13.10,0:24:14.63,Default,,0000,0000,0000,,Tu Sonokoe Utae.
Dialogue: 0,0:24:14.63,0:24:16.91,Default,,0000,0000,0000,,Kiedy lato grzeje, oto czego potrzebujesz...
Dialogue: 0,0:24:16.91,0:24:19.30,Default,,0000,0000,0000,,Uczucie zimna w ustach i gorąca w sercu.
Dialogue: 0,0:24:19.30,0:24:22.45,Default,,0000,0000,0000,,Czujesz, jakby twoje ciało się rozpływało.
Dialogue: 0,0:24:22.45,0:24:23.83,Default,,0000,0000,0000,,Nie mogę przestać ich jeść!
Dialogue: 0,0:24:23.83,0:24:27.49,Default,,0000,0000,0000,,Wszyscy kochają Batoniki Inspiracji!
