Dialogue: 0,0:00:07.71,0:00:09.75,Default,,0000,0000,0000,,Nie ukryjesz się przede mną.
Dialogue: 0,0:00:10.01,0:00:11.79,Default,,0000,0000,0000,,Znajdę cię wszędzie.
Dialogue: 0,0:00:13.22,0:00:14.69,Default,,0000,0000,0000,,Mów mi Onee-sama!
Dialogue: 0,0:00:16.61,0:00:21.00,Default,,0000,0000,0000,,Dobra! Właśnie zdobyłam super platynowe bilety na koncert muzyki klasycznej!
Dialogue: 0,0:00:21.09,0:00:22.24,Default,,0000,0000,0000,,Super!
Dialogue: 0,0:00:22.70,0:00:26.66,Default,,0000,0000,0000,,Ale nadal nie jesteśmy gotowe, by chodzić na randki same...
Dialogue: 0,0:00:27.06,0:00:28.67,Default,,0000,0000,0000,,Wiesz, jak temu zaradzić, prawda?
Dialogue: 0,0:00:28.93,0:00:32.20,Default,,0000,0000,0000,,Po prostu ich dotknij i wszystko będzie dobrze.
Dialogue: 0,0:00:32.63,0:00:33.89,Default,,0000,0000,0000,,Nie mogę tego zrobić.
Dialogue: 0,0:00:34.90,0:00:35.90,Default,,0000,0000,0000,,Ponieważ ja...
Dialogue: 0,0:00:42.02,0:00:43.68,Default,,0000,0000,0000,,Ja nic nie zrobiłam.
Dialogue: 0,0:00:44.23,0:00:45.32,Default,,0000,0000,0000,,Onee-sama?
Dialogue: 0,0:00:50.26,0:00:51.41,Default,,0000,0000,0000,,O nic się nie martw.
Dialogue: 0,0:00:52.04,0:00:54.79,Default,,0000,0000,0000,,Później się tym zajmę.
Dialogue: 0,0:00:57.89,0:00:59.50,Default,,0000,0000,0000,,Czas coś przekąsić!
Dialogue: 0,0:01:09.90,0:01:10.99,Default,,0000,0000,0000,,Trzymaj się!
Dialogue: 0,0:01:13.34,0:01:14.34,Default,,0000,0000,0000,,Ten znak...
Dialogue: 0,0:01:15.35,0:01:16.50,Default,,0000,0000,0000,,To tamtej senpai.
Dialogue: 0,0:01:17.65,0:01:21.18,Default,,0000,0000,0000,,Jak śmiała tknąć moją siostrzyczkę!
