Dialogue: 0,0:01:21.97,0:01:24.17,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:01:33.29,0:01:35.83,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:01:35.94,0:01:37.84,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:01:38.44,0:01:43.36,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:01:44.56,0:01:49.20,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:01:49.74,0:01:54.72,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:01:55.91,0:01:58.47,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:01:58.71,0:02:01.15,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:02:01.55,0:02:02.61,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:02:02.61,0:02:03.68,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:02:03.68,0:02:06.08,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:02:06.38,0:02:08.93,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:02:09.25,0:02:11.97,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:02:12.31,0:02:15.05,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:02:15.12,0:02:18.07,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:02:18.14,0:02:20.25,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:02:20.44,0:02:23.25,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:02:23.55,0:02:26.39,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:02:26.44,0:02:29.13,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:02:29.24,0:02:31.53,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:02:29.74,0:02:32.50,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:31.70,0:02:34.18,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:32.56,0:02:35.32,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:34.50,0:02:36.98,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:35.43,0:02:37.00,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:02:37.35,0:02:40.17,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:02:52.72,0:02:56.52,Title,,0000,0000,0000,,{\fad(1000,1000)\pos(476,567)}Tylko dziewczyny
Dialogue: 0,0:03:02.06,0:03:04.88,Default,,0000,0000,0000,,Wspaniale. Wręcz cudownie!
Dialogue: 0,0:03:05.16,0:03:08.23,Default,,0000,0000,0000,,Czuję, jak pojawiają się nowe pomysły.
Dialogue: 0,0:03:08.78,0:03:10.27,Default,,0000,0000,0000,,Wybieram cię.
Dialogue: 0,0:03:11.91,0:03:13.09,Default,,0000,0000,0000,,U-Um...
Dialogue: 0,0:03:13.49,0:03:15.73,Default,,0000,0000,0000,,Dzień dobry, Fukune-chan.
Dialogue: 0,0:03:16.88,0:03:18.94,Default,,0000,0000,0000,,Powinnam się domyślić, że spróbujesz pogadać z Fukune-chan.
Dialogue: 0,0:03:19.00,0:03:21.24,Default,,0000,0000,0000,,Jest tak, jak o tobie mówią, Botan-senpai.
Dialogue: 0,0:03:21.27,0:03:22.36,Default,,0000,0000,0000,,Masz naprawdę świetny gust.
Dialogue: 0,0:03:22.96,0:03:24.45,Default,,0000,0000,0000,,Ty również jesteś całkiem znana.
Dialogue: 0,0:03:24.77,0:03:28.47,Default,,0000,0000,0000,,Wszyscy mówią o pewnej pierwszoklasistce, która zmusza dziewczyny, by mówiły do niej Onee-sama.
Dialogue: 0,0:03:28.76,0:03:30.48,Default,,0000,0000,0000,,Och, doprawdy?
Dialogue: 0,0:03:30.80,0:03:34.10,Default,,0000,0000,0000,,Więc wiedziałaś, że ta zeszłej nocy była moją siostrzyczką.
Dialogue: 0,0:03:34.50,0:03:40.01,Default,,0000,0000,0000,,Właściwie to ona już nie jest twoją siostrzyczka, tylko jednym z moich dzieł sztuki.
Dialogue: 0,0:03:41.65,0:03:44.49,Default,,0000,0000,0000,,Będę musiała ci się za to odwdzięczyć.
Dialogue: 0,0:03:44.84,0:03:45.99,Default,,0000,0000,0000,,Bądź pewna, że to zrobię!
Dialogue: 0,0:03:48.48,0:03:50.49,Default,,0000,0000,0000,,Już nie mogę się doczekać.
Dialogue: 0,0:03:51.12,0:03:54.91,Default,,0000,0000,0000,,Co ta Ran wyprawia z samego rana?
Dialogue: 0,0:03:55.26,0:03:57.12,Default,,0000,0000,0000,,Ta, z którą rozmawia, to Beni Botan-senpai.
Dialogue: 0,0:03:57.73,0:03:59.05,Default,,0000,0000,0000,,Beni Botan?
Dialogue: 0,0:03:59.25,0:04:01.63,Default,,0000,0000,0000,,Zdaje się, że gdzieś ostatnio słyszałem to nazwisko...
Dialogue: 0,0:04:03.15,0:04:07.34,Thoughts,,0000,0000,0000,,Taketo-san, słyszałeś o incydencie malowanych mundurków?
Dialogue: 0,0:04:07.60,0:04:10.47,Thoughts,,0000,0000,0000,,Incydent malowanych mundurków?
Dialogue: 0,0:04:15.47,0:04:19.83,Default,,0000,0000,0000,,Światowej sławy geniusz awangardowej sztuki!
Dialogue: 0,0:04:20.18,0:04:22.99,Default,,0000,0000,0000,,T-ta Botan-senpai?
Dialogue: 0,0:04:23.48,0:04:27.44,Default,,0000,0000,0000,,Słyszałem, że zmieni każdy motyw, jaki jej się spodoba, w sztukę, choćby nie wiem co.
Dialogue: 0,0:04:27.90,0:04:29.22,Default,,0000,0000,0000,,W sztukę...
Dialogue: 0,0:04:30.74,0:04:34.79,Default,,0000,0000,0000,,Chciałbym, by zauważyła różnicę między pasją a szaleństwem.
Dialogue: 0,0:04:34.96,0:04:35.99,Default,,0000,0000,0000,,Racja.
Dialogue: 0,0:04:36.48,0:04:39.96,Default,,0000,0000,0000,,Powinna dojść do lepszego zastosowania swojej energii.
Dialogue: 0,0:04:40.44,0:04:42.02,Default,,0000,0000,0000,,D-dojść?
Dialogue: 0,0:04:42.97,0:04:47.36,Default,,0000,0000,0000,,No weź, ty też... z samego rana... ludzie patrzą.
Dialogue: 0,0:04:47.39,0:04:48.63,Default,,0000,0000,0000,,Jesteśmy w miejscu publicznym.
Dialogue: 0,0:04:48.63,0:04:50.49,Default,,0000,0000,0000,,Powiedz to, teraz! Głośno!
Dialogue: 0,0:04:52.47,0:04:55.80,Default,,0000,0000,0000,,3.1415926...
Dialogue: 0,0:05:04.76,0:05:06.54,Thoughts,,0000,0000,0000,,Narukara-san siedzi sama.
Dialogue: 0,0:05:07.00,0:05:09.47,Default,,0000,0000,0000,,Na co się gapisz, ero-pisarzu?
Dialogue: 0,0:05:11.39,0:05:12.25,Default,,0000,0000,0000,,O co chodzi?
Dialogue: 0,0:05:13.20,0:05:14.81,Default,,0000,0000,0000,,Nie twoja sprawa.
Dialogue: 0,0:05:15.18,0:05:17.48,Default,,0000,0000,0000,,Najpierw Botan-senpai, teraz ty...
Dialogue: 0,0:05:17.76,0:05:21.47,Default,,0000,0000,0000,,Dlaczego wszystkie dziwadła tak ciągnie do Fukune-chan?
Dialogue: 0,0:05:22.30,0:05:25.63,Default,,0000,0000,0000,,Co? B-Botan-senpai? Poważnie?
Dialogue: 0,0:05:25.80,0:05:27.75,Default,,0000,0000,0000,,Nie pozwolę żadnemu z was jej tknąć!
Dialogue: 0,0:05:27.90,0:05:30.45,Default,,0000,0000,0000,,Ani jej, ani takiemu ero-pisarzowi jak ty!
Dialogue: 0,0:05:35.74,0:05:38.46,Default,,0000,0000,0000,,Narukara Fukune-san z klasy 1-3,
Dialogue: 0,0:05:38.72,0:05:41.99,Default,,0000,0000,0000,,wzywa cię Komitet Działalności Kulturalnej Geniuszy.
Dialogue: 0,0:05:42.31,0:05:44.23,Default,,0000,0000,0000,,Prosimy o zgłoszenie się do pokoju nauczycielskiego.
Dialogue: 0,0:05:45.21,0:05:46.33,Default,,0000,0000,0000,,Idzie sobie...
Dialogue: 0,0:05:47.28,0:05:49.72,Default,,0000,0000,0000,,Komitet Działalności Kulturalnej Geniuszy?
Dialogue: 0,0:05:50.26,0:05:52.16,Default,,0000,0000,0000,,Pierwszy raz słyszę tą nazwę.
Dialogue: 0,0:05:52.73,0:05:55.03,Default,,0000,0000,0000,,Pewnie został dopiero co stworzony przez jakiegoś dziwaka.
Dialogue: 0,0:05:55.26,0:05:57.24,Default,,0000,0000,0000,,W końcu to Akademia Inspiracji.
Dialogue: 0,0:06:03.47,0:06:04.36,Default,,0000,0000,0000,,Wiedziałam!
Dialogue: 0,0:06:05.42,0:06:05.88,Default,,0000,0000,0000,,Co?
Dialogue: 0,0:06:06.78,0:06:11.51,Beni Botan,,0000,0000,0000,,{\pos(722,271)}Beni Botan
Dialogue: 0,0:06:06.78,0:06:11.51,GCAC,,0000,0000,0000,,{\pos(720,156)}Komitet Działalności Kulturalnej Geniuszy
Dialogue: 0,0:06:07.29,0:06:09.32,Default,,0000,0000,0000,,Przewodniczącą tego komitetu jest Beni Botan.
Dialogue: 0,0:06:09.50,0:06:11.51,Default,,0000,0000,0000,,To pułapka zastawiona przez nią na Fukune-chan!
Dialogue: 0,0:06:11.88,0:06:12.97,Default,,0000,0000,0000,,Muszę ją powstrzymać!
Dialogue: 0,0:06:13.86,0:06:14.43,Default,,0000,0000,0000,,Czekaj!
Dialogue: 0,0:06:15.30,0:06:15.96,Default,,0000,0000,0000,,Idę z tobą.
Dialogue: 0,0:06:16.59,0:06:17.97,Default,,0000,0000,0000,,Czemu ty też idziesz?
Dialogue: 0,0:06:18.45,0:06:20.64,Default,,0000,0000,0000,,Ponieważ martwię się o Narukarę-san.
Dialogue: 0,0:06:21.87,0:06:23.68,Default,,0000,0000,0000,,Myślisz, że jesteś jej rycerzem w lśniącej zbroi czy coś?
Dialogue: 0,0:06:23.71,0:06:25.89,Default,,0000,0000,0000,,Chyba śnisz, ero-pisarzu!
Dialogue: 0,0:06:26.20,0:06:29.88,Default,,0000,0000,0000,,T-to nie ma teraz znaczenia.
Dialogue: 0,0:06:31.69,0:06:34.19,Default,,0000,0000,0000,,Nie sądzisz, że Fukune-chan cię znienawidzi jak się dowie?
Dialogue: 0,0:06:35.85,0:06:37.95,Default,,0000,0000,0000,,Sama ją obronię.
Dialogue: 0,0:06:38.18,0:06:39.24,Default,,0000,0000,0000,,Nie wtrącaj się!
Dialogue: 0,0:06:41.45,0:06:42.28,Default,,0000,0000,0000,,Ja...
Dialogue: 0,0:06:44.92,0:06:47.22,Default,,0000,0000,0000,,Nadchodzi. Czuję, jak nadchodzi.
Dialogue: 0,0:06:48.14,0:06:52.04,Default,,0000,0000,0000,,Co to za specjalne wydarzenie?
Dialogue: 0,0:06:52.44,0:06:53.85,Default,,0000,0000,0000,,Jak-już-mówiłam.
Dialogue: 0,0:06:54.08,0:07:01.66,Default,,0000,0000,0000,,Planuję zrobić wielką wystawę dla wszystkich genialnych artystów w Akademii Inspiracji.
Dialogue: 0,0:07:02.00,0:07:07.14,Default,,0000,0000,0000,,Dlatego potrzebuję naprawdę wspaniałego dzieła, które będzie w centrum uwagi.
Dialogue: 0,0:07:07.77,0:07:10.04,Default,,0000,0000,0000,,Pomożesz mi, prawda? Prawda?
Dialogue: 0,0:07:10.70,0:07:12.80,Default,,0000,0000,0000,,Ale muszę ćwiczyć...
Dialogue: 0,0:07:13.17,0:07:15.15,Default,,0000,0000,0000,,Tak, tak, wiem.
Dialogue: 0,0:07:15.58,0:07:18.60,Default,,0000,0000,0000,,Ale najpierw pozwól mi zacząć.
Dialogue: 0,0:07:24.80,0:07:26.72,Default,,0000,0000,0000,,Jesteśmy teraz same w tym świecie.
Dialogue: 0,0:07:27.15,0:07:28.70,Default,,0000,0000,0000,,Nikt nie może nam przeszkodzić.
Dialogue: 0,0:07:29.59,0:07:31.46,Default,,0000,0000,0000,,Rozkoszujmy się tym bez pośpiechu.
Dialogue: 0,0:07:31.95,0:07:34.70,Default,,0000,0000,0000,,Niestety, Onee-sama. Nie mogę jej znaleźć.
Dialogue: 0,0:07:34.79,0:07:36.97,Default,,0000,0000,0000,,Wygląda na to, że położenie jej pracowni jest ściśle tajne.
Dialogue: 0,0:07:37.37,0:07:39.44,Default,,0000,0000,0000,,Czekaj no tylko, senpai!
Dialogue: 0,0:07:43.75,0:07:45.84,Default,,0000,0000,0000,,Opór jest bezcelowy.
Dialogue: 0,0:07:46.07,0:07:48.63,Default,,0000,0000,0000,,Odsłoń się przede mną.
Dialogue: 0,0:07:48.91,0:07:50.46,Default,,0000,0000,0000,,Mów mi Onee-sama!
Dialogue: 0,0:07:58.79,0:08:01.72,Default,,0000,0000,0000,,W tamtej chwili, 45 satelitów zostało zhackowanych,
Dialogue: 0,0:08:01.72,0:08:04.79,Default,,0000,0000,0000,,w tym kilka satelitów wojskowych należących do światowych supermocarstw.
Dialogue: 0,0:08:05.56,0:08:11.19,Default,,0000,0000,0000,,Jednocześnie wszystkie kamery w Akademii Inspiracji znalazły sie pod kontrolą Musen Ran.
Dialogue: 0,0:08:18.97,0:08:20.72,Default,,0000,0000,0000,,Klasy Akademii Inspiracji, sprawdzone.
Dialogue: 0,0:08:21.30,0:08:22.42,Default,,0000,0000,0000,,Żeński akademik, sprawdzony.
Dialogue: 0,0:08:22.73,0:08:23.31,Default,,0000,0000,0000,,Sprawdzone.
Dialogue: 0,0:08:23.65,0:08:24.17,Default,,0000,0000,0000,,Sprawdzone.
Dialogue: 0,0:08:24.54,0:08:25.06,Default,,0000,0000,0000,,Sprawdzone.
Dialogue: 0,0:08:25.43,0:08:26.29,Default,,0000,0000,0000,,Sprawdzone.
Dialogue: 0,0:08:27.10,0:08:29.31,Default,,0000,0000,0000,,Nie widzę jej na żadnej z kamer.
Dialogue: 0,0:08:30.51,0:08:33.56,Default,,0000,0000,0000,,To znaczy, że musi być gdzie indziej!
Dialogue: 0,0:08:34.82,0:08:37.34,Thoughts,,0000,0000,0000,,Zastanawiam się, co robi teraz Botan-senpai.
Dialogue: 0,0:08:43.34,0:08:44.89,Default,,0000,0000,0000,,Teraz twoja kolej.
Dialogue: 0,0:08:49.26,0:08:51.15,Default,,0000,0000,0000,,T-teraz nie czas na myślenie o tym.
Dialogue: 0,0:08:54.43,0:08:57.93,Default,,0000,0000,0000,,Wolałabym, byś nie używała moich kamer szpiegowskich w takich celach.
Dialogue: 0,0:08:58.70,0:08:59.56,Default,,0000,0000,0000,,Senpai!
Dialogue: 0,0:08:59.77,0:09:02.75,Default,,0000,0000,0000,,Nie mów mi, że zapomniałaś, co zrobiłaś Fukune-chan!
Dialogue: 0,0:09:03.27,0:09:08.01,Default,,0000,0000,0000,,Przestań narzekać albo wyślę ci olbrzymią dawkę wirusów Musen Ran,
Dialogue: 0,0:09:08.01,0:09:09.93,Default,,0000,0000,0000,,które zniszczą Ministerstwo Obrony!
Dialogue: 0,0:09:10.16,0:09:12.77,Default,,0000,0000,0000,,Dobra, dobra. Już rozumiem.
Dialogue: 0,0:09:13.72,0:09:16.19,Default,,0000,0000,0000,,K-klarnet...
Dialogue: 0,0:09:16.90,0:09:19.14,Default,,0000,0000,0000,,Dobrze, zaczynajmy więc.
Dialogue: 0,0:09:23.94,0:09:26.12,Default,,0000,0000,0000,,Dość tego, Botan-senpai!
Dialogue: 0,0:09:26.58,0:09:30.77,Default,,0000,0000,0000,,Niemożliwe! Jak mogłaś tak szybko znaleźć moją pracownię?
Dialogue: 0,0:09:31.29,0:09:32.92,Default,,0000,0000,0000,,Całkiem sprytne...
Dialogue: 0,0:09:33.38,0:09:37.78,Default,,0000,0000,0000,,Ukryć wejście do swojej podziemnej pracowni w porzuconym piecu.
Dialogue: 0,0:09:37.95,0:09:39.61,Default,,0000,0000,0000,,To świetna kryjówka.
Dialogue: 0,0:09:39.87,0:09:42.43,Default,,0000,0000,0000,,Idealna, by się zabawić tylko we dwoje.
Dialogue: 0,0:09:42.54,0:09:44.21,Default,,0000,0000,0000,,Jakie znowu "zabawić się"?
Dialogue: 0,0:09:44.38,0:09:47.25,Default,,0000,0000,0000,,Zaciągnęłaś ją tu wbrew jej woli.
Dialogue: 0,0:09:47.34,0:09:49.29,Default,,0000,0000,0000,,Ona się wcale dobrze nie bawi!
Dialogue: 0,0:09:49.95,0:09:52.59,Default,,0000,0000,0000,,O rany! Masz z tym jakiś problem?
Dialogue: 0,0:09:53.11,0:09:54.05,Default,,0000,0000,0000,,Oczywiście!
Dialogue: 0,0:09:54.23,0:09:57.44,Default,,0000,0000,0000,,Miła, zabawna i elegancka.
Dialogue: 0,0:09:57.50,0:09:59.71,Default,,0000,0000,0000,,Taka powinna być onee-sama.
Dialogue: 0,0:10:01.72,0:10:05.48,Default,,0000,0000,0000,,A co jeśli ktoś ci ją jutro odbierze?
Dialogue: 0,0:10:06.00,0:10:07.57,Default,,0000,0000,0000,,Nie będzie ci to przeszkadzać?
Dialogue: 0,0:10:08.58,0:10:09.70,Default,,0000,0000,0000,,Co masz na myśli?
Dialogue: 0,0:10:10.04,0:10:13.26,Default,,0000,0000,0000,,Jedyna rzecz, w którą wierzę, to pasja, którą właśnie czuję.
Dialogue: 0,0:10:13.49,0:10:15.73,Default,,0000,0000,0000,,Prawda istnieje wyłącznie w teraźniejszości.
Dialogue: 0,0:10:17.31,0:10:21.61,Default,,0000,0000,0000,,Różnimy się od siebie. Ja nie próbuję ukrywać swoich złych stron.
Dialogue: 0,0:10:22.88,0:10:23.62,Default,,0000,0000,0000,,Złych?
Dialogue: 0,0:10:24.11,0:10:28.79,Default,,0000,0000,0000,,Otóż to. Właśnie powiedziałaś, że jesteś słaba w radzeniu sobie z dziewczynami.
Dialogue: 0,0:10:29.94,0:10:32.38,Default,,0000,0000,0000,,Twierdzisz, że{\i1}ja{\i0}źle się obchodzę z dziewczynami?
Dialogue: 0,0:10:32.84,0:10:34.73,Default,,0000,0000,0000,,Tego ci nie daruję!
Dialogue: 0,0:10:35.28,0:10:39.15,Default,,0000,0000,0000,,Ach tak. Więc może mi to udowodnisz?
Dialogue: 0,0:10:41.74,0:10:42.91,Default,,0000,0000,0000,,A teraz
Dialogue: 0,0:10:42.97,0:10:44.47,Default,,0000,0000,0000,,zaczynamy zaczynamy jednorundowy pojedynek
Dialogue: 0,0:10:44.47,0:10:46.99,Default,,0000,0000,0000,,o to, kto weźmie Narukarę Fukune.
Dialogue: 0,0:10:47.42,0:10:49.03,Default,,0000,0000,0000,,W niebieskim narożniku,
Dialogue: 0,0:10:49.12,0:10:53.11,Default,,0000,0000,0000,,Beni Botan z klasy 3-2!
Dialogue: 0,0:10:53.80,0:10:55.06,Default,,0000,0000,0000,,W czerwonym narożniku,
Dialogue: 0,0:10:55.14,0:10:59.34,Default,,0000,0000,0000,,Musen Ran z klasy 1-3!
Dialogue: 0,0:11:01.63,0:11:03.70,Default,,0000,0000,0000,,Komentować będę ja, Kiya Star.
Dialogue: 0,0:11:03.29,0:11:08.98,Mei Choushi,,0000,0000,0000,,{\fad(330,0)\pos(400,509)}Mei Choushi
Dialogue: 0,0:11:03.29,0:11:08.98,Genius Analyst,,0000,0000,0000,,{\fad(330,0)\pos(398,415)}Genialna Analityczka
Dialogue: 0,0:11:03.81,0:11:07.72,Default,,0000,0000,0000,,Analizą zajmie się genialna analityczka, Mei Choushi-san.
Dialogue: 0,0:11:08.03,0:11:08.98,Default,,0000,0000,0000,,Witam wszystkich.
Dialogue: 0,0:11:33.07,0:11:35.16,Default,,0000,0000,0000,,Wiedziałem, że to się wymknie spod kontroli.
Dialogue: 0,0:11:37.78,0:11:40.16,Default,,0000,0000,0000,,Co się dzieje? Ran nagle odwraca się tyłem do przeciwniczki?!
Dialogue: 0,0:11:40.62,0:11:43.37,Default,,0000,0000,0000,,Ciekawa jestem, co się stanie dalej. Popatrzmy.
Dialogue: 0,0:11:46.22,0:11:47.88,Default,,0000,0000,0000,,Uśmiechnęła się!
Dialogue: 0,0:11:52.45,0:11:54.17,Default,,0000,0000,0000,,I wyciągnęła dłoń!
Dialogue: 0,0:11:54.86,0:11:57.18,Default,,0000,0000,0000,,Młodsza siostrzyczka będzie się czuła niepewnie, kiedy w milczeniu odwróci się do niej plecami.
Dialogue: 0,0:11:57.36,0:11:59.54,Default,,0000,0000,0000,,Jednak ta niepewność zostaje wyeliminowana przez odwrócenie się z powrotem, uśmiechając się.
Dialogue: 0,0:11:59.80,0:12:03.21,Default,,0000,0000,0000,,Kombo Starszej siostry: wyciągnięcie dłoni dla podwojenia radości.
Dialogue: 0,0:12:05.59,0:12:08.21,Default,,0000,0000,0000,,Wszystkie siostrzyczki Ran zemdlały!
Dialogue: 0,0:12:08.29,0:12:09.36,Default,,0000,0000,0000,,Całkiem skuteczne.
Dialogue: 0,0:12:12.31,0:12:15.10,Default,,0000,0000,0000,,Botan chwiejnie podchodzi do niej.
Dialogue: 0,0:12:16.13,0:12:17.94,Default,,0000,0000,0000,,Zastosuje pełen uczucia uścisk?
Dialogue: 0,0:12:18.08,0:12:20.06,Default,,0000,0000,0000,,Czy też pójdzie dalej i skradnie pocałunek?
Dialogue: 0,0:12:20.29,0:12:21.30,Default,,0000,0000,0000,,Przekonajmy się.
Dialogue: 0,0:12:25.63,0:12:28.53,Default,,0000,0000,0000,,Omal nie przełamałaś mojej obrony, ale...
Dialogue: 0,0:12:30.20,0:12:32.72,Default,,0000,0000,0000,,Ja wolę bardziej bezpośrednie podejście.
Dialogue: 0,0:12:33.56,0:12:36.17,Default,,0000,0000,0000,,Co to ma być? Chcesz we mnie strzelić promieniem czy coś?
Dialogue: 0,0:12:47.87,0:12:49.70,Default,,0000,0000,0000,,N-niemożliwe.
Dialogue: 0,0:12:50.13,0:12:52.23,Default,,0000,0000,0000,,Jedno spojrzenie wystarczy.
Dialogue: 0,0:12:53.58,0:12:55.07,Default,,0000,0000,0000,,Ran, weź się w garść!
Dialogue: 0,0:12:56.74,0:12:58.49,Default,,0000,0000,0000,,Dobrze, zaczynajmy więc.
Dialogue: 0,0:13:03.17,0:13:05.78,Default,,0000,0000,0000,,Mówiłam ci, wolę bezpośrednie podejście!
Dialogue: 0,0:13:08.45,0:13:10.52,Default,,0000,0000,0000,,Tak jest dużo szybciej.
Dialogue: 0,0:13:14.54,0:13:17.24,Default,,0000,0000,0000,,Botan kontratakuje chwyceniem za piersi.
Dialogue: 0,0:13:17.55,0:13:19.70,Default,,0000,0000,0000,,Atak Ran został kompletnie odparty!
Dialogue: 0,0:13:19.88,0:13:21.02,Default,,0000,0000,0000,,Znalazła się w ciężkiej sytuacji.
Dialogue: 0,0:13:21.68,0:13:24.47,Default,,0000,0000,0000,,Ataki Ran opierają się na ustalonym wzorcu.
Dialogue: 0,0:13:24.67,0:13:27.51,Default,,0000,0000,0000,,Wygląd, gesty, a następnie objęcie.
Dialogue: 0,0:13:27.86,0:13:31.02,Default,,0000,0000,0000,,Z kolei strategia Botan polega po prostu na bezpośrednim natarciu.
Dialogue: 0,0:13:36.11,0:13:39.17,Default,,0000,0000,0000,,Oho! Botan nagle zaczęła biec!
Dialogue: 0,0:13:41.55,0:13:42.33,Default,,0000,0000,0000,,Ty!
Dialogue: 0,0:13:53.58,0:13:55.73,Default,,0000,0000,0000,,Widzisz? Teraz już rozumiesz?
Dialogue: 0,0:14:07.10,0:14:09.20,Default,,0000,0000,0000,,Ciągle gadasz o uczuciach,
Dialogue: 0,0:14:09.77,0:14:12.41,Default,,0000,0000,0000,,ale nie potrafisz nic zrobić.
Dialogue: 0,0:14:14.25,0:14:16.09,Default,,0000,0000,0000,,To jest przyjemne, prawda?
Dialogue: 0,0:14:21.54,0:14:23.84,Default,,0000,0000,0000,,Nawet, jeśli to ja to robię.
Dialogue: 0,0:14:28.00,0:14:30.47,Default,,0000,0000,0000,,Dalej, kończmy to.
Dialogue: 0,0:14:45.86,0:14:48.10,Default,,0000,0000,0000,,To jest to! Jej specjalny atak kończący, odcisk piersi!
Dialogue: 0,0:14:48.18,0:14:50.34,Default,,0000,0000,0000,,Atak i dzieło sztuki w jednym.
Dialogue: 0,0:14:50.42,0:14:51.74,Default,,0000,0000,0000,,Naprawdę genialne.
Dialogue: 0,0:15:01.62,0:15:02.45,Default,,0000,0000,0000,,Ran!
Dialogue: 0,0:15:15.11,0:15:18.01,Default,,0000,0000,0000,,To już chyba koniec pojedynku.
Dialogue: 0,0:15:15.11,0:15:17.12,Default,,0000,0000,0000,,{\3c&HFF9600&\4c&HFFFF00&}Co ty wyprawiasz, zboczeńcu?!
Dialogue: 0,0:15:17.12,0:15:18.04,Default,,0000,0000,0000,,{\3c&HFF9600&\4c&HFFFF00&}O co ci chodzi?
Dialogue: 0,0:15:19.36,0:15:21.31,Default,,0000,0000,0000,,P-po coś tu przylazł?
Dialogue: 0,0:15:21.63,0:15:24.24,Default,,0000,0000,0000,,Nikt cię nie prosił o pomoc!
Dialogue: 0,0:15:24.53,0:15:25.53,Default,,0000,0000,0000,,Wiem o tym!
Dialogue: 0,0:15:26.02,0:15:29.26,Default,,0000,0000,0000,,Ale jak tak dalej pójdzie, Narukara-san zostanie zmieniona w jedno z jej dzieł sztuki, prawda?
Dialogue: 0,0:15:29.44,0:15:30.27,Default,,0000,0000,0000,,Zamknij się!
Dialogue: 0,0:15:31.45,0:15:32.25,Default,,0000,0000,0000,,Tym razem
Dialogue: 0,0:15:32.80,0:15:34.78,Default,,0000,0000,0000,,to ja ją obronię.
Dialogue: 0,0:15:40.55,0:15:42.61,Default,,0000,0000,0000,,Ran, mam pewien pomysł.
Dialogue: 0,0:15:43.88,0:15:48.01,Default,,0000,0000,0000,,Jako pisarz porno, jestem nią bardzo podniecony.
Dialogue: 0,0:15:48.50,0:15:51.00,Default,,0000,0000,0000,,Powalimy ją całym tym libido.
Dialogue: 0,0:15:52.12,0:15:54.04,Default,,0000,0000,0000,,To powinno dać ci przynajmniej okazję do ataku.
Dialogue: 0,0:15:56.45,0:15:59.72,Default,,0000,0000,0000,,Pozwól mi sobie pomóc, ten jeden raz,
Dialogue: 0,0:16:00.12,0:16:01.50,Default,,0000,0000,0000,,aby chronić Narukarę-san.
Dialogue: 0,0:16:02.08,0:16:03.63,Default,,0000,0000,0000,,A-ale...
Dialogue: 0,0:16:04.20,0:16:04.98,Default,,0000,0000,0000,,Ja...
Dialogue: 0,0:16:06.01,0:16:06.67,Default,,0000,0000,0000,,Ran!
Dialogue: 0,0:16:08.25,0:16:11.55,Default,,0000,0000,0000,,Co się dzieje? Botan wciągnęła Narukarę-san na ring,
Dialogue: 0,0:16:11.55,0:16:13.50,Default,,0000,0000,0000,,lekceważąc fakt, że pojedynek wciąż trwa!
Dialogue: 0,0:16:16.72,0:16:18.50,Default,,0000,0000,0000,,Dobrze, zaczynajmy więc.
Dialogue: 0,0:16:23.26,0:16:24.81,Default,,0000,0000,0000,,Narukara-san czeka.
Dialogue: 0,0:16:27.51,0:16:29.29,Default,,0000,0000,0000,,Nie waż się niczego schrzanić!
Dialogue: 0,0:16:29.55,0:16:30.47,Default,,0000,0000,0000,,Ty też.
Dialogue: 0,0:16:32.77,0:16:34.69,Default,,0000,0000,0000,,K-klarnet...
Dialogue: 0,0:16:40.03,0:16:41.00,Default,,0000,0000,0000,,Dość tego.
Dialogue: 0,0:16:47.78,0:16:49.76,Default,,0000,0000,0000,,Och, nadal stoisz?
Dialogue: 0,0:16:50.34,0:16:54.84,Default,,0000,0000,0000,,Ale wątpię, byś była w stanie coś zrobić.
Dialogue: 0,0:16:55.50,0:16:56.74,Default,,0000,0000,0000,,Ran wróciła na ring!
Dialogue: 0,0:16:57.00,0:16:58.52,Default,,0000,0000,0000,,Czyżby to nie był jeszcze koniec?
Dialogue: 0,0:17:02.11,0:17:04.06,Default,,0000,0000,0000,,Widzisz? A nie mówiłam?
Dialogue: 0,0:17:04.49,0:17:06.44,Default,,0000,0000,0000,,Ran upadła!
Dialogue: 0,0:17:06.44,0:17:08.62,Default,,0000,0000,0000,,Czyżby miała już dość?
Dialogue: 0,0:17:08.91,0:17:10.43,Default,,0000,0000,0000,,Hej! Chwila...
Dialogue: 0,0:17:11.67,0:17:14.08,Default,,0000,0000,0000,,Zgadza się. Pojedynek się skończył.
Dialogue: 0,0:17:14.25,0:17:18.04,Default,,0000,0000,0000,,Ale to nie wystarczy, by zaspokoić artystę.
Dialogue: 0,0:17:18.24,0:17:20.36,Default,,0000,0000,0000,,Tylko najlepsze płótno może przedstawić
Dialogue: 0,0:17:20.45,0:17:22.49,Default,,0000,0000,0000,,obraz stworzony w jego umyśle.
Dialogue: 0,0:17:23.38,0:17:26.25,Default,,0000,0000,0000,,Najlepsze płótno?
Dialogue: 0,0:17:26.71,0:17:27.91,Default,,0000,0000,0000,,Ty nim jesteś!
Dialogue: 0,0:17:28.17,0:17:30.56,Default,,0000,0000,0000,,Tak, ciało samego artysty!
Dialogue: 0,0:17:33.05,0:17:33.66,Default,,0000,0000,0000,,Ja jestem...
Dialogue: 0,0:17:34.92,0:17:36.04,Default,,0000,0000,0000,,...płótnem?
Dialogue: 0,0:17:50.71,0:17:54.47,Default,,0000,0000,0000,,Najpierw skosztowała dojrzałych, nabrzmiałych pomarańczy.
Dialogue: 0,0:17:55.76,0:17:59.49,Default,,0000,0000,0000,,Jej ciało zesztywniało na myśl o lśniących truskawkach
Dialogue: 0,0:17:59.64,0:18:01.19,Default,,0000,0000,0000,,oskubanych jej palcami.
Dialogue: 0,0:18:03.74,0:18:05.66,Default,,0000,0000,0000,,Brzoskwinia w kształcie serca...
Dialogue: 0,0:18:06.38,0:18:08.13,Default,,0000,0000,0000,,A w centrum tego owocu
Dialogue: 0,0:18:08.36,0:18:11.91,Default,,0000,0000,0000,,płynęło źródło gorącej terpentyny.
Dialogue: 0,0:18:14.43,0:18:15.61,Default,,0000,0000,0000,,Maluje.
Dialogue: 0,0:18:16.16,0:18:17.79,Default,,0000,0000,0000,,I jednocześnie jest malowana.
Dialogue: 0,0:18:18.41,0:18:20.82,Default,,0000,0000,0000,,Nieskończony krąg tworzenia.
Dialogue: 0,0:18:21.66,0:18:24.70,Default,,0000,0000,0000,,Oddając się stanowi ekstazy, jakiej dotąd nie znała,
Dialogue: 0,0:18:24.70,0:18:27.37,Default,,0000,0000,0000,,artystka zapomniała o wszystkim innym.
Dialogue: 0,0:18:28.63,0:18:30.64,Default,,0000,0000,0000,,Jeszcze. Jeszcze!
Dialogue: 0,0:18:32.62,0:18:33.71,Default,,0000,0000,0000,,Teraz, Ran!
Dialogue: 0,0:18:36.93,0:18:37.44,Default,,0000,0000,0000,,O nie!
Dialogue: 0,0:18:39.37,0:18:40.43,Default,,0000,0000,0000,,Teraz ci pokażę!
Dialogue: 0,0:18:41.03,0:18:42.53,Default,,0000,0000,0000,,Onee-sama...
Dialogue: 0,0:18:45.08,0:18:46.29,Default,,0000,0000,0000,,Patrzy ci w oczy.
Dialogue: 0,0:18:48.93,0:18:50.08,Default,,0000,0000,0000,,Chwyta twoją dłoń.
Dialogue: 0,0:18:52.06,0:18:54.12,Thoughts,,0000,0000,0000,,J-jej atak...
Dialogue: 0,0:18:58.00,0:18:59.75,Default,,0000,0000,0000,,Użycza ci swego ramienia.
Dialogue: 0,0:19:01.47,0:19:03.51,Thoughts,,0000,0000,0000,,N-nie mogę przestać!
Dialogue: 0,0:19:03.91,0:19:05.81,Default,,0000,0000,0000,,Zagląda w twoje serce.
Dialogue: 0,0:19:17.06,0:19:18.44,Default,,0000,0000,0000,,A na koniec,
Dialogue: 0,0:19:19.04,0:19:21.02,Default,,0000,0000,0000,,robi tak!
Dialogue: 0,0:19:25.24,0:19:28.49,Default,,0000,0000,0000,,To jest to! Genialna programistka, Ran, pokazuje swoją prawdziwą moc.
Dialogue: 0,0:19:28.63,0:19:31.07,Default,,0000,0000,0000,,Szybki deszcz delikatnych dotknięć!
Dialogue: 0,0:19:38.31,0:19:40.63,Default,,0000,0000,0000,,Mówi mi Onee-sama!
Dialogue: 0,0:19:54.18,0:19:55.88,Default,,0000,0000,0000,,To nie tak, że nie potrafiłam tego zrobić.
Dialogue: 0,0:19:56.22,0:19:59.61,Default,,0000,0000,0000,,Po prostu nie posunęłam się tak daleko, jak tylko mogłam, senpai.
Dialogue: 0,0:20:00.79,0:20:01.82,Default,,0000,0000,0000,,Padła!
Dialogue: 0,0:20:01.93,0:20:03.68,Default,,0000,0000,0000,,Botan przegrała pojedynek.
Dialogue: 0,0:20:04.20,0:20:09.31,Default,,0000,0000,0000,,Ran dzielnie udawała, że padła, sprawiając, że Botan opuściła gardę.
Dialogue: 0,0:20:09.51,0:20:13.33,Default,,0000,0000,0000,,Nie, normalnie Botan przejrzałaby tą sztuczkę.
Dialogue: 0,0:20:13.88,0:20:18.01,Default,,0000,0000,0000,,Gdyby nie została wprowadzona w trans przez tą recytację...
Dialogue: 0,0:20:18.38,0:20:20.34,Default,,0000,0000,0000,,U-udało się.
Dialogue: 0,0:20:29.49,0:20:32.62,Default,,0000,0000,0000,,Wszystko w porządku? Nic cię nie boli?
Dialogue: 0,0:20:35.78,0:20:38.25,Default,,0000,0000,0000,,G-gdzie jest Botan-senpai?
Dialogue: 0,0:20:39.31,0:20:40.78,Default,,0000,0000,0000,,Nią się nie przejmuj.
Dialogue: 0,0:20:41.29,0:20:44.28,Default,,0000,0000,0000,,Z pewnością będzie zajęta przez jakiś czas.
Dialogue: 0,0:20:47.69,0:20:50.28,Default,,0000,0000,0000,,Musen-san, ty mnie uratowałaś?
Dialogue: 0,0:20:53.44,0:20:54.07,Default,,0000,0000,0000,,Dzięku-
Dialogue: 0,0:20:55.88,0:20:57.97,Default,,0000,0000,0000,,Fukune-chan, wiesz co...
Dialogue: 0,0:20:59.98,0:21:01.88,Default,,0000,0000,0000,,W głowie mi się kręci.
Dialogue: 0,0:21:02.48,0:21:05.58,Default,,0000,0000,0000,,To był naprawdę solidny krwotok z nosa.
Dialogue: 0,0:21:08.74,0:21:09.28,Default,,0000,0000,0000,,Um...
Dialogue: 0,0:21:10.26,0:21:12.61,Default,,0000,0000,0000,,N-N-Nar... Narukara-san?
Dialogue: 0,0:21:12.67,0:21:13.59,Default,,0000,0000,0000,,Dlaczego?
Dialogue: 0,0:21:14.19,0:21:16.86,Default,,0000,0000,0000,,Bo wiesz, Musen-san mi powiedziała,
Dialogue: 0,0:21:17.41,0:21:21.11,Default,,0000,0000,0000,,że tak naprawdę to Akutagawa-kun mnie obronił.
Dialogue: 0,0:21:21.66,0:21:22.98,Default,,0000,0000,0000,,Więc tu przyszłam...
Dialogue: 0,0:21:24.33,0:21:26.19,Default,,0000,0000,0000,,Ran ci to powiedziała?
Dialogue: 0,0:21:26.36,0:21:28.63,Default,,0000,0000,0000,,Chciała też, żebym ci to dała.
Dialogue: 0,0:21:30.58,0:21:34.32,Default,,0000,0000,0000,,"Nie zrozum tego źle. Onee-sama jest zawsze uczciwa.
Dialogue: 0,0:21:34.46,0:21:35.47,Default,,0000,0000,0000,,To jedyny powód.
Dialogue: 0,0:21:35.67,0:21:36.44,Default,,0000,0000,0000,,P.S.
Dialogue: 0,0:21:36.79,0:21:39.00,Default,,0000,0000,0000,,Nadal jesteś śmieciem i pisarzem porno,
Dialogue: 0,0:21:39.17,0:21:42.61,Default,,0000,0000,0000,,Ale mimo to myślę, że jesteś, po mnie i jeszcze trzech czy czterech osobach,
Dialogue: 0,0:21:42.61,0:21:44.57,Default,,0000,0000,0000,,odpowiednią osobą dla Fukune-chan."
Dialogue: 0,0:21:45.51,0:21:46.09,Thoughts,,0000,0000,0000,,Ran...
Dialogue: 0,0:21:47.47,0:21:48.24,Default,,0000,0000,0000,,Um...
Dialogue: 0,0:21:48.70,0:21:50.54,Default,,0000,0000,0000,,O-o co chodzi?
Dialogue: 0,0:21:51.08,0:21:51.92,Default,,0000,0000,0000,,Dziękuję.
Dialogue: 0,0:21:53.29,0:21:55.27,Default,,0000,0000,0000,,Nie, to nic takiego.
Dialogue: 0,0:21:55.91,0:21:58.52,Default,,0000,0000,0000,,Czemu zawsze mi pomagasz?
Dialogue: 0,0:21:58.92,0:22:03.03,Default,,0000,0000,0000,,P-ponieważ kocham słuchać, jak grasz na klarnecie!
Dialogue: 0,0:22:03.43,0:22:04.52,Default,,0000,0000,0000,,Kochasz?
Dialogue: 0,0:22:05.21,0:22:07.50,Default,,0000,0000,0000,,Dlatego ćwiczysz każdego dnia, prawda?
Dialogue: 0,0:22:13.36,0:22:15.66,Default,,0000,0000,0000,,Oboje dajmy z siebie wszystko, dobra? Na razie!
Dialogue: 0,0:22:21.69,0:22:22.69,Default,,0000,0000,0000,,Kocha...
