Dialogue: 0,0:22:33.88,0:22:36.73,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.73,0:22:39.30,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.39,0:22:52.64,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.79,0:22:54.22,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.26,0:22:55.49,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.49,0:22:56.87,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:57.09,0:22:58.36,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.51,0:22:59.93,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.97,0:23:02.26,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.58,0:23:05.80,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.88,0:23:08.02,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.13,0:23:10.65,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.67,0:23:12.91,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.17,0:23:14.72,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.74,0:23:15.97,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:16.04,0:23:18.71,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.88,0:23:20.16,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.29,0:23:23.93,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.62,0:23:26.00,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:26.04,0:23:27.47,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.51,0:23:30.14,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.27,0:23:32.60,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.60,0:23:35.32,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.74,0:23:39.58,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.61,0:23:42.15,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.23,0:24:05.69,Introduction/Gauge,,0000,0000,0000,,{\pos(640,250)}Wskaźnik dzisiejszego krwawienia z nosa
Dialogue: 0,0:24:06.73,0:24:08.03,Dialogue,,0000,0000,0000,,Urocze?
Dialogue: 0,0:24:08.03,0:24:09.35,Dialogue,,0000,0000,0000,,Sexy?
Dialogue: 0,0:24:09.35,0:24:12.19,Dialogue,,0000,0000,0000,,Które wolisz?
Dialogue: 0,0:24:12.28,0:24:27.19,Title,,0000,0000,0000,,{\an4\pos(108,247)}W następnym odcinku:\NKocham cię!
Dialogue: 0,0:24:12.76,0:24:14.51,Dialogue,,0000,0000,0000,,Mówi Akutagawa Taketo.
Dialogue: 0,0:24:14.51,0:24:16.06,Dialogue,,0000,0000,0000,,Prawdę mówiąc, ja...
Dialogue: 0,0:24:16.06,0:24:18.04,Dialogue,,0000,0000,0000,,Jestem dziewczyną!
Dialogue: 0,0:24:18.04,0:24:19.91,Dialogue,,0000,0000,0000,,Moja mama i siostra zgłosiły coś, co napisałam
Dialogue: 0,0:24:19.91,0:24:21.32,Dialogue,,0000,0000,0000,,do konkursu, nie pytając mnie o zdanie.
Dialogue: 0,0:24:21.32,0:24:24.07,Dialogue,,0000,0000,0000,,Poza tym nienawidzę pisać o cyckach i tyłkach...
Dialogue: 0,0:24:24.07,0:24:25.45,Dialogue,,0000,0000,0000,,Wcale tego nie lubię!
Dialogue: 0,0:24:25.45,0:24:27.15,Dialogue,,0000,0000,0000,,C-co ty robisz, Onee-chan?
