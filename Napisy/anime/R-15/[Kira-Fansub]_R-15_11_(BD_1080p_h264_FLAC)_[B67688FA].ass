Dialogue: 0,0:01:35.01,0:01:37.21,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:01:46.33,0:01:48.87,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:01:48.98,0:01:50.88,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:01:51.48,0:01:56.40,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:01:57.60,0:02:02.24,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:02:02.78,0:02:07.76,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:02:08.95,0:02:11.51,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:02:11.75,0:02:14.19,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:02:14.59,0:02:15.65,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:02:15.65,0:02:16.72,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:02:16.72,0:02:19.12,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:02:19.42,0:02:21.97,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:02:22.29,0:02:25.01,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:02:25.35,0:02:28.09,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:02:28.16,0:02:31.11,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:02:31.18,0:02:33.29,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:02:33.48,0:02:36.29,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:02:36.59,0:02:39.43,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:02:39.48,0:02:42.17,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:02:42.28,0:02:44.57,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:02:42.78,0:02:45.54,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:44.74,0:02:47.22,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:45.60,0:02:48.36,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:47.54,0:02:50.02,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:48.47,0:02:50.04,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:02:50.39,0:02:53.21,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:03:05.99,0:03:10.04,Title,,0000,0000,0000,,{\fad(800,800)\pos(600,564)}Błękit naszego lata
Dialogue: 0,0:03:12.47,0:03:14.57,Dialogue,,0000,0000,0000,,Jest naprawdę świetna,
Dialogue: 0,0:03:14.57,0:03:16.84,Dialogue,,0000,0000,0000,,ta piosenka napisana przez Iikyoku Kanade-san.
Dialogue: 0,0:03:18.19,0:03:19.59,Dialogue,,0000,0000,0000,,Czegoś brakuje.
Dialogue: 0,0:03:19.63,0:03:21.61,Introduction/Gauge,,0000,0000,0000,,{\fad(480,0)\frz29.329\pos(841,136)}Iikyoku Kanade
Dialogue: 0,0:03:20.70,0:03:21.61,Introduction/Gauge,,0000,0000,0000,,{\fad(710,0)\frz20.13\pos(178,254)}Genialna\NKompozytorka
Dialogue: 0,0:03:21.89,0:03:25.39,Dialogue,,0000,0000,0000,,R-racja. Nadal nie ma tekstu.
Dialogue: 0,0:03:25.94,0:03:31.02,Dialogue,,0000,0000,0000,,Ale czy wybranie Akutagawy-kuna do pisania tekstu na pewno było dobrym pomysłem?
Dialogue: 0,0:03:31.02,0:03:34.92,Dialogue,,0000,0000,0000,,Jest jedyną osobą w naszej klasie, która ma jakiś talent pisarski.
Dialogue: 0,0:03:34.92,0:03:37.00,Dialogue,,0000,0000,0000,,Nawet, jeśli jest genialnym pisarzem porno...
Dialogue: 0,0:03:37.31,0:03:43.31,Dialogue,,0000,0000,0000,,Cóż, z akompaniamentem Narukary-san na pewno wygramy konkurs na najlepszy chór.
Dialogue: 0,0:03:43.31,0:03:45.60,Dialogue,,0000,0000,0000,,Tak swoją drogą, to gdzie oni są?
Dialogue: 0,0:03:56.17,0:04:01.85,Thoughts,,0000,0000,0000,,Obejmować mnie tak znienacka... Co się stało, Narukara-san?
Dialogue: 0,0:04:01.85,0:04:04.66,Thoughts,,0000,0000,0000,,Muszę ją spytać,
Dialogue: 0,0:04:04.66,0:04:07.62,Thoughts,,0000,0000,0000,,bo nigdy tego nie zrozumiem.
Dialogue: 0,0:04:10.32,0:04:16.09,Dialogue,,0000,0000,0000,,Przerwa na lunch, co? Jeszcze nigdy nie wagarowałem.
Dialogue: 0,0:04:16.09,0:04:17.53,Dialogue,,0000,0000,0000,,Ja też.
Dialogue: 0,0:04:18.19,0:04:23.44,Dialogue,,0000,0000,0000,,Nigdy nie zostałam w domu, zamiast iść do szkoły...
Dialogue: 0,0:04:23.44,0:04:25.02,Dialogue,,0000,0000,0000,,...nie mówiąc nikomu.
Dialogue: 0,0:04:26.88,0:04:30.53,Thoughts,,0000,0000,0000,,Nie powinienem się teraz śmiać! Jaki ja jestem głupi!
Dialogue: 0,0:04:39.40,0:04:43.82,Dialogue,,0000,0000,0000,,Następnym przedmiotem jest ulubiony miś Utae-chan!
Dialogue: 0,0:04:43.82,0:04:47.55,Dialogue,,0000,0000,0000,,Przytulała go tyle razy, że każdy fan chciałby go mieć.
Dialogue: 0,0:04:48.16,0:04:49.51,Dialogue,,0000,0000,0000,,Zaczynamy licytację od 5000 jenów!
Dialogue: 0,0:04:49.79,0:04:52.35,Dialogue,,0000,0000,0000,,To idzie tu, a to tam...
Dialogue: 0,0:04:52.35,0:04:57.80,Dialogue,,0000,0000,0000,,Ach! Pomaganie w przenoszeniu rzeczy może być trudniejsze niż faktyczne uczestniczenie w zawodach!
Dialogue: 0,0:05:00.10,0:05:01.42,Dialogue,,0000,0000,0000,,120,000 jenów!
Dialogue: 0,0:05:01.42,0:05:03.78,Dialogue,,0000,0000,0000,,120,000 jenów! Czy ktoś da więcej?
Dialogue: 0,0:05:03.78,0:05:04.81,Dialogue,,0000,0000,0000,,125,000 jenów!
Dialogue: 0,0:05:13.28,0:05:15.14,Dialogue,,0000,0000,0000,,Zaczyna się robić naprawdę gorąco...
Dialogue: 0,0:05:15.14,0:05:16.78,Dialogue,,0000,0000,0000,,133,000 jenów!
Dialogue: 0,0:05:21.75,0:05:23.30,Dialogue,,0000,0000,0000,,Utae-chan?
Dialogue: 0,0:05:24.04,0:05:29.12,Dialogue,,0000,0000,0000,,Klasa 1-2 wykorzystuje Utae-chan do zarabiania pieniędzy na licytacjach, co?
Dialogue: 0,0:05:29.12,0:05:31.16,Dialogue,,0000,0000,0000,,Nam też nieźle idzie.
Dialogue: 0,0:05:32.80,0:05:37.39,Dialogue,,0000,0000,0000,,W końcu u nas genialna programistka i genialny matematyk łączą siły!
Dialogue: 0,0:05:38.80,0:05:40.81,Dialogue,,0000,0000,0000,,C-co do tego...
Dialogue: 0,0:05:42.93,0:05:45.80,Dialogue,,0000,0000,0000,,Co się stało z tą dwójką?
Dialogue: 0,0:05:52.06,0:05:56.68,Dialogue,,0000,0000,0000,,Ze skomplikowanym wzorem do prognoz ekonomicznych od Ritsu
Dialogue: 0,0:05:56.68,0:06:01.82,Dialogue,,0000,0000,0000,,i napisanym przez Ran programem, który natychmiast reaguje na sytuację na światowym rynku,
Dialogue: 0,0:06:02.51,0:06:05.84,Dialogue,,0000,0000,0000,,ta dwójka pracowała razem i w ciągu jednej nocy zostali milionerami!
Dialogue: 0,0:06:06.27,0:06:07.82,Dialogue,,0000,0000,0000,,Udało nam się!
Dialogue: 0,0:06:07.82,0:06:10.35,Dialogue,,0000,0000,0000,,A wymieniliście to na gotówkę?
Dialogue: 0,0:06:11.15,0:06:15.17,Dialogue,,0000,0000,0000,,Zasady rundy drugiej mówią, że trzeba zdobyć gotówkę.
Dialogue: 0,0:06:15.17,0:06:17.07,Dialogue,,0000,0000,0000,,Dane komputerowe...
Dialogue: 0,0:06:17.07,0:06:17.93,Dialogue,,0000,0000,0000,,...się nie liczą.
Dialogue: 0,0:06:25.25,0:06:27.32,Dialogue,,0000,0000,0000,,W drugiej rundzie
Dialogue: 0,0:06:27.32,0:06:29.44,Dialogue,,0000,0000,0000,,klasa 1-2 wygrywa i dostaje 200 punktów.
Dialogue: 0,0:06:29.44,0:06:32.51,Dialogue,,0000,0000,0000,,Klasa 1-1 dostaje 100 punktów.
Dialogue: 0,0:06:32.51,0:06:34.03,Dialogue,,0000,0000,0000,,Na trzecim miejscu
Dialogue: 0,0:06:34.26,0:06:36.90,Dialogue,,0000,0000,0000,,klasa 1-3 nie dostaje nic!
Dialogue: 0,0:06:36.90,0:06:39.52,Dialogue,,0000,0000,0000,,Moja teoria była perfekcyjna.
Dialogue: 0,0:06:39.52,0:06:41.67,Dialogue,,0000,0000,0000,,Ale... Ale...
Dialogue: 0,0:06:42.93,0:06:46.41,Dialogue,,0000,0000,0000,,Teraz naszą jedyną nadzieją jest nadrobienie strat w zawodach chóru!
Dialogue: 0,0:06:46.87,0:06:49.85,Dialogue,,0000,0000,0000,,Nie podoba mi się to, że ten zboczony kretyn pisze tekst...
Dialogue: 0,0:06:50.74,0:06:54.47,Dialogue,,0000,0000,0000,,Ale z klarnetem Fukune-chan jakoś damy radę!
Dialogue: 0,0:06:54.47,0:06:56.43,Dialogue,,0000,0000,0000,,Prawda, Fukune-chan?
Dialogue: 0,0:07:03.92,0:07:07.22,Dialogue,,0000,0000,0000,,Och, nie musisz tego robić.
Dialogue: 0,0:07:07.22,0:07:07.94,Dialogue,,0000,0000,0000,,Nie szkodzi.
Dialogue: 0,0:07:08.46,0:07:11.44,Dialogue,,0000,0000,0000,,Zrobiłeś mi kawę,
Dialogue: 0,0:07:11.44,0:07:13.57,Dialogue,,0000,0000,0000,,więc pomyślałam, że też coś dla ciebie zrobię.
Dialogue: 0,0:07:14.28,0:07:16.06,Dialogue,,0000,0000,0000,,Poczekaj jeszcze chwilę.
Dialogue: 0,0:07:17.13,0:07:20.69,Thoughts,,0000,0000,0000,,Wspaniale. Zupełnie jak nowożeńcy.
Dialogue: 0,0:07:20.69,0:07:24.33,Thoughts,,0000,0000,0000,,Nie, jak para, która dopiero co zaczęła ze sobą chodzić!
Dialogue: 0,0:07:24.53,0:07:25.74,Dialogue,,0000,0000,0000,,Nie czas na to!
Dialogue: 0,0:07:25.74,0:07:27.92,Dialogue,,0000,0000,0000,,Muszę się jej spytać, co się stało.
Dialogue: 0,0:07:27.92,0:07:29.76,Dialogue,,0000,0000,0000,,He? Co to za zapach?
Dialogue: 0,0:07:32.08,0:07:33.63,Dialogue,,0000,0000,0000,,Przypala się!
Dialogue: 0,0:07:41.56,0:07:42.53,Dialogue,,0000,0000,0000,,Nie smakuje ci?
Dialogue: 0,0:07:42.96,0:07:46.67,Dialogue,,0000,0000,0000,,To nie tak. Naprawdę, jest tak dobre, że aż płaczę.
Dialogue: 0,0:07:46.67,0:07:47.99,Dialogue,,0000,0000,0000,,To dobrze!
Dialogue: 0,0:07:47.99,0:07:50.20,Dialogue,,0000,0000,0000,,Pierwszy raz to robiłam.
Dialogue: 0,0:07:50.20,0:07:52.61,Dialogue,,0000,0000,0000,,Jeszcze kiedyś zrobię, dobrze?
Dialogue: 0,0:07:52.61,0:07:55.02,Dialogue,,0000,0000,0000,,J-jasne, kiedyś...
Dialogue: 0,0:07:59.50,0:08:03.12,Dialogue,,0000,0000,0000,,Hej, czy to nie czas na twoje ćwiczenie?
Dialogue: 0,0:08:03.12,0:08:05.21,Dialogue,,0000,0000,0000,,Jeśli chcesz, możesz poćwiczyć tutaj.
Dialogue: 0,0:08:05.21,0:08:06.99,Dialogue,,0000,0000,0000,,Nie, nie trzeba.
Dialogue: 0,0:08:07.82,0:08:09.12,Dialogue,,0000,0000,0000,,Narukara-san?
Dialogue: 0,0:08:11.18,0:08:14.20,Dialogue,,0000,0000,0000,,O, właśnie. Wspominałem o tym wczoraj...
Dialogue: 0,0:08:14.20,0:08:17.41,Dialogue,,0000,0000,0000,,Ale czy na zawodach chóru
Dialogue: 0,0:08:17.41,0:08:19.77,Dialogue,,0000,0000,0000,,mogłabyś zagrać dla nas na klarnecie?
Dialogue: 0,0:08:23.10,0:08:27.12,Dialogue,,0000,0000,0000,,N-na pewno wygramy, jeśli nam pomożesz!
Dialogue: 0,0:08:27.12,0:08:31.51,Dialogue,,0000,0000,0000,,Ale najpierw muszę napisać słowa...
Dialogue: 0,0:08:33.52,0:08:34.26,Dialogue,,0000,0000,0000,,Słowa?
Dialogue: 0,0:08:34.81,0:08:36.70,Dialogue,,0000,0000,0000,,Ty je piszesz?
Dialogue: 0,0:08:36.70,0:08:38.43,Dialogue,,0000,0000,0000,,T-tak.
Dialogue: 0,0:08:38.43,0:08:40.03,Dialogue,,0000,0000,0000,,Wszyscy mnie o to prosili.
Dialogue: 0,0:08:40.64,0:08:43.16,Dialogue,,0000,0000,0000,,Jakie będą? O czym będzie tekst piosenki?
Dialogue: 0,0:08:44.43,0:08:46.32,Dialogue,,0000,0000,0000,,O czym?
Dialogue: 0,0:08:46.32,0:08:47.53,Dialogue,,0000,0000,0000,,Cóż...
Dialogue: 0,0:08:47.84,0:08:50.20,Dialogue,,0000,0000,0000,,Ale ja umiem pisać tylko porno.
Dialogue: 0,0:08:53.15,0:08:55.34,Dialogue,,0000,0000,0000,,Fukune-san z pewnością by zrozumiała.
Dialogue: 0,0:08:55.82,0:08:58.35,Dialogue,,0000,0000,0000,,E-e-ee...
Dialogue: 0,0:09:00.85,0:09:03.86,Dialogue,,0000,0000,0000,,Ee, to będzie piosenka o wiecznej miłości!
Dialogue: 0,0:09:03.86,0:09:05.44,Dialogue,,0000,0000,0000,,I o tym, żeby się nie poddawać!
Dialogue: 0,0:09:05.87,0:09:07.54,Dialogue,,0000,0000,0000,,Albo o przyjaźni!
Dialogue: 0,0:09:07.54,0:09:08.89,Dialogue,,0000,0000,0000,,Coś w tym stylu...
Dialogue: 0,0:09:11.24,0:09:12.45,Dialogue,,0000,0000,0000,,Niesamowite.
Dialogue: 0,0:09:13.68,0:09:16.78,Dialogue,,0000,0000,0000,,Naprawdę {\i1}jesteś{\i0} geniuszem.
Dialogue: 0,0:09:17.67,0:09:21.69,Dialogue,,0000,0000,0000,,Nie to, co ja.
Dialogue: 0,0:09:21.69,0:09:23.07,Dialogue,,0000,0000,0000,,Narukara-san?
Dialogue: 0,0:09:29.67,0:09:31.71,Dialogue,,0000,0000,0000,,To nieprawda.
Dialogue: 0,0:09:31.71,0:09:34.04,Dialogue,,0000,0000,0000,,Masz coś, co jest dla ciebie ważne.
Dialogue: 0,0:09:34.44,0:09:35.36,Dialogue,,0000,0000,0000,,Widzisz?
Dialogue: 0,0:09:39.58,0:09:40.93,Dialogue,,0000,0000,0000,,Akutagawa-kun...
Dialogue: 0,0:09:41.79,0:09:42.56,Dialogue,,0000,0000,0000,,Ja...
Dialogue: 0,0:09:42.99,0:09:45.38,Dialogue,,0000,0000,0000,,Jesteś o wiele lepsza niż ja.
Dialogue: 0,0:09:45.38,0:09:47.47,Dialogue,,0000,0000,0000,,W końcu jesteś geniuszem!
Dialogue: 0,0:09:55.14,0:09:57.38,Dialogue,,0000,0000,0000,,Dlatego się tak nie martw!
Dialogue: 0,0:09:57.38,0:10:00.56,Dialogue,,0000,0000,0000,,Wszyscy liczą na ciebie, że zagrasz na klarnecie.
Dialogue: 0,0:10:00.56,0:10:02.00,Dialogue,,0000,0000,0000,,Mylisz się.
Dialogue: 0,0:10:03.32,0:10:04.98,Dialogue,,0000,0000,0000,,Narukara-san?
Dialogue: 0,0:10:05.61,0:10:07.88,Dialogue,,0000,0000,0000,,Nie jestem geniuszem.
Dialogue: 0,0:10:07.88,0:10:09.72,Dialogue,,0000,0000,0000,,Nie mogę być,
Dialogue: 0,0:10:09.72,0:10:13.16,Dialogue,,0000,0000,0000,,bo muzyka mnie nie wybrała.
Dialogue: 0,0:10:13.16,0:10:14.54,Dialogue,,0000,0000,0000,,Nie jestem geniuszem.
Dialogue: 0,0:10:15.03,0:10:16.41,Dialogue,,0000,0000,0000,,Wcale nie jestem geniuszem!
Dialogue: 0,0:10:16.98,0:10:19.11,Dialogue,,0000,0000,0000,,Nawet z tym klarnetem!
Dialogue: 0,0:10:19.11,0:10:22.35,Dialogue,,0000,0000,0000,,Nigdy mi się to nie podobało, nie lubiłam tego!
Dialogue: 0,0:10:25.74,0:10:27.72,Dialogue,,0000,0000,0000,,Nienawidzę was wszystkich!
Dialogue: 0,0:10:42.73,0:10:44.51,Dialogue,,0000,0000,0000,,Fukune-san?
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\frz14.808\frx16\fry332\pos(133,308)}Narukara
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\frz14.808\frx16\fry332\pos(343,249)}Fukune
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\frz14.808\frx16\fry332\pos(555,191)}Odchodzi
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\3c&H832E2F&\frz14\frx22\fry326\pos(113,528)}z
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\3c&H832E2F&\frz12.746\frx18\fry332\pos(289,484)}Akademii
Dialogue: 0,0:10:57.35,0:11:00.06,Article,,0000,0000,0000,,{\be1\3c&H832E2F&\frx20\fry338\frz13.361\pos(555,420)}Inspiracji?
Dialogue: 0,0:11:00.64,0:11:02.51,Dialogue,,0000,0000,0000,,Co to ma być?
Dialogue: 0,0:11:03.09,0:11:07.25,Dialogue,,0000,0000,0000,,Narukara Fukune-san, genialna klarnecistka z klasy 1-3
Dialogue: 0,0:11:07.25,0:11:10.46,Dialogue,,0000,0000,0000,,zamierza odejść z Akademii Inspiracji.
Dialogue: 0,0:11:10.46,0:11:15.09,Dialogue,,0000,0000,0000,,Wygląda na to, że wpływ na tą decyzję miał jej ojciec,
Dialogue: 0,0:11:15.09,0:11:18.64,Dialogue,,0000,0000,0000,,Narukara Fukuzoushi, jeden z najlepszych klarnecistów na świecie.
Dialogue: 0,0:11:18.64,0:11:20.91,Dialogue,,0000,0000,0000,,Narukara-san przenosi się do innej szkoły...
Dialogue: 0,0:11:20.91,0:11:23.04,Dialogue,,0000,0000,0000,,To dużo poważniejsza sprawa niż ten cały chór.
Dialogue: 0,0:11:24.04,0:11:25.22,Dialogue,,0000,0000,0000,,Taketo?
Dialogue: 0,0:11:26.00,0:11:28.49,Door Sign,,0000,0000,0000,,{\be1\pos(840,352)}Kółko\NDziennikarskie
Dialogue: 0,0:11:26.40,0:11:28.46,Dialogue,,0000,0000,0000,,Czy to, co jest napisane w tym artykule, to prawda?
Dialogue: 0,0:11:28.75,0:11:31.48,Dialogue,,0000,0000,0000,,To tylko plotka, ale tak.
Dialogue: 0,0:11:31.74,0:11:37.39,Dialogue,,0000,0000,0000,,Ale skoro jest geniuszem, nauka za granicą jest dla niej lepsza.
Dialogue: 0,0:11:37.97,0:11:39.66,Dialogue,,0000,0000,0000,,Lepsza dla niej?
Dialogue: 0,0:11:39.83,0:11:42.21,Dialogue,,0000,0000,0000,,Nie mów takich okropnych rzeczy...
Dialogue: 0,0:11:43.82,0:11:44.97,Dialogue,,0000,0000,0000,,...proszę.
Dialogue: 0,0:11:45.29,0:11:47.55,Dialogue,,0000,0000,0000,,Okropne, co?
Dialogue: 0,0:11:47.55,0:11:49.99,Dialogue,,0000,0000,0000,,A wiedziałeś o tym?
Dialogue: 0,0:11:50.43,0:11:55.10,Dialogue,,0000,0000,0000,,Wczorajszy koncert Narukary-san był kompletną klapą.
Dialogue: 0,0:11:59.73,0:12:01.39,Dialogue,,0000,0000,0000,,W połowie występu
Dialogue: 0,0:12:01.39,0:12:04.26,Dialogue,,0000,0000,0000,,z jakiegoś powodu nagle przestała grać.
Dialogue: 0,0:12:04.26,0:12:07.13,Dialogue,,0000,0000,0000,,Nie było innego wyjścia, jak tylko opuścić kurtynę.
Dialogue: 0,0:12:12.62,0:12:16.00,Dialogue,,0000,0000,0000,,Po tym wydarzeniu nie wróciła do Akademika.
Dialogue: 0,0:12:16.29,0:12:18.42,Dialogue,,0000,0000,0000,,Poszła i ukryła się gdzieś.
Dialogue: 0,0:12:19.16,0:12:21.23,Dialogue,,0000,0000,0000,,Prawdopodobnie okropnie się po tym czuła
Dialogue: 0,0:12:21.23,0:12:24.44,Dialogue,,0000,0000,0000,,i chciała po prostu, żeby ktoś ją pocieszył.
Dialogue: 0,0:12:28.66,0:12:29.93,Dialogue,,0000,0000,0000,,Fukune-chan!
Dialogue: 0,0:12:29.93,0:12:31.05,Dialogue,,0000,0000,0000,,To nieprawda, co nie?
Dialogue: 0,0:12:31.05,0:12:33.40,Dialogue,,0000,0000,0000,,Nie odchodzisz, prawda?
Dialogue: 0,0:12:33.40,0:12:34.69,Dialogue,,0000,0000,0000,,Prawda? Prawda?
Dialogue: 0,0:12:35.21,0:12:36.65,Dialogue,,0000,0000,0000,,Fukune-chan!
Dialogue: 0,0:12:38.02,0:12:39.92,Dialogue,,0000,0000,0000,,Brak odpowiedzi, co?
Dialogue: 0,0:12:41.01,0:12:42.44,Dialogue,,0000,0000,0000,,W takim razie wedrę się tam siłą!
Dialogue: 0,0:12:44.80,0:12:46.84,Dialogue,,0000,0000,0000,,Daj spokój, Ran! Opanuj się!
Dialogue: 0,0:12:46.84,0:12:48.33,Dialogue,,0000,0000,0000,,Ale dlaczego tak nagle?
Dialogue: 0,0:12:48.33,0:12:52.35,Dialogue,,0000,0000,0000,,Dlaczego? Nikt jej nie widział od jej koncertu.
Dialogue: 0,0:12:52.95,0:12:56.22,Dialogue,,0000,0000,0000,,Jakby tak o tym pomyśleć, Akutagawy-kuna też wczoraj nie widziałam.
Dialogue: 0,0:12:56.77,0:12:58.21,Dialogue,,0000,0000,0000,,Taketo?
Dialogue: 0,0:13:03.40,0:13:08.48,Dialogue,,0000,0000,0000,,Gdybym wiedział, co się dzieje z Narukarą-san...
Dialogue: 0,0:13:09.14,0:13:12.47,Dialogue,,0000,0000,0000,,Gdybyś wiedział, co się dzieje?
Dialogue: 0,0:13:15.86,0:13:18.38,Dialogue,,0000,0000,0000,,Co się z nią stało?
Dialogue: 0,0:13:20.71,0:13:22.92,Dialogue,,0000,0000,0000,,Była w twoim pokoju?!
Dialogue: 0,0:13:25.10,0:13:29.84,Dialogue,,0000,0000,0000,,W momencie, gdy czuła się okropnie, wybrała ciebie, nie mnie.
Dialogue: 0,0:13:29.84,0:13:30.70,Dialogue,,0000,0000,0000,,Fukune-chan...
Dialogue: 0,0:13:31.73,0:13:32.62,Dialogue,,0000,0000,0000,,Ran...
Dialogue: 0,0:13:44.34,0:13:45.14,Dialogue,,0000,0000,0000,,Jednakże,
Dialogue: 0,0:13:46.06,0:13:48.96,Dialogue,,0000,0000,0000,,nie wierzę, że tak po prostu odeszła ze szkoły.
Dialogue: 0,0:13:48.96,0:13:50.80,Dialogue,,0000,0000,0000,,Że po prostu zniknęła!
Dialogue: 0,0:13:51.00,0:13:53.18,Dialogue,,0000,0000,0000,,Nie mogę w to uwierzyć!
Dialogue: 0,0:13:53.52,0:13:56.51,Dialogue,,0000,0000,0000,,Dlaczego? Dlaczego tak się stało?
Dialogue: 0,0:13:56.51,0:13:57.54,Dialogue,,0000,0000,0000,,Co mamy robić?
Dialogue: 0,0:13:58.03,0:14:00.85,Dialogue,,0000,0000,0000,,Już kompletnie nie wiem, co się dzieje!
Dialogue: 0,0:14:00.85,0:14:02.63,Dialogue,,0000,0000,0000,,Zamierzam napisać ten tekst.
Dialogue: 0,0:14:02.63,0:14:04.66,Dialogue,,0000,0000,0000,,He? O czym ty mówisz?
Dialogue: 0,0:14:04.66,0:14:05.70,Dialogue,,0000,0000,0000,,To nasz najmniejszy problem.
Dialogue: 0,0:14:06.53,0:14:07.45,Dialogue,,0000,0000,0000,,Muszę to zrobić.
Dialogue: 0,0:14:09.11,0:14:11.75,Dialogue,,0000,0000,0000,,To niemożliwe, żeby Narukara-san nienawidziła muzykę.
Dialogue: 0,0:14:11.75,0:14:14.22,Dialogue,,0000,0000,0000,,Albo, że nienawidzi swojego klarnetu.
Dialogue: 0,0:14:14.22,0:14:17.64,Dialogue,,0000,0000,0000,,Możliwe, że teraz zamyka drzwi do swojego serca...
Dialogue: 0,0:14:17.64,0:14:20.34,Dialogue,,0000,0000,0000,,Ale muzyka na pewno może je otworzyć!
Dialogue: 0,0:14:20.34,0:14:22.95,Dialogue,,0000,0000,0000,,Musimy postawić wszystko na ten chór!
Dialogue: 0,0:14:22.95,0:14:25.19,Dialogue,,0000,0000,0000,,Pokażę jej, kim naprawdę jestem.
Dialogue: 0,0:14:25.19,0:14:27.20,Dialogue,,0000,0000,0000,,Napiszę ten tekst porno!
Dialogue: 0,0:14:30.85,0:14:32.02,Dialogue,,0000,0000,0000,,Może masz rację.
Dialogue: 0,0:14:32.02,0:14:35.93,Dialogue,,0000,0000,0000,,Niechętnie to przyznaję, ale z twoimi zdolnościami do pisania porno,
Dialogue: 0,0:14:35.93,0:14:37.96,Dialogue,,0000,0000,0000,,możesz napisać coś niesamowitego.
Dialogue: 0,0:14:38.60,0:14:40.55,Dialogue,,0000,0000,0000,,Zamierzam powiedzieć Narukarze-san...
Dialogue: 0,0:14:40.55,0:14:44.60,Dialogue,,0000,0000,0000,,Poprzez tekst tej piosenki powiem jej o swoich... To znaczy o {\i1}naszych{\i0} uczuciach!
Dialogue: 0,0:14:45.08,0:14:46.84,Dialogue,,0000,0000,0000,,Hej, Taketo!
Dialogue: 0,0:14:46.84,0:14:50.11,Dialogue,,0000,0000,0000,,Co wasza dwójka robi tu sama?
Dialogue: 0,0:14:50.25,0:14:52.61,Dialogue,,0000,0000,0000,,Zaczynamy. Wszyscy.
Dialogue: 0,0:14:54.16,0:14:55.99,Dialogue,,0000,0000,0000,,Ale najpierw...
Dialogue: 0,0:14:58.06,0:14:59.44,Dialogue,,0000,0000,0000,,Trzymaj to.
Dialogue: 0,0:14:59.44,0:15:01.74,Dialogue,,0000,0000,0000,,U-um, dobra...
Dialogue: 0,0:15:07.25,0:15:09.00,Dialogue,,0000,0000,0000,,To zapłata za trzymanie jej klarnetu.
Dialogue: 0,0:15:15.80,0:15:20.28,Dialogue,,0000,0000,0000,,Ale czy zwycięstwo bez tekstu i muzyki nie jest niemożliwe?
Dialogue: 0,0:15:21.54,0:15:23.84,Dialogue,,0000,0000,0000,,Geniusze nie znają słowa "niemożliwe"!
Dialogue: 0,0:15:23.84,0:15:26.31,Dialogue,,0000,0000,0000,,Nie denerwuje was przegrywanie?
Dialogue: 0,0:15:27.69,0:15:29.75,Dialogue,,0000,0000,0000,,Chyba nie mamy wyboru.
Dialogue: 0,0:15:29.75,0:15:32.31,Dialogue,,0000,0000,0000,,Jak tak dalej pójdzie, nie będziemy mogli nazywać się geniuszami.
Dialogue: 0,0:15:33.95,0:15:35.29,Dialogue,,0000,0000,0000,,Racja.
Dialogue: 0,0:15:37.48,0:15:38.40,Dialogue,,0000,0000,0000,,Biorę się za pisanie!
Dialogue: 0,0:15:39.00,0:15:41.78,Dialogue,,0000,0000,0000,,Z pasją, jaką wkładam w swoje opowiadania pornograficzne,
Dialogue: 0,0:15:41.78,0:15:45.40,Dialogue,,0000,0000,0000,,napisze tekst, który będzie dumny, silny i wzniosły!
Dialogue: 0,0:15:58.40,0:15:59.61,Dialogue,,0000,0000,0000,,Nie potrafię.
Dialogue: 0,0:15:59.90,0:16:02.57,Dialogue,,0000,0000,0000,,Jesteś geniuszem czy nie? Jak możesz bać się napisać tekst piosenki?
Dialogue: 0,0:16:02.57,0:16:05.64,Dialogue,,0000,0000,0000,,Może nie nadajesz się do pisania takich rzeczy? Nie, to niemożliwe!
Dialogue: 0,0:16:06.44,0:16:08.37,Dialogue,,0000,0000,0000,,Ale gdyby to było opowiadanie porno...
Dialogue: 0,0:16:10.89,0:16:13.05,Dialogue,,0000,0000,0000,,Otwórz oczy...
Dialogue: 0,0:16:13.05,0:16:15.63,Dialogue,,0000,0000,0000,,Na nowe wyżyny, nowe rozkosze...
Dialogue: 0,0:16:15.63,0:16:17.15,Dialogue,,0000,0000,0000,,Na niepohamowaną pasję.
Dialogue: 0,0:16:18.44,0:16:20.17,Dialogue,,0000,0000,0000,,Proszę, powiedz mi.
Dialogue: 0,0:16:20.17,0:16:24.39,Dialogue,,0000,0000,0000,,Pokaż mi, czym jest prawdziwa miłość poprzez swoje zdolności pisarskie.
Dialogue: 0,0:16:25.74,0:16:29.35,Dialogue,,0000,0000,0000,,Chcę, żebyś wypełnił mnie swoimi emocjami.
Dialogue: 0,0:16:29.35,0:16:30.99,Dialogue,,0000,0000,0000,,Wypełnij mnie...
Dialogue: 0,0:16:30.99,0:16:33.92,Dialogue,,0000,0000,0000,,Ach, czuję to! Przepełnia mnie!
Dialogue: 0,0:16:49.85,0:16:51.31,Dialogue,,0000,0000,0000,,A jednak mogę to napisać...
Dialogue: 0,0:16:53.64,0:16:54.82,Dialogue,,0000,0000,0000,,Narukara-san.
Dialogue: 0,0:16:55.22,0:16:57.00,Dialogue,,0000,0000,0000,,Poczekaj tylko, Narukara-san.
Dialogue: 0,0:16:57.00,0:16:58.81,Dialogue,,0000,0000,0000,,Piszę to dla ciebie.
Dialogue: 0,0:17:01.68,0:17:03.31,Thoughts,,0000,0000,0000,,O czym będzie tekst piosenki?
Dialogue: 0,0:17:10.49,0:17:13.65,Thoughts,,0000,0000,0000,,Naprawdę jesteś geniuszem, Akutagawa-kun.
Dialogue: 0,0:17:15.54,0:17:18.82,Thoughts,,0000,0000,0000,,Nie to, co ja.
Dialogue: 0,0:17:18.82,0:17:22.18,Thoughts,,0000,0000,0000,,Hej, co tam piszesz?
Dialogue: 0,0:17:32.57,0:17:35.67,Dialogue,,0000,0000,0000,,Słyszałam, że Akutagawa-kun pisze opowiadania porno.
Dialogue: 0,0:17:36.16,0:17:39.20,Dialogue,,0000,0000,0000,,Obrzydliwe... Lepiej trzymajmy się od niego z daleka.
Dialogue: 0,0:17:39.20,0:17:43.25,Dialogue,,0000,0000,0000,,T-to nie tak! Pornografia to sztuka!
Dialogue: 0,0:17:43.25,0:17:46.12,Dialogue,,0000,0000,0000,,Piszę historie o miłości!
Dialogue: 0,0:17:47.38,0:17:48.19,Dialogue,,0000,0000,0000,,Nienawidzę cię.
Dialogue: 0,0:17:57.43,0:17:59.27,Dialogue,,0000,0000,0000,,Co ja wyprawiam?
Dialogue: 1,0:18:00.16,0:18:02.66,Newspaper Circle,,0000,0000,0000,,{\pos(1009,301)}Kółko\N\NDziennikarskie\N\N\NAkademii\N\NInspiracji
Dialogue: 0,0:18:00.16,0:18:02.66,Newspaper Circle,,0000,0000,0000,,{\an3\pos(996,646)\be1\fnFansub Block\be1\bord0\fs300\c&H446481&\frz269.199\clip(m 993 654 l 1277 634 1277 0 938 2)}AAA
Dialogue: 0,0:18:05.96,0:18:07.97,Dialogue,,0000,0000,0000,,Gdybym to była ja,
Dialogue: 0,0:18:07.97,0:18:10.72,Dialogue,,0000,0000,0000,,mogłabym zostać z tobą na zawsze,
Dialogue: 0,0:18:10.72,0:18:12.13,Dialogue,,0000,0000,0000,,Taketo-kun.
Dialogue: 0,0:18:12.17,0:18:13.30,Phone,,0000,0000,0000,,{\frz21.01\pos(665,346)}Akutagawa Taketo-kun
Dialogue: 0,0:18:13.30,0:18:14.16,Phone,,0000,0000,0000,,{\frz21.01\c&H666896&\pos(665,346)}Akutagawa Taketo-kun
Dialogue: 0,0:18:17.04,0:18:21.63,Thoughts,,0000,0000,0000,,Tak. Z jakiegoś powodu czuję się lepiej, słysząc to!
Dialogue: 1,0:18:26.19,0:18:30.69,Newspaper Circle,,0000,0000,0000,,{\pos(1009,301)}Kółko\N\NDziennikarskie\N\N\NAkademii\N\NInspiracji
Dialogue: 0,0:18:26.19,0:18:30.69,Newspaper Circle,,0000,0000,0000,,{\an3\pos(996,646)\be1\fnFansub Block\be1\bord0\fs300\c&H446481&\frz269.199\clip(m 993 654 l 1277 634 1277 0 938 2)}AAA
Dialogue: 0,0:18:26.71,0:18:30.65,Dialogue,,0000,0000,0000,,Staję się okropną dziewczyną.
Dialogue: 0,0:18:31.85,0:18:35.90,Dialogue,,0000,0000,0000,,Naprzód! Naprzód! Utae!
Dialogue: 0,0:18:36.01,0:18:39.46,Dialogue,,0000,0000,0000,,Dasz radę! Dasz radę, Utae!
Dialogue: 0,0:18:39.46,0:18:42.99,Dialogue,,0000,0000,0000,,Walcz! Walcz! Utae!
Dialogue: 0,0:18:47.30,0:18:48.99,Dialogue,,0000,0000,0000,,Ałałała..
Dialogue: 0,0:18:49.42,0:18:51.69,Dialogue,,0000,0000,0000,,Co ty robisz, Katsuyo-san?
Dialogue: 0,0:18:51.69,0:18:53.90,Dialogue,,0000,0000,0000,,A jak myślisz?
Dialogue: 0,0:18:53.90,0:18:55.25,Dialogue,,0000,0000,0000,,Wspieram cię!
Dialogue: 0,0:18:55.65,0:18:56.77,Dialogue,,0000,0000,0000,,Mnie?
Dialogue: 0,0:18:59.21,0:19:03.52,Dialogue,,0000,0000,0000,,Wyglądałaś, jakbyś była samotna i bardzo czymś zmartwiona.
Dialogue: 0,0:19:03.52,0:19:05.24,Dialogue,,0000,0000,0000,,Dlatego postanowiłam cię podnieść na duchu!
Dialogue: 0,0:19:05.84,0:19:09.46,Dialogue,,0000,0000,0000,,Cokolwiek by się nie działo, powinnaś być szczera wobec siebie.
Dialogue: 0,0:19:09.46,0:19:10.72,Dialogue,,0000,0000,0000,,To najlepsze wyjście!
Dialogue: 0,0:19:10.89,0:19:14.43,Dialogue,,0000,0000,0000,,Naprzód! Naprzód! Utae!
Dialogue: 0,0:19:14.43,0:19:17.70,Dialogue,,0000,0000,0000,,Walcz! Dasz radę! Naprzód!
Dialogue: 0,0:19:17.70,0:19:21.14,Dialogue,,0000,0000,0000,,Rozchmurz się, Utae-chan!
Dialogue: 0,0:19:21.14,0:19:23.76,Dialogue,,0000,0000,0000,,Wyrzuć swe łzy w dal!
Dialogue: 0,0:19:31.39,0:19:37.13,Dialogue,,0000,0000,0000,,Tak jak myślałem, szkoła nie jest ci potrzebna.
Dialogue: 0,0:19:37.13,0:19:38.31,Dialogue,,0000,0000,0000,,Tato...
Dialogue: 0,0:19:39.03,0:19:43.74,Dialogue,,0000,0000,0000,,Musisz być geniuszem w każdej chwili, w każdej sytuacji.
Dialogue: 0,0:19:43.74,0:19:46.55,Dialogue,,0000,0000,0000,,Tego wymaga gra na klarnecie.
Dialogue: 0,0:19:46.55,0:19:48.73,Dialogue,,0000,0000,0000,,To jest powód, dla którego istniejesz.
Dialogue: 0,0:19:56.45,0:20:00.27,Thoughts,,0000,0000,0000,,Kocham twoją muzykę.
Dialogue: 0,0:20:14.54,0:20:16.84,Dialogue,,0000,0000,0000,,"Miłość nigdy nie przegra."
Dialogue: 0,0:20:17.41,0:20:20.60,Dialogue,,0000,0000,0000,,"Daj z siebie wszystko, a nadzieja przyjdzie do ciebie."
Dialogue: 0,0:20:20.60,0:20:21.83,Dialogue,,0000,0000,0000,,"Nie poddawaj się."
Dialogue: 0,0:20:22.52,0:20:25.85,Dialogue,,0000,0000,0000,,"Marzenia się spełniają."
Dialogue: 0,0:20:26.80,0:20:29.84,Dialogue,,0000,0000,0000,,"Będę zawsze przy tobie."
Dialogue: 0,0:20:32.68,0:20:36.59,Dialogue,,0000,0000,0000,,Mógłbym napisać dowolny tekst w tym stylu.
Dialogue: 0,0:20:36.59,0:20:37.36,Dialogue,,0000,0000,0000,,To powinno...
Dialogue: 0,0:20:37.88,0:20:38.86,Thoughts,,0000,0000,0000,,Nienawidzę cię.
Dialogue: 0,0:20:39.52,0:20:44.02,Dialogue,,0000,0000,0000,,To powinno sprawić, że nie znienawidzi mnie bardziej.
Dialogue: 0,0:20:47.56,0:20:49.28,Dialogue,,0000,0000,0000,,Podoba mi się ten wyraz twarzy.
Dialogue: 0,0:20:49.28,0:20:51.20,Dialogue,,0000,0000,0000,,Tego właśnie potrzebuję do swoich zdjęć.
Dialogue: 0,0:20:51.89,0:20:53.21,Dialogue,,0000,0000,0000,,Raika...
Dialogue: 0,0:20:53.53,0:20:55.71,Dialogue,,0000,0000,0000,,Najwyższa obrzydliwość...
Dialogue: 0,0:20:59.12,0:21:02.86,Dialogue,,0000,0000,0000,,Mężczyzna, który odrzuca samego siebie, by uciec od wszystkiego.
Dialogue: 0,0:21:02.86,0:21:04.92,Dialogue,,0000,0000,0000,,I jak? Paskudne, prawda?
Dialogue: 0,0:21:08.28,0:21:09.89,Dialogue,,0000,0000,0000,,Ja...
Dialogue: 0,0:21:09.89,0:21:11.84,Dialogue,,0000,0000,0000,,Nie mam wyboru!
Dialogue: 0,0:21:12.19,0:21:15.34,Dialogue,,0000,0000,0000,,Wiesz, jaka jest najpaskudniejsza rzecz na świecie?
Dialogue: 0,0:21:15.34,0:21:17.24,Dialogue,,0000,0000,0000,,Hipokryta.
Dialogue: 0,0:21:18.45,0:21:19.22,Dialogue,,0000,0000,0000,,Hipokryta...
Dialogue: 0,0:21:20.48,0:21:23.76,Dialogue,,0000,0000,0000,,Ten, kto mówi o otwieraniu drzwi do serc innych,
Dialogue: 0,0:21:23.76,0:21:26.34,Dialogue,,0000,0000,0000,,a zamyka swoje własne.
Dialogue: 0,0:21:26.34,0:21:28.38,Dialogue,,0000,0000,0000,,Ten, który twierdzi, że chce komuś pomóc,
Dialogue: 0,0:21:28.38,0:21:31.36,Dialogue,,0000,0000,0000,,ale tak naprawdę mówi to, co jest dla niego wygodne.
Dialogue: 0,0:21:31.36,0:21:33.63,Dialogue,,0000,0000,0000,,A na końcu
Dialogue: 0,0:21:33.63,0:21:36.39,Dialogue,,0000,0000,0000,,zostają mu tylko wymówki.
Dialogue: 0,0:21:37.68,0:21:40.69,Dialogue,,0000,0000,0000,,Świetny wyraz twarzy. Cudowny.
Dialogue: 0,0:21:40.69,0:21:43.39,Dialogue,,0000,0000,0000,,Okropność warta tytułu "Hipokryta".
Dialogue: 0,0:21:44.23,0:21:45.14,Dialogue,,0000,0000,0000,,Nie.
Dialogue: 0,0:21:46.46,0:21:48.70,Dialogue,,0000,0000,0000,,To nie jestem ja.
Dialogue: 0,0:21:48.70,0:21:50.14,Dialogue,,0000,0000,0000,,Prawdziwy ja...
Dialogue: 0,0:21:52.55,0:21:53.70,Dialogue,,0000,0000,0000,,Ja...
Dialogue: 0,0:21:55.74,0:21:58.18,Dialogue,,0000,0000,0000,,Ja wcale nie jestem taki!
Dialogue: 0,0:22:06.27,0:22:11.24,Dialogue,,0000,0000,0000,,Chyba poniosłam porażkę jako fotograf, zbytnio spoufalając się z obiektem.
Dialogue: 0,0:22:11.24,0:22:12.70,Dialogue,,0000,0000,0000,,Jestem beznadziejna.
Dialogue: 0,0:22:13.88,0:22:18.07,Dialogue,,0000,0000,0000,,To chyba ja jestem {\i1}najpaskudniejsza{\i0} ze wszystkich...
