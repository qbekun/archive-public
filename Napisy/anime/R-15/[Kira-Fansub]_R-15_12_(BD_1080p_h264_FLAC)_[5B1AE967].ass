Dialogue: 0,0:00:00.99,0:00:03.19,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:00:12.31,0:00:14.85,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:00:14.96,0:00:16.86,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:00:17.46,0:00:22.38,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:00:23.58,0:00:28.22,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:00:28.76,0:00:33.74,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:00:34.93,0:00:37.49,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:00:37.73,0:00:40.17,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:00:40.57,0:00:41.63,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:00:41.63,0:00:42.70,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:00:42.70,0:00:45.10,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:00:45.40,0:00:47.95,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:00:48.27,0:00:50.99,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:00:51.33,0:00:54.07,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:00:54.14,0:00:57.09,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:00:57.16,0:00:59.27,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:00:59.46,0:01:02.27,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:01:02.57,0:01:05.41,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:01:05.46,0:01:08.15,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:01:08.26,0:01:10.55,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:01:08.76,0:01:11.52,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:10.72,0:01:13.20,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:11.58,0:01:14.34,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:13.52,0:01:16.00,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:14.45,0:01:16.02,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:01:16.37,0:01:19.19,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:01:37.00,0:01:38.40,Thoughts,,0000,0000,0000,,To nie jestem ja!
Dialogue: 0,0:01:57.38,0:01:58.84,Thoughts,,0000,0000,0000,,Wszyscy dają z siebie wszystko.
Dialogue: 0,0:01:58.84,0:02:00.67,Thoughts,,0000,0000,0000,,Nie mogę być jedynym, który ucieka!
Dialogue: 0,0:02:02.01,0:02:07.09,Title,,0000,0000,0000,,{\fad(800,800)\pos(1152,558)}Kocham cię!!
Dialogue: 0,0:02:05.27,0:02:06.60,Thoughts,,0000,0000,0000,,Nie chcę, by się dowiedziała.
Dialogue: 0,0:02:06.60,0:02:08.17,Thoughts,,0000,0000,0000,,Nie chcę, żeby mnie nienawidziła!
Dialogue: 0,0:02:08.17,0:02:10.84,Thoughts,,0000,0000,0000,,Ale czy to oznacza, że mam pozwolić jej cierpieć?
Dialogue: 0,0:02:11.96,0:02:14.49,Thoughts,,0000,0000,0000,,Czy ja czasem nie próbuję zignorować jej prawdziwych uczuć
Dialogue: 0,0:02:14.95,0:02:17.48,Thoughts,,0000,0000,0000,,i okłamywać samego siebie, żeby tylko poczuć się lepiej?
Dialogue: 0,0:02:18.34,0:02:19.71,Thoughts,,0000,0000,0000,,Biorę się za pisanie!
Dialogue: 0,0:02:25.11,0:02:26.88,Thoughts,,0000,0000,0000,,Będę pisał, by ona znów mogła się śmiać.
Dialogue: 0,0:02:27.15,0:02:29.30,Thoughts,,0000,0000,0000,,Będę pisał, by ona znów mogła grać na swoim klarnecie.
Dialogue: 0,0:02:29.30,0:02:32.35,Thoughts,,0000,0000,0000,,Tym razem zrobię, co mogę...
Dialogue: 0,0:02:32.35,0:02:34.07,Thoughts,,0000,0000,0000,,To, co tylko ja mogę zrobić!
Dialogue: 0,0:02:34.79,0:02:36.39,Thoughts,,0000,0000,0000,,Będę pisał...
Dialogue: 0,0:02:36.94,0:02:37.88,Thoughts,,0000,0000,0000,,...do samego końca!
Dialogue: 0,0:02:44.89,0:02:48.05,Thoughts,,0000,0000,0000,,Kocham słuchać twojego klarnetu!
Dialogue: 0,0:02:49.28,0:02:52.24,Dialogue,,0000,0000,0000,,Nic nie mogę zrobić.
Dialogue: 0,0:02:52.24,0:02:54.71,Dialogue,,0000,0000,0000,,Nic już nie wiem.
Dialogue: 0,0:02:54.71,0:02:56.00,Dialogue,,0000,0000,0000,,Więc dlaczego?
Dialogue: 0,0:03:10.59,0:03:12.25,Dialogue,,0000,0000,0000,,Nie!
Dialogue: 0,0:03:12.25,0:03:13.77,Dialogue,,0000,0000,0000,,To nie to!
Dialogue: 0,0:03:17.93,0:03:19.03,Thoughts,,0000,0000,0000,,Nienawidzę!
Dialogue: 0,0:03:24.94,0:03:26.15,Dialogue,,0000,0000,0000,,Narukara-san...
Dialogue: 0,0:03:27.61,0:03:29.45,Dialogue,,0000,0000,0000,,Nigdy więcej cię nie okłamię.
Dialogue: 0,0:03:29.45,0:03:31.83,Dialogue,,0000,0000,0000,,Ja... Prawdziwy ja...
Dialogue: 0,0:03:49.05,0:03:51.84,Dialogue,,0000,0000,0000,,Akutagawa-kun!
Dialogue: 0,0:04:01.74,0:04:02.98,Dialogue,,0000,0000,0000,,Przepraszam.
Dialogue: 0,0:04:02.98,0:04:04.36,Dialogue,,0000,0000,0000,,Nie rozumiem.
Dialogue: 0,0:04:08.23,0:04:09.41,Dialogue,,0000,0000,0000,,Taketo-kun...
Dialogue: 0,0:04:19.83,0:04:22.87,Dialogue,,0000,0000,0000,,Muszę się pośpieszyć i znaleźć Narukarę-san.
Dialogue: 0,0:04:26.52,0:04:29.42,Dialogue,,0000,0000,0000,,Wykrwawiam się...
Dialogue: 0,0:04:44.09,0:04:46.36,Dialogue,,0000,0000,0000,,Proszę, weź to.
Dialogue: 0,0:04:46.36,0:04:49.57,Dialogue,,0000,0000,0000,,Daj to Narukarze-san z klasy 1-3.
Dialogue: 0,0:04:53.94,0:04:56.06,Dialogue,,0000,0000,0000,,Dziękuję... ci.
Dialogue: 0,0:05:05.28,0:05:08.00,Dialogue,,0000,0000,0000,,Czas na ostateczne rozstrzygnięcie naszego turnieju!
Dialogue: 0,0:05:09.61,0:05:11.39,Dialogue,,0000,0000,0000,,To już ostatnia runda.
Dialogue: 0,0:05:11.59,0:05:14.84,Dialogue,,0000,0000,0000,,Pokażcie nam swój geniusz.
Dialogue: 0,0:05:20.26,0:05:22.30,Dialogue,,0000,0000,0000,,Zaczniemy od...
Dialogue: 0,0:05:22.30,0:05:24.08,Dialogue,,0000,0000,0000,,...ceremonii otwarcia!
Dialogue: 0,0:05:27.29,0:05:28.56,Dialogue,,0000,0000,0000,,Jej!
Dialogue: 0,0:05:37.94,0:05:39.86,Dialogue,,0000,0000,0000,,Jak długo jeszcze masz zamiar się wygłupiać?
Dialogue: 0,0:05:42.80,0:05:43.97,Dialogue,,0000,0000,0000,,Idziemy.
Dialogue: 0,0:05:50.26,0:05:52.36,Dialogue,,0000,0000,0000,,Zbliża się czas naszego występu.
Dialogue: 0,0:05:52.84,0:05:55.31,Dialogue,,0000,0000,0000,,Co ten zbok wyprawia?!
Dialogue: 0,0:05:55.31,0:05:56.52,Dialogue,,0000,0000,0000,,Cz-czyżby on...
Dialogue: 0,0:05:56.52,0:05:58.53,Dialogue,,0000,0000,0000,,Taketo przyjdzie! Jestem tego pewien!
Dialogue: 0,0:05:58.53,0:06:00.54,Dialogue,,0000,0000,0000,,Oczywiście!
Dialogue: 0,0:06:00.54,0:06:02.09,Dialogue,,0000,0000,0000,,Ała!
Dialogue: 0,0:06:08.75,0:06:09.64,Dialogue,,0000,0000,0000,,Akutagawa-kun!
Dialogue: 0,0:06:10.87,0:06:11.65,Dialogue,,0000,0000,0000,,Taketo!
Dialogue: 0,0:06:17.88,0:06:20.58,Dialogue,,0000,0000,0000,,Taketo, wiedziałem, że przyjdziesz!
Dialogue: 0,0:06:20.58,0:06:23.65,Dialogue,,0000,0000,0000,,Uch, czekaj... Przestań.
Dialogue: 0,0:06:28.01,0:06:31.17,Dialogue,,0000,0000,0000,,To był występ taneczny cheerleaderek z pierwszego roku.
Dialogue: 0,0:06:31.66,0:06:33.38,Dialogue,,0000,0000,0000,,A teraz, kto pierwszy?
Dialogue: 0,0:06:34.04,0:06:35.33,Dialogue,,0000,0000,0000,,Klasa 1-1!
Dialogue: 0,0:06:40.53,0:06:42.54,Dialogue,,0000,0000,0000,,Coś się stało, Panienko?
Dialogue: 0,0:06:42.54,0:06:43.34,Dialogue,,0000,0000,0000,,Proszę się pośpieszyć.
Dialogue: 0,0:06:46.07,0:06:47.59,Dialogue,,0000,0000,0000,,Poczekajcie chwilę.
Dialogue: 0,0:06:58.47,0:06:59.68,Dialogue,,0000,0000,0000,,Co to ma być?
Dialogue: 0,0:06:59.68,0:07:01.00,Dialogue,,0000,0000,0000,,To już przesada...
Dialogue: 0,0:07:01.54,0:07:05.22,Dialogue,,0000,0000,0000,,W-w końcu prosiliśmy o porno tekst.
Dialogue: 0,0:07:05.22,0:07:07.37,Dialogue,,0000,0000,0000,,Nawet mnie to trochę podnieca.
Dialogue: 0,0:07:07.83,0:07:10.04,Dialogue,,0000,0000,0000,,Właśnie dlatego ona tego wysłucha.
Dialogue: 0,0:07:10.04,0:07:11.65,Dialogue,,0000,0000,0000,,Z muzyką Kanade-chan
Dialogue: 0,0:07:11.65,0:07:14.26,Dialogue,,0000,0000,0000,,i akompaniamentem Narukary-san
Dialogue: 0,0:07:14.26,0:07:16.50,Dialogue,,0000,0000,0000,,sprawię, że wszyscy staną i posłuchają!
Dialogue: 0,0:07:16.96,0:07:18.51,Dialogue,,0000,0000,0000,,Staną?
Dialogue: 0,0:07:18.77,0:07:20.64,Dialogue,,0000,0000,0000,,To właśnie moja moc!
Dialogue: 0,0:07:22.04,0:07:23.39,Dialogue,,0000,0000,0000,,Taketo...
Dialogue: 0,0:07:23.74,0:07:27.01,Dialogue,,0000,0000,0000,,Skoro twierdzisz, że to zadziała, będziemy za tobą podążać do samego końca!
Dialogue: 0,0:07:27.01,0:07:28.30,Dialogue,,0000,0000,0000,,Prawda?
Dialogue: 0,0:07:28.30,0:07:28.90,Dialogue,,0000,0000,0000,,Zgadza się.
Dialogue: 0,0:07:29.16,0:07:30.14,Dialogue,,0000,0000,0000,,Zróbmy to.
Dialogue: 0,0:07:30.14,0:07:32.15,Dialogue,,0000,0000,0000,,Tak!
Dialogue: 0,0:07:33.70,0:07:35.62,Dialogue,,0000,0000,0000,,Została jeszcze tylko sprawa Narukary-san.
Dialogue: 0,0:07:36.91,0:07:38.78,Dialogue,,0000,0000,0000,,Jestem pewien, że przyjdzie... Na pewno.
Dialogue: 0,0:07:41.39,0:07:42.60,Dialogue,,0000,0000,0000,,O co chodzi?
Dialogue: 0,0:07:45.73,0:07:47.79,Dialogue,,0000,0000,0000,,Mogę prosić o chwilę?
Dialogue: 0,0:07:48.05,0:07:49.69,Dialogue,,0000,0000,0000,,J-jasne...
Dialogue: 0,0:07:52.04,0:07:54.28,Dialogue,,0000,0000,0000,,To dla ciebie.
Dialogue: 0,0:07:58.56,0:07:59.31,Paper,,0000,0000,0000,,{\be1\frz9.238\frx6\fry16\pos(624,301)}Kocham cię.
Dialogue: 0,0:07:59.31,0:07:59.44,Paper,,0000,0000,0000,,{\be1\frx6\fry16\pos(520,306)\frz11.103}Kocham cię.
Dialogue: 0,0:07:59.44,0:07:59.56,Paper,,0000,0000,0000,,{\be1\frx6\fry16\pos(467,303)\frz11.721}Kocham cię.
Dialogue: 0,0:07:59.56,0:07:59.69,Paper,,0000,0000,0000,,{\be1\frx6\fry16\frz14.504\pos(406,313)}Kocham cię.
Dialogue: 0,0:07:59.69,0:07:59.81,Paper,,0000,0000,0000,,{\be1\frx6\fry16\frz13.951\pos(30,389)}Kocham cię.
Dialogue: 0,0:07:59.81,0:07:59.94,Paper,,0000,0000,0000,,{\be1\frx6\fry16\pos(-21,393)\frz15.751}Kocham cię.
Dialogue: 0,0:07:59.94,0:08:00.06,Paper,,0000,0000,0000,,{\be1\frx6\fry16\frz17.38\pos(-94,401)}Kocham cię.
Dialogue: 0,0:08:13.86,0:08:14.95,Dialogue,,0000,0000,0000,,No już, idziemy.
Dialogue: 0,0:08:21.70,0:08:22.29,Dialogue,,0000,0000,0000,,Fukune!
Dialogue: 0,0:08:22.85,0:08:24.40,Dialogue,,0000,0000,0000,,Ojou-sama...
Dialogue: 0,0:08:41.88,0:08:44.63,Dialogue,,0000,0000,0000,,Panienko Fukune!!
Dialogue: 0,0:08:44.81,0:08:47.74,Song,,0000,0000,0000,,{\fad(250,250)}Spójrzmy w niebo.
Dialogue: 0,0:08:47.88,0:08:48.88,Dialogue,,0000,0000,0000,,Gdzie Utae-san?
Dialogue: 0,0:08:48.88,0:08:50.64,Dialogue,,0000,0000,0000,,Dokąd ona poszła?
Dialogue: 0,0:08:50.81,0:08:52.13,Dialogue,,0000,0000,0000,,Co robić?
Dialogue: 0,0:08:52.13,0:08:53.62,Dialogue,,0000,0000,0000,,Mam złe przeczucia...
Dialogue: 0,0:08:56.02,0:08:59.60,Dialogue,,0000,0000,0000,,Przepraszam, że cię w to wciągnęłam, Tsukuru-san.
Dialogue: 0,0:08:59.92,0:09:01.53,Dialogue,,0000,0000,0000,,Żaden problem.
Dialogue: 0,0:09:01.53,0:09:04.60,Dialogue,,0000,0000,0000,,Tak długo, jak tylko dostaję fundusze na badania, jestem zadowolona!
Dialogue: 0,0:09:05.43,0:09:09.54,Dialogue,,0000,0000,0000,,Bądź co bądź, jestem szalonym naukowcem, który zniszczy świat!
Dialogue: 0,0:09:10.43,0:09:11.63,Dialogue,,0000,0000,0000,,Dziękuję.
Dialogue: 0,0:09:11.63,0:09:12.55,Dialogue,,0000,0000,0000,,Na razie.
Dialogue: 0,0:09:15.19,0:09:17.09,Dialogue,,0000,0000,0000,,Przepraszam was.
Dialogue: 0,0:09:18.27,0:09:19.56,Dialogue,,0000,0000,0000,,Ale...
Dialogue: 0,0:09:20.25,0:09:23.83,Thoughts,,0000,0000,0000,,Cokolwiek by się nie działo, powinnaś być szczera wobec siebie.
Dialogue: 0,0:09:23.83,0:09:25.10,Thoughts,,0000,0000,0000,,To najlepsze wyjście!
Dialogue: 0,0:09:26.79,0:09:29.98,Dialogue,,0000,0000,0000,,Tylko tyle mogę zrobić.
Dialogue: 0,0:09:29.98,0:09:32.10,Dialogue,,0000,0000,0000,,Choćby nie wiem co.
Dialogue: 0,0:09:38.48,0:09:39.90,Dialogue,,0000,0000,0000,,N-nie zostało już dużo czasu...
Dialogue: 0,0:09:51.11,0:09:52.74,Dialogue,,0000,0000,0000,,Narukara-san.
Dialogue: 0,0:10:14.02,0:10:15.65,Dialogue,,0000,0000,0000,,U-um, ja...
Dialogue: 0,0:10:15.65,0:10:17.58,Dialogue,,0000,0000,0000,,Czekałam na ciebie, Fukune-chan!
Dialogue: 0,0:10:17.58,0:10:19.56,Dialogue,,0000,0000,0000,,Nie martw się! Jestem z tobą!
Dialogue: 0,0:10:20.36,0:10:22.28,Dialogue,,0000,0000,0000,,Skoro są już wszyscy, to idziemy.
Dialogue: 0,0:10:23.60,0:10:25.87,Dialogue,,0000,0000,0000,,Ruszamy, Klaso 1-3!
Dialogue: 0,0:10:25.87,0:10:27.31,Dialogue,,0000,0000,0000,,TAK!
Dialogue: 0,0:10:30.84,0:10:32.27,Dialogue,,0000,0000,0000,,Fukune...
Dialogue: 0,0:10:34.57,0:10:36.15,Dialogue,,0000,0000,0000,,A oto ostatni dzisiejszy występ...
Dialogue: 0,0:10:36.15,0:10:37.78,Dialogue,,0000,0000,0000,,...klasy 1-3!
Dialogue: 0,0:10:58.91,0:11:00.69,Thoughts,,0000,0000,0000,,Akutagawa-kun.
Dialogue: 0,0:11:02.73,0:11:04.63,Thoughts,,0000,0000,0000,,Narukara-san,
Dialogue: 0,0:11:04.63,0:11:06.69,Thoughts,,0000,0000,0000,,oto, kim naprawdę jestem.
Dialogue: 0,0:11:06.84,0:11:10.00,Thoughts,,0000,0000,0000,,To właśnie jest Akutagawa Taketo!
Dialogue: 0,0:11:22.20,0:11:25.27,Song,,0000,0000,0000,,{\an7\fad(250,250)}W tył i w przód.
Dialogue: 0,0:11:23.69,0:11:26.39,Song,,0000,0000,0000,,{\an9\fad(250,250)}Śliskie i mokre.
Dialogue: 0,0:11:25.27,0:11:28.51,Song,,0000,0000,0000,,{\an7\fad(250,250)}Miękkie i okrągłe.
Dialogue: 0,0:11:26.39,0:11:28.51,Song,,0000,0000,0000,,{\an9\fad(250,250)}Głaszcząc mocno.
Dialogue: 0,0:11:28.51,0:11:32.19,Song,,0000,0000,0000,,{\fad(250,250)}Jak cudownie.
Dialogue: 0,0:11:32.20,0:11:34.25,Song,,0000,0000,0000,,{\an7\fad(250,250)}W tył i w przód.
Dialogue: 0,0:11:32.93,0:11:35.69,Song,,0000,0000,0000,,{\an9\fad(250,250)}Śliskie i mokre.
Dialogue: 0,0:11:34.25,0:11:37.20,Song,,0000,0000,0000,,{\an7\fad(250,250)}Miękkie i okrągłe.
Dialogue: 0,0:11:35.69,0:11:37.20,Song,,0000,0000,0000,,{\an9\fad(250,250)}Głaszcząc mocno.
Dialogue: 0,0:11:37.53,0:11:40.71,Dialogue,,0000,0000,0000,,Kontrast pomiędzy tekstem a muzyką jest zdumiewający...
Dialogue: 0,0:11:50.67,0:11:57.19,Song,,0000,0000,0000,,{\fad(250,250)}Moje serce tańczy ku nieskończonej rozkoszy,
Dialogue: 0,0:11:57.19,0:12:03.42,Song,,0000,0000,0000,,{\fad(250,250)}docierając do miejsca, które kocham najbardziej.
Dialogue: 0,0:12:03.42,0:12:09.45,Song,,0000,0000,0000,,{\fad(250,250)}Kolejna rzecz, którą wiem, myślę o dniu, w którym poznaliśmy się,
Dialogue: 0,0:12:09.45,0:12:16.23,Song,,0000,0000,0000,,{\fad(250,250)}nadzy, jak w dniu swoich narodzin.
Dialogue: 0,0:12:16.23,0:12:22.77,Song,,0000,0000,0000,,{\fad(250,250)}Bogini, zawstydzona melodią przyjemności
Dialogue: 0,0:12:22.77,0:12:29.20,Song,,0000,0000,0000,,{\fad(250,250)}i filar stojący twardo pomiędzy smukłymi krzywiznami.
Dialogue: 0,0:12:29.20,0:12:35.06,Song,,0000,0000,0000,,{\fad(250,250)}Głos donośny i wyraźny na scenie, gorący i zdyszany oddech.
Dialogue: 0,0:12:35.06,0:12:41.46,Song,,0000,0000,0000,,{\fad(250,250)}Melodia, którą słyszę, to pożądanie.
Dialogue: 0,0:12:41.46,0:12:47.60,Song,,0000,0000,0000,,{\fad(250,250)}Odrzuć je i chodźmy na drugą stronę.
Dialogue: 0,0:12:43.21,0:12:47.60,Thoughts,,0000,0000,0000,,Racja.{\i0} Jest {\i1}takie miejsce, które kocham najbardziej.
Dialogue: 0,0:12:47.60,0:12:52.00,Song,,0000,0000,0000,,{\fad(250,250)}Cichy szept i nasze jęki...
Dialogue: 0,0:12:52.00,0:12:55.58,Song,,0000,0000,0000,,{\fad(250,250)}Daj mi się poczuć, daj mi się wziąć.
Dialogue: 0,0:12:55.58,0:12:58.77,Thoughts,,0000,0000,0000,,Widzę światło przenikające między drzewami. Czuję lekki wiatr.
Dialogue: 0,0:12:58.77,0:13:00.78,Thoughts,,0000,0000,0000,,I słyszę dźwięk klarnetu!
Dialogue: 0,0:13:00.78,0:13:07.47,Song,,0000,0000,0000,,{\fad(250,250)}Niebiosa rozkoszy.
Dialogue: 0,0:13:10.74,0:13:16.80,Song,,0000,0000,0000,,{\fad(250,250)}Zacznijmy nasz recital.
Dialogue: 0,0:13:11.92,0:13:14.76,Thoughts,,0000,0000,0000,,Dziś odnajdę boginię muzyki.
Dialogue: 0,0:13:16.80,0:13:23.12,Song,,0000,0000,0000,,{\fad(250,250)}Tańczące strofy i kuszący rytm poprowadziły nas do miłości.
Dialogue: 0,0:13:20.70,0:13:24.12,Thoughts,,0000,0000,0000,,Najpierw oberwałem, a potem stało się mnóstwo szalonych rzeczy.
Dialogue: 0,0:13:23.49,0:13:29.60,Song,,0000,0000,0000,,{\fad(250,250)}Zagrajmy melodię wznoszącej się miłości,
Dialogue: 0,0:13:29.60,0:13:36.32,Song,,0000,0000,0000,,{\fad(250,250)}trzymając się za ręce i oddychając jak jedno.
Dialogue: 0,0:13:30.15,0:13:33.54,Thoughts,,0000,0000,0000,,Ale z jakiegoś powodu nie mogłem oderwać od niej wzroku.
Dialogue: 0,0:13:33.54,0:13:36.32,Thoughts,,0000,0000,0000,,A teraz nie potrafię myśleć o niczym innym!
Dialogue: 0,0:13:36.32,0:13:42.38,Song,,0000,0000,0000,,{\fad(250,250)}To ogród pokus.
Dialogue: 0,0:13:42.38,0:13:49.13,Song,,0000,0000,0000,,{\fad(250,250)}Wgryzę się w delikatne brzoskwinie i soczyste melony.
Dialogue: 0,0:13:49.13,0:13:55.18,Song,,0000,0000,0000,,{\fad(250,250)}To restauracja Erosa.
Dialogue: 0,0:13:55.18,0:14:01.87,Song,,0000,0000,0000,,{\fad(250,250)}Obfity posiłek sycących dań...
Dialogue: 0,0:14:01.87,0:14:07.93,Song,,0000,0000,0000,,{\fad(250,250)}Pełen talerz pysznego mięsa
Dialogue: 0,0:14:07.93,0:14:15.59,Song,,0000,0000,0000,,{\fad(250,250)}i dojrzałe owoce seksu.
Dialogue: 0,0:14:17.58,0:14:23.98,Song,,0000,0000,0000,,{\fad(250,250)}Nie potrzebuję niczego więcej
Dialogue: 0,0:14:23.98,0:14:30.69,Song,,0000,0000,0000,,{\fad(250,250)}Twoje odsłonięte ciało jest takie piękne,
Dialogue: 0,0:14:30.69,0:14:36.78,Song,,0000,0000,0000,,{\fad(250,250)}to nieopisana radość.
Dialogue: 0,0:14:36.78,0:14:43.18,Song,,0000,0000,0000,,{\fad(250,250)}Pragnę go całego, od początku do końca.
Dialogue: 0,0:14:43.18,0:14:49.61,Song,,0000,0000,0000,,{\fad(250,250)}Pokaż mi swój uśmiech.
Dialogue: 0,0:14:49.61,0:14:57.94,Song,,0000,0000,0000,,{\fad(250,250)}Chcę być z tobą, dokąd byś nie poszła.
Dialogue: 0,0:14:50.19,0:14:52.23,Thoughts,,0000,0000,0000,,Właśnie, ja...
Dialogue: 0,0:14:57.94,0:15:03.02,Song,,0000,0000,0000,,{\fad(250,250)}Oddaj mi się.
Dialogue: 0,0:15:01.67,0:15:03.02,Thoughts,,0000,0000,0000,,Teraz, pozwól mi to usłyszeć.
Dialogue: 0,0:15:29.98,0:15:32.70,Thoughts,,0000,0000,0000,,Co to za uczucie?
Dialogue: 0,0:15:35.52,0:15:38.68,Thoughts,,0000,0000,0000,,Moje serce bije jak oszalałe, jestem taka podekscytowana!
Dialogue: 0,0:15:42.29,0:15:45.91,Thoughts,,0000,0000,0000,,To narasta we mnie!
Dialogue: 0,0:15:53.09,0:15:55.96,Thoughts,,0000,0000,0000,,Właśnie, to jest...
Dialogue: 0,0:16:05.23,0:16:06.98,Thoughts,,0000,0000,0000,,Kiedy byłam mała,
Dialogue: 0,0:16:07.36,0:16:10.49,Thoughts,,0000,0000,0000,,kiedy pierwszy raz zagrałam na klarnecie...
Dialogue: 0,0:16:11.69,0:16:14.10,Thoughts,,0000,0000,0000,,To jest dokładnie to samo uczucie.
Dialogue: 0,0:16:14.10,0:16:18.24,Thoughts,,0000,0000,0000,,Wtedy mój tata uśmiechnął się do mnie.
Dialogue: 0,0:16:18.24,0:16:21.39,Thoughts,,0000,0000,0000,,Ale teraz...
Dialogue: 0,0:16:22.83,0:16:29.17,Song,,0000,0000,0000,,{\fad(250,250)}My, razem we dwoje,
Dialogue: 0,0:16:29.17,0:16:35.17,Song,,0000,0000,0000,,{\fad(250,250)}nasz cud.
Dialogue: 0,0:16:35.17,0:16:40.57,Song,,0000,0000,0000,,{\fad(250,250)}Połączeni przez miłość...
Dialogue: 0,0:16:40.57,0:16:53.38,Song,,0000,0000,0000,,{\fad(250,250)}Tu i teraz, wieczny raj!
Dialogue: 0,0:16:53.38,0:16:59.55,Song,,0000,0000,0000,,{\fad(250,250)}Będę z tobą już na zawsze,
Dialogue: 0,0:16:59.55,0:17:05.23,Song,,0000,0000,0000,,{\fad(250,250)}tak postanowiłem w swym sercu.
Dialogue: 0,0:17:05.23,0:17:18.01,Song,,0000,0000,0000,,{\fad(250,250)}Chcę uwierzyć w te uczucia całą moją duszą.
Dialogue: 0,0:17:18.01,0:17:23.61,Song,,0000,0000,0000,,{\an7\fad(250,250)}Otwarta i szczera miłość...
Dialogue: 0,0:17:18.01,0:17:19.90,Thoughts,,0000,0000,0000,,Co to ma być?
Dialogue: 0,0:17:22.20,0:17:23.61,Song,,0000,0000,0000,,{\an9\fad(250,250)}(otwarta i szczera)
Dialogue: 0,0:17:23.61,0:17:25.67,Thoughts,,0000,0000,0000,,Tekst to praktycznie porno, ale...
Dialogue: 0,0:17:25.67,0:17:27.39,Thoughts,,0000,0000,0000,,Dlaczego to jest takie...
Dialogue: 0,0:17:27.39,0:17:29.63,Thoughts,,0000,0000,0000,,Kocham to. Naprawdę to czuję!
Dialogue: 0,0:17:29.89,0:17:32.96,Thoughts,,0000,0000,0000,,Piosenka, słowa i akompaniament...
Dialogue: 0,0:17:32.96,0:17:36.27,Thoughts,,0000,0000,0000,,Dodanie tych trzech rzeczy daje razem pięć. Albo dziesięć...
Dialogue: 0,0:17:36.27,0:17:38.96,Thoughts,,0000,0000,0000,,Nie, cały milion!
Dialogue: 0,0:17:39.14,0:17:42.06,Thoughts,,0000,0000,0000,,T-to genialna trójca!
Dialogue: 0,0:17:42.58,0:17:48.75,Song,,0000,0000,0000,,{\fad(250,250)}Przepiękny kwiat
Dialogue: 0,0:17:42.78,0:17:44.10,Thoughts,,0000,0000,0000,,Fukune-chan...
Dialogue: 0,0:17:48.75,0:17:54.87,Song,,0000,0000,0000,,{\fad(250,250)}w polu lilii.
Dialogue: 0,0:17:54.87,0:18:00.15,Song,,0000,0000,0000,,{\fad(250,250)}Dzielący nieskończoną miłość
Dialogue: 0,0:17:54.87,0:17:56.07,Thoughts,,0000,0000,0000,,Taketo...
Dialogue: 0,0:18:00.15,0:18:06.55,Song,,0000,0000,0000,,{\fad(250,250)}niezliczoną ilość razy.
Dialogue: 0,0:18:06.55,0:18:13.21,Song,,0000,0000,0000,,{\an7\fad(250,250)}Ulotna refleksja
Dialogue: 0,0:18:11.86,0:18:13.21,Song,,0000,0000,0000,,{\an9\fad(250,250)}(refleksja)
Dialogue: 0,0:18:13.21,0:18:18.84,Song,,0000,0000,0000,,{\fad(250,250)}romantycznych zdjęć.
Dialogue: 0,0:18:18.84,0:18:31.87,Song,,0000,0000,0000,,{\fad(250,250)}Rozmawiajmy ze sobą, bo przysięgliśmy sobie naszą przyszłość.
Dialogue: 0,0:18:19.50,0:18:20.65,Thoughts,,0000,0000,0000,,To jest...
Dialogue: 0,0:18:28.37,0:18:31.13,Thoughts,,0000,0000,0000,,...to właśnie oznacza gra na klarnecie!
Dialogue: 0,0:18:31.87,0:18:35.69,Thoughts,,0000,0000,0000,,Nie wiedziałam, co robić.
Dialogue: 0,0:18:35.69,0:18:38.99,Thoughts,,0000,0000,0000,,Nie jestem geniuszem jak inni.
Dialogue: 0,0:18:38.99,0:18:41.49,Thoughts,,0000,0000,0000,,Dlatego nie znałam uczucia radości i cieszenia się czymś.
Dialogue: 0,0:18:41.49,0:18:43.21,Thoughts,,0000,0000,0000,,Byłam pusta.
Dialogue: 0,0:18:43.21,0:18:44.68,Thoughts,,0000,0000,0000,,Ale... Ale...
Dialogue: 0,0:18:50.76,0:18:51.91,Thoughts,,0000,0000,0000,,Ta piosenka...
Dialogue: 0,0:18:53.15,0:18:55.56,Thoughts,,0000,0000,0000,,Piosenka stworzona przez wszystkich mówi mi...
Dialogue: 0,0:18:56.36,0:18:59.09,Thoughts,,0000,0000,0000,,Ich piosenka mówi mi, kim jestem!
Dialogue: 0,0:19:01.85,0:19:07.85,Song,,0000,0000,0000,,{\fad(250,250)}Nie potrzebujemy nic więcej.
Dialogue: 0,0:19:07.85,0:19:14.13,Song,,0000,0000,0000,,{\fad(250,250)}Obnażmy się przed sobą.
Dialogue: 0,0:19:12.58,0:19:14.13,Thoughts,,0000,0000,0000,,Chcę jeszcze zagrać...
Dialogue: 0,0:19:14.13,0:19:16.06,Thoughts,,0000,0000,0000,,Chcę, by usłyszało to więcej ludzi!
Dialogue: 0,0:19:16.06,0:19:19.87,Thoughts,,0000,0000,0000,,Kocham grać na klarnecie!
Dialogue: 0,0:19:20.25,0:19:22.69,Dialogue,,0000,0000,0000,,W-więc tak gra panienka Fukune.
Dialogue: 0,0:19:23.98,0:19:25.99,Dialogue,,0000,0000,0000,,To jest geniusz.
Dialogue: 0,0:19:27.42,0:19:29.38,Dialogue,,0000,0000,0000,,Oni także są ludźmi.
Dialogue: 0,0:19:29.38,0:19:32.76,Dialogue,,0000,0000,0000,,Potykają się, cierpią, czasami popełniają błędy.
Dialogue: 0,0:19:32.76,0:19:36.18,Dialogue,,0000,0000,0000,,Ale właśnie dzięki temu potrafią wznieść się na wyższe poziomy.
Dialogue: 0,0:19:36.18,0:19:39.02,Dialogue,,0000,0000,0000,,To cudowne, nieprawdaż?
Dialogue: 0,0:19:39.02,0:19:46.11,Song,,0000,0000,0000,,{\fad(250,250)}My, razem we dwoje,
Dialogue: 0,0:19:41.89,0:19:42.72,Dialogue,,0000,0000,0000,,Idziemy.
Dialogue: 0,0:19:46.11,0:19:52.11,Song,,0000,0000,0000,,{\fad(250,250)}nasz cud.
Dialogue: 0,0:19:52.11,0:19:57.65,Song,,0000,0000,0000,,{\fad(250,250)}Połączeni przez miłość...
Dialogue: 0,0:19:57.65,0:20:13.87,Song,,0000,0000,0000,,{\fad(250,1000)}Tu i teraz, wieczny raj!
Dialogue: 0,0:20:23.12,0:20:24.21,Dialogue,,0000,0000,0000,,I tak oto...
Dialogue: 0,0:20:24.64,0:20:27.37,Dialogue,,0000,0000,0000,,Zwycięzcami turnieju
Dialogue: 0,0:20:27.37,0:20:29.98,Dialogue,,0000,0000,0000,,zostaje klasa 1-3!
Dialogue: 0,0:20:34.92,0:20:36.04,Dialogue,,0000,0000,0000,,Dobra!
Dialogue: 0,0:20:36.04,0:20:37.18,Dialogue,,0000,0000,0000,,Taketo-kun...
Dialogue: 0,0:20:39.91,0:20:41.46,Thoughts,,0000,0000,0000,,T-Taketo-kun!?
Dialogue: 0,0:20:41.46,0:20:42.73,Thoughts,,0000,0000,0000,,Czy ona powiedziała "Taketo-kun"?!
Dialogue: 0,0:20:43.13,0:20:45.31,Thoughts,,0000,0000,0000,,T-T-T-Taketo-kun!?
Dialogue: 0,0:20:45.31,0:20:46.92,Dialogue,,0000,0000,0000,,Ten tekst...
Dialogue: 0,0:20:53.78,0:20:55.07,Dialogue,,0000,0000,0000,,O czym właściwie był?
Dialogue: 0,0:20:56.73,0:20:59.95,Dialogue,,0000,0000,0000,,Były fragmenty, których nie rozumiałam.
Dialogue: 0,0:20:59.95,0:21:03.08,Dialogue,,0000,0000,0000,,Cóż, wiesz...
Dialogue: 0,0:21:03.08,0:21:04.34,Dialogue,,0000,0000,0000,,Kiedyś...
Dialogue: 0,0:21:04.34,0:21:06.27,Dialogue,,0000,0000,0000,,Kiedyś na pewno zrozumiesz.
Dialogue: 0,0:21:08.59,0:21:10.40,Dialogue,,0000,0000,0000,,Co za kretyn...
Dialogue: 0,0:21:11.66,0:21:13.01,Dialogue,,0000,0000,0000,,Taketo!
Dialogue: 0,0:21:13.53,0:21:14.88,Dialogue,,0000,0000,0000,,Dokąd chcesz jechać?
Dialogue: 0,0:21:14.88,0:21:16.54,Dialogue,,0000,0000,0000,,A ty, Fukune-chan?
Dialogue: 0,0:21:17.20,0:21:18.89,Dialogue,,0000,0000,0000,,Hmm, zobaczmy...
Dialogue: 0,0:21:19.62,0:21:20.38,Dialogue,,0000,0000,0000,,Wiedeń!
Dialogue: 0,0:21:22.00,0:21:26.00,Rock,,0000,0000,0000,,{\be0\frx12\fry10\frz26.5\t(0,3983,\fs125)\c&H23313F&\move(545,237,535,219,21,3983)}Kocham cię
Dialogue: 0,0:21:31.47,0:21:32.71,Dialogue,,0000,0000,0000,,Dobra robota.
Dialogue: 0,0:21:33.05,0:21:35.23,Dialogue,,0000,0000,0000,,Co masz na myśli?
Dialogue: 0,0:21:35.23,0:21:36.21,Dialogue,,0000,0000,0000,,Ech?
Dialogue: 0,0:21:37.67,0:21:40.77,Dialogue,,0000,0000,0000,,Widząc tych dwoje
Dialogue: 0,0:21:40.77,0:21:42.30,Dialogue,,0000,0000,0000,,zrozumiałam.
Dialogue: 0,0:21:42.96,0:21:44.79,Dialogue,,0000,0000,0000,,To wszystko.
Dialogue: 0,0:21:44.79,0:21:48.21,Dialogue,,0000,0000,0000,,Spełnianie marzeń innych, nieważne gdzie i kiedy.
Dialogue: 0,0:21:48.21,0:21:49.56,Dialogue,,0000,0000,0000,,Czy ty nigdy...
Dialogue: 0,0:21:49.82,0:21:50.91,Dialogue,,0000,0000,0000,,Nie!
Dialogue: 0,0:21:50.91,0:21:52.43,Dialogue,,0000,0000,0000,,Jestem genialną idolką!
Dialogue: 0,0:21:52.77,0:21:56.68,Dialogue,,0000,0000,0000,,W takim razie kto spełni {\i1}twoje{\i0} marzenia?
Dialogue: 0,0:21:57.17,0:21:59.69,Dialogue,,0000,0000,0000,,Wyruszam na koncert.
Dialogue: 0,0:22:00.04,0:22:01.44,Dialogue,,0000,0000,0000,,Koncert?
Dialogue: 0,0:22:01.44,0:22:02.19,Dialogue,,0000,0000,0000,,Gdzie?
Dialogue: 0,0:22:02.97,0:22:04.02,Dialogue,,0000,0000,0000,,We Wiedniu!
Dialogue: 0,0:22:04.69,0:22:05.72,Dialogue,,0000,0000,0000,,Ach tak?
Dialogue: 0,0:22:05.72,0:22:09.28,Dialogue,,0000,0000,0000,,Nasze szkolne życie dopiero się zaczyna!
Dialogue: 0,0:22:09.28,0:22:10.08,Dialogue,,0000,0000,0000,,Tak!
Dialogue: 0,0:22:15.94,0:22:17.66,Dialogue,,0000,0000,0000,,Wiecie co...
Dialogue: 0,0:22:17.66,0:22:20.33,Dialogue,,0000,0000,0000,,Szczerze mówiąc, nie spodziewałam się, że wygracie.
Dialogue: 0,0:22:20.91,0:22:23.84,Dialogue,,0000,0000,0000,,Jesteście naprawdę genialni.
Dialogue: 0,0:22:24.24,0:22:28.66,Dialogue,,0000,0000,0000,,Pytaj mnie o wszystko, co chcesz wiedzieć o Wiedniu, Fukune-chan.
Dialogue: 0,0:22:30.87,0:22:33.08,Dialogue,,0000,0000,0000,,Taketo, źle znosisz loty samolotem?
Dialogue: 0,0:22:33.08,0:22:34.34,Dialogue,,0000,0000,0000,,Jeśli będziesz recytował wymyśloną przeze mnie formułę,
Dialogue: 0,0:22:34.34,0:22:37.59,Dialogue,,0000,0000,0000,,która oblicza wartości neurologiczne i euforyczne,
Dialogue: 0,0:22:37.59,0:22:40.29,Dialogue,,0000,0000,0000,,od razu poczujesz się lepiej!
Dialogue: 0,0:22:40.29,0:22:42.35,Dialogue,,0000,0000,0000,,Dalej, mów razem ze mną!
Dialogue: 0,0:22:42.35,0:22:44.76,Dialogue,,0000,0000,0000,,3.141562...
Dialogue: 0,0:22:48.96,0:22:50.92,All Done!,,0000,0000,0000,,{\fad(398,0)\frz0.78\pos(1150,533)}Skończone!
Dialogue: 0,0:22:52.33,0:22:55.18,RomajiED,,0000,0000,0000,,{\k4}Ho{\k8}ra, {\k17}hi{\k17}ra{\k17}me{\k25}ki {\K16}PO{\K32}WER {\k45}e{\k19}i{\k34}you {\k17}bu{\k17}so{\k17}ku
Dialogue: 0,0:22:55.18,0:22:57.75,RomajiED,,0000,0000,0000,,{\k8}Ma{\k10}ta {\K14}BAN{\K18}ZAI {\k16}shi{\k15}te {\K31}PEA{\K30}CE {\k27}jou{\k27}sho{\k17}u {\k44}chuu
Dialogue: 0,0:23:09.84,0:23:11.09,RomajiED,,0000,0000,0000,,{\k8}Sa, {\k10}i{\k13}kou {\k6}a{\k18}sa {\k3}i{\k7}tch{\k7}ou {\k8}ka{\k10}ra {\K14}HA{\K21}PPY
