Dialogue: 0,0:22:52.33,0:22:55.18,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:55.18,0:22:57.75,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:23:09.84,0:23:11.09,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:23:11.24,0:23:12.67,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:23:12.71,0:23:13.94,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:23:13.94,0:23:15.32,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:23:15.54,0:23:16.81,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:23:16.96,0:23:18.38,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:23:18.42,0:23:20.71,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:21.03,0:23:24.25,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:24.33,0:23:26.47,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:26.58,0:23:29.10,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:29.12,0:23:31.36,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:31.62,0:23:33.17,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:33.19,0:23:34.42,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:34.49,0:23:37.16,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:37.33,0:23:38.61,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:38.74,0:23:42.38,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:43.07,0:23:44.45,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:44.49,0:23:45.92,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:45.96,0:23:48.59,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:48.72,0:23:51.05,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:51.05,0:23:53.77,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:55.19,0:23:58.03,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:58.06,0:24:00.60,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
