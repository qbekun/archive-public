Dialogue: 0,0:00:27.74,0:00:29.94,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:00:39.06,0:00:41.60,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:00:41.71,0:00:43.61,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:00:44.21,0:00:49.13,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:00:50.33,0:00:54.97,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:00:55.51,0:01:00.49,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:01:01.68,0:01:04.24,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:01:04.48,0:01:06.92,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:01:07.32,0:01:08.38,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:01:08.38,0:01:09.45,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:01:09.45,0:01:11.85,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:01:12.15,0:01:14.70,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:01:15.02,0:01:17.74,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:01:18.08,0:01:20.82,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:01:20.89,0:01:23.84,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:01:23.91,0:01:26.02,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:01:26.21,0:01:29.02,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:01:29.32,0:01:32.16,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:01:32.21,0:01:34.90,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:01:35.01,0:01:37.30,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:01:35.51,0:01:38.27,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:37.47,0:01:39.95,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:38.33,0:01:41.09,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:40.27,0:01:42.75,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:41.20,0:01:42.77,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:01:43.12,0:01:45.94,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:01:58.43,0:02:02.56,Title,,0000,0000,0000,,{\fad(531,513)\pos(1048,582)}Fotoreportaże
Dialogue: 0,0:02:06.15,0:02:08.50,Default,,0000,0000,0000,,{\i1}Odwaliłem wczoraj kawał dobrej roboty.
Dialogue: 0,0:02:08.50,0:02:11.85,Default,,0000,0000,0000,,{\i1}Fantazje oparte wyłącznie na fotografowaniu były całkiem całkiem...
Dialogue: 0,0:02:11.85,0:02:13.03,Default,,0000,0000,0000,,Dzień dobry.
Dialogue: 0,0:02:14.29,0:02:16.16,Default,,0000,0000,0000,,N-Narukara-san!
Dialogue: 0,0:02:17.66,0:02:19.02,Default,,0000,0000,0000,,Dz-dzień dobry!
Dialogue: 0,0:02:19.02,0:02:21.17,Default,,0000,0000,0000,,Ł-ładna dziś pogoda, nie?
Dialogue: 0,0:02:21.17,0:02:23.46,Default,,0000,0000,0000,,Tak, naprawdę ładna...
Dialogue: 0,0:02:27.97,0:02:29.76,Default,,0000,0000,0000,,{\i1}To jest to!
Dialogue: 0,0:02:29.76,0:02:33.69,Default,,0000,0000,0000,,{\i1}Szkolne życie, o którym marzyłem, nareszcie się zaczyna!
Dialogue: 0,0:02:35.11,0:02:36.46,Default,,0000,0000,0000,,Co się stało?
Dialogue: 0,0:02:37.31,0:02:40.40,Default,,0000,0000,0000,,Twoje oczy są całe czerwone. Pracowałeś całą noc?
Dialogue: 0,0:02:40.40,0:02:42.88,Default,,0000,0000,0000,,T-tak, powiedzmy...
Dialogue: 0,0:02:42.88,0:02:47.57,Default,,0000,0000,0000,,Naprawdę bym chciała kiedyś przeczytać jedną z twych powieści romantycznych.
Dialogue: 0,0:02:47.57,0:02:49.97,Default,,0000,0000,0000,,{\i1}W-właśnie...
Dialogue: 0,0:02:49.97,0:02:53.20,Default,,0000,0000,0000,,{\i1}Narukara-san nadal nie wie, że piszę porno.
Dialogue: 0,0:02:53.83,0:02:56.27,Default,,0000,0000,0000,,Nie czytam za dużo...
Dialogue: 0,0:02:56.27,0:02:58.80,Default,,0000,0000,0000,,ale jeśli to dzieło kolegi z klasy...
Dialogue: 0,0:02:58.80,0:03:01.11,Default,,0000,0000,0000,,N-nie zmuszaj się.
Dialogue: 0,0:03:01.11,0:03:03.67,Default,,0000,0000,0000,,Jesteś zajęta ćwiczeniem gry na klarnecie, prawda?
Dialogue: 0,0:03:03.67,0:03:04.75,Default,,0000,0000,0000,,Ale...
Dialogue: 0,0:03:04.75,0:03:07.24,Default,,0000,0000,0000,,Skup się na muzyce.
Dialogue: 0,0:03:07.24,0:03:09.34,Default,,0000,0000,0000,,W ten sposób będę o wiele szczęśliwszy.
Dialogue: 0,0:03:09.66,0:03:12.83,Default,,0000,0000,0000,,Naprawdę? Więc tak zrobię.
Dialogue: 0,0:03:12.83,0:03:14.93,Default,,0000,0000,0000,,Dobra, to ja idę do sali muzycznej.
Dialogue: 0,0:03:17.33,0:03:19.10,Default,,0000,0000,0000,,Jesteś żałosny.
Dialogue: 0,0:03:21.55,0:03:25.70,Default,,0000,0000,0000,,Piszesz te niesamowicie zboczone historie i chcesz, by wiedzieli o tym wszyscy oprócz Narukary-san?
Dialogue: 0,0:03:25.70,0:03:28.45,Default,,0000,0000,0000,,C-co za różnica?
Dialogue: 0,0:03:28.45,0:03:32.45,Default,,0000,0000,0000,,Moment, w którym niewinna dziewczyna otwiera oczy na nieczysty świat dorosłych...
Dialogue: 0,0:03:32.94,0:03:34.91,Default,,0000,0000,0000,,Idealny materiał na zdjęcie.
Dialogue: 0,0:03:34.91,0:03:37.90,Default,,0000,0000,0000,,To nie ma nic wspólnego z Narukarą-san.
Dialogue: 0,0:03:37.90,0:03:39.87,Default,,0000,0000,0000,,Nic nie rozumiesz.
Dialogue: 0,0:03:40.75,0:03:43.12,Default,,0000,0000,0000,,Ludzie to obrzydliwe stworzenia. Zwłaszcza kobiety.
Dialogue: 0,0:03:47.08,0:03:50.05,Default,,0000,0000,0000,,To ty nic nie rozumiesz, Raika.
Dialogue: 0,0:03:58.71,0:03:59.76,Default,,0000,0000,0000,,To jest...
Dialogue: 0,0:03:59.76,0:04:02.92,Default,,0000,0000,0000,,...jeden z tych "listów miłosnych", o których tyle słyszałem!
Dialogue: 0,0:04:09.26,0:04:10.25,Default,,0000,0000,0000,,Co o tym sądzisz?
Dialogue: 0,0:04:10.94,0:04:13.34,Default,,0000,0000,0000,,Niewykluczone, że to faktycznie jest list miłosny.
Dialogue: 0,0:04:13.34,0:04:15.73,Default,,0000,0000,0000,,To? Poważnie?
Dialogue: 0,0:04:15.73,0:04:20.43,Default,,0000,0000,0000,,Są tacy, którzy chcą pominąć proces miłości i przejść od razu do samego końca.
Dialogue: 0,0:04:20.43,0:04:21.61,Default,,0000,0000,0000,,Innymi słowy,
Dialogue: 0,0:04:21.61,0:04:24.78,Default,,0000,0000,0000,,chcą pominąć poznawanie się i randki
Dialogue: 0,0:04:24.78,0:04:26.88,Default,,0000,0000,0000,,i od razu zrobić ze mną XXX?
Dialogue: 0,0:04:27.41,0:04:29.05,Default,,0000,0000,0000,,Niewybaczalne.
Dialogue: 0,0:04:29.05,0:04:32.21,Default,,0000,0000,0000,,Chcą usidlić Taketo przy użyciu sprytnego planu...
Dialogue: 0,0:04:32.21,0:04:33.71,Default,,0000,0000,0000,,{\i1}List miłosny!
Dialogue: 0,0:04:38.09,0:04:40.75,Default,,0000,0000,0000,,{\i1}Czyżbym jednak miał...
Dialogue: 0,0:04:40.18,0:04:41.60,door,,0000,0000,0000,,{\c&H0B00BE&\fs75\pos(643,118)}Szczęście!
Dialogue: 0,0:04:41.60,0:04:43.60,door,,0000,0000,0000,,{\fs55\pos(652,575)}Kółko Dziennikarskie
Dialogue: 0,0:04:49.83,0:04:52.99,Default,,0000,0000,0000,,Dostarczyłeś artykuł sporo czasu przed deadlinem, do tego całkiem niezły.
Dialogue: 0,0:04:52.99,0:04:55.09,Default,,0000,0000,0000,,Ostatnio coraz lepiej ci idzie.
Dialogue: 0,0:04:55.87,0:04:56.95,Default,,0000,0000,0000,,No, może.
Dialogue: 0,0:04:57.53,0:05:00.93,Default,,0000,0000,0000,,Raika-san, jak ci idzie z twoją robotą?
Dialogue: 0,0:05:02.00,0:05:03.98,Default,,0000,0000,0000,,Jeszcze nie skończyłam.
Dialogue: 0,0:05:03.98,0:05:05.12,Default,,0000,0000,0000,,Jej robotą?
Dialogue: 0,0:05:05.12,0:05:07.88,Default,,0000,0000,0000,,Poprosiłam ją, by zrobiła plakat promujący Akademię Inspiracji.
Dialogue: 0,0:05:08.04,0:05:17.59,Default top TSing,,0000,0000,0000,,{\an8\fad(318,473)}"Wybierzcie Akademię Inspiracji"
Dialogue: 0,0:05:08.70,0:05:12.49,Default,,0000,0000,0000,,Aby w przyszłym roku przyciągnąć geniuszy z całego kraju
Dialogue: 0,0:05:12.49,0:05:14.10,Default,,0000,0000,0000,,Potrzebuję czegoś awangardowego i oszałamiającego,
Dialogue: 0,0:05:14.10,0:05:17.59,Default,,0000,0000,0000,,{\fad(0,473)}zdjęcia, którego ludzie nigdy nie zapomną.
Dialogue: 0,0:05:18.13,0:05:19.77,Default,,0000,0000,0000,,Wiem, ale...
Dialogue: 0,0:05:21.11,0:05:23.06,Default,,0000,0000,0000,,Jakoś nie mogę uchwycić odpowiedniego zdjęcia...
Dialogue: 0,0:05:23.06,0:05:25.46,Default,,0000,0000,0000,,Zastój. Cóż za rzadkość.
Dialogue: 0,0:05:26.36,0:05:27.06,Default,,0000,0000,0000,,No co?
Dialogue: 0,0:05:28.21,0:05:29.30,Default,,0000,0000,0000,,Nic takiego.
Dialogue: 0,0:05:33.47,0:05:35.26,Default,,0000,0000,0000,,{\i1}Nie mam pojęcia, kto to przysłał.
Dialogue: 0,0:05:35.58,0:05:37.29,Default,,0000,0000,0000,,{\i1}Nie wiem, jak ta osoba wygląda,
Dialogue: 0,0:05:37.29,0:05:40.01,Default,,0000,0000,0000,,{\i1}a moją jedyną wskazówką są majtki z misiem.
Dialogue: 0,0:05:40.77,0:05:43.52,Default,,0000,0000,0000,,A wtedy wszystkie razem dałyśmy z siebie wszystko!
Dialogue: 0,0:05:43.85,0:05:45.69,Default,,0000,0000,0000,,{\i1}Ale mimo to...
Dialogue: 0,0:05:45.69,0:05:49.52,Default,,0000,0000,0000,,{\i1}Nie mogę po prostu podejść i powiedzieć "pokażcie mi swoje majtki!".
Dialogue: 0,0:05:51.99,0:05:53.07,Default,,0000,0000,0000,,Boski wiatr!
Dialogue: 0,0:05:53.65,0:05:55.40,Default,,0000,0000,0000,,Niebieskie i różowe...
Dialogue: 0,0:05:55.40,0:05:56.27,Default,,0000,0000,0000,,Niestety!
Dialogue: 0,0:05:56.27,0:05:57.61,Default,,0000,0000,0000,,Co "niestety"?!
Dialogue: 0,0:05:57.61,0:05:59.66,Default,,0000,0000,0000,,Postaram się bardziej! Przepraszam!
Dialogue: 0,0:06:01.14,0:06:02.41,Default,,0000,0000,0000,,{\i1}Legendarne majtki w paski!
Dialogue: 0,0:06:03.40,0:06:06.14,Default,,0000,0000,0000,,{\i1}Blisko! To nie miś, tylko cętkowany wąż.
Dialogue: 0,0:06:07.28,0:06:10.00,Default,,0000,0000,0000,,{\i1}Niesamowite! Strawberry Panic!
Dialogue: 0,0:06:13.12,0:06:15.68,Default,,0000,0000,0000,,{\i1}Co się dzisiaj dzieje?
Dialogue: 0,0:06:15.68,0:06:19.64,Default,,0000,0000,0000,,{\i1}Jest dokładnie tak samo jak w normalnym życiu licealisty, o którym czytałem w mangach!
Dialogue: 0,0:06:21.68,0:06:24.43,Default,,0000,0000,0000,,{\i1}Ale nadal nie znalazłem misia.
Dialogue: 0,0:06:25.09,0:06:26.37,Default,,0000,0000,0000,,{\i1}Już wiem...
Dialogue: 0,0:06:26.37,0:06:28.62,Default,,0000,0000,0000,,{\i1}Moje pragnienie odnalezienia dziewczyny ze zdjęcia
Dialogue: 0,0:06:28.62,0:06:32.11,Default,,0000,0000,0000,,{\i1}obudziły we mnie super moc!
Dialogue: 0,0:06:34.68,0:06:37.53,Default,,0000,0000,0000,,{\i1}Jam jest ten, który wzywa boski wiatr--
Dialogue: 0,0:06:42.49,0:06:44.80,Default,,0000,0000,0000,,Spójrz na te wszystkie skargi!
Dialogue: 0,0:06:44.80,0:06:48.94,Default,,0000,0000,0000,,Wszyscy donoszą, że zaglądałeś dziewczynom pod spódniczki.
Dialogue: 0,0:06:48.94,0:06:50.29,Default,,0000,0000,0000,,To nieporozumienie.
Dialogue: 0,0:06:50.29,0:06:51.72,Default,,0000,0000,0000,,Ja nic nie zrobiłem.
Dialogue: 0,0:06:51.72,0:06:56.88,Default,,0000,0000,0000,,Jeśli się przyznasz, może ci odpuszczę po stu batach.
Dialogue: 0,0:06:56.88,0:06:58.63,Default,,0000,0000,0000,,To był boski wiatr!
Dialogue: 0,0:06:58.63,0:07:00.31,Default,,0000,0000,0000,,Dość tego!
Dialogue: 0,0:07:00.31,0:07:03.18,Default,,0000,0000,0000,,Nie ma mowy, bym uwierzyła, że wiatr za tobą podąża.
Dialogue: 0,0:07:07.15,0:07:09.03,Default,,0000,0000,0000,,Dojrzała czerń!
Dialogue: 0,0:07:10.04,0:07:12.03,Default,,0000,0000,0000,,Ty zboczony, problematyczny dzieciaku!
Dialogue: 0,0:07:13.64,0:07:15.16,Default,,0000,0000,0000,,To było okrutne.
Dialogue: 0,0:07:15.16,0:07:17.66,Default,,0000,0000,0000,,Poza tym, to był zupełny przypadek.
Dialogue: 0,0:07:17.66,0:07:19.80,Default,,0000,0000,0000,,Jesteś przeklęty.
Dialogue: 0,0:07:24.79,0:07:28.17,Introduction/Gauge,,0000,0000,0000,,{\fad(654,0)\pos(1034,63)}Yoruno Misa
Dialogue: 0,0:07:24.79,0:07:28.17,Introduction/Gauge,,0000,0000,0000,,{\fad(654,0)\pos(253,63)}Genialna Wróżbitka
Dialogue: 0,0:07:25.30,0:07:28.17,Default,,0000,0000,0000,,Granica pomiędzy szczęściem i pechem jest bardzo cienka.
Dialogue: 0,0:07:34.08,0:07:36.60,Default,,0000,0000,0000,,C-co to miało być?
Dialogue: 0,0:07:38.42,0:07:40.10,Default,,0000,0000,0000,,Yoruno Misa?
Dialogue: 0,0:07:40.10,0:07:43.78,Default,,0000,0000,0000,,Słyszałem, że jej przepowiednie zawsze się sprawdzają.
Dialogue: 0,0:07:43.78,0:07:47.68,Default,,0000,0000,0000,,Ale do tej pory czułem się, jakby szczęście mi cały czas sprzyjało.
Dialogue: 0,0:07:47.68,0:07:50.15,Default,,0000,0000,0000,,Naprawdę tak uważasz?
Dialogue: 0,0:07:51.90,0:07:54.32,Default,,0000,0000,0000,,Jeśli się do niego zbliżysz, zostaniesz upokorzona.
Dialogue: 0,0:07:54.32,0:07:56.28,Default,,0000,0000,0000,,Zbliżenie się nawet na odległość metra jest niebezpieczne.
Dialogue: 0,0:07:56.68,0:08:00.95,Default,,0000,0000,0000,,Niedobrze! Dopiero co wyjaśniłem tamten skandal...
Dialogue: 0,0:08:04.04,0:08:07.92,smack,,0000,0000,0000,,{\pos(361,519)}{}Szczę
Dialogue: 0,0:08:04.04,0:08:08.42,smack,,0000,0000,0000,,{\pos(964,519)}{}ście
Dialogue: 0,0:08:08.04,0:08:11.38,smack,,0000,0000,0000,,{\fad(0,934)\c&H1A1B19&\3c&HE3E3E3&\pos(354,520)}{}Nie
Dialogue: 0,0:08:08.42,0:08:08.80,smack,,0000,0000,0000,,{\pos(964,519)\t(\c&H1A1B19&)}{}szczęście
Dialogue: 0,0:08:08.80,0:08:11.38,smack,,0000,0000,0000,,{\c&H1A1B19&\pos(964,519)\fad(0,934)}{}szczęście
Dialogue: 0,0:08:11.42,0:08:13.34,Default,,0000,0000,0000,,C-co robić?
Dialogue: 0,0:08:13.64,0:08:15.36,Default,,0000,0000,0000,,Tamto zdjęcie...
Dialogue: 0,0:08:15.96,0:08:17.88,Default,,0000,0000,0000,,Myślisz, że jest przeklęte czy coś?
Dialogue: 0,0:08:17.88,0:08:22.04,Default,,0000,0000,0000,,Nie wierzę w takie nienaukowe bzdury jak klątwy.
Dialogue: 0,0:08:22.60,0:08:24.40,Default,,0000,0000,0000,,Ale jeśli tak się zastanowić,
Dialogue: 0,0:08:24.40,0:08:27.34,Default,,0000,0000,0000,,to podejrzewam, że to spisek udający działanie klątwy.
Dialogue: 0,0:08:27.34,0:08:29.07,Default,,0000,0000,0000,,Spisek? Niby czyj?
Dialogue: 0,0:08:29.07,0:08:34.82,Default,,0000,0000,0000,,Normalnie bym powiedział, że kogoś, kto najbardziej korzysta na tej sytuacji...
Dialogue: 0,0:08:34.82,0:08:37.19,Default,,0000,0000,0000,,Masz na myśli mnie?
Dialogue: 0,0:08:37.19,0:08:39.94,Default,,0000,0000,0000,,Ja ci oczywiście wierzę!
Dialogue: 0,0:08:42.87,0:08:45.11,Default,,0000,0000,0000,,Taketo, nawet mnie?
Dialogue: 0,0:08:45.11,0:08:46.56,Default,,0000,0000,0000,,T-to był wypadek!
Dialogue: 0,0:08:46.56,0:08:47.42,Default,,0000,0000,0000,,Ja nic nie zrobiłem.
Dialogue: 0,0:08:48.27,0:08:50.06,Default,,0000,0000,0000,,"Zrobić to"?
Dialogue: 0,0:08:50.06,0:08:52.67,Default,,0000,0000,0000,,Nie mogę... nie tutaj...
Dialogue: 0,0:08:53.00,0:08:54.40,Default,,0000,0000,0000,,Ritsu, wzór!
Dialogue: 0,0:08:54.40,0:08:56.40,Default,,0000,0000,0000,,Wypowiedz magiczne słowa!
Dialogue: 0,0:08:56.40,0:08:58.68,Default,,0000,0000,0000,,3.141...
Dialogue: 0,0:09:11.22,0:09:13.31,Default,,0000,0000,0000,,Muszę coś z tym zrobić.
Dialogue: 0,0:09:22.80,0:09:23.72,Default,,0000,0000,0000,,Co jest?
Dialogue: 0,0:09:23.72,0:09:25.89,Default,,0000,0000,0000,,Nie uciekniesz przed klątwą.
Dialogue: 0,0:09:27.04,0:09:29.42,Default,,0000,0000,0000,,Prawdziwe piekło dopiero się zacznie.
Dialogue: 0,0:09:29.42,0:09:31.81,Default,,0000,0000,0000,,Nie mów, że... to ty?
Dialogue: 0,0:09:31.81,0:09:34.01,Default,,0000,0000,0000,,Ja tylko widzę przyszłość.
Dialogue: 0,0:09:34.74,0:09:38.30,Default,,0000,0000,0000,,I widzę, jak będziesz cierpieć...
Dialogue: 0,0:09:38.30,0:09:40.11,Default,,0000,0000,0000,,Cz-czekaj!
Dialogue: 0,0:09:43.39,0:09:46.83,Default,,0000,0000,0000,,Nie... to chyba jednak nie ty.
Dialogue: 0,0:09:49.37,0:09:53.42,Default,,0000,0000,0000,,{\i1}Jakby tak pomyśleć, wszystko do tej pory dotyczyło majtek.
Dialogue: 0,0:09:53.93,0:09:57.77,Default,,0000,0000,0000,,{\i1}Jeśli naprawdę jestem przeklęty, muszę uważać na majtki.
Dialogue: 0,0:10:00.16,0:10:02.58,Default,,0000,0000,0000,,Sz-szczęście!
Dialogue: 0,0:10:04.79,0:10:06.62,Default,,0000,0000,0000,,{\i1}T-to jest...
Dialogue: 0,0:10:08.10,0:10:10.04,Default,,0000,0000,0000,,{\i1}Zapach detergentu.
Dialogue: 0,0:10:10.04,0:10:12.10,Default,,0000,0000,0000,,{\i1}Muszą być świeżo wyprane.
Dialogue: 0,0:10:18.45,0:10:20.09,Default,,0000,0000,0000,,Czy to twoje?
Dialogue: 0,0:10:20.09,0:10:22.56,Default,,0000,0000,0000,,Tak, upuściłam je.
Dialogue: 0,0:10:22.56,0:10:24.97,Default,,0000,0000,0000,,Ale nie ma żadnego dowodu na to, że są twoje.
Dialogue: 0,0:10:25.54,0:10:27.23,Default,,0000,0000,0000,,Jeśli chcesz dowodu, to go mam.
Dialogue: 0,0:10:28.85,0:10:32.73,Default,,0000,0000,0000,,Pasują do mnie idealnie.
Dialogue: 0,0:10:32.73,0:10:35.48,Default,,0000,0000,0000,,A teraz spróbuj mi je założyć.
Dialogue: 0,0:10:36.76,0:10:38.57,Default,,0000,0000,0000,,Jesteś jak jakiś Kopciuszek, wiesz?
Dialogue: 0,0:10:40.65,0:10:42.51,Default,,0000,0000,0000,,Niezła wizja mnie naszła!
Dialogue: 0,0:10:42.51,0:10:44.05,Default,,0000,0000,0000,,Nazwę to "Szklane majtki".
Dialogue: 0,0:10:44.05,0:10:45.98,Default,,0000,0000,0000,,Chwila, wtedy nie ma sensu ich zakładać.
Dialogue: 0,0:10:46.80,0:10:48.22,Default,,0000,0000,0000,,O nie.
Dialogue: 0,0:10:48.22,0:10:50.26,Default,,0000,0000,0000,,Dałem się nabrać na majtki.
Dialogue: 0,0:10:50.26,0:10:54.24,Default,,0000,0000,0000,,Nie, nie. Jeśli je wezmę, wyniknie z tego więcej kłopotów.
Dialogue: 0,0:10:56.42,0:10:58.92,Default,,0000,0000,0000,,Czyjeś pranie musiało zostać porwane przez wiatr.
Dialogue: 0,0:10:59.39,0:11:01.70,Default,,0000,0000,0000,,Dam to komuś z ochrony.
Dialogue: 0,0:11:24.49,0:11:26.25,Default,,0000,0000,0000,,Kim ty jesteś?
Dialogue: 0,0:11:26.92,0:11:29.63,Default,,0000,0000,0000,,Nie... przestań!
Dialogue: 0,0:11:42.40,0:11:43.80,Default,,0000,0000,0000,,{\i1}Sen?
Dialogue: 0,0:11:44.50,0:11:46.50,handwriting,,0000,0000,0000,,{\pos(661,127)\frz5.613}Strach przed majtkami
Dialogue: 0,0:11:49.27,0:11:51.05,Default,,0000,0000,0000,,Ruszaj, ruszaj, Inspiracjo!
Dialogue: 0,0:11:51.05,0:11:52.65,Default,,0000,0000,0000,,Naprzód, Inspiracjo!
Dialogue: 0,0:11:52.65,0:11:54.85,Default,,0000,0000,0000,,Z-znowu majtki!
Dialogue: 0,0:11:55.83,0:11:58.39,Default,,0000,0000,0000,,Och, ale szybki!
Dialogue: 0,0:11:57.18,0:11:59.81,Default,,0000,0000,0000,,Niech mi ktoś pomoże!
Dialogue: 0,0:12:01.10,0:12:02.35,name,,0000,0000,0000,,{\c&H591AAB&\pos(544,417)}Tylko
Dialogue: 0,0:12:01.10,0:12:02.35,name,,0000,0000,0000,,{\c&H591AAB&\pos(801,421)}Dziewczyny
Dialogue: 0,0:12:05.56,0:12:06.90,Default,,0000,0000,0000,,Jak śmiałeś?
Dialogue: 0,0:12:06.90,0:12:08.95,Default,,0000,0000,0000,,T-to nie ja!
Dialogue: 0,0:12:08.95,0:12:10.76,Default,,0000,0000,0000,,A widzisz tu kogoś innego?
Dialogue: 0,0:12:10.76,0:12:12.49,Default,,0000,0000,0000,,Jak śmiałeś ujawnić mój sekret?
Dialogue: 0,0:12:12.49,0:12:13.85,Default,,0000,0000,0000,,To nieporozumienie!
Dialogue: 0,0:12:13.85,0:12:16.51,Default,,0000,0000,0000,,Poza tym, to już od dawna nie jest żadna tajemnica.
Dialogue: 0,0:12:16.51,0:12:18.91,Default,,0000,0000,0000,,Ty śmieciu!
Dialogue: 0,0:12:23.59,0:12:25.17,Default,,0000,0000,0000,,M-mogłaś mnie zabić!
Dialogue: 0,0:12:25.17,0:12:27.22,Default,,0000,0000,0000,,Wracaj do piekła!
Dialogue: 0,0:12:27.22,0:12:28.82,Default,,0000,0000,0000,,To bolało...
Dialogue: 0,0:12:33.19,0:12:37.43,Default,,0000,0000,0000,,Nie sądziłam, że przejrzysz moje zdolności ninja.
Dialogue: 0,0:12:37.43,0:12:39.36,Default,,0000,0000,0000,,Kagaku Tsukuru?
Dialogue: 0,0:12:39.36,0:12:41.43,Default,,0000,0000,0000,,To było naprawdę podłe...
Dialogue: 0,0:12:41.43,0:12:44.28,Default,,0000,0000,0000,,Zepsuliście mój Generator Boskiego Wiatru.
Dialogue: 0,0:12:44.28,0:12:46.33,Default,,0000,0000,0000,,Co ty tam robiłaś?
Dialogue: 0,0:12:46.33,0:12:47.86,Default,,0000,0000,0000,,Co to za Generator Boskiego Wiatru?
Dialogue: 0,0:12:48.15,0:12:49.99,Default,,0000,0000,0000,,Mój nowy wynalazek!
Dialogue: 0,0:12:49.99,0:12:52.95,Default,,0000,0000,0000,,Wywołuje lokalny powiew wiatru!
Dialogue: 0,0:12:52.95,0:12:56.02,Default,,0000,0000,0000,,To byłaś ty? Ty za tym wszystkim stałaś?
Dialogue: 0,0:12:56.02,0:12:57.54,Default,,0000,0000,0000,,Pozwólcie, że wyjaśnię.
Dialogue: 0,0:12:57.54,0:13:01.71,Default,,0000,0000,0000,,Najpierw używa mikrofal, by rozłożyć powietrze na poziomie atomowym...
Dialogue: 0,0:13:01.71,0:13:03.74,Default,,0000,0000,0000,,Czemu to robisz?
Dialogue: 0,0:13:04.95,0:13:06.91,Default,,0000,0000,0000,,Meiki-san mnie poprosiła!
Dialogue: 0,0:13:06.91,0:13:09.22,Default,,0000,0000,0000,,Raika? Więc to jej sprawka?
Dialogue: 0,0:13:10.92,0:13:13.97,Default,,0000,0000,0000,,Raika!
Dialogue: 0,0:13:15.05,0:13:16.97,Default,,0000,0000,0000,,Co ty sobie myślisz?
Dialogue: 0,0:13:20.26,0:13:21.81,Default,,0000,0000,0000,,Raika?
Dialogue: 0,0:13:23.53,0:13:24.44,Default,,0000,0000,0000,,Co to ma być?
Dialogue: 0,0:13:26.92,0:13:28.86,Default,,0000,0000,0000,,Rozczarowałeś mnie!
Dialogue: 0,0:13:28.86,0:13:30.85,Default,,0000,0000,0000,,Robiłaś mi zdjęcia z ukrycia?
Dialogue: 0,0:13:30.85,0:13:35.36,Default,,0000,0000,0000,,Dałam ci nawet swoją bieliznę, a to najlepsze ujęcie, jakie możesz mi dać?
Dialogue: 0,0:13:35.36,0:13:37.88,Default,,0000,0000,0000,,Więc to były twoje majtki?
Dialogue: 0,0:13:39.15,0:13:40.62,Default,,0000,0000,0000,,Więc tamto zdjęcie też...
Dialogue: 0,0:13:40.95,0:13:43.13,Default,,0000,0000,0000,,Majtki z misiem nie były dość sexy?
Dialogue: 0,0:13:47.18,0:13:50.79,Default,,0000,0000,0000,,Nawet jeśli to było tylko przez chwilę, podnieciłem się majtkami Raiki...
Dialogue: 0,0:13:50.79,0:13:52.05,Default,,0000,0000,0000,,Co masz na myśli?
Dialogue: 0,0:13:52.05,0:13:54.09,Default,,0000,0000,0000,,Co ty do mnie masz?
Dialogue: 0,0:13:54.09,0:13:55.84,Default,,0000,0000,0000,,To wszystko twoja wina!
Dialogue: 0,0:13:57.45,0:14:00.16,Default,,0000,0000,0000,,To ma być prawdziwe oblicze zboczonego pisarza-fetyszysty,
Dialogue: 0,0:14:00.16,0:14:02.30,Default,,0000,0000,0000,,którego ludzie nazywają "Chodzącym Pożądaniem"?
Dialogue: 0,0:14:02.83,0:14:04.70,Default,,0000,0000,0000,,Mężczyzna, którego unikają wszystkie dziewczyny,
Dialogue: 0,0:14:04.70,0:14:07.31,Default,,0000,0000,0000,,ten, który żyje w świecie własnych fantazji.
Dialogue: 0,0:14:07.31,0:14:10.19,Default,,0000,0000,0000,,Co się stało ze porąbanym odludkiem, Akutagawą Taketo?
Dialogue: 0,0:14:10.19,0:14:12.27,Default,,0000,0000,0000,,A więc to tak mnie postrzegasz.
Dialogue: 0,0:14:12.27,0:14:15.66,Default,,0000,0000,0000,,Póki nie odzyskasz swojego odrażającego, pokręconego blasku,
Dialogue: 0,0:14:15.66,0:14:17.66,Default,,0000,0000,0000,,nie jesteś wart fotografowania.
Dialogue: 0,0:14:18.18,0:14:21.53,Default,,0000,0000,0000,,W tym tempie moja kariera fotografistki dobiegnie końca.
Dialogue: 0,0:14:21.89,0:14:24.63,Default,,0000,0000,0000,,To ja jestem przyczyną twojego zastoju?
Dialogue: 0,0:14:24.63,0:14:25.41,Default,,0000,0000,0000,,Oczywiście!
Dialogue: 0,0:14:25.75,0:14:28.75,Default,,0000,0000,0000,,Po cholerę ci paskudne zdjęcia na ten plakat?
Dialogue: 0,0:14:28.75,0:14:32.09,Default,,0000,0000,0000,,Zrujnujesz reputację Akademii Inspiracji!
Dialogue: 0,0:14:32.83,0:14:34.61,Default,,0000,0000,0000,,Właśnie w tym problem!
Dialogue: 0,0:14:34.61,0:14:37.34,Default,,0000,0000,0000,,Zrobię to zdjęcie, choćby nie wiem co.
Dialogue: 0,0:14:38.02,0:14:42.50,Default,,0000,0000,0000,,Myliłam się, myśląc, że robienie zdjęć z ukrycia to dobry sposób na ujawnienie prawdziwej natury człowieka.
Dialogue: 0,0:14:42.50,0:14:46.06,Default,,0000,0000,0000,,Zrobię to paskudne zdjęcie, z tobą w roli modela.
Dialogue: 0,0:14:46.06,0:14:47.63,Default,,0000,0000,0000,,Ż-żartujesz, prawda?
Dialogue: 0,0:14:47.63,0:14:50.52,Default,,0000,0000,0000,,Jeśli odmówisz, opublikuję to zdjęcie.
Dialogue: 0,0:14:51.79,0:14:53.25,Default,,0000,0000,0000,,{\i1}To byłby problem.
Dialogue: 0,0:14:53.25,0:14:56.11,Default,,0000,0000,0000,,{\i1}Wątpię, bym dał radę się z tego wyplątać.
Dialogue: 0,0:14:59.15,0:15:01.61,Default,,0000,0000,0000,,Pozwól mi ze sobą współpracować.
Dialogue: 0,0:15:02.36,0:15:04.12,Default,,0000,0000,0000,,To będzie nasze studio.
Dialogue: 0,0:15:04.12,0:15:06.31,Default,,0000,0000,0000,,Czemu damska toaleta?
Dialogue: 0,0:15:06.31,0:15:09.29,Default,,0000,0000,0000,,To święta ziemia, na którą żaden mężczyzna nie ma prawa wkroczyć.
Dialogue: 0,0:15:09.29,0:15:13.63,Default,,0000,0000,0000,,A teraz zboczony drań zakrada się, by ją splugawić. {było jeszcze coś o impotencie, ale nie wiedziałem jak to przetlumaczyć}
Dialogue: 0,0:15:13.92,0:15:19.95,Default,,0000,0000,0000,,Dalej, sprofanuj damską toaletę, miejsce, gdzie dziewczyny są najbardziej bezbronne,
Dialogue: 0,0:15:19.95,0:15:22.18,Default,,0000,0000,0000,,swoimi wstrętnymi, obrzydliwymi fantazjami!
Dialogue: 0,0:15:22.18,0:15:24.85,Default,,0000,0000,0000,,Niby jak mam sprofanować łazienkę dziewczyn?
Dialogue: 0,0:15:24.85,0:15:26.84,Default,,0000,0000,0000,,Podejrzewasz mnie nawet o fetysz do budynków?
Dialogue: 0,0:15:26.84,0:15:29.06,Default,,0000,0000,0000,,Przestań gadać i zacznij działać!
Dialogue: 0,0:15:33.56,0:15:34.61,Default,,0000,0000,0000,,Wiesz co...
Dialogue: 0,0:15:35.60,0:15:37.23,Default,,0000,0000,0000,,Nie ma w tym nic paskudnego!
Dialogue: 0,0:15:37.23,0:15:40.91,Default,,0000,0000,0000,,Jeśli tylko tak siedzisz na kiblu, wygląda to tak, jakbyś po prostu załatwiał grubszą potrzebę.
Dialogue: 0,0:15:40.91,0:15:43.35,Default,,0000,0000,0000,,Przebywanie w damskiej toalecie nie ma żadnego sensu!
Dialogue: 0,0:15:43.35,0:15:44.43,Default,,0000,0000,0000,,Oczywiście, że nie.
Dialogue: 0,0:15:44.43,0:15:47.33,Default,,0000,0000,0000,,Zrób coś! Jesteś genialnym pisarzem porno.
Dialogue: 0,0:15:47.33,0:15:51.69,Default,,0000,0000,0000,,Niby co? Jeśli żadna dziewczyna z niej nie korzysta, to nie jest to żadna damska toaleta!
Dialogue: 0,0:15:53.68,0:15:55.98,Default,,0000,0000,0000,,Masz na myśli to, że to ja powinnam tam usiąść?
Dialogue: 0,0:15:56.60,0:16:00.96,Default,,0000,0000,0000,,Mężczyzna wkradający się i podglądający sikającą dziewczynę.
Dialogue: 0,0:16:01.87,0:16:04.89,Default,,0000,0000,0000,,Już łapię. Faktycznie, wyjątkowo paskudne.
Dialogue: 0,0:16:04.89,0:16:05.60,Default,,0000,0000,0000,,Niech będzie.
Dialogue: 0,0:16:07.02,0:16:08.17,Default,,0000,0000,0000,,Ch-ch-chwila!
Dialogue: 0,0:16:08.17,0:16:11.89,Default,,0000,0000,0000,,Jestem profesjonalistką. Jestem gotowa oddać siebie dla tego zdjęcia.
Dialogue: 0,0:16:11.89,0:16:14.10,Default,,0000,0000,0000,,Chwila moment. Nie możesz tego zrobić!
Dialogue: 0,0:16:14.10,0:16:16.51,Default,,0000,0000,0000,,Sztuka wymaga poświęceń!
Dialogue: 0,0:16:19.07,0:16:21.11,Default,,0000,0000,0000,,Taketo-kun?
Dialogue: 0,0:16:21.11,0:16:24.28,Default,,0000,0000,0000,,U-Utae-san...
Dialogue: 0,0:16:24.28,0:16:26.29,Default,,0000,0000,0000,,Co ty wyprawiasz, zboczeńcu?
Dialogue: 0,0:16:26.29,0:16:27.27,Default,,0000,0000,0000,,To nie tak!
Dialogue: 0,0:16:27.96,0:16:29.59,Default,,0000,0000,0000,,To Raika...
Dialogue: 0,0:16:33.32,0:16:34.87,Default,,0000,0000,0000,,Nie zostawiaj mnie!
Dialogue: 0,0:16:34.87,0:16:36.28,Default,,0000,0000,0000,,Ty zboku!
Dialogue: 0,0:16:36.28,0:16:38.40,Default,,0000,0000,0000,,Tym razem się nie wykręcisz.
Dialogue: 0,0:16:38.40,0:16:39.88,Default,,0000,0000,0000,,Mówię przecież, że...
Dialogue: 0,0:16:39.88,0:16:41.38,Default,,0000,0000,0000,,Czekajcie, dziewczyny!
Dialogue: 0,0:16:41.97,0:16:43.54,Default,,0000,0000,0000,,Nie wyciągajmy pochopnych wniosków.
Dialogue: 0,0:16:43.54,0:16:46.56,Default,,0000,0000,0000,,Może przyszedł tu po materiał do swojej powieści.
Dialogue: 0,0:16:47.29,0:16:48.69,Default,,0000,0000,0000,,Ale...
Dialogue: 0,0:16:49.52,0:16:52.39,Default,,0000,0000,0000,,Myślę, że to i tak by mnie nie usprawiedliwiało.
Dialogue: 0,0:16:54.98,0:16:56.61,Default,,0000,0000,0000,,C-co jest?
Dialogue: 0,0:17:07.13,0:17:08.52,Default,,0000,0000,0000,,Menedżerze...
Dialogue: 0,0:17:08.52,0:17:12.08,Default,,0000,0000,0000,,Cała przemokłam.
Dialogue: 0,0:17:12.61,0:17:15.07,Default,,0000,0000,0000,,Tam pod spodem też?
Dialogue: 0,0:17:15.71,0:17:17.65,Default,,0000,0000,0000,,Ściągaj to.
Dialogue: 0,0:17:17.65,0:17:21.76,Default,,0000,0000,0000,,Twoi fani chcą się zabawić twoją wodą.
Dialogue: 0,0:17:22.35,0:17:25.26,Default,,0000,0000,0000,,Dobrze... jeśli to dla fanów...
Dialogue: 0,0:17:26.64,0:17:28.03,Default,,0000,0000,0000,,{\i1}N-niedobrze!
Dialogue: 0,0:17:28.93,0:17:30.37,Default,,0000,0000,0000,,To jest to! Ruszaj!
Dialogue: 0,0:17:30.37,0:17:33.71,Default,,0000,0000,0000,,Zboczony pisarz-fetyszysta, który profanuje przemoczoną idolkę w damskiej toalecie...
Dialogue: 0,0:17:33.71,0:17:35.94,Default,,0000,0000,0000,,To jest mój Akutagawa Taketo!
Dialogue: 0,0:17:35.94,0:17:37.60,Default,,0000,0000,0000,,Raika!
Dialogue: 0,0:17:38.95,0:17:41.99,Default,,0000,0000,0000,,Miałem szczęście, że mi wybaczyły, ale...
Dialogue: 0,0:17:41.99,0:17:43.28,Default,,0000,0000,0000,,Co ty wyprawiałaś?
Dialogue: 0,0:17:44.86,0:17:48.31,Default,,0000,0000,0000,,Byłam już tak blisko zrobienia niesamowicie paskudnego zdjęcia.
Dialogue: 0,0:17:48.31,0:17:49.83,Default,,0000,0000,0000,,Ty tchórzu!
Dialogue: 0,0:17:49.83,0:17:53.79,Default,,0000,0000,0000,,Skąd u ciebie taka obsesja na punkcie paskudnych zdjęć?
Dialogue: 0,0:17:53.79,0:17:56.69,Default,,0000,0000,0000,,Robię paskudne zdjęcia.
Dialogue: 0,0:17:56.69,0:17:58.38,Default,,0000,0000,0000,,Robię to, bo muszę.
Dialogue: 0,0:17:58.75,0:18:00.37,Default,,0000,0000,0000,,Czemu?
Dialogue: 0,0:18:00.37,0:18:02.42,Default,,0000,0000,0000,,Jutro spróbujemy ponownie.
Dialogue: 0,0:18:02.42,0:18:03.09,Default,,0000,0000,0000,,Nara.
Dialogue: 0,0:18:03.39,0:18:06.56,Default,,0000,0000,0000,,Nie wciągaj już w to nikogo więcej!
Dialogue: 0,0:18:06.56,0:18:09.61,Default,,0000,0000,0000,,Jeśli w grę wchodzi sztuka, nie ma czegoś takiego jak tabu.
Dialogue: 0,0:18:11.61,0:18:14.64,Default,,0000,0000,0000,,Muszę coś z tym zrobić...
Dialogue: 0,0:18:27.57,0:18:29.77,Default,,0000,0000,0000,,{\i1}Niech cię, Raika!
Dialogue: 0,0:18:29.77,0:18:31.95,Default,,0000,0000,0000,,{\i1}Mówić to wszystko...
Dialogue: 0,0:18:31.95,0:18:35.64,Default,,0000,0000,0000,,{\i1}Zrobię ci to, i to, i jeszcze to!
Dialogue: 0,0:18:37.62,0:18:39.58,newspaper,,0000,0000,0000,,{\frz14.95\pos(669,486)}{\c&H000000&}Szatnia Dziewcząt
Dialogue: 0,0:18:39.93,0:18:42.96,Default,,0000,0000,0000,,Ten słodki zapach potu i dezodorantu...
Dialogue: 0,0:18:44.49,0:18:46.27,Default,,0000,0000,0000,,Czemu szatnia dziewczyn?
Dialogue: 0,0:18:46.27,0:18:49.21,Default,,0000,0000,0000,,To święta ziemia, na którą żaden mężczyzna nie ma prawa wkroczyć.
Dialogue: 0,0:18:49.21,0:18:53.47,Default,,0000,0000,0000,,A teraz zboczony pisarz-ekshibicjonista zakrada się, by ją splugawić.
Dialogue: 0,0:18:53.47,0:18:57.40,Default,,0000,0000,0000,,Dalej, sprofanuj szatnię dziewczyn, miejsce, gdzie dziewczyny odsłaniają wszystko,
Dialogue: 0,0:18:57.40,0:19:01.46,Default,,0000,0000,0000,,swoimi wstrętnymi, odrażającymi fantazjami.
Dialogue: 0,0:19:01.46,0:19:04.16,Default,,0000,0000,0000,,Dokładnie to samo mówiłaś wczoraj w damskiej toalecie.
Dialogue: 0,0:19:04.16,0:19:05.07,Default,,0000,0000,0000,,Nie robisz żadnych postępów.
Dialogue: 0,0:19:05.07,0:19:06.20,Default,,0000,0000,0000,,Zamknij się!
Dialogue: 0,0:19:06.20,0:19:07.11,Default,,0000,0000,0000,,Do roboty!
Dialogue: 0,0:19:07.11,0:19:08.11,Default,,0000,0000,0000,,W życiu!
Dialogue: 0,0:19:08.11,0:19:10.86,Default,,0000,0000,0000,,Dalej, sprofanuj ją wreszcie!
Dialogue: 0,0:19:12.80,0:19:13.97,Default,,0000,0000,0000,,Co ty wyprawiasz?
Dialogue: 0,0:19:13.97,0:19:18.42,Default,,0000,0000,0000,,Zaczynamy! Uwiecznię twój najpaskudniejszy moment.
Dialogue: 0,0:19:18.42,0:19:19.29,Default,,0000,0000,0000,,Nie mogę!
Dialogue: 0,0:19:19.29,0:19:21.44,Default,,0000,0000,0000,,Zrób to! Natychmiast!
Dialogue: 0,0:19:22.50,0:19:25.33,Default,,0000,0000,0000,,{\i1}Ona jest niebezpieczna!
Dialogue: 0,0:19:26.09,0:19:29.42,Default,,0000,0000,0000,,Już rozumiem... Nie masz dość materiału do fantazjowania, co?
Dialogue: 0,0:19:30.55,0:19:32.17,Default,,0000,0000,0000,,H-hej!
Dialogue: 0,0:19:32.89,0:19:37.60,Default,,0000,0000,0000,,Wygląda na to, że zdjęcia i świeżo wyprane majtki ci nie wystarczą.
Dialogue: 0,0:19:39.29,0:19:41.85,Default,,0000,0000,0000,,I jak? Lepsze od zdjęcia, nie?
Dialogue: 0,0:19:41.85,0:19:43.87,Default,,0000,0000,0000,,{\i1}Właściwie to całkiem urocze...
Dialogue: 0,0:19:43.87,0:19:46.11,Default,,0000,0000,0000,,{\i1}Nie przypuszczałem, że Raika może tak dobrze wyglądać w czymś takim.
Dialogue: 0,0:19:46.65,0:19:48.64,Default,,0000,0000,0000,,Dam ci te, dopiero co noszone.
Dialogue: 0,0:19:48.64,0:19:50.32,Default,,0000,0000,0000,,To musi cię zadowolić, prawda?
Dialogue: 0,0:19:50.32,0:19:52.21,Default,,0000,0000,0000,,W rzeczy samej!
Dialogue: 0,0:19:52.21,0:19:54.55,Default,,0000,0000,0000,,Chwila, to jest już przegięcie!
Dialogue: 0,0:19:54.55,0:19:57.62,Default,,0000,0000,0000,,Moją pracą jako fotografistki jest zrobienie wszystkiego, czego potrzeba dla zrobienia zdjęcia.
Dialogue: 0,0:19:57.95,0:19:59.83,Default,,0000,0000,0000,,N-nie ściągaj ich!
Dialogue: 0,0:20:03.94,0:20:06.29,Default,,0000,0000,0000,,Zamierzasz mnie przelecieć?
Dialogue: 0,0:20:06.83,0:20:07.84,Default,,0000,0000,0000,,Nie, to jest...
Dialogue: 0,0:20:07.84,0:20:10.41,Default,,0000,0000,0000,,Nie sądziłam, że to ty zrobisz pierwszy krok.
Dialogue: 0,0:20:10.41,0:20:11.78,Default,,0000,0000,0000,,P-przepraszam!
Dialogue: 0,0:20:14.02,0:20:15.67,Default,,0000,0000,0000,,Ty tchórzu!
Dialogue: 0,0:20:15.67,0:20:18.76,Default,,0000,0000,0000,,Jeśli ty nie potrafisz, to ja to zrobię!
Dialogue: 0,0:20:18.76,0:20:20.36,Default,,0000,0000,0000,,P-przestań!
Dialogue: 0,0:20:20.36,0:20:21.71,Default,,0000,0000,0000,,O co chodzi?
Dialogue: 0,0:20:21.71,0:20:23.92,Default,,0000,0000,0000,,Tylko mnie to zaboli.
Dialogue: 0,0:20:30.68,0:20:31.70,Default,,0000,0000,0000,,Ja...
Dialogue: 0,0:20:31.70,0:20:35.10,Default,,0000,0000,0000,,Patrzą na mnie.
Dialogue: 0,0:20:35.10,0:20:37.15,Default,,0000,0000,0000,,Na moją brzydotę...
Dialogue: 0,0:20:37.15,0:20:39.72,Default,,0000,0000,0000,,Widzę to.
Dialogue: 0,0:20:40.82,0:20:42.15,Default,,0000,0000,0000,,Raika?
Dialogue: 0,0:20:42.15,0:20:43.60,Default,,0000,0000,0000,,Nie patrz na mnie!
Dialogue: 0,0:20:43.60,0:20:45.71,Default,,0000,0000,0000,,Nie! Nie patrz!
Dialogue: 0,0:20:48.74,0:20:51.04,Default,,0000,0000,0000,,Fotografistka zdała sobie sprawę z tego,
Dialogue: 0,0:20:51.04,0:20:53.93,Default,,0000,0000,0000,,że miliony oczu skierowane są na nią.
Dialogue: 0,0:20:53.93,0:20:58.06,Default,,0000,0000,0000,,I że była całkowicie odsłonięta.
Dialogue: 0,0:20:59.22,0:21:01.39,Default,,0000,0000,0000,,Nie mogła niczego ukryć.
Dialogue: 0,0:21:01.39,0:21:04.56,Default,,0000,0000,0000,,Ponieważ sama tego pragnęła.
Dialogue: 0,0:21:04.56,0:21:06.35,Default,,0000,0000,0000,,Chciała zostać dostrzeżona.
Dialogue: 0,0:21:08.86,0:21:10.11,Default,,0000,0000,0000,,Nie!
Dialogue: 0,0:21:10.11,0:21:12.37,Default,,0000,0000,0000,,Czekała na to...
Dialogue: 0,0:21:12.37,0:21:14.57,Default,,0000,0000,0000,,...by zostać pokazana.
Dialogue: 0,0:21:15.10,0:21:17.54,Default,,0000,0000,0000,,Ukazana w całej swej wstydliwości.
Dialogue: 0,0:21:18.12,0:21:21.03,Default,,0000,0000,0000,,To, co chciała sfotografować najbardziej na świecie,
Dialogue: 0,0:21:21.03,0:21:23.12,Default,,0000,0000,0000,,było tuż przed nią.
Dialogue: 0,0:21:23.12,0:21:25.32,Default,,0000,0000,0000,,Pokaż. Pokaż im...
Dialogue: 0,0:21:25.32,0:21:27.64,Default,,0000,0000,0000,,...swoje paskudne oblicze!
Dialogue: 0,0:21:27.64,0:21:29.41,Default,,0000,0000,0000,,Pokaż siebie!
Dialogue: 0,0:21:34.11,0:21:35.34,Default,,0000,0000,0000,,Paskudna...
Dialogue: 0,0:21:36.78,0:21:38.64,Default,,0000,0000,0000,,Jestem paskudna.
Dialogue: 0,0:21:39.52,0:21:40.89,Default,,0000,0000,0000,,Paskudna jesteś!
Dialogue: 0,0:21:40.89,0:21:44.15,Default,,0000,0000,0000,,Raika!
Dialogue: 0,0:21:49.83,0:21:51.65,Default,,0000,0000,0000,,Skończyłam ten plakat, Taketo.
Dialogue: 0,0:21:53.37,0:21:55.28,Default,,0000,0000,0000,,Wygląda na to, że wreszcie wyrwałaś się z zastoju.
Dialogue: 0,0:21:55.28,0:21:57.94,Default,,0000,0000,0000,,Ta. To już chyba koniec.
Dialogue: 0,0:21:57.94,0:21:59.77,Default,,0000,0000,0000,,Czuję się lepiej.
Dialogue: 0,0:22:00.90,0:22:02.33,Default,,0000,0000,0000,,Dzięki tobie.
Dialogue: 0,0:22:02.33,0:22:04.29,Default,,0000,0000,0000,,Nie, co ty...
Dialogue: 0,0:22:04.29,0:22:05.50,Default,,0000,0000,0000,,Cieszę się.
Dialogue: 0,0:22:05.50,0:22:07.28,Default,,0000,0000,0000,,Popatrz na to!
Dialogue: 0,0:22:07.28,0:22:09.23,Default,,0000,0000,0000,,Jest doskonałe.
Dialogue: 0,0:22:09.23,0:22:11.73,Default,,0000,0000,0000,,C-co to ma być?
Dialogue: 0,0:22:11.73,0:22:14.01,Default,,0000,0000,0000,,Moje podziękowanie dla ciebie.
Dialogue: 0,0:22:14.01,0:22:15.44,Default,,0000,0000,0000,,Niby gdzie?
Dialogue: 0,0:22:17.65,0:22:19.98,Default,,0000,0000,0000,,Nie wstyd ci?
Dialogue: 0,0:22:19.98,0:22:23.50,Default,,0000,0000,0000,,Najlepsza fotografistka jest jednocześnie najlepszym tematem dla zdjęcia.
Dialogue: 0,0:22:23.50,0:22:24.36,Default,,0000,0000,0000,,Czyż nie?
Dialogue: 0,0:22:24.36,0:22:26.14,Default,,0000,0000,0000,,Więc fotografuj tylko siebie.
Dialogue: 0,0:22:27.12,0:22:31.55,Default,,0000,0000,0000,,Oboje jesteśmy paskudni, nie sądzisz, że do siebie pasujemy?
