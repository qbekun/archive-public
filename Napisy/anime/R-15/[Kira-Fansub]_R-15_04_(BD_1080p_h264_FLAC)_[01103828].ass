Dialogue: 0,0:22:33.73,0:22:36.58,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.58,0:22:39.15,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.24,0:22:52.49,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.64,0:22:54.07,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.11,0:22:55.34,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.34,0:22:56.72,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:56.94,0:22:58.21,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.36,0:22:59.78,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.82,0:23:02.11,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.43,0:23:05.65,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.73,0:23:07.87,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:07.98,0:23:10.50,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.52,0:23:12.76,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.02,0:23:14.57,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.59,0:23:15.82,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:15.89,0:23:18.56,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.73,0:23:20.01,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.14,0:23:23.78,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.47,0:23:25.85,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:25.89,0:23:27.32,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.36,0:23:29.99,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.12,0:23:32.45,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.45,0:23:35.17,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.59,0:23:39.43,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.46,0:23:42.00,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.36,0:24:05.83,Introduction/Gauge,,0000,0000,0000,,{\c&H222D38&\fscx115\fscy115\pos(635,266)\fs75}Wskaźnik dzisiejszego krwawienia z nosa
Dialogue: 0,0:24:07.45,0:24:08.71,Default,,0000,0000,0000,,Nie rozlej!
Dialogue: 0,0:24:08.71,0:24:11.80,Default,,0000,0000,0000,,To ja będę tą, która się wścieknie.
Dialogue: 0,0:24:12.42,0:24:27.43,Title,,0000,0000,0000,,{\pos(820,249)}{}W następnym odcinku:
Dialogue: 0,0:24:12.42,0:24:27.43,Title,,0000,0000,0000,,{\pos(955,304)}Korzyści ponad przyjaźnią.
Dialogue: 0,0:24:12.96,0:24:14.49,Default,,0000,0000,0000,,Tu Meiki Raika.
Dialogue: 0,0:24:14.49,0:24:16.74,Default,,0000,0000,0000,,Nie tam! Ile razy mam ci powtarzać?
Dialogue: 0,0:24:16.74,0:24:18.52,Default,,0000,0000,0000,,Nie tam mnie swędzi...
Dialogue: 0,0:24:20.62,0:24:22.32,Default,,0000,0000,0000,,Jesteś idiotą czy co?
Dialogue: 0,0:24:22.32,0:24:23.63,Default,,0000,0000,0000,,Nie tam!
Dialogue: 0,0:24:26.07,0:24:27.43,Default,,0000,0000,0000,,Nie dotykaj tam!
