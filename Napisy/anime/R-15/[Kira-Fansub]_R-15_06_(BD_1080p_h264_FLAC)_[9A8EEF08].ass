Dialogue: 0,0:01:24.82,0:01:27.02,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:01:36.14,0:01:38.68,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:01:38.79,0:01:40.69,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:01:41.29,0:01:46.21,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:01:47.41,0:01:52.05,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:01:52.59,0:01:57.57,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:01:58.76,0:02:01.32,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:02:01.56,0:02:04.00,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:02:04.40,0:02:05.46,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:02:05.46,0:02:06.53,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:02:06.53,0:02:08.93,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:02:09.23,0:02:11.78,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:02:12.10,0:02:14.82,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:02:15.16,0:02:17.90,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:02:17.97,0:02:20.92,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:02:20.99,0:02:23.10,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:02:23.29,0:02:26.10,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:02:26.40,0:02:29.24,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:02:29.29,0:02:31.98,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:02:32.09,0:02:34.38,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:02:32.59,0:02:35.35,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:34.55,0:02:37.03,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:35.41,0:02:38.17,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:37.35,0:02:39.83,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:38.28,0:02:39.85,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:02:40.20,0:02:43.02,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:02:55.62,0:03:00.00,Title,,0000,0000,0000,,{\fad(1000,1000)\pos(850,580)}Co, jeśli menedżer Akademii Inspiracji...
Dialogue: 0,0:03:08.52,0:03:14.99,Softball Game,,0000,0000,0000,,{\be5\pos(640,5)}Mistrzostwa gimnazjalistów w Softballu!
Dialogue: 0,0:03:13.56,0:03:15.68,Dialogue,,0000,0000,0000,,Trzy auty! Zmiana!
Dialogue: 0,0:03:15.69,0:03:18.24,Dialogue,,0000,0000,0000,,Kolejna runda bez punktów dla Nagano.
Dialogue: 0,0:03:19.07,0:03:23.01,Dialogue,,0000,0000,0000,,To jest nagranie z finału zeszłorocznych krajowych mistrzostw gimnazjalistów w softballu.
Dialogue: 0,0:03:23.01,0:03:24.35,Dialogue,,0000,0000,0000,,Jeden zespół był bardzo doświadczony,
Dialogue: 0,0:03:24.35,0:03:27.45,Dialogue,,0000,0000,0000,,a drugi nigdy wcześniej nie przeszedł nawet przez eliminacje.
Dialogue: 0,0:03:27.86,0:03:29.44,Dialogue,,0000,0000,0000,,Jak myślisz, który wygrał?
Dialogue: 0,0:03:30.38,0:03:32.25,Dialogue,,0000,0000,0000,,Ten doświadczony, prawda?
Dialogue: 0,0:03:32.29,0:03:34.75,Softball Game,,0000,0000,0000,,{\be5\pos(640,5)}Mistrzostwa gimnazjalistów w Softballu!
Dialogue: 0,0:03:33.45,0:03:34.75,Dialogue,,0000,0000,0000,,I koniec!
Dialogue: 0,0:03:35.09,0:03:38.05,Dialogue,,0000,0000,0000,,Po raz pierwszy wygrywa Gimnazjum Sumikawa!
Dialogue: 0,0:03:38.08,0:03:39.05,Dialogue,,0000,0000,0000,,Pudło.
Dialogue: 0,0:03:41.46,0:03:42.90,Dialogue,,0000,0000,0000,,Sekret tkwi w {\i1}niej{\i0}.
Dialogue: 0,0:03:43.76,0:03:44.82,Dialogue,,0000,0000,0000,,Kim ona jest?
Dialogue: 0,0:03:49.04,0:03:54.50,Dialogue,,0000,0000,0000,,Genialny menedżer, który potrafi poprowadzić do zwycięstwa każdą drużynę, nieważne jak słabą!
Dialogue: 0,0:03:54.50,0:03:56.13,Dialogue,,0000,0000,0000,,M-miło cię poznać.
Dialogue: 0,0:03:56.13,0:03:57.31,Dialogue,,0000,0000,0000,,Jestem Kurabu Katsuyo.
Dialogue: 0,0:04:01.33,0:04:04.32,Introduction/Gauge,,0000,0000,0000,,{\fad(530,0)\pos(979,57)}Kurabu Katsuyo
Dialogue: 0,0:04:02.33,0:04:04.32,Introduction/Gauge,,0000,0000,0000,,{\fad(1000,0)\pos(268,109)}Genialny Menedżer
Dialogue: 0,0:04:15.14,0:04:16.06,Dialogue,,0000,0000,0000,,Taketo...
Dialogue: 0,0:04:21.02,0:04:25.82,Canned Beef,,0000,0000,0000,,{\fad(250,0)\frz32.488\frx356\fry18\pos(791,516)}Puszkowana Wołowina
Dialogue: 0,0:04:21.28,0:04:22.60,Dialogue,,0000,0000,0000,,C-co to ma być?
Dialogue: 0,0:04:22.98,0:04:24.96,Dialogue,,0000,0000,0000,,No dobra, resztę zostawiam wam!
Dialogue: 0,0:04:26.39,0:04:27.86,Dialogue,,0000,0000,0000,,Sz-szefie!
Dialogue: 0,0:04:28.55,0:04:30.13,Dialogue,,0000,0000,0000,,Witaj w zapuszkowanym pokoju.
Dialogue: 0,0:04:32.13,0:04:34.89,Dialogue,,0000,0000,0000,,Zostało ci 48 godzin.
Dialogue: 0,0:04:34.89,0:04:37.10,Dialogue,,0000,0000,0000,,Nie możesz juz więcej przegapić terminu.
Dialogue: 0,0:04:37.10,0:04:38.36,Dialogue,,0000,0000,0000,,Czas start!
Dialogue: 0,0:04:39.69,0:04:41.41,Dialogue,,0000,0000,0000,,Jestem pewna, że wszystko będzie dobrze.
Dialogue: 0,0:04:41.41,0:04:44.16,Dialogue,,0000,0000,0000,,Wierzę w ciebie, Akutagawa-sensei.
Dialogue: 0,0:04:44.51,0:04:46.46,Dialogue,,0000,0000,0000,,Bierzmy się do pracy!
Dialogue: 0,0:04:48.58,0:04:50.34,Dialogue,,0000,0000,0000,,Och, racja...
Dialogue: 0,0:04:50.34,0:04:53.15,Dialogue,,0000,0000,0000,,Nie na tym polega praca pisarza.
Dialogue: 0,0:04:53.15,0:04:55.70,Dialogue,,0000,0000,0000,,Przepraszam. Pomyliłam się.
Dialogue: 0,0:04:55.91,0:04:57.71,Dialogue,,0000,0000,0000,,Głupia, głupia, głupia!
Dialogue: 0,0:04:58.09,0:05:00.64,Dialogue,,0000,0000,0000,,Nieważne. Nie przejmuj się tym.
Dialogue: 0,0:05:00.81,0:05:01.82,Dialogue,,0000,0000,0000,,Masz rację.
Dialogue: 0,0:05:01.82,0:05:04.32,Dialogue,,0000,0000,0000,,Nie mogę się poddawać z powodu zastoju.
Dialogue: 0,0:05:04.32,0:05:05.61,Dialogue,,0000,0000,0000,,Akutagawa-sensei!
Dialogue: 0,0:05:05.78,0:05:08.22,Dialogue,,0000,0000,0000,,Muszę się bardziej przyłożyć! Jeej!
Dialogue: 0,0:05:08.22,0:05:09.31,Dialogue,,0000,0000,0000,,Co za ulga.
Dialogue: 0,0:05:09.31,0:05:11.69,Dialogue,,0000,0000,0000,,Zawsze pracowałam z klubami sportowymi.
Dialogue: 0,0:05:11.69,0:05:14.74,Dialogue,,0000,0000,0000,,To mój pierwszy raz, kiedy pomagam klubowi kulturalnemu, więc trochę się martwiłam.
Dialogue: 0,0:05:16.20,0:05:17.87,Dialogue,,0000,0000,0000,,Akutagawa-sensei,
Dialogue: 0,0:05:17.87,0:05:19.70,Dialogue,,0000,0000,0000,,dajmy z siebie wszystko, dobrze?
Dialogue: 0,0:05:19.70,0:05:21.20,Dialogue,,0000,0000,0000,,Daj sobie spokój z tym "Sensei".
Dialogue: 0,0:05:22.32,0:05:23.87,Dialogue,,0000,0000,0000,,Mów mi Taketo.
Dialogue: 0,0:05:23.87,0:05:26.28,Dialogue,,0000,0000,0000,,Więc ty możesz mi mówić Katsuyo!
Dialogue: 0,0:05:26.59,0:05:28.14,Dialogue,,0000,0000,0000,,Dobrze, Katsuyo-chan.
Dialogue: 0,0:05:28.14,0:05:29.78,Dialogue,,0000,0000,0000,,Mam nadzieję, że będzie się nam miło pracować!
Dialogue: 0,0:05:31.22,0:05:35.21,Thoughts,,0000,0000,0000,,Cóż, bądź co bądź, jest tu by mnie wspierać.
Dialogue: 0,0:05:35.47,0:05:38.39,Thoughts,,0000,0000,0000,,Martwi mnie to, że to szefowa ją przyprowadziła.
Dialogue: 0,0:05:38.54,0:05:40.12,Dialogue,,0000,0000,0000,,Zapraszam do twojego biurka.
Dialogue: 0,0:05:41.03,0:05:44.14,Dialogue,,0000,0000,0000,,Przygotowałam ci papier i przybory do pisania.
Dialogue: 0,0:05:45.11,0:05:47.72,Dialogue,,0000,0000,0000,,Jeśli będziesz jeszcze czegoś potrzebował, po prostu mi powiedz, dobrze?
Dialogue: 0,0:05:47.97,0:05:50.76,Canned Beef,,0000,0000,0000,,{\fs60\frx12\fry16\frz3.156\pos(904,551)}Puszkowana Wołowina
Dialogue: 0,0:05:48.10,0:05:49.82,Dialogue,,0000,0000,0000,,O-okej!
Dialogue: 0,0:05:53.92,0:05:56.94,Time,,0000,0000,0000,,{\fad(1000,0)\pos(1180,607)}Południe: Minęły 2 godziny
Dialogue: 0,0:06:09.77,0:06:11.95,Dialogue,,0000,0000,0000,,To ja idę się przebrać.
Dialogue: 0,0:06:16.17,0:06:17.84,Thoughts,,0000,0000,0000,,P-przebrać?
Dialogue: 0,0:06:18.58,0:06:20.65,Thoughts,,0000,0000,0000,,teraz, za tymi drzwiami...
Dialogue: 0,0:06:29.55,0:06:31.02,Dialogue,,0000,0000,0000,,T-to jest...
Dialogue: 0,0:06:33.68,0:06:35.12,Dialogue,,0000,0000,0000,,Nic z tego. Żadnych pomysłów.
Dialogue: 0,0:06:36.70,0:06:40.63,Dialogue,,0000,0000,0000,,Normalnie takie coś starczyłoby mi na jakieś 40 stron.
Dialogue: 0,0:06:41.61,0:06:45.00,Dialogue,,0000,0000,0000,,W każdym razie, muszę pisać. Rubryki, krótkie opowiadania, książki...
Dialogue: 0,0:06:45.48,0:06:46.40,Dialogue,,0000,0000,0000,,Kończy mi się czas!
Dialogue: 0,0:06:46.75,0:06:49.73,Dialogue,,0000,0000,0000,,Co ze mną będzie, jeśli nie będę już mógł pisać?
Dialogue: 0,0:06:55.16,0:06:58.55,Dialogue,,0000,0000,0000,,L-O-V-E... Akutagawa!
Dialogue: 0,0:06:58.55,0:07:01.62,Dialogue,,0000,0000,0000,,C-U-T-E... Taketo, jej!
Dialogue: 0,0:07:02.25,0:07:05.03,Dialogue,,0000,0000,0000,,Cieszy mnie to, ale proszę, bądź cicho.
Dialogue: 0,0:07:06.08,0:07:08.62,Time,,0000,0000,0000,,{\fad(1000,0)\pos(1220,605)}13:00 : Minęły 3 godziny
Dialogue: 0,0:07:09.63,0:07:11.12,Dialogue,,0000,0000,0000,,Słyszałaś, Onee-sama?
Dialogue: 0,0:07:11.47,0:07:12.38,Dialogue,,0000,0000,0000,,O czym?
Dialogue: 0,0:07:12.38,0:07:14.16,Dialogue,,0000,0000,0000,,O Akutagawie Taketo.
Dialogue: 0,0:07:15.43,0:07:17.72,Dialogue,,0000,0000,0000,,Nie ma go, bo musi sie wyrobić przed deadlinem, racja?
Dialogue: 0,0:07:17.72,0:07:22.55,Dialogue,,0000,0000,0000,,Słyszałam, że ma zastój, i że jest gdzieś zamknięty, póki nie skończy pracy.
Dialogue: 0,0:07:23.55,0:07:26.42,Dialogue,,0000,0000,0000,,Wolę, gdy go nie ma, od razu jest ciszej.
Dialogue: 0,0:07:26.42,0:07:29.06,Dialogue,,0000,0000,0000,,Może wykorzysta tą szansę, by stać się lepszym człowiekiem.
Dialogue: 0,0:07:29.52,0:07:30.56,Dialogue,,0000,0000,0000,,Zamknięty?
Dialogue: 0,0:07:42.18,0:07:43.02,Thoughts,,0000,0000,0000,,Niezłe!
Dialogue: 0,0:07:43.02,0:07:46.26,Thoughts,,0000,0000,0000,,Może powinienem jeszcze raz rozważyć, czy fartuszek i mundurek
Dialogue: 0,0:07:46.26,0:07:48.27,Thoughts,,0000,0000,0000,,to rzeczywiście utarte schematy.
Dialogue: 0,0:07:48.27,0:07:49.25,Dialogue,,0000,0000,0000,,Taketo-kun.
Dialogue: 0,0:07:50.11,0:07:53.26,Dialogue,,0000,0000,0000,,Lunch już prawie gotowy. Poczekaj jeszcze chwilę, dobrze?
Dialogue: 0,0:07:55.42,0:07:56.74,Thoughts,,0000,0000,0000,,Już mam!
Dialogue: 0,0:08:05.03,0:08:06.27,Thoughts,,0000,0000,0000,,A jednak nie.
Dialogue: 0,0:08:06.44,0:08:07.76,Dialogue,,0000,0000,0000,,Gotowe!
Dialogue: 0,0:08:07.99,0:08:09.83,Dialogue,,0000,0000,0000,,J-już?
Dialogue: 0,0:08:09.83,0:08:11.87,Dialogue,,0000,0000,0000,,He? Za wcześnie?
Dialogue: 0,0:08:11.87,0:08:13.99,Dialogue,,0000,0000,0000,,Nie, w porządku. Dzięki.
Dialogue: 0,0:08:13.99,0:08:16.78,Dialogue,,0000,0000,0000,,Jeszcze nigdy nie jadłem posiłku własnoręcznie przyrządzonego przez dziewczynę.
Dialogue: 0,0:08:16.78,0:08:19.25,Dialogue,,0000,0000,0000,,Zjedz dużo i odnów siły.
Dialogue: 0,0:08:19.25,0:08:19.79,Dialogue,,0000,0000,0000,,Dobra!
Dialogue: 0,0:08:20.11,0:08:22.78,Dialogue,,0000,0000,0000,,Proszę, jedz póki ciepłe.
Dialogue: 0,0:08:23.64,0:08:25.02,Dialogue,,0000,0000,0000,,Co to ma być?!
Dialogue: 0,0:08:25.02,0:08:29.67,Dialogue,,0000,0000,0000,,To specjalny oczny gulasz z tuńczykiem od Katsuyo! Jest dobry dla mózgu!
Dialogue: 0,0:08:30.59,0:08:32.31,Dialogue,,0000,0000,0000,,Proszę, wcinaj!
Dialogue: 0,0:08:37.53,0:08:38.57,Dialogue,,0000,0000,0000,,Taketo-kun?
Dialogue: 0,0:08:38.57,0:08:40.37,Dialogue,,0000,0000,0000,,Co się stało, Taketo-kun?
Dialogue: 0,0:08:40.37,0:08:42.61,Dialogue,,0000,0000,0000,,{\fad(0,2000)}Taketo-kun!
Dialogue: 0,0:08:44.77,0:08:45.77,Dialogue,,0000,0000,0000,,Katsuyo-kun!
Dialogue: 0,0:08:46.23,0:08:47.26,Dialogue,,0000,0000,0000,,T-tak?
Dialogue: 0,0:08:47.26,0:08:51.40,Dialogue,,0000,0000,0000,,Jaka część ludzkiego ciała może urosnąć sześć razy większa niż normalnie?
Dialogue: 0,0:08:52.23,0:08:53.24,Dialogue,,0000,0000,0000,,Jaka część?
Dialogue: 0,0:08:54.27,0:08:55.56,Dialogue,,0000,0000,0000,,P-p-p-penii—
Dialogue: 0,0:08:55.71,0:08:57.26,Dialogue,,0000,0000,0000,,Głupia!
Dialogue: 0,0:08:57.26,0:08:59.15,Dialogue,,0000,0000,0000,,Uważaj na słowa!
Dialogue: 0,0:08:59.87,0:09:01.13,Dialogue,,0000,0000,0000,,P-przepraszam!
Dialogue: 0,0:09:01.73,0:09:02.68,Dialogue,,0000,0000,0000,,Oko!
Dialogue: 0,0:09:03.05,0:09:04.75,Dialogue,,0000,0000,0000,,Rośnie, kiedy jest ciemno.
Dialogue: 0,0:09:04.75,0:09:05.58,Dialogue,,0000,0000,0000,,Kiedy jest ciemno?
Dialogue: 0,0:09:05.90,0:09:06.79,Dialogue,,0000,0000,0000,,T-tak!
Dialogue: 0,0:09:07.76,0:09:09.26,Dialogue,,0000,0000,0000,,Więc, sprawdźmy twoją odpowiedź.
Dialogue: 0,0:09:18.53,0:09:19.50,Dialogue,,0000,0000,0000,,Dzieńdoberek!
Dialogue: 0,0:09:19.50,0:09:20.36,Dialogue,,0000,0000,0000,,Raika?
Dialogue: 0,0:09:20.36,0:09:22.55,Dialogue,,0000,0000,0000,,Chyba nie jest z tobą tak źle, skoro masz czas na spanie.
Dialogue: 0,0:09:23.75,0:09:25.88,Dialogue,,0000,0000,0000,,Nie masz czasem ważnego terminu?
Dialogue: 0,0:09:27.11,0:09:29.67,Dialogue,,0000,0000,0000,,Niedobrze! Za długo spałem!
Dialogue: 0,0:09:30.24,0:09:31.82,Dialogue,,0000,0000,0000,,Dzięki, że mnie obudziłaś.
Dialogue: 0,0:09:32.08,0:09:33.43,Dialogue,,0000,0000,0000,,Muszę się pospieszyć...
Dialogue: 0,0:09:33.43,0:09:34.49,Dialogue,,0000,0000,0000,,Mną się nie przejmuj.
Dialogue: 0,0:09:34.49,0:09:39.60,Dialogue,,0000,0000,0000,,Ja tu tylko przyszłam, by sfotografować pisarza porno, który nie może napisać porno.
Dialogue: 0,0:09:40.43,0:09:41.95,Dialogue,,0000,0000,0000,,Dzień dobry, Taketo-kun!
Dialogue: 0,0:09:42.90,0:09:44.45,Dialogue,,0000,0000,0000,,Kurabu Katsuyo?
Dialogue: 0,0:09:45.02,0:09:45.89,Dialogue,,0000,0000,0000,,Witaj z powrotem.
Dialogue: 0,0:09:46.46,0:09:47.87,Dialogue,,0000,0000,0000,,Jesteś głodny?
Dialogue: 0,0:09:47.87,0:09:50.08,Dialogue,,0000,0000,0000,,Poczekaj. Zaraz zrobię obiad.
Dialogue: 0,0:09:50.42,0:09:51.28,Dialogue,,0000,0000,0000,,Dzięki.
Dialogue: 0,0:09:51.28,0:09:51.91,Dialogue,,0000,0000,0000,,Taketo...
Dialogue: 0,0:09:52.66,0:09:55.10,Dialogue,,0000,0000,0000,,Czy ty wiesz, kim ona jest?
Dialogue: 0,0:09:55.10,0:09:56.94,Dialogue,,0000,0000,0000,,Genialny menedżer, zgadza się?
Dialogue: 0,0:09:56.94,0:09:59.61,Dialogue,,0000,0000,0000,,Słyszałem, że każdy, komu pomaga, odnosi sukces, choćby nie wiem co.
Dialogue: 0,0:10:00.10,0:10:04.20,Dialogue,,0000,0000,0000,,Faktycznie, jej pomoc niemalże gwarantuje powodzenie.
Dialogue: 0,0:10:04.20,0:10:07.33,Dialogue,,0000,0000,0000,,Ale zwycięstwo zawsze ma swoją cenę.
Dialogue: 0,0:10:11.87,0:10:14.59,Dialogue,,0000,0000,0000,,Oto, co się stało z drużyną baseballową, której pomagała.
Dialogue: 0,0:10:18.53,0:10:20.62,Dialogue,,0000,0000,0000,,To mój telefon! Jak...
Dialogue: 0,0:10:20.91,0:10:21.60,Dialogue,,0000,0000,0000,,Tak?
Dialogue: 0,0:10:22.95,0:10:25.27,Dialogue,,0000,0000,0000,,Hej. Cz-czekaj no...
Dialogue: 0,0:10:23.64,0:10:27.86,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Och, ja? Jestem menedżerem Taketo-sana, Kurabu Katsuyo.
Dialogue: 0,0:10:28.17,0:10:29.81,Dialogue,,0000,0000,0000,,Taketo-san?
Dialogue: 0,0:10:29.81,0:10:31.45,Dialogue,,0000,0000,0000,,Chwileczkę.
Dialogue: 0,0:10:32.97,0:10:34.20,Dialogue,,0000,0000,0000,,Twój wydawca.
Dialogue: 0,0:10:35.35,0:10:37.45,Dialogue,,0000,0000,0000,,Nie ma mnie! Powiedz, że mnie nie ma!
Dialogue: 0,0:10:37.45,0:10:39.17,Dialogue,,0000,0000,0000,,Kazał powiedzieć, że go nie ma.
Dialogue: 0,0:10:41.01,0:10:44.65,Dialogue,,0000,0000,0000,,Najmocniej przepraszam. Nie, to jest... Proszę mnie wysłuchać!
Dialogue: 0,0:10:44.65,0:10:46.29,Dialogue,,0000,0000,0000,,Mam problemy z komputerem.
Dialogue: 0,0:10:46.29,0:10:47.81,Dialogue,,0000,0000,0000,,Nie, przecież piszę ręcznie.
Dialogue: 0,0:10:47.81,0:10:50.62,Dialogue,,0000,0000,0000,,Ee, no to mój krewny miał wypadek.
Dialogue: 0,0:10:54.81,0:10:56.71,Dialogue,,0000,0000,0000,,Zrobiłam kilka świetnych zdjęć!
Dialogue: 0,0:10:56.71,0:10:58.35,Dialogue,,0000,0000,0000,,No to powodzenia z pisaniem.
Dialogue: 0,0:10:59.04,0:11:01.16,Dialogue,,0000,0000,0000,,Już dość... Nie dam rady.
Dialogue: 0,0:11:00.73,0:11:01.65,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Taketo-kun?
Dialogue: 0,0:11:01.16,0:11:04.86,Dialogue,,0000,0000,0000,,Jestem beznadziejnym pisarzem! Mój wydawca pewnie też tak myśli...
Dialogue: 0,0:11:05.01,0:11:08.34,Dialogue,,0000,0000,0000,,To nieprawda! Na pewno dasz radę.
Dialogue: 0,0:11:08.34,0:11:09.71,Dialogue,,0000,0000,0000,,Uwierz w siebie!
Dialogue: 0,0:11:09.71,0:11:10.46,Dialogue,,0000,0000,0000,,Już wiem!
Dialogue: 0,0:11:11.24,0:11:12.76,Dialogue,,0000,0000,0000,,Ta ręka jest wszystkiemu winna!
Dialogue: 0,0:11:13.13,0:11:15.97,Dialogue,,0000,0000,0000,,To przez tą rękę muszę pisać!
Dialogue: 0,0:11:14.42,0:11:16.49,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Czekaj! Taketo-kun, nie rób tego!
Dialogue: 0,0:11:16.49,0:11:18.13,Dialogue,,0000,0000,0000,,To przez tą rękę gonią mnie terminy!
Dialogue: 0,0:11:19.49,0:11:22.13,Comment,,0000,0000,0000,,Osobiste przemyślenie: Czy ona nie potrafi zagrać nic innego? I to ma być genialna klarnecistka?
Dialogue: 0,0:11:54.50,0:11:57.60,Dialogue,,0000,0000,0000,,Ach tak. Ona też ciężko pracuje, nawet o tej porze.
Dialogue: 0,0:11:58.29,0:12:00.64,Dialogue,,0000,0000,0000,,Ja chyba też powinienem się trochę postarać.
Dialogue: 0,0:12:01.05,0:12:02.65,Dialogue,,0000,0000,0000,,Nie rób tego!
Dialogue: 0,0:12:02.91,0:12:04.66,Dialogue,,0000,0000,0000,,Nie rób tego, Taketo-kun!
Dialogue: 0,0:12:04.71,0:12:08.42,Canned Beef,,0000,0000,0000,,{\fad(1000,0)\frx348\fry32\frz33.01\pos(790,514)\c&H112A16&}Puszkowana Wołowina
Dialogue: 0,0:12:05.98,0:12:08.42,Dialogue,,0000,0000,0000,,Taketo-kun!!
Dialogue: 0,0:12:23.75,0:12:26.31,Time,,0000,0000,0000,,{\fad(1000,0)\pos(1218,607)}8:00 : Minęły 22 godziny
Dialogue: 0,0:12:43.45,0:12:44.31,Dialogue,,0000,0000,0000,,Nie wierzę!
Dialogue: 0,0:12:46.40,0:12:48.35,Dialogue,,0000,0000,0000,,Nie musisz się zmuszać do czytania tego.
Dialogue: 0,0:12:48.35,0:12:52.80,Dialogue,,0000,0000,0000,,Nie! Jako twój menedżer muszę się zapoznać z twoją pracą.
Dialogue: 0,0:12:55.04,0:12:57.00,Dialogue,,0000,0000,0000,,Niemożliwe... Nie!
Dialogue: 0,0:13:00.33,0:13:01.96,Dialogue,,0000,0000,0000,,{\fad(0,1000)}N-nie!
Dialogue: 0,0:13:03.68,0:13:06.58,Dialogue,,0000,0000,0000,,Nie przypuszczałem, że będę musiał tego słuchać przez całą noc...
Dialogue: 0,0:13:07.70,0:13:10.26,Dialogue,,0000,0000,0000,,Nie poddawaj sie... postaraj się...
Dialogue: 0,0:13:10.26,0:13:11.55,Dialogue,,0000,0000,0000,,Daj z siebie wszystko...
Dialogue: 0,0:13:11.55,0:13:14.65,Dialogue,,0000,0000,0000,,Ciesz mnie to, że wspiera mnie nawet przez sen.
Dialogue: 0,0:13:16.06,0:13:18.70,Dialogue,,0000,0000,0000,,Kurde, ja też zrobiłem się senny.
Dialogue: 0,0:13:19.22,0:13:19.85,Dialogue,,0000,0000,0000,,Taketo!
Dialogue: 0,0:13:20.19,0:13:21.48,Dialogue,,0000,0000,0000,,Słyszałem od Raiki,
Dialogue: 0,0:13:21.48,0:13:24.27,Dialogue,,0000,0000,0000,,że jesteś tu zamknięty ze swoim menedżerem.
Dialogue: 0,0:13:24.50,0:13:29.26,Dialogue,,0000,0000,0000,,Och, Ritsu. Wybacz, mógłbyś przekazać, że dziś też mnie nie będzie?
Dialogue: 0,0:13:30.56,0:13:33.14,Dialogue,,0000,0000,0000,,To wszystko przez to, że mój harmonogram jest naprawdę napięty.
Dialogue: 0,0:13:33.14,0:13:34.52,Dialogue,,0000,0000,0000,,N-napięty?!
Dialogue: 0,0:13:35.12,0:13:37.02,Dialogue,,0000,0000,0000,,Tak, naprawdę napięty...
Dialogue: 0,0:13:37.02,0:13:38.80,Dialogue,,0000,0000,0000,,Daje mi naprawdę niezły wycisk.
Dialogue: 0,0:13:38.80,0:13:40.41,Gan,,0000,0000,0000,,{\fad(0,1000)\frz336.159\move(602,174,626,188)}Gan
Dialogue: 0,0:13:39.23,0:13:40.41,Dialogue,,0000,0000,0000,,Wycisk?
Dialogue: 0,0:13:41.21,0:13:44.28,Dialogue,,0000,0000,0000,,J-jestem pewien, że z twoim talentem dasz sobie radę, ale...
Dialogue: 0,0:13:44.25,0:13:47.12,Dialogue,,0000,0000,0000,,J-j-ja...
Dialogue: 0,0:13:46.83,0:13:49.19,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Ritsu! Wartość {\i1}pi{\i0}!
Dialogue: 0,0:13:49.19,0:13:52.11,Dialogue,,0000,0000,0000,,3.1415926535...
Dialogue: 0,0:13:52.89,0:13:56.71,Dialogue,,0000,0000,0000,,{\fad(0,1000)}Cholera, od tego jeszcze bardziej chce mi się spać.
Dialogue: 0,0:13:59.98,0:14:01.42,Dialogue,,0000,0000,0000,,Katsuyo-kun!
Dialogue: 0,0:14:01.73,0:14:02.51,Dialogue,,0000,0000,0000,,T-tak!
Dialogue: 0,0:14:03.17,0:14:06.78,Dialogue,,0000,0000,0000,,Podaj mi nazwę północnego jeziora w Saskatchewan!
Dialogue: 0,0:14:08.10,0:14:08.65,Dialogue,,0000,0000,0000,,O...
Dialogue: 0,0:14:08.65,0:14:09.54,Dialogue,,0000,0000,0000,,Że jak?
Dialogue: 0,0:14:09.91,0:14:11.15,Dialogue,,0000,0000,0000,,O-Oman...
Dialogue: 0,0:14:11.15,0:14:12.38,Dialogue,,0000,0000,0000,,Głośniej!
Dialogue: 0,0:14:12.38,0:14:14.56,Dialogue,,0000,0000,0000,,Oman... Lake.
Dialogue: 0,0:14:14.56,0:14:15.80,Dialogue,,0000,0000,0000,,Jeszcze głośniej!
Dialogue: 0,0:14:16.23,0:14:17.52,Dialogue,,0000,0000,0000,,Oman Lake!
Dialogue: 0,0:14:17.52,0:14:18.67,Dialogue,,0000,0000,0000,,Więcej uczucia!
Dialogue: 0,0:14:19.07,0:14:20.54,Dialogue,,0000,0000,0000,,Oman Lake!
Dialogue: 0,0:14:20.54,0:14:22.43,Dialogue,,0000,0000,0000,,Powiedz to, jakbyś szeptała do ucha ukochanego!
Dialogue: 0,0:14:22.43,0:14:23.95,Dialogue,,0000,0000,0000,,Oman Lake.
Dialogue: 0,0:14:23.95,0:14:26.10,Dialogue,,0000,0000,0000,,Teraz tak, jakbyś właśnie miała orgazm!
Dialogue: 0,0:14:26.10,0:14:27.97,Dialogue,,0000,0000,0000,,Oman Lake!
Dialogue: 0,0:14:27.97,0:14:29.95,Dialogue,,0000,0000,0000,,{\fad(0,1000)}Tak, jakbyś piła kawę o świcie...
Dialogue: 0,0:14:32.74,0:14:34.11,Dialogue,,0000,0000,0000,,To jest...
Dialogue: 0,0:14:35.49,0:14:38.45,Paper,,0000,0000,0000,,{\frz357.589\pos(639,103)}Pogadam
Dialogue: 0,0:14:35.49,0:14:38.45,Paper,,0000,0000,0000,,{\pos(731,245)}z nauczycielami.
Dialogue: 0,0:14:35.49,0:14:38.45,Paper,,0000,0000,0000,,{\pos(636,375)}Powodzenia.
Dialogue: 0,0:14:36.64,0:14:37.64,Dialogue,,0000,0000,0000,,Ritsu...
Dialogue: 0,0:14:38.68,0:14:40.11,Dialogue,,0000,0000,0000,,Dzięki, Ritsu.
Dialogue: 0,0:14:40.11,0:14:41.69,Dialogue,,0000,0000,0000,,Dobra, wracam do roboty.
Dialogue: 0,0:14:43.18,0:14:43.82,Dialogue,,0000,0000,0000,,Tak?
Dialogue: 0,0:14:43.82,0:14:47.46,Dialogue,,0000,0000,0000,,To telefon pisarza porno, Akutagawy Taketo.
Dialogue: 0,0:14:43.93,0:14:44.76,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Znowu?!
Dialogue: 0,0:14:47.46,0:14:50.02,Dialogue,,0000,0000,0000,,Jeśli dzwonisz w innej sprawie niż przedłużenie terminu,
Dialogue: 0,0:14:50.02,0:14:52.95,Dialogue,,0000,0000,0000,,zostaw wiadomość po sygnale.
Dialogue: 0,0:14:52.95,0:14:53.89,Dialogue,,0000,0000,0000,,Biip!
Dialogue: 0,0:14:54.93,0:14:56.19,Dialogue,,0000,0000,0000,,Załatwione!
Dialogue: 0,0:14:56.19,0:14:58.57,Dialogue,,0000,0000,0000,,Nie odbieraj telefonu za mnie!
Dialogue: 0,0:15:00.07,0:15:04.46,Dialogue,,0000,0000,0000,,P-przepraszam. Myślałam, że powinnam to robić jako twój menedżer.
Dialogue: 0,0:15:04.46,0:15:06.21,Dialogue,,0000,0000,0000,,Głupia, głupia, głupia!
Dialogue: 0,0:15:06.21,0:15:07.93,Dialogue,,0000,0000,0000,,Jaka ja jestem głupia!
Dialogue: 0,0:15:08.28,0:15:09.71,Thoughts,,0000,0000,0000,,Ciężki przypadek.
Dialogue: 0,0:15:09.71,0:15:11.61,Thoughts,,0000,0000,0000,,Naprawdę ciężki.
Dialogue: 0,0:15:15.60,0:15:17.89,Time,,0000,0000,0000,,{\fad(1000,0)\pos(1178,607)}Południe: Minęło 26 godzin
Dialogue: 0,0:15:18.27,0:15:20.22,Dialogue,,0000,0000,0000,,Umieram z głodu.
Dialogue: 0,0:15:21.37,0:15:23.41,Dialogue,,0000,0000,0000,,Katsuyo-chan? Otwarte!
Dialogue: 0,0:15:24.01,0:15:25.21,Dialogue,,0000,0000,0000,,Przepraszam za najście.
Dialogue: 0,0:15:26.08,0:15:27.02,Dialogue,,0000,0000,0000,,Pomyślałam, że wpadnę.
Dialogue: 0,0:15:27.02,0:15:28.31,Dialogue,,0000,0000,0000,,Utae-san?
Dialogue: 0,0:15:31.62,0:15:34.89,Dialogue,,0000,0000,0000,,Słyszałam, że pisarzom podczas deadlinu jest bardzo ciężko.
Dialogue: 0,0:15:34.89,0:15:36.78,Dialogue,,0000,0000,0000,,Dlatego zrobiłam ci bento.
Dialogue: 0,0:15:37.10,0:15:38.62,Dialogue,,0000,0000,0000,,Nie powinnam?
Dialogue: 0,0:15:38.62,0:15:40.97,Dialogue,,0000,0000,0000,,Nie, nic z tych rzeczy!
Dialogue: 0,0:15:40.97,0:15:42.81,Dialogue,,0000,0000,0000,,Akurat zgłodniałem.
Dialogue: 0,0:15:45.45,0:15:47.09,Dialogue,,0000,0000,0000,,O nie. To zawstydzające.
Dialogue: 0,0:15:47.09,0:15:49.30,Dialogue,,0000,0000,0000,,Robiłam je w pośpiechu, bo nie miałam za dużo czasu.
Dialogue: 0,0:15:50.25,0:15:51.22,Dialogue,,0000,0000,0000,,Utae-san...
Dialogue: 0,0:15:51.88,0:15:54.44,Thoughts,,0000,0000,0000,,Racja. Ona jest idolką, czyż nie?
Dialogue: 0,0:15:54.44,0:15:56.62,Thoughts,,0000,0000,0000,,Ma tyle na głowie, a mimo to znalazła czas dla mnie.
Dialogue: 0,0:15:58.80,0:16:01.50,Thoughts,,0000,0000,0000,,Prawdziwe bento od światowej sławy idolki.
Dialogue: 0,0:16:01.50,0:16:04.00,Thoughts,,0000,0000,0000,,Kompletne, ze wszystkimi dodatkami.
Dialogue: 0,0:16:05.20,0:16:06.18,Dialogue,,0000,0000,0000,,Co się stało?
Dialogue: 0,0:16:06.61,0:16:07.67,Dialogue,,0000,0000,0000,,Przepraszam.
Dialogue: 0,0:16:07.67,0:16:11.61,Dialogue,,0000,0000,0000,,Nie sądziłem, że tak cudownie jest mieć kogoś, kto cię wspiera.
Dialogue: 0,0:16:11.61,0:16:13.99,Dialogue,,0000,0000,0000,,Przesadzasz, Taketo-kun.
Dialogue: 0,0:16:13.99,0:16:15.34,Dialogue,,0000,0000,0000,,No już, jedz.
Dialogue: 0,0:16:15.34,0:16:15.91,Dialogue,,0000,0000,0000,,D-dobra!
Dialogue: 0,0:16:17.20,0:16:21.20,Dialogue,,0000,0000,0000,,Nie masz czasu, prawda? Pisz dalej, a ja cię nakarmię.
Dialogue: 0,0:16:21.80,0:16:23.18,Dialogue,,0000,0000,0000,,Proszę, powiedz "aaa".
Dialogue: 0,0:16:28.00,0:16:29.06,Dialogue,,0000,0000,0000,,Już, "aaa".
Dialogue: 0,0:16:29.06,0:16:30.07,Dialogue,,0000,0000,0000,,Aaa...
Dialogue: 0,0:16:31.62,0:16:32.91,Dialogue,,0000,0000,0000,,Trochę zawstydzające, nie?
Dialogue: 0,0:16:32.91,0:16:34.00,Dialogue,,0000,0000,0000,,P-prawda.
Dialogue: 0,0:16:35.92,0:16:37.65,Dialogue,,0000,0000,0000,,Jak ci smakuje?
Dialogue: 0,0:16:39.37,0:16:40.40,Dialogue,,0000,0000,0000,,Jest przepyszne!
Dialogue: 0,0:16:40.40,0:16:41.61,Dialogue,,0000,0000,0000,,Serio?
Dialogue: 0,0:16:41.61,0:16:42.81,Dialogue,,0000,0000,0000,,Serio, serio!
Dialogue: 0,0:16:42.78,0:16:45.63,Dialogue,,0000,0000,0000,,To jest najlepsze bento, jakie kiedykolwiek jadłem!
Dialogue: 0,0:16:46.92,0:16:47.64,Dialogue,,0000,0000,0000,,Znowu przesadzasz.
Dialogue: 0,0:16:48.18,0:16:50.97,Dialogue,,0000,0000,0000,,No to powodzenia z pisaniem, Sensei!
Dialogue: 0,0:16:50.97,0:16:52.37,Dialogue,,0000,0000,0000,,Proszę, "aaa"!
Dialogue: 0,0:16:52.37,0:16:53.20,Dialogue,,0000,0000,0000,,Aaa...
Dialogue: 0,0:16:55.10,0:16:58.23,Thoughts,,0000,0000,0000,,To są niewątpliwie jej pałeczki.
Dialogue: 0,0:16:58.23,0:16:59.87,Thoughts,,0000,0000,0000,,T-to oznacza...
Dialogue: 0,0:17:00.35,0:17:02.59,Thoughts,,0000,0000,0000,,Jej usta ich dotykały.
Dialogue: 0,0:17:02.59,0:17:04.92,Thoughts,,0000,0000,0000,,A teraz one dotykają moich ust.
Dialogue: 0,0:17:05.43,0:17:08.97,Thoughts,,0000,0000,0000,,Więc jej usta dotykają moich ust?!
Dialogue: 0,0:17:09.97,0:17:12.64,Thoughts,,0000,0000,0000,,To jest nierealne! Niewiarygodne!
Dialogue: 0,0:17:14.02,0:17:15.22,Thoughts,,0000,0000,0000,,Dam radę!
Dialogue: 0,0:17:15.22,0:17:16.63,Thoughts,,0000,0000,0000,,Włożę tą pasję w pisanie.
Dialogue: 0,0:17:16.98,0:17:18.87,Thoughts,,0000,0000,0000,,Wróciłam.
Dialogue: 0,0:17:19.53,0:17:23.38,Dialogue,,0000,0000,0000,,Przepraszam, jeden z klubów sportowych poprosił mnie o pomoc.
Dialogue: 0,0:17:23.72,0:17:25.27,Dialogue,,0000,0000,0000,,Ale już skończyłam.
Dialogue: 0,0:17:26.65,0:17:28.43,Dialogue,,0000,0000,0000,,Jakie wspaniałe bento!
Dialogue: 0,0:17:28.43,0:17:30.44,Dialogue,,0000,0000,0000,,Kto je zrobił?
Dialogue: 0,0:17:30.44,0:17:32.65,Dialogue,,0000,0000,0000,,M-może też się poczęstujesz?
Dialogue: 0,0:17:33.45,0:17:34.80,Dialogue,,0000,0000,0000,,Mogę?
Dialogue: 0,0:17:34.80,0:17:37.16,Dialogue,,0000,0000,0000,,Dzięki, jestem strasznie głodna.
Dialogue: 0,0:17:37.21,0:17:47.18,Canned Beef,,0000,0000,0000,,{\fs70\frx12\fry24\frz2.492\pos(908,557)}Puszkowana Wołowina
Dialogue: 0,0:17:38.65,0:17:40.37,Dialogue,,0000,0000,0000,,Więc, powodzenia.
Dialogue: 0,0:17:40.37,0:17:41.61,Dialogue,,0000,0000,0000,,Dzięki.
Dialogue: 0,0:17:41.61,0:17:43.47,Dialogue,,0000,0000,0000,,Dzięki za jedzenie!
Dialogue: 0,0:17:43.47,0:17:44.16,Dialogue,,0000,0000,0000,,Na razie!
Dialogue: 0,0:17:54.61,0:17:57.48,Dialogue,,0000,0000,0000,,Już prawie na coś wpadłem.
Dialogue: 0,0:17:57.48,0:18:00.18,Dialogue,,0000,0000,0000,,Jak ci idzie? Nadal nic?
Dialogue: 0,0:18:00.18,0:18:02.19,Dialogue,,0000,0000,0000,,Tak. Nic a nic.
Dialogue: 0,0:18:02.45,0:18:03.86,Dialogue,,0000,0000,0000,,Nie martw się!
Dialogue: 0,0:18:03.86,0:18:07.70,Dialogue,,0000,0000,0000,,Masz jeszcze 20 godzin, więc, yyy... Ile stron na godzinę?
Dialogue: 0,0:18:07.70,0:18:09.60,Dialogue,,0000,0000,0000,,Ile stron masz właściwie napisać?
Dialogue: 0,0:18:09.77,0:18:13.13,Thoughts,,0000,0000,0000,,To jest to! Jeśli chcesz kogoś uwieść, potrzebujesz pretekstu!
Dialogue: 0,0:18:13.53,0:18:15.80,Thoughts,,0000,0000,0000,,A wtedy, w odpowiednim momencie, przelotna ekspozycja!
Dialogue: 0,0:18:15.80,0:18:17.06,Thoughts,,0000,0000,0000,,To oczywiste!
Dialogue: 0,0:18:17.29,0:18:18.33,Thoughts,,0000,0000,0000,,Skup się.
Dialogue: 0,0:18:18.33,0:18:22.23,Thoughts,,0000,0000,0000,,To uczucie, które przepływa przez moje ciało...
Dialogue: 0,0:18:22.23,0:18:25.24,Thoughts,,0000,0000,0000,,Tym razem uda mi się przelać moją pasję na papier!
Dialogue: 0,0:18:28.06,0:18:29.35,Dialogue,,0000,0000,0000,,Patrzałeś się, prawda?
Dialogue: 0,0:18:29.35,0:18:32.74,Dialogue,,0000,0000,0000,,N-nie! Moje oczy same się poruszyły.
Dialogue: 0,0:18:33.14,0:18:35.26,Dialogue,,0000,0000,0000,,To dla dobra twojej pracy, czyż nie?
Dialogue: 0,0:18:35.72,0:18:38.71,Dialogue,,0000,0000,0000,,Przeczytałam mnóstwo twoich książek, więc rozumiem.
Dialogue: 0,0:18:38.71,0:18:43.44,Dialogue,,0000,0000,0000,,Potrzebujesz czegoś takiego, by pracować, prawda?
Dialogue: 0,0:18:50.33,0:18:53.84,Thoughts,,0000,0000,0000,,Nie. To nie to. Nie tego potrzebuję!
Dialogue: 0,0:18:56.99,0:18:58.96,Time,,0000,0000,0000,,{\fad(1000,0)\pos(1218,605)}21:00 : Minęło 35 godzin
Dialogue: 0,0:19:03.97,0:19:05.61,Dialogue,,0000,0000,0000,,Zostało 12 godzin.
Dialogue: 0,0:19:05.61,0:19:08.31,Dialogue,,0000,0000,0000,,Jak ci idzie? Kończysz już?
Dialogue: 0,0:19:08.31,0:19:09.20,Dialogue,,0000,0000,0000,,Nawet nie zacząłem.
Dialogue: 0,0:19:09.20,0:19:12.38,Dialogue,,0000,0000,0000,,Cóż, chyba nie mam wyboru!
Dialogue: 0,0:19:15.28,0:19:19.76,Dialogue,,0000,0000,0000,,Od teraz nie możesz nawet na sekundę oderwać wzroku od kartki.
Dialogue: 0,0:19:20.02,0:19:22.83,Dialogue,,0000,0000,0000,,Już, pisz! Ja też dam z siebie wszystko!
Dialogue: 0,0:19:23.98,0:19:28.40,Dialogue,,0000,0000,0000,,Fight, oh! Fight, oh! Naprzód, Ta-ke-to!
Dialogue: 0,0:19:26.54,0:19:28.40,Dialogue,,0000,0000,0000,,{\3c&H640000&\4c&H960000&}Znowu to?
Dialogue: 0,0:19:31.10,0:19:31.76,Dialogue,,0000,0000,0000,,Wytrzyj pot.
Dialogue: 0,0:19:31.76,0:19:32.94,Dialogue,,0000,0000,0000,,Już się robi, Sensei.
Dialogue: 0,0:19:35.24,0:19:37.50,Thoughts,,0000,0000,0000,,To jeszcze nie to!
Dialogue: 0,0:19:39.86,0:19:41.12,Dialogue,,0000,0000,0000,,M-moja ręka...
Dialogue: 0,0:19:42.33,0:19:45.97,Dialogue,,0000,0000,0000,,Proszę, użyj tych rąk, by dokonać cudu!
Dialogue: 0,0:19:45.97,0:19:47.12,Thoughts,,0000,0000,0000,,To też nie to!
Dialogue: 0,0:19:50.51,0:19:52.43,Dialogue,,0000,0000,0000,,I jak? Skończyłeś?
Dialogue: 0,0:19:53.29,0:19:56.45,Dialogue,,0000,0000,0000,,To na nic. Już nie potrafię pisać o dziewczynach.
Dialogue: 0,0:19:56.45,0:19:59.95,Dialogue,,0000,0000,0000,,Poważnie? Nawet te stroje, które zachowałam na sam koniec, nie pomogły?
Dialogue: 0,0:20:00.50,0:20:03.05,Dialogue,,0000,0000,0000,,Mniejsza z tym. Skończę z karierą pisarską.
Dialogue: 0,0:20:03.05,0:20:04.49,Dialogue,,0000,0000,0000,,Nie możesz tego zrobić!
Dialogue: 0,0:20:04.49,0:20:08.45,Dialogue,,0000,0000,0000,,Jesteś genialnym pisarzem porno. Musisz pisać porno!
Dialogue: 0,0:20:08.45,0:20:09.46,Dialogue,,0000,0000,0000,,Nie potrafię.
Dialogue: 0,0:20:09.69,0:20:11.38,Dialogue,,0000,0000,0000,,Nie poddawaj się!
Dialogue: 0,0:20:11.38,0:20:12.59,Dialogue,,0000,0000,0000,,Nie dam rady!
Dialogue: 0,0:20:13.30,0:20:15.71,Dialogue,,0000,0000,0000,,Nie mogę nic napisać! Nie po tym wszystkim, co zrobiłaś!
Dialogue: 0,0:20:15.71,0:20:18.13,Dialogue,,0000,0000,0000,,A-ale skoro jestem twoim menedżerem...
Dialogue: 0,0:20:18.13,0:20:19.73,Dialogue,,0000,0000,0000,,Dość tego! Odejdź stąd!
Dialogue: 0,0:20:25.82,0:20:27.00,Dialogue,,0000,0000,0000,,Przepraszam.
Dialogue: 0,0:20:35.15,0:20:36.76,Dialogue,,0000,0000,0000,,Może potraktowałem ją zbyt ostro?
Dialogue: 0,0:20:37.27,0:20:39.60,Dialogue,,0000,0000,0000,,Nieważne. To i tak już koniec.
Dialogue: 0,0:20:40.20,0:20:41.04,Dialogue,,0000,0000,0000,,Taketo-kun!
Dialogue: 0,0:20:41.90,0:20:44.05,Dialogue,,0000,0000,0000,,Tym razem musi się udać!
Dialogue: 0,0:20:44.31,0:20:46.43,Dialogue,,0000,0000,0000,,Skoro powiedziałeś, że nie możesz więcej pisać o dziewczynach,
Dialogue: 0,0:20:46.43,0:20:48.41,Dialogue,,0000,0000,0000,,wpadłam na pewien pomysł.
Dialogue: 0,0:20:48.41,0:20:49.27,Dialogue,,0000,0000,0000,,Chłopaki!
Dialogue: 0,0:20:52.55,0:20:56.88,Dialogue,,0000,0000,0000,,Premium Muskuły z klubu kulturystycznego Akademii Geniuszy!
Dialogue: 0,0:20:56.88,0:20:58.55,Dialogue,,0000,0000,0000,,Więcej mięśni!
Dialogue: 0,0:20:59.27,0:21:00.41,Dialogue,,0000,0000,0000,,Dobra, chłopaki!
Dialogue: 0,0:21:00.41,0:21:04.98,Dialogue,,0000,0000,0000,,Pokażcie Taketo-kunowi wspaniałość mężczyzn, aby mógł napisać znakomite porno!
Dialogue: 0,0:21:04.98,0:21:06.93,Dialogue,,0000,0000,0000,,Jesteśmy mięśniami!
Dialogue: 0,0:21:07.25,0:21:09.31,Dialogue,,0000,0000,0000,,Yo! Biceps!
Dialogue: 0,0:21:09.51,0:21:11.55,Dialogue,,0000,0000,0000,,Yo! Mięśnie brzucha!
Dialogue: 0,0:21:11.75,0:21:13.79,Dialogue,,0000,0000,0000,,Klata!
Dialogue: 0,0:21:14.02,0:21:15.57,Dialogue,,0000,0000,0000,,I jak, Taketo-kun?
Dialogue: 0,0:21:15.57,0:21:18.10,Dialogue,,0000,0000,0000,,Dotykają mnie. Dotykają mnie!
Dialogue: 0,0:21:18.61,0:21:20.80,Dialogue,,0000,0000,0000,,Są twardzi, a do tego mokrzy!
Dialogue: 0,0:21:20.80,0:21:21.97,Dialogue,,0000,0000,0000,,I śmierdzą!
Dialogue: 0,0:21:21.97,0:21:24.53,Dialogue,,0000,0000,0000,,Postaraj się, Akutagawa-sensei!
Dialogue: 0,0:21:24.70,0:21:26.08,Dialogue,,0000,0000,0000,,Nie mogę!
Dialogue: 0,0:21:26.08,0:21:29.90,Dialogue,,0000,0000,0000,,Nie chciałem pracować dla czegoś takiego!
Dialogue: 0,0:21:32.02,0:21:34.49,Thoughts,,0000,0000,0000,,Ż-życie przemyka mi przed oczami?
Dialogue: 0,0:21:36.76,0:21:37.82,Dialogue,,0000,0000,0000,,Powodzenia.
Dialogue: 0,0:21:39.77,0:21:41.50,Dialogue,,0000,0000,0000,,Yo! Muskuły!
Dialogue: 0,0:21:46.32,0:21:51.43,Dialogue,,0000,0000,0000,,{\fad(0,2000)}D-dziewczyny!!
