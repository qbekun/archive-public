Dialogue: 0,0:22:33.77,0:22:36.62,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.62,0:22:39.19,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.28,0:22:52.53,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.68,0:22:54.11,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.15,0:22:55.38,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.38,0:22:56.76,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:56.98,0:22:58.25,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.40,0:22:59.82,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.86,0:23:02.15,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.47,0:23:05.69,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.77,0:23:07.91,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.02,0:23:10.54,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.56,0:23:12.80,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.06,0:23:14.61,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.63,0:23:15.86,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:15.93,0:23:18.60,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.77,0:23:20.05,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.18,0:23:23.82,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.51,0:23:25.89,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:25.93,0:23:27.36,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.40,0:23:30.03,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.16,0:23:32.49,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.49,0:23:35.21,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.63,0:23:39.47,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.50,0:23:42.04,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
