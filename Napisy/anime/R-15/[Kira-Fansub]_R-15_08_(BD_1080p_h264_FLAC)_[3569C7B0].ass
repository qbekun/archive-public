Dialogue: 0,0:23:36.64,0:23:39.48,RomajiED,,0000,0000,0000,,{\k5}Ho{\k10}ra, {\k16}hi{\k16}ra{\k16}me{\k24}ki {\K47}POWER {\K54}SKIP {\k22}shi{\k11}te {\k24}sei{\k16}re{\k23}tsu
Dialogue: 0,0:23:39.51,0:23:42.05,RomajiED,,0000,0000,0000,,{\k7}Ma{\k9}ta {\K31}BANZAI {\k22}shi{\k21}te {\K51}PEACE {\k15}ko{\k14}u{\k16}shi{\k7}n{\k22}da {\K16}LET'S {\K23}GO!
Dialogue: 0,0:22:33.78,0:22:36.63,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.63,0:22:39.20,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.29,0:22:52.54,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.69,0:22:54.12,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.16,0:22:55.39,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.39,0:22:56.77,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:56.99,0:22:58.26,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.41,0:22:59.83,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.87,0:23:02.16,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.48,0:23:05.70,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.78,0:23:07.92,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.03,0:23:10.55,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.57,0:23:12.81,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.07,0:23:14.62,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.64,0:23:15.87,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:15.94,0:23:18.61,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.78,0:23:20.06,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.19,0:23:23.83,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.52,0:23:25.90,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:25.94,0:23:27.37,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.41,0:23:30.04,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.17,0:23:32.50,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.50,0:23:35.22,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.64,0:23:39.48,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.51,0:23:42.05,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.12,0:24:17.09,Title,,0000,0000,0000,,{\an4\pos(104,265)}W następnym odcinku:\NArchiwum X\NSzefowej
Dialogue: 0,0:24:12.88,0:24:14.46,Dialogue,,0000,0000,0000,,Tu Narukara Fukune.
Dialogue: 0,0:24:14.46,0:24:16.35,Dialogue,,0000,0000,0000,,Znowu zagram w shiritori.
Dialogue: 0,0:24:16.35,0:24:18.25,Dialogue,,0000,0000,0000,,"Szkolny kostium kąpielowy"
Dialogue: 0,0:24:16.35,0:24:18.25,Dialogue,,0000,0000,0000,,{\an8\pos(640,10)}(School Mizugi)
Dialogue: 0,0:24:18.25,0:24:21.64,Dialogue,,0000,0000,0000,,"Oczy lśniące jak u bestii"
Dialogue: 0,0:24:18.25,0:24:21.64,Dialogue,,0000,0000,0000,,{\an8\pos(640,10)}(Giragira...hitomi)
Dialogue: 0,0:24:21.64,0:24:26.63,Dialogue,,0000,0000,0000,,"Zobacz, co zrobiłaś tam niżej. Jesteś niegrzeczną dziewczynką."
Dialogue: 0,0:24:21.64,0:24:26.63,Dialogue,,0000,0000,0000,,{\an8\pos(640,10)}(Miro...ha)
Dialogue: 0,0:24:26.63,0:24:27.29,Dialogue,,0000,0000,0000,,"Och, przesta—"
Dialogue: 0,0:24:26.63,0:24:27.29,Dialogue,,0000,0000,0000,,{\an8\pos(640,10)}(haa, yamete)
