Dialogue: 0,0:22:33.93,0:22:36.78,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.78,0:22:39.35,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.44,0:22:52.69,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.84,0:22:54.27,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.31,0:22:55.54,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.54,0:22:56.92,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:57.14,0:22:58.41,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.56,0:22:59.98,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:23:00.02,0:23:02.31,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.63,0:23:05.85,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.93,0:23:08.07,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.18,0:23:10.70,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.72,0:23:12.96,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.22,0:23:14.77,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.79,0:23:16.02,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:16.09,0:23:18.76,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.93,0:23:20.21,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.34,0:23:23.98,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.67,0:23:26.05,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:26.09,0:23:27.52,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.56,0:23:30.19,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.32,0:23:32.65,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.65,0:23:35.37,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.79,0:23:39.63,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.66,0:23:42.20,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:06.80,0:24:08.50,Default,,0000,0000,0000,,N-nie!
Dialogue: 0,0:24:08.80,0:24:10.80,Default,,0000,0000,0000,,Nie patrz!
Dialogue: 0,0:24:12.47,0:24:27.48,Title,,0000,0000,0000,,{\pos(319,260)}Jestem Idolką,\Nnawet jeśli się rozbiorę!
Dialogue: 0,0:24:12.98,0:24:14.65,Default,,0000,0000,0000,,To ja, Narukara Fukune.
Dialogue: 0,0:24:14.65,0:24:16.26,Default,,0000,0000,0000,,Zagram w shiritori.
Dialogue: 0,0:24:14.65,0:24:17.80,Comment,,0000,0000,0000,,Shiritori: gra polegająca na wypowiadaniu kolejnych słów tak, by każdy kolejny wyraz zaczynał się tą samą sylabą, na którą kończył się poprzedni.
Dialogue: 0,0:24:16.60,0:24:17.85,Default,,0000,0000,0000,,"Żona..."
Dialogue: 0,0:24:17.85,0:24:19.14,Default,,0000,0000,0000,,"Ryżówka..."
Dialogue: 0,0:24:17.85,0:24:19.14,Comment,,0000,0000,0000,,Gatunek ryby żyjący w Azjii. Ciekawych odsyłam na Wikipedię.
Dialogue: 0,0:24:19.14,0:24:20.85,Default,,0000,0000,0000,,"Nożyczki"
Dialogue: 0,0:24:20.85,0:24:24.82,Default,,0000,0000,0000,,"Proszę pana, proszę przestać. Nie to miałam na myśli..."
Dialogue: 0,0:24:24.82,0:24:27.75,Default,,0000,0000,0000,,"Więc co tu się..."
