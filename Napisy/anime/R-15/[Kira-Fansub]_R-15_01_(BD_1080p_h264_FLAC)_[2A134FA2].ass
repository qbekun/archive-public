Dialogue: 0,0:00:45.94,0:00:48.14,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:00:57.26,0:00:59.80,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:00:59.91,0:01:01.81,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:01:02.41,0:01:07.33,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:01:08.53,0:01:13.17,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:01:13.71,0:01:18.69,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:01:19.88,0:01:22.44,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:01:22.68,0:01:25.12,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:01:25.52,0:01:26.58,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:01:26.58,0:01:27.65,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:01:27.65,0:01:30.05,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:01:30.35,0:01:32.90,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:01:33.22,0:01:35.94,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:01:36.28,0:01:39.02,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:01:39.09,0:01:42.04,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:01:42.11,0:01:44.22,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:01:44.41,0:01:47.22,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:01:47.52,0:01:50.36,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:01:50.41,0:01:53.10,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:01:53.21,0:01:55.50,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:01:53.71,0:01:56.47,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:55.67,0:01:58.15,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:56.53,0:01:59.29,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:01:58.47,0:02:00.95,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:01:59.40,0:02:00.97,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:02:01.32,0:02:04.14,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:02:18.43,0:02:23.43,Title,,0000,0000,0000,,{\pos(891,579)\fad(0,850)}Witamy w Akademii Inspiracji!
Dialogue: 0,0:02:23.22,0:02:24.48,Default,,0000,0000,0000,,Sen?
Dialogue: 0,0:02:28.44,0:02:29.76,Default,,0000,0000,0000,,Pracujesz?
Dialogue: 0,0:02:30.68,0:02:32.89,Default,,0000,0000,0000,,Czy też cieszysz się kolejną fantazją?
Dialogue: 0,0:02:32.89,0:02:36.35,Default,,0000,0000,0000,,Kiedy pogrążasz się w tych swoich urojeniach, zamknij chociaż usta, dobrze?
Dialogue: 0,0:02:36.35,0:02:38.92,Default,,0000,0000,0000,,Nikt nie chce słyszeć twoich myśli,
Dialogue: 0,0:02:38.92,0:02:40.49,Default,,0000,0000,0000,,Akutagawa Taketo.
Dialogue: 0,0:02:41.61,0:02:42.91,Default,,0000,0000,0000,,D-dobrze.
Dialogue: 0,0:02:42.91,0:02:44.03,Default,,0000,0000,0000,,Znakomicie!
Dialogue: 0,0:02:44.75,0:02:47.97,Default,,0000,0000,0000,,Znowu się zaczyna.
Dialogue: 0,0:02:54.38,0:02:57.63,Default,,0000,0000,0000,,Świetne! Jest jak napalona bestia!
Dialogue: 0,0:02:57.63,0:03:00.01,Default,,0000,0000,0000,,Wiosenna bestia!
Dialogue: 0,0:03:01.34,0:03:03.22,Default,,0000,0000,0000,,Rany, Taketo...
Dialogue: 0,0:03:03.58,0:03:06.48,Default,,0000,0000,0000,,Twoich myśli nigdy nie da się podstawić do żadnego wzoru.
Dialogue: 0,0:03:09.09,0:03:11.31,Default,,0000,0000,0000,,Rany... Znowu to samo.
Dialogue: 0,0:03:15.27,0:03:17.24,Default,,0000,0000,0000,,Nawet Narukara...
Dialogue: 0,0:03:17.85,0:03:18.96,Default,,0000,0000,0000,,U-Um...
Dialogue: 0,0:03:18.96,0:03:23.20,Default,,0000,0000,0000,,Psze pani! On nadal się źle zachowuje...
Dialogue: 0,0:03:26.22,0:03:27.50,Default,,0000,0000,0000,,O rany...
Dialogue: 0,0:03:29.27,0:03:31.55,Default,,0000,0000,0000,,Nie, nie. Uspokój się.
Dialogue: 0,0:03:31.55,0:03:34.63,Default,,0000,0000,0000,,Nadal jest tysiąc razy lepiej niż w gimnazjum!
Dialogue: 0,0:03:35.45,0:03:40.76,Default,,0000,0000,0000,,Od mojego debiutu jako ukryty autor porno pod pseudonimem Akutagawa Taketo,
Dialogue: 0,0:03:38.88,0:03:40.76,Titles,,0000,0000,0000,,{\pos(1084,468)}{\fad(100,0)}Ukryty\Nautor\Nporno...
Dialogue: 0,0:03:39.72,0:03:40.76,Titles,,0000,0000,0000,,{\pos(156,127)}{\fad(50,0)}Akutagawa\NTaketo\Ndebiutuje!!!
Dialogue: 0,0:03:40.96,0:03:43.57,Default,,0000,0000,0000,,dokąd bym nie poszedł,
Dialogue: 0,0:03:43.57,0:03:45.74,Default,,0000,0000,0000,,ludzie mówili o mnie za moimi plecami i prosto w twarz.
Dialogue: 0,0:03:46.56,0:03:49.74,Default,,0000,0000,0000,,Dziewczynom zbierało się na płacz tylko dlatego, że były ze mną w jednej klasie
Dialogue: 0,0:03:50.19,0:03:53.06,Default,,0000,0000,0000,,i byłem obrzucany wszelkimi wyzwiskami, jakie tylko można było wymyślić.
Dialogue: 0,0:03:51.81,0:03:52.23,derp,,0000,0000,0000,,{\fs120\frz340.171\move(1880,720,-200,-100,0,350)}Ero-zjeb
Dialogue: 0,0:03:53.15,0:03:53.48,derp,,0000,0000,0000,,{\fs120\move(-0,540,2080,-300,0,350)\frz21.934\fad(30,0)}Zboczony pisarz
Dialogue: 0,0:03:53.63,0:03:56.55,Default,,0000,0000,0000,,Każdy dzień był piekłem.
Dialogue: 0,0:03:58.87,0:03:59.84,Default,,0000,0000,0000,,Ale teraz...
Dialogue: 0,0:04:00.38,0:04:05.49,Default,,0000,0000,0000,,Mogę cieszyć się pozornie normalnym życiem w szkole średniej,
Dialogue: 0,0:04:05.66,0:04:06.53,Default,,0000,0000,0000,,ponieważ...
Dialogue: 0,0:04:07.85,0:04:10.82,Default,,0000,0000,0000,,Prywatna szkoła średnia, Akademia Inspiracji!
Dialogue: 0,0:04:11.92,0:04:17.38,Default,,0000,0000,0000,,{\frz0}To święte miejsce nauki dla utalentowanych uczniów wybranych w całej Japonii.
Dialogue: 0,0:04:16.13,0:04:18.09,Titles,,0000,0000,0000,,{\pos(235,492)\fad(50,0)}Tesubou Meguru
Dialogue: 0,0:04:16.96,0:04:18.09,Titles,,0000,0000,0000,,{\fad(50,0)\pos(276,552)}Utalentowana Gimnastyczka!
Dialogue: 0,0:04:17.39,0:04:18.34,Default,,0000,0000,0000,,Błyskotliwa kreatywność...
Dialogue: 0,0:04:18.55,0:04:20.45,Default,,0000,0000,0000,,Ciała i umysły w ruchu.
Dialogue: 0,0:04:20.45,0:04:22.63,Default,,0000,0000,0000,,Dusze wolne jak wiatr...
Dialogue: 0,0:04:21.09,0:04:23.26,Titles,,0000,0000,0000,,{\frz24.766\pos(165,82)\fad(50,50)}Beni Batan
Dialogue: 0,0:04:21.80,0:04:23.18,Titles,,0000,0000,0000,,{\frz24.766\pos(216,127)\fs60\fad(50,50)}Rewolucyjna Artystka!
Dialogue: 0,0:04:22.64,0:04:25.43,Default,,0000,0000,0000,,Możliwości są nieograniczone.
Dialogue: 0,0:04:25.43,0:04:27.61,Default,,0000,0000,0000,,Przyzwoitość, zdrowy rozsądek, etyka...
Dialogue: 0,0:04:27.27,0:04:29.35,Titles,,0000,0000,0000,,{\frz342.313\pos(189,406)}{\fad(50,0)}Musen Ran
Dialogue: 0,0:04:27.61,0:04:29.52,Default,,0000,0000,0000,,Żadne zasady obowiązujące resztę świata
Dialogue: 0,0:04:28.06,0:04:29.35,Titles,,0000,0000,0000,,{\frz342.313\pos(33,553)}{\an1}{\fad(50,0)}Genialna\N Programistka!
Dialogue: 0,0:04:29.86,0:04:33.59,Default,,0000,0000,0000,,nie mogą powstrzymać fali ich geniuszu
Dialogue: 0,0:04:32.31,0:04:34.52,Titles,,0000,0000,0000,,{\frz22.056\pos(150,87)}{\fad(50,0)}Meiki Raika
Dialogue: 0,0:04:32.77,0:04:34.52,Titles,,0000,0000,0000,,{\frz22.056\pos(194,183)}{\fad(50,0)}Niesamowita\NFotografistka!
Dialogue: 0,0:04:33.92,0:04:39.65,Default,,0000,0000,0000,,ponieważ każdy chłopak i każda dziewczyna tutaj jest prawdziwym geniuszem!
Dialogue: 0,0:04:37.53,0:04:39.24,Titles,,0000,0000,0000,,{\pos(578,173)}{\fad(50,0)}Ensuu Ritsu
Dialogue: 0,0:04:38.28,0:04:39.24,Titles,,0000,0000,0000,,{\pos(1023,38)}Genialny Matematyk!
Dialogue: 0,0:04:39.65,0:04:45.08,Default,,0000,0000,0000,,A teraz kilka słów od pana Kuroki Suiboku - fundatora, dyrektora i prezesa zarządu szkoły.
Dialogue: 0,0:04:45.08,0:04:50.37,Default,,0000,0000,0000,,Geniusz to 1% inspiracji i 99% ciężkiej pracy!
Dialogue: 0,0:04:50.70,0:04:51.66,Default,,0000,0000,0000,,Innymi słowy,
Dialogue: 0,0:04:51.86,0:04:55.05,Default,,0000,0000,0000,,wierzcie w swoje inspiracje i walczcie do końca!
Dialogue: 0,0:04:55.79,0:04:59.38,Default,,0000,0000,0000,,Ciężka praca bez inspiracji jest bezwartościowa!
Dialogue: 0,0:05:00.42,0:05:02.63,Default,,0000,0000,0000,,Nieważne, co inni powiedzą
Dialogue: 0,0:05:02.63,0:05:03.84,Default,,0000,0000,0000,,zignorujcie ich!
Dialogue: 0,0:05:06.55,0:05:08.72,Default,,0000,0000,0000,,To jest motto Akademii Inspiracji:
Dialogue: 0,0:05:08.72,0:05:13.94,Default,,0000,0000,0000,,"Zaufaj swej inspiracji! Zaufaj swym talentom! Podążaj swą własną ścieżką!
Dialogue: 0,0:05:13.94,0:05:16.25,Default,,0000,0000,0000,,Chwała Akademii Inspiracji!
Dialogue: 0,0:05:14.48,0:05:16.98,Titles,,0000,0000,0000,,{\an7\fs32\pos(252,19)\fad(1800,0)}Zaufaj swej inspiracji! Zaufaj swym talentom! Podążaj swą własną ścieżką!
Dialogue: 0,0:05:17.16,0:05:20.15,Default,,0000,0000,0000,,Czytała Kiya Star!
Dialogue: 0,0:05:20.99,0:05:22.90,Titles,,0000,0000,0000,,{\pos(675,558)\fad(50,0)}Kiya Star
Dialogue: 0,0:05:21.78,0:05:22.90,Titles,,0000,0000,0000,,{\pos(648,637)\fad(50,0)}Legendarna Narratorka
Dialogue: 0,0:05:24.65,0:05:26.32,Default,,0000,0000,0000,,Naprawdę genialna.
Dialogue: 0,0:05:28.78,0:05:31.13,Default,,0000,0000,0000,,Ale nawet geniusze popełniają czasem błędy.
Dialogue: 0,0:05:36.18,0:05:37.42,Default,,0000,0000,0000,,Słuchaj, Taketo.
Dialogue: 0,0:05:37.95,0:05:40.67,Default,,0000,0000,0000,,Jestem twoim kolegą z klasy i przyjacielem.
Dialogue: 0,0:05:40.67,0:05:45.34,Default,,0000,0000,0000,,Naprawdę chciałbym spróbować zrozumieć twój talent,
Dialogue: 0,0:05:45.53,0:05:50.52,Default,,0000,0000,0000,,ale zważywszy na to, że dziewczyny nie rozumieją i nie mogą cię zrozumieć...
Dialogue: 0,0:05:50.52,0:05:52.35,Default,,0000,0000,0000,,To jest, cóż...
Dialogue: 0,0:05:52.35,0:05:53.85,Default,,0000,0000,0000,,Nie mogę na to patrzeć.
Dialogue: 0,0:05:53.85,0:05:55.73,Default,,0000,0000,0000,,Szczerze mówiąc,
Dialogue: 0,0:05:55.73,0:05:57.50,Default,,0000,0000,0000,,jesteś zbyt otwarty!
Dialogue: 0,0:05:58.32,0:05:59.61,Default,,0000,0000,0000,,Taketo?
Dialogue: 0,0:05:59.88,0:06:01.36,Default,,0000,0000,0000,,Słuchasz mnie?
Dialogue: 0,0:06:01.57,0:06:03.36,Default,,0000,0000,0000,,Nikt nic nie rozumie.
Dialogue: 0,0:06:03.75,0:06:07.28,Default,,0000,0000,0000,,Zaślepieni płytkim poczuciem moralności i obrzydzenia
Dialogue: 0,0:06:07.28,0:06:09.57,Default,,0000,0000,0000,,nie potrafią dostrzec prawdy.
Dialogue: 0,0:06:09.57,0:06:10.56,Default,,0000,0000,0000,,Bądź co bądź...
Dialogue: 0,0:06:12.95,0:06:15.25,Default,,0000,0000,0000,,...sex jest podstawą ludzkiej egzystencji!
Dialogue: 0,0:06:15.25,0:06:18.64,Default,,0000,0000,0000,,Dlatego pisanie o seksie jest pisaniem o tym, co czyni nas ludźmi!
Dialogue: 0,0:06:18.64,0:06:21.13,Default,,0000,0000,0000,,Tak, to jest literatura, którą tworzę!
Dialogue: 0,0:06:21.50,0:06:27.05,Default,,0000,0000,0000,,Używając mych zdolności jak pisarz porno, pewnego dnia osiągnę status literata!
Dialogue: 0,0:06:29.33,0:06:32.77,Default,,0000,0000,0000,,A kiedy moja literatura poruszy serca ludzkości...
Dialogue: 0,0:06:32.77,0:06:36.69,Default,,0000,0000,0000,,Nie, w dniu, w którym na wieki wyryję swoje imię w historii literatury...
Comment: 0,0:06:34.56,0:06:35.43,Default,,0000,0000,0000,,[Sign: {}Between Warmth and Wetness{} by Akutagawa Taketo, Best Seller!]
Comment: 0,0:06:35.35,0:06:36.19,Default,,0000,0000,0000,,[Sign: Huge new print run!!]
Dialogue: 0,0:06:37.99,0:06:39.56,Default,,0000,0000,0000,,...świat się zmieni!
Dialogue: 0,0:06:39.75,0:06:44.96,Default,,0000,0000,0000,,Kiedy zatriumfuję nad tymi, którzy mnie wyśmiewali, to będzie mój dzień chwały!
Dialogue: 0,0:06:41.15,0:06:44.15,Brushy Signs,,0000,0000,0000,,{\fs40\move(938,132,928,-135)\c&H83908D&}Akutagawa Taketo\N Zdobywa nagrodę zarządcy Tokio
Dialogue: 0,0:06:45.53,0:06:47.66,Default,,0000,0000,0000,,Będę żył jak król!
Dialogue: 0,0:06:47.66,0:06:49.69,Default,,0000,0000,0000,,Będę otoczony pięknymi dziewczętami na słonecznej wyspie
Dialogue: 0,0:06:49.69,0:06:51.91,Default,,0000,0000,0000,,i cieszył się życiem w porno-pałacu!
Dialogue: 0,0:06:55.92,0:06:57.47,Default,,0000,0000,0000,,Hej, Taketo!
Dialogue: 0,0:06:58.92,0:07:00.48,Default,,0000,0000,0000,,Słuchasz mnie?
Dialogue: 0,0:07:01.52,0:07:03.19,Default,,0000,0000,0000,,T-twoje rzęsy są za długie!
Dialogue: 0,0:07:03.19,0:07:05.18,Default,,0000,0000,0000,,To znaczy, słucham, słucham.
Dialogue: 0,0:07:05.17,0:07:08.55,Default,,0000,0000,0000,,Tak, otwarty... Zbyt otwarty. Lubię...
Dialogue: 0,0:07:09.45,0:07:10.39,Default,,0000,0000,0000,,Znaczy się, lubię cię...
Dialogue: 0,0:07:09.45,0:07:14.74,Comment,,0000,0000,0000,,Dla tych, co nie rozumieją: to taka japońska gra słów. Chodzi o słowo "suki" (lubić\kochać), obecne także w zwrocie "suki o mise" (być odsłoniętym\otwartym)
Dialogue: 0,0:07:12.55,0:07:14.74,Default,,0000,0000,0000,,L-lubisz mnie?
Dialogue: 0,0:07:15.10,0:07:17.36,Default,,0000,0000,0000,,Co ty wygadujesz?
Dialogue: 0,0:07:17.36,0:07:20.13,Default,,0000,0000,0000,,Jestem tylko twoim kumplem.
Dialogue: 0,0:07:20.13,0:07:21.06,Default,,0000,0000,0000,,Więc...
Dialogue: 0,0:07:21.85,0:07:22.91,Default,,0000,0000,0000,,Ritsu?
Dialogue: 0,0:07:23.75,0:07:27.57,Default,,0000,0000,0000,,Ale ja... Ja zdecydowanie nie, dobra?
Dialogue: 0,0:07:27.57,0:07:31.24,Default,,0000,0000,0000,,Uspokój się, Ritsu! Masz, napiszę ci to jeszcze raz.
Dialogue: 0,0:07:31.24,0:07:32.30,Default,,0000,0000,0000,,Ile to się równa?
Dialogue: 0,0:07:33.97,0:07:40.94,Default,,0000,0000,0000,,3.141592653589793238462643...
Dialogue: 0,0:07:40.94,0:07:45.01,Default,,0000,0000,0000,,Wygląda, jakby cały czas był poważny, ale w rzeczywistości jest szczery i miły.
Dialogue: 0,0:07:45.01,0:07:49.11,Default,,0000,0000,0000,,Tylko dlaczego czasami gada bez sensu?
Dialogue: 0,0:07:49.11,0:07:51.39,Default,,0000,0000,0000,,Proszę, Onee-sama. Otwórz buzię!
Dialogue: 0,0:07:53.05,0:07:54.49,Default,,0000,0000,0000,,I jak?
Dialogue: 0,0:07:55.18,0:07:56.68,Default,,0000,0000,0000,,Pyszne!
Dialogue: 0,0:07:56.68,0:08:01.14,Default,,0000,0000,0000,,Aa-chan, twoje smażone krewetki są tak pyszne, że ich smak odbija się echem w galaktyce!
Dialogue: 0,0:08:02.80,0:08:05.67,Default,,0000,0000,0000,,Jak się tak zastanowić, Ritsu powiedział kiedyś,
Dialogue: 0,0:08:05.67,0:08:06.69,Default,,0000,0000,0000,,że Ran...
Dialogue: 0,0:08:13.29,0:08:15.03,Default,,0000,0000,0000,,Jakie to słodkie.
Dialogue: 0,0:08:15.03,0:08:17.29,Default,,0000,0000,0000,,Onee-sama, wstydzę się...
Dialogue: 0,0:08:17.29,0:08:19.71,Default,,0000,0000,0000,,Zobaczmy, jak smakujesz tam na dole...
Dialogue: 0,0:08:25.95,0:08:31.11,Default,,0000,0000,0000,,Cóż, akurat ja nie powinienem wypowiadać się na temat cudzych upodobań.
Dialogue: 0,0:08:31.11,0:08:31.88,Default,,0000,0000,0000,,Ała!
Dialogue: 0,0:08:31.88,0:08:34.36,Default,,0000,0000,0000,,Przestań się na nas gapić! To obrzydliwe!
Dialogue: 0,0:08:34.99,0:08:36.63,Default,,0000,0000,0000,,Czekaj no chwilę.
Dialogue: 0,0:08:37.00,0:08:40.70,Default,,0000,0000,0000,,On nawet nic nie powiedział. To było kompletnie nieuzasadnione.
Dialogue: 0,0:08:40.70,0:08:42.95,Default,,0000,0000,0000,,Co niby Taketo wam zrobił?
Dialogue: 0,0:08:42.95,0:08:44.89,Default,,0000,0000,0000,,Patrzał się na nas tym zbereźnym wzrokiem!
Dialogue: 0,0:08:44.89,0:08:46.65,Default,,0000,0000,0000,,Założę się, że wyobrażał sobie coś zboczonego.
Dialogue: 0,0:08:46.97,0:08:50.40,Default,,0000,0000,0000,,I uważam, że nie ma nawet prawa używać mojego imienia!
Dialogue: 0,0:08:50.40,0:08:52.46,Default,,0000,0000,0000,,Teraz jesteś geniuszem psychologii?
Dialogue: 0,0:08:52.46,0:08:55.95,Default,,0000,0000,0000,,Jakby co, to ja potrzebuję bardziej logicznego wyjaśnienia.
Dialogue: 0,0:08:55.95,0:08:57.01,Default,,0000,0000,0000,,Że co?
Dialogue: 0,0:08:57.01,0:08:58.08,Default,,0000,0000,0000,,No co?!
Dialogue: 0,0:08:59.99,0:09:03.24,Default,,0000,0000,0000,,Ritsu, jestem ci wdzięczny za twą przyjaźń...
Dialogue: 0,0:09:03.24,0:09:06.09,Default,,0000,0000,0000,,ale naprawdę sobie coś wyobrażałem. Wybacz.
Dialogue: 0,0:09:24.09,0:09:25.35,Default,,0000,0000,0000,,Sz-szefie!
Dialogue: 0,0:09:25.61,0:09:27.20,Default,,0000,0000,0000,,Szef czego?
Dialogue: 0,0:09:27.20,0:09:30.79,Default,,0000,0000,0000,,Ne znasz jej? Jest szefem Kółka Dziennikarskiego.
Dialogue: 0,0:09:30.79,0:09:34.03,Default,,0000,0000,0000,,Jest pierwszej klasy geniuszem, nawet tu, w Akademii Inspiracji.
Dialogue: 0,0:09:35.69,0:09:39.58,Default,,0000,0000,0000,,Taketo, wybraliśmy materiał na pierwszą stronę gazety na przyszły tydzień.
Dialogue: 0,0:09:43.06,0:09:47.23,Default,,0000,0000,0000,,"Dodatek specjalny o nowych uczniach! Uważajcie na tych geniuszy!"
Dialogue: 0,0:09:47.23,0:09:50.80,Default,,0000,0000,0000,,"Część 1: Narukara Fukune, genialna klarnecistka."
Dialogue: 0,0:09:51.07,0:09:52.18,Default,,0000,0000,0000,,Fukune?
Dialogue: 0,0:09:53.25,0:09:56.03,Default,,0000,0000,0000,,Więc pierwsza będzie z naszej klasy?
Dialogue: 0,0:09:56.03,0:09:57.55,Default,,0000,0000,0000,,Zapowiada się ciekawie.
Dialogue: 0,0:09:57.55,0:10:01.25,Default,,0000,0000,0000,,Ee, szefie, przepraszam,
Dialogue: 0,0:10:01.27,0:10:04.56,Default,,0000,0000,0000,,ale nie wiem, czy to dobry pomysł, bym ja przeprowadził ten wywiad...
Dialogue: 0,0:10:04.58,0:10:06.48,Default,,0000,0000,0000,,Jakiś problem?
Dialogue: 0,0:10:06.48,0:10:07.81,Default,,0000,0000,0000,,Yy, więc...
Dialogue: 0,0:10:08.08,0:10:10.85,Default,,0000,0000,0000,,Jest...Tak jakby...
Dialogue: 0,0:10:10.85,0:10:11.86,Default,,0000,0000,0000,,Ałć.
Dialogue: 0,0:10:11.86,0:10:14.18,Default,,0000,0000,0000,,Zajmij się tym dla mnie, dobrze?
Dialogue: 0,0:10:15.47,0:10:17.62,Default,,0000,0000,0000,,A-ale, szefie!
Dialogue: 0,0:10:33.21,0:10:36.08,Default,,0000,0000,0000,,Nie ma jej w klasie ani w sali muzycznej.
Dialogue: 0,0:10:36.32,0:10:39.46,Default,,0000,0000,0000,,I nie wróciła do swojego pokoju w akademiku, więc...
Dialogue: 0,0:10:42.45,0:10:45.98,Default,,0000,0000,0000,,Naprawdę jej szukasz, Akutagawa Taketo.
Dialogue: 0,0:10:45.98,0:10:49.61,Default,,0000,0000,0000,,Jesteś prawie jak prześladowca... stalker boy.
Dialogue: 0,0:10:49.61,0:10:53.48,Default,,0000,0000,0000,,Nie mam wyboru! Muszę zrobić z nią wywiad dla Kółka Dziennikarskiego.
Dialogue: 0,0:10:53.48,0:10:57.49,Default,,0000,0000,0000,,Przypuszczam, że z taką wymówką możesz robić, co chcesz.
Dialogue: 0,0:10:57.49,0:10:59.48,Default,,0000,0000,0000,,Masz szczęście, zboczeńcu.
Dialogue: 0,0:10:59.66,0:11:03.22,Default,,0000,0000,0000,,A właściwie dlaczego ty chodzisz za mną?
Dialogue: 0,0:11:03.22,0:11:05.49,Default,,0000,0000,0000,,Nie jesteś członkiem Kółka Dziennikarskiego.
Dialogue: 0,0:11:07.62,0:11:09.67,Default,,0000,0000,0000,,Poprosili mnie, bym zrobiła kilka zdjęć.
Dialogue: 0,0:11:09.67,0:11:13.00,Default,,0000,0000,0000,,Nie wiedziałeś, Panie Brudne Myśli?
Dialogue: 0,0:11:13.15,0:11:16.15,Default,,0000,0000,0000,,No dalej. Pokaż mi, kim naprawdę jesteś.
Dialogue: 0,0:11:16.15,0:11:17.67,Default,,0000,0000,0000,,Kim naprawdę jestem?
Dialogue: 0,0:11:17.84,0:11:20.13,Default,,0000,0000,0000,,Chcę momentu brzydoty i żądzy.
Dialogue: 0,0:11:20.13,0:11:23.93,Default,,0000,0000,0000,,Właśnie w takich momentach ludzie odsłaniają swe prawdziwe oblicze.
Dialogue: 0,0:11:25.06,0:11:27.91,Default,,0000,0000,0000,,No co jest? Dalej. Zrób to...
Dialogue: 0,0:11:38.47,0:11:40.90,Default,,0000,0000,0000,,Przestań, głupi szkodniku!
Dialogue: 0,0:11:40.90,0:11:42.52,Default,,0000,0000,0000,,Ja tu jestem od robienia zdjęć!
Dialogue: 0,0:11:42.52,0:11:45.24,Default,,0000,0000,0000,,Nie, tej nocy to ja będę robił zdjęcia tobie.
Dialogue: 0,0:11:48.82,0:11:51.24,Default,,0000,0000,0000,,Już wiem, co będzie na mojej własnej pierwszej stronie...
Dialogue: 0,0:11:52.57,0:11:54.46,Default,,0000,0000,0000,,M-moje oczy!
Dialogue: 0,0:11:54.46,0:11:57.86,Default,,0000,0000,0000,,Ta mina była całkiem niezła, robaku.
Dialogue: 0,0:11:57.86,0:11:59.70,Default,,0000,0000,0000,,Chodząca porażko...
Dialogue: 0,0:12:03.79,0:12:09.92,Default,,0000,0000,0000,,"Mężczyzna włożył swoje czarno-czerwone szaleństwo w jej drżący dzbanek miodu.
Dialogue: 0,0:12:09.92,0:12:10.84,Default,,0000,0000,0000,,'Aaach...'
Dialogue: 0,0:12:10.84,0:12:13.03,Default,,0000,0000,0000,,Sok rozkoszy rozlał się.
Dialogue: 0,0:12:13.03,0:12:16.32,Default,,0000,0000,0000,,Był gorętszy niż magma i słodszy niż śmietana,
Dialogue: 0,0:12:16.32,0:12:19.83,Default,,0000,0000,0000,,lecz miał w sobie gorycz grzechu.
Dialogue: 0,0:12:19.83,0:12:21.98,Default,,0000,0000,0000,,A wtedy fotografistka..."
Dialogue: 0,0:12:22.21,0:12:23.86,Default,,0000,0000,0000,,Przestań, idiotko! Nie czytaj tego!
Dialogue: 0,0:12:24.68,0:12:27.80,Default,,0000,0000,0000,,Co jest? Wyobrażałeś sobie scenę ze mną?
Dialogue: 0,0:12:27.80,0:12:29.83,Default,,0000,0000,0000,,Cóż, tak trzymaj.
Dialogue: 0,0:12:29.83,0:12:32.83,Default,,0000,0000,0000,,Nie przegap okazji do wyzwolenia swych instynktów.
Dialogue: 0,0:12:35.88,0:12:39.23,Default,,0000,0000,0000,,Co tak siedzisz? Rusz się, porno-dziwaku!
Dialogue: 0,0:12:39.23,0:12:41.00,Default,,0000,0000,0000,,A niby czyja to wina?
Dialogue: 0,0:12:43.15,0:12:45.41,Default,,0000,0000,0000,,Ale ma rację. To moja szansa.
Dialogue: 0,0:12:45.41,0:12:47.36,Default,,0000,0000,0000,,Nie mam czasu się lenić.
Dialogue: 0,0:12:48.17,0:12:51.55,Default,,0000,0000,0000,,Chcę porozmawiać z Narukarą.
Dialogue: 0,0:12:51.55,0:12:53.39,Default,,0000,0000,0000,,Chcę móc z nią porozmawiać.
Dialogue: 0,0:12:53.39,0:12:56.71,Default,,0000,0000,0000,,I chcę ją przeprosić.
Dialogue: 0,0:13:07.53,0:13:08.86,SONGDERP,,0000,0000,0000,,{\an8}Kocham cię!{}
Dialogue: 0,0:13:08.86,0:13:13.37,SONGDERP,,0000,0000,0000,,{\an8}Kocham was, letnie dni!{}
Dialogue: 0,0:13:13.37,0:13:17.12,SONGDERP,,0000,0000,0000,,{\an8}{}Nieważne, ile czasu upłynie{}
Dialogue: 0,0:13:17.41,0:13:20.00,SONGDERP,,0000,0000,0000,,{\an8}Zawsze będę o tobie pamiętać{}
Dialogue: 0,0:13:20.00,0:13:24.13,SONGDERP,,0000,0000,0000,,{\an8}Wspomnienia pierwszej miłości!{}
Dialogue: 0,0:13:20.37,0:13:22.12,Titles,,0000,0000,0000,,{\pos(705,483)\fad(50,0)}Sonokoe Utae
Dialogue: 0,0:13:21.25,0:13:22.12,Titles,,0000,0000,0000,,{\pos(725,571)\fad(50,0)}Utalentowana Idolka
Dialogue: 0,0:13:34.26,0:13:36.32,Default,,0000,0000,0000,,Nawet na chwilę nie mogę spuścić cię z oczu!
Dialogue: 0,0:13:43.57,0:13:48.10,Default,,0000,0000,0000,,Nie było jej nigdzie, gdzie szukałem. Gdzie jeszcze może być?
Dialogue: 0,0:14:05.28,0:14:07.93,Default,,0000,0000,0000,,Zostaw mnie! Zostaw mnie! Zostaw mnie!
Dialogue: 0,0:14:09.84,0:14:12.10,Default,,0000,0000,0000,,Z drogi! Z drogi! Z drogi! Z drogi!
Dialogue: 0,0:14:19.68,0:14:21.52,Titles,,0000,0000,0000,,{\pos(672,499)\fad(50,0)}Kagaku Tsukuru
Dialogue: 0,0:14:20.52,0:14:21.52,Titles,,0000,0000,0000,,{\pos(672,594)\fad(50,0)}Genialna Wynalazczyni
Dialogue: 0,0:14:25.71,0:14:28.44,Default,,0000,0000,0000,,Wydajność też jest w porządku...
Dialogue: 0,0:14:29.50,0:14:31.28,Default,,0000,0000,0000,,Może to wina balansu...
Dialogue: 0,0:14:31.59,0:14:34.28,Default,,0000,0000,0000,,Chyba będę musiała dopracować konstrukcję skrzydeł...
Dialogue: 0,0:15:22.80,0:15:25.44,Default,,0000,0000,0000,,Co to jest? Może jakiś rodzaj orzechów?
Dialogue: 0,0:15:26.19,0:15:28.01,Default,,0000,0000,0000,,Ładnie pachnie.
Dialogue: 0,0:15:29.83,0:15:31.84,Default,,0000,0000,0000,,Jest jakiś wilgotny...
Dialogue: 0,0:15:36.17,0:15:40.10,Default,,0000,0000,0000,,Co... ty... robisz...?
Dialogue: 0,0:15:40.10,0:15:42.59,Default,,0000,0000,0000,,Yy, tego...
Dialogue: 0,0:15:43.44,0:15:45.24,Default,,0000,0000,0000,,Byłem trochę głodny
Dialogue: 0,0:15:45.72,0:15:49.73,Default,,0000,0000,0000,,i w dodatku niewyspany, więc trochę odleciałem...
Dialogue: 0,0:15:47.73,0:15:49.73,Default,,0000,0000,0000,,{\an8}Mój ustnik...{overlap}
Dialogue: 0,0:15:51.76,0:15:53.61,Default,,0000,0000,0000,,T-to nie tak!
Dialogue: 0,0:15:54.11,0:15:54.90,Default,,0000,0000,0000,,N...
Dialogue: 0,0:15:54.90,0:15:55.86,Default,,0000,0000,0000,,N?
Dialogue: 0,0:15:55.86,0:15:58.91,Default,,0000,0000,0000,,Nie jedz tego!
Dialogue: 0,0:16:05.23,0:16:07.38,Default,,0000,0000,0000,,Nie miałem zamiaru!
Dialogue: 0,0:16:10.11,0:16:10.99,Default,,0000,0000,0000,,Sen?
Dialogue: 0,0:16:15.21,0:16:16.50,Default,,0000,0000,0000,,Może tam?
Dialogue: 0,0:16:19.44,0:16:20.97,Default,,0000,0000,0000,,Ta-da!
Dialogue: 0,0:16:20.97,0:16:24.07,Default,,0000,0000,0000,,Ruszaj! Ruszaj, Inspiracjo! Naprzód, Inspiracjo!
Dialogue: 0,0:16:24.07,0:16:27.23,Default,,0000,0000,0000,,Walcz! Walcz! Jej!
Dialogue: 0,0:16:28.66,0:16:31.29,Default,,0000,0000,0000,,Racja. To tutaj ja...
Dialogue: 0,0:16:36.11,0:16:37.37,Default,,0000,0000,0000,,...i Narukara...
Dialogue: 0,0:16:48.56,0:16:51.55,Default,,0000,0000,0000,,Cz-czemu się w nią wpatruję?
Dialogue: 0,0:16:52.76,0:16:54.32,Default,,0000,0000,0000,,To moja szansa!
Dialogue: 0,0:16:54.32,0:16:57.67,Default,,0000,0000,0000,,Raiki tu nie ma, mogę z nią porozmawiać sam na sam.
Dialogue: 0,0:16:57.67,0:16:59.85,Default,,0000,0000,0000,,T-to nie będzie trudne, prawda?
Dialogue: 0,0:17:01.38,0:17:03.76,Default,,0000,0000,0000,,Co to za uczucie?
Dialogue: 0,0:17:08.58,0:17:11.28,Default,,0000,0000,0000,,C-co ja robię?
Dialogue: 0,0:17:11.28,0:17:14.42,Default,,0000,0000,0000,,Przestań! Przestań!
Dialogue: 0,0:17:14.81,0:17:15.95,Default,,0000,0000,0000,,Ja...
Dialogue: 0,0:17:52.29,0:17:53.35,Default,,0000,0000,0000,,Ja...
Dialogue: 0,0:17:53.63,0:17:55.25,Default,,0000,0000,0000,,C-co ja napisałem?
Dialogue: 0,0:17:55.25,0:17:56.59,Default,,0000,0000,0000,,Co ty wyprawiasz?
Dialogue: 0,0:17:57.98,0:18:00.48,Default,,0000,0000,0000,,Nie, to jest... to nie tak...
Dialogue: 0,0:18:02.01,0:18:05.00,Default,,0000,0000,0000,,Bezbronna dziewczyna śpi tutaj, tuż przed tobą!
Dialogue: 0,0:18:05.00,0:18:08.17,Default,,0000,0000,0000,,Rusz się i pożryj ją!
Dialogue: 0,0:18:08.17,0:18:09.82,Default,,0000,0000,0000,,Jak głodna świnia!
Dialogue: 0,0:18:09.82,0:18:13.66,Default,,0000,0000,0000,,Ruszaj! Naprzód! Rzuć się na nią z kwikiem, zboczona świnio!
Dialogue: 0,0:18:14.78,0:18:17.26,Default,,0000,0000,0000,,I ty się nazywasz zboczonym nastolatkiem?
Dialogue: 0,0:18:17.26,0:18:18.58,Default,,0000,0000,0000,,Powinieneś się wstydzić!
Dialogue: 0,0:18:18.58,0:18:19.84,Default,,0000,0000,0000,,Ty ******!
Dialogue: 0,0:18:19.84,0:18:21.48,Default,,0000,0000,0000,,O co się tak wściekasz?
Dialogue: 0,0:18:24.93,0:18:26.50,Default,,0000,0000,0000,,A to co?
Dialogue: 0,0:18:27.07,0:18:28.46,Default,,0000,0000,0000,,To jest, ten...
Dialogue: 0,0:18:29.45,0:18:35.97,Default,,0000,0000,0000,,"Jeśli miałbyś to nazwać, powinieneś określić to jako najczystszą kroplę, złotą kroplę."
Dialogue: 0,0:18:35.97,0:18:40.11,Default,,0000,0000,0000,,"Lśniący klejnot, stworzony z życia i piękna wiosny.
Dialogue: 0,0:18:40.36,0:18:42.07,Default,,0000,0000,0000,,To było..."
Dialogue: 0,0:18:43.92,0:18:45.31,Default,,0000,0000,0000,,Co to ma być?
Dialogue: 0,0:18:45.31,0:18:46.86,Default,,0000,0000,0000,,Nie czytaj tego! Po prostu nie czytaj!
Dialogue: 0,0:18:47.13,0:18:48.87,Default,,0000,0000,0000,,To nie jest w twoim stylu!
Dialogue: 0,0:18:48.87,0:18:51.37,Default,,0000,0000,0000,,Powinieneś pisać o jej kobiecym gąszczu czy coś!
Dialogue: 0,0:18:51.52,0:18:53.63,Default,,0000,0000,0000,,Albo o lśniącej, mięsistej włóczni!
Dialogue: 0,0:18:53.63,0:18:56.25,Default,,0000,0000,0000,,Albo o brzoskwince! Coś w ten deseń!
Dialogue: 0,0:18:56.25,0:18:57.96,Default,,0000,0000,0000,,Postradałeś rozum, Taketo?
Dialogue: 0,0:18:57.95,0:18:59.67,Default,,0000,0000,0000,,Co ty w ogóle wygadujesz?
Dialogue: 0,0:18:59.67,0:19:03.31,Default,,0000,0000,0000,,Zgwałcić! Zbezcześcić! Wzgórek łonowy! Powtórz! Weź się w garść!
Dialogue: 0,0:19:03.31,0:19:05.29,Default,,0000,0000,0000,,Zgwałcić! Zbezcześcić! Wzgórek łonowy! Powiedz to!
Dialogue: 0,0:19:05.29,0:19:06.72,Default,,0000,0000,0000,,W życiu tego nie powiem!
Dialogue: 0,0:19:06.72,0:19:08.59,Default,,0000,0000,0000,,Zgwałcić... Zbezcześcić...
Dialogue: 0,0:19:08.59,0:19:10.97,Default,,0000,0000,0000,,Wzgórek łonowy...
Dialogue: 0,0:19:10.97,0:19:12.90,Default,,0000,0000,0000,,Słuchaj! Jesteś...
Dialogue: 0,0:19:21.81,0:19:24.11,Default,,0000,0000,0000,,Z-znowu?!
Dialogue: 0,0:19:26.80,0:19:28.06,Default,,0000,0000,0000,,Narukara?
Dialogue: 0,0:20:10.22,0:20:12.99,Default,,0000,0000,0000,,E-e-e-e no tego...
Dialogue: 0,0:20:14.94,0:20:16.76,Default,,0000,0000,0000,,Nie!
Dialogue: 0,0:20:16.76,0:20:18.21,Default,,0000,0000,0000,,N-narukara, zaczekaj...
Dialogue: 0,0:20:29.82,0:20:32.81,Default,,0000,0000,0000,,Skończyłem z większymi problemami niż ten wywiad...
Dialogue: 0,0:20:35.00,0:20:37.72,Default,,0000,0000,0000,,Ale co to było, w każdym razie?
Dialogue: 0,0:20:38.70,0:20:43.27,Default,,0000,0000,0000,,Nigdy czegoś takiego nie czułem. Było zupełnie inne, niż zwykle.
Dialogue: 0,0:20:43.54,0:20:48.28,Default,,0000,0000,0000,,Było energiczne i przytłaczające, ale jakby czyste.
Dialogue: 0,0:20:48.95,0:20:50.20,Default,,0000,0000,0000,,Ne, było bardziej...
Dialogue: 0,0:20:50.20,0:20:52.83,Default,,0000,0000,0000,,bardziej... Sam już nie wiem.
Dialogue: 0,0:20:55.00,0:20:57.57,Default,,0000,0000,0000,,Jaki sens ma rozmyślanie nad tym?
Dialogue: 0,0:20:57.57,0:21:00.50,Default,,0000,0000,0000,,Jestem pisarzem! Jest tylko jedna rzecz, którą mogę zrobić...
Dialogue: 0,0:21:00.50,0:21:01.52,Default,,0000,0000,0000,,Pisać!
Dialogue: 0,0:21:16.56,0:21:19.10,Default,,0000,0000,0000,,Transformuję się ze swym magicznym klarnetem!
Dialogue: 0,0:21:20.06,0:21:22.75,Default,,0000,0000,0000,,Purarara Purarira Pururupi!
Dialogue: 0,0:21:23.27,0:21:25.59,Default,,0000,0000,0000,,Nigdy nie przestanę dmuchać!
Dialogue: 0,0:21:25.59,0:21:27.73,Default,,0000,0000,0000,,Magiczna Fukune!
Dialogue: 0,0:21:28.07,0:21:33.02,Default,,0000,0000,0000,,"Purarira... Pururupi..."
Dialogue: 0,0:21:33.71,0:21:35.70,Default,,0000,0000,0000,,C-co to ma być?
Dialogue: 0,0:21:36.36,0:21:39.00,Default,,0000,0000,0000,,Czemu piszę nowelkę?
Dialogue: 0,0:21:39.00,0:21:41.67,Default,,0000,0000,0000,,P-pierwszy raz zdarza mi się coś takiego.
Dialogue: 0,0:21:41.67,0:21:43.04,Default,,0000,0000,0000,,Co takiego?
Dialogue: 0,0:21:43.99,0:21:44.98,Default,,0000,0000,0000,,Szefie!
Dialogue: 0,0:21:44.98,0:21:47.71,Default,,0000,0000,0000,,Taketo! Skończyłeś swój artykuł?
Dialogue: 0,0:21:47.71,0:21:49.37,Default,,0000,0000,0000,,Ee, to jest...
Dialogue: 0,0:21:49.37,0:21:51.42,Default,,0000,0000,0000,,Czekaj. Mogę to wyjaśnić.
Dialogue: 0,0:21:51.85,0:21:53.76,Default,,0000,0000,0000,,A tak w ogóle to co ty robisz w męskim akademiku?
Dialogue: 0,0:21:53.76,0:21:56.59,Default,,0000,0000,0000,,Cóż, skoro nie skończyłeś, to trudno.
Dialogue: 0,0:21:56.59,0:22:01.39,Default,,0000,0000,0000,,Będę czekała tak długo, aż napiszesz coś dobrego, panie Akutagawa!
Dialogue: 0,0:22:02.89,0:22:04.60,Default,,0000,0000,0000,,Sz-szefie...
Dialogue: 0,0:22:05.44,0:22:07.61,Default,,0000,0000,0000,,Naprawdę myślałeś, że powiem coś takiego?
Dialogue: 0,0:22:08.62,0:22:09.90,Default,,0000,0000,0000,,Nie...
Dialogue: 0,0:22:16.28,0:22:17.92,Default,,0000,0000,0000,,Bez jaj!
Dialogue: 0,0:22:22.75,0:22:23.79,Default,,0000,0000,0000,,Jeszcze raz!
