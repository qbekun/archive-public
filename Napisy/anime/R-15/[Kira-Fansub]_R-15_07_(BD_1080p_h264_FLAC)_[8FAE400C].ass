Dialogue: 0,0:22:33.75,0:22:36.60,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.60,0:22:39.17,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.26,0:22:52.51,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.66,0:22:54.09,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.13,0:22:55.36,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.36,0:22:56.74,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:56.96,0:22:58.23,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.38,0:22:59.80,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.84,0:23:02.13,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.45,0:23:05.67,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.75,0:23:07.89,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.00,0:23:10.52,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.54,0:23:12.78,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.04,0:23:14.59,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.61,0:23:15.84,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:15.91,0:23:18.58,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.75,0:23:20.03,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.16,0:23:23.80,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.49,0:23:25.87,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:25.91,0:23:27.34,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.38,0:23:30.01,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.14,0:23:32.47,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.47,0:23:35.19,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.61,0:23:39.45,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.48,0:23:42.02,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.55,0:24:05.88,Introduction/Gauge,,0000,0000,0000,,{\pos(631,250)}Wskaźnik dzisiejszego krwawienia z nosa
Dialogue: 0,0:24:07.35,0:24:08.64,Dialogue,,0000,0000,0000,,Oczyszczenie.
Dialogue: 0,0:24:08.64,0:24:09.47,Dialogue,,0000,0000,0000,,Yah!
Dialogue: 0,0:24:09.47,0:24:10.76,Dialogue,,0000,0000,0000,,Oczyszczenie.
Dialogue: 0,0:24:10.76,0:24:11.74,Dialogue,,0000,0000,0000,,Yah!
Dialogue: 0,0:24:12.40,0:24:27.33,Title,,0000,0000,0000,,{\an4\pos(102,265)}W następnym odcinku:\NDzień bez\NInspiracji
Dialogue: 0,0:24:12.95,0:24:14.87,Dialogue,,0000,0000,0000,,To ja, Enshuu Ritsu.
Dialogue: 0,0:24:14.87,0:24:19.81,Dialogue,,0000,0000,0000,,M-matma nie jest gorsza od czegokolwiek! Możesz robić...
Dialogue: 0,0:24:19.81,0:24:21.44,Dialogue,,0000,0000,0000,,Dużo rzeczy...
Dialogue: 0,0:24:21.44,0:24:23.25,Dialogue,,0000,0000,0000,,Na przykład trójkąty!
Dialogue: 0,0:24:23.25,0:24:24.80,Dialogue,,0000,0000,0000,,Albo kątomierze!
Dialogue: 0,0:24:24.80,0:24:27.33,Dialogue,,0000,0000,0000,,Mnóstwo rz-rzeczy—
