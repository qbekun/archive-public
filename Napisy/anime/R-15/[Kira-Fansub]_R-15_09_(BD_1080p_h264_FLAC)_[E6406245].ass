Dialogue: 0,0:22:33.87,0:22:36.72,EnglishED,,0000,0000,0000,,Spójrz, moc inspiracji i brak energii
Dialogue: 0,0:22:36.72,0:22:39.29,EnglishED,,0000,0000,0000,,Krzyczą "banzai" i unoszą znak pokoju
Dialogue: 0,0:22:51.38,0:22:52.63,EnglishED,,0000,0000,0000,,W najlepsze poranki jestem zawsze radosna,
Dialogue: 0,0:22:52.78,0:22:54.21,EnglishED,,0000,0000,0000,,ponieważ wiem, że mam swoją szczęśliwą bieliznę
Dialogue: 0,0:22:54.25,0:22:55.48,EnglishED,,0000,0000,0000,,Tajemnicze, miękkie uczucie
Dialogue: 0,0:22:55.48,0:22:56.86,EnglishED,,0000,0000,0000,,Jest całkiem niesamowite
Dialogue: 0,0:22:57.08,0:22:58.35,EnglishED,,0000,0000,0000,,Chcę szybko zobaczyć swojego ukochanego,
Dialogue: 0,0:22:58.50,0:22:59.92,EnglishED,,0000,0000,0000,,który jest samolubnym prawiczkiem
Dialogue: 0,0:22:59.96,0:23:02.25,EnglishED,,0000,0000,0000,,nawet, jeśli bycie chłopczycą jest zabronione, jest OK!
Dialogue: 0,0:23:02.57,0:23:05.79,EnglishED,,0000,0000,0000,,Polećmy razem
Dialogue: 0,0:23:05.87,0:23:08.01,EnglishED,,0000,0000,0000,,przez lśniący raj klasy
Dialogue: 0,0:23:08.12,0:23:10.64,EnglishED,,0000,0000,0000,,Powiedzcie wszyscy! Przyjemna przesyłka!
Dialogue: 0,0:23:10.66,0:23:12.90,EnglishED,,0000,0000,0000,,Pobiegnijmy i zagrajmy w piłkę!
Dialogue: 0,0:23:13.16,0:23:14.71,EnglishED,,0000,0000,0000,,Naprzód, banzai, pokój!
Dialogue: 0,0:23:14.73,0:23:15.96,EnglishED,,0000,0000,0000,,Wytrwały pokój!
Dialogue: 0,0:23:16.03,0:23:18.70,EnglishED,,0000,0000,0000,,Z pewnością coś dobrego się dziś wydarzy
Dialogue: 0,0:23:18.87,0:23:20.15,EnglishED,,0000,0000,0000,,Unieś ręce w górę i skocz!
Dialogue: 0,0:23:20.28,0:23:23.92,EnglishED,,0000,0000,0000,,Przyciągnij napiętą uwagę boga
Dialogue: 0,0:23:24.61,0:23:25.99,EnglishED,,0000,0000,0000,,Jeszcze raz! Banzai, pokój!
Dialogue: 0,0:23:26.03,0:23:27.46,EnglishED,,0000,0000,0000,,"Wszystko dobrze", pokój!
Dialogue: 0,0:23:27.50,0:23:30.13,EnglishED,,0000,0000,0000,,Cały czas się uśmiechaj
Dialogue: 0,0:23:30.26,0:23:32.59,EnglishED,,0000,0000,0000,,Jeśli na 100% wypełnione pewnością siebie
Dialogue: 0,0:23:32.59,0:23:35.31,EnglishED,,0000,0000,0000,,jest twoje serce
Dialogue: 0,0:23:36.73,0:23:39.57,EnglishED,,0000,0000,0000,,Spójrz, przeskakujemy granice mocą inspiracji
Dialogue: 0,0:23:39.60,0:23:42.14,EnglishED,,0000,0000,0000,,Maszerując i krzycząc "banzai" dla pokoju. Naprzód!
Dialogue: 0,0:24:02.21,0:24:05.62,Introduction/Gauge,,0000,0000,0000,,{\pos(640,250)}Wskaźnik dzisiejszego krwawienia z nosa
Dialogue: 0,0:24:07.81,0:24:10.51,Dialogue,,0000,0000,0000,,Chodź, zjedz sobie moich pierożków.
Dialogue: 0,0:24:12.25,0:24:27.14,Title,,0000,0000,0000,,{\an4\pos(100,240)}W następnym odcinku:\NElegia Parnego Miasta
Dialogue: 0,0:24:12.95,0:24:14.55,Dialogue,,0000,0000,0000,,Mówi szefowa.
Dialogue: 0,0:24:14.55,0:24:16.39,Dialogue,,0000,0000,0000,,Co lubię?
Dialogue: 0,0:24:16.39,0:24:18.43,Dialogue,,0000,0000,0000,,Czy to nie oczywiste?
Dialogue: 0,0:24:18.43,0:24:21.96,Dialogue,,0000,0000,0000,,Długie, twarde...
Dialogue: 0,0:24:21.96,0:24:25.75,Dialogue,,0000,0000,0000,,Uwielbiam czasami je ssać.
Dialogue: 0,0:24:25.75,0:24:27.14,Dialogue,,0000,0000,0000,,Nigdy nie mam dość-
