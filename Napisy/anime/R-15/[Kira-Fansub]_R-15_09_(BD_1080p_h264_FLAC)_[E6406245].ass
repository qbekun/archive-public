Dialogue: 0,0:01:29.02,0:01:31.22,EnglishOP,,0000,0000,0000,,Uwielbiam być podekscytowana!
Dialogue: 0,0:01:40.34,0:01:42.88,EnglishOP,,0000,0000,0000,,Mam w swej głowie piętnaście sekretów
Dialogue: 0,0:01:42.99,0:01:44.89,EnglishOP,,0000,0000,0000,,więc schowałam je w swój mundurek
Dialogue: 0,0:01:45.49,0:01:50.41,EnglishOP,,0000,0000,0000,,Właśnie wyobrażam sobie, jak wirujesz
Dialogue: 0,0:01:51.61,0:01:56.25,EnglishOP,,0000,0000,0000,,Proszę, bądź miły, mimo tego podłego spojrzenia
Dialogue: 0,0:01:56.79,0:02:01.77,EnglishOP,,0000,0000,0000,,Moje pierwsze zauroczenie z pewnością będzie wielkie
Dialogue: 0,0:02:02.96,0:02:05.52,EnglishOP,,0000,0000,0000,,Jestem zbyt zdumiona, by móc mówić
Dialogue: 0,0:02:05.76,0:02:08.20,EnglishOP,,0000,0000,0000,,Chcę poczuć ucisk w piersi, pokaż mi to!
Dialogue: 0,0:02:08.60,0:02:09.66,EnglishOP,,0000,0000,0000,,Szybko! Teraz!
Dialogue: 0,0:02:09.66,0:02:10.73,EnglishOP,,0000,0000,0000,,Gdzie? Co?
Dialogue: 0,0:02:10.73,0:02:13.13,EnglishOP,,0000,0000,0000,,Moje fantazje eksplodowały!
Dialogue: 0,0:02:13.43,0:02:15.98,EnglishOP,,0000,0000,0000,,Chcę zjeść więcej.
Dialogue: 0,0:02:16.30,0:02:19.02,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze potrzymać.
Dialogue: 0,0:02:19.36,0:02:22.10,EnglishOP,,0000,0000,0000,,Jak smakuje twoje serce?
Dialogue: 0,0:02:22.17,0:02:25.12,EnglishOP,,0000,0000,0000,,Pewnego dnia uchwycę rzeczywistość
Dialogue: 0,0:02:25.19,0:02:27.30,EnglishOP,,0000,0000,0000,,Chcę cię jeszcze przytulić
Dialogue: 0,0:02:27.49,0:02:30.30,EnglishOP,,0000,0000,0000,,Będzie dobrze, nawet jeśli pokażesz mi to w tajemnicy
Dialogue: 0,0:02:30.60,0:02:33.44,EnglishOP,,0000,0000,0000,,Ale jeśli to tylko sen, to nic z tego
Dialogue: 0,0:02:33.49,0:02:36.18,EnglishOP,,0000,0000,0000,,Oddam ci moje serce i ciało
Dialogue: 0,0:02:36.29,0:02:38.58,EnglishOP,,0000,0000,0000,,{\an1}tylko dla ciebie
Dialogue: 0,0:02:36.79,0:02:39.55,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:38.75,0:02:41.23,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:39.61,0:02:42.37,EnglishOP,,0000,0000,0000,,{\an3}(Uwielbiam być podekscytowana!)
Dialogue: 0,0:02:41.55,0:02:44.03,EnglishOP,,0000,0000,0000,,{\an1}Na niebie!
Dialogue: 0,0:02:42.48,0:02:44.05,EnglishOP,,0000,0000,0000,,{\an3}Uwielbiam
Dialogue: 0,0:02:44.40,0:02:47.22,EnglishOP,,0000,0000,0000,,być podekscytowana!
Dialogue: 0,0:02:59.58,0:03:03.67,Title,,0000,0000,0000,,{\fad(800,800)\pos(1000,562)}Archiwum X Szefowej
Dialogue: 0,0:03:01.80,0:03:03.58,Dialogue,,0000,0000,0000,,Proszę cię, Ran.
Dialogue: 0,0:03:04.93,0:03:07.60,Dialogue,,0000,0000,0000,,Wystarczy mi jej imię albo adres.
Dialogue: 0,0:03:07.60,0:03:09.76,Dialogue,,0000,0000,0000,,Po prostu ją zapytaj.
Dialogue: 0,0:03:10.13,0:03:12.25,Dialogue,,0000,0000,0000,,Nie musiałbym cię o nic prosić, gdyby mi powiedziała.
Dialogue: 0,0:03:14.12,0:03:16.50,Dialogue,,0000,0000,0000,,No dobra. W końcu jestem ci coś winna.
Dialogue: 0,0:03:18.51,0:03:21.30,Dialogue,,0000,0000,0000,,Mam przeszukać bazę danych akademii, tak?
