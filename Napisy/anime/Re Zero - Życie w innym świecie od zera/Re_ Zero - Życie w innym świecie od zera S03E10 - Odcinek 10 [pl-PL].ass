Dialogue: 0,0:00:08.68,0:00:10.07,Default,Garfiel,0,0,0,,Idziemy do rezydencji?!
Dialogue: 0,0:00:10.52,0:00:13.93,Default,Subaru,0,0,0,,Wiem, co się stanie i muszę\Ntemu zapobiec!
Dialogue: 0,0:00:14.02,0:00:15.85,Default,Subaru,0,0,0,,Przyciąga ją mój zapach, więc...
Dialogue: 0,0:00:15.76,0:00:17.99,Default,Garfiel,0,0,0,,Jeśli proponujesz użyć cię jako przynęty,
Dialogue: 0,0:00:18.08,0:00:20.39,Default,Garfiel,0,0,0,,Odgryzę ci jeden z palców!
Dialogue: 0,0:00:20.48,0:00:24.78,Default,Garfiel,0,0,0,,Staruszka, Ram i wszyscy inni\Njuż zostali połknięci!
Dialogue: 0,0:00:24.87,0:00:28.46,Default,Garfiel,0,0,0,,Okryłbym się hańbą, gdybym pozwolił, żeby\Ndopadła też ciebie!
Dialogue: 0,0:00:29.64,0:00:32.21,Default,Subaru,0,0,0,,Cień... pochłonął ich wszystkich?
Dialogue: 0,0:00:34.57,0:00:35.99,Default,Garfiel,0,0,0,,Tak.
Dialogue: 0,0:00:36.08,0:00:39.78,Default,Garfiel,0,0,0,,Cała ziemia została pochłonięta\Ncieniem zanim nawet się zorientowałem.
Dialogue: 0,0:00:40.20,0:00:45.14,Default,Garfiel,0,0,0,,Gdyby Ram nie odrzuciła mnie podmuchem\Nwiatru, pochłonąłby także mnie.
Dialogue: 0,0:00:46.16,0:00:48.46,Default,Subaru,0,0,0,,Więc Ram i Ryuzu po prostu...
Dialogue: 0,0:00:48.94,0:00:49.82,Default,Subaru,0,0,0,,A Otto...
Dialogue: 0,0:00:50.86,0:00:52.40,Default,Subaru,0,0,0,,A Emilia też?
Dialogue: 0,0:00:57.61,0:01:00.49,Default,Subaru,0,0,0,,Cholera! Dlaczego akurat teraz?!
Dialogue: 0,0:01:01.73,0:01:02.62,Default,Subaru,0,0,0,,Kto tam jest?!
Dialogue: 0,0:01:06.21,0:01:07.91,Default,Subaru,0,0,0,,Co to za żart?
Dialogue: 0,0:01:08.00,0:01:10.67,Default,Garfiel,0,0,0,,Miałem nadzieję, że nie\Nbędziesz musiał tego widzieć.
Dialogue: 0,0:01:10.76,0:01:13.12,Default,Subaru,0,0,0,,Czy to klony Ryuzu?
Dialogue: 0,0:01:13.52,0:01:15.38,Default,Garfiel,0,0,0,,Nie martw się o nie.
Dialogue: 0,0:01:15.47,0:01:16.98,Default,Garfiel,0,0,0,,To nie ona.
Dialogue: 0,0:01:17.07,0:01:19.01,Default,Garfiel,0,0,0,,Są puste od środka.
Dialogue: 0,0:01:19.55,0:01:22.01,Default,Subaru,0,0,0,,Co zamierzasz zrobić?
Dialogue: 0,0:01:23.41,0:01:25.14,Default,Garfiel,0,0,0,,Co o tym sądzisz?
Dialogue: 0,0:01:26.25,0:01:29.58,Default,Garfiel,0,0,0,,Przebijemy się siłą liczebności i\Nzmiażdżymy go!
Dialogue: 0,0:01:44.84,0:01:46.08,Default,Envy,0,0,0,,Kocham cię.
Dialogue: 0,0:01:46.33,0:01:48.75,Default,Garfiel,0,0,0,,No i jesteś!
Dialogue: 0,0:01:53.87,0:01:54.75,Default,Subaru,0,0,0,,Czekaj!
Dialogue: 0,0:02:00.28,0:02:01.16,Default,Garfiel,0,0,0,,Idź!
Dialogue: 0,0:02:19.87,0:02:20.99,Default,Envy,0,0,0,,Kocham cię.
Dialogue: 0,0:02:21.60,0:02:22.53,Default,Subaru,0,0,0,,Zamknij się...
Dialogue: 0,0:02:22.62,0:02:25.23,Default,Envy,0,0,0,,Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:25.32,0:02:26.29,Default,Subaru,0,0,0,,Zamknij się!
Dialogue: 0,0:02:26.38,0:02:28.78,Default,Envy,0,0,0,,Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:29.24,0:02:30.15,Default,Envy,0,0,0,,Subaru...
Dialogue: 0,0:02:31.24,0:02:34.17,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:30.15,0:02:33.11,Default,Subaru,0,0,0,,Nie waż się tak mnie nazywać!
Dialogue: 0,0:02:33.20,0:02:34.56,Default,Subaru,0,0,0,,Przestań!
Dialogue: 0,0:02:34.65,0:02:38.38,Default,Subaru,0,0,0,,Pierwsze szczere „kocham cię”\Nw tym świecie miało wielką moc,
Dialogue: 0,0:02:34.65,0:02:37.35,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:37.95,0:02:40.49,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:38.38,0:02:43.87,Default,Subaru,0,0,0,,Sprawiło, że pomyślałem, że taki\Nfrajer jak ja może się stać bohaterem!
Dialogue: 0,0:02:41.04,0:02:43.78,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:43.87,0:02:46.91,Default,Subaru,0,0,0,,Miejsca numer jeden i dwa w\Nmoim sercu są już zajęte!
Dialogue: 0,0:02:44.41,0:02:46.82,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:46.91,0:02:48.76,Default,Subaru,0,0,0,,Nie ma tu dla ciebie miejsca!
Dialogue: 0,0:02:48.85,0:02:51.73,Default,Envy,0,0,0,,{\an8}Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:02:49.60,0:02:51.64,Default,Subaru,0,0,0,,W porównaniu z tobą,
Dialogue: 0,0:02:51.73,0:02:55.13,Default,Subaru,0,0,0,,Łatwiej mi byłoby kochać Echidnę\Nczy jakąkolwiek z innych czarownic!
Dialogue: 0,0:03:03.18,0:03:07.46,Default,Envy,0,0,0,,Kocham cię. Kocham cię. Kocham cię.
Dialogue: 0,0:03:07.55,0:03:10.18,Default,Envy,0,0,0,,Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:10.74,0:03:11.80,Default,Envy,0,0,0,,Kochaj mnie.
Dialogue: 0,0:03:12.20,0:03:15.42,Default,Envy,0,0,0,,Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:15.51,0:03:18.65,Default,Envy,0,0,0,,Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:18.74,0:03:21.05,Default,Envy,0,0,0,,Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:21.14,0:03:23.46,Default,Subaru,0,0,0,,To nie jest śmierć.
Dialogue: 0,0:03:23.55,0:03:26.94,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:24.85,0:03:28.34,Default,Subaru,0,0,0,,Cień mnie otacza... pochłania...
Dialogue: 0,0:03:28.75,0:03:32.07,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:28.75,0:03:33.51,Default,Subaru,0,0,0,,To po prostu... będzie\Nmnie kochać... na zawsze?
Dialogue: 0,0:03:32.07,0:03:38.22,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.\NKochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:37.44,0:03:39.46,Default,Subaru,0,0,0,,Chusteczka Petry...
Dialogue: 0,0:03:38.22,0:03:41.57,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:41.82,0:03:45.27,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:45.36,0:03:51.62,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.\NKochaj mnie. Kochaj mnie.
Dialogue: 0,0:03:42.70,0:03:46.97,Default,Subaru,0,0,0,,Czy Echidna... wiedziała,\Nże tak się stanie?!
Dialogue: 0,0:03:51.62,0:03:56.00,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.\NKochaj mnie.
Dialogue: 0,0:03:54.44,0:03:57.08,Default,Subaru,0,0,0,,Ta cholerna czarownica!
Dialogue: 0,0:03:56.00,0:03:59.35,Default,Envy,0,0,0,,{\an8}Kochaj mnie. Kochaj mnie. Kochaj mnie.\NKochaj mnie.
Dialogue: 0,0:03:59.44,0:04:00.76,Default,Envy,0,0,0,,Kochaj mnie.
Dialogue: 0,0:04:36.44,0:04:39.36,Default,Subaru,0,0,0,,Przysięgam...
Dialogue: 0,0:04:40.57,0:04:43.80,Default,Subaru,0,0,0,,Ja... cię uratuję.
Dialogue: 0,0:04:56.22,0:04:58.58,Default,Subaru,0,0,0,,Wróciłem.
Dialogue: 0,0:05:00.30,0:05:01.32,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:05:05.80,0:05:06.77,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:05:12.62,0:05:14.67,Default,Subaru,0,0,0,,Dlaczego się trzęsę?
Dialogue: 0,0:05:15.83,0:05:17.50,Default,Subaru,0,0,0,,Nie mogę... być...
Dialogue: 0,0:05:24.71,0:05:26.55,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:05:29.93,0:05:31.14,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:05:32.56,0:05:33.89,Default,Emilia,0,0,0,,Gdzie...
Dialogue: 0,0:05:34.92,0:05:37.04,Default,Emilia,0,0,0,,Czekaj, ja tylko...
Dialogue: 0,0:05:39.16,0:05:40.23,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:05:42.32,0:05:43.34,Default,Emilia,0,0,0,,Dlaczego?
Dialogue: 0,0:05:44.94,0:05:47.74,Default,Emilia,0,0,0,,dlaczego wyglądasz, jakbyś tak bardzo\Ncierpiał?
Dialogue: 0,0:05:58.24,0:06:01.14,Default,Emilia,0,0,0,,W porządku, Subaru.
Dialogue: 0,0:06:01.60,0:06:03.27,Default,Emilia,0,0,0,,Jestem tutaj, widzisz?
Dialogue: 0,0:06:03.88,0:06:05.34,Default,Emilia,0,0,0,,Jestem tutaj.
Dialogue: 0,0:06:09.84,0:06:10.80,Default,Ram,0,0,0,,Więc...
Dialogue: 0,0:06:11.08,0:06:13.99,Default,Ram,0,0,0,,Miałeś pomóc Emilii,\Na tylko przysporzyłeś jej kłopotów.
Dialogue: 0,0:06:14.08,0:06:15.31,Default,Ram,0,0,0,,Dlaczego żyjesz?
Dialogue: 0,0:06:15.49,0:06:17.63,Default,Emilia,0,0,0,,Po tym, jak przyszedłeś, żeby mi pomóc,
Dialogue: 0,0:06:17.72,0:06:20.48,Default,Emilia,0,0,0,,szkoda, że tak się martwiłeś, że zacząłeś\Npłakać.
Dialogue: 0,0:06:20.57,0:06:23.54,Default,Subaru,0,0,0,,Emilia, znowu mnie rozpłaczysz.
Dialogue: 0,0:06:23.63,0:06:27.30,Default,Emilia,0,0,0,,Ale ty zawsze mi pomagasz.
Dialogue: 0,0:06:27.39,0:06:31.01,Default,Emilia,0,0,0,,Więc po części cieszę się, że pozwoliłeś\Nmi zobaczyć
Dialogue: 0,0:06:31.10,0:06:32.53,Default,Emilia,0,0,0,,tę twoją słabszą stronę.
Dialogue: 0,0:06:35.08,0:06:39.46,Default,Subaru,0,0,0,,Ale wolałbym, żebyś nie\Nwidziała tej strony mnie.
Dialogue: 0,0:06:39.72,0:06:41.35,Default,Emilia,0,0,0,,Dlaczego nie?
Dialogue: 0,0:06:41.85,0:06:46.01,Default,Subaru,0,0,0,,Bo chcę, żebyś widziała tylko tę część\Nmnie, która stara się dobrze wyglądać.
Dialogue: 0,0:06:46.10,0:06:51.26,Default,Subaru,0,0,0,,Chcę, żebyś zapomniała, że naprawdę jestem\Nsłabym, bezradnym frajerem.
Dialogue: 0,0:06:51.51,0:06:54.55,Default,Emilia,0,0,0,,Hej! Nie znienawidzę cię tylko dlatego, że
Dialogue: 0,0:06:54.64,0:06:57.06,Default,Emilia,0,0,0,,pokazałeś mi chwilę słabości!
Dialogue: 0,0:06:57.28,0:07:01.06,Default,Ram,0,0,0,,Ta duma nie brzmi przekonująco, kiedy\Ndopiero co wypłakałeś sobie oczy.
Dialogue: 0,0:07:01.26,0:07:03.98,Default,Subaru,0,0,0,,Musisz za każdym razem psuć mi nastrój?!
Dialogue: 0,0:07:04.07,0:07:08.10,Default,Otto,0,0,0,,Spokojnie. Ram w ten sposób pokazuje\Ntroskę.
Dialogue: 0,0:07:15.27,0:07:17.46,Default,Garfiel,0,0,0,,Przez chwilę nie\Nwiedziałem co się stanie,
Dialogue: 0,0:07:17.55,0:07:19.92,Default,Garfiel,0,0,0,,Ale cieszę się, że wróciłeś.
Dialogue: 0,0:07:20.01,0:07:22.35,Default,Garfiel,0,0,0,,Lekki wiatr nie strąci gafgalona z drzewa,
Dialogue: 0,0:07:22.44,0:07:24.48,Default,,0,0,0,,a to już coś!
Dialogue: 0,0:07:25.17,0:07:26.28,Default,Subaru,0,0,0,,Au!
Dialogue: 0,0:07:26.37,0:07:28.55,Default,Subaru,0,0,0,,Czekaj... to wszystko?
Dialogue: 0,0:07:29.67,0:07:30.76,Default,Garfiel,0,0,0,,Hę?
Dialogue: 0,0:07:31.89,0:07:34.97,Default - italics,Subaru,0,0,0,,Jeśli nic innego, to Garfiel\Nnie jest teraz wrogi.
Dialogue: 0,0:07:35.28,0:07:37.55,Default - italics,Subaru,0,0,0,,Próba nie złamała ducha Emilii.
Dialogue: 0,0:07:37.64,0:07:39.99,Default - italics,Subaru,0,0,0,,A Garfiel nadal utrzymuje\Nneutralne stanowisko.
Dialogue: 0,0:07:40.25,0:07:43.10,Default - italics,Subaru,0,0,0,,To najlepszy punkt wyjścia\Njaki miałem do tej pory.
Dialogue: 0,0:07:43.49,0:07:47.60,Default - italics,Subaru,0,0,0,,Teraz muszę tylko sprawdzić, co mogę\Nprzetestować i co mogę przynieść.
Dialogue: 0,0:07:47.69,0:07:49.03,Default - italics,Subaru,0,0,0,,Muszę wykorzystać to.
Dialogue: 0,0:07:52.17,0:07:54.10,Default,Subaru,0,0,0,,Ram, chcę z tobą o czymś porozmawiać.
Dialogue: 0,0:07:54.26,0:07:55.14,Default,Ram,0,0,0,,Zboczeniec.
Dialogue: 0,0:07:55.23,0:07:57.95,Default,Subaru,0,0,0,,Pochopnie mnie ocen{\i1}i{\i0}asz i oczerniasz!
Dialogue: 0,0:07:58.04,0:07:58.92,Default,Ram,0,0,0,,Hmh.
Dialogue: 0,0:07:59.01,0:08:01.82,Default,Subaru,0,0,0,,Po pierwsze, nigdy nie patrzyłem\Nna ciebie w ten sposób!
Dialogue: 0,0:08:01.96,0:08:04.51,Default,Ram,0,0,0,,To prawda. Zwykle patrzysz o wiele\Nbardziej mętnie.
Dialogue: 0,0:08:06.88,0:08:08.96,Default,Ram,0,0,0,,O co chcesz mnie prosić?
Dialogue: 0,0:08:10.08,0:08:11.79,Default,Subaru,0,0,0,,Chodzi o Garfiela.
Dialogue: 0,0:08:12.20,0:08:14.06,Default,Subaru,0,0,0,,Zaraz zrobię coś za jego plecami.
Dialogue: 0,0:08:14.15,0:08:17.08,Default,Subaru,0,0,0,,i jest duża szansa,\Nże spróbuje się wtrącić.
Dialogue: 0,0:08:17.17,0:08:20.06,Default,Subaru,0,0,0,,Chcę, żebyś go tu zatrzymała.
Dialogue: 0,0:08:21.05,0:08:23.30,Default,Ram,0,0,0,,Nie podoba mi się to spojrzenie, Barusu.
Dialogue: 0,0:08:23.39,0:08:25.04,Default,Subaru,0,0,0,,Przestań podejrzewać, dobrze?
Dialogue: 0,0:08:25.79,0:08:27.18,Default,Ram,0,0,0,,Dobrze.
Dialogue: 0,0:08:27.70,0:08:29.07,Default,Subaru,0,0,0,,Dziękuję, doceniam to.
Dialogue: 0,0:08:29.16,0:08:30.21,Default,Ram,0,0,0,,Cena: 10 przysług.
Dialogue: 0,0:08:30.30,0:08:31.61,Default,Subaru,0,0,0,,To dużo!
Dialogue: 0,0:08:36.24,0:08:39.94,Default - italics,Subaru,0,0,0,,Kiedy byłem w cieniu, połączyłem\Nsię z wieloma świadomościami.
Dialogue: 0,0:08:40.45,0:08:42.85,Default - italics,Subaru,0,0,0,,To były prawdopodobnie\Nwspomnienia jej ofiar.
Dialogue: 0,0:08:43.29,0:08:45.02,Default - italics,Subaru,0,0,0,,To wszystko rozproszone fragmenty.
Dialogue: 0,0:08:45.11,0:08:49.69,Default - italics,Subaru,0,0,0,,ale zdołałem wrócić z wiedzą wartą więcej\Nniż moje życie.
Dialogue: 0,0:08:49.78,0:08:52.21,Default - italics,Subaru,0,0,0,,Teraz pozostaje tylko\Nzweryfikować wspomnienia.
Dialogue: 0,0:08:55.00,0:08:56.18,Default,Subaru,0,0,0,,Znalazłem.
Dialogue: 0,0:09:46.28,0:09:49.86,Default,Subaru,0,0,0,,Czy to Ryuzu?
Dialogue: 0,0:09:51.94,0:09:56.57,Default,Ryuzu,0,0,0,,Nie sądziłam, że odkryjesz to już\Npół dnia po przybyciu, młody Su.
Dialogue: 0,0:09:58.52,0:10:00.46,Default,Subaru,0,0,0,,To było wspomnienie.
Dialogue: 0,0:10:00.55,0:10:02.91,Default,Subaru,0,0,0,,Pamięć ofiary Czarownicy Zazdrości,
Dialogue: 0,0:10:03.00,0:10:05.51,Default,Subaru,0,0,0,,kogoś, kto wiedział o tym miejscu.
Dialogue: 0,0:10:06.85,0:10:11.33,Default,Subaru,0,0,0,,Czy ta dziewczyna po lewej to ta,\Nktóra mnie tu zaprowadziła?
Dialogue: 0,0:10:12.17,0:10:14.38,Default,Ryuzu,0,0,0,,To mało prawdopodobne.
Dialogue: 0,0:10:14.47,0:10:18.18,Default,Ryuzu,0,0,0,,Ta dziewczyna jest jedną ze strażniczek\Nprzydzielonych do tego miejsca.
Dialogue: 0,0:10:18.27,0:10:21.26,Default,Ryuzu,0,0,0,,W lesie spotkała cię inna.
Dialogue: 0,0:10:21.35,0:10:23.96,Default,Ryuzu,0,0,0,,Jedno z oczu Sanktuarium, nic więcej.
Dialogue: 0,0:10:24.37,0:10:26.31,Default,Subaru,0,0,0,,Chciałbym cię o coś zapytać.
Dialogue: 0,0:10:26.58,0:10:30.06,Default,Subaru,0,0,0,,Po tym, chciałbym poprosić\No pomoc, jeśli to możliwe.
Dialogue: 0,0:10:30.49,0:10:32.86,Default,Ryuzu,0,0,0,,Nie zignoruję twojej prośby, młody Su,
Dialogue: 0,0:10:33.38,0:10:35.64,Default,Ryuzu,0,0,0,,Apostole Chciwości.
Dialogue: 0,0:10:36.39,0:10:37.32,Default,Ryuzu,0,0,0,,To jest...
Dialogue: 0,0:10:37.68,0:10:41.61,Default,Ryuzu,0,0,0,,to, co zapisano w umowie,\Nktóra wiąże nas,
Dialogue: 0,0:10:41.70,0:10:43.42,Default,Ryuzu,0,0,0,,kopie Ryuzu Meyer.
Dialogue: 0,0:10:48.59,0:10:50.80,Default,Subaru,0,0,0,,Wydaje się być do mnie\Nbardzo przywiązana...
Dialogue: 0,0:10:52.25,0:10:57.67,Default,Ryuzu,0,0,0,,Wiesz, kto jest odpowiedzialny za\Nstworzenie tego miejsca, prawda?
Dialogue: 0,0:10:57.86,0:11:01.53,Default,Subaru,0,0,0,,To była chyba Echidna,\NCzarownica Chciwości, prawda?
Dialogue: 0,0:11:02.05,0:11:05.43,Default,Ryuzu,0,0,0,,Tak, to jest ziemia zbudowana\Nprzez rękę wspomnianej czarownicy,
Dialogue: 0,0:11:05.73,0:11:09.82,Default,Ryuzu,0,0,0,,To obiekt eksperymentalny, który\Nmiał spełnić marzenia czarownicy.
Dialogue: 0,0:11:10.27,0:11:12.44,Default,Subaru,0,0,0,,Na czym eksperymentowała?
Dialogue: 0,0:11:12.83,0:11:15.44,Default,Ryuzu,0,0,0,,Nie widzisz tego przed sobą?
Dialogue: 0,0:11:16.65,0:11:21.91,Default,Ryuzu,0,0,0,,Czy w magicznym krysztale nie była\Nuwięziona dziewczyna podobna do mnie?
Dialogue: 0,0:11:22.18,0:11:25.78,Default,Ryuzu,0,0,0,,To była prawdziwa, pierwsza Ryuzu Meyer.
Dialogue: 0,0:11:26.30,0:11:31.04,Default,Ryuzu,0,0,0,,Wszystkie pozostałe Ryuzu, w tym ja, są\Njej kopiami.
Dialogue: 0,0:11:31.72,0:11:33.12,Default,Ryuzu,0,0,0,,Jesteśmy tylko imitacjami.
Dialogue: 0,0:11:35.64,0:11:39.21,Default,Ryuzu,0,0,0,,Czy fakt, że jestem kopią,\Nzmienia twoje zdanie o mnie?
Dialogue: 0,0:11:41.52,0:11:43.28,Default,Subaru,0,0,0,,Nie wiem.
Dialogue: 0,0:11:43.37,0:11:46.43,Default,Subaru,0,0,0,,Chciałbym powiedzieć, że nie.
Dialogue: 0,0:11:46.52,0:11:47.40,Default,Subaru,0,0,0,,Chciałbym, ale...
Dialogue: 0,0:11:50.47,0:11:52.64,Default,Ryuzu,0,0,0,,Jaki jesteś dobry, młody Su.
Dialogue: 0,0:11:53.80,0:11:56.02,Default,Ryuzu,0,0,0,,Nasze ciała replik zbudowane są na
Dialogue: 0,0:11:56.11,0:12:00.20,Default,Ryuzu,0,0,0,,rdzeniach sztucznego „od”, wytwarzanych za\Npomocą magii.
Dialogue: 0,0:12:00.29,0:12:03.43,Default,Ryuzu,0,0,0,,Te jądra są owinięte w manę\Ni przyjmują formę fizyczną.
Dialogue: 0,0:12:03.52,0:12:05.34,Default,Ryuzu,0,0,0,,w wyniku czego powstają te ciała.
Dialogue: 0,0:12:05.43,0:12:09.73,Default,Subaru,0,0,0,,Czekaj, mówisz o dosłownym\Ntworzeniu życia!
Dialogue: 0,0:12:10.88,0:12:13.58,Default,Subaru,0,0,0,,Po co ona robiła\Ntaki eksperyment?
Dialogue: 0,0:12:14.16,0:12:17.04,Default,Ryuzu,0,0,0,,By dodać coś do tych ciał.
Dialogue: 0,0:12:17.76,0:12:21.37,Default,Ryuzu,0,0,0,,Konkretnie: osobowości, wspomnienia i\Nwiedzę...
Dialogue: 0,0:12:21.46,0:12:23.18,Default,Ryuzu,0,0,0,,Innymi słowy, duszę.
Dialogue: 0,0:12:23.77,0:12:28.35,Default,Ryuzu,0,0,0,,Wypełniła ciało Ryuzu Meyer własną istotą,
Dialogue: 0,0:12:28.84,0:12:30.83,Default,Ryuzu,0,0,0,,a za każdym razem, gdy ciało ginęło,
Dialogue: 0,0:12:30.92,0:12:35.21,Default,Ryuzu,0,0,0,,tworzyła nowe naczynie, które miało\Nodziedziczyć jej duszę,
Dialogue: 0,0:12:35.30,0:12:36.65,Default,Ryuzu,0,0,0,,co uczyniłoby ją...
Dialogue: 0,0:12:37.40,0:12:39.86,Default,Subaru,0,0,0,,w zasadzie nieśmiertelną.
Dialogue: 0,0:12:41.51,0:12:43.49,Default,Subaru,0,0,0,,Więc to wszystko!
Dialogue: 0,0:12:43.58,0:12:46.57,Default,Subaru,0,0,0,,Dlatego zachowywała\Nsię tak znajomo!
Dialogue: 0,0:12:47.78,0:12:51.10,Default - italics,Subaru,0,0,0,,Powrót przez Śmierć czyni mnie\Nw zasadzie nieśmiertelnym.
Dialogue: 0,0:12:51.57,0:12:54.38,Default - italics,Subaru,0,0,0,,Czy była szczęśliwa,\Nże znalazła pokrewną duszę?
Dialogue: 0,0:12:55.28,0:12:58.17,Default,Subaru,0,0,0,,Czy eksperyment Echidny był sukcesem?
Dialogue: 0,0:12:58.82,0:13:02.41,Default,Ryuzu,0,0,0,,Nie, dusza Echidny nie była dziedziczona.
Dialogue: 0,0:13:03.12,0:13:07.14,Default,Ryuzu,0,0,0,,Plany czarownicy spełniły się\Ntylko w niedoskonałej formie.
Dialogue: 0,0:13:07.35,0:13:08.98,Default,Subaru,0,0,0,,Nieperfekcyjna forma?
Dialogue: 0,0:13:09.56,0:13:11.89,Default,Ryuzu,0,0,0,,Ryuzu Meyer była niewystarczającym\Nnaczyniem,
Dialogue: 0,0:13:11.98,0:13:15.16,Default,Ryuzu,0,0,0,,by stać się naczyniem\Ndla Czarownicy Chciwości.
Dialogue: 0,0:13:15.25,0:13:18.86,Default,Subaru,0,0,0,,I nie mogła się tego\Ndomyślić zanim spróbowała?
Dialogue: 0,0:13:20.12,0:13:22.83,Default,Ryuzu,0,0,0,,Po śmierci czarownicy,\Nten obiekt pozostaje.
Dialogue: 0,0:13:22.92,0:13:26.02,Default,Ryuzu,0,0,0,,i nadal produkowane są\Nkolejne egzemplarze.
Dialogue: 0,0:13:26.61,0:13:28.66,Default,Ryuzu,0,0,0,,Ponieważ nasze ciała są zbudowane z many,
Dialogue: 0,0:13:28.80,0:13:33.66,Default,Ryuzu,0,0,0,,Ratuje nas to, że do przetrwania\Nnie potrzebujemy żadnych zasobów.
Dialogue: 0,0:13:34.89,0:13:37.27,Default,Subaru,0,0,0,,Wygląda na to, że pijesz herbatę.
Dialogue: 0,0:13:37.36,0:13:39.25,Default,Ryuzu,0,0,0,,To tylko moje hobby.
Dialogue: 0,0:13:40.00,0:13:44.13,Default,Ryuzu,0,0,0,,To indywidualna dziwaczność, którą\Nzdobyłam w ciągu mojego długiego życia.
Dialogue: 0,0:13:45.82,0:13:49.67,Default,Ryuzu,0,0,0,,Byłam jedną z pierwszych czterech kopii.
Dialogue: 0,0:13:49.76,0:13:52.17,Default,Ryuzu,0,0,0,,400 lat temu.
Dialogue: 0,0:13:52.26,0:13:56.38,Default,Ryuzu,0,0,0,,Dostałam mądrość i\Nosobowość do zarządzania
Dialogue: 0,0:13:56.47,0:13:58.77,Default,Ryuzu,0,0,0,,rosnącą liczbą kopii oraz Sanktuarium.
Dialogue: 0,0:13:59.15,0:14:00.78,Default,Subaru,0,0,0,,Tak cię stworzono?
Dialogue: 0,0:14:01.16,0:14:03.23,Default,Ryuzu,0,0,0,,Na początku cierpiałam.
Dialogue: 0,0:14:03.55,0:14:06.37,Default,Ryuzu,0,0,0,,Nie miałam wspomnień,\Ntylko pracę do wykonania.
Dialogue: 0,0:14:06.85,0:14:10.09,Default,Ryuzu,0,0,0,,Nie wiem, ile lat minęło, zanim
Dialogue: 0,0:14:10.18,0:14:13.95,Default,Ryuzu,0,0,0,,naprawdę poczułam, że żyję...
Dialogue: 0,0:14:15.80,0:14:18.04,Default,Ryuzu,0,0,0,,Nie bądź taki smutny.
Dialogue: 0,0:14:18.77,0:14:24.00,Default,Ryuzu,0,0,0,,W swój sposób znalazłam sens\Nw spełnianiu swojego celu.
Dialogue: 0,0:14:24.55,0:14:28.59,Default,Ryuzu,0,0,0,,Dobrze, a co miałaś na myśli, mówiąc\Nwcześniej „Apostoł Chciwości”?
Dialogue: 0,0:14:28.98,0:14:35.35,Default,Ryuzu,0,0,0,,Krótko mówiąc, to ktoś, kto może\Nwydawać rozkazy nam, kopiom Ryuzu Meyer.
Dialogue: 0,0:14:35.93,0:14:41.43,Default,Ryuzu,0,0,0,,Czy czarownica nie ofiarowała ci na\Ncmentarzu symbolu swojego apostoła?
Dialogue: 0,0:14:41.52,0:14:43.34,Default,Subaru,0,0,0,,Jaki symbol?
Dialogue: 0,0:14:43.43,0:14:47.94,Default,Ryuzu,0,0,0,,Część ciała, jak\Nwłos lub paznokieć.
Dialogue: 0,0:14:49.40,0:14:50.86,Default,Subaru,0,0,0,,Czekaj, herbata Chidna?!
Dialogue: 0,0:14:51.25,0:14:52.20,Default,Ryuzu,0,0,0,,Herbata Chidna?
Dialogue: 0,0:14:52.29,0:14:56.50,Default,Subaru,0,0,0,,Dwa razy podstępem kazała mi pić\Nswoje płyny ustrojowe jako herbatę.
Dialogue: 0,0:14:56.59,0:14:59.21,Default,Ryuzu,0,0,0,,Więc połknąłeś część czarownicy.
Dialogue: 0,0:14:59.43,0:15:02.59,Default,Ryuzu,0,0,0,,Żarty na bok, to pewnie to.
Dialogue: 0,0:15:02.68,0:15:06.46,Default,Subaru,0,0,0,,Co ona mi kazała pić?
Dialogue: 0,0:15:09.49,0:15:10.71,Default,Subaru,0,0,0,,Poczekaj.
Dialogue: 0,0:15:10.80,0:15:14.34,Default,Subaru,0,0,0,,Jeśli prawo do dowodzenia kopiami\Nczyni kogoś jej apostołem...
Dialogue: 0,0:15:14.43,0:15:17.47,Default,Subaru,0,0,0,,Czy Garfiel też wszedł na cmentarz\Ni podjął się Próby?
Dialogue: 0,0:15:25.84,0:15:27.32,Default,Subaru,0,0,0,,Ryuzu...
Dialogue: 0,0:15:27.63,0:15:32.04,Default,Subaru,0,0,0,,Nie mów Garfielowi, że jestem Apostołem\NChciwości,
Dialogue: 0,0:15:32.51,0:15:34.53,Default,Subaru,0,0,0,,lub że byliśmy w kontakcie.
Dialogue: 0,0:15:34.97,0:15:37.86,Default,Ryuzu,0,0,0,,Młody Gar miałby coś do\Npowiedzenia, gdyby wiedział.
Dialogue: 0,0:15:37.95,0:15:40.50,Default,Ryuzu,0,0,0,,że jego krewna spotyka\Nsię z jego kochankiem.
Dialogue: 0,0:15:40.72,0:15:44.43,Default,Subaru,0,0,0,,To było okropnie podłe, a do tego\Nuczyniłoby mnie strasznym grzesznikiem!
Dialogue: 0,0:15:44.94,0:15:47.17,Default,Subaru,0,0,0,,Ale tak, to chyba wszystko w porządku.
Dialogue: 0,0:15:47.26,0:15:49.82,Default,Subaru,0,0,0,,W przyszłości będę\Npotrzebował twojej pomocy.
Dialogue: 0,0:15:49.91,0:15:51.13,Default,Subaru,0,0,0,,Mogę na ciebie liczyć.
Dialogue: 0,0:15:51.56,0:15:54.67,Default,Ryuzu,0,0,0,,Nie mogę ci się przeciwstawić.
Dialogue: 0,0:15:54.76,0:15:56.88,Default,Ryuzu,0,0,0,,Chcesz straszaka na Garfa lub maskotki—
Dialogue: 0,0:15:56.97,0:16:01.57,Default,Subaru,0,0,0,,Możesz przestać robić ze mnie\Nwiecznie sfrustrowanego faceta?!
Dialogue: 0,0:16:01.82,0:16:04.45,Default,Subaru,0,0,0,,Musisz kontynuować\Ndobrą pracę jako oko.
Dialogue: 0,0:16:11.85,0:16:13.53,Default,Subaru,0,0,0,,Dziękuję, Ryuzu.
Dialogue: 0,0:16:14.26,0:16:19.72,Default,Subaru,0,0,0,,Mówiłaś, że pierwotne nazwisko to Meyer, a\Ntwoje brzmi Bilma, prawda?
Dialogue: 0,0:16:19.81,0:16:20.76,Default,Subaru,0,0,0,,Skąd to się wzięło?
Dialogue: 0,0:16:23.00,0:16:26.50,Default,Ryuzu,0,0,0,,Nosić imię „Ryuzu” to obowiązek, który\Nzostał we mnie zaszczepiony.
Dialogue: 0,0:16:26.92,0:16:31.13,Default,Ryuzu,0,0,0,,Dlatego musimy wyrażać naszą\Nindywidualność w inny sposób.
Dialogue: 0,0:16:31.73,0:16:35.25,Default,Ryuzu,0,0,0,,takie jak hobby,\Npreferencje... i nazwiska.
Dialogue: 0,0:16:36.12,0:16:37.66,Default,Ryuzu,0,0,0,,Młody Su...
Dialogue: 0,0:16:39.51,0:16:44.07,Default,Ryuzu,0,0,0,,Jeśli nie masz nic przeciwko, mógłbyś\Nzadać mi to samo pytanie jeszcze raz...
Dialogue: 0,0:16:44.57,0:16:47.08,Default,Ryuzu,0,0,0,,po jutrzejszym dniu?
Dialogue: 0,0:16:53.01,0:16:56.87,Default,Subaru,0,0,0,,Muszę jakoś zabrać wszystkich\Nbezpiecznie do wioski.
Dialogue: 0,0:17:01.02,0:17:03.42,Default - italics,Subaru,0,0,0,,Nie chcę przez to przechodzić ponownie.
Dialogue: 0,0:17:04.19,0:17:06.89,Default,Emilia,0,0,0,,Subaru, co ty tu robisz?
Dialogue: 0,0:17:06.98,0:17:12.02,Default,Emilia,0,0,0,,Hej... Nieźle mnie zaskakuje,\Nkiedy tak potwornie się boisz.
Dialogue: 0,0:17:12.11,0:17:15.66,Default,Subaru,0,0,0,,Kto tak mówi w\Ndzisiejszych czasach?
Dialogue: 0,0:17:15.75,0:17:17.65,Default,Emilia,0,0,0,,Chyba martwiłam się na marne.
Dialogue: 0,0:17:17.74,0:17:20.64,Default,Subaru,0,0,0,,Nie robiłem nic, o co warto się martwić.
Dialogue: 0,0:17:20.73,0:17:22.47,Default,Subaru,0,0,0,,Wszystko w porządku.
Dialogue: 0,0:17:31.93,0:17:35.66,Default,Subaru,0,0,0,,Wyglądasz prawie jak wróżka, Emilia.
Dialogue: 0,0:17:35.75,0:17:39.51,Default,Emilia,0,0,0,,Nie powinieneś mówić\Ntakich rzeczy o kimś!
Dialogue: 0,0:17:39.60,0:17:41.07,Default,Emilia,0,0,0,,Nawet ja mogę się złościć.
Dialogue: 0,0:17:41.16,0:17:42.58,Default,Subaru,0,0,0,,To miał być komplement!
Dialogue: 0,0:17:42.88,0:17:45.74,Default,Emilia,0,0,0,,Wróżki są rodzajem złych duchów, prawda?
Dialogue: 0,0:17:45.83,0:17:47.64,Default,Emilia,0,0,0,,Nie oszukasz mnie,\Nże to komplement!
Dialogue: 0,0:17:47.73,0:17:50.84,Default,Subaru,0,0,0,,Kolejny tekst na podryw udaremniony przez\Nróżnicę kulturową!
Dialogue: 0,0:17:51.32,0:17:55.85,Default,Subaru,0,0,0,,Co ty tu robisz tak późno w nocy?
Dialogue: 0,0:17:55.94,0:17:59.34,Default,Subaru,0,0,0,,Gdyby tu był Puck, powiedziałby\Nci, że to złe dla skóry.
Dialogue: 0,0:17:59.43,0:18:03.69,Default,Emilia,0,0,0,,Chyba... nie mam na to usprawiedliwienia.
Dialogue: 0,0:18:03.78,0:18:06.25,Default,Emilia,0,0,0,,Nie mogłam spać od tamtej pory.
Dialogue: 0,0:18:06.34,0:18:08.85,Default,Emilia,0,0,0,,Więc poszłam na spacer,\Nżeby poczuć nocny wiatr.
Dialogue: 0,0:18:09.44,0:18:12.22,Default,Subaru,0,0,0,,Bo martwisz się Próbą?
Dialogue: 0,0:18:12.31,0:18:13.66,Default,Emilia,0,0,0,,Nie chodzi o to.
Dialogue: 0,0:18:14.41,0:18:16.96,Default,Emilia,0,0,0,,Nie... może tak.
Dialogue: 0,0:18:17.49,0:18:20.96,Default,Emilia,0,0,0,,Ale nie jestem całkowicie\Npewna, co to jest.
Dialogue: 0,0:18:21.05,0:18:24.54,Default,Emilia,0,0,0,,Spacerowałam w nadziei,\Nże to zrozumiem... chyba.
Dialogue: 0,0:18:26.17,0:18:27.83,Default,Emilia,0,0,0,,Naprawdę chciałabym...
Dialogue: 0,0:18:28.59,0:18:30.54,Default,Emilia,0,0,0,,żeby Puck tu był.
Dialogue: 0,0:18:34.09,0:18:37.62,Default,Subaru,0,0,0,,Chyba dokądkolwiek pójdę, zawsze będę\Ntylko zastępcą.
Dialogue: 0,0:18:38.18,0:18:39.06,Default,Emilia,0,0,0,,Hę?
Dialogue: 0,0:18:41.37,0:18:43.38,Default,Subaru,0,0,0,,Jesteś niesamowita, Emilio.
Dialogue: 0,0:18:43.47,0:18:46.27,Default,Subaru,0,0,0,,Nikt by cię nie winił\Nza to, że chcesz uciec.
Dialogue: 0,0:18:46.36,0:18:49.73,Default,Subaru,0,0,0,,Ale stawiasz temu czoło\Ni nie wycofujesz się.
Dialogue: 0,0:18:50.02,0:18:53.39,Default,Emilia,0,0,0,,Co tak nagle się stało?
Dialogue: 0,0:18:53.48,0:18:55.12,Default,Subaru,0,0,0,,To nie nagłe.
Dialogue: 0,0:18:55.56,0:18:59.74,Default,Subaru,0,0,0,,Zawsze tak myślałem, ale nie\Npotrafiłem powiedzieć do teraz.
Dialogue: 0,0:19:00.21,0:19:01.45,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:19:02.00,0:19:05.55,Default,Subaru,0,0,0,,Nie wiem, jak bardzo mogę ci pomóc.
Dialogue: 0,0:19:05.64,0:19:08.11,Default,Subaru,0,0,0,,Ale powiem to, co czuję na głos.
Dialogue: 0,0:19:08.20,0:19:10.11,Default,Subaru,0,0,0,,Wszystko będzie dobrze, Emilio.
Dialogue: 0,0:19:10.20,0:19:11.46,Default,Subaru,0,0,0,,Wiem, że się uda.
Dialogue: 0,0:19:12.90,0:19:15.17,Default,Subaru,0,0,0,,Jestem po twojej stronie.
Dialogue: 0,0:19:17.35,0:19:19.36,Default,Emilia,0,0,0,,Tak, dziękuję.
Dialogue: 0,0:19:19.98,0:19:23.74,Default,Emilia,0,0,0,,Naprawdę dodałeś mi wiele odwagi.
Dialogue: 0,0:19:31.19,0:19:33.31,Default,Otto,0,0,0,,Natsuki, wróciłeś?
Dialogue: 0,0:19:33.52,0:19:36.06,Default,Otto,0,0,0,,Tak długo cię nie było,\Nże się o ciebie martwiłem.
Dialogue: 0,0:19:36.15,0:19:38.78,Default,Otto,0,0,0,,Myślałem, że zgubiłeś się w lesie.
Dialogue: 0,0:19:39.24,0:19:41.63,Default,Subaru,0,0,0,,Co ty jesteś, nadopiekuńcza matka?
Dialogue: 0,0:19:41.72,0:19:44.28,Default,Otto,0,0,0,,Przynajmniej pozwól mi być ojcem.
Dialogue: 0,0:19:45.26,0:19:48.79,Default,Otto,0,0,0,,Natsuki, wiem, że ostatnio\Nwiele przeszedłeś,
Dialogue: 0,0:19:48.88,0:19:51.04,Default,Otto,0,0,0,,Zawsze możesz ze mną\Nporozmawiać.
Dialogue: 0,0:19:51.13,0:19:53.31,Default,Subaru,0,0,0,,Gada przez sen dziwne rzeczy. Ohyda.
Dialogue: 0,0:19:53.40,0:19:56.71,Default,Otto,0,0,0,,Tak mówisz do kogoś,\Nkto się o ciebie martwił?!
Dialogue: 0,0:20:00.48,0:20:02.31,Default,Subaru,0,0,0,,Tylko bądź cicho i śpij.
Dialogue: 0,0:20:02.40,0:20:06.77,Default,Subaru,0,0,0,,Jeśli twoje wybuchy wzburzą mieszkańców,\Nwszyscy będziemy mieli kłopoty.
Dialogue: 0,0:20:06.86,0:20:09.58,Default,Otto,0,0,0,,Nie chciałem żartować.
Dialogue: 0,0:20:09.67,0:20:12.03,Default,Subaru,0,0,0,,Wiem, wiem.
Dialogue: 0,0:20:14.40,0:20:16.39,Default,Subaru,0,0,0,,Właśnie dlatego nie mogę ci powiedzieć.
Dialogue: 0,0:20:18.20,0:20:19.77,Default - italics,Subaru,0,0,0,,Idę sam.
Dialogue: 0,0:20:23.08,0:20:24.24,Default - italics,Subaru,0,0,0,,Emilia,
Dialogue: 0,0:20:24.33,0:20:27.79,Default - italics,Subaru,0,0,0,,Wracam do rezydencji Roswaala, żeby się\Nczymś zająć.
Dialogue: 0,0:20:27.88,0:20:32.04,Default - italics,Subaru,0,0,0,,Nie mogę powiedzieć o tym Ram, Roswaalowi\Nani mieszkańcom wioski.
Dialogue: 0,0:20:32.86,0:20:35.06,Default - italics,Subaru,0,0,0,,Więc nie musisz się o nic martwić.
Dialogue: 0,0:20:35.15,0:20:37.08,Default - italics,Subaru,0,0,0,,Wrócę, jak tylko skończę.
Dialogue: 0,0:20:38.94,0:20:41.34,Default,Subaru,0,0,0,,W tym świecie mam wszystko powtarzać,
Dialogue: 0,0:20:41.80,0:20:44.03,Default,Subaru,0,0,0,,Więc to nie ma sensu.
Dialogue: 0,0:20:45.95,0:20:47.78,Default,Subaru,0,0,0,,Chodźmy, Patrasche.
Dialogue: 0,0:20:52.49,0:20:54.40,Default - italics,Subaru,0,0,0,,Nawet jeśli ten świat zniknie,
Dialogue: 0,0:20:54.49,0:20:56.85,Default - italics,Subaru,0,0,0,,nawet jeśli w końcu go zostawię,
Dialogue: 0,0:20:57.28,0:20:59.63,Default - italics,Subaru,0,0,0,,Nie chcę, żeby Emilia wyglądała smutnie.
Dialogue: 0,0:21:00.57,0:21:02.97,Default - italics,Subaru,0,0,0,,Moim celem jest zwyciężyć w rezydencji\NRoswaala.
Dialogue: 0,0:21:03.40,0:21:05.98,Default - italics,Subaru,0,0,0,,Muszę się dowiedzieć,\Nco się tam dzieje.
Dialogue: 0,0:21:06.39,0:21:09.27,Default - italics,Subaru,0,0,0,,Jeśli tego nie wiem, nie\Nmogę sobie z tym poradzić.
Dialogue: 0,0:21:09.36,0:21:12.58,Default - italics,Subaru,0,0,0,,Ale jeśli się dowiem, mogę\Nnawet poprosić Echidnę o pomoc.
Dialogue: 0,0:21:13.13,0:21:15.23,Default,Subaru,0,0,0,,Przeprowadzę tyle prób, ile będzie trzeba.
Dialogue: 0,0:21:15.32,0:21:18.13,Default,Subaru,0,0,0,,Tylko ja mogę to zrobić.
Dialogue: 0,0:21:21.45,0:21:24.30,Default,Garfiel,0,0,0,,Ha! Tyle energii z samego rana.
Dialogue: 0,0:21:25.04,0:21:28.19,Default,Garfiel,0,0,0,,Masz cholernie odważnego smoka lądowego.
Dialogue: 0,0:21:29.22,0:21:32.03,Default,Subaru,0,0,0,,Wydaje się, że między nami\Ndoszło do nieporozumienia.
Dialogue: 0,0:21:32.12,0:21:34.73,Default,Garfiel,0,0,0,,Nieporozumienie? Jak diabli!
Dialogue: 0,0:21:35.12,0:21:40.11,Default,Garfiel,0,0,0,,Ty i twój odór czarownicy\Nzamierzacie zrobić coś złego, prawda?
Dialogue: 0,0:21:40.64,0:21:42.48,Default,Subaru,0,0,0,,Nie zaprzeczę, że źle pachnę.
Dialogue: 0,0:21:42.57,0:21:44.47,Default,Subaru,0,0,0,,Ale dlaczego teraz o tym mówisz?
Dialogue: 0,0:21:45.68,0:21:48.09,Default,Subaru,0,0,0,,Wczoraj nic o tym nie mówiłeś.
Dialogue: 0,0:21:49.53,0:21:52.33,Default,Subaru,0,0,0,,Wygląda na to, że to było\Nniewygodne pytanie dla ciebie.
Dialogue: 0,0:21:52.42,0:21:54.92,Default,Subaru,0,0,0,,Masz to na twarzy, Garfiel.
Dialogue: 0,0:21:56.21,0:21:57.60,Default,Garfiel,0,0,0,,Przestań.
Dialogue: 0,0:21:57.69,0:22:01.09,Default,Garfiel,0,0,0,,Nie denerwuj mnie\Njeszcze bardziej.
Dialogue: 0,0:22:03.70,0:22:05.80,Default,Garfiel,0,0,0,,Nawet o tym nie myśl, smoku lądowy!
Dialogue: 0,0:22:05.89,0:22:08.90,Default,Garfiel,0,0,0,,Jeden ruch, a twój ukochany pan zostanie\Nzmiażdżony!
Dialogue: 0,0:22:13.01,0:22:14.79,Default,Garfiel,0,0,0,,Co ty się uśmiechasz?!
Dialogue: 0,0:22:15.50,0:22:18.81,Default,Subaru,0,0,0,,Jesteś taki łatwy do odczytania.
Dialogue: 0,0:22:18.90,0:22:19.78,Default,Garfiel,0,0,0,,Co?!
Dialogue: 0,0:22:20.12,0:22:24.86,Default,Subaru,0,0,0,,Teraz wiem, co wywołuje twoją reakcję
Dialogue: 0,0:22:25.49,0:22:27.68,Default,Subaru,0,0,0,,i co cię złości.
Dialogue: 0,0:22:36.77,0:22:39.37,Default,Garfiel,0,0,0,,Ty draniu! Testowałeś mnie?!
Dialogue: 0,0:22:40.16,0:22:41.64,Default,Garfiel,0,0,0,,Jesteś szalony!
Dialogue: 0,0:22:41.73,0:22:44.97,Default,Garfiel,0,0,0,,Po co, do diabła, tak ryzykujesz życiem?!
Dialogue: 0,0:22:45.06,0:22:50.30,Default,Subaru,0,0,0,,Gdyby wystarczyło moje życie,\Nbyłaby to dobra cena za taki wynik.
Dialogue: 0,0:22:51.86,0:22:54.59,Default,Subaru,0,0,0,,Bądź wyrozumiały i odpuść mi, dobrze?
Dialogue: 0,0:22:54.68,0:22:56.79,Default,Garfiel,0,0,0,,Jeśli cię teraz puszczę,
Dialogue: 0,0:22:56.88,0:22:59.48,Default,Garfiel,0,0,0,,Możesz zagwarantować, że nie\Nzrobisz nam nic złego?
Dialogue: 0,0:22:59.82,0:23:02.01,Default,Subaru,0,0,0,,Nie zdradzę Emilii.
Dialogue: 0,0:23:02.10,0:23:04.51,Default,Subaru,0,0,0,,i nie zrobię nic złego Sanktuarium.
Dialogue: 0,0:23:04.60,0:23:05.65,Default,Subaru,0,0,0,,Uwierz mi.
Dialogue: 0,0:23:07.66,0:23:11.57,Default,Subaru,0,0,0,,Garfiel, wiem, że coś ukrywasz.
Dialogue: 0,0:23:11.66,0:23:13.62,Default,Subaru,0,0,0,,Ale ja się dowiem, co to jest.
Dialogue: 0,0:23:13.95,0:23:14.87,Default,Subaru,0,0,0,,Przysięgam.
Dialogue: 0,0:23:15.10,0:23:15.98,Default,Garfiel,0,0,0,,Zamknij się!
Dialogue: 0,0:23:16.07,0:23:19.49,Default,Subaru,0,0,0,,Dopóki się nie poddam, nie ma tajemnic.
Dialogue: 0,0:23:19.58,0:23:21.65,Default,Subaru,0,0,0,,Marnujesz czas próbując mnie powstrzymać.
Dialogue: 0,0:23:21.74,0:23:24.91,Default,Garfiel,0,0,0,,Co chcesz zrobić z tym miejscem?! Z nami?!
Dialogue: 0,0:23:25.00,0:23:28.78,Default,Subaru,0,0,0,,Mówiłem ci, że mam zamiar pomóc Emilii.
Dialogue: 0,0:23:28.87,0:23:31.60,Default,Subaru,0,0,0,,Nie mam zamiaru szkodzić Sanktuarium.
Dialogue: 0,0:23:31.69,0:23:35.03,Default,Subaru,0,0,0,,Mogę przysporzyć wam cierpienia, ale chcę\Nwam wszystkim pomóc.
Dialogue: 0,0:23:35.12,0:23:37.12,Default,Garfiel,0,0,0,,Za kogo się uważasz?!
Dialogue: 0,0:23:37.21,0:23:40.53,Default,Garfiel,0,0,0,,Nie wiesz nic o tym miejscu,\Nstaruszce ani o nikim!
Dialogue: 0,0:23:40.62,0:23:42.55,Default,Subaru,0,0,0,,To czego nie wiem, to się nauczę.
Dialogue: 0,0:23:42.64,0:23:45.15,Default,Subaru,0,0,0,,Uważam, że to powód, dla którego to robię.
Dialogue: 0,0:23:45.37,0:23:48.03,Default,Garfiel,0,0,0,,Co osiągniesz tym zarozumiałym gadaniem?!
Dialogue: 0,0:23:48.30,0:23:51.38,Default,Garfiel,0,0,0,,Nie masz pojęcia, czym\Njest ból i cierpienie!
Dialogue: 0,0:23:51.47,0:23:53.53,Default,Garfiel,0,0,0,,Przestań gadać, jakbyś wiedział!
Dialogue: 0,0:23:53.93,0:23:54.95,Default,Subaru,0,0,0,,Wiem.
Dialogue: 0,0:23:57.49,0:23:59.54,Default,Subaru,0,0,0,,Znam piekło.
Dialogue: 0,0:24:02.76,0:24:05.62,Default,Subaru,0,0,0,,Widziałem to wiele razy.
Dialogue: 0,0:24:18.87,0:24:22.06,Default,Subaru,0,0,0,,Tylko ja muszę znać piekło.
Dialogue: 0,0:24:25.44,0:24:28.18,Default,Subaru,0,0,0,,Po to tu jestem.
Dialogue: 0,0:24:28.27,0:24:31.28,Episode Title,Title,0,0,0,,{\t(1,5000,\fs40)}Znam {\c&H409BF4&}pie{\c&HFFFFFF&}k{\c&H6D6D6D&}ło
Dialogue: 0,0:24:34.26,0:24:37.95,Default,Frederica,0,0,0,,Powinniśmy opuścić rezydencję\Ni schronić się w wiosce?
Dialogue: 0,0:24:38.66,0:24:40.31,Default,Frederica,0,0,0,,Tego nam życzysz?
Dialogue: 0,0:24:40.40,0:24:41.84,Default,Subaru,0,0,0,,Tak, jeśli chcesz.
Dialogue: 0,0:24:41.93,0:24:44.91,Default,Subaru,0,0,0,,Wybaczcie, że was obciążam,\Nale wiem, że dacie radę.
Dialogue: 0,0:24:45.00,0:24:47.63,Default,Frederica,0,0,0,,Ależ z ciebie uwodziciel.
Dialogue: 0,0:24:47.72,0:24:51.90,Default,Frederica,0,0,0,,Z pewnością wiesz jak zdobyć\Nserce pokojówki, Subaru.
Dialogue: 0,0:24:51.99,0:24:54.59,Default,Petra,0,0,0,,Ja też się z nią zgadzam!
Dialogue: 0,0:24:54.86,0:24:56.56,Default,Subaru,0,0,0,,Dzięki za amulet ochronny.
Dialogue: 0,0:24:56.65,0:25:00.93,Default,Subaru,0,0,0,,To naprawdę pomogło, choć może\Nnie w sposób, w jaki chciałaś.
Dialogue: 0,0:25:01.14,0:25:04.26,Default,Petra,0,0,0,,Naprawdę byłam ci przydatna?
Dialogue: 0,0:25:04.35,0:25:06.43,Default,Subaru,0,0,0,,Tak. Uratowałaś mi życie...
Dialogue: 0,0:25:06.52,0:25:08.53,Default,Subaru,0,0,0,,To nie jest całkowicie dokładne.
Dialogue: 0,0:25:08.62,0:25:09.82,Default,Subaru,0,0,0,,Bardzo mi to pomogło.
Dialogue: 0,0:25:10.08,0:25:11.36,Default,Petra,0,0,0,,Tak się cieszę!
Dialogue: 0,0:25:11.45,0:25:13.99,Default,Petra,0,0,0,,W takim razie możesz mi podziękować\Nrandką!
Dialogue: 0,0:25:14.31,0:25:15.23,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:25:15.32,0:25:18.19,Default,Subaru,0,0,0,,To zaszczyt być twoim\Npierwszym partnerem na randce.
Dialogue: 0,0:25:18.28,0:25:19.53,Default,Subaru,0,0,0,,Dobrze się przygotuję.
Dialogue: 0,0:25:19.62,0:25:21.13,Default,Petra,0,0,0,,To jest obietnica!
Dialogue: 0,0:25:21.72,0:25:24.42,Default,Petra,0,0,0,,Idę się przygotować!
Dialogue: 0,0:25:26.75,0:25:29.71,Default - italics,Subaru,0,0,0,,Zróbmy więcej takich obietnic.
Dialogue: 0,0:25:30.68,0:25:32.60,Default,Frederica,0,0,0,,Jest bardzo dobrą dziewczyną.
Dialogue: 0,0:25:33.76,0:25:34.64,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:25:36.23,0:25:41.32,Default,Subaru,0,0,0,,Zaopiekuj się Rem, Petrą, Patrasche... i\Nsobą.
Dialogue: 0,0:25:41.41,0:25:44.27,Default,Subaru,0,0,0,,Przyjdę jak tylko będę mógł.
Dialogue: 0,0:25:44.66,0:25:50.03,Default,Frederica,0,0,0,,Będę wyczekiwać chwili,\Ngdy dołączysz do nas z Beatrice-sama.
Dialogue: 0,0:25:56.80,0:25:58.86,Default,Beatrice,0,0,0,,W końcu tu jesteś.
Dialogue: 0,0:25:59.50,0:26:03.70,Default,Subaru,0,0,0,,Jestem tu z innego powodu niż ostatnio.
Dialogue: 0,0:26:04.27,0:26:06.21,Default,Beatrice,0,0,0,,Rób co chcesz.
Dialogue: 0,0:26:06.64,0:26:09.33,Default,Beatrice,0,0,0,,To wszystko jest dość ironiczne.
Dialogue: 0,0:26:10.71,0:26:13.50,Default,Beatrice,0,0,0,,Koniec kontraktu, który\Ntrwał bardzo długo...
Dialogue: 0,0:26:13.92,0:26:16.27,Default,Beatrice,0,0,0,,Przez zakończenie końca końca,
Dialogue: 0,0:26:16.36,0:26:19.05,Default,Beatrice,0,0,0,,Tym razem naprawdę zostanę uwolniona.
Dialogue: 0,0:26:19.65,0:26:20.85,Default,Beatrice,0,0,0,,Oczywiście.
Dialogue: 0,0:26:22.48,0:26:25.17,Default,Beatrice,0,0,0,,To, że musi to nastąpić z tobą,
Dialogue: 0,0:26:25.26,0:26:28.59,Default,Beatrice,0,0,0,,To chyba zbyt ironiczne\Nzakończenie dla mnie.
