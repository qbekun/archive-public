Dialogue: 0,0:00:02.46,0:00:04.12,Default,Garfiel,0,0,0,,"Zamiast"?!
Dialogue: 0,0:00:04.21,0:00:05.09,Default,Otto,0,0,0,,Tak.
Dialogue: 0,0:00:05.20,0:00:06.52,Default,Garfiel,0,0,0,,Gdzie jest starucha?
Dialogue: 0,0:00:06.62,0:00:08.52,Default,Otto,0,0,0,,Nie mogłem przewidzieć, co się stanie,
Dialogue: 0,0:00:08.61,0:00:10.16,Default,,0,0,0,,więc wysłałem ją gdzie indziej.
Dialogue: 0,0:00:10.29,0:00:13.44,Default,Garfiel,0,0,0,,A ty co jeszcze tu robisz?
Dialogue: 0,0:00:13.53,0:00:16.16,Default,Garfiel,0,0,0,,Chcesz „porozmawiać”, ale nie ma tu tej\Nosoby!
Dialogue: 0,0:00:16.39,0:00:17.59,Default,Otto,0,0,0,,Tak, to prawda.
Dialogue: 0,0:00:17.68,0:00:23.29,Default,Otto,0,0,0,,Więc uznajmy, że kupuję czas, by pewien\Nchłopak i dziewczyna mogli pobyć sami.
Dialogue: 0,0:00:24.49,0:00:26.00,Default,Garfiel,0,0,0,,Och, naprawdę?!
Dialogue: 0,0:00:29.25,0:00:32.38,Default,Garfiel,0,0,0,,Nie dasz rady, płotko.
Dialogue: 0,0:00:37.54,0:00:38.42,Default,Otto,0,0,0,,Kamień—
Dialogue: 0,0:00:43.62,0:00:44.92,Default,,0,0,0,,Cholera...
Dialogue: 0,0:00:46.16,0:00:48.46,Default,Otto,0,0,0,,Tego szukasz?
Dialogue: 0,0:00:49.60,0:00:54.16,Default,Otto,0,0,0,,Kupiec zawsze jest krok do przodu, by\Nocenić swoje szanse powodzenia,
Dialogue: 0,0:00:54.58,0:00:55.82,Default,Otto,0,0,0,,a ja jestem kupcem.
Dialogue: 0,0:00:56.12,0:00:57.49,Default,Garfiel,0,0,0,,Ty...
Dialogue: 0,0:00:59.52,0:01:03.03,Default,Otto,0,0,0,,Nigdy nie miałem wielu\Nludzkich przyjaciół.
Dialogue: 0,0:01:03.12,0:01:06.12,Default,Otto,0,0,0,,Ale zaprzyjaźniłem się za to z wieloma\Nnieludźmi.
Dialogue: 0,0:01:07.09,0:01:09.32,Default,Otto,0,0,0,,Cały las jest teraz przeciwko tobie.
Dialogue: 0,0:01:09.74,0:01:12.81,Default,Otto,0,0,0,,Najpierw naciesz się powitaniem od owadów\Nzodda!
Dialogue: 0,0:01:15.69,0:01:17.81,Default,Garfiel,0,0,0,,Cholera... Cholera!
Dialogue: 0,0:01:17.90,0:01:20.01,Default,Garfiel,0,0,0,,Cholera!
Dialogue: 0,0:01:31.80,0:01:34.02,Default - italics,Otto,0,0,0,,Kiedy byłem małym chłopcem,
Dialogue: 0,0:01:34.11,0:01:36.28,Default - italics,Otto,0,0,0,,Świat był piekielną kolebką.
Dialogue: 0,0:01:39.53,0:01:42.73,Default - italics,Otto,0,0,0,,Dokądkolwiek poszedłem, słyszałem\Nniekończące się głosy,
Dialogue: 0,0:01:42.82,0:01:45.75,Default - italics,Otto,0,0,0,,Ale nie wiedziałem, co mówią.
Dialogue: 0,0:01:46.72,0:01:51.44,Default - italics,Otto,0,0,0,,W tym wieku nie wiedziałem, że to\Nbłogosławieństwo, z którym się urodziłem:
Dialogue: 0,0:01:51.53,0:01:54.22,Default - italics,Otto,0,0,0,,Boska Ochrona „Duszy Języka”.
Dialogue: 0,0:01:55.22,0:01:56.61,Default - flashback,Bro,0,0,0,,Czekaj!
Dialogue: 0,0:02:00.27,0:02:02.14,Default - flashback,Mom,0,0,0,,Otto, co robisz?
Dialogue: 0,0:02:04.85,0:02:06.45,Default - flashback,Mom,0,0,0,,Nie zamierzasz się z nimi bawić?
Dialogue: 0,0:02:08.53,0:02:12.94,Default - italics,Otto,0,0,0,,Moi rodzice ze wszystkich sił próbowali\Nzrozumieć moją osobliwość,
Dialogue: 0,0:02:13.50,0:02:18.20,Default - italics,Otto,0,0,0,,ale ktoś bez Boskiej Ochrony nigdy tego\Nnie zrozumie.
Dialogue: 0,0:02:35.14,0:02:37.08,Default - flashback,Bro,0,0,0,,Otto, spróbuj to napisać.
Dialogue: 0,0:02:43.86,0:02:46.64,Default - italics,Otto,0,0,0,,To był mój brat, starszy ode mnie o siedem\Nlat,
Dialogue: 0,0:02:46.73,0:02:50.27,Default - italics,Otto,0,0,0,,który wpadł na to, że pismo może przynieść\Nzrozumienie,
Dialogue: 0,0:02:50.36,0:02:52.17,Default - italics,Otto,0,0,0,,gdy mowa nie wystarczała.
Dialogue: 0,0:03:16.09,0:03:17.42,Default - flashback,Mom,0,0,0,,Otto...
Dialogue: 0,0:03:29.62,0:03:33.82,Default - italics,Otto,0,0,0,,To mógł być pierwszy raz od urodzenia, gdy\Nwybuchnąłem płaczem.
Dialogue: 0,0:03:38.29,0:03:40.77,Default - italics,Otto,0,0,0,,A kiedy skończyłem dziesięć lat...
Dialogue: 0,0:03:54.10,0:03:57.38,Default - flashback,Bug,0,0,0,,Duże... światło... poszło... tędy...
Dialogue: 0,0:03:57.70,0:04:02.17,Default - italics,Otto,0,0,0,,Te bezsensowne głosy zaczęły zmieniać się\Nw dźwięki mające znaczenie.
Dialogue: 0,0:04:02.96,0:04:04.64,Default - flashback,Bro,0,0,0,,Rozumiesz, co mówią zwierzęta?
Dialogue: 0,0:04:04.99,0:04:05.87,Default - flashback,Otto,0,0,0,,Tak.
Dialogue: 0,0:04:08.13,0:04:10.81,Default - flashback,Bug,0,0,0,,Wkrótce będzie padać.
Dialogue: 0,0:04:11.12,0:04:12.92,Default - flashback,Otto,0,0,0,,Mówią, że niedługo będzie padać.
Dialogue: 0,0:04:13.01,0:04:13.89,Default - flashback,Bro,0,0,0,,Hę?
Dialogue: 0,0:04:22.29,0:04:24.91,Default - flashback,Bro,0,0,0,,Otto, to niesamowita moc.
Dialogue: 0,0:04:25.00,0:04:26.48,Default - flashback,Bro,0,0,0,,A że jest tak niezwykła,
Dialogue: 0,0:04:26.57,0:04:30.23,Default - flashback,,0,0,0,,nie powinieneś rozmawiać z owadami zodda\Nprzy ludziach.
Dialogue: 0,0:04:30.32,0:04:31.20,Default - flashback,Otto,0,0,0,,Dlaczego nie?
Dialogue: 0,0:04:31.29,0:04:34.01,Default - flashback,Bro,0,0,0,,Boskie Ochrony to\Nbłogosławieństwa tego świata,
Dialogue: 0,0:04:34.10,0:04:36.60,Default - flashback,Bro,0,0,0,,ale niektórzy próbowaliby je wykorzystać.
Dialogue: 0,0:04:36.90,0:04:38.92,Default - flashback,Bro,0,0,0,,Musisz ukrywać swoją moc.
Dialogue: 0,0:04:40.41,0:04:44.59,Default - flashback,Otto,0,0,0,,Dlatego nie mogę już z tobą rozmawiać\Nprzy innych ludziach, Fulfew.
Dialogue: 0,0:04:45.02,0:04:47.28,Default - flashback,Fulfew,0,0,0,,Rozumiem, Młody Mistrzu.
Dialogue: 0,0:04:47.93,0:04:48.98,Default - flashback,Kid,0,0,0,,Kłamca!
Dialogue: 0,0:04:49.07,0:04:50.70,Default - flashback,Kid,0,0,0,,Kłamca! Kłamca!
Dialogue: 0,0:04:50.79,0:04:51.67,Default - flashback,Kid,0,0,0,,Kłamiesz!
Dialogue: 0,0:04:51.76,0:04:52.70,Default - flashback,Kid,0,0,0,,Wiemy, że łżesz!
Dialogue: 0,0:04:52.79,0:04:53.67,Default - flashback,Kid,0,0,0,,Kłamiesz!
Dialogue: 0,0:04:53.76,0:04:55.18,Default - flashback,Bro,0,0,0,,Nie kłamię!
Dialogue: 0,0:04:55.27,0:04:58.51,Default - flashback,Bro,0,0,0,,Mój starszy brat Otto potrafi rozmawiać ze\Nzwierzętami!
Dialogue: 0,0:04:59.55,0:05:01.44,Default - flashback,Bro,0,0,0,,Prawda, Otto?!
Dialogue: 0,0:05:20.68,0:05:21.56,Default - flashback,Kid,0,0,0,,To prawda!
Dialogue: 0,0:05:21.65,0:05:22.53,Default - flashback,Kid,0,0,0,,Owady zodda!
Dialogue: 0,0:05:26.34,0:05:28.93,Default - flashback,Guy,0,0,0,,O nie, robaki Zodda!
Dialogue: 0,0:05:33.75,0:05:35.23,Default - flashback,Kid,0,0,0,,Ty dziwaku od owadów zodda!
Dialogue: 0,0:05:38.16,0:05:41.18,Default - italics,Otto,0,0,0,,Potem zapieczętowałem swoją Boską Ochronę
Dialogue: 0,0:05:41.27,0:05:43.71,Default - italics,Otto,0,0,0,,i przysiągłem nigdy więcej jej nie używać.
Dialogue: 0,0:05:46.41,0:05:48.53,Default - italics,Otto,0,0,0,,A kiedy miałem piętnaście lat...
Dialogue: 0,0:05:50.30,0:05:54.07,Default - flashback,Guy,0,0,0,,Ty sukinsynu! Wiem, że byłeś z moją\Ndziewczyną!
Dialogue: 0,0:05:54.16,0:05:56.51,Default - flashback,Otto,0,0,0,,C-Czekaj—
Dialogue: 0,0:05:55.45,0:05:57.92,Default - flashback,Guy,0,0,0,,{\an8}Zamknij się, ty dziwaku od owadów zodda!
Dialogue: 0,0:05:58.13,0:06:01.17,Default - flashback,Otto,0,0,0,,Dziwak... od owadów zodda?
Dialogue: 0,0:06:02.90,0:06:05.26,Default - flashback,Otto,0,0,0,,Dowiem się prawdy!
Dialogue: 0,0:06:06.18,0:06:07.06,Default - flashback,Dog,0,0,0,,Widziałem.
Dialogue: 0,0:06:33.46,0:06:34.74,Default - flashback,Otto,0,0,0,,Wiem prawdę!
Dialogue: 0,0:06:34.83,0:06:37.83,Default - flashback,Otto,0,0,0,,Jesteś ósmym facetem, z którym była!
Dialogue: 0,0:06:38.96,0:06:39.84,Default - flashback,Girl,0,0,0,,Ty kretynie!
Dialogue: 0,0:06:41.08,0:06:43.09,Default - flashback,Girl,0,0,0,,Niech ktoś go zabije!
Dialogue: 0,0:06:47.28,0:06:50.46,Default - italics,Otto,0,0,0,,Naraziłem się córce najpotężniejszego\Nczłowieka w mieście,
Dialogue: 0,0:06:50.55,0:06:52.67,Default - italics,Otto,0,0,0,,i wygnano mnie.
Dialogue: 0,0:06:58.54,0:07:02.67,Default - italics,Otto,0,0,0,,Potem niespodziewanie usamodzielniłem się\Njako kupiec
Dialogue: 0,0:07:02.76,0:07:04.52,Default - italics,Otto,0,0,0,,i harowałem jak wół.
Dialogue: 0,0:07:08.66,0:07:13.41,Default - italics,Otto,0,0,0,,Postanowiłem, że pewnego dnia\Nbędę prowadził własny sklep.
Dialogue: 0,0:07:18.40,0:07:19.99,Default - italics,Otto,0,0,0,,Dasz radę, Otto!
Dialogue: 0,0:07:20.77,0:07:22.70,Default - italics,Otto,0,0,0,,Dalej, Otto! Dalej!
Dialogue: 0,0:07:29.69,0:07:31.68,Default - flashback,Petel,0,0,0,,No proszę, no proszę...
Dialogue: 0,0:07:31.77,0:07:34.47,Default - flashback,Petel,0,0,0,,Dokąd tak...
Dialogue: 0,0:07:34.88,0:07:35.97,Default - flashback,Petel,0,0,0,,pędzisz?!
Dialogue: 0,0:08:12.63,0:08:14.71,Default - flashback,Ricardo,0,0,0,,Masz szczęście.
Dialogue: 0,0:08:14.80,0:08:17.51,Default - flashback,Ricardo,0,0,0,,Zginąłbyś, gdybym cię nie znalazł.
Dialogue: 0,0:08:17.89,0:08:20.89,Default - flashback,Ricardo,0,0,0,,Lepiej podziękuj młodemu szefowi.
Dialogue: 0,0:08:20.98,0:08:23.32,Default - flashback,Otto,0,0,0,,M-Młodemu... szefowi?
Dialogue: 0,0:08:23.41,0:08:24.77,Default - flashback,Ricardo,0,0,0,,Tak, to nasz szef.
Dialogue: 0,0:08:24.98,0:08:28.05,Default - flashback,Ricardo,0,0,0,,I to on uratował ci życie.
Dialogue: 0,0:08:28.14,0:08:31.52,Default - flashback,Otto,0,0,0,,R-Rozumiem... Bardzo dziękuję.
Dialogue: 0,0:08:31.99,0:08:33.59,Default - flashback,Otto,0,0,0,,I powinienem mu też podziękować.
Dialogue: 0,0:08:34.82,0:08:37.12,Default - flashback,Ricardo,0,0,0,,Jeśli zamierzasz płakać, najpierw się\Nschowaj.
Dialogue: 0,0:08:38.17,0:08:41.12,Default - flashback,Ricardo,0,0,0,,Żaden mężczyzna nie powinien szlochać przy\Ninnych.
Dialogue: 0,0:08:41.21,0:08:43.52,Default - flashback,Otto,0,0,0,,Hę? P-Płakać?
Dialogue: 0,0:08:49.01,0:08:49.89,Default - flashback,Otto,0,0,0,,Cholera...
Dialogue: 0,0:08:51.62,0:08:52.87,Default - flashback,Otto,0,0,0,,Co to jest?
Dialogue: 0,0:08:53.92,0:08:56.57,Default - flashback,Otto,0,0,0,,To... T-To...
Dialogue: 0,0:08:59.85,0:09:04.50,Default - flashback,Otto,0,0,0,,J-Jak dobrze, że nie umarłem...
Dialogue: 0,0:09:05.20,0:09:10.11,Default - italics,Otto,0,0,0,,Zrozumiałem, że każdy mój płacz oznacza\Nodrodzenie w życiu.
Dialogue: 0,0:09:10.47,0:09:13.44,Default - italics,Otto,0,0,0,,Pierwszy płacz — niemowlęcia, które\Notrzymało życie...
Dialogue: 0,0:09:14.32,0:09:15.65,Default - italics,Otto,0,0,0,,Drugi — gdy poznałem
Dialogue: 0,0:09:16.12,0:09:19.58,Default - italics,Otto,0,0,0,,miłość rodziny i zrozumiałem, gdzie należy\Nmoje serce...
Dialogue: 0,0:09:20.03,0:09:23.15,Default - italics,Otto,0,0,0,,A dziś trzeci, gdy otarłem się o śmierć
Dialogue: 0,0:09:23.24,0:09:27.24,Default - italics,Otto,0,0,0,,i zrozumiałem swój cel oraz powód, dla\Nktórego żyję.
Dialogue: 0,0:09:29.17,0:09:33.58,Default,Otto,0,0,0,,Tak naprawdę nie proszono mnie, żebym\Nwłaśnie tak kupił czas...
Dialogue: 0,0:09:33.67,0:09:36.19,Default,Otto,0,0,0,,Ale to wszystko, by pomóc\Nmojemu przyjacielowi!
Dialogue: 0,0:09:42.72,0:09:44.51,Default,Bird,0,0,0,,...nadchodzi! Nadchodzi!
Dialogue: 0,0:09:44.60,0:09:45.83,Default,Bird,0,0,0,,Nadchodzi ktoś zły!
Dialogue: 0,0:09:45.92,0:09:47.06,Default,Otto,0,0,0,,Wiem o tym!
Dialogue: 0,0:09:47.34,0:09:49.43,Default,Bug,0,0,0,,Tuż za tobą. Już tu jest.
Dialogue: 0,0:09:49.52,0:09:51.36,Default,Otto,0,0,0,,Powiedziałem, że {\i1}wiem{\i0}!
Dialogue: 0,0:09:51.45,0:09:53.89,Default,Otto,0,0,0,,Zaplanowałem to! To część kalkulacji!
Dialogue: 0,0:09:53.98,0:09:56.24,Default,Hamster,0,0,0,,Umrzesz. Biedactwo.
Dialogue: 0,0:09:56.45,0:10:00.22,Default,Otto,0,0,0,,Możesz przestać być taki pesymistyczny?!
Dialogue: 0,0:10:08.02,0:10:11.06,Default,Otto,0,0,0,,Tak się dzieje, gdy ciągle jej używam?
Dialogue: 0,0:10:11.15,0:10:14.42,Default,Otto,0,0,0,,Moja Boska Ochrona to straszne utrapienie.
Dialogue: 0,0:10:15.25,0:10:20.14,Default,Otto,0,0,0,,Ciekawe, czy Natsuki ma okazję\Nporozmawiać z Emilią.
Dialogue: 0,0:10:44.14,0:10:46.04,Default,Garfiel,0,0,0,,Znalazłem cię!
Dialogue: 0,0:10:57.39,0:10:58.70,Default,Garfiel,0,0,0,,Do diabła z tobą!
Dialogue: 0,0:10:59.51,0:11:02.59,Default,Otto,0,0,0,,Dla odmiany powierzono mi naprawdę\Nekscytującą rolę!
Dialogue: 0,0:11:02.68,0:11:05.18,Default,Otto,0,0,0,,Nie pozwolę ci złapać mnie tak łatwo!
Dialogue: 0,0:11:33.22,0:11:35.45,Default,Otto,0,0,0,,Daj mi spokój...
Dialogue: 0,0:11:35.54,0:11:37.21,Default,Garfiel,0,0,0,,Nie sądzę!
Dialogue: 0,0:11:42.39,0:11:45.39,Default,Garfiel,0,0,0,,Nie pozwolę ci znowu robić swoich bzdur!
Dialogue: 0,0:11:45.77,0:11:48.21,Default,Otto,0,0,0,,J-Ja nie byłbym taki pewien...
Dialogue: 0,0:11:48.57,0:11:50.57,Default,Otto,0,0,0,,Ta walka jeszcze się nie skończyła—
Dialogue: 0,0:11:51.33,0:11:54.08,Default,Garfiel,0,0,0,,Mówiłem, że nie pozwolę ci znów odwalić\Nżadnego numeru!
Dialogue: 0,0:11:54.53,0:11:56.63,Default,Garfiel,0,0,0,,Szczerze mówiąc, zaskoczyłeś mnie.
Dialogue: 0,0:11:56.72,0:11:59.98,Default,Garfiel,0,0,0,,Naprawdę nie sądziłem, że cię na to stać.
Dialogue: 0,0:12:01.51,0:12:05.79,Default,Garfiel,0,0,0,,Musisz mi wybaczyć, że robię coś tak\Npodłego mężczyźnie.
Dialogue: 0,0:12:08.41,0:12:11.46,Default,Otto,0,0,0,,Chyba zrobiłem wszystko, co mogłem.
Dialogue: 0,0:12:11.66,0:12:13.76,Default,Garfiel,0,0,0,,Natychmiast oddaj mi kamień!
Dialogue: 0,0:12:13.85,0:12:15.29,Default,Garfiel,0,0,0,,Dość już, do cholery!
Dialogue: 0,0:12:19.88,0:12:22.83,Default,Garfiel,0,0,0,,No dobra. Kiedy się obudzisz, wszystko\Nbędzie—
Dialogue: 0,0:12:22.92,0:12:26.68,Default,Otto,0,0,0,,Powiedzmy, że moja osobista walka kończy\Nsię tutaj.
Dialogue: 0,0:12:28.58,0:12:29.46,Default,Garfiel,0,0,0,,Ram!
Dialogue: 0,0:12:29.55,0:12:30.43,Default,Ram,0,0,0,,El Fula!
Dialogue: 0,0:12:30.84,0:12:32.40,Default,Garfiel,0,0,0,,Zdziro!
Dialogue: 0,0:12:36.48,0:12:40.00,Default,Ram,0,0,0,,Niby o tym wiedziałam, ale jesteś tak\Nżałosny, że nie mogłam patrzeć.
Dialogue: 0,0:12:40.09,0:12:44.36,Default,Otto,0,0,0,,Czy to nie trochę surowe wobec kogoś, kto\Nwalcząc, dał z siebie wszystko?
Dialogue: 0,0:12:44.57,0:12:47.12,Default,Ram,0,0,0,,Wszystko? W takim stanie?
Dialogue: 0,0:12:47.21,0:12:51.05,Default,Otto,0,0,0,,Nie widziałem pokojówki będącej\Nwiększym przeciwieństwem ukojenia!
Dialogue: 0,0:12:51.14,0:12:53.32,Default,Garfiel,0,0,0,,Ram, przejście na ich stronę nie znaczy,
Dialogue: 0,0:12:53.41,0:12:57.13,Default,Garfiel,0,0,0,,że sprzeciwiasz się temu, czego chce ten\Ndrań Roswaal?
Dialogue: 0,0:12:57.53,0:13:00.63,Default,Ram,0,0,0,,Oddałabym duszę, by spełnić\Nnajwiększe pragnienie mojego pana.
Dialogue: 0,0:13:00.96,0:13:01.84,Default,Ram,0,0,0,,Ale...
Dialogue: 0,0:13:02.02,0:13:03.80,Default,Ram,0,0,0,,na swój własny sposób.
Dialogue: 0,0:13:04.04,0:13:05.74,Default,Garfiel,0,0,0,,Przestań!
Dialogue: 0,0:13:05.83,0:13:09.76,Default,Garfiel,0,0,0,,Co twoim zdaniem dzieje się, kiedy mnie tu\Nzatrzymujesz?!
Dialogue: 0,0:13:09.85,0:13:13.13,Default,Garfiel,0,0,0,,Naprawdę myślisz, że warto mu zaufać?
Dialogue: 0,0:13:13.22,0:13:15.17,Default,Otto,0,0,0,,Czy Natsuki jest tego wart?
Dialogue: 0,0:13:15.55,0:13:18.39,Default,Otto,0,0,0,,Jeśli chodzi o to, czy jest coś wart,
Dialogue: 0,0:13:18.48,0:13:19.87,Default,Otto,0,0,0,,Chyba nie.
Dialogue: 0,0:13:19.96,0:13:20.84,Default,Garfiel,0,0,0,,Co?!
Dialogue: 0,0:13:20.93,0:13:23.73,Default,Otto,0,0,0,,Ale nie mogę się doczekać, jakie kwiaty z\Nniego wyrosną,
Dialogue: 0,0:13:23.84,0:13:26.14,Default,Otto,0,0,0,,więc wciąż go przycinam i strząsam\Nrobaki...
Dialogue: 0,0:13:27.76,0:13:29.91,Default,Otto,0,0,0,,Chyba w takim nastroju jestem.
Dialogue: 0,0:13:30.16,0:13:35.90,Default,Ram,0,0,0,,Szczerze nie wiem, czemu wiążesz\Nz Barusu tak wielkie nadzieje.
Dialogue: 0,0:13:36.82,0:13:41.29,Default,Ram,0,0,0,,Jest słaby i tak niekompetentny,\Nże nie umie nawet zrobić herbaty.
Dialogue: 0,0:13:41.38,0:13:45.13,Default,Otto,0,0,0,,To trochę za daleko... albo może nie.
Dialogue: 0,0:13:45.44,0:13:48.60,Default,Ram,0,0,0,,Ale... kiedy chodzi o życie lub śmierć,
Dialogue: 0,0:13:48.69,0:13:50.49,Default,Ram,0,0,0,,ma przedziwnie dobre wyczucie czasu.
Dialogue: 0,0:13:52.20,0:13:53.95,Default,Ram,0,0,0,,Facet mający tylko wyczucie chwili.
Dialogue: 0,0:13:54.04,0:13:55.23,Default,,0,0,0,,To jest Barusu.
Dialogue: 0,0:13:56.08,0:13:59.89,Default,Ram,0,0,0,,Jeśli dostrzega okazję i ją wykorzystuje,
Dialogue: 0,0:14:00.54,0:14:02.82,Default,Ram,0,0,0,,Wiesz, że to jedyna droga do zwycięstwa.
Dialogue: 0,0:14:03.07,0:14:06.67,Default,Otto,0,0,0,,Ostatecznie chyba ty też ufasz\NNatsukiemu, Ram.
Dialogue: 0,0:14:06.76,0:14:07.70,Default,Ram,0,0,0,,Mów „Ram”.
Dialogue: 0,0:14:07.79,0:14:10.39,Default,Otto,0,0,0,,To taki wrogi sposób na\Nukrycie swojej nieśmiałości!
Dialogue: 0,0:14:11.62,0:14:13.49,Default,Garfiel,0,0,0,,Wystarczy!
Dialogue: 0,0:14:25.50,0:14:26.54,Default,Ram,0,0,0,,Odsuń się.
Dialogue: 0,0:14:26.96,0:14:27.97,Default,Otto,0,0,0,,Czekaj... Ram!
Dialogue: 0,0:14:38.00,0:14:41.39,Default,Ram,0,0,0,,Czy kiedykolwiek mnie pokonałeś w walce?
Dialogue: 0,0:14:47.33,0:14:48.90,Default,Otto,0,0,0,,Nie... wierzę...
Dialogue: 0,0:15:01.84,0:15:04.13,Default,Ram,0,0,0,,Stałeś się silniejszy, Garf.
Dialogue: 0,0:15:24.08,0:15:25.90,Default,Ram,0,0,0,,Al Fula!
Dialogue: 0,0:15:32.13,0:15:35.95,Default,Subaru,0,0,0,,Liczę na ciebie, Otto. Tylko nie rób nic\Nszalonego.
Dialogue: 0,0:15:37.84,0:15:38.72,Default,Subaru,0,0,0,,Teraz...
Dialogue: 0,0:15:39.86,0:15:41.96,Default,Subaru,0,0,0,,Zrobię co do mnie należy.
Dialogue: 0,0:15:46.61,0:15:49.32,Default,Subaru,0,0,0,,Och, dobrze. Wreszcie cię znalazłem.
Dialogue: 0,0:15:53.93,0:15:56.93,Episode Title,Title,0,0,0,,{\pos(320,60)\t(1,3000,\fs40)\c&H9B9F92&}O{\c&HFFFFFF&}tto Suwen
Dialogue: 0,0:16:00.72,0:16:03.94,Default,Subaru,0,0,0,,Naprawdę to przemyślałaś, prawda,\NEmilia-tan?
Dialogue: 0,0:16:04.19,0:16:07.34,Default,Subaru,0,0,0,,Wiedziałaś, że nikt cię nie znajdzie,\Njeśli się tu ukryjesz.
Dialogue: 0,0:16:08.27,0:16:12.92,Default,Emilia,0,0,0,,Dlaczego... tu jesteś, Subaru? Przecież\Nciebie nie...
Dialogue: 0,0:16:13.01,0:16:16.06,Default,Subaru,0,0,0,,...odrzuca tak mocno jak Roswaala?
Dialogue: 0,0:16:16.72,0:16:21.45,Default,Subaru,0,0,0,,To znaczy jestem tutaj, ale z trudem to\Nznoszę.
Dialogue: 0,0:16:21.83,0:16:23.67,Default,Emilia,0,0,0,,R-Rozumiem...
Dialogue: 0,0:16:23.76,0:16:28.78,Default,Subaru,0,0,0,,Połowa mnie wierzyła, że tu będziesz,\Na połowa tylko tego pragnęła.
Dialogue: 0,0:16:29.84,0:16:31.56,Default,Emilia,0,0,0,,Połowa... i połowa...
Dialogue: 0,0:16:31.65,0:16:33.66,Default,Subaru,0,0,0,,Tak mi ulżyło, że cię znalazłem.
Dialogue: 0,0:16:34.54,0:16:36.40,Default,Emilia,0,0,0,,Tylko... ulżyło?
Dialogue: 0,0:16:37.27,0:16:39.24,Default,Emilia,0,0,0,,Nie jesteś zły?
Dialogue: 0,0:16:39.33,0:16:41.32,Default,Subaru,0,0,0,,O co chodzi, Emilia-tan?
Dialogue: 0,0:16:41.41,0:16:44.38,Default,Subaru,0,0,0,,Naprawdę bałaś się, że będę na ciebie zły?
Dialogue: 0,0:16:44.47,0:16:46.13,Default,Subaru,0,0,0,,Nie jestem zły.
Dialogue: 0,0:16:46.22,0:16:49.85,Default,Subaru,0,0,0,,Choć spanikowałem, nie byłem\Nnawet pewien, czy żyję.
Dialogue: 0,0:16:49.94,0:16:52.64,Default,Emilia,0,0,0,,Rozumiem. Nie jesteś zły.
Dialogue: 0,0:16:52.99,0:16:53.87,Default,Subaru,0,0,0,,Emilia?
Dialogue: 0,0:16:56.05,0:16:59.55,Default,Emilia,0,0,0,,Nie jesteś na mnie zły, Subaru.
Dialogue: 0,0:17:01.12,0:17:03.02,Default,Emilia,0,0,0,,Nawet się nie rozgniewasz.
Dialogue: 0,0:17:04.42,0:17:07.66,Default,Emilia,0,0,0,,Dlaczego się nie gniewasz?
Dialogue: 0,0:17:08.24,0:17:11.19,Default,Emilia,0,0,0,,To, co zrobiłam, było samolubne, prawda?
Dialogue: 0,0:17:11.28,0:17:13.01,Default,Emilia,0,0,0,,Sprawiło ci to kłopot, prawda?
Dialogue: 0,0:17:13.37,0:17:16.40,Default,Emilia,0,0,0,,Zmartwiłam cię, odchodząc bez słowa.
Dialogue: 0,0:17:17.22,0:17:21.00,Default,Emilia,0,0,0,,Nie gniewasz się, bo od początku n-niczego\Nsię nie spodziewałeś?
Dialogue: 0,0:17:21.09,0:17:24.79,Default,Emilia,0,0,0,,Jesteś dla mnie dobry nawet wtedy, gdy coś\Nzepsuję,
Dialogue: 0,0:17:24.88,0:17:26.97,Default,Emilia,0,0,0,,bo nie jesteś mną rozczarowany, prawda?
Dialogue: 0,0:17:27.06,0:17:30.69,Default,Emilia,0,0,0,,Bo wiesz, że to nigdy\Nnie pójdzie dobrze?
Dialogue: 0,0:17:30.93,0:17:33.78,Default,Subaru,0,0,0,,Nie, Emilio, nie tak myślę!
Dialogue: 0,0:17:33.87,0:17:35.07,Default,Emilia,0,0,0,,Więc...
Dialogue: 0,0:17:35.90,0:17:37.45,Default,Emilia,0,0,0,,Więc dlaczego?
Dialogue: 0,0:17:38.42,0:17:41.30,Default,Emilia,0,0,0,,Dlaczego nie dotrzymałeś obietnicy?!
Dialogue: 0,0:17:41.76,0:17:45.66,Default,Emilia,0,0,0,,Ty i Puck złamaliście obietnice i\Nodeszliście.
Dialogue: 0,0:17:46.14,0:17:49.22,Default,Emilia,0,0,0,,Odszedłeś i mnie zostawiłeś.
Dialogue: 0,0:17:50.32,0:17:51.95,Default,Emilia,0,0,0,,Jesteś kłamcą.
Dialogue: 0,0:17:52.52,0:17:54.08,Default,,0,0,0,,Puck jest kłamcą.
Dialogue: 0,0:17:55.67,0:17:56.70,Default,Emilia,0,0,0,,Kłamca...
Dialogue: 0,0:17:57.78,0:17:59.00,Default,,0,0,0,,Ty kłamco...
Dialogue: 0,0:17:59.09,0:17:59.97,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:18:00.06,0:18:02.92,Default,Emilia,0,0,0,,Nie powinieneś... łamać obietnicy...
Dialogue: 0,0:18:03.22,0:18:04.72,Default,Emilia,0,0,0,,Nie powinieneś kłamać!
Dialogue: 0,0:18:05.01,0:18:06.72,Default,Emilia,0,0,0,,To źle!
Dialogue: 0,0:18:20.72,0:18:21.71,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:18:22.57,0:18:24.62,Default,Subaru,0,0,0,,Kocham cię.
Dialogue: 0,0:18:24.99,0:18:25.87,Default,Emilia,0,0,0,,Hę?
Dialogue: 0,0:18:28.12,0:18:32.37,Default,Subaru,0,0,0,,Noc po nocy wbiegasz w tę samą cholerną\Npróbę.
Dialogue: 0,0:18:32.46,0:18:35.54,Default,Subaru,0,0,0,,Czym w ogóle jest ta próba? To tylko\Nprzeszłość!
Dialogue: 0,0:18:35.63,0:18:38.44,Default,Subaru,0,0,0,,Przestań rozpaczać nad czymś, co już dawno\Nminęło!
Dialogue: 0,0:18:38.53,0:18:39.59,Default,Emilia,0,0,0,,Yyy, co...
Dialogue: 0,0:18:39.68,0:18:44.31,Default,Subaru,0,0,0,,Kiedy próbowałem zrobić to za ciebie,\Nnalegałaś, że tylko ty możesz to zrobić.
Dialogue: 0,0:18:44.40,0:18:47.08,Default,Subaru,0,0,0,,Jeśli to spieprzysz,\Nznaczy, że tylko gadałaś!
Dialogue: 0,0:18:47.17,0:18:48.48,Default,Emilia,0,0,0,,S-Subaru...
Dialogue: 0,0:18:48.57,0:18:51.52,Default,Subaru,0,0,0,,A na końcu, kiedy twój pupil i opiekun\Nodchodzi,
Dialogue: 0,0:18:51.61,0:18:54.48,Default,Subaru,0,0,0,,porzucasz obowiązki, uciekasz,\Ndąsasz się i płaczesz?
Dialogue: 0,0:18:54.57,0:18:56.53,Default,Subaru,0,0,0,,Nie mogę tego dłużej znieść!
Dialogue: 0,0:19:00.42,0:19:02.12,Default,Emilia,0,0,0,,Masz rację.
Dialogue: 0,0:19:02.21,0:19:06.49,Default,,0,0,0,,To tylko logiczne,\Nże myślisz o mnie w ten sposób.
Dialogue: 0,0:19:06.70,0:19:07.58,Default,Subaru,0,0,0,,Ale mimo to...
Dialogue: 0,0:19:08.54,0:19:11.92,Default,Subaru,0,0,0,,Kocham cię, Emilio.
Dialogue: 0,0:19:14.82,0:19:16.66,Default,Subaru,0,0,0,,Kocham cię.
Dialogue: 0,0:19:17.38,0:19:21.59,Default,Subaru,0,0,0,,Kocham cię tak, tak, tak bardzo, że nie\Nwiem, co ze sobą zrobić.
Dialogue: 0,0:19:21.90,0:19:24.25,Default,Emilia,0,0,0,,S-Skąd to wszystko się wzięło?
Dialogue: 0,0:19:24.34,0:19:27.27,Default,Subaru,0,0,0,,Uwielbiam twoje piękne srebrne włosy.
Dialogue: 0,0:19:27.36,0:19:30.66,Default,Subaru,0,0,0,,Uwielbiam te wilgotne fioletowe klejnoty,\Nktóre masz zamiast oczu.
Dialogue: 0,0:19:30.79,0:19:34.34,Default,Subaru,0,0,0,,Uwielbiam twój głos i to, jak samo jego\Nbrzmienie wprawia mnie w trans.
Dialogue: 0,0:19:34.43,0:19:37.87,Default,Subaru,0,0,0,,Twoje długie, szczupłe ręce\Ni nogi, twoja blada skóra,
Dialogue: 0,0:19:38.24,0:19:41.73,Default,Subaru,0,0,0,,i twój wzrost — wszystko jest dla mnie\Naż nieznośnie idealne.
Dialogue: 0,0:19:41.82,0:19:44.36,Default,Subaru,0,0,0,,Przy tobie serce pędzi mi jak szalone.
Dialogue: 0,0:19:44.45,0:19:45.37,Default,Subaru,0,0,0,,To przerażające.
Dialogue: 0,0:19:47.21,0:19:49.61,Default,Subaru,0,0,0,,Uwielbiam też to, że jesteś trochę\Nroztargniona.
Dialogue: 0,0:19:49.70,0:19:52.35,Default,Subaru,0,0,0,,To, jak zawsze dajesz z siebie wszystko,\Njest urocze,
Dialogue: 0,0:19:52.69,0:19:55.87,Default,Subaru,0,0,0,,i szanuję to, jak starasz się pomagać\Ninnym.
Dialogue: 0,0:19:56.26,0:19:59.96,Default,Subaru,0,0,0,,Trudno zostawić cię samą, gdy widzę, jak\Nstawiasz innych ponad siebie.
Dialogue: 0,0:20:00.50,0:20:04.53,Default,Subaru,0,0,0,,Chcę z miejsca przy tobie oglądać każdą\Ntwoją minę.
Dialogue: 0,0:20:05.80,0:20:07.74,Default,Emilia,0,0,0,,To nie czas na...
Dialogue: 0,0:20:08.47,0:20:10.36,Default,Emilia,0,0,0,,Przestań się bawić!
Dialogue: 0,0:20:10.45,0:20:12.95,Default,Emilia,0,0,0,,Dlaczego nagle mówisz to wszystko?!
Dialogue: 0,0:20:13.04,0:20:15.21,Default,Emilia,0,0,0,,Nie o tym rozmawialiśmy!
Dialogue: 0,0:20:15.30,0:20:17.72,Default,Emilia,0,0,0,,Mówiłeś, że jestem zupełnie bezużyteczna
Dialogue: 0,0:20:17.81,0:20:19.12,Default,,0,0,0,,że nie mogłeś mnie znieść!
Dialogue: 0,0:20:19.21,0:20:20.31,Default,Subaru,0,0,0,,Tak, masz rację.
Dialogue: 0,0:20:20.40,0:20:23.47,Default,Emilia,0,0,0,,Czemu miałbyś wybaczyć\Nmi taką bezużyteczność?!
Dialogue: 0,0:20:23.56,0:20:26.69,Default,Subaru,0,0,0,,Jeśli chcesz tylko tej\Nodpowiedzi, mówiłem to wiele razy!
Dialogue: 0,0:20:26.78,0:20:29.45,Default,Subaru,0,0,0,,Bo cię kocham!
Dialogue: 0,0:20:31.25,0:20:33.30,Default,Subaru,0,0,0,,Jestem w tobie zakochany po uszy!
Dialogue: 0,0:20:33.39,0:20:36.24,Default,Subaru,0,0,0,,Wszystko w tobie lśni w moich oczach!
Dialogue: 0,0:20:36.71,0:20:38.97,Default,Subaru,0,0,0,,Oczywiście nie wszystko w tobie jest\Nidealne.
Dialogue: 0,0:20:39.06,0:20:42.12,Default,Subaru,0,0,0,,Nie jesteś ani aniołem ani boginią,\Ntylko zwykłą dziewczyną.
Dialogue: 0,0:20:42.21,0:20:44.68,Default,Subaru,0,0,0,,Czasami będzie ci tak źle, że zechcesz\Npłakać,
Dialogue: 0,0:20:44.77,0:20:48.22,Default,Subaru,0,0,0,,i będziesz chciała uciec od tego, co cię\Nrani! Rozumiem!
Dialogue: 0,0:20:48.51,0:20:53.63,Default,Subaru,0,0,0,,Ale nawet z tą słabością i cechami, które\Nsama mogłabyś nazwać brzydkimi...
Dialogue: 0,0:20:54.29,0:20:57.11,Default,Subaru,0,0,0,,Kocham każdą część twojej istoty, Emilio.
Dialogue: 0,0:20:58.46,0:21:01.67,Default,Emilia,0,0,0,,To po prostu... zbyt samolubne!
Dialogue: 0,0:21:01.76,0:21:04.60,Default,Emilia,0,0,0,,Wymieniłeś wszystko, przez\Nco jestem bezużyteczna,
Dialogue: 0,0:21:04.69,0:21:06.70,Default,Emilia,0,0,0,,i nadal mówisz, że mnie kochasz?
Dialogue: 0,0:21:07.43,0:21:08.90,Default,Emilia,0,0,0,,Jak mam ci uwierzyć?!
Dialogue: 0,0:21:08.99,0:21:12.04,Default,Subaru,0,0,0,,Mylisz się! Wszystko rozumiesz na opak!
Dialogue: 0,0:21:12.13,0:21:16.42,Default,Subaru,0,0,0,,Nie kocham cię dlatego, że w ciebie\Nwierzę!
Dialogue: 0,0:21:16.51,0:21:19.61,Default,Subaru,0,0,0,,Wierzę w ciebie, bo cię kocham!
Dialogue: 0,0:21:19.70,0:21:23.18,Default,Emilia,0,0,0,,Tylko miłość nie jest powodem,\Nby w kogoś wierzyć!
Dialogue: 0,0:21:24.44,0:21:27.48,Default,Subaru,0,0,0,,Jeśli miłość nie jest powodem,\Nby w ciebie wierzyć...
Dialogue: 0,0:21:27.57,0:21:31.23,Default,Subaru,0,0,0,,Więc kto do diabła chciałby przejść przez\Ncałe to cierpienie,
Dialogue: 0,0:21:31.32,0:21:34.89,Default,Subaru,0,0,0,,żeby przyjść z pomocą takiej utrapience\Njak ty?!
Dialogue: 0,0:21:34.98,0:21:38.20,Default,Subaru,0,0,0,,Kocham cię tak, że aż wariuję!
Dialogue: 0,0:21:38.29,0:21:40.36,Default,Subaru,0,0,0,,Kocham cię tak bardzo, że mógłbym umrzeć!
Dialogue: 0,0:21:40.59,0:21:43.23,Default,Subaru,0,0,0,,Dlatego znoszę ten ból i cierpienie!
Dialogue: 0,0:21:43.32,0:21:46.62,Default,Subaru,0,0,0,,Nawet teraz czuję, że mogę wymiotować,\Nale wciąż stoję przed tobą!
Dialogue: 0,0:21:47.52,0:21:50.54,Default,Emilia,0,0,0,,Nigdy cię o to nie prosiłam!
Dialogue: 0,0:21:50.63,0:21:52.23,Default,Emilia,0,0,0,,Jesteś po prostu samolubny!
Dialogue: 0,0:21:52.32,0:21:56.28,Default,,0,0,0,,Nie myślisz o moich uczuciach!
Dialogue: 0,0:21:56.37,0:21:59.47,Default,Emilia,0,0,0,,Nie masz pojęcia, co czuję za każdym\Nrazem, gdy widzę, jak
Dialogue: 0,0:21:59.72,0:22:02.50,Default,Emilia,0,0,0,,przeze mnie zostajesz ranny!
Dialogue: 0,0:22:02.59,0:22:05.64,Default,Subaru,0,0,0,,{\i1}Skąd{\i0} mam wiedzieć?! Nawet\No tym nie myślę!
Dialogue: 0,0:22:05.73,0:22:09.59,Default,Subaru,0,0,0,,Myślę tylko o tym, jak dobrze wyglądać\Nprzed tobą!
Dialogue: 0,0:22:09.68,0:22:11.72,Default,Subaru,0,0,0,,Cierpię dla ciebie!
Dialogue: 0,0:22:11.81,0:22:13.99,Default,,0,0,0,,Wyglądaj tak uroczo, jak oczekiwałem!
Dialogue: 0,0:22:14.08,0:22:16.05,Default,Emilia,0,0,0,,Nie mów tak, jakbym była lalką!
Dialogue: 0,0:22:16.14,0:22:18.68,Default,Emilia,0,0,0,,Dlaczego złamałeś obietnicę?!
Dialogue: 0,0:22:18.77,0:22:21.53,Default,Emilia,0,0,0,,Gdybyś zrobił to, o co cię\Nprosiłam, to by wystarczyło!
Dialogue: 0,0:22:21.62,0:22:23.39,Default,Emilia,0,0,0,,Dlaczego nawet tego nie zrobiłeś?!
Dialogue: 0,0:22:23.48,0:22:25.72,Default,Emilia,0,0,0,,Naprawdę mnie nienawidzisz, prawda?!
Dialogue: 0,0:22:25.81,0:22:26.69,Default,Subaru,0,0,0,,Kocham cię!
Dialogue: 0,0:22:26.78,0:22:27.66,Default,Emilia,0,0,0,,Kłamca!
Dialogue: 0,0:22:27.75,0:22:29.59,Default,Subaru,0,0,0,,Nie kłamię, kocham cię!
Dialogue: 0,0:22:28.91,0:22:30.03,Default,Emilia,0,0,0,,Więc...
Dialogue: 0,0:22:33.42,0:22:34.48,Default,Emilia,0,0,0,,Dlaczego?
Dialogue: 0,0:22:35.23,0:22:37.63,Default,,0,0,0,,Dlaczego złamałeś obietnicę?
Dialogue: 0,0:22:39.34,0:22:40.49,Default,Subaru,0,0,0,,Nie mogę ci powiedzieć.
Dialogue: 0,0:22:40.87,0:22:44.17,Default,Emilia,0,0,0,,Gdybyś został ze mną do\Nrana, jak obiecałeś,
Dialogue: 0,0:22:44.65,0:22:47.63,Default,Emilia,0,0,0,,Mogłabym ci uwierzyć.
Dialogue: 0,0:22:47.72,0:22:51.18,Default,Emilia,0,0,0,,Mogłabym ci uwierzyć i powierzyć ci\Nwszystko.
Dialogue: 0,0:22:52.37,0:22:54.80,Default,Emilia,0,0,0,,Ale ty...
Dialogue: 0,0:23:01.38,0:23:07.30,Default,Emilia,0,0,0,,Odkąd Puck odszedł, moje\Nwspomnienia powoli wracają.
Dialogue: 0,0:23:07.78,0:23:10.41,Default,Emilia,0,0,0,,Widoki w mojej głowie,\Nktórych nie rozpoznaję...
Dialogue: 0,0:23:10.50,0:23:12.28,Default,Emilia,0,0,0,,Rozmowy, których nie pamiętam...
Dialogue: 0,0:23:12.94,0:23:14.66,Default,Emilia,0,0,0,,Coraz więcej z nich wraca.
Dialogue: 0,0:23:15.22,0:23:18.79,Default,Emilia,0,0,0,,Myślałam, że pamiętam\Nwszystko przez cały ten czas.
Dialogue: 0,0:23:19.73,0:23:23.41,Default,Emilia,0,0,0,,Ale zapomniałam o nich, jakby nigdy nie\Nistniały.
Dialogue: 0,0:23:25.86,0:23:27.80,Default,Emilia,0,0,0,,Kiedy wszystkie wspomnienia powrócą,
Dialogue: 0,0:23:28.40,0:23:30.47,Default,Emilia,0,0,0,,Co się ze mną stanie?
Dialogue: 0,0:23:31.19,0:23:33.71,Default,Emilia,0,0,0,,Czy to naprawdę ja?
Dialogue: 0,0:23:34.18,0:23:36.31,Default,Emilia,0,0,0,,Zapomniałam o wielu ważnych rzeczach.
Dialogue: 0,0:23:36.56,0:23:38.89,Default,Emilia,0,0,0,,Nawet zapomniałam o matce.
Dialogue: 0,0:23:39.76,0:23:43.71,Default,Emilia,0,0,0,,A jednak... nie mylę się?
Dialogue: 0,0:23:47.76,0:23:51.15,Default - flashback,Nahoko,0,0,0,,{\i1}Nieważne, jak zaczynasz ani co dzieje się\Npośrodku.{\i0}
Dialogue: 0,0:23:51.75,0:23:53.36,Default - flashback,Nahoko,0,0,0,,{\i1}Liczy się to, jak kończysz.{\i0}
Dialogue: 0,0:23:55.10,0:23:58.16,Default - italics,Subaru,0,0,0,,Tak... masz rację, mamo.
Dialogue: 0,0:24:00.79,0:24:03.60,Default,Subaru,0,0,0,,Nieważne, jakie wspomnienia odzyskasz,
Dialogue: 0,0:24:03.69,0:24:05.24,Default,Subaru,0,0,0,,To nic nie zmieni.
Dialogue: 0,0:24:06.55,0:24:08.25,Default,Subaru,0,0,0,,Kocham cię.
Dialogue: 0,0:24:08.69,0:24:10.26,Default,,0,0,0,,Zawsze będę cię kochał.
Dialogue: 0,0:24:11.87,0:24:13.85,Default,Emilia,0,0,0,,Nie mogę w to uwierzyć.
Dialogue: 0,0:24:14.35,0:24:21.35,Default,Emilia,0,0,0,,Jeśli zniknie ta ja, którą jak twierdzisz\Nkochasz... czy nadal mógłbyś...
Dialogue: 0,0:24:22.01,0:24:23.08,Default,Subaru,0,0,0,,Mógłbym.
Dialogue: 0,0:24:23.17,0:24:26.85,Default,Subaru,0,0,0,,Nieważne co się stanie,\Nnie odejdziesz.
Dialogue: 0,0:24:27.34,0:24:28.98,Default,Subaru,0,0,0,,Kocham cię.
Dialogue: 0,0:24:29.31,0:24:30.86,Default,Emilia,0,0,0,,Ale jesteś kłamcą!
Dialogue: 0,0:24:31.68,0:24:34.41,Default,Emilia,0,0,0,,Nie potrafiłeś sprawić, żebym ci\Nuwierzyła.
Dialogue: 0,0:24:35.19,0:24:37.28,Default,Subaru,0,0,0,,Więc teraz sprawię, że mi uwierzysz.
Dialogue: 0,0:24:40.29,0:24:41.19,Default,Emilia,0,0,0,,Suba—
Dialogue: 0,0:24:41.59,0:24:43.24,Default,Subaru,0,0,0,,Jeśli tego nie chcesz, uchyl się.
Dialogue: 0,0:25:14.90,0:25:16.16,Default,Subaru,0,0,0,,Kocham cię.
Dialogue: 0,0:25:16.63,0:25:18.60,Default,Subaru,0,0,0,,Nieważne, ile twoich wad zobaczę,
Dialogue: 0,0:25:18.69,0:25:20.70,Default,Subaru,0,0,0,,I nawet jeśli będziemy się tak kłócić...
Dialogue: 0,0:25:20.79,0:25:23.94,Default,Subaru,0,0,0,,Nigdy nie przestanę cię kochać.
Dialogue: 0,0:25:24.37,0:25:26.56,Default,Subaru,0,0,0,,To się nie zmieni, cokolwiek się stanie.
Dialogue: 0,0:25:27.21,0:25:29.13,Default,Subaru,0,0,0,,Będę cię kochał jeszcze bardziej.
Dialogue: 0,0:25:29.55,0:25:32.80,Default,Subaru,0,0,0,,Dlatego zawsze będę w ciebie wierzył.
Dialogue: 0,0:25:33.57,0:25:35.32,Default,Subaru,0,0,0,,A jeśli chcesz wiedzieć dlaczego...
Dialogue: 0,0:25:36.82,0:25:38.65,Default,Emilia,0,0,0,,Bo... kochasz mnie?
Dialogue: 0,0:25:42.61,0:25:45.16,Default,Subaru,0,0,0,,Gdy zalewają cię wszystkie te nieznane\Nwspomnienia,
Dialogue: 0,0:25:45.25,0:25:47.95,Default,Subaru,0,0,0,,To naturalne, że czujesz się\Nniespokojna i przerażona.
Dialogue: 0,0:25:48.34,0:25:50.94,Default,Subaru,0,0,0,,Ale droga, którą kroczyłaś do tej pory,\Nnie zniknie.
Dialogue: 0,0:25:52.08,0:25:54.03,Default,Subaru,0,0,0,,Wszystko będzie dobrze.
Dialogue: 0,0:25:54.34,0:25:58.08,Default,Emilia,0,0,0,,Skąd możesz mieć taką pewność?
Dialogue: 0,0:25:58.73,0:26:00.74,Default,Subaru,0,0,0,,Nie liczy się to, jak zaczynasz.
Dialogue: 0,0:26:00.83,0:26:02.18,Default,,0,0,0,,Liczy się to, jak kończysz.
Dialogue: 0,0:26:03.91,0:26:07.37,Default,Subaru,0,0,0,,Powiedziała to kobieta, którą szanuję\Nnajbardziej na całym świecie.
Dialogue: 0,0:26:08.05,0:26:09.95,Default,Subaru,0,0,0,,Wszystko będzie dobrze, Emilio.
Dialogue: 0,0:26:10.74,0:26:12.68,Default,Subaru,0,0,0,,Jestem po twojej stronie.
Dialogue: 0,0:26:12.77,0:26:14.62,Default,,0,0,0,,Możesz sobie wszystko przypomnieć.
Dialogue: 0,0:26:15.34,0:26:18.30,Default,Subaru,0,0,0,,Jeśli nadal będziesz się bać, znajdziemy\Nje.
Dialogue: 0,0:26:18.57,0:26:20.86,Default,Emilia,0,0,0,,Znaleźć... co?
Dialogue: 0,0:26:22.32,0:26:26.19,Default,Subaru,0,0,0,,Tak jak moje uczucia do ciebie\Nsprawiają, że mogę biec naprzód,
Dialogue: 0,0:26:26.66,0:26:30.75,Default,Subaru,0,0,0,,znajdziesz swoje najcenniejsze uczucie —\Nto, które pozwoli ci odrzucić
Dialogue: 0,0:26:30.84,0:26:32.84,Default,Subaru,0,0,0,,wszystkie lęki i biec dalej.
Dialogue: 0,0:26:34.73,0:26:39.90,Default,Subaru,0,0,0,,Oczywiście, mam nadzieję,\Nże to uczucie będzie dla mnie.
Dialogue: 0,0:26:41.18,0:26:44.10,Default,Emilia,0,0,0,,Moje najcenniejsze uczucie...
Dialogue: 0,0:26:46.69,0:26:51.68,Default,Emilia,0,0,0,,Ciekawe, czy znajduje się wśród tych\Nwszystkich odzyskiwanych wspomnień.
Dialogue: 0,0:26:52.17,0:26:54.17,Default,Emilia,0,0,0,,Moje najcenniejsze uczucie...
Dialogue: 0,0:26:55.28,0:26:57.07,Default,Subaru,0,0,0,,Tak, jestem pewien.
Dialogue: 0,0:26:57.61,0:26:59.76,Default,Subaru,0,0,0,,Twój powód, by iść dalej, jest właśnie\Ntam.
Dialogue: 0,0:27:08.69,0:27:09.57,Default,Emilia,0,0,0,,Tak.
Dialogue: 0,0:27:09.81,0:27:14.82,Episode Title,Title,0,0,0,,{\fs40}Powód, by {\c&H6D6D6D&}wierzyć{\c&HFFFFFF&}
Dialogue: 0,0:27:24.47,0:27:26.32,Default,Subaru,0,0,0,,Hej. Przepraszam, że musiałeś czekać.
Dialogue: 0,0:27:26.58,0:27:29.11,Default,Garfiel,0,0,0,,Nie czekałem na ciebie.
Dialogue: 0,0:27:29.20,0:27:36.20,Default,,0,0,0,,
