Dialogue: 0,0:00:31.01,0:00:32.42,Default - flashback,Wilhelm,0,0,0,,Nie widziałem cię wcześniej.
Dialogue: 0,0:00:32.95,0:00:36.11,Default - flashback,Wilhelm,0,0,0,,Co kobieta robi tu o tak wczesnej porze?
Dialogue: 0,0:00:45.68,0:00:47.77,Default - flashback,Theresia,0,0,0,,Ach, nie przejmuj się tym.
Dialogue: 0,0:00:47.86,0:00:48.91,Default - flashback,,0,0,0,,Po prostu tu przyjdź.
Dialogue: 0,0:01:05.12,0:01:06.07,Default - flashback,Theresia,0,0,0,,Hej...
Dialogue: 0,0:01:10.56,0:01:12.32,Default - flashback,Theresia,0,0,0,,Lubisz kwiaty?
Dialogue: 0,0:01:23.43,0:01:24.31,Default,Crusch,0,0,0,,Żołnierze
Dialogue: 0,0:01:24.41,0:01:25.77,Default,Subaru,0,0,0,,Niech mu się dostanie!
Dialogue: 0,0:01:25.94,0:01:27.28,Default - italics,Rem,0,0,0,,Al Huma!
Dialogue: 0,0:01:43.49,0:01:46.79,Default,Crusch,0,0,0,,Żołnierze! Za tymi dwoma głupcami!
Dialogue: 0,0:02:01.33,0:02:02.83,Default,Rem,0,0,0,,Włączają się odstraszacze.
Dialogue: 0,0:02:02.92,0:02:04.47,Default,,0,0,0,,Zamknij oczy.
Dialogue: 0,0:02:14.15,0:02:15.33,Default,Subaru,0,0,0,,O rany...
Dialogue: 0,0:02:15.42,0:02:18.07,Default,Subaru,0,0,0,,Tak właśnie mówili wszyscy! Niesamowite!
Dialogue: 0,0:03:00.15,0:03:02.92,Default,Subaru,0,0,0,,To… Biały Wieloryb?
Dialogue: 0,0:04:46.17,0:04:48.18,Default,Subaru,0,0,0,,Jest naprawdę ogromny.
Dialogue: 0,0:04:49.14,0:04:50.29,Default,Rem,0,0,0,,Boisz się?
Dialogue: 0,0:04:52.02,0:04:53.50,Default,Subaru,0,0,0,,Tak, boję się...
Dialogue: 0,0:04:53.59,0:04:55.55,Default,Subaru,0,0,0,,o tej olśniewająco jasnej przyszłości,
Dialogue: 0,0:04:55.64,0:04:57.57,Default,,0,0,0,,gdzie chwalą mnie za pokonanie go!
Dialogue: 0,0:04:58.46,0:05:00.69,Default,Subaru,0,0,0,,No to uciekajmy jak najszybciej!
Dialogue: 0,0:05:01.21,0:05:02.10,Default,Rem,0,0,0,,Tak.
Dialogue: 0,0:05:09.51,0:05:10.57,Default,Subaru,0,0,0,,Jest taki szybki!
Dialogue: 0,0:05:21.58,0:05:22.87,Default,Crusch,0,0,0,,Bardzo nas nie doceniasz,
Dialogue: 0,0:05:22.96,0:05:25.08,Default,,0,0,0,,odwracając wzrok tak beztrosko.
Dialogue: 0,0:05:25.93,0:05:28.19,Default,Rem,0,0,0,,Niewidzialny miecz, nieważna odległość.
Dialogue: 0,0:05:28.70,0:05:30.53,Default,Rem,0,0,0,,To sztuka walki mieczem Crusch,
Dialogue: 0,0:05:30.63,0:05:32.32,Default,,0,0,0,,znane ze strajku stu pracowników
Dialogue: 0,0:05:54.72,0:05:55.60,Default,Crusch,0,0,0,,Rozproszyć się!
Dialogue: 0,0:05:55.76,0:05:56.99,Default,All,0,0,0,,Rozproszyć się!
Dialogue: 0,0:06:13.22,0:06:14.57,Default,Wilhelm,0,0,0,,Od czternastu lat,
Dialogue: 0,0:06:15.27,0:06:17.62,Default,,0,0,0,,Nie marzyłem o niczym innym,\Njak o tym dniu.
Dialogue: 0,0:06:20.00,0:06:22.58,Default,Wilhelm,0,0,0,,Przybądź tu jesienią i\Nzostaw po sobie zwłoki.
Dialogue: 0,0:06:35.04,0:06:37.47,Default,Wilhelm,0,0,0,,Jesteś po prostu potworem!
Dialogue: 0,0:06:58.62,0:07:00.69,Default,Wilhelm,0,0,0,,Jakże miło, że jesteś tak pomocny,
Dialogue: 0,0:07:00.78,0:07:02.64,Default,Wilhelm,0,0,0,,przybywając tu na śmierć!
Dialogue: 0,0:07:13.66,0:07:14.60,Default,Subaru,0,0,0,,O cholera!
Dialogue: 0,0:07:24.35,0:07:27.56,Default,Ricardo,0,0,0,,Nie odwracaj od nas wzroku, kretynie!
Dialogue: 0,0:07:29.51,0:07:30.76,Default,Mimi,0,0,0,,No to zaczynamy!
Dialogue: 0,0:07:30.85,0:07:32.10,Default,Hetaro,0,0,0,,Wszyscy, teraz!
Dialogue: 0,0:07:36.03,0:07:37.77,Default,Crusch,0,0,0,,Żołnierze, cofnijcie się!
Dialogue: 0,0:07:45.00,0:07:47.23,Default,Crusch,0,0,0,,Ogień z boku!
Dialogue: 0,0:07:47.70,0:07:49.03,Default - italics,All,0,0,0,,Algoa!
Dialogue: 0,0:08:07.42,0:08:09.58,Default,Subaru,0,0,0,,Wygląda na to, że to naprawdę zadziałało!
Dialogue: 0,0:08:09.67,0:08:11.46,Default,Subaru,0,0,0,,Myślę, że damy radę!
Dialogue: 0,0:08:11.81,0:08:13.79,Default,Rem,0,0,0,,Nie, szczerze mówiąc,
Dialogue: 0,0:08:13.99,0:08:16.66,Default,,0,0,0,,mieliśmy nadzieję, że\Nten atak unieruchomi go.
Dialogue: 0,0:08:19.23,0:08:21.52,Default,Subaru,0,0,0,,Wcale nie traci wysokości...
Dialogue: 0,0:08:25.44,0:08:28.79,Default,Ricardo,0,0,0,,Od samego początku wykorzystaliśmy\Nwszystkie nasze najlepsze ataki.
Dialogue: 0,0:08:29.00,0:08:30.90,Default,Ricardo,0,0,0,,To nie pomogło,
Dialogue: 0,0:08:30.99,0:08:34.26,Default,Ricardo,0,0,0,,to o wiele trudniejsze,\Nniż nam się wydawało.
Dialogue: 0,0:08:34.53,0:08:36.86,Default,Subaru,0,0,0,,Magiczne ataki nie zadziałały?
Dialogue: 0,0:08:36.95,0:08:40.55,Default,Rem,0,0,0,,Jego białe włosy rozpraszają\Nmanę i rozpraszają siłę.
Dialogue: 0,0:08:40.64,0:08:43.44,Default,Rem,0,0,0,,Moja magia też nie była tak\Nskuteczna, jak się wydawało.
Dialogue: 0,0:08:44.11,0:08:45.03,Default,Crusch,0,0,0,,Ogień!
Dialogue: 0,0:08:50.11,0:08:51.54,Default,Ricardo,0,0,0,,Czas na drugą kampanię.
Dialogue: 0,0:08:51.63,0:08:53.84,Default,Ricardo,0,0,0,,Zmniejszaj jego zapas energii!
Dialogue: 0,0:09:03.88,0:09:06.63,Default,Subaru,0,0,0,,Występowanie teraz w roli\Nprzynęty byłoby przeszkodą...
Dialogue: 0,0:09:07.39,0:09:10.17,Default,Subaru,0,0,0,,Więc pozostaje nam tylko\Nczekać, aż coś się wydarzy?
Dialogue: 0,0:09:10.41,0:09:13.61,Default,Felix,0,0,0,,Jestem tak samo poirytowany jak ty.
Dialogue: 0,0:09:14.07,0:09:16.01,Default,Felix,0,0,0,,Nie mam nawet żadnych ataków,
Dialogue: 0,0:09:16.10,0:09:18.32,Default,,0,0,0,,więc i tak mogę tylko patrzeć...
Dialogue: 0,0:09:18.65,0:09:22.03,Default,Subaru,0,0,0,,Dzięki Twojej medycznej\Nwiedzy jesteś naszym ratunkiem.
Dialogue: 0,0:09:22.12,0:09:24.98,Default,Subaru,0,0,0,,Po prostu pełnij tę rolę dla nas!
Dialogue: 0,0:09:25.26,0:09:26.56,Default,Subaru,0,0,0,,Liczymy na Ciebie.
Dialogue: 0,0:09:27.83,0:09:31.65,Default,Felix,0,0,0,,Naprawdę zmieniłeś się w ciągu\Nzaledwie jednego dnia, co?
Dialogue: 0,0:09:31.74,0:09:32.62,Default,Felix,0,0,0,,Co się stało?
Dialogue: 0,0:09:33.23,0:09:34.51,Default,Subaru,0,0,0,,Gdybym miał mówić...
Dialogue: 0,0:09:34.60,0:09:36.65,Default,,0,0,0,,Stałem się właśnie lepszym człowiekiem.
Dialogue: 0,0:09:36.74,0:09:38.16,Default,Rem,0,0,0,,Wilhelm to...
Dialogue: 0,0:09:58.39,0:10:00.06,Default,Ricardo,0,0,0,,Hup-hup!
Dialogue: 0,0:10:29.19,0:10:30.49,Default,Wilhelm,0,0,0,,Nieszczęśliwy...
Dialogue: 0,0:10:31.90,0:10:33.23,Default,Guy,0,0,0,,Co to jest?
Dialogue: 0,0:10:35.56,0:10:36.54,Default,Guy,0,0,0,,Coś tu nie gra...
Dialogue: 0,0:10:36.63,0:10:37.76,Default,Guy,0,0,0,,Co się dzieje?
Dialogue: 0,0:10:45.93,0:10:47.22,Default,Subaru,0,0,0,,Kolor jego oczu...
Dialogue: 0,0:11:50.70,0:11:52.72,Default - flashback,Theresia,0,0,0,,Czy polubiłeś kwiaty?
Dialogue: 0,0:11:55.83,0:11:57.72,Default - flashback,Wilhelm,0,0,0,,Nie, nie znoszę ich.
Dialogue: 0,0:12:03.15,0:12:04.97,Default - flashback,Theresia,0,0,0,,Dlaczego trzymasz ten miecz?
Dialogue: 0,0:12:05.06,0:12:07.28,Default - flashback,Wilhelm,0,0,0,,Bo to wszystko, co mam.
Dialogue: 0,0:12:14.29,0:12:15.33,Default,Subaru,0,0,0,,Zniknęło?
Dialogue: 0,0:12:18.06,0:12:19.96,Default,Rem,0,0,0,,Jedziemy! Trzymajcie się!
Dialogue: 0,0:12:28.67,0:12:30.40,Default,Crusch,0,0,0,,Żołnierze, wycofujcie się!
Dialogue: 0,0:12:30.49,0:12:31.40,Default,Guy,0,0,0,,Wycofać się!
Dialogue: 0,0:12:31.49,0:12:32.64,Default,Guy,0,0,0,,Cofnąć się!
Dialogue: 0,0:12:37.46,0:12:39.01,Default,Subaru,0,0,0,,Chwila, chwila, chwila, chwila!
Dialogue: 0,0:12:48.83,0:12:50.98,Default,Subaru,0,0,0,,Tak wygląda ta magiczna mgła?
Dialogue: 0,0:12:51.49,0:12:52.83,Default,Subaru,0,0,0,,Jeśli to nas trafi...
Dialogue: 0,0:13:02.18,0:13:03.37,Default,Crusch,0,0,0,,Ilu ludzi straciliśmy?
Dialogue: 0,0:13:03.82,0:13:05.98,Default,Conwood,0,0,0,,Dwunastu z mojej jednostki.
Dialogue: 0,0:13:06.07,0:13:07.76,Default,Conwood,0,0,0,,Brakuje nam teraz trzech osób.
Dialogue: 0,0:13:07.97,0:13:09.25,Default,Crusch,0,0,0,,Kto się zgubił?
Dialogue: 0,0:13:09.53,0:13:10.86,Default,Conwood,0,0,0,,Nie wiem.
Dialogue: 0,0:13:11.13,0:13:12.49,Default,Guy,0,0,0,,Czternastu z mojej grupy.
Dialogue: 0,0:13:12.58,0:13:13.81,Default,,0,0,0,,Jeden opuszczony.
Dialogue: 0,0:13:14.31,0:13:16.61,Default,Guy,0,0,0,,Brakuje mi sześciu. Przepraszam.
Dialogue: 0,0:13:20.65,0:13:23.68,Default - flashback,Otto,0,0,0,,Po przeciwnej stronie nikt nie jechał.
Dialogue: 0,0:13:23.77,0:13:25.44,Default - flashback,Otto,0,0,0,,Kim jest Rem?
Dialogue: 0,0:13:25.53,0:13:27.20,Default - flashback,Ram,0,0,0,,Rem… Kto to jest?
Dialogue: 0,0:13:27.29,0:13:29.04,Default - flashback,Subaru,0,0,0,,Ty też zapomniałeś o Rem?
Dialogue: 0,0:13:29.57,0:13:30.90,Default - italics,Subaru,0,0,0,,To wszystko...
Dialogue: 0,0:13:31.01,0:13:33.36,Default - italics,Subaru,0,0,0,,Ludzie, których ogarnęła\Nmgła Białego Wieloryba
Dialogue: 0,0:13:33.45,0:13:35.86,Default - italics,,0,0,0,,znikneli z powierzchni ziemi\Nwraz ze wszystkim.
Dialogue: 0,0:13:37.52,0:13:39.36,Default,Subaru,0,0,0,,Mgła eliminacji.
Dialogue: 0,0:13:40.14,0:13:41.38,Default,Crusch,0,0,0,,Wróciłeś?
Dialogue: 0,0:13:42.21,0:13:43.63,Default,Wilhelm,0,0,0,,Wybacz mi ten pośpiech.
Dialogue: 0,0:13:43.80,0:13:44.87,Default,,0,0,0,,Odszkodowanie?
Dialogue: 0,0:13:44.96,0:13:46.86,Default,Crusch,0,0,0,,Zginęło dwadzieścia jeden osób.
Dialogue: 0,0:13:47.35,0:13:49.65,Default,Crusch,0,0,0,,Wygląda na to, że cały pluton zginął.
Dialogue: 0,0:13:50.44,0:13:52.06,Default,Crusch,0,0,0,,To nie będzie w ogóle możliwe
Dialogue: 0,0:13:52.36,0:13:54.77,Default,,0,0,0,,aby godnie uczcić pamięć zmarłych.
Dialogue: 0,0:13:55.18,0:13:56.30,Default,Conwood,0,0,0,,Przepraszam.
Dialogue: 0,0:13:58.34,0:14:00.73,Default - flashback,Theresia,0,0,0,,Dlaczego trzymasz ten miecz?
Dialogue: 0,0:14:06.14,0:14:07.45,Default - flashback,Wilhelm,0,0,0,,Ponieważ nie zdecydowałem
Dialogue: 0,0:14:08.63,0:14:11.20,Default - flashback,,0,0,0,,lub w jakikolwiek inny sposób
Dialogue: 0,0:14:17.15,0:14:18.40,Default,Crusch,0,0,0,,Skoro już jest we mgle,
Dialogue: 0,0:14:19.17,0:14:21.40,Default,Crusch,0,0,0,,nie będziemy wiedzieć, skąd zaatakuje.
Dialogue: 0,0:14:22.10,0:14:25.01,Default,Crusch,0,0,0,,Zostać blisko siebie to najgorsza\Nrzecz, jaką można zrobić.
Dialogue: 0,0:14:25.31,0:14:26.84,Default,Crusch,0,0,0,,Natychmiast się rozproszyć.
Dialogue: 0,0:14:28.37,0:14:29.25,Default,Crusch,0,0,0,,Co to jest?
Dialogue: 0,0:14:33.90,0:14:35.44,Default,Subaru,0,0,0,,Czy to ten Biały Wieloryb?
Dialogue: 0,0:14:40.08,0:14:41.67,Default,Subaru,0,0,0,,Hej! Co się stało?
Dialogue: 0,0:14:44.15,0:14:45.03,Default,Subaru,0,0,0,,Hej!
Dialogue: 0,0:14:56.25,0:14:57.55,Default,Subaru,0,0,0,,Hej! Rem!
Dialogue: 0,0:14:58.15,0:15:02.12,Default,Rem,0,0,0,,Ten głos to mgła, która atakuje\Nbezpośrednio nasze umysły...
Dialogue: 0,0:15:03.78,0:15:05.66,Default,Rem,0,0,0,,Podobnie jak w przypadku many,
Dialogue: 0,0:15:06.05,0:15:07.33,Default,,0,0,0,,ale co gorsza...
Dialogue: 0,0:15:08.80,0:15:11.79,Default,Subaru,0,0,0,,Niektórzy potrafią się temu\Noprzeć, a inni nie?
Dialogue: 0,0:15:12.73,0:15:14.80,Default,Subaru,0,0,0,,Nic nie czuję...
Dialogue: 0,0:15:15.54,0:15:16.75,Default,Rem,0,0,0,,W porządku.
Dialogue: 0,0:15:16.84,0:15:18.52,Default,,0,0,0,,Teraz już się uspokoi.
Dialogue: 0,0:15:19.92,0:15:20.80,Default,Subaru,0,0,0,,Hej!
Dialogue: 0,0:15:20.89,0:15:22.86,Default,Subaru,0,0,0,,Dość tego... Przestań!
Dialogue: 0,0:15:24.40,0:15:25.28,Default,Crusch,0,0,0,,Felis!
Dialogue: 0,0:15:25.37,0:15:26.56,Default,,0,0,0,,Niech pomogą inni!
Dialogue: 0,0:15:27.01,0:15:31.19,Default,Subaru,0,0,0,,Ranienie ludzi jest dla armii\Nwiększym obciążeniem niż ich zabijanie,
Dialogue: 0,0:15:31.28,0:15:33.48,Default,Subaru,0,0,0,,ale jaki potwór by tak postąpił?
Dialogue: 0,0:15:33.57,0:15:34.65,Default,Felix,0,0,0,,Ruszaj się!
Dialogue: 0,0:15:41.17,0:15:44.85,Default - italics,Subaru,0,0,0,,Wydaje mi się, że Felis potrafi usuną\Nskutki skażenia spowodowanego mgłą.
Dialogue: 0,0:15:45.90,0:15:47.65,Default - italics,Subaru,0,0,0,,Ale nie ma na to czasu...
Dialogue: 0,0:15:47.74,0:15:49.88,Default - italics,Subaru,0,0,0,,Jeśli to nas teraz dopadnie, to po nas.
Dialogue: 0,0:15:58.41,0:15:59.66,Default,Subaru,0,0,0,,Crusch!
Dialogue: 0,0:15:59.83,0:16:01.22,Default,,0,0,0,,Zyskam nam trochę czasu.
Dialogue: 0,0:16:01.42,0:16:03.45,Default,Subaru,0,0,0,,Niech wszyscy się zgromadzą!
Dialogue: 0,0:16:03.54,0:16:04.42,Default,Crusch,0,0,0,,Co?
Dialogue: 0,0:16:04.56,0:16:08.07,Default,Subaru,0,0,0,,Rem, musisz iść ze mną\Nw najniebezpieczniejsze miejsce!
Dialogue: 0,0:16:08.80,0:16:10.53,Default,Rem,0,0,0,,Oczywiście. Gdziekolwiek.
Dialogue: 0,0:16:10.64,0:16:11.85,Default,Crusch,0,0,0,,Czekaj, Subaru!
Dialogue: 0,0:16:11.94,0:16:14.03,Default,Subaru,0,0,0,,Zakryć uszy!
Dialogue: 0,0:16:12.29,0:16:13.46,Default,Crusch,0,0,0,,W tej mgle...
Dialogue: 0,0:16:14.39,0:16:17.04,Default,Subaru,0,0,0,,Kto nie może, niech zostanie na miejscu!
Dialogue: 0,0:16:19.27,0:16:21.48,Default,Subaru,0,0,0,,Powrócę po śmierci do…
Dialogue: 0,0:16:31.80,0:16:33.21,Default,Subaru,0,0,0,,Wróciłem...
Dialogue: 0,0:16:33.30,0:16:34.43,Default,Subaru,0,0,0,,No i co, Rem?
Dialogue: 0,0:16:34.52,0:16:36.24,Default,,0,0,0,,Czy pachnę jak Czarownica?
Dialogue: 0,0:16:36.33,0:16:38.01,Default,Rem,0,0,0,,Tak, śmierdzisz!
Dialogue: 0,0:16:38.10,0:16:40.73,Default,Subaru,0,0,0,,Właśnie tego chciałem, ale\Nczy musiałeś to tak ująć?
Dialogue: 0,0:16:41.98,0:16:44.97,Default,Crusch,0,0,0,,Ci, którzy mogą się iść,\Nniech przeniosą rannych pod drzewo!
Dialogue: 0,0:16:45.06,0:16:47.38,Default,Crusch,0,0,0,,Będziemy musieli użyć trochę siły.
Dialogue: 0,0:16:49.03,0:16:50.65,Default,Subaru,0,0,0,,Wraz z ulgarmem,
Dialogue: 0,0:16:50.74,0:16:53.83,Default,,0,0,0,,było na tyle skuteczne,\Nże objęło cały las.
Dialogue: 0,0:16:53.99,0:16:55.45,Default,Subaru,0,0,0,,Co tym razem zrobi?
Dialogue: 0,0:16:55.54,0:16:57.63,Default,Subaru,0,0,0,,Szczerze mówiąc, to wielka niewiadoma...
Dialogue: 0,0:16:57.72,0:16:59.52,Default,Rem,0,0,0,,Nie, działa.
Dialogue: 0,0:17:01.68,0:17:02.87,Default,Subaru,0,0,0,,To już wkrótce.
Dialogue: 0,0:17:03.14,0:17:05.07,Default,Subaru,0,0,0,,To… to nadchodzi!
Dialogue: 0,0:17:06.50,0:17:07.86,Default - italics,Rem,0,0,0,,Ul Huma!
Dialogue: 0,0:17:12.17,0:17:13.34,Default,Subaru,0,0,0,,Jak?
Dialogue: 0,0:17:24.66,0:17:26.48,Default,Hetaro,0,0,0,,Siostro! Razem!
Dialogue: 0,0:17:32.08,0:17:32.96,Default,Mimi,0,0,0,,Kapitanie!
Dialogue: 0,0:17:33.05,0:17:34.35,Default,Ricardo,0,0,0,,Dam radę!
Dialogue: 0,0:17:46.01,0:17:46.96,Default,Subaru,0,0,0,,Rem!
Dialogue: 0,0:17:55.36,0:17:58.14,Default,Wilhelm,0,0,0,,Odwracasz wzrok ode mnie?\NJakie to niegrzeczne.
Dialogue: 0,0:17:58.58,0:18:03.35,Default,Wilhelm,0,0,0,,A przecież przez ostatnie\Nczternaście lat szalałem za tobą!
Dialogue: 0,0:18:06.21,0:18:08.29,Default,Ricardo,0,0,0,,To zaczyna być fajne.
Dialogue: 0,0:18:08.66,0:18:12.46,Default,Ricardo,0,0,0,,Jest solidniejszy, niż się spodziewałem,\Nale nie aż tak wytrzymały!
Dialogue: 0,0:18:12.84,0:18:16.32,Default,Wilhelm,0,0,0,,Nie, nie stawia takiego oporu,\Njakiego można by się spodziewać.
Dialogue: 0,0:18:17.03,0:18:19.40,Default,Wilhelm,0,0,0,,Trudno mi w to uwierzyć
Dialogue: 0,0:18:20.13,0:18:23.23,Default,Wilhelm,0,0,0,,pokonałem moją żonę,\Nmistrzynię szermierki.
Dialogue: 0,0:18:23.32,0:18:24.87,Default,Wilhelm,0,0,0,,To, że wyprzedziliśmy innych,
Dialogue: 0,0:18:24.99,0:18:28.07,Default,Wilhelm,0,0,0,,nie wykorzystała swojej mgły\Ndo rozdzielenia naszych sił—
Dialogue: 0,0:18:34.20,0:18:36.16,Default,Wilhelm,0,0,0,,Zanim wyjdę, wezmę jeszcze jedną rzecz!
Dialogue: 0,0:18:46.52,0:18:47.57,Default,Subaru,0,0,0,,Wilhelm!
Dialogue: 0,0:18:47.66,0:18:48.54,Default,Wilhelm,0,0,0,,Bądźcie czujni!
Dialogue: 0,0:18:48.63,0:18:50.08,Default,,0,0,0,,Nie wiemy, skąd to nadejdzie.
Dialogue: 0,0:19:10.62,0:19:11.81,Default,Ricardo,0,0,0,,Co słychać?
Dialogue: 0,0:19:12.08,0:19:13.20,Default,,0,0,0,,To się nie uda?
Dialogue: 0,0:19:20.12,0:19:21.06,Default,Wilhelm,0,0,0,,To nadchodzi.
Dialogue: 0,0:19:23.67,0:19:26.33,Default,Subaru,0,0,0,,Zaczyna się mgła!
Dialogue: 0,0:19:38.40,0:19:39.53,Default,Subaru,0,0,0,,Uciekaj!
Dialogue: 0,0:19:46.18,0:19:49.15,Default - flashback,Theresia,0,0,0,,Hej, polubiłeś już kwiaty?
Dialogue: 0,0:19:51.79,0:19:52.67,Default - flashback,Theresia,0,0,0,,Co to jest?
Dialogue: 0,0:19:53.66,0:19:55.10,Default - flashback,Wilhelm,0,0,0,,Mówiono o nadaniu,
Dialogue: 0,0:19:55.41,0:19:56.65,Default - flashback,,0,0,0,,i zostałem rycerzem.
Dialogue: 0,0:20:00.32,0:20:02.15,Default - flashback,Theresia,0,0,0,,Cóż, gratulacje.
Dialogue: 0,0:20:02.48,0:20:04.02,Default - flashback,Theresia,0,0,0,,Jesteś blisko marzenia.
Dialogue: 0,0:20:04.90,0:20:05.93,Default - flashback,Wilhelm,0,0,0,,Moje marzenie?
Dialogue: 0,0:20:06.02,0:20:08.22,Default - flashback,Theresia,0,0,0,,Czyż nie trzymasz miecza, by chronić?
Dialogue: 0,0:20:09.03,0:20:12.05,Default - flashback,Theresia,0,0,0,,Rycerz to ktoś, kto chroni innych.
Dialogue: 0,0:20:22.60,0:20:25.43,Default - flashback,Wilhelm,0,0,0,,Nie chcę... umrzeć...
Dialogue: 0,0:20:45.14,0:20:46.37,Default - flashback,Wilhelm,0,0,0,,To upokarzające!
Dialogue: 0,0:20:48.59,0:20:49.57,Default - flashback,Theresia,0,0,0,,Rozumiem.
Dialogue: 0,0:20:49.66,0:20:51.29,Default - flashback,Wilhelm,0,0,0,,Śmiałeś się ze mnie?!
Dialogue: 0,0:20:52.98,0:20:54.79,Default - flashback,Wilhelm,0,0,0,,Odpowiedz mi, Teresio!
Dialogue: 0,0:20:55.59,0:20:56.53,Default - flashback,Wilhelm,0,0,0,,Nie...
Dialogue: 0,0:20:57.54,0:21:00.14,Default - flashback,Wilhelm,0,0,0,,Mistrzyni szermierki Theresia van Astrea!
Dialogue: 0,0:21:08.38,0:21:10.88,Default - flashback,Theresia,0,0,0,,Nie... wrócę tu już więcej.
Dialogue: 0,0:21:16.24,0:21:18.02,Default - flashback,Wilhelm,0,0,0,,Z taką twarzą,
Dialogue: 0,0:21:18.26,0:21:20.52,Default - flashback,,0,0,0,,Nie powinieneś trzymać miecza!
Dialogue: 0,0:21:21.92,0:21:23.85,Default - flashback,Theresia,0,0,0,,Jestem mistrzem szermierki.
Dialogue: 0,0:21:24.32,0:21:26.37,Default - flashback,Theresia,0,0,0,,Nie rozumiałam, dlaczego,
Dialogue: 0,0:21:26.98,0:21:28.20,Default - flashback,,0,0,0,,ale teraz już wiem.
Dialogue: 0,0:21:28.74,0:21:30.79,Default - flashback,Wilhelm,0,0,0,,Powód...
Dialogue: 0,0:21:31.73,0:21:34.00,Default - flashback,Theresia,0,0,0,,Wznieść miecz, by kogoś chronić.
Dialogue: 0,0:21:34.82,0:21:37.52,Default - flashback,Theresia,0,0,0,,Mnie też się to podoba.
Dialogue: 0,0:21:41.02,0:21:43.44,Default - flashback,Wilhelm,0,0,0,,Chwileczkę, Theresia...
Dialogue: 0,0:21:44.20,0:21:46.12,Default - flashback,Wilhelm,0,0,0,,Zabiorę ci miecz!
Dialogue: 0,0:21:46.91,0:21:50.04,Default - flashback,Wilhelm,0,0,0,,Nie obchodzi mnie tytuł\Nnadany Mistrzowi Miecza!
Dialogue: 0,0:21:50.62,0:21:52.32,Default - flashback,Wilhelm,0,0,0,,Władając mieczem...
Dialogue: 0,0:21:53.12,0:21:56.34,Default - flashback,Wilhelm,0,0,0,,Piękno stalowego ostrza...\NNie lekceważ ich,
Dialogue: 0,0:21:57.17,0:21:58.52,Default - flashback,Wilhelm,0,0,0,,Mistrzu szermierki!
Dialogue: 0,0:22:12.47,0:22:13.81,Default,Ricardo,0,0,0,,Mamy kłopoty!
Dialogue: 0,0:22:42.10,0:22:43.80,Default,Subaru,0,0,0,,Żartujesz sobie...
Dialogue: 0,0:22:50.97,0:22:53.84,Episode Title,Title,0,0,0,,Wilhelm z Astrei
Comment: 0,0:22:53.93,0:22:55.93,Episode Title,,0,0,0,,
Dialogue: 0,0:23:01.48,0:23:03.44,Default,Mimi,0,0,0,,Kapitanie?
Dialogue: 0,0:23:07.42,0:23:08.57,Default,Guy,0,0,0,,Jak?
Dialogue: 0,0:23:08.66,0:23:09.92,Default,Guy,0,0,0,,To już koniec...
Dialogue: 0,0:23:10.01,0:23:11.11,Default,Guy,0,0,0,,Jesteśmy skończeni.
Dialogue: 0,0:23:14.41,0:23:16.37,Default,Subaru,0,0,0,,Nie pozwól, żeby go pochłonęło!
Dialogue: 0,0:23:17.98,0:23:19.80,Default,Subaru,0,0,0,,Jeśli wyciągniemy go, zanim połknie,
Dialogue: 0,0:23:19.89,0:23:21.54,Default,,0,0,0,,możemy go uratować!
Dialogue: 0,0:23:29.23,0:23:30.29,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:23:32.03,0:23:36.69,Default,Subaru,0,0,0,,Nie myślcie, że ta odrobina\Nrozpaczy wystarczy, by mnie powstrzymać!
Dialogue: 0,0:23:37.09,0:23:39.04,Default,Subaru,0,0,0,,Poddawanie się nie w naszym stylu!
Dialogue: 0,0:23:39.13,0:23:40.81,Default,Subaru,0,0,0,,Nie ja, nie ty,
Dialogue: 0,0:23:40.90,0:23:42.77,Default,Subaru,0,0,0,,nie każdy!
Dialogue: 0,0:24:03.67,0:24:05.32,Default,Subaru,0,0,0,,Chodźmy, Patrasche!
Dialogue: 0,0:24:05.41,0:24:07.42,Default,Subaru,0,0,0,,Pędź prosto pod nosem wieloryba!
Dialogue: 0,0:24:12.09,0:24:16.23,Default,Rem,0,0,0,,Jedyna osoba, która może\Nwąchać Subaru, to ja!
Dialogue: 0,0:24:24.92,0:24:26.11,Default,Crusch,0,0,0,,Zamknij usta!
Dialogue: 0,0:24:29.33,0:24:32.11,Default,Crusch,0,0,0,,Na pierwszy rzut oka sytuacja wygląda źle.
Dialogue: 0,0:24:32.20,0:24:33.39,Default,Crusch,0,0,0,,Gdzie jest Wilhelm?
Dialogue: 0,0:24:33.48,0:24:35.48,Default,Subaru,0,0,0,,Jeśli go pamiętasz,
Dialogue: 0,0:24:35.57,0:24:37.75,Default,,0,0,0,,przynajmniej wiemy, że mgła go nie zabiła.
Dialogue: 0,0:24:38.93,0:24:41.72,Default,Subaru,0,0,0,,Wszystko zależy od tego,\Njak Rem będzie walczyć.
Dialogue: 0,0:24:43.73,0:24:45.45,Default,Crusch,0,0,0,,Co o tym sądzisz, Natsuki Subaru?
Dialogue: 0,0:24:45.81,0:24:47.30,Default,Crusch,0,0,0,,Czy to nie jest dziwne?
Dialogue: 0,0:24:47.39,0:24:48.60,Default,Subaru,0,0,0,,Dziwne?
Dialogue: 0,0:24:48.69,0:24:50.41,Default,Crusch,0,0,0,,Obecnie są trzy białe wieloryby.
Dialogue: 0,0:24:50.84,0:24:52.83,Default,Crusch,0,0,0,,Jeśli jest to mabeast żyjący w stadach,
Dialogue: 0,0:24:52.92,0:24:55.17,Default,Crusch,0,0,0,,jak to możliwe, o tym nie wiedzieliśmy?
Dialogue: 0,0:24:55.87,0:24:57.38,Default,Crusch,0,0,0,,Musi być w tym jakiś haczyk.
Dialogue: 0,0:24:58.57,0:25:00.84,Default,Subaru,0,0,0,,I musimy się tego dowiedzieć, co?
Dialogue: 0,0:25:02.09,0:25:03.93,Default,Crusch,0,0,0,,Jeśli nie, to długo nie wytrzymamy.
Dialogue: 0,0:25:04.17,0:25:05.47,Default,Crusch,0,0,0,,Coś wymyślimy.
Dialogue: 0,0:25:05.56,0:25:08.32,Default,,0,0,0,,Wycofanie się nie wchodzi już w grę.
Dialogue: 0,0:25:10.08,0:25:11.06,Default,Crusch,0,0,0,,Ogień!
Dialogue: 0,0:25:14.20,0:25:15.46,Default,Crusch,0,0,0,,„Ogień!” – krzyknęłam!
Dialogue: 0,0:25:21.16,0:25:22.39,Default,Subaru,0,0,0,,Crusch!
Dialogue: 0,0:25:45.97,0:25:48.44,Default,Subaru,0,0,0,,Siła woli!
Dialogue: 0,0:25:50.94,0:25:53.60,Default,Subaru,0,0,0,,Cholera... Bycie śmiałkiem to za mało!
Dialogue: 0,0:25:53.69,0:25:54.98,Default,Subaru,0,0,0,,Muszę się zastanowić!
Dialogue: 0,0:25:55.07,0:25:56.46,Default,,0,0,0,,Dlaczego jest ich trzech?
Dialogue: 0,0:25:56.55,0:25:57.52,Default,Crusch,0,0,0,,Schyl się!
Dialogue: 0,0:26:13.80,0:26:14.92,Default,Subaru,0,0,0,,O rany!
Dialogue: 0,0:26:15.06,0:26:17.57,Default,Subaru,0,0,0,,Super!
Dialogue: 0,0:26:19.43,0:26:22.38,Default,Hetaro,0,0,0,,Wszyscy będziemy wspierać Subaru i Crusch
Dialogue: 0,0:26:23.06,0:26:26.14,Default,Hetaro,0,0,0,,póki kapitan nie wyzdrowieje\Ni się nie przegrupujemy.
Dialogue: 0,0:26:26.48,0:26:28.63,Default,Subaru,0,0,0,,Ricardo wciąż żyje?
Dialogue: 0,0:26:28.72,0:26:33.18,Default,Hetaro,0,0,0,,Tak, moja siostra zabrała\Ngo do pana Felixa.
Dialogue: 0,0:26:33.45,0:26:35.40,Default,Mimi,0,0,0,,Namęczył! To nie było łatwe!
Dialogue: 0,0:26:35.49,0:26:38.04,Default,Subaru,0,0,0,,Rozumiem... To ulga.
Dialogue: 0,0:26:38.13,0:26:40.62,Default,Hetaro,0,0,0,,W obliczu śmierci nasz\Nkapitan wysłał wiadomość.
Dialogue: 0,0:26:41.19,0:26:43.08,Default,Hetaro,0,0,0,,„Hej, robi się coraz jaśniej.
Dialogue: 0,0:26:43.17,0:26:46.61,Default,Hetaro,0,0,0,,„To, że nie umarłem, jest tego dowodem!”
Dialogue: 0,0:26:47.25,0:26:48.16,Default,Hetaro,0,0,0,,Tak powiedział.
Dialogue: 0,0:26:48.25,0:26:49.57,Default,Subaru,0,0,0,,„Lżejszy”?
Dialogue: 0,0:26:51.70,0:26:55.67,Default,Subaru,0,0,0,,{\fad(1,178)}Co jest w tej trudnej i\Nciężkiej sytuacji jasnego?
Dialogue: 0,0:26:59.37,0:27:00.30,Default,Subaru,0,0,0,,Światło?
Dialogue: 0,0:27:09.68,0:27:12.70,Default,Subaru,0,0,0,,No właśnie... Teraz rozumiem!
Dialogue: 0,0:27:13.02,0:27:13.93,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:27:21.57,0:27:22.45,Default,,0,0,0,,Co?
Dialogue: 0,0:27:50.56,0:27:51.44,Default,Subaru,0,0,0,,Wilhelm!
Dialogue: 0,0:27:53.66,0:27:55.50,Default,Wilhelm,0,0,0,,Nie ma wystarczających umiejętności.
Dialogue: 0,0:27:55.60,0:27:56.82,Default,,0,0,0,,Byłem nieostrożny...
Dialogue: 0,0:27:57.62,0:27:59.15,Default,Hetaro,0,0,0,,Czy wszystko z nim w porządku?
Dialogue: 0,0:27:59.66,0:28:01.94,Default,Subaru,0,0,0,,Tak, on jest tylko nieprzytomny!
Dialogue: 0,0:28:02.21,0:28:04.34,Default,Subaru,0,0,0,,Przepraszam, ale czy zawieziesz do Felis?
Dialogue: 0,0:28:04.43,0:28:06.29,Default,Hetaro,0,0,0,,Jasne! A ty?
Dialogue: 0,0:28:07.69,0:28:09.70,Default,Subaru,0,0,0,,Zdałem sobie sprawę z jednej rzeczy...
Dialogue: 0,0:28:16.67,0:28:17.90,Default,Crusch,0,0,0,,Rozpadło się?
Dialogue: 0,0:28:18.65,0:28:19.79,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:28:19.88,0:28:21.85,Default,,0,0,0,,Jego siła bojowa i lewe oko
Dialogue: 0,0:28:21.94,0:28:24.03,Default,,0,0,0,,Wilhelm wykłuł\Nmu oko, to przekonało mnie
Dialogue: 0,0:28:24.12,0:28:27.67,Default,Subaru,0,0,0,,Skoro walczyliście z tym\Nproblemem, na pewno to poczuliście.
Dialogue: 0,0:28:28.41,0:28:30.71,Default,Rem,0,0,0,,Byłam całkowicie pochłonięty walką, ale...
Dialogue: 0,0:28:30.80,0:28:31.79,Default,,0,0,0,,Masz rację.
Dialogue: 0,0:28:31.88,0:28:36.00,Default,Crusch,0,0,0,,Zgadzam się z przypuszczeniem, że ten\Nmodel jest słabszy od pierwowzoru.
Dialogue: 0,0:28:36.09,0:28:39.00,Default,Crusch,0,0,0,,Ale co nam to daje?
Dialogue: 0,0:28:39.09,0:28:43.44,Default,Crusch,0,0,0,,Zabicie trzech białych wielorybów to\Nznacznie łatwiej powiedzieć niż zrobić.
Dialogue: 0,0:28:43.97,0:28:46.27,Default,Subaru,0,0,0,,Nie musimy zabijać wszystkich trzech.
Dialogue: 0,0:28:46.36,0:28:48.05,Default,Subaru,0,0,0,,Jedno powinno wystarczyć.
Dialogue: 0,0:28:48.56,0:28:51.25,Default,Subaru,0,0,0,,Ten drań zmusił swoich dwóch do walki,
Dialogue: 0,0:28:51.34,0:28:54.16,Default,Subaru,0,0,0,,podczas gdy sam tam wisi i obserwuje.
Dialogue: 0,0:28:54.76,0:28:57.11,Default,Subaru,0,0,0,,Jak myślisz, co to robi?
Dialogue: 0,0:28:58.66,0:29:00.25,Default,Crusch,0,0,0,,To jest ten prawdziwy?
Dialogue: 0,0:29:00.69,0:29:01.84,Default,Subaru,0,0,0,,Nie zejdzie
Dialogue: 0,0:29:01.93,0:29:04.88,Default,,0,0,0,,ponieważ wie, że nie może\Npozwolić, by go zabito.
Dialogue: 0,0:29:05.58,0:29:06.59,Default,Crusch,0,0,0,,Ale...
Dialogue: 0,0:29:07.99,0:29:11.30,Default,Crusch,0,0,0,,Z tej odległości nie mogę liczyć na to,\Nże trafię mieczem.
Dialogue: 0,0:29:11.81,0:29:14.63,Default,Crusch,0,0,0,,Gdybym miał jedną szansę,\Nto może by się udało...
Dialogue: 0,0:29:15.69,0:29:17.02,Default,Subaru,0,0,0,,Mam plan...
Dialogue: 0,0:29:18.27,0:29:21.33,Default,Subaru,0,0,0,,ale to chyba zbyt ryzykowne posunięcie.
Dialogue: 0,0:29:21.75,0:29:22.92,Default,Subaru,0,0,0,,Chcesz dołączyć?
Dialogue: 0,0:29:34.49,0:29:36.29,Default,Crusch,0,0,0,,Myślę, że oszalałeś.
Dialogue: 0,0:29:36.81,0:29:41.64,Default,Subaru,0,0,0,,Już samo podjęcie się tego ogromnego\Nzadania było szaleństwem.
Dialogue: 0,0:29:43.55,0:29:44.93,Default,Crusch,0,0,0,,Być może.
Dialogue: 0,0:29:45.23,0:29:47.14,Default,,0,0,0,,Nie, masz rację.
Dialogue: 0,0:29:47.23,0:29:49.76,Default,Crusch,0,0,0,,Dotyczy to wszystkich, którzy są tu teraz.
Dialogue: 0,0:29:52.25,0:29:53.38,Default,Guy,0,0,0,,Znikaj!
Dialogue: 0,0:30:00.69,0:30:02.60,Default,Crusch,0,0,0,,Wstrzymamy się z tymi dwoma deblami.
Dialogue: 0,0:30:04.40,0:30:05.86,Default,Crusch,0,0,0,,Przyjmuję twój zakład.
Dialogue: 0,0:30:12.18,0:30:13.78,Default,Guy,0,0,0,,Zbliżają się w tę stronę...
Dialogue: 0,0:30:14.16,0:30:15.12,Default,Guy,0,0,0,,Trzymaj dystans!
Dialogue: 0,0:30:15.62,0:30:16.77,Default,Guy,0,0,0,,Uciekaj!
Dialogue: 0,0:30:17.11,0:30:19.21,Default,Guy,0,0,0,,Zostaniemy zmieceni z powierzchni ziemi...
Dialogue: 0,0:30:46.71,0:30:48.02,Default,Guy,0,0,0,,Crusch!
Dialogue: 0,0:30:51.21,0:30:53.38,Default,Crusch,0,0,0,,Wstańcie! Podnieście głowy!
Dialogue: 0,0:30:53.65,0:30:54.65,Default,,0,0,0,,Chwytajcie za broń!
Dialogue: 0,0:30:55.69,0:30:57.07,Default,Crusch,0,0,0,,Spójrz na tego chłopca.
Dialogue: 0,0:30:57.43,0:30:59.06,Default,Crusch,0,0,0,,Jest taki słaby i delikatny,
Dialogue: 0,0:30:59.15,0:31:01.17,Default,,0,0,0,,zdmuchnąłby go podmuch, a nie ma broni!
Dialogue: 0,0:31:01.65,0:31:05.04,Default,Crusch,0,0,0,,To bezsilny chłopiec, którego porażkę\Nwidziałam na własne oczy!
Dialogue: 0,0:31:05.89,0:31:08.52,Default,Crusch,0,0,0,,Jest słabszy niż ktokolwiek inny tutaj!
Dialogue: 0,0:31:09.32,0:31:11.00,Default,Crusch,0,0,0,,A krzyczy głośniej niż inni
Dialogue: 0,0:31:12.10,0:31:13.72,Default,,0,0,0,,że wciąż możemy to zrobić.
Dialogue: 0,0:31:15.02,0:31:17.83,Default,Crusch,0,0,0,,Jak więc możemy tu siedzieć\Nze spuszczonymi głowami?
Dialogue: 0,0:31:18.43,0:31:21.38,Default,Crusch,0,0,0,,Jeśli nasz najsłabszy\Nczłowiek się nie poddał,
Dialogue: 0,0:31:21.47,0:31:24.38,Default,Crusch,0,0,0,,Godzimy się na klęczenie\Nw obliczu porażki?
Dialogue: 0,0:31:29.57,0:31:31.86,Default,Crusch,0,0,0,,Czy wszyscy dotarliście aż tutaj?
Dialogue: 0,0:31:34.03,0:31:35.78,Default,Crusch,0,0,0,,żeby pogrążać się w wstydzie?!
Dialogue: 0,0:32:04.71,0:32:06.14,Default,Crusch,0,0,0,,Chodź za mną!
Dialogue: 0,0:32:19.82,0:32:24.11,Default,Subaru,0,0,0,,Ma tupet, nazywając mnie\Nmięczakiem i nieudacznikiem...
Dialogue: 0,0:32:26.04,0:32:27.66,Default,Subaru,0,0,0,,Zróbmy to, Rem.
Dialogue: 0,0:32:28.07,0:32:29.17,Default,,0,0,0,,Czas na główny punkt!
Dialogue: 0,0:32:29.26,0:32:30.90,Default,Rem,0,0,0,,No właśnie, Subaru.
Dialogue: 0,0:32:38.84,0:32:39.81,Default - italics,Rem,0,0,0,,Al Huma!
Dialogue: 0,0:32:46.53,0:32:47.41,Default,Rem,0,0,0,,Proszę!
Dialogue: 0,0:32:56.84,0:32:57.90,Default,Crusch,0,0,0,,Liczę na ciebie.
Dialogue: 0,0:32:59.72,0:33:02.56,Default,Subaru,0,0,0,,Hej... Teraz, kiedy widzę cię z bliska,
Dialogue: 0,0:33:02.65,0:33:05.25,Default,,0,0,0,,Naprawdę jesteś przerażający.
Dialogue: 0,0:33:10.42,0:33:12.04,Default,Subaru,0,0,0,,Postaraj się za mną nadążyć.
Dialogue: 0,0:33:12.13,0:33:15.04,Default,Subaru,0,0,0,,Żebyś wiedział, mam opinię kogoś.
Dialogue: 0,0:33:15.13,0:33:17.59,Default,Subaru,0,0,0,,To irytujące, aż nikt nie\Nmoże mnie zignorować!
Dialogue: 0,0:33:22.06,0:33:24.46,Default,Subaru,0,0,0,,No to do dzieła!
Dialogue: 0,0:33:27.15,0:33:30.31,Default,Subaru,0,0,0,,Robię ci ogromną przysługę!\NSłuchaj uważnie!
Dialogue: 0,0:33:30.73,0:33:32.79,Default,Subaru,0,0,0,,To przez ciebie zginął Rem
Dialogue: 0,0:33:32.88,0:33:35.98,Default,Subaru,0,0,0,,i przeżyłem tak straszną traumę!
Dialogue: 0,0:33:45.46,0:33:48.13,Default,Subaru,0,0,0,,Wróciłem!
Dialogue: 0,0:33:59.42,0:34:00.30,Default,Subaru,0,0,0,,Rem!
Dialogue: 0,0:34:00.57,0:34:01.45,Default,Rem,0,0,0,,Tak!
Dialogue: 0,0:34:14.62,0:34:15.84,Default,Subaru,0,0,0,,Uratowałeś mnie...
Dialogue: 0,0:34:15.93,0:34:17.18,Default,Rem,0,0,0,,Dziękuję za poczęstunek.
Dialogue: 0,0:34:17.27,0:34:18.55,Default,Subaru,0,0,0,,O czym ty mówisz?
Dialogue: 0,0:34:27.71,0:34:29.54,Default,Subaru,0,0,0,,Nie zawiedź mnie, Patrasche.
Dialogue: 0,0:34:29.63,0:34:30.92,Default,,0,0,0,,Jesteś smokiem, prawda?
Dialogue: 0,0:34:31.01,0:34:32.92,Default,Subaru,0,0,0,,Pokaż mi, jaki jesteś niesamowity!
Dialogue: 0,0:34:39.99,0:34:41.84,Default,Subaru,0,0,0,,A masz!
Dialogue: 0,0:34:42.15,0:34:43.31,Default,Crusch,0,0,0,,Ogień!
Dialogue: 0,0:35:43.74,0:35:47.41,Default,Wilhelm,0,0,0,,To jest dla mojej żony,\NTheresii van Astrea.
Dialogue: 0,0:36:08.77,0:36:09.86,Default - flashback,Wilhelm,0,0,0,,Wygrałem.
Dialogue: 0,0:36:10.62,0:36:14.20,Default - flashback,Wilhelm,0,0,0,,Jako słabszy szermierz nie masz już\Npowodu, by trzymać miecz.
Dialogue: 0,0:36:14.78,0:36:17.65,Default - flashback,Theresia,0,0,0,,Jeśli ja tego nie zrobię, to kto?
Dialogue: 0,0:36:18.81,0:36:22.68,Default - flashback,Wilhelm,0,0,0,,Znajdę powód, dla którego trzymasz miecz.
Dialogue: 0,0:36:24.61,0:36:25.71,Default - flashback,Wilhelm,0,0,0,,Wystarczy, że
Dialogue: 0,0:36:27.03,0:36:29.63,Default - flashback,Wilhelm,0,0,0,,jest powód, dla którego sięgnąłem po nią.
Dialogue: 0,0:36:34.77,0:36:37.76,Default - flashback,Theresia,0,0,0,,Hej, lubisz kwiaty?
Dialogue: 0,0:36:38.49,0:36:40.06,Default - flashback,Wilhelm,0,0,0,,Już ich nie nienawidzę.
Dialogue: 0,0:36:40.38,0:36:42.41,Default - flashback,Theresia,0,0,0,,Dlaczego dzierżysz ten miecz?
Dialogue: 0,0:36:43.90,0:36:44.90,Default - flashback,Wilhelm,0,0,0,,Aby chronić...
Dialogue: 0,0:36:48.52,0:36:49.68,Default - flashback,Wilhelm,0,0,0,,...ty.
Dialogue: 0,0:36:53.45,0:36:55.74,Default - flashback,Theresia,0,0,0,,Kochasz mnie?
Dialogue: 0,0:36:57.49,0:36:58.37,Default - flashback,Wilhelm,0,0,0,,Wiesz o tym.
Dialogue: 0,0:36:59.91,0:37:02.29,Default - flashback,Theresia,0,0,0,,Czasami wciąż chcę, żebyś to powiedział.
Dialogue: 0,0:37:03.50,0:37:04.69,Default - flashback,Wilhelm,0,0,0,,W porządku.
Dialogue: 0,0:37:05.19,0:37:06.10,Default - flashback,,0,0,0,,Kiedyś...
Dialogue: 0,0:37:07.79,0:37:09.26,Default - flashback,Wilhelm,0,0,0,,Kiedy mam na to ochotę.
Dialogue: 0,0:37:26.64,0:37:29.19,Default,Wilhelm,0,0,0,,Śpij w pokoju wiecznym.
Dialogue: 0,0:37:44.85,0:37:47.29,Default,Wilhelm,0,0,0,,To już koniec, Teresio.
Dialogue: 0,0:37:48.79,0:37:50.00,Default,Wilhelm,0,0,0,,W końcu...
Dialogue: 0,0:37:50.59,0:37:53.38,Default,Wilhelm,0,0,0,,Theresia, ja...
Dialogue: 0,0:37:55.77,0:37:56.65,Default,Wilhelm,0,0,0,,Ja...
Dialogue: 0,0:38:00.93,0:38:04.46,Default,Wilhelm,0,0,0,,Kocham cię!
Dialogue: 0,0:38:11.51,0:38:13.64,Default,Crusch,0,0,0,,Biały Wieloryb upadł!
Dialogue: 0,0:38:14.94,0:38:17.09,Default,Crusch,0,0,0,,Potwór z mgły,
Dialogue: 0,0:38:17.24,0:38:20.24,Default,,0,0,0,,która od czterech stuleci sieje\Npostrach na całym świecie,
Dialogue: 0,0:38:21.13,0:38:25.43,Default,Crusch,0,0,0,,został pokonany przez Wilhelma van Astrea!
Dialogue: 0,0:38:33.42,0:38:36.69,Default,Crusch,0,0,0,,Wygraliśmy tę bitwę!
Dialogue: 0,0:38:57.60,0:38:59.80,Default,Crusch,0,0,0,,Wszystko w porządku, Subaru?
Dialogue: 0,0:39:02.73,0:39:04.90,Default,Subaru,0,0,0,,Tak czy inaczej...
Dialogue: 0,0:39:05.65,0:39:07.82,Default,Subaru,0,0,0,,Cieszę się, że jesteś cała i\Nzdrowa Crusch.
Dialogue: 0,0:39:08.24,0:39:09.51,Default,Crusch,0,0,0,,Tak, jestem.
Dialogue: 0,0:39:09.98,0:39:12.93,Default,Crusch,0,0,0,,Jednak nasze straty nie są małe.
Dialogue: 0,0:39:13.36,0:39:15.19,Default,Crusch,0,0,0,,Wraz z pokonaniem Białego Wieloryba,
Dialogue: 0,0:39:15.28,0:39:17.58,Default,,0,0,0,,Ci, którzy zginęli, nie powrócą.
Dialogue: 0,0:39:21.93,0:39:24.24,Default,Subaru,0,0,0,,Moim zdaniem świetnie ci poszło, Crusch.
Dialogue: 0,0:39:24.93,0:39:27.18,Default,Subaru,0,0,0,,Twoja popularność powinna\Nposzybować w górę—
Dialogue: 0,0:39:27.27,0:39:31.45,Default,Subaru,0,0,0,,Chwila, czy właśnie pomogłem ci w\Nwyborze władcy, choć nie powinienem?
Dialogue: 0,0:39:31.54,0:39:34.10,Default,Crusch,0,0,0,,Masz dość ponure miny.
Dialogue: 0,0:39:34.51,0:39:37.14,Default,Crusch,0,0,0,,Nie wyglądasz na pogromcę\NBiałego Wieloryba.
Dialogue: 0,0:39:37.44,0:39:41.52,Default,Subaru,0,0,0,,Pierwsze, co zrobi Emilia,\Nto nazwie mnie zdrajcą...
Dialogue: 0,0:39:41.97,0:39:43.27,Default,Subaru,0,0,0,,Jak mnie nazwałeś?
Dialogue: 0,0:39:43.79,0:39:46.23,Default,Crusch,0,0,0,,Pogromca Białego Wieloryba.
Dialogue: 0,0:39:46.92,0:39:48.44,Default,Crusch,0,0,0,,Nie chciałabym być
Dialogue: 0,0:39:48.53,0:39:53.26,Default,,0,0,0,,na tyle bezwstydny, by przywłaszczyć\Nsobie twoje osiągnięcie.
Dialogue: 0,0:39:53.81,0:39:55.89,Default,Subaru,0,0,0,,Nie, naprawdę nic nie zrobiłem.
Dialogue: 0,0:40:06.52,0:40:08.98,Default,Subaru,0,0,0,,Chyba masz o mnie lepsze zdanie.
Dialogue: 0,0:40:09.07,0:40:10.01,Default,,0,0,0,,Jestem zaskoczony.
Dialogue: 0,0:40:10.48,0:40:12.26,Default,Crusch,0,0,0,,Nie ma powodu do skromności.
Dialogue: 0,0:40:12.35,0:40:15.16,Default,Crusch,0,0,0,,Szczerze mówiąc, bardzo\Nchętnie bym cię powitał
Dialogue: 0,0:40:15.25,0:40:18.84,Default,,0,0,0,,w moim domu i wynagrodził\Ntwoje osiągnięcia.
Dialogue: 0,0:40:18.93,0:40:20.76,Default,Subaru,0,0,0,,Proszę, nie proś mnie o to!
Dialogue: 0,0:40:20.85,0:40:23.14,Default,Subaru,0,0,0,,Nie chodzi tu o lojalność ani o wierność,
Dialogue: 0,0:40:23.23,0:40:26.31,Default,Subaru,0,0,0,,ale moja wiara już jest dokładnie\Ntam, gdzie powinna.
Dialogue: 0,0:40:28.56,0:40:30.53,Default,Subaru,0,0,0,,Ustanowię Emilię władczynią.
Dialogue: 0,0:40:32.74,0:40:34.13,Default,Subaru,0,0,0,,Nie dla nikogo.
Dialogue: 0,0:40:34.36,0:40:36.01,Default,,0,0,0,,Po prostu właśnie to chcę zrobić.
Dialogue: 0,0:40:40.33,0:40:42.16,Default,Crusch,0,0,0,,Wiedziałam o tym już wcześniej,
Dialogue: 0,0:40:42.77,0:40:44.45,Default,,0,0,0,,ale to wciąż trochę boli.
Dialogue: 0,0:40:46.10,0:40:48.80,Default,Subaru,0,0,0,,Szczerze mówiąc, uważam,\Nże jesteś niesamowitą osobą.
Dialogue: 0,0:40:48.89,0:40:52.68,Default,Subaru,0,0,0,,Gdybym był sam, na pewno\Nprzyjąłbym twoją propozycję.
Dialogue: 0,0:40:53.15,0:40:55.79,Default,Subaru,0,0,0,,Liczę na to, że dotrzymasz\Nwarunków sojuszu.
Dialogue: 0,0:40:55.88,0:40:58.35,Default,Subaru,0,0,0,,Nawet jeśli w końcu staniemy się wrogami,
Dialogue: 0,0:40:58.44,0:41:01.59,Default,Subaru,0,0,0,,Myślę, że do tego czasu damy sobie radę.
Dialogue: 0,0:41:03.31,0:41:06.74,Default,Crusch,0,0,0,,Subaru, pozwól, że sprostuję\Njedno z twoich przekonań.
Dialogue: 0,0:41:08.24,0:41:10.67,Default,Crusch,0,0,0,,Nawet gdybyśmy kiedyś ze sobą walczyli,
Dialogue: 0,0:41:11.14,0:41:14.02,Default,Crusch,0,0,0,,będę ci nadal życzliwy.
Dialogue: 0,0:41:14.50,0:41:17.47,Default,Crusch,0,0,0,,Nawet jeśli przyjdzie nam to\Nkiedyś rozstrzygnąć,
Dialogue: 0,0:41:17.56,0:41:20.49,Default,Crusch,0,0,0,,nie zapomnę o długu,\Nktóry dziś zaciągnęłam.
Dialogue: 0,0:41:21.02,0:41:23.45,Default,Crusch,0,0,0,,Dlatego nawet jeśli staniemy się wrogami,
Dialogue: 0,0:41:24.00,0:41:28.42,Default,Crusch,0,0,0,,będę cię szanować i\Nokazywać ci łaskę aż do końca.
Dialogue: 0,0:41:35.97,0:41:39.11,Default,Subaru,0,0,0,,Gdybym nie miał już w sercu numeru 1 i 2,
Dialogue: 0,0:41:39.20,0:41:41.10,Default,Subaru,0,0,0,,to mogło się źle skończyć.
Dialogue: 0,0:41:43.14,0:41:46.71,Default,Crusch,0,0,0,,Nie myślę o tobie jak o kobiecie.
Dialogue: 0,0:41:47.25,0:41:50.47,Default,Crusch,0,0,0,,Nie zaprzeczam, że momentami\Ncoś poruszało mnie do głębi,
Dialogue: 0,0:41:50.65,0:41:53.62,Default,Crusch,0,0,0,,ale moje serce spoczywa na\Nkońcu mojego snu.
Dialogue: 0,0:42:02.68,0:42:03.71,Default,Crusch,0,0,0,,A teraz...
Dialogue: 0,0:42:04.32,0:42:05.61,Default,Crusch,0,0,0,,Wychodzę
Dialogue: 0,0:42:05.70,0:42:09.68,Default,Crusch,0,0,0,,aby przewieźć naszych rannych\Noraz zwłoki Białego Wieloryba do stolicy.
Dialogue: 0,0:42:10.45,0:42:13.89,Default,Crusch,0,0,0,,Wygląda jednak na to, że wciąż\Nmasz coś do załatwienia.
Dialogue: 0,0:42:14.13,0:42:15.01,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:42:15.39,0:42:16.48,Default,Subaru,0,0,0,,Może to zabrzmi źle,
Dialogue: 0,0:42:16.72,0:42:19.59,Default,,0,0,0,,ale właśnie o to chodziło w tym\Npolowaniu na wieloryby.
Dialogue: 0,0:42:19.70,0:42:20.58,Default,Crusch,0,0,0,,Tak?
Dialogue: 0,0:42:20.67,0:42:23.09,Default,Crusch,0,0,0,,Pokonanie Wieloryba miało\Ndrugorzędne znaczenie?
Dialogue: 0,0:42:23.18,0:42:24.27,Default,Crusch,0,0,0,,Intrygujące.
Dialogue: 0,0:42:25.58,0:42:26.58,Default,Crusch,0,0,0,,Potrzebujesz pomocy?
Dialogue: 0,0:42:26.95,0:42:28.00,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:42:28.63,0:42:29.52,Default,Subaru,0,0,0,,Ale...
Dialogue: 0,0:42:30.16,0:42:33.17,Default,Subaru,0,0,0,,Nie spodziewałem się, że to polowanie\Nwywoła takie skutki.
Dialogue: 0,0:42:34.48,0:42:35.36,Default,Subaru,0,0,0,,Co więcej
Dialogue: 0,0:42:35.51,0:42:39.26,Default,Wilhelm,0,0,0,,Skoro tak, to czemu by nie skorzystać\Nz pomocy tego staruszka?
Dialogue: 0,0:42:43.28,0:42:44.67,Default,Wilhelm,0,0,0,,Panie Subaru,
Dialogue: 0,0:42:45.75,0:42:47.29,Default,Wilhelm,0,0,0,,wraz z tym podporządkowaniem,
Dialogue: 0,0:42:47.91,0:42:52.50,Default,Wilhelm,0,0,0,,to dzięki tobie udało mi się\Nzrealizować swój plan
Dialogue: 0,0:42:52.74,0:42:54.44,Default,,0,0,0,,za to, że przeżyłem ten cały czas.
Dialogue: 0,0:42:54.63,0:42:55.85,Default,Wilhelm,0,0,0,,Dziękuję...
Dialogue: 0,0:42:56.31,0:42:57.26,Default,Wilhelm,0,0,0,,Dziękuję.
Dialogue: 0,0:42:58.60,0:43:02.22,Default,Wilhelm,0,0,0,,Dziękuję wam z całego serca!
Dialogue: 0,0:43:06.00,0:43:09.28,Default,Subaru,0,0,0,,To dzięki twojej sile udało się to\Nosiągnąć, panie Wilhelm.
Dialogue: 0,0:43:09.84,0:43:13.75,Default,Subaru,0,0,0,,Powód, dlaczego chciałem pokonać Wieloryba\Ni walczyłem, nie poddając się...
Dialogue: 0,0:43:14.29,0:43:16.66,Default,Subaru,0,0,0,,Nie wiem, czy można to tak\Npowiedzieć, ale...
Dialogue: 0,0:43:17.22,0:43:18.53,Default,Subaru,0,0,0,,Gratulacje.
Dialogue: 0,0:43:18.85,0:43:21.36,Default,Subaru,0,0,0,,I dziękuję za Państwa służbę.
Dialogue: 0,0:43:22.29,0:43:26.02,Default,Subaru,0,0,0,,Myślę, że udało ci się to, bo kochałeś\Nswoją żonę z całego serca.
Dialogue: 0,0:43:28.48,0:43:29.63,Default,Wilhelm,0,0,0,,Dziękuję...
Dialogue: 0,0:43:34.90,0:43:38.79,Default,Crusch,0,0,0,,Powinieneś jeszcze przez jakiś\Nczas zatrzymać ten cenny miecz.
Dialogue: 0,0:43:39.41,0:43:42.01,Default,Crusch,0,0,0,,W najbliższych dniach brak\Nbroni niewiele ci pomoże.
Dialogue: 0,0:43:42.19,0:43:43.69,Default,Wilhelm,0,0,0,,Tak, pani. Dziękuję.
Dialogue: 0,0:43:44.05,0:43:47.11,Default,Crusch,0,0,0,,Zabierz Felis i połowę tych,\Nktórzy nie odnieśli obrażeń.
Dialogue: 0,0:43:47.56,0:43:49.29,Default,Crusch,0,0,0,,Powinno ich być około dwudziestu.
Dialogue: 0,0:43:49.38,0:43:50.26,Default,Subaru,0,0,0,,Jesteś pewien?
Dialogue: 0,0:43:50.83,0:43:53.33,Default,Crusch,0,0,0,,Mówiłam, że nie będę\Nzachowywać się bezwstydnie.
Dialogue: 0,0:43:53.84,0:43:55.32,Default,Crusch,0,0,0,,I że będę cię szanować.
Dialogue: 0,0:44:00.26,0:44:01.26,Default,Subaru,0,0,0,,Dziękuję.
Dialogue: 0,0:44:05.74,0:44:06.70,Default,Rem,0,0,0,,Dlaczego?
Dialogue: 0,0:44:07.12,0:44:09.09,Default,Felix,0,0,0,,Nie możesz się ruszyć, prawda?
Dialogue: 0,0:44:11.14,0:44:14.59,Default,Felix,0,0,0,,Znając się na magiu leczenia nie\Nmogę pozwolić, żebyś się przemęczał!
Dialogue: 0,0:44:14.95,0:44:16.04,Default,Felix,0,0,0,,Zostaniesz tu—
Dialogue: 0,0:44:16.13,0:44:17.01,Default,Rem,0,0,0,,Ale...
Dialogue: 0,0:44:17.38,0:44:18.69,Default,Subaru,0,0,0,,Uważaj!
Dialogue: 0,0:44:19.44,0:44:22.60,Default,Subaru,0,0,0,,Proszę, słuchaj Felis i nie przesadzaj.
Dialogue: 0,0:44:22.69,0:44:23.90,Default,Rem,0,0,0,,Nie zrobię tego.
Dialogue: 0,0:44:23.99,0:44:26.23,Default,,0,0,0,,To zbyt bolesne... Nie mogę tego znieść.
Dialogue: 0,0:44:26.70,0:44:28.56,Default,Rem,0,0,0,,Kiedy będą kłopoty,
Dialogue: 0,0:44:28.65,0:44:31.89,Default,,0,0,0,,chcę być pierwszym,\Nktóry się z Tobą skontaktuje.
Dialogue: 0,0:44:32.49,0:44:35.52,Default,Rem,0,0,0,,To wszystko, czego pragnę! Proszę więc...
Dialogue: 0,0:44:35.61,0:44:37.63,Default,Subaru,0,0,0,,W takim razie nie musisz się martwić.
Dialogue: 0,0:44:39.53,0:44:42.37,Default,Subaru,0,0,0,,Uratowałeś mnie już tyle razy.
Dialogue: 0,0:44:43.83,0:44:48.29,Default,Subaru,0,0,0,,Czy nie zdajesz sobie sprawy,\Njak wiele dla mnie do tej pory zrobiłeś?
Dialogue: 0,0:44:48.52,0:44:51.49,Default,Subaru,0,0,0,,Chciałbym, żebyś mi\Npomagał również od teraz.
Dialogue: 0,0:44:51.82,0:44:54.58,Default,Subaru,0,0,0,,{\fad(1,888)}Więc tym razem zostaw wszystko mnie.
Dialogue: 0,0:44:56.95,0:45:00.05,Default,Rem,0,0,0,,Czy po tym wszystkim nadal\Nbędę mogła być przy Tobie?
Dialogue: 0,0:45:01.65,0:45:03.80,Default,Subaru,0,0,0,,To ja powinienem cię o to błagać.
Dialogue: 0,0:45:07.53,0:45:09.40,Default,Rem,0,0,0,,Uznam to za obietnicę.
Dialogue: 0,0:45:10.03,0:45:12.16,Default,Rem,0,0,0,,Nie możesz się już wycofać.
Dialogue: 0,0:45:17.19,0:45:18.92,Default,Subaru,0,0,0,,Wszystko będzie dobrze, Rem.
Dialogue: 0,0:45:19.01,0:45:21.31,Default,Subaru,0,0,0,,Znajdę sposób, żeby wszystko załatwić!
Dialogue: 0,0:45:21.95,0:45:23.85,Default,Subaru,0,0,0,,Jestem twoim bohaterem!
Dialogue: 0,0:45:24.11,0:45:26.50,Default,Subaru,0,0,0,,Postanowiłem zrobić ten pierwszy krok!
Dialogue: 0,0:45:27.10,0:45:28.58,Default,Subaru,0,0,0,,Ale nie musisz się martwić!
Dialogue: 0,0:45:29.05,0:45:31.27,Default,Subaru,0,0,0,,Udało mi się wykonać\Npolowanie na wieloryby.
Dialogue: 0,0:45:31.36,0:45:34.67,Default,Subaru,0,0,0,,W tej chwili twój bohater\Njest fanatyczny jak demon.
Dialogue: 0,0:45:35.70,0:45:37.02,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:45:42.22,0:45:43.14,Default,Rem,0,0,0,,W porządku!
Dialogue: 0,0:45:43.96,0:45:47.57,Default,Rem,0,0,0,,Mój bohater jest najlepszy na świecie!
Dialogue: 0,0:46:06.90,0:46:11.66,Default,Ricardo,0,0,0,,Stary, naprawdę trafiłeś na\Nsame najlepsze fragmenty, wiesz?
Dialogue: 0,0:46:12.01,0:46:14.12,Default,Mimi,0,0,0,,Kapitanie... Mimi też! Mimi też!
Dialogue: 0,0:46:14.21,0:46:16.41,Default,Mimi,0,0,0,,Wyszło mi naprawdę świetnie!
Dialogue: 0,0:46:16.67,0:46:18.77,Default,Subaru,0,0,0,,Czy nie otarłeś się o śmierć?
Dialogue: 0,0:46:18.86,0:46:21.50,Default,Subaru,0,0,0,,Poza tym twój brat był wyczerpany.
Dialogue: 0,0:46:21.59,0:46:23.45,Default,,0,0,0,,Skąd bierzesz tyle energii?
Dialogue: 0,0:46:23.54,0:46:26.01,Default,Mimi,0,0,0,,Hetaro to jeszcze maluch. Jest słaby.
Dialogue: 0,0:46:26.10,0:46:28.59,Default,Mimi,0,0,0,,Naprawdę, to takie żałosne...
Dialogue: 0,0:46:29.04,0:46:32.19,Default,Ricardo,0,0,0,,W dalszej części walki z Wielorybem\Nnie udało mi się zbyt wiele,
Dialogue: 0,0:46:32.28,0:46:33.79,Default,Ricardo,0,0,0,,ale nie martw się.
Dialogue: 0,0:46:33.88,0:46:36.51,Default,Ricardo,0,0,0,,W końcu moja pani poprosiła\Nmnie o przysługę.
Dialogue: 0,0:46:36.60,0:46:39.60,Default,Ricardo,0,0,0,,W prawdziwej walce, która będzie,\Npokażę ci, na co mnie stać.
Dialogue: 0,0:46:39.81,0:46:41.11,Default,Subaru,0,0,0,,Prawdziwa walka?
Dialogue: 0,0:46:41.20,0:46:42.56,Default,,0,0,0,,Co ty tu próbujesz zrobić?
Dialogue: 0,0:46:42.76,0:46:44.78,Default,Ricardo,0,0,0,,Zmierzycie się z Kultem Czarownicy?
Dialogue: 0,0:46:46.26,0:46:49.29,Default,Ricardo,0,0,0,,Nie lekceważ sieci\Ninformacji o sprzedawcach.
Dialogue: 0,0:46:49.38,0:46:50.70,Default,Ricardo,0,0,0,,Ach, oto nadchodzą.
Dialogue: 0,0:46:55.30,0:46:57.55,Default,Ricardo,0,0,0,,To połowa naszej grupy najemników.
Dialogue: 0,0:46:57.64,0:46:58.71,Default,Subaru,0,0,0,,Połowa?
Dialogue: 0,0:46:58.93,0:47:01.84,Default,Ricardo,0,0,0,,Połowa z nich została wysłana,\Nby zablokować drogę,
Dialogue: 0,0:47:01.93,0:47:04.21,Default,,0,0,0,,zamiast walczyć z Wielorybem.
Dialogue: 0,0:47:04.67,0:47:07.06,Default,Subaru,0,0,0,,Czy oni nam też pomogą?
Dialogue: 0,0:47:07.15,0:47:08.67,Default,Subaru,0,0,0,,Kto nimi kieruje?
Dialogue: 0,0:47:08.88,0:47:11.39,Default,Mimi,0,0,0,,Mój młodszy brat, Tivey!
Dialogue: 0,0:47:11.67,0:47:13.79,Default,Subaru,0,0,0,,Masz jeszcze jednego młodszego brata?
Dialogue: 0,0:47:14.01,0:47:18.15,Default,Subaru,0,0,0,,Naprawdę ciekawi mnie, czy jest bardziej\Npodobny do ciebie, czy do Hetaro.
Dialogue: 0,0:47:24.10,0:47:25.44,Default,Mimi,0,0,0,,Hej!
Dialogue: 0,0:47:30.33,0:47:32.45,Default - italics,Subaru,0,0,0,,Dlaczego on z nimi jest?
Dialogue: 0,0:47:34.95,0:47:39.96,Episode Title,Title,0,0,0,,Demonstruje sprzeciw
