Dialogue: 0,0:00:05.10,0:00:07.59,Default,Subaru,0,0,0,,Otwórz drzwi! Wypuść mnie stąd!
Dialogue: 0,0:00:07.68,0:00:09.15,Default,Subaru,0,0,0,,Otwórz drzwi!
Dialogue: 0,0:00:11.68,0:00:13.28,Default,Beatrice,0,0,0,,Już za późno.
Dialogue: 0,0:00:14.44,0:00:16.19,Default,Subaru,0,0,0,,Jeszcze {\i1}nie{\i0} jest za późno!
Dialogue: 0,0:00:16.28,0:00:17.86,Default,Subaru,0,0,0,,Muszę szybko dotrzeć do Rem!
Dialogue: 0,0:00:17.95,0:00:20.57,Default,Beatrice,0,0,0,,Twój powód powrotu do tego pokoju,
Dialogue: 0,0:00:20.66,0:00:22.78,Default,Beatrice,0,0,0,,zniknął, jak sądzę.
Dialogue: 0,0:00:35.74,0:00:38.47,Default,Subaru,0,0,0,,Do diabła z tym!
Dialogue: 0,0:00:41.12,0:00:44.63,Default,Subaru,0,0,0,,Dlaczego próbujesz mnie uratować?!
Dialogue: 0,0:00:45.48,0:00:48.52,Default,Beatrice,0,0,0,,Bo wyglądasz tak żałośnie, że nie mogę na\Nciebie patrzeć.
Dialogue: 0,0:00:49.12,0:00:51.07,Default,Subaru,0,0,0,,Ale dlaczego ja?!
Dialogue: 0,0:00:51.16,0:00:52.99,Default,Subaru,0,0,0,,Jeśli naprawdę chcesz kogoś ocalić,
Dialogue: 0,0:00:53.53,0:00:55.03,Default,Subaru,0,0,0,,Dlaczego ich nie uratujesz?!
Dialogue: 0,0:00:55.41,0:00:57.55,Default,Subaru,0,0,0,,Mogłaś to zrobić!
Dialogue: 0,0:00:57.64,0:01:00.74,Default,Beatrice,0,0,0,,Dlaczego miałabym to robić?
Dialogue: 0,0:01:01.47,0:01:05.76,Default,Beatrice,0,0,0,,Nie mam żadnego powodu,\Nby kogoś ratować.
Dialogue: 0,0:01:05.85,0:01:09.96,Default,Subaru,0,0,0,,Więc... Ty też nie masz\Npowodu, by mnie ratować!
Dialogue: 0,0:01:10.53,0:01:13.83,Default,Subaru,0,0,0,,Kto cię prosił, żebyś mnie ratowała?!
Dialogue: 0,0:01:15.89,0:01:18.79,Default,Subaru,0,0,0,,Masz pojęcie, co zrobiłaś?!
Dialogue: 0,0:01:18.88,0:01:22.22,Default,Subaru,0,0,0,,Przez ciebie wszystko może legnąć w\Ngruzach!
Dialogue: 0,0:01:22.31,0:01:23.96,Default,Subaru,0,0,0,,Wszystko będzie napisane na nowo.
Dialogue: 0,0:01:24.24,0:01:27.09,Default,Subaru,0,0,0,,a ta okropna teraźniejszość zostanie\Nutrwalona na zawsze!
Dialogue: 0,0:01:27.64,0:01:30.82,Default,Subaru,0,0,0,,Powinnaś była mnie zabić!
Dialogue: 0,0:01:35.27,0:01:36.15,Default,Beatrice,0,0,0,,Nie rozumiem.
Dialogue: 0,0:01:37.57,0:01:38.86,Default,Beatrice,0,0,0,,Nie rozumiem!
Dialogue: 0,0:01:39.77,0:01:40.95,Default,Subaru,0,0,0,,W porządku.
Dialogue: 0,0:01:41.25,0:01:43.87,Default,Subaru,0,0,0,,Jeśli nie pomożesz...
Dialogue: 0,0:01:46.41,0:01:47.29,Default,Beatrice,0,0,0,,Nie!
Dialogue: 0,0:01:50.11,0:01:51.75,Default,Subaru,0,0,0,,Dlaczego... ty...
Dialogue: 0,0:01:51.84,0:01:53.43,Default,Beatrice,0,0,0,,Nie pozwolę ci, jak sądzę!
Dialogue: 0,0:01:53.52,0:01:55.57,Default,Beatrice,0,0,0,,Nie pozwolę ci tu umrzeć!
Dialogue: 0,0:01:55.66,0:01:57.51,Default,Subaru,0,0,0,,Puść mnie!
Dialogue: 0,0:02:09.76,0:02:12.83,Default,Subaru,0,0,0,,Dlaczego... to tutaj?
Dialogue: 0,0:02:24.72,0:02:25.77,Default,Subaru,0,0,0,,Dlaczego?
Dialogue: 0,0:02:26.60,0:02:30.71,Default,Subaru,0,0,0,,Dlaczego trzymasz tę książkę, jakby była\Ntak cenna?
Dialogue: 0,0:02:32.07,0:02:36.94,Default,Subaru,0,0,0,,To nie ta sama książka, którą mieli\Nwyznawcy Kultu Czarownicy... prawda?
Dialogue: 0,0:02:37.88,0:02:39.82,Default,Subaru,0,0,0,,Tylko wygląda tak samo, prawda?
Dialogue: 0,0:02:41.15,0:02:44.85,Default,Subaru,0,0,0,,Dlaczego temu nie zaprzeczasz?
Dialogue: 0,0:02:45.90,0:02:50.06,Default,Beatrice,0,0,0,,Nie mam rozkazu\Nodpowiadać na to pytanie.
Dialogue: 0,0:02:51.19,0:02:53.43,Default,Subaru,0,0,0,,Co jest napisane w tej książce?
Dialogue: 0,0:02:53.80,0:02:54.92,Default,Subaru,0,0,0,,Co ci mówi?
Dialogue: 0,0:02:55.01,0:02:57.32,Default,Beatrice,0,0,0,,To pytanie też nie jest w książce.
Dialogue: 0,0:02:57.80,0:03:00.45,Default,Subaru,0,0,0,,Nie wolno ci robić niczego,\Nco nie jest w książce?!
Dialogue: 0,0:03:00.54,0:03:03.11,Default,Subaru,0,0,0,,A kiedy wcześniej mnie osłoniłaś...
Dialogue: 0,0:03:03.20,0:03:05.26,Default,Beatrice,0,0,0,,Tego pytania też tu nie ma.
Dialogue: 0,0:03:05.35,0:03:07.72,Default,Subaru,0,0,0,,Więc dlaczego mówisz do mnie teraz?!
Dialogue: 0,0:03:07.81,0:03:09.81,Default,Subaru,0,0,0,,Czemu ocaliłaś mnie od śmierci?!
Dialogue: 0,0:03:09.90,0:03:10.78,Default,Beatrice,0,0,0,,Nie wiem!
Dialogue: 0,0:03:10.90,0:03:15.71,Default,Subaru,0,0,0,,Nie możesz zrobić niczego,\Nco nie jest napisane w tej książce?!
Dialogue: 0,0:03:15.80,0:03:17.10,Default,Beatrice,0,0,0,,Tak, przypuszczam!
Dialogue: 0,0:03:17.60,0:03:18.74,Default,Beatrice,0,0,0,,Tak, to prawda.
Dialogue: 0,0:03:19.24,0:03:22.80,Default,Beatrice,0,0,0,,Wszystko co robię jest zgodne z\Nprzewodnictwem Ewangelii, przypuszczam!
Dialogue: 0,0:03:23.24,0:03:25.79,Default,Beatrice,0,0,0,,To jest sens mojego życia!
Dialogue: 0,0:03:25.88,0:03:28.42,Default,Beatrice,0,0,0,,To jest cel mojego istnienia!
Dialogue: 0,0:03:29.14,0:03:34.39,Default,Subaru,0,0,0,,Próbowałaś mnie uratować, bo książka ci\Nkazała?
Dialogue: 0,0:03:34.48,0:03:36.63,Default,Subaru,0,0,0,,I wtedy, gdy uratowałaś mnie po klątwie,
Dialogue: 0,0:03:36.72,0:03:39.32,Default,Subaru,0,0,0,,i gdy mi pomogłaś, kiedy\Nnie mogłem nawet stanąć?!
Dialogue: 0,0:03:39.41,0:03:43.05,Default,Subaru,0,0,0,,Gdy razem się wygłupialiśmy, kłócąc\Nsię i zachowując jak durnie...
Dialogue: 0,0:03:43.14,0:03:44.28,Default,Beatrice,0,0,0,,Mówiłam ci!
Dialogue: 0,0:03:44.59,0:03:46.62,Default,Beatrice,0,0,0,,Tak, to dlatego, przypuszczam!
Dialogue: 0,0:03:46.71,0:03:50.43,Default,Beatrice,0,0,0,,Wszystko co zrobiłam, wszystko co\Nwidziałam, wszystko co powiedziałam...
Dialogue: 0,0:03:50.52,0:03:53.19,Default,Beatrice,0,0,0,,Wszystko było zapisane w tej książce!
Dialogue: 0,0:03:53.28,0:03:57.17,Default,Beatrice,0,0,0,,Jakbyś mógł poruszyć moim\Nsercem sam, jak sądzę!
Dialogue: 0,0:03:57.26,0:03:59.36,Default,Beatrice,0,0,0,,Nie bądź taki zadufany w sobie, człowieku!
Dialogue: 0,0:03:59.64,0:04:02.46,Default,Beatrice,0,0,0,,Wszystko, co robię, robię dla Matki!
Dialogue: 0,0:04:02.55,0:04:04.50,Default,Beatrice,0,0,0,,Jesteś po prostu... po prostu...
Dialogue: 0,0:04:05.02,0:04:06.26,Default,Beatrice,0,0,0,,Człowiek! Człowiek!
Dialogue: 0,0:04:06.60,0:04:07.48,Default,Beatrice,0,0,0,,Człowiek!
Dialogue: 0,0:04:16.54,0:04:18.57,Default,Beatrice,0,0,0,,Nie dotykaj mnie, człowieku!
Dialogue: 0,0:04:18.66,0:04:20.86,Default,Beatrice,0,0,0,,Nawet cię nie znam, człowieku!
Dialogue: 0,0:04:20.95,0:04:22.50,Default,Beatrice,0,0,0,,Nienawidzę cię! Nienawidzę cię!
Dialogue: 0,0:04:22.66,0:04:24.18,Default,Beatrice,0,0,0,,{\i1}Nienawidzę{\i0} cię!
Dialogue: 0,0:04:31.30,0:04:35.09,Default,Beatrice,0,0,0,,Wtedy... byłam taka szczęśliwa...
Dialogue: 0,0:04:38.87,0:04:40.38,Default,Elsa,0,0,0,,Co za szkoda.
Dialogue: 0,0:04:49.52,0:04:50.40,Default,Elsa,0,0,0,,Och?
Dialogue: 0,0:04:50.49,0:04:52.41,Default,Subaru,0,0,0,,...ea...tri...
Dialogue: 0,0:04:53.49,0:04:56.65,Default,Elsa,0,0,0,,To wspaniale, naprawdę\Nsię o ciebie troszczy.
Dialogue: 0,0:05:22.16,0:05:23.46,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:05:29.42,0:05:32.11,Default,Subaru,0,0,0,,Mój punkt powrotu się nie zmienił.
Dialogue: 0,0:05:32.87,0:05:34.48,Default,Subaru,0,0,0,,To już trzeci raz.
Dialogue: 0,0:05:36.41,0:05:37.29,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:05:37.38,0:05:40.51,Default,Emilia,0,0,0,,Nie, mylisz się, to nie ja!
Dialogue: 0,0:05:40.60,0:05:43.34,Default,Emilia,0,0,0,,Pomóż mi, Puck... Puck...
Dialogue: 0,0:05:38.60,0:05:40.81,Default,Subaru,0,0,0,,Emilia, bądź silna!
Dialogue: 0,0:05:40.90,0:05:41.83,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:05:42.23,0:05:43.35,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:05:48.10,0:05:49.22,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:06:07.50,0:06:09.25,Default,Emilia,0,0,0,,Przepraszam, Subaru.
Dialogue: 0,0:06:09.67,0:06:11.85,Default,Emilia,0,0,0,,za to, że straciłam spokój.
Dialogue: 0,0:06:12.09,0:06:13.97,Default,Subaru,0,0,0,,Hej, wszystko w porządku.
Dialogue: 0,0:06:14.48,0:06:16.09,Default,Emilia,0,0,0,,Ale ja...
Dialogue: 0,0:06:16.68,0:06:19.65,Default,Subaru,0,0,0,,Odpocznij na dziś, porozmawiamy jutro.
Dialogue: 0,0:06:22.09,0:06:22.97,Default,Emilia,0,0,0,,Tak.
Dialogue: 0,0:06:25.44,0:06:27.87,Default,Subaru,0,0,0,,Ram, zaopiekuj się Emilią.
Dialogue: 0,0:06:34.70,0:06:37.23,Default,Subaru,0,0,0,,Pozostała tylko rozmowa z Roswaalem.
Dialogue: 0,0:06:38.94,0:06:40.22,Default,Otto,0,0,0,,{\an8}Natsuki?
Dialogue: 0,0:06:37.23,0:06:40.83,Default,Subaru,0,0,0,,Muszę zapytać go o Beatrice,\Nbo ostatnio nie mogłem.
Dialogue: 0,0:06:40.92,0:06:43.00,Default,Otto,0,0,0,,Natsuki, słuchasz mnie?
Dialogue: 0,0:06:41.88,0:06:43.00,Default,Subaru,0,0,0,,I... co?
Dialogue: 0,0:06:43.52,0:06:45.66,Default,Otto,0,0,0,,Natsuki, wszystko w porządku?
Dialogue: 0,0:06:45.75,0:06:46.63,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:06:46.93,0:06:50.86,Default,Subaru,0,0,0,,Tak, oczywiście! Czuję się świetnie!\NWłaściwie doskonale!
Dialogue: 0,0:06:50.95,0:06:52.95,Default,Subaru,0,0,0,,Czy wyglądam, jakby coś było nie tak?
Dialogue: 0,0:06:53.48,0:06:56.16,Default,Otto,0,0,0,,Nie, nic nie wygląda źle.
Dialogue: 0,0:06:56.25,0:06:58.19,Default,Otto,0,0,0,,Wydajesz się być bardzo spokojny.
Dialogue: 0,0:06:58.28,0:06:59.72,Default,Subaru,0,0,0,,Tak?
Dialogue: 0,0:06:59.81,0:07:02.72,Default,Otto,0,0,0,,Nawet z Emilią w jej obecnym stanie.
Dialogue: 0,0:07:03.54,0:07:06.79,Default,Otto,0,0,0,,Czy niesłusznie uważam twój spokój za\Nniepokojący?
Dialogue: 0,0:07:08.39,0:07:12.35,Default,Subaru,0,0,0,,Myślisz, że jestem teraz zbyt spokojny?
Dialogue: 0,0:07:12.44,0:07:15.53,Default,Otto,0,0,0,,Nie sądzę, żeby to było złe.
Dialogue: 0,0:07:15.72,0:07:16.60,Default,Otto,0,0,0,,Ale...
Dialogue: 0,0:07:18.74,0:07:21.99,Default,Subaru,0,0,0,,Nie, dzięki tobie jestem teraz bardziej\Npewny siebie.
Dialogue: 0,0:07:22.08,0:07:23.42,Default,Subaru,0,0,0,,Dzięki, Otto.
Dialogue: 0,0:07:23.80,0:07:24.68,Default,Otto,0,0,0,,Co?
Dialogue: 0,0:07:24.77,0:07:26.15,Default,Subaru,0,0,0,,To dowodzi, że nadal umiem
Dialogue: 0,0:07:26.24,0:07:29.56,Default,Subaru,0,0,0,,myśleć racjonalnie,\Nnawet po tym wszystkim.
Dialogue: 0,0:07:29.65,0:07:34.37,Default,Otto,0,0,0,,Nie, ale moim zdaniem jest ogromna różnica\Nmiędzy spokojnym wyglądem
Dialogue: 0,0:07:34.46,0:07:38.10,Default,Otto,0,0,0,,a racjonalnym myśleniem o sytuacji...
Dialogue: 0,0:07:38.19,0:07:40.56,Default,Subaru,0,0,0,,Mówimy o Roswaalu.
Dialogue: 0,0:07:40.65,0:07:43.16,Default,Subaru,0,0,0,,Nie mogę pozwolić mu tym\Nrazem unikać tematu.
Dialogue: 0,0:07:43.56,0:07:45.15,Default,Garfiel,0,0,0,,Masz chwilkę?
Dialogue: 0,0:07:45.71,0:07:47.06,Default,Subaru,0,0,0,,Garfiel?
Dialogue: 0,0:07:47.71,0:07:50.76,Default,Subaru,0,0,0,,Niełatwo wpadasz w schematy, co?
Dialogue: 0,0:07:50.85,0:07:51.73,Default,Garfiel,0,0,0,,Co?
Dialogue: 0,0:07:51.82,0:07:55.74,Default,Subaru,0,0,0,,Ostatnim razem wróciłbyś od razu, gdybym\Ncię nie powstrzymał.
Dialogue: 0,0:07:55.83,0:07:57.95,Default,Subaru,0,0,0,,Mam coś ważnego do zrobienia.
Dialogue: 0,0:07:58.24,0:08:01.75,Default,Garfiel,0,0,0,,Mówisz o swoim podejrzanym\Nplanie z tym draniem?
Dialogue: 0,0:08:01.84,0:08:04.07,Default,Subaru,0,0,0,,Nie nazywaj tego podejrzanym planem!
Dialogue: 0,0:08:04.16,0:08:05.56,Default,Subaru,0,0,0,,Więc czego chciałeś?
Dialogue: 0,0:08:05.65,0:08:07.21,Default,Subaru,0,0,0,,Chodzi o Sanktuarium?
Dialogue: 0,0:08:07.63,0:08:11.34,Default,Garfiel,0,0,0,,Myślisz, że o czym jeszcze\Nchciałbym z tobą porozmawiać?
Dialogue: 0,0:08:11.98,0:08:14.88,Default,Subaru,0,0,0,,Może chcesz informacji o Ram.
Dialogue: 0,0:08:14.97,0:08:17.94,Default,Subaru,0,0,0,,Ona woli wysokich facetów,\Nktórzy noszą makijaż klauna.
Dialogue: 0,0:08:18.03,0:08:21.02,Default,Garfiel,0,0,0,,Przestań, przygnębiasz mnie!
Dialogue: 0,0:08:21.48,0:08:25.15,Default,Subaru,0,0,0,,W takim razie idziemy porozmawiać o naszym\Nżyciu uczuciowym!
Dialogue: 0,0:08:25.24,0:08:26.52,Default,Otto,0,0,0,,Natsuki... ale...
Dialogue: 0,0:08:27.03,0:08:29.61,Default,Subaru,0,0,0,,Daj spokój, Otto. Zostaw to\Nna jutro, dobrze?
Dialogue: 0,0:08:30.03,0:08:32.21,Default,Otto,0,0,0,,W porządku.
Dialogue: 0,0:08:32.30,0:08:36.14,Default,Otto,0,0,0,,Liczę, że jutro zajmiesz się margrabią.
Dialogue: 0,0:08:41.16,0:08:43.46,Default,Garfiel,0,0,0,,Nie tutaj. Chodź za mną.
Dialogue: 0,0:08:44.74,0:08:47.46,Default,Subaru,0,0,0,,Kolejna zmiana biegu wydarzeń?
Dialogue: 0,0:08:55.56,0:08:56.83,Default,Subaru,0,0,0,,Więc...
Dialogue: 0,0:08:56.92,0:08:59.44,Default,Subaru,0,0,0,,Ile czasu minęło, odkąd widziałeś\NFredericę?
Dialogue: 0,0:08:59.53,0:09:03.23,Default,Garfiel,0,0,0,,I dlaczego mam ci to mówić?
Dialogue: 0,0:09:03.56,0:09:05.67,Default,Subaru,0,0,0,,Pomyślałem, że nie zaszkodzi zapytać.
Dialogue: 0,0:09:05.76,0:09:08.69,Default,Garfiel,0,0,0,,Ha! Już dawno stąd odeszła.
Dialogue: 0,0:09:09.11,0:09:10.56,Default,Garfiel,0,0,0,,Ona nie jest już moją troską.
Dialogue: 0,0:09:10.84,0:09:12.19,Default,Subaru,0,0,0,,O to chodzi.
Dialogue: 0,0:09:12.28,0:09:15.03,Default,Subaru,0,0,0,,Wiem, że jesteś bratem Frederiki,
Dialogue: 0,0:09:15.12,0:09:18.44,Default,Subaru,0,0,0,,więc ona też spełnia warunek mieszanej\Nkrwi.
Dialogue: 0,0:09:18.53,0:09:20.20,Default,Subaru,0,0,0,,Więc dlaczego jej tu nie ma?
Dialogue: 0,0:09:20.48,0:09:21.98,Default,Garfiel,0,0,0,,Dlaczego mnie pytasz?
Dialogue: 0,0:09:22.07,0:09:24.91,Default,Garfiel,0,0,0,,Bariera nie zniknie, dopóki\Nktoś nie przejdzie próby.
Dialogue: 0,0:09:25.00,0:09:26.16,Default,Garfiel,0,0,0,,Nic tego nie zmieni.
Dialogue: 0,0:09:26.50,0:09:28.86,Default,Subaru,0,0,0,,Znając powód, będziemy mieli więcej\Nmożliwości.
Dialogue: 0,0:09:29.34,0:09:31.71,Default,Subaru,0,0,0,,Jestem typem, który chce mieć
Dialogue: 0,0:09:31.80,0:09:34.80,Default,Subaru,0,0,0,,Wszystkie informacje zanim\Nbędę szukał odpowiedzi.
Dialogue: 0,0:09:36.69,0:09:37.75,Default,Garfiel,0,0,0,,Jesteśmy tutaj.
Dialogue: 0,0:09:50.63,0:09:53.02,Default,Subaru,0,0,0,,To ty chciałaś ze mną porozmawiać, Ryuzu?
Dialogue: 0,0:09:53.11,0:09:55.81,Default,Ryuzu,0,0,0,,Możesz tak to interpretować.
Dialogue: 0,0:09:55.90,0:09:58.30,Default,Ryuzu,0,0,0,,Młody Gar jest moim opiekunem.
Dialogue: 0,0:10:00.25,0:10:02.75,Default,Subaru,0,0,0,,Czy to tutaj przychodzisz\Nsię zrelaksować czy coś?
Dialogue: 0,0:10:02.84,0:10:05.13,Default,Subaru,0,0,0,,Skoro zaprosiłaś mnie do takiego miejsca,
Dialogue: 0,0:10:05.22,0:10:08.12,Default,Subaru,0,0,0,,Czy wkrótce zaczniesz dzielić\Nsię ze mną swoimi sekretami?
Dialogue: 0,0:10:08.32,0:10:10.88,Default,Ryuzu,0,0,0,,Ależ z ciebie gładki rozmówca.
Dialogue: 0,0:10:11.41,0:10:15.54,Default,Subaru,0,0,0,,Odpowiesz na moje pytanie?
Dialogue: 0,0:10:16.12,0:10:19.71,Default,Ryuzu,0,0,0,,Masz na myśli powód, dla którego\NFrederica opuściła Sanktuarium?
Dialogue: 0,0:10:19.80,0:10:23.01,Default,Ryuzu,0,0,0,,Co zamierzasz zrobić z tą informacją?
Dialogue: 0,0:10:23.32,0:10:27.35,Default,Subaru,0,0,0,,Wykorzystam ją, by wydostać wszystkich z\NSanktuarium.
Dialogue: 0,0:10:27.79,0:10:30.59,Default,Subaru,0,0,0,,Wtedy nikt nie będzie musiał przechodzić\Npróby, prawda?
Dialogue: 0,0:10:30.70,0:10:33.15,Default,Ryuzu,0,0,0,,Logicznie rzecz biorąc, tak, masz rację.
Dialogue: 0,0:10:33.24,0:10:36.12,Default,Ryuzu,0,0,0,,Ale dlaczego tak uparcie unikasz próby?
Dialogue: 0,0:10:36.21,0:10:38.84,Default,Subaru,0,0,0,,Bo nie chcę zmuszać\NEmilii do tego.
Dialogue: 0,0:10:38.93,0:10:41.49,Default,Subaru,0,0,0,,To mój własny, czysto samolubny powód.
Dialogue: 0,0:10:43.92,0:10:46.35,Default,Ryuzu,0,0,0,,To może zadziałać w przypadku próby,
Dialogue: 0,0:10:46.44,0:10:49.83,Default,Ryuzu,0,0,0,,ale nie można wiecznie\Nuciekać przed trudnościami...
Dialogue: 0,0:10:49.92,0:10:52.21,Default,Subaru,0,0,0,,Nie mówię o ucieczce.
Dialogue: 0,0:10:52.88,0:10:56.98,Default,Subaru,0,0,0,,Może nie teraz, ale Emilia w końcu będzie\Nmusiała stawić czoła swojej przeszłości.
Dialogue: 0,0:10:57.33,0:10:58.95,Default,Ryuzu,0,0,0,,Chcesz jej dać ucieczkę,
Dialogue: 0,0:10:59.04,0:11:03.10,Default,Ryuzu,0,0,0,,ale nie od rzeczy, które\Nją najbardziej skrzywdzą?
Dialogue: 0,0:11:03.72,0:11:05.94,Default,Subaru,0,0,0,,Pokona ją bez uciekania.
Dialogue: 0,0:11:06.35,0:11:09.35,Default,Subaru,0,0,0,,Mam wiarę, że dziewczyna, w której\Nsię zakochałem, zrobi to.
Dialogue: 0,0:11:13.67,0:11:15.42,Default,Garfiel,0,0,0,,Powiedz mu, staruszko!
Dialogue: 0,0:11:15.90,0:11:20.03,Default,Garfiel,0,0,0,,Powiedz mu, że to jak gadgy gwadzeadd\Npróbujący się ukryć w górach!
Dialogue: 0,0:11:20.12,0:11:23.55,Default,Subaru,0,0,0,,Doceniam to, ale nie mam pojęcia, co\Npowiedziałeś.
Dialogue: 0,0:11:23.64,0:11:28.62,Default,Ryuzu,0,0,0,,Młody Gar chce powiedzieć,\Nże nie ma wygodnej drogi ucieczki.
Dialogue: 0,0:11:28.93,0:11:32.87,Default,Ryuzu,0,0,0,,Odejście Frederiki było pewnym wyjątkiem.
Dialogue: 0,0:11:32.96,0:11:36.84,Default,Ryuzu,0,0,0,,Nie spełnia warunków do\Nprzetrzymywania w barierze.
Dialogue: 0,0:11:37.41,0:11:39.73,Default,Subaru,0,0,0,,Warunki utrzymywania się w barierze?
Dialogue: 0,0:11:39.82,0:11:42.14,Default,Subaru,0,0,0,,Czy poza półkrwią jest\Njeszcze jakiś warunek?
Dialogue: 0,0:11:42.23,0:11:44.59,Default,Ryuzu,0,0,0,,Nie ma wyjątków.
Dialogue: 0,0:11:44.68,0:11:45.62,Default,Subaru,0,0,0,,Więc...
Dialogue: 0,0:11:45.71,0:11:48.43,Default,Ryuzu,0,0,0,,Bariera określa status mieszańca na\Npodstawie
Dialogue: 0,0:11:48.52,0:11:50.15,Default,Ryuzu,0,0,0,,udziału krwi każdej rasy.
Dialogue: 0,0:11:50.24,0:11:52.75,Default,Ryuzu,0,0,0,,Jeśli ludzkiej i nieludzkiej\Nkrwi jest po równo,
Dialogue: 0,0:11:52.84,0:11:54.54,Default,Ryuzu,0,0,0,,bariera zatrzyma taką osobę.
Dialogue: 0,0:11:55.20,0:11:56.33,Default,Ryuzu,0,0,0,,Jednak...
Dialogue: 0,0:11:56.42,0:11:58.09,Default,Subaru,0,0,0,,Mniej niż pół obcej krwi...
Dialogue: 0,0:11:58.18,0:12:00.78,Default,Subaru,0,0,0,,na przykład jedną czwartą, bariera cię nie\Nzatrzyma?
Dialogue: 0,0:12:00.96,0:12:02.19,Default,Subaru,0,0,0,,To znaczy...
Dialogue: 0,0:12:02.28,0:12:04.03,Default,Garfiel,0,0,0,,Mamy różnych ojców.
Dialogue: 0,0:12:04.68,0:12:07.26,Default,Garfiel,0,0,0,,Jestem Garfiel Tinzel.
Dialogue: 0,0:12:08.12,0:12:11.25,Default,Garfiel,0,0,0,,Jestem pewien, że używa innego nazwiska.
Dialogue: 0,0:12:11.55,0:12:13.46,Default - flashback,Frederica,0,0,0,,Jestem Frederica Baumann.
Dialogue: 0,0:12:15.15,0:12:18.59,Default,Ryuzu,0,0,0,,Urodziła się z ludzkiej\Nmatki i ojca mieszanej krwi.
Dialogue: 0,0:12:19.09,0:12:21.92,Default,Ryuzu,0,0,0,,Dlatego może wejść i wyjść\Nz lasu, kiedy tylko zechce.
Dialogue: 0,0:12:22.34,0:12:24.51,Default,Garfiel,0,0,0,,Ha! Może wchodzić i wychodzić, kiedy chce?
Dialogue: 0,0:12:24.60,0:12:25.80,Default,Garfiel,0,0,0,,Nie rozśmieszaj mnie!
Dialogue: 0,0:12:25.89,0:12:29.24,Default,Garfiel,0,0,0,,Nie była tu od ponad 10 lat!
Dialogue: 0,0:12:29.33,0:12:31.18,Default,Garfiel,0,0,0,,Frederica opuściła to miejsce!
Dialogue: 0,0:12:32.37,0:12:33.68,Default,Ryuzu,0,0,0,,Młody Gar...
Dialogue: 0,0:12:34.88,0:12:36.71,Default,Ryuzu,0,0,0,,A teraz wiesz.
Dialogue: 0,0:12:36.80,0:12:40.82,Default,Ryuzu,0,0,0,,Przepraszam, że tak długo słuchałeś, by\Ntak mało się dowiedzieć.
Dialogue: 0,0:12:41.24,0:12:42.33,Default,Subaru,0,0,0,,Nie.
Dialogue: 0,0:12:42.42,0:12:46.94,Default,Subaru,0,0,0,,To lepsze niż wieczne tkwienie przy\Nbezużytecznych opcjach.
Dialogue: 0,0:12:47.37,0:12:50.16,Default,Subaru,0,0,0,,Ale chyba nadal musimy przejść próbę...
Dialogue: 0,0:12:52.59,0:12:55.18,Default,Subaru,0,0,0,,Garfiel, Ryuzu...
Dialogue: 0,0:12:55.27,0:12:57.38,Default,Subaru,0,0,0,,Chciałbym zaproponować coś.
Dialogue: 0,0:12:58.19,0:12:59.84,Default,Ryuzu,0,0,0,,Sugerujesz coś?
Dialogue: 0,0:13:00.20,0:13:04.44,Default,Subaru,0,0,0,,Idę przekonać do tego Roswaala i Emilię,
Dialogue: 0,0:13:04.53,0:13:08.24,Default,Subaru,0,0,0,,ale to bardzo ważne, więc proszę, nie\Nmówcie o tym nikomu.
Dialogue: 0,0:13:10.53,0:13:13.56,Default,Ryuzu,0,0,0,,Dobrze, nikomu nie powiemy.
Dialogue: 0,0:13:13.65,0:13:15.27,Default,Ryuzu,0,0,0,,Powiedz nam, co tylko chcesz.
Dialogue: 0,0:13:17.46,0:13:20.15,Default,Subaru,0,0,0,,Chcę przejść próbę zamiast Emilii.
Dialogue: 0,0:13:20.42,0:13:21.40,Default,Garfiel,0,0,0,,Co?!
Dialogue: 0,0:13:21.76,0:13:23.97,Default,Subaru,0,0,0,,Kiedy wszedłem na cmentarz,\Nby pomóc Emilii,
Dialogue: 0,0:13:24.30,0:13:25.85,Default,Subaru,0,0,0,,Wróciłem nieuszkodzony, prawda?
Dialogue: 0,0:13:26.00,0:13:28.87,Default,Subaru,0,0,0,,Mam uprawnienia do przystąpienia do próby.
Dialogue: 0,0:13:29.16,0:13:31.91,Default,Subaru,0,0,0,,A poza tym, już przeszedłem\Njedną z nich.
Dialogue: 0,0:13:32.38,0:13:33.87,Default,Garfiel,0,0,0,,Przeszedłeś próbę?!
Dialogue: 0,0:13:35.58,0:13:37.79,Default,Subaru,0,0,0,,"Rzeczy się skomplikowały".
Dialogue: 0,0:13:37.88,0:13:39.53,Default,Subaru,0,0,0,,Czy to o czym myślisz, Ryuzu?
Dialogue: 0,0:13:39.92,0:13:44.19,Default,Ryuzu,0,0,0,,Nie mogę zaprzeczyć, że wyjąłeś mi to z\Nust.
Dialogue: 0,0:13:44.60,0:13:47.69,Default,Ryuzu,0,0,0,,Ale teraz rozumiem.
Dialogue: 0,0:13:51.35,0:13:55.16,Default,Ryuzu,0,0,0,,Młody Su, też muszę ci coś powiedzieć.
Dialogue: 0,0:13:55.25,0:13:56.13,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:13:56.36,0:14:01.65,Default,Ryuzu,0,0,0,,Na razie musisz siedzieć cicho i być\Ngrzeczny.
Dialogue: 0,0:14:01.88,0:14:02.76,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:14:05.62,0:14:08.74,Default,Ryuzu,0,0,0,,Wiem, że pewnie się zastanawiasz,\Ndlaczego tak się dzieje.
Dialogue: 0,0:14:08.83,0:14:11.49,Default,Ryuzu,0,0,0,,Ale nie będę prosiła cię o wybaczenie.
Dialogue: 0,0:14:11.58,0:14:14.70,Default,Ryuzu,0,0,0,,Jak obiecałam, nikomu nie powiem\Ntego, co mi powiedziałeś.
Dialogue: 0,0:14:14.79,0:14:17.78,Default,Ryuzu,0,0,0,,Przysięgam na imię Ryuzu Shimy.
Dialogue: 0,0:14:30.99,0:14:32.62,Default,Garfiel,0,0,0,,Obudziłeś się?
Dialogue: 0,0:14:34.81,0:14:36.22,Default,Garfiel,0,0,0,,Rozwiążę cię.
Dialogue: 0,0:14:36.31,0:14:39.54,Default,Garfiel,0,0,0,,I uprzedzam, że wołanie o pomoc nic nie\Nda.
Dialogue: 0,0:14:40.20,0:14:41.45,Default,Subaru,0,0,0,,Niech ktoś pomoże!
Dialogue: 0,0:14:41.54,0:14:43.21,Default,Garfiel,0,0,0,,Powiedziałem, że to nie zadziała!
Dialogue: 0,0:14:43.30,0:14:45.99,Default,Garfiel,0,0,0,,To część Sanktuarium,\No której nikt nie wie!
Dialogue: 0,0:14:48.24,0:14:52.74,Default,Garfiel,0,0,0,,Nie ma potrzeby ratować kogoś,\Nkto chce umrzeć, prawda?
Dialogue: 0,0:14:53.04,0:14:54.98,Default,Subaru,0,0,0,,Nie wiem o czym mówisz!
Dialogue: 0,0:14:55.07,0:14:59.27,Default,Garfiel,0,0,0,,Jesteście sławni jako banda dziwaków.
Dialogue: 0,0:14:59.36,0:15:01.87,Default,Subaru,0,0,0,,Poczekaj... naprawdę nie rozumiem...
Dialogue: 0,0:15:01.96,0:15:03.15,Default,Garfiel,0,0,0,,Nie udawaj głupca!
Dialogue: 0,0:15:03.24,0:15:06.35,Default,Garfiel,0,0,0,,Miasma wypływa z każdej\Npory w twoim ciele!
Dialogue: 0,0:15:06.44,0:15:07.79,Default,Garfiel,0,0,0,,Jesteś z Kultu Czarownicy!
Dialogue: 0,0:15:08.76,0:15:12.41,Default,Garfiel,0,0,0,,Zapach jest silniejszy, odkąd wyszedłeś z\Ncmentarza.
Dialogue: 0,0:15:12.99,0:15:15.76,Default,Garfiel,0,0,0,,Niewiele osób ma taką ilość miasmy.
Dialogue: 0,0:15:15.95,0:15:19.45,Default,Garfiel,0,0,0,,Chciałem cię wypuścić, jeśli\Nprzysięgniesz, że niczego nie spróbujesz,
Dialogue: 0,0:15:19.54,0:15:22.53,Default,Garfiel,0,0,0,,ale mówisz, że chcesz przejść próbę\Nzamiast księżniczki?
Dialogue: 0,0:15:22.62,0:15:23.99,Default,Garfiel,0,0,0,,To nie żart!
Dialogue: 0,0:15:25.08,0:15:28.78,Default,Subaru,0,0,0,,Czujesz... zapach czarownicy na mnie?
Dialogue: 0,0:15:28.96,0:15:31.70,Default,Garfiel,0,0,0,,Ha! Zabawnie to nazwałeś!
Dialogue: 0,0:15:32.20,0:15:35.30,Default,Garfiel,0,0,0,,Pasuje, prawda? „Zapach czarownicy”!
Dialogue: 0,0:15:35.78,0:15:38.14,Default,Garfiel,0,0,0,,Co chcesz robić na tym cmentarzu?!
Dialogue: 0,0:15:38.76,0:15:40.06,Default,Garfiel,0,0,0,,Co planujesz?
Dialogue: 0,0:15:40.15,0:15:43.31,Default,Garfiel,0,0,0,,To nic dobrego, skoro grób czarownicy\Njest jego częścią.
Dialogue: 0,0:15:43.40,0:15:46.71,Default,Subaru,0,0,0,,To po co mnie tu wciągać?
Dialogue: 0,0:15:46.80,0:15:48.51,Default,Subaru,0,0,0,,Dlaczego mnie nie zabiłeś?
Dialogue: 0,0:15:48.60,0:15:52.84,Default,Garfiel,0,0,0,,Bo wiesz jak przekonać ludzi!
Dialogue: 0,0:15:53.52,0:15:59.14,Default,Garfiel,0,0,0,,Nie chcę cię zabijać i potem tego żałować,\Njak po upadku Twierdzy Tesla!
Dialogue: 0,0:15:59.23,0:16:01.10,Default,Subaru,0,0,0,,Więc co ze mną zrobisz?
Dialogue: 0,0:16:01.40,0:16:05.08,Default,Garfiel,0,0,0,,Na razie wszystko zależy od Emilii.
Dialogue: 0,0:16:13.99,0:16:15.50,Default,Garfiel,0,0,0,,To niemożliwe!
Dialogue: 0,0:16:15.59,0:16:17.23,Default,Garfiel,0,0,0,,Nie pozwolę ci też się zabić!
Dialogue: 0,0:16:17.32,0:16:20.98,Default,Garfiel,0,0,0,,Nie mam cholernego pojęcia, co myślisz.
Dialogue: 0,0:16:21.39,0:16:25.70,Default,Garfiel,0,0,0,,Ale to co mnie wkurza najbardziej\Nto twoje nastawienie!
Dialogue: 0,0:16:25.79,0:16:29.71,Default,Garfiel,0,0,0,,Masz takie same oczy jak ten drań Roswaal!
Dialogue: 0,0:16:29.80,0:16:32.65,Default,Garfiel,0,0,0,,Nie próbuj żadnych sztuczek!
Dialogue: 0,0:16:38.95,0:16:40.36,Default,Guy,0,0,0,,Subaru!
Dialogue: 0,0:16:40.45,0:16:41.91,Default,Lady,0,0,0,,Subaru!
Dialogue: 0,0:16:43.36,0:16:45.06,Default,Emilia,0,0,0,,Subaru!
Dialogue: 0,0:16:52.16,0:16:53.53,Default,Emilia,0,0,0,,Ram, coś?
Dialogue: 0,0:16:54.16,0:16:55.55,Default,Ram,0,0,0,,Niestety nie.
Dialogue: 0,0:16:55.64,0:17:00.92,Default,Garfiel,0,0,0,,Każdy, kto w nocy sam wędruje po\NZagubionym Lesie, nie wróci z łatwością.
Dialogue: 0,0:17:01.01,0:17:02.00,Default,Otto,0,0,0,,Sam?
Dialogue: 0,0:17:03.96,0:17:05.29,Default,Otto,0,0,0,,Nieważne.
Dialogue: 0,0:17:05.76,0:17:09.38,Default,Emilia,0,0,0,,Puck, dlaczego nie wyjdziesz?
Dialogue: 0,0:17:10.06,0:17:12.25,Default,Garfiel,0,0,0,,Chodź ze mną na chwilę.
Dialogue: 0,0:17:12.34,0:17:13.22,Default,Otto,0,0,0,,Co?!
Dialogue: 0,0:17:15.31,0:17:17.68,Default,Garfiel,0,0,0,,Tylko nie rozpowiadaj.
Dialogue: 0,0:17:17.77,0:17:19.39,Default,Garfiel,0,0,0,,Tak długo jak nie...
Dialogue: 0,0:17:28.96,0:17:31.88,Default - italics,Subaru,0,0,0,,Za mocno mnie związał!
Dialogue: 0,0:17:38.28,0:17:41.91,Default - italics,Subaru,0,0,0,,Nie mam czasu, żeby tu tkwić!
Dialogue: 0,0:17:42.00,0:17:44.52,Default - italics,Subaru,0,0,0,,Myśl. Na razie wiem,
Dialogue: 0,0:17:44.61,0:17:48.45,Default - italics,Subaru,0,0,0,,że napastnik zaczeka, aż ktoś wróci do\Nrezydencji.
Dialogue: 0,0:17:48.54,0:17:50.63,Default - italics,Subaru,0,0,0,,Jak na razie, najdłużej to było pięć dni.
Dialogue: 0,0:17:53.91,0:17:55.69,Default,Subaru,0,0,0,,Beatrice...
Dialogue: 0,0:17:55.78,0:17:59.80,Default - italics,Subaru,0,0,0,,Naprawdę przez cały czas tylko wykonywałaś\Npolecenia Ewangelii?
Dialogue: 0,0:18:00.23,0:18:01.11,Default - flashback,Beatrice,0,0,0,,Mówiłam ci!
Dialogue: 0,0:18:01.20,0:18:02.97,Default - flashback,Beatrice,0,0,0,,Tak, to dlatego, przypuszczam!
Dialogue: 0,0:18:04.16,0:18:06.07,Default - italics,Subaru,0,0,0,,Nawet jeśli to prawda...
Dialogue: 0,0:18:06.98,0:18:10.62,Default - italics,Subaru,0,0,0,,Dałbym wszystko,\Nżeby usłyszeć twój głos.
Dialogue: 0,0:19:27.47,0:19:30.19,Default,Otto,0,0,0,,Podejrzewałem, że będziesz\Nw nieszczęśliwym stanie.
Dialogue: 0,0:19:30.28,0:19:32.92,Default,Otto,0,0,0,,Ale to jest jeszcze gorsze niż myślałem.
Dialogue: 0,0:19:34.30,0:19:36.53,Default,Otto,0,0,0,,Musisz być cicho.
Dialogue: 0,0:19:37.20,0:19:39.55,Default,Otto,0,0,0,,Balansuję tu na niebezpiecznej granicy.
Dialogue: 0,0:19:39.64,0:19:41.98,Default,Otto,0,0,0,,Nie chcę, żeby strażnik mnie złapał.
Dialogue: 0,0:19:42.40,0:19:45.12,Default,Otto,0,0,0,,My nigdy nie wiemy,\Nkiedy odpuścić, prawda?
Dialogue: 0,0:19:48.74,0:19:53.35,Default,Otto,0,0,0,,W każdym razie, cieszę się,\Nże nadal żyjesz, Natsuki.
Dialogue: 0,0:19:58.53,0:19:59.96,Default,Subaru,0,0,0,,Jak długo?
Dialogue: 0,0:20:00.05,0:20:01.61,Default,Otto,0,0,0,,Trzy dni.
Dialogue: 0,0:20:01.70,0:20:04.51,Default,Otto,0,0,0,,Jest noc... i czas próby.
Dialogue: 0,0:20:04.60,0:20:05.68,Default,Subaru,0,0,0,,Trzy dni?!
Dialogue: 0,0:20:05.77,0:20:08.65,Default,Subaru,0,0,0,,A próba wciąż trwa?
Dialogue: 0,0:20:08.74,0:20:11.62,Default,Otto,0,0,0,,Emilia ma plan.
Dialogue: 0,0:20:12.11,0:20:14.87,Default,Subaru,0,0,0,,Co się stało, gdy mnie nie było?
Dialogue: 0,0:20:14.96,0:20:17.23,Default,Otto,0,0,0,,Wieść o twoim zniknięciu szybko się\Nrozeszła,
Dialogue: 0,0:20:17.32,0:20:19.47,Default,Otto,0,0,0,,wywołując panikę w całej społeczności.
Dialogue: 0,0:20:20.13,0:20:22.90,Default,Otto,0,0,0,,Zwłaszcza Emilia z trudem zachowywała\Nspokój.
Dialogue: 0,0:20:22.99,0:20:26.07,Default,Otto,0,0,0,,Właściwie odmówiła próby następnego dnia.
Dialogue: 0,0:20:26.60,0:20:27.83,Default,Subaru,0,0,0,,Emilia?
Dialogue: 0,0:20:28.22,0:20:32.01,Default,Otto,0,0,0,,Wszyscy cię szukali, ale bez powodzenia.
Dialogue: 0,0:20:32.41,0:20:36.08,Default,Otto,0,0,0,,Markgraf powiedział więc Emilii, że\Npowinni dać pierwszeństwo
Dialogue: 0,0:20:36.61,0:20:41.59,Default,Otto,0,0,0,,uwolnieniu Sanktuarium, aby można było\Nzebrać grupę poszukiwawczą.
Dialogue: 0,0:20:41.68,0:20:43.14,Default,Subaru,0,0,0,,Grupę poszukiwawczą?
Dialogue: 0,0:20:43.68,0:20:45.66,Default,Subaru,0,0,0,,Czy Emilia się z tym zgodziła?
Dialogue: 0,0:20:45.75,0:20:49.45,Default,Otto,0,0,0,,Powiedziała, że markgraf złożył\Njej jakąś formalną przysięgę...
Dialogue: 0,0:20:50.42,0:20:55.22,Default,Otto,0,0,0,,Dlatego Emilia desperacko podchodziła do\Npróby wczoraj i dzisiaj,
Dialogue: 0,0:20:55.96,0:21:00.24,Default,Otto,0,0,0,,i wydaje się być głęboko przygnębiona,\Ngdy jej próby nie kończą się sukcesem.
Dialogue: 0,0:21:00.79,0:21:03.68,Default,Subaru,0,0,0,,Jest jedna rzecz, która mnie\Nnieustannie niepokoi...
Dialogue: 0,0:21:03.77,0:21:04.65,Default,Otto,0,0,0,,Co to jest?
Dialogue: 0,0:21:04.86,0:21:09.31,Default,Subaru,0,0,0,,Dlaczego ciągle mówisz, jakbyś\Nto słyszał z drugiej ręki?
Dialogue: 0,0:21:09.40,0:21:11.95,Default,Otto,0,0,0,,O to pytasz?
Dialogue: 0,0:21:12.44,0:21:14.80,Default,Otto,0,0,0,,To dość trudne do powiedzenia, szczerze...
Dialogue: 0,0:21:15.32,0:21:19.21,Default,Otto,0,0,0,,Prawda jest taka,\Nże Garfiel też ma na mnie oko.
Dialogue: 0,0:21:19.30,0:21:22.31,Default,Otto,0,0,0,,Więc też biegałem, próbując go uniknąć.
Dialogue: 0,0:21:22.40,0:21:23.28,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:21:23.52,0:21:26.83,Default,Otto,0,0,0,,Byłem tam, kiedy ostatnio\Nsię widzieliście. Pamiętasz?
Dialogue: 0,0:21:27.71,0:21:29.43,Default,Otto,0,0,0,,To naturalne, że mnie podejrzewał.
Dialogue: 0,0:21:29.52,0:21:31.90,Default,Otto,0,0,0,,A potem powiedział do mnie...
Dialogue: 0,0:21:31.99,0:21:37.41,Default,Otto,0,0,0,,że jeśli nikomu nie powiem, iż się z nim\Nspotkałeś, nie zrobi mi krzywdy.
Dialogue: 0,0:21:37.93,0:21:40.81,Default,Otto,0,0,0,,Pokazał mi świecący kamień\Njako zabezpieczenie.
Dialogue: 0,0:21:40.90,0:21:43.22,Default,Subaru,0,0,0,,I odmówiłeś?!
Dialogue: 0,0:21:43.31,0:21:44.46,Default,Subaru,0,0,0,,Au...
Dialogue: 0,0:21:44.98,0:21:48.15,Default,Subaru,0,0,0,,A teraz Garfiel cię ściga?
Dialogue: 0,0:21:48.24,0:21:52.40,Default,Otto,0,0,0,,Tak, więc zdobyłem wszystkie te\Ninformacje podczas ucieczki.
Dialogue: 0,0:21:52.49,0:21:54.19,Default,Otto,0,0,0,,Słyszałem to z drugiej ręki.
Dialogue: 0,0:21:54.28,0:21:56.99,Default,Otto,0,0,0,,Chociaż to dość zabawne\Njak długo to się ciągnęło,
Dialogue: 0,0:21:57.08,0:21:58.96,Default,,0,0,0,,To była zabawniejsza opcja.
Dialogue: 0,0:21:59.26,0:22:01.43,Default,Subaru,0,0,0,,Przestań się nade mną znęcać! Oszalałeś?!
Dialogue: 0,0:22:01.52,0:22:03.31,Default,Subaru,0,0,0,,Dlaczego to zrobiłeś?!
Dialogue: 0,0:22:04.71,0:22:07.85,Default,Subaru,0,0,0,,Naprawdę jestem ci wdzięczny, że mnie\Nuratowałeś.
Dialogue: 0,0:22:08.52,0:22:13.45,Default,Subaru,0,0,0,,Szczerze mówiąc, zanim cię zobaczyłem,\Nmyślałem, że lepiej byłoby umrzeć.
Dialogue: 0,0:22:14.21,0:22:15.09,Default,Subaru,0,0,0,,Ale...
Dialogue: 0,0:22:16.05,0:22:19.10,Default,Subaru,0,0,0,,Nie rozumiem, dlaczego mi pomagasz.
Dialogue: 0,0:22:24.56,0:22:26.78,Default,Otto,0,0,0,,Posłuchaj, Natsuki...
Dialogue: 0,0:22:27.80,0:22:30.31,Default,Otto,0,0,0,,Czy naprawdę tak dziwne jest
Dialogue: 0,0:22:30.87,0:22:33.12,Default,Otto,0,0,0,,próbować pomóc przyjacielowi?
Dialogue: 0,0:22:35.80,0:22:36.68,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:22:38.40,0:22:42.70,Default,Otto,0,0,0,,Dlaczego stoisz tam jak posąg\Nz taką zszokowaną twarzą?
Dialogue: 0,0:22:43.05,0:22:46.56,Default,Subaru,0,0,0,,Po prostu nagle wspomniałeś kogoś, kogo\Nnie znam.
Dialogue: 0,0:22:46.65,0:22:48.85,Default,Subaru,0,0,0,,Nie wiem, kim jest Eugene...
Dialogue: 0,0:22:48.94,0:22:51.80,Default,Otto,0,0,0,,Wszystko zrozumiałeś źle!
Dialogue: 0,0:22:51.89,0:22:55.70,Default,Otto,0,0,0,,Nie powiedziałem "Eugene",\Ntylko "{\i1}przyjaciel{\i0}"!
Dialogue: 0,0:22:55.79,0:22:58.71,Default,Subaru,0,0,0,,Kto jest czyim przyjacielem?
Dialogue: 0,0:22:58.80,0:23:00.77,Default,Otto,0,0,0,,{\i1}Jesteś{\i0} {\i1}moim{\i0} przyjacielem!
Dialogue: 0,0:23:04.77,0:23:08.86,Default,Otto,0,0,0,,To prawda, że przyszedłem tu z tobą,\Nbo to służyło też moim interesom!
Dialogue: 0,0:23:09.09,0:23:12.34,Default,Otto,0,0,0,,Najpierw był olej, potem uratowałeś mnie\Nprzed Kultem Czarownicy,
Dialogue: 0,0:23:12.43,0:23:15.17,Default,Otto,0,0,0,,potem obiecano audiencję u margrabiego...
Dialogue: 0,0:23:15.26,0:23:16.20,Default,Otto,0,0,0,,Ale...
Dialogue: 0,0:23:16.48,0:23:18.68,Default,Otto,0,0,0,,Kiedy odłożyć na bok wszystkie te\Nprzysługi,
Dialogue: 0,0:23:18.90,0:23:22.51,Default,Otto,0,0,0,,Uważam cię za przyjaciela, Natsuki-san.
Dialogue: 0,0:23:22.96,0:23:26.35,Default,Otto,0,0,0,,Chociaż nie lubię,\Njak mnie traktujesz...
Dialogue: 0,0:23:26.44,0:23:29.43,Default,Otto,0,0,0,,Ale uznaję, że świadczy to o bliskości\Nprzyjaciół.
Dialogue: 0,0:23:34.64,0:23:35.52,Default,Otto,0,0,0,,Co?
Dialogue: 0,0:23:37.68,0:23:41.23,Default,Subaru,0,0,0,,Przy... Przy... Przyjaciele?!\NNaprawdę przyjaciele?!
Dialogue: 0,0:23:41.32,0:23:46.61,Default,Subaru,0,0,0,,Otto, chciałeś być moim przyjacielem?!
Dialogue: 0,0:23:49.36,0:23:52.75,Default,Subaru,0,0,0,,Przyjaciele... Otto, przysięgam, stary...
Dialogue: 0,0:23:52.84,0:23:54.78,Default,Otto,0,0,0,,To boli!
Dialogue: 0,0:23:55.94,0:23:57.24,Default,Otto,0,0,0,,Co ty robisz?!
Dialogue: 0,0:23:57.33,0:23:59.89,Default,Otto,0,0,0,,Byłem głupi, że to powiedziałem!
Dialogue: 0,0:23:59.98,0:24:03.03,Default,Otto,0,0,0,,Wiedziałem, że będziesz się ze mnie śmiać!
Dialogue: 0,0:24:03.12,0:24:05.87,Default,Subaru,0,0,0,,Jak mogłem się nie śmiać?
Dialogue: 0,0:24:05.96,0:24:07.76,Default,Subaru,0,0,0,,To nie ty jesteś szalony.
Dialogue: 0,0:24:07.85,0:24:10.32,Default,Subaru,0,0,0,,Po prostu powaliła mnie własna głupota.
Dialogue: 0,0:24:10.41,0:24:13.46,Default,Subaru,0,0,0,,Jestem tak zrozpaczony własną głupotą, że\Naż muszę się śmiać!
Dialogue: 0,0:24:21.62,0:24:22.70,Default,Otto,0,0,0,,Natsuki?
Dialogue: 0,0:24:26.46,0:24:27.79,Default,Subaru,0,0,0,,Przepraszam.
Dialogue: 0,0:24:27.88,0:24:31.19,Default,Subaru,0,0,0,,Naprawdę jesteś moim przyjacielem, Otto.
Dialogue: 0,0:24:33.69,0:24:36.69,Default,Subaru,0,0,0,,Dzięki, że mnie uratowałeś.
Dialogue: 0,0:24:36.78,0:24:40.04,Episode Title,Title,0,0,0,,{\fs25\t(1,5010,\fs30)\c&H9DA195&}Przy{\c&HFAFAFA&}jaciel
Dialogue: 0,0:25:52.60,0:25:54.87,Default,Otto,0,0,0,,Garfiel jest na cmentarzu.
Dialogue: 0,0:25:54.96,0:25:57.18,Default,Otto,0,0,0,,Więc możemy cię wydostać z bariery.
Dialogue: 0,0:25:58.22,0:26:00.66,Default,Subaru,0,0,0,,Ale pytanie brzmi, czy to\Nw ogóle możliwe.
Dialogue: 0,0:26:00.91,0:26:03.73,Default,Otto,0,0,0,,Nie musisz się o to martwić.
Dialogue: 0,0:26:03.82,0:26:06.15,Default,Otto,0,0,0,,Mam bardzo niezawodnego pomocnika.
Dialogue: 0,0:26:06.24,0:26:07.52,Default,Subaru,0,0,0,,Pomocnik?
Dialogue: 0,0:26:12.49,0:26:15.36,Default,Ram,0,0,0,,Zastanawiam się, czy\Nprzyjedziesz, zanim zostanę babcią.
Dialogue: 0,0:26:16.57,0:26:19.63,Default,Ram,0,0,0,,Oczywiście, nawet jako stara\Nbabcia, nadal będę słodka.
Dialogue: 0,0:26:19.72,0:26:26.72,Default,,0,0,0,,
