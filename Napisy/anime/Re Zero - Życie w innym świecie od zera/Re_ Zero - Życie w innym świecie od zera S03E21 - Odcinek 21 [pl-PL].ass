Dialogue: 0,0:00:06.32,0:00:09.90,Default - flashback,Subaru,0,0,0,,Cholera... Chciałem powstrzymać\Nnajazd na posiadłość,
Dialogue: 0,0:00:09.99,0:00:12.40,Default - flashback,Subaru,0,0,0,,ale chyba tylko uczyniłem\Ngo nieuniknionym.
Dialogue: 0,0:00:12.58,0:00:15.88,Default - flashback,Garfiel,0,0,0,,Ha! Aż miło było tego posłuchać.
Dialogue: 0,0:00:15.97,0:00:18.91,Default - flashback,Otto,0,0,0,,Gdyby te negocjacje nie\Nmiały rozwiązać sprawy,
Dialogue: 0,0:00:19.00,0:00:21.08,Default - flashback,Otto,0,0,0,,może bym się z tobą zgodził.
Dialogue: 0,0:00:21.40,0:00:25.00,Default - flashback,Subaru,0,0,0,,Muszę jak najszybciej\Ndotrzeć do posiadłości!
Dialogue: 0,0:00:25.09,0:00:26.66,Default - flashback,Subaru,0,0,0,,A jednak tkwię tutaj...
Dialogue: 0,0:00:26.75,0:00:29.92,Default - flashback,Otto,0,0,0,,Powiedzieć, że brakuje nam ludzi,\Nto nic nie powiedzieć.
Dialogue: 0,0:00:30.01,0:00:32.07,Default - flashback,Garfiel,0,0,0,,No to pójdę z tobą.
Dialogue: 0,0:00:32.16,0:00:33.04,Default - flashback,Both,0,0,0,,Co?
Dialogue: 0,0:00:33.84,0:00:34.84,Default - flashback,Garfiel,0,0,0,,Co?
Dialogue: 0,0:00:35.22,0:00:36.77,Default - flashback,Otto,0,0,0,,Na pewno rozumiesz sytuację?
Dialogue: 0,0:00:36.86,0:00:40.78,Default - flashback,Otto,0,0,0,,Pójście do posiadłości oznacza\Nopuszczenie Sanktuarium.
Dialogue: 0,0:00:40.87,0:00:42.86,Default - flashback,Otto,0,0,0,,Bariera cię nie zatrzyma?
Dialogue: 0,0:00:42.95,0:00:44.16,Default - flashback,Garfiel,0,0,0,,Bariera?
Dialogue: 0,0:00:44.25,0:00:45.44,Default - flashback,Garfiel,0,0,0,,To żaden problem.
Dialogue: 0,0:00:45.70,0:00:46.59,Default - flashback,Both,0,0,0,,Co?!
Dialogue: 0,0:00:46.68,0:00:51.90,Default - flashback,Garfiel,0,0,0,,Tak jak siostra mam ojca mieszańca\Ni matkę człowieka.
Dialogue: 0,0:00:52.42,0:00:55.12,Default - flashback,Garfiel,0,0,0,,Mam za mało mieszanej krwi. Bariera mnie\Nnie zatrzyma.
Dialogue: 0,0:00:55.21,0:00:59.37,Default - flashback,Subaru,0,0,0,,Ale słyszałem, że ty i Frederica\Nmacie różnych ojców!
Dialogue: 0,0:00:59.78,0:01:02.08,Default - flashback,Garfiel,0,0,0,,Co? No, wiesz...
Dialogue: 0,0:01:02.58,0:01:07.25,Default - flashback,Garfiel,0,0,0,,Moja matka miała cholernego pecha\Ni fatalny gust do facetów.
Dialogue: 0,0:01:07.34,0:01:08.69,Default - flashback,Garfiel,0,0,0,,Sam sobie dopowiedz resztę!
Dialogue: 0,0:01:10.84,0:01:13.63,Default - flashback,Subaru,0,0,0,,Trzeba było powiedzieć wcześniej!
Dialogue: 0,0:01:17.59,0:01:21.24,Default - flashback,Garfiel,0,0,0,,Już jestem najsilniejszy, a z nimi
Dialogue: 0,0:01:21.33,0:01:23.39,Default - flashback,Garfiel,0,0,0,,Będę jeszcze silniejszy!
Dialogue: 0,0:01:23.65,0:01:27.44,Default - flashback,Subaru,0,0,0,,Pokaż nam, na co cię stać!
Dialogue: 0,0:01:28.21,0:01:29.61,Default - flashback,Garfiel,0,0,0,,Możecie na mnie liczyć.
Dialogue: 0,0:01:29.70,0:01:33.08,Default - flashback,Garfiel,0,0,0,,Jak to mówią: przed Reinhardem\Nnikt nie ucieknie.
Dialogue: 0,0:01:33.17,0:01:36.51,Default - flashback,Subaru,0,0,0,,Jeszcze żyje, a już ma\Nwłasne powiedzenie?
Dialogue: 0,0:01:36.60,0:01:37.67,Default - flashback,Subaru,0,0,0,,Serio?
Dialogue: 0,0:01:38.36,0:01:40.07,Default - flashback,Otto,0,0,0,,Tutaj też wszystko gotowe.
Dialogue: 0,0:01:40.71,0:01:44.31,Default - flashback,Subaru,0,0,0,,Oby Elsa i jej wspólniczka\Nnie przyszły za wcześnie.
Dialogue: 0,0:01:44.51,0:01:47.17,Default - flashback,Subaru,0,0,0,,Liczę na was i na naszego wroga!
Dialogue: 0,0:01:47.26,0:01:49.43,Default - flashback,Subaru,0,0,0,,Sztuka wojenna w stylu Natsukiego Subaru!
Dialogue: 0,0:01:49.52,0:01:51.59,Default - flashback,Subaru,0,0,0,,Moje {\i1}Odwrócone Fuurinkazan{\i0}!
Dialogue: 0,0:01:52.47,0:01:54.13,Default - flashback,Garfiel,0,0,0,,A-Ale super!
Dialogue: 0,0:01:54.52,0:01:57.14,Default - flashback,Subaru,0,0,0,,Dzięki za pomoc, wy dwaj idioci!
Dialogue: 0,0:01:57.23,0:02:00.52,Default - flashback,Otto,0,0,0,,Nie możesz normalnie podziękować,\Nty jeden idioto?!
Dialogue: 0,0:02:00.61,0:02:01.72,Default - flashback,Subaru,0,0,0,,W każdym razie, Ram...
Dialogue: 0,0:02:02.10,0:02:03.67,Default - flashback,Subaru,0,0,0,,Resztę zostawiam tobie.
Dialogue: 0,0:02:03.76,0:02:05.74,Default - flashback,Ram,0,0,0,,Dobrze. Rób, co chcesz.
Dialogue: 0,0:02:05.83,0:02:08.60,Default - flashback,Ram,0,0,0,,Od tej chwili też będę robić, co chcę.
Dialogue: 0,0:02:16.77,0:02:17.65,Default - flashback,Subaru,0,0,0,,Ram...
Dialogue: 0,0:02:19.70,0:02:21.20,Default - flashback,Subaru,0,0,0,,Nie rób niczego szalonego.
Dialogue: 0,0:02:22.08,0:02:23.70,Default - flashback,Ram,0,0,0,,I kto to mówi, Barusu?
Dialogue: 0,0:02:23.79,0:02:24.84,Default - flashback,Ram,0,0,0,,Nie rozśmieszaj mnie.
Dialogue: 0,0:02:27.76,0:02:28.64,Default - flashback,Subaru,0,0,0,,Słuchajcie!
Dialogue: 0,0:02:28.83,0:02:31.18,Default - flashback,Subaru,0,0,0,,Wybaczcie całe to zamieszanie, ale...
Dialogue: 0,0:02:31.60,0:02:32.79,Default - flashback,Head,0,0,0,,Subaru,
Dialogue: 0,0:02:32.88,0:02:35.05,Default - flashback,Head,0,0,0,,nie musi się pan o nas martwić.
Dialogue: 0,0:02:35.48,0:02:39.70,Default - flashback,Head,0,0,0,,Nasz minister spraw wewnętrznych już\Nwszystko nam wyjaśnił.
Dialogue: 0,0:02:42.29,0:02:43.85,Default - flashback,Guy,0,0,0,,No już, ruszajcie!
Dialogue: 0,0:02:43.94,0:02:46.62,Default - flashback,Guy,0,0,0,,Ale gdy leci ci krew z nosa,\Nlepiej ją wytrzyj.
Dialogue: 0,0:02:46.71,0:02:48.62,Default - flashback,Guy,0,0,0,,Nie chcesz przecież zawieść Petry!
Dialogue: 0,0:02:49.01,0:02:50.79,Default - flashback,Subaru,0,0,0,,Dzięki, ludzie!
Dialogue: 0,0:02:50.88,0:02:51.76,Default - flashback,Subaru,0,0,0,,Ale...
Dialogue: 0,0:02:51.85,0:02:55.34,Default - flashback,Guy,0,0,0,,Subaru, proszę się poddać\Ni pozwolić nam pomóc!
Dialogue: 0,0:02:55.60,0:02:57.35,Default - flashback,Otto,0,0,0,,A kto jest ministrem spraw wewnę—
Dialogue: 0,0:02:57.44,0:02:59.03,Default - flashback,Subaru,0,0,0,,Ruszamy!
Dialogue: 0,0:04:29.88,0:04:33.79,Default,Ram,0,0,0,,Trzej idioci zaprzęgli powóz do bardzo\Nmądrego smoka lądowego
Dialogue: 0,0:04:33.88,0:04:35.62,Default,Ram,0,0,0,,i wyruszyli do posiadłości.
Dialogue: 0,0:04:36.45,0:04:38.24,Default,Emilia,0,0,0,,Dobrze, rozumiem.
Dialogue: 0,0:04:38.33,0:04:41.03,Default,Emilia,0,0,0,,Naprawdę, co ja mam z nim zrobić?
Dialogue: 0,0:04:41.12,0:04:42.26,Default,Ram,0,0,0,,To wszystko?
Dialogue: 0,0:04:42.62,0:04:44.92,Default,Emilia,0,0,0,,Chyba wciąż jestem trochę zła.
Dialogue: 0,0:04:45.40,0:04:48.96,Default,Emilia,0,0,0,,Czy Subaru naprawdę mówił serio,\Nkiedy powiedział, że mnie kocha?
Dialogue: 0,0:04:49.60,0:04:52.98,Default,Ram,0,0,0,,Barusu troszczy się o ciebie\Nbardziej niż o kogokolwiek.
Dialogue: 0,0:04:53.33,0:04:55.20,Default,Emilia,0,0,0,,Rozumiem. Dziękuję.
Dialogue: 0,0:04:55.29,0:04:58.98,Default,Ram,0,0,0,,Emilio, czy twój\Npowrót oznacza, że...
Dialogue: 0,0:04:59.07,0:05:00.19,Default,Emilia,0,0,0,,Próba?
Dialogue: 0,0:05:00.81,0:05:04.75,Default,Emilia,0,0,0,,Tak. Udało mi się zmierzyć\Nz własną przeszłością,
Dialogue: 0,0:05:04.84,0:05:06.57,Default,Emilia,0,0,0,,Czekają mnie jeszcze dwie próby.
Dialogue: 0,0:05:07.09,0:05:10.92,Default,Emilia,0,0,0,,Później będę musiała\Nznów wejść do grobowca.
Dialogue: 0,0:05:15.07,0:05:17.99,Default,Ram,0,0,0,,Naprawdę stałaś się silniejsza.
Dialogue: 0,0:05:20.20,0:05:22.96,Default,Ram,0,0,0,,Emilio, bardzo przepraszam.
Dialogue: 0,0:05:23.60,0:05:25.12,Default,Emilia,0,0,0,,Skąd nagle te przeprosiny?
Dialogue: 0,0:05:25.82,0:05:29.45,Default,Ram,0,0,0,,Po raz pierwszy naprawdę szczerze\Nchylę przed kimś głowę.
Dialogue: 0,0:05:31.22,0:05:35.62,Default,Ram,0,0,0,,Do tej pory nie wierzyłam,\Nże zdołasz się podnieść.
Dialogue: 0,0:05:36.78,0:05:39.92,Default,Ram,0,0,0,,A teraz stoisz przede mną,
Dialogue: 0,0:05:40.01,0:05:41.95,Default,Ram,0,0,0,,z wzrokiem skierowanym naprzód.
Dialogue: 0,0:05:42.50,0:05:45.90,Default,Ram,0,0,0,,Tracisz tylko kilka punktów za ślady łez.
Dialogue: 0,0:05:46.23,0:05:48.86,Default,Emilia,0,0,0,,Co? O nie!
Dialogue: 0,0:05:49.73,0:05:55.37,Default,Emilia,0,0,0,,Pomogłaś Subaru i Otto-kunowi, bo uważałaś\Nmnie za beksę?
Dialogue: 0,0:05:55.46,0:05:58.03,Default,Ram,0,0,0,,Nie bądź niemądra. To tobie pomogłam,
Dialogue: 0,0:05:58.12,0:06:01.21,Default,Ram,0,0,0,,i to ty sprawiłaś,\Nże pomoc stała się opłacalna.
Dialogue: 0,0:06:01.70,0:06:05.27,Default,Emilia,0,0,0,,Ja... naprawdę? Ale dlaczego?
Dialogue: 0,0:06:05.36,0:06:08.59,Default,Emilia,0,0,0,,Dlaczego postanowiłaś mi pomóc?
Dialogue: 0,0:06:09.36,0:06:13.96,Default,Ram,0,0,0,,Prosząc o coś, trzeba okazać szczerość.
Dialogue: 0,0:06:19.29,0:06:21.23,Default,Ram,0,0,0,,Błagam cię, Emilio.
Dialogue: 0,0:06:21.72,0:06:25.03,Default,Ram,0,0,0,,Proszę, uratuj mojego pana,\NRoswaala.
Dialogue: 0,0:06:25.47,0:06:26.74,Default,Emilia,0,0,0,,Roswaal?
Dialogue: 0,0:06:27.40,0:06:30.49,Default,Ram,0,0,0,,Opętały go urojenia.
Dialogue: 0,0:06:31.13,0:06:35.70,Default,Ram,0,0,0,,Od bardzo dawna krępują jego duszę\Nniczym klątwa.
Dialogue: 0,0:06:36.69,0:06:39.27,Default,Ram,0,0,0,,Być może nie miałabym nic przeciwko temu.
Dialogue: 0,0:06:39.70,0:06:41.89,Default,Ram,0,0,0,,Nawet gdyby na mnie nie patrzył,
Dialogue: 0,0:06:41.98,0:06:44.48,Default,Ram,0,0,0,,nawet gdyby uważał mnie\Ntylko za narzędzie...
Dialogue: 0,0:06:45.71,0:06:46.59,Default,Emilia,0,0,0,,Ram...
Dialogue: 0,0:06:47.28,0:06:51.26,Default,Ram,0,0,0,,Ale jego urojenia już sprowadziły go\Nz drogi prowadzącej do właściwego końca.
Dialogue: 0,0:06:51.87,0:06:53.88,Default,Ram,0,0,0,,Jego pragnienie straciło kierunek,
Dialogue: 0,0:06:53.97,0:06:57.63,Default,Ram,0,0,0,,a on trzyma się słów napisanych\Ntylko po to, by dobrze brzmiały.
Dialogue: 0,0:06:57.72,0:07:00.35,Default,Ram,0,0,0,,Proszę, przełam to.
Dialogue: 0,0:07:01.68,0:07:04.31,Default,Emilia,0,0,0,,Co mam zrobić?
Dialogue: 0,0:07:04.68,0:07:07.03,Default,Ram,0,0,0,,Zasiądź na królewskim tronie.
Dialogue: 0,0:07:09.78,0:07:12.74,Default,Ram,0,0,0,,Gdy zasiądziesz na tronie Luguniki,
Dialogue: 0,0:07:12.83,0:07:15.10,Default,Ram,0,0,0,,życzenie Roswaala się spełni.
Dialogue: 0,0:07:15.66,0:07:17.72,Default,Ram,0,0,0,,Choć tak długo błądził,
Dialogue: 0,0:07:17.81,0:07:20.36,Default,Ram,0,0,0,,nadejdzie dzień,\Nw którym jego życzenie się spełni.
Dialogue: 0,0:07:20.58,0:07:24.35,Default,Ram,0,0,0,,Proszę, powiedz o tym Roswaalowi.
Dialogue: 0,0:07:24.85,0:07:28.66,Default,Ram,0,0,0,,Daj mu powód, by żył\Nzarówno teraz, jak i w przyszłości.
Dialogue: 0,0:07:30.48,0:07:32.63,Default,Ram,0,0,0,,Proszę, Emilio.
Dialogue: 0,0:07:35.04,0:07:37.60,Default,Ram,0,0,0,,Proszę, uratuj go.
Dialogue: 0,0:07:49.49,0:07:55.49,Default,Emilia,0,0,0,,Nie bardzo rozumiem,\Njak moje panowanie ma uratować Roswaala.
Dialogue: 0,0:07:56.24,0:08:01.34,Default,Emilia,0,0,0,,Chyba jeszcze nie potrafię\Nw pełni zrozumieć także twoich pragnień.
Dialogue: 0,0:08:02.21,0:08:03.09,Default,Emilia,0,0,0,,Ale...
Dialogue: 0,0:08:03.46,0:08:07.79,Default,Emilia,0,0,0,,Po raz pierwszy\No cokolwiek mnie prosisz.
Dialogue: 0,0:08:09.50,0:08:10.59,Default,Emilia,0,0,0,,Dobrze, Ram.
Dialogue: 0,0:08:11.14,0:08:14.87,Default,Emilia,0,0,0,,Uwierzyłaś we mnie,\Na ja chcę ci się odwdzięczyć.
Dialogue: 0,0:08:15.25,0:08:19.35,Default,Emilia,0,0,0,,Jestem pewna, że teraz muszę zacząć\Ndziałać sama.
Dialogue: 0,0:08:32.53,0:08:34.52,Default,Roswaal,0,0,0,,Czy mogę...
Dialogue: 0,0:08:34.61,0:08:38.70,Default,Roswaal,0,0,0,,złożyć ci również swoje gratulacje?
Dialogue: 0,0:08:45.67,0:08:47.07,Default,Emilia,0,0,0,,Wystarczy. Ani kroku bliżej.
Dialogue: 0,0:08:47.88,0:08:49.96,Default,Roswaal,0,0,0,,No proszę...
Dialogue: 0,0:08:50.05,0:08:53.53,Default,Roswaal,0,0,0,,Cóż za wspaniałe powitanie, Emilio.
Dialogue: 0,0:08:53.62,0:08:57.80,Default,Roswaal,0,0,0,,Wbrew pozorom\Nszczerze się o ciebie martwię.
Dialogue: 0,0:08:57.89,0:09:00.73,Default,Roswaal,0,0,0,,Można nawet powiedzieć,\Nże mi cię żal.
Dialogue: 0,0:09:00.82,0:09:02.71,Default,Emilia,0,0,0,,Żal... mnie?
Dialogue: 0,0:09:02.80,0:09:06.51,Default,Roswaal,0,0,0,,Tak, z całego serca mi cię żal.
Dialogue: 0,0:09:06.60,0:09:10.90,Default,Roswaal,0,0,0,,Nie wiesz, jak być kochaną inaczej niż\Nprzez spełnianie cudzych oczekiwań,
Dialogue: 0,0:09:10.99,0:09:14.86,Default,Roswaal,0,0,0,,a mimo to musisz stawić czoła\Nprzeszłości, której nigdy nie chciałaś.
Dialogue: 0,0:09:16.21,0:09:18.82,Default,Roswaal,0,0,0,,Pozwól, że ci pogratuluję,
Dialogue: 0,0:09:19.32,0:09:23.08,Default,Roswaal,0,0,0,,z całym współczuciem i litością,\Nna jakie mnie stać.
Dialogue: 0,0:09:23.17,0:09:25.72,Default,Roswaal,0,0,0,,Brawo za pokonanie próby!
Dialogue: 0,0:09:25.81,0:09:28.83,Default,Roswaal,0,0,0,,Byłem przekonany,\Nże nie jesteś do tego zdolna.
Dialogue: 0,0:09:29.57,0:09:32.56,Default,Emilia,0,0,0,,Trudno mi dziękować,\Ngdy gratulujesz w taki sposób.
Dialogue: 0,0:09:33.09,0:09:36.09,Default,Emilia,0,0,0,,Mówiłeś, że nie dam rady.
Dialogue: 0,0:09:36.18,0:09:37.80,Default,Emilia,0,0,0,,Zmieniłeś zdanie?
Dialogue: 0,0:09:39.40,0:09:42.31,Default,Emilia,0,0,0,,Masz rację. Wiem,\Nże przysporzyłam ci wielu zmartwień.
Dialogue: 0,0:09:43.29,0:09:45.66,Default,Emilia,0,0,0,,Potrafiłam tylko się załamywać.
Dialogue: 0,0:09:46.08,0:09:50.27,Default,Emilia,0,0,0,,Przysporzyłam tylu kłopotów Puckowi,\NSubaru... wszystkim.
Dialogue: 0,0:09:50.85,0:09:53.58,Default,Emilia,0,0,0,,Ale wszyscy mnie uratowali.
Dialogue: 0,0:09:53.97,0:09:55.68,Default,Emilia,0,0,0,,Byłam zupełnie bezużyteczna,
Dialogue: 0,0:09:55.77,0:09:57.67,Default,Emilia,0,0,0,,a oni wyciągnęli do mnie pomocną dłoń.
Dialogue: 0,0:09:57.77,0:10:01.55,Default,Emilia,0,0,0,,Zrozumiałam,\Nże nie mogę ciągle się załamywać.
Dialogue: 0,0:10:04.52,0:10:07.31,Default,Roswaal,0,0,0,,Mówisz to samo co Subaru.
Dialogue: 0,0:10:07.40,0:10:09.86,Default,Roswaal,0,0,0,,Tylko powtarzasz jego słowa?
Dialogue: 0,0:10:09.95,0:10:10.83,Default,Ram,0,0,0,,Roswaalu!
Dialogue: 0,0:10:11.09,0:10:14.27,Default,Roswaal,0,0,0,,Pożyczone słowa i miejsce, które dla\Nciebie przygotowano,
Dialogue: 0,0:10:14.36,0:10:18.92,Default,Roswaal,0,0,0,,a nawet udział w próbie — wszystko\Nwybrałaś, gdy już przygotowano warunki.
Dialogue: 0,0:10:19.01,0:10:22.89,Default,Roswaal,0,0,0,,A mimo tej wiedzy Subaru\Nnakłania cię do okropnych rzeczy.
Dialogue: 0,0:10:22.98,0:10:25.05,Default,Emilia,0,0,0,,To nieprawda! Subaru chce—
Dialogue: 0,0:10:25.14,0:10:26.40,Default,Roswaal,0,0,0,,Oboje go znamy.
Dialogue: 0,0:10:26.49,0:10:28.50,Default,Roswaal,0,0,0,,Nie przemawiał logiką ani rozsądkiem,
Dialogue: 0,0:10:28.59,0:10:31.74,Default,Roswaal,0,0,0,,a jedynie wygłosił wyjątkowo głośną\Nmowę motywacyjną. Czyż nie?
Dialogue: 0,0:10:32.16,0:10:33.92,Default,Roswaal,0,0,0,,Narzucił ci własne samozadowolenie,
Dialogue: 0,0:10:34.01,0:10:38.04,Default,Roswaal,0,0,0,,emocjonalnie zapewniając, że dasz radę,\Nzmusił cię do wpisania się w jego ideał.
Dialogue: 0,0:10:38.13,0:10:40.75,Default,Roswaal,0,0,0,,Rozumiem. Naprawdę rozumiem.
Dialogue: 0,0:10:40.84,0:10:42.70,Default,Roswaal,0,0,0,,W końcu on i ja...
Dialogue: 0,0:10:43.05,0:10:45.66,Default,Roswaal,0,0,0,,jesteśmy tacy sami.
Dialogue: 0,0:10:46.42,0:10:49.26,Default,Emilia,0,0,0,,Ty i Subaru jesteście tacy sami?
Dialogue: 0,0:10:49.35,0:10:50.66,Default,Emilia,0,0,0,,Co masz na myśli?
Dialogue: 0,0:10:50.75,0:10:54.80,Default,Roswaal,0,0,0,,Obaj narzucamy swoje ideały\Nkobietom, które kochamy.
Dialogue: 0,0:10:56.35,0:10:58.28,Default,Roswaal,0,0,0,,Na pewno cię rozpieszcza
Dialogue: 0,0:10:58.37,0:11:01.13,Default,Roswaal,0,0,0,,i traktuje z największą troską i\Nżyczliwością.
Dialogue: 0,0:11:01.22,0:11:05.65,Default,Roswaal,0,0,0,,Nawet nie pomyślał, że nie jesteś\Nzwyczajną dziewczyną, prawda?
Dialogue: 0,0:11:05.74,0:11:10.39,Default,Roswaal,0,0,0,,Kocha idealną wersję ciebie,\Nktóra istnieje w jego wyobraźni.
Dialogue: 0,0:11:11.20,0:11:12.35,Default,Roswaal,0,0,0,,Mylę się?
Dialogue: 0,0:11:19.97,0:11:21.03,Default,Emilia,0,0,0,,To wszystko?
Dialogue: 0,0:11:21.86,0:11:26.60,Default,Emilia,0,0,0,,Tylko przez to sądzisz,\Nże jesteście podobni?
Dialogue: 0,0:11:27.53,0:11:29.60,Default,Emilia,0,0,0,,Jeśli tylko to chciałeś powiedzieć...
Dialogue: 0,0:11:30.15,0:11:33.47,Default,Emilia,0,0,0,,Ty i Subaru wcale nie jesteście tacy sami.
Dialogue: 0,0:11:34.74,0:11:39.13,Default,Emilia,0,0,0,,Subaru powiedział,\Nże jestem wrzodem na tyłku.
Dialogue: 0,0:11:39.54,0:11:40.42,Default,Roswaal,0,0,0,,Co?
Dialogue: 0,0:11:40.63,0:11:45.05,Default,Emilia,0,0,0,,Spytał, kim jestem, by mu przeszkadzać\Npo tym wszystkim, co dla mnie zrobił.
Dialogue: 0,0:11:46.58,0:11:49.86,Default,Emilia,0,0,0,,Kazał mi przestać rozpamiętywać\Nto, co już minęło.
Dialogue: 0,0:11:50.75,0:11:54.15,Default,Emilia,0,0,0,,Powiedział, że tylko gadam\Ni że dłużej tego nie zniesie.
Dialogue: 0,0:11:55.01,0:11:57.57,Default,Emilia,0,0,0,,I we wszystkim miał rację.
Dialogue: 0,0:11:57.98,0:12:02.61,Default,Emilia,0,0,0,,Byłam słaba, tylko gadałam\Ni pod każdym względem zawodziłam.
Dialogue: 0,0:12:03.28,0:12:06.11,Default,Emilia,0,0,0,,Subaru naprawdę widzi\Nmnie taką, jaka jestem.
Dialogue: 0,0:12:06.66,0:12:10.18,Default,Emilia,0,0,0,,Dlatego wiem, że wcale\Nnie jesteście podobni.
Dialogue: 0,0:12:13.14,0:12:14.79,Default,Emilia,0,0,0,,Kiedy chcę coś zrobić,
Dialogue: 0,0:12:15.23,0:12:17.17,Default,Emilia,0,0,0,,kiedy pragnę się zmienić,
Dialogue: 0,0:12:17.26,0:12:20.15,Default,Emilia,0,0,0,,on bierze mnie za rękę i mi pomaga.
Dialogue: 0,0:12:20.24,0:12:22.92,Default,Emilia,0,0,0,,Pokazał, że są ludzie,\Nktórzy mówią mi takie rzeczy.
Dialogue: 0,0:12:23.01,0:12:25.48,Default,Roswaal,0,0,0,,Nie sądzisz, że mógł\Ncię po prostu zwodzić?
Dialogue: 0,0:12:25.57,0:12:28.12,Default,Roswaal,0,0,0,,Tylko po to, by umiejętnie postawić cię na\Nnogi?
Dialogue: 0,0:12:28.21,0:12:30.48,Default,Emilia,0,0,0,,Nie. Nie kłamał.
Dialogue: 0,0:12:30.88,0:12:34.63,Default,Emilia,0,0,0,,To, co czuł Subaru, gdy mówił, że we\Nmnie wierzy, nie stanie się kłamstwem.
Dialogue: 0,0:12:35.06,0:12:36.19,Default,Emilia,0,0,0,,Nie pozwolę na to.
Dialogue: 0,0:12:36.63,0:12:38.08,Default,Emilia,0,0,0,,Zamienię kłamstwa w życzenia.
Dialogue: 0,0:12:38.62,0:12:42.77,Default,Emilia,0,0,0,,Właśnie to muszę teraz zrobić\Ni właśnie tego chcę.
Dialogue: 0,0:12:50.10,0:12:52.72,Default,Roswaal,0,0,0,,Ty wciąż się zmieniasz.
Dialogue: 0,0:12:54.53,0:12:58.67,Default,Roswaal,0,0,0,,Niezwykle trudno mi to zaakceptować.
Dialogue: 0,0:13:02.29,0:13:03.47,Default,Emilia,0,0,0,,Roswaal?
Dialogue: 0,0:13:04.36,0:13:06.12,Default,Roswaal,0,0,0,,Twoja decyzja jest bezcenna,
Dialogue: 0,0:13:06.21,0:13:08.43,Default,Roswaal,0,0,0,,a wola dalszego marszu — szlachetna.
Dialogue: 0,0:13:08.93,0:13:12.10,Default,Roswaal,0,0,0,,Właśnie dlatego mi cię żal.
Dialogue: 0,0:13:12.85,0:13:16.01,Default,Roswaal,0,0,0,,Decyzja, przez którą uznajesz\Nswoje cierpienie za uzasadnione,
Dialogue: 0,0:13:16.10,0:13:19.18,Default,Roswaal,0,0,0,,już nie ma znaczenia w świecie,\Nktóry wkrótce się skończy.
Dialogue: 0,0:13:19.27,0:13:21.19,Default,Emilia,0,0,0,,Świat... się skończy?
Dialogue: 0,0:13:21.28,0:13:24.57,Default,Roswaal,0,0,0,,Ściślej mówiąc, zmierza ku końcowi.
Dialogue: 0,0:13:24.93,0:13:27.08,Default,Roswaal,0,0,0,,Ten świat zboczył z właściwej drogi
Dialogue: 0,0:13:27.17,0:13:30.20,Default,Roswaal,0,0,0,,i zmierza teraz\Nku niewłaściwemu celowi.
Dialogue: 0,0:13:30.29,0:13:33.62,Default,Roswaal,0,0,0,,Sanktuarium i królewska elekcja\Nstraciły już wszelkie znaczenie.
Dialogue: 0,0:13:34.03,0:13:35.10,Default,Emilia,0,0,0,,Roswaal?
Dialogue: 0,0:13:35.61,0:13:37.71,Default,Emilia,0,0,0,,Dlaczego brzmisz, jakbyś się poddał?
Dialogue: 0,0:13:38.09,0:13:41.48,Default,Emilia,0,0,0,,Czy to nie my...\NCzy to nie ty i ja zaczęliśmy tę drogę?
Dialogue: 0,0:13:41.57,0:13:44.63,Default,Emilia,0,0,0,,Chcesz się poddać przed końcem?\NNie pozwolę na to!
Dialogue: 0,0:13:45.48,0:13:48.34,Default,Roswaal,0,0,0,,Co zatem zamierzasz zrobić?
Dialogue: 0,0:13:48.57,0:13:50.24,Default,Emilia,0,0,0,,Nie wiem!
Dialogue: 0,0:13:50.33,0:13:52.43,Default,Emilia,0,0,0,,Ale to, co złe, pozostaje złe!
Dialogue: 0,0:13:52.52,0:13:53.71,Default,Emilia,0,0,0,,Nie poddawaj się!
Dialogue: 0,0:13:53.80,0:13:55.60,Default,Emilia,0,0,0,,To zbyt samolubne!
Dialogue: 0,0:13:56.48,0:14:00.14,Default,Roswaal,0,0,0,,Naprawdę brzmisz zupełnie jak Subaru-kun.
Dialogue: 0,0:14:01.67,0:14:07.18,Default,Roswaal,0,0,0,,Ciekawe, ile z twoich chełpliwych słów\Nmoże się urzeczywistnić.
Dialogue: 0,0:14:07.55,0:14:10.97,Default,Emilia,0,0,0,,Zaraz ci to pokażę.
Dialogue: 0,0:14:11.06,0:14:15.00,Default,Emilia,0,0,0,,W grobowcu... nie,\Nrównież poza Sanktuarium.
Dialogue: 0,0:14:16.86,0:14:18.09,Default,Ram,0,0,0,,Emilio...
Dialogue: 0,0:14:18.18,0:14:19.91,Default,Emilia,0,0,0,,Idę już, Ram.
Dialogue: 0,0:14:20.00,0:14:23.96,Default,Emilia,0,0,0,,Obiecuję, że spełnię prośbę,\Nktórą mi powierzyłaś.
Dialogue: 0,0:14:33.35,0:14:36.23,Default,Roswaal,0,0,0,,To ja i moja nauczycielka\Ndaliśmy temu początek.
Dialogue: 0,0:14:36.32,0:14:39.82,Default,Roswaal,0,0,0,,Tylko w tej jednej kwestii\Nsię pomyliłaś, Emilio.
Dialogue: 0,0:14:51.62,0:14:56.51,Default,Roswaal,0,0,0,,Jej determinacja jest najwyraźniej\Nznacznie silniejsza, niż sądziłem.
Dialogue: 0,0:14:56.99,0:15:00.87,Default,Ram,0,0,0,,Roswaalu, ile z naszej rozmowy słyszałeś?
Dialogue: 0,0:15:00.96,0:15:04.21,Default,Roswaal,0,0,0,,Widziałem, jak przed nią klękasz.
Dialogue: 0,0:15:04.30,0:15:06.17,Default,Roswaal,0,0,0,,Niezła z ciebie aktorka.
Dialogue: 0,0:15:06.77,0:15:11.38,Default,Roswaal,0,0,0,,Słyszałem, że pomogłaś im\Nw sprawie Garfiela.
Dialogue: 0,0:15:11.47,0:15:14.89,Default,Roswaal,0,0,0,,Oczywiście wiem, że uważałaś to\Nza słuszne posunięcie.
Dialogue: 0,0:15:15.69,0:15:19.56,Default,Ram,0,0,0,,Co zamierzasz teraz zrobić?
Dialogue: 0,0:15:20.10,0:15:23.43,Default,Roswaal,0,0,0,,Moje pragnienie się nie zmieniło,
Dialogue: 0,0:15:23.81,0:15:26.65,Default,Roswaal,0,0,0,,choć teraz muszę się\Nnieco bardziej postarać.
Dialogue: 0,0:15:26.74,0:15:27.62,Default,Ram,0,0,0,,Co mam...
Dialogue: 0,0:15:27.71,0:15:30.75,Default,Roswaal,0,0,0,,Zostań tu i czekaj na powrót Emilii.
Dialogue: 0,0:15:30.98,0:15:33.95,Default,Roswaal,0,0,0,,Gdyby nikt nie powitał jej odważnej duszy\Npo powrocie,
Dialogue: 0,0:15:34.04,0:15:38.37,Default,Roswaal,0,0,0,,nawet mnie zrobiłoby się jej żal.
Dialogue: 0,0:15:48.64,0:15:54.32,Default - italics,Ram,0,0,0,,Przyjęłam zakład, bo wydawał się\Nnajlepszą szansą na spełnienie życzenia.
Dialogue: 0,0:15:55.62,0:15:57.04,Default - flashback,Otto,0,0,0,,Witaj, Ram.
Dialogue: 0,0:15:57.67,0:16:00.77,Default - flashback,Otto,0,0,0,,Piękny wieczór, prawda?\NWietrzyk jest taki chłodny.
Dialogue: 0,0:16:01.54,0:16:03.64,Default - flashback,Ram,0,0,0,,Jesteś tym chłopakiem,\Nktóry był z Barusu.
Dialogue: 0,0:16:03.73,0:16:07.75,Default - flashback,Otto,0,0,0,,Natsuki chyba nie potrafi\Nwidzieć w tobie wroga.
Dialogue: 0,0:16:07.84,0:16:08.82,Default - flashback,Otto,0,0,0,,Jeśli ma rację,
Dialogue: 0,0:16:09.20,0:16:14.20,Default - flashback,Otto,0,0,0,,możemy ci pomóc zdobyć to,\Nczego {\i1}naprawdę{\i0} pragniesz.
Dialogue: 0,0:16:15.73,0:16:16.70,Default - flashback,Ram,0,0,0,,Ale irytujące.
Dialogue: 0,0:16:17.01,0:16:17.89,Default - flashback,Otto,0,0,0,,Co?
Dialogue: 0,0:16:17.98,0:16:20.38,Default - flashback,Ram,0,0,0,,Powiedziałam, że jesteś irytujący.
Dialogue: 0,0:16:21.20,0:16:22.70,Default - flashback,Ram,0,0,0,,Podaj więcej szczegółów.
Dialogue: 0,0:16:24.74,0:16:26.29,Default - flashback,Otto,0,0,0,,Taki jest mój pomysł.
Dialogue: 0,0:16:26.38,0:16:27.74,Default - flashback,,0,0,0,,Co o nim sądzisz?
Dialogue: 0,0:16:31.02,0:16:33.97,Default - flashback,Ram,0,0,0,,Jeśli chcesz mojej pomocy,\Nmam trzy warunki.
Dialogue: 0,0:16:34.51,0:16:38.47,Default - flashback,Ram,0,0,0,,Po pierwsze, z całego serca popieram\Nutarcie nosa Garfielowi.
Dialogue: 0,0:16:38.56,0:16:42.63,Default - flashback,Ram,0,0,0,,Ale potem musicie zostawić go w moich\Nrękach.
Dialogue: 0,0:16:43.07,0:16:43.98,Default - flashback,Otto,0,0,0,,Jasne.
Dialogue: 0,0:16:44.70,0:16:46.32,Default - flashback,Ram,0,0,0,,Następna jest Emilia.
Dialogue: 0,0:16:46.87,0:16:48.81,Default - flashback,Ram,0,0,0,,Niech Barusu coś z nią zrobi.
Dialogue: 0,0:16:48.90,0:16:52.36,Default - flashback,Otto,0,0,0,,To chyba będzie zależeć\Nod Natsukiego i Emilii.
Dialogue: 0,0:16:52.87,0:16:56.11,Default - flashback,Otto,0,0,0,,Mam przeczucie, że trzeci warunek\Nbędzie naprawdę ciężki.
Dialogue: 0,0:16:56.47,0:16:57.48,Default - flashback,Ram,0,0,0,,Głupcze.
Dialogue: 0,0:16:57.57,0:17:01.87,Default - flashback,Ram,0,0,0,,Tylko nie mów Barusu,\Ndlaczego przyjęłam ten zakład.
Dialogue: 0,0:17:02.58,0:17:04.89,Default - flashback,Ram,0,0,0,,Nie chcę rezygnować\Nz mojego ostatniego planu.
Dialogue: 0,0:17:18.44,0:17:24.03,Default,Roswaal,0,0,0,,Przy użyciu jasnowidzenia łatwo tu trafić.
Dialogue: 0,0:17:24.76,0:17:28.92,Default,Roswaal,0,0,0,,Czy nie kazałem ci czekać na Emilię?
Dialogue: 0,0:17:29.01,0:17:31.04,Default,Ram,0,0,0,,Tak, kazałeś.
Dialogue: 0,0:17:31.13,0:17:32.57,Default,Roswaal,0,0,0,,Więc powiedz mi.
Dialogue: 0,0:17:32.90,0:17:36.78,Default,Roswaal,0,0,0,,Z jakiego powodu tu przyszłaś?
Dialogue: 0,0:17:37.26,0:17:38.53,Default,Ram,0,0,0,,To proste.
Dialogue: 0,0:17:39.14,0:17:40.71,Default,Ram,0,0,0,,Przyszłam cię zabrać...
Dialogue: 0,0:17:42.03,0:17:44.87,Default,Ram,0,0,0,,z objęć urojeń czarownicy.
Dialogue: 0,0:17:46.24,0:17:48.94,Default,Roswaal,0,0,0,,Urojeń, powiadasz?
Dialogue: 0,0:17:49.03,0:17:52.11,Default,Roswaal,0,0,0,,Minęło kilka lat, odkąd ostatnio\Nwymierzyłaś we mnie różdżkę,
Dialogue: 0,0:17:52.20,0:17:56.18,Default,Roswaal,0,0,0,,ale szkoda, że zrobiłaś to tutaj\Ni nazwałaś je „urojeniami”.
Dialogue: 0,0:17:56.27,0:17:59.49,Default,Ram,0,0,0,,Zawsze tak o nich myślałam.\NTylko nie mówiłam tego na głos.
Dialogue: 0,0:17:59.58,0:18:00.93,Default,Ram,0,0,0,,Czy to nie oczywiste?
Dialogue: 0,0:18:01.14,0:18:02.41,Default,Roswaal,0,0,0,,Oczywiste...
Dialogue: 0,0:18:02.93,0:18:08.44,Default,Roswaal,0,0,0,,Z twojej perspektywy upokarzające dni,\Nw których mi ulegałaś, trwały długo.
Dialogue: 0,0:18:09.22,0:18:13.11,Default,Roswaal,0,0,0,,Uważałem twoje zachowanie\Nza sposób okazywania oddania.
Dialogue: 0,0:18:14.83,0:18:18.16,Default,Ram,0,0,0,,Pobicie Garfa służyło dwóm celom:\Nrealizacji mojego planu
Dialogue: 0,0:18:18.25,0:18:21.20,Default,Ram,0,0,0,,i próbie wybicia mu głupoty z głowy.
Dialogue: 0,0:18:21.72,0:18:25.41,Default,Ram,0,0,0,,Nie mam pojęcia, co zamierzali zrobić,\Ngdyby mnie tam nie było.
Dialogue: 0,0:18:25.80,0:18:30.21,Default,Roswaal,0,0,0,,Nie mogę zaprzeczyć, że ostatecznie\Nwszystko dobrze się skończyło.
Dialogue: 0,0:18:30.30,0:18:35.05,Default,Roswaal,0,0,0,,Subaru z pewnością wybierze ryzykowną\Ndrogę w ostatecznym starciu.
Dialogue: 0,0:18:35.14,0:18:38.56,Default,Ram,0,0,0,,Ale Barusu ma jedną zaletę:\Nwyczucie czasu.
Dialogue: 0,0:18:39.02,0:18:42.97,Default,Ram,0,0,0,,Postawienie na jego jedyną zaletę\Nnie było błędem.
Dialogue: 0,0:18:45.38,0:18:47.73,Default,Ram,0,0,0,,Masz księgę, prawda?
Dialogue: 0,0:18:50.49,0:18:52.89,Default,Ram,0,0,0,,W miejscu wyznaczonym\Nna ostateczne starcie,
Dialogue: 0,0:18:52.98,0:18:55.91,Default,Ram,0,0,0,,na etapie, w którym sam\Nprzystępujesz do akcji,
Dialogue: 0,0:18:56.29,0:19:01.41,Default,Ram,0,0,0,,na pewno masz ze sobą Księgę Mądrości,\Nna której polegasz najbardziej.
Dialogue: 0,0:19:03.30,0:19:05.64,Default,Roswaal,0,0,0,,Ani razu nie zapomniałem
Dialogue: 0,0:19:05.73,0:19:10.12,Default,Roswaal,0,0,0,,o jedynej przysiędze,\Nktórą sobie złożyliśmy.
Dialogue: 0,0:19:10.58,0:19:12.63,Default,Ram,0,0,0,,Kto mieczem wojuje, od miecza ginie,
Dialogue: 0,0:19:12.72,0:19:14.63,Default,Ram,0,0,0,,kto polega na magii, zginie od niej,
Dialogue: 0,0:19:14.72,0:19:17.22,Default,Ram,0,0,0,,a kto oddaje się ogniowi,\Npowinien zginąć w ogniu.
Dialogue: 0,0:19:17.65,0:19:20.84,Default,Roswaal,0,0,0,,Kto prosi demona o przysługę,\Npowinien zginąć z jego ręki.
Dialogue: 0,0:19:21.35,0:19:25.68,Default,Roswaal,0,0,0,,To, na czym ktoś polega,\Npowinno przynieść mu śmierć.
Dialogue: 0,0:19:26.71,0:19:28.87,Default,Roswaal,0,0,0,,A teraz nadszedł czas.
Dialogue: 0,0:19:28.96,0:19:33.65,Default,Roswaal,0,0,0,,Skoro straciłem to, czego pragnąłem,\Noddaję się w twoje ręce.
Dialogue: 0,0:19:33.86,0:19:36.36,Default,Roswaal,0,0,0,,Jeśli nie przeszkadza ci, że jestem pustą\Nskorupą,
Dialogue: 0,0:19:36.45,0:19:39.91,Default,Roswaal,0,0,0,,możesz zrobić ze mną, co zechcesz.\NTaka była nasza przysięga.
Dialogue: 0,0:19:40.00,0:19:42.45,Default,Ram,0,0,0,,To ja zdecyduję, czy przeżyjesz.
Dialogue: 0,0:19:42.54,0:19:45.60,Default,Roswaal,0,0,0,,Wreszcie możesz dokonać zemsty.
Dialogue: 0,0:19:48.48,0:19:49.70,Default,Roswaal,0,0,0,,W końcu...
Dialogue: 0,0:19:50.28,0:19:53.14,Default,Roswaal,0,0,0,,Nie miałaś wyboru i wbrew sobie\Nprzysięgłaś lojalność
Dialogue: 0,0:19:53.23,0:19:57.13,Default,Roswaal,0,0,0,,jednemu z ludzi, którzy zniszczyli twoją\Nojczyznę, i byłaś zmuszona z nim żyć.
Dialogue: 0,0:19:57.22,0:20:02.82,Default,Roswaal,0,0,0,,Choć uczyniłaś to po utracie rogu i\Nzdolności do zachowania swej postaci,
Dialogue: 0,0:20:02.91,0:20:05.46,Default,Roswaal,0,0,0,,tak skrajne cierpienie zdarza się\Nniezwykle rzadko.
Dialogue: 0,0:20:06.02,0:20:08.92,Default,Roswaal,0,0,0,,Nie ma bardziej użytecznego pionka niż ty.
Dialogue: 0,0:20:09.01,0:20:11.28,Default,Roswaal,0,0,0,,Dlatego tak wielka szkoda...
Dialogue: 0,0:20:11.37,0:20:13.39,Default,Roswaal,0,0,0,,Twoja decyzja była tylko odrobinę...
Dialogue: 0,0:20:13.73,0:20:15.43,Default,Roswaal,0,0,0,,przedwczesna.
Dialogue: 0,0:20:15.52,0:20:20.63,Default,Roswaal,0,0,0,,To imponujące, że zmusiłaś mnie\Ndo zabrania Księgi Mądrości.
Dialogue: 0,0:20:20.72,0:20:25.56,Default,Roswaal,0,0,0,,Powinnaś była przeoczyć ostatni krok\Nprowadzący do planowanego działania.
Dialogue: 0,0:20:25.65,0:20:27.53,Default,Roswaal,0,0,0,,I tylko tego naprawdę żałuję!
Dialogue: 0,0:20:31.65,0:20:33.90,Default,Roswaal,0,0,0,,Oto cenna dziewczyna, która oddała swe\Nżycie,
Dialogue: 0,0:20:33.99,0:20:37.34,Default,Roswaal,0,0,0,,by ocalić przyjaciółkę,\Nstając się rdzeniem Sanktuarium.
Dialogue: 0,0:20:37.99,0:20:40.84,Default,Roswaal,0,0,0,,Ale mój cel jej nie dotyczy.
Dialogue: 0,0:20:41.83,0:20:45.76,Default,Ram,0,0,0,,Chcesz użyć tego magicznego kryształu\Ndo rzucenia potężnego zaklęcia?
Dialogue: 0,0:20:46.05,0:20:48.69,Default,Roswaal,0,0,0,,Dość potężnego, by zmienić pogodę.
Dialogue: 0,0:20:48.78,0:20:52.63,Default,Roswaal,0,0,0,,Zgodnie z Księgą sprawię,\Nże w Sanktuarium spadnie śnieg.
Dialogue: 0,0:20:52.72,0:20:55.06,Default,Roswaal,0,0,0,,Aby użyć tej magii,
Dialogue: 0,0:20:55.94,0:21:00.28,Default,Roswaal,0,0,0,,potrzebuję ogromnego skupienia\Ni niezwykle precyzyjnej kontroli many.
Dialogue: 0,0:21:00.37,0:21:03.68,Default,Roswaal,0,0,0,,Gdybym się tym zajmował,\Nz całą pewnością
Dialogue: 0,0:21:03.77,0:21:05.45,Default,Roswaal,0,0,0,,mogłabyś mnie trafić.
Dialogue: 0,0:21:06.40,0:21:09.16,Default,Ram,0,0,0,,To nie miałoby żadnego znaczenia.
Dialogue: 0,0:21:09.45,0:21:13.56,Default,Roswaal,0,0,0,,A zmuszenie mnie do kapitulacji,\Ngdy jestem w pełni sił, ma znaczenie?
Dialogue: 0,0:21:13.65,0:21:17.17,Default,Roswaal,0,0,0,,Czy po prostu chciałaś\Njak najszybciej mnie zniszczyć?
Dialogue: 0,0:21:17.51,0:21:21.50,Default,Ram,0,0,0,,Nie. Naprawdę niczego nie rozumiesz.
Dialogue: 0,0:21:25.84,0:21:28.05,Default,Ram,0,0,0,,Nie pozwolę, by twoje\Nżyczenie się spełniło.
Dialogue: 0,0:21:28.33,0:21:32.97,Default,Ram,0,0,0,,Gdybyś po spełnieniu życzenia oddał mi\Npustą skorupę, nic by to nie znaczyło.
Dialogue: 0,0:21:33.54,0:21:36.94,Default,Ram,0,0,0,,Nie zadowoliłoby mnie przyjęcie cię\Nzłamanego.
Dialogue: 0,0:21:37.24,0:21:39.98,Default,Roswaal,0,0,0,,No proszę, jaka zachłanna.
Dialogue: 0,0:21:40.37,0:21:43.07,Default,Roswaal,0,0,0,,Ale sądzisz, że zdołasz\Nmnie teraz pokonać?
Dialogue: 0,0:21:43.49,0:21:45.39,Default,Ram,0,0,0,,Nie, na pewno nie zdołam.
Dialogue: 0,0:21:45.48,0:21:49.72,Default,Ram,0,0,0,,Tylko twoja nauczycielka zna twoją moc\Nlepiej ode mnie.
Dialogue: 0,0:21:49.81,0:21:54.91,Default,Roswaal,0,0,0,,Jak więc dokładnie\Nzamierzasz osiągnąć swój cel?
Dialogue: 0,0:21:57.20,0:21:58.62,Default,Ram,0,0,0,,Sama nie zdołam wygrać.
Dialogue: 0,0:21:58.99,0:22:01.60,Default,Ram,0,0,0,,To oczywiste. Dlatego...
Dialogue: 0,0:22:04.76,0:22:07.97,Default,Puck,0,0,0,,Jeśli jest nas dwoje przeciw jednemu,\Nto chyba mamy przewagę?
Dialogue: 0,0:22:09.24,0:22:13.72,Default,Roswaal,0,0,0,,Więc przede wszystkim dlatego\Nzgodziłaś się na plan Subaru?!
Dialogue: 0,0:22:13.81,0:22:16.06,Default,Ram,0,0,0,,Mówiłam ci, Roswaalu.
Dialogue: 0,0:22:16.84,0:22:20.48,Default,Ram,0,0,0,,Zabiorę cię z objęć urojeń czarownicy.
Dialogue: 0,0:22:23.07,0:22:26.85,Default,Puck,0,0,0,,A ja jestem tylko zabłąkanym duchem,\Nktóry akurat tędy przechodził.
Dialogue: 0,0:22:27.63,0:22:31.47,Default,Puck,0,0,0,,No dobrze, czas dokończyć to,\Nco wcześniej przerwaliśmy!
Dialogue: 0,0:22:34.77,0:22:35.79,Default,Roswaal,0,0,0,,Chodź!
Dialogue: 0,0:22:37.59,0:22:38.92,Default,Puck,0,0,0,,Jak sobie życzysz!
Dialogue: 0,0:22:49.14,0:22:51.34,Default,Petra,0,0,0,,Muszę biec... Muszę biec!
Dialogue: 0,0:22:55.11,0:22:56.56,Default,Petra,0,0,0,,Rem?
Dialogue: 0,0:22:57.46,0:23:00.27,Default,Petra,0,0,0,,Ale... Ale, ale... To niemożliwe...
Dialogue: 0,0:23:00.88,0:23:03.27,Default,Petra,0,0,0,,Ale... Rem jest...
Dialogue: 0,0:23:07.14,0:23:10.14,Default,Petra,0,0,0,,Ale... wiem, że Subaru\Nwłaśnie tak by postąpił!
Dialogue: 0,0:23:11.12,0:23:12.00,Default,Petra,0,0,0,,Więc...
Dialogue: 0,0:23:18.18,0:23:19.21,Default,Petra,0,0,0,,Rem...
Dialogue: 0,0:23:24.42,0:23:26.67,Default,Elsa,0,0,0,,Ojej, co za urocza dziewczynka.
Dialogue: 0,0:23:33.20,0:23:35.89,Default,Elsa,0,0,0,,Ty musisz być tą mniejszą pokojówką?
Dialogue: 0,0:23:37.21,0:23:38.67,Default,Elsa,0,0,0,,Trzęsiesz się?
Dialogue: 0,0:23:39.57,0:23:40.72,Default,Elsa,0,0,0,,Nie martw się.
Dialogue: 0,0:23:41.29,0:23:45.09,Default,Elsa,0,0,0,,Na pewno masz\Nprzepiękne wnętrzności.
Dialogue: 0,0:23:47.16,0:23:48.21,Default,Elsa,0,0,0,,Grzeczna dziewczynka.
Dialogue: 0,0:23:49.18,0:23:51.03,Default,Elsa,0,0,0,,Wyślę cię na spotkanie z aniołami.
Dialogue: 0,0:23:51.90,0:23:52.78,Default,Frederica,0,0,0,,Petra!
Dialogue: 0,0:23:53.86,0:23:55.32,Default,Petra,0,0,0,,Frederico!
Dialogue: 0,0:23:55.41,0:23:57.31,Default,Frederica,0,0,0,,Jesteś niegrzeczną dziewczynką, Petro!
Dialogue: 0,0:23:57.58,0:23:59.16,Default,Frederica,0,0,0,,Kazałam ci uciekać.
Dialogue: 0,0:23:59.25,0:24:00.71,Default,Frederica,0,0,0,,Później cię ukarzę!
Dialogue: 0,0:24:01.92,0:24:03.67,Default,Petra,0,0,0,,D-Dobrze!
Dialogue: 0,0:24:04.03,0:24:05.42,Default,Elsa,0,0,0,,Jak cudownie.
Dialogue: 0,0:24:05.92,0:24:08.51,Default,Elsa,0,0,0,,Ty musisz być tą większą pokojówką.
Dialogue: 0,0:24:08.98,0:24:13.31,Default,Elsa,0,0,0,,Cieszę się, że jesteście razem\Ni do tego tak się przyjaźnicie.
Dialogue: 0,0:24:13.68,0:24:15.73,Default,Elsa,0,0,0,,Ułożę wasze wnętrzności obok siebie
Dialogue: 0,0:24:15.82,0:24:18.31,Default,Elsa,0,0,0,,i sprawdzę, czy ich zawartość\Ndo siebie pasuje.
Dialogue: 0,0:24:18.53,0:24:22.74,Default,Frederica,0,0,0,,Od początku do końca żadne twoje słowo\Nnie ma najmniejszego sensu.
Dialogue: 0,0:24:22.83,0:24:24.67,Default,Frederica,0,0,0,,Nie nazwałabym tego dobrym gustem.
Dialogue: 0,0:24:24.76,0:24:26.27,Default,Elsa,0,0,0,,Krew półczłowieka, jak widzę.
Dialogue: 0,0:24:26.36,0:24:31.59,Default,Elsa,0,0,0,,Po zdarzeniach w stolicy, które prawie\Nmnie zabiły, moje umiejętności wzrosły.
Dialogue: 0,0:24:31.68,0:24:33.11,Default,Elsa,0,0,0,,Nie dasz sobie ze mną rady.
Dialogue: 0,0:24:33.54,0:24:37.53,Default,Frederica,0,0,0,,Chętnie obwiniłabym osobę,\Nktóra wtedy cię nie dobiła.
Dialogue: 0,0:24:40.97,0:24:43.62,Default,Frederica,0,0,0,,Petro, natychmiast wyjdź z posiadłości.
Dialogue: 0,0:24:44.12,0:24:46.96,Default,Petra,0,0,0,,A-Ale... Nee...
Dialogue: 0,0:24:49.62,0:24:51.86,Default,Frederica,0,0,0,,Nie wiem, kto cię przysłał,
Dialogue: 0,0:24:51.95,0:24:54.34,Default,Frederica,0,0,0,,Twoimi celami jesteśmy Petra i ja.
Dialogue: 0,0:24:54.69,0:24:55.57,Default,Elsa,0,0,0,,Tak.
Dialogue: 0,0:24:56.30,0:24:58.80,Default,Elsa,0,0,0,,Dwie pokojówki i mała dziewczynka-duch.
Dialogue: 0,0:24:59.23,0:25:02.43,Default,Elsa,0,0,0,,Nigdy nie rozcinałam ducha,\Nwięc jestem bardzo podekscytowana.
Dialogue: 0,0:24:59.84,0:25:00.72,Default,Frederica,0,0,0,,{\an8}Uciekaj!
Dialogue: 0,0:25:00.81,0:25:01.69,Default,Petra,0,0,0,,{\an8}Dobrze!
Dialogue: 0,0:25:05.60,0:25:07.74,Default,Frederica,0,0,0,,Twój charakter jest gorszy od gustu.
Dialogue: 0,0:25:08.12,0:25:09.09,Default,Elsa,0,0,0,,Jest grzeczna.
Dialogue: 0,0:25:09.18,0:25:10.69,Default,Frederica,0,0,0,,Jestem z niej niezwykle dumna!
Dialogue: 0,0:25:19.70,0:25:20.73,Default,Petra,0,0,0,,Nee...
Dialogue: 0,0:25:22.00,0:25:24.72,Default,Petra,0,0,0,,Może Beatrice coś poradzi!
Dialogue: 0,0:25:25.43,0:25:26.31,Default,Petra,0,0,0,,Tutaj!
Dialogue: 0,0:25:27.02,0:25:27.90,Default,Petra,0,0,0,,Nie...
Dialogue: 0,0:25:27.99,0:25:29.49,Default,Petra,0,0,0,,Tutaj?! Nie...
Dialogue: 0,0:25:29.65,0:25:30.55,Default,Petra,0,0,0,,Tu też jej nie ma!
Dialogue: 0,0:25:30.77,0:25:31.65,Default,Petra,0,0,0,,Nie ma jej tutaj.
Dialogue: 0,0:25:33.78,0:25:35.42,Default,Petra,0,0,0,,Tu również jej nie ma.
Dialogue: 0,0:25:37.82,0:25:38.89,Default,Petra,0,0,0,,Nee jest...
Dialogue: 0,0:25:40.44,0:25:41.75,Default,Petra,0,0,0,,Rem jest...
Dialogue: 0,0:25:55.87,0:25:57.26,Default,Petra,0,0,0,,Subaru...
Dialogue: 0,0:25:58.20,0:25:59.97,Default,Petra,0,0,0,,Pomóż mi!
Dialogue: 0,0:26:04.46,0:26:07.37,Default,Subaru,0,0,0,,Dobrze. Już dobrze, Petro.
Dialogue: 0,0:26:08.91,0:26:09.83,Default,Petra,0,0,0,,Co?
Dialogue: 0,0:26:10.58,0:26:14.53,Default,Subaru,0,0,0,,Przepraszam za spóźnienie,\Nale przybyłem ci pomóc.
Dialogue: 0,0:26:15.26,0:26:17.63,Default,Subaru,0,0,0,,Cieszę się, że nic ci nie jest, Petro.
Dialogue: 0,0:26:19.28,0:26:23.47,Default,Petra,0,0,0,,To ty, Subaru? Przyszedłeś po nas?
Dialogue: 0,0:26:23.91,0:26:25.41,Default,Subaru,0,0,0,,To ja. I tak, przyszedłem.
Dialogue: 0,0:26:25.50,0:26:27.51,Default,Petra,0,0,0,,Subaru, Frederica—
Dialogue: 0,0:26:27.60,0:26:29.03,Default,Subaru,0,0,0,,Zostaw to mnie!
Dialogue: 0,0:26:29.12,0:26:33.94,Default,Subaru,0,0,0,,...chciałbym powiedzieć,\Nale jeśli tam wpadnę, od razu zginę.
Dialogue: 0,0:26:34.18,0:26:38.67,Default,Subaru,0,0,0,,Wysłałem więc zamiast siebie\Nsuperpotężne wsparcie.
Dialogue: 0,0:26:38.76,0:26:40.59,Default,Subaru,0,0,0,,Jak na wieczór ponownego spotkania
Dialogue: 0,0:26:40.68,0:26:43.83,Default,,0,0,0,,ci, którzy nam przeszkadzają,\Nprzeszkadzają odrobinę {\i1}za bardzo{\i0}.
Dialogue: 0,0:26:45.34,0:26:49.00,Default,Frederica,0,0,0,,Czemu za każdym razem celujesz\Ntuż pod moją klatkę piersiową?
Dialogue: 0,0:26:49.09,0:26:51.28,Default,Elsa,0,0,0,,Można powiedzieć, że to moje hobby.
Dialogue: 0,0:26:51.37,0:26:53.00,Default,Elsa,0,0,0,,Jestem Łowczynią Wnętrzności.
Dialogue: 0,0:26:53.09,0:26:54.79,Default,Elsa,0,0,0,,Lubię rozcinać brzuchy!
Dialogue: 0,0:26:54.88,0:26:56.89,Default,Garfiel,0,0,0,,Szef lubi mawiać...
Dialogue: 0,0:26:58.92,0:27:02.46,Default,Garfiel,0,0,0,,że najlepszą obroną jest atak.
Dialogue: 0,0:27:02.55,0:27:07.27,Default,Garfiel,0,0,0,,Jeśli więc użyję do ataku tarczy,\Nktóra ma służyć obronie...
Dialogue: 0,0:27:08.18,0:27:11.80,Default,Garfiel,0,0,0,,najlepsza obrona\Ni najlepszy atak połączą się,
Dialogue: 0,0:27:11.89,0:27:15.57,Default,Garfiel,0,0,0,,czyniąc mnie tu najsilniejszym, prawda?!
Dialogue: 0,0:27:15.81,0:27:18.73,Default,Garfiel,0,0,0,,Nie sądzisz, starsza siostro?
Dialogue: 0,0:27:18.82,0:27:20.48,Default,Garfiel,0,0,0,,Łał, ale jesteś wielka!
Dialogue: 0,0:27:21.10,0:27:22.99,Default,Garfiel,0,0,0,,Zaraz, naprawdę jesteś moją siostrą?!
Dialogue: 0,0:27:23.08,0:27:26.13,Default,Garfiel,0,0,0,,Mam wrażenie, że powinienem\Nmówić do ciebie „starszy bracie”.
Dialogue: 0,0:27:26.82,0:27:29.95,Default,Frederica,0,0,0,,Nie bądź taki bezczelny,\Ngdy tylko znów się spotkaliśmy!
Dialogue: 0,0:27:34.82,0:27:37.55,Default,Frederica,0,0,0,,Garf, bardzo urosłeś.
Dialogue: 0,0:27:37.81,0:27:40.44,Default,Garfiel,0,0,0,,To zabrzmiało jak sarkazm!
Dialogue: 0,0:27:40.53,0:27:43.43,Default,Garfiel,0,0,0,,To ty jesteś cholernie za wielka!
Dialogue: 0,0:27:43.89,0:27:44.89,Default,Elsa,0,0,0,,Więc...
Dialogue: 0,0:27:45.44,0:27:48.89,Default,Elsa,0,0,0,,Mogę już przerwać\Nwasze radosne spotkanie?
Dialogue: 0,0:27:48.98,0:27:51.56,Default,Garfiel,0,0,0,,Miło, że na nas zaczekałaś.
Dialogue: 0,0:27:51.86,0:27:53.34,Default,Garfiel,0,0,0,,Hej, sio—
Dialogue: 0,0:27:53.43,0:27:56.64,Default,Garfiel,0,0,0,,Starsza siostro, znasz dziewczynę\No imieniu Rem?
Dialogue: 0,0:27:57.65,0:27:59.53,Default,Frederica,0,0,0,,Tak, jest w posiadłości.
Dialogue: 0,0:27:59.62,0:28:01.78,Default,Frederica,0,0,0,,Subaru powiedział,\Nże to siostra Ram.
Dialogue: 0,0:28:02.21,0:28:05.40,Default,Garfiel,0,0,0,,Gdy tylko trafi się okazja,\Njak najszybciej wyprowadź Rem.
Dialogue: 0,0:28:05.49,0:28:08.50,Default,Garfiel,0,0,0,,Będę miał pełne ręce roboty z tą suką.
Dialogue: 0,0:28:08.86,0:28:09.83,Default,Frederica,0,0,0,,Co ty mówisz?
Dialogue: 0,0:28:10.40,0:28:11.84,Default,Garfiel,0,0,0,,Wybacz, starsza siostro.
Dialogue: 0,0:28:12.22,0:28:16.42,Default,Garfiel,0,0,0,,Nie mogę z nią walczyć, martwiąc się\No osobę stojącą za moimi plecami.
Dialogue: 0,0:28:17.02,0:28:17.97,Default,Frederica,0,0,0,,Garf...
Dialogue: 0,0:28:18.58,0:28:21.05,Default,Garfiel,0,0,0,,Widzisz moją rękę, prawda?
Dialogue: 0,0:28:21.45,0:28:26.00,Default,Garfiel,0,0,0,,To tarcza, którą bawiliśmy się\Njako dzieci.
Dialogue: 0,0:28:26.40,0:28:31.79,Default,Garfiel,0,0,0,,To bieganie z tobą\Nuczyniło mnie najsilniejszym.
Dialogue: 0,0:28:38.90,0:28:41.33,Default,Garfiel,0,0,0,,No chodź, suko w czerni!
Dialogue: 0,0:28:41.42,0:28:43.65,Default,Garfiel,0,0,0,,Uczcimy moje wyjście z Sanktuarium!
Dialogue: 0,0:28:43.99,0:28:50.57,Default,Garfiel,0,0,0,,Najpierw rozwalę pierwszą ścianę,\Nktóra stanie mi na drodze!
Dialogue: 0,0:28:52.79,0:28:55.79,Episode Title,Title,0,0,0,,{\pos(320,80)\fs33\t(1,5000,\fs38)\bord4}Ponowne spotkanie wśród {\c&H32EFF4&}ryków
Dialogue: 0,0:29:03.25,0:29:06.93,Default,Beatrice,0,0,0,,Dlaczego tu jesteś? Nie wzywałam cię.
Dialogue: 0,0:29:07.02,0:29:11.27,Default,Subaru,0,0,0,,Wybacz, ale przychodzę\Nniezależnie od tego, czy mnie wzywano.
Dialogue: 0,0:29:11.53,0:29:13.90,Default,Beatrice,0,0,0,,Jak zawsze dbasz tylko o siebie.
Dialogue: 0,0:29:13.99,0:29:15.98,Default,Beatrice,0,0,0,,Zgadza się. Jestem samolubny.
Dialogue: 0,0:29:16.82,0:29:19.12,Default,Subaru,0,0,0,,Wyciągnę cię stąd, Beatrice.
Dialogue: 0,0:29:19.73,0:29:24.24,Default,Subaru,0,0,0,,Tym razem pozwolisz mi\Nwyciągnąć cię na światło dzienne,
Dialogue: 0,0:29:24.52,0:29:28.85,Default,Subaru,0,0,0,,a potem będziemy się bawić,\Naż twoja suknia sczernieje od błota!
Dialogue: 0,0:29:28.94,0:29:35.94,Default,,0,0,0,,
