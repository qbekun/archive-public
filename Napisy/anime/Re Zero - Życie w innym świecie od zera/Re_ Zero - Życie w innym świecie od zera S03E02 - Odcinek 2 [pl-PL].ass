Dialogue: 0,0:00:05.01,0:00:07.72,Default,Crusch,0,0,0,,Emilia i Natsuki Subaru,
Dialogue: 0,0:00:07.81,0:00:11.61,Default,Crusch,0,0,0,,Z radością ugoszczę was u siebie tak\Ndługo, jak będzie trzeba.
Dialogue: 0,0:00:12.04,0:00:13.58,Default,Emilia,0,0,0,,Doceniamy to.
Dialogue: 0,0:00:13.67,0:00:17.60,Default,Emilia,0,0,0,,Ale chcemy, żeby mieszkańcy\Nwrócili do domu.
Dialogue: 0,0:00:17.69,0:00:19.51,Default,Subaru,0,0,0,,Wrócimy, gdy odwieziemy wszystkich.
Dialogue: 0,0:00:19.60,0:00:22.50,Default,Subaru,0,0,0,,i porozmawiamy z jej sponsorem, Roswaalem.
Dialogue: 0,0:00:22.99,0:00:24.20,Default,Crusch,0,0,0,,Dobrze.
Dialogue: 0,0:00:24.29,0:00:28.29,Default,Crusch,0,0,0,,mam nadzieję, że wreszcie spłacę wobec\Nciebie ten ogromny dług wdzięczności.
Dialogue: 0,0:00:28.44,0:00:32.20,Default,Subaru,0,0,0,,To nic wielkiego,\Nty też nam pomogłaś.
Dialogue: 0,0:00:32.29,0:00:35.59,Default,Subaru,0,0,0,,Dostaliśmy nawet nagrodę. Prawda,\NPatrasche?
Dialogue: 0,0:00:36.89,0:00:38.07,Default,Subaru,0,0,0,,Au!
Dialogue: 0,0:00:38.16,0:00:39.35,Default,Emilia,0,0,0,,Wszystko ok, Subaru?
Dialogue: 0,0:00:39.55,0:00:41.79,Default,Subaru,0,0,0,,Te łuski bolą bardziej...
Dialogue: 0,0:00:41.88,0:00:45.48,Default,Subaru,0,0,0,,Teraz wiem, jak czuje się rzodkiew daikon,\Nkiedy ściera się ją na tarce!
Dialogue: 0,0:00:47.28,0:00:50.11,Default,Felis,0,0,0,,Subaru, zabezpieczyłem Rem.
Dialogue: 0,0:00:50.20,0:00:51.95,Default,Felis,0,0,0,,Trzymaj ją w miejscu!
Dialogue: 0,0:00:53.26,0:00:54.14,Default,Subaru,0,0,0,,Dobrze.
Dialogue: 0,0:00:54.23,0:00:58.50,Default,Felis,0,0,0,,Ty też będziesz potrzebował odpoczynku,\Nkiedy wrócisz do rezydencji.
Dialogue: 0,0:00:58.59,0:00:59.47,Default,Subaru,0,0,0,,Ja?
Dialogue: 0,0:00:59.78,0:01:03.37,Default,Felis,0,0,0,,Od walki z Lenistwem przeciążasz swoją\Nbramę.
Dialogue: 0,0:01:03.88,0:01:06.83,Default,Felis,0,0,0,,Oczyściłem twoją bramę ze wszystkich\Ntoksyn,
Dialogue: 0,0:01:06.92,0:01:09.21,Default,Felis,0,0,0,,ale musi odpoczywać przez dwa miesiące.
Dialogue: 0,0:01:09.30,0:01:10.78,Default,Subaru,0,0,0,,Dwa miesiące?
Dialogue: 0,0:01:11.17,0:01:14.62,Default,Subaru,0,0,0,,Cóż, na pewno te wszystkie szalone\Nrzeczy nie mogą trwać {\i1}tak{\i0} długo...
Dialogue: 0,0:01:14.98,0:01:17.18,Default,Subaru,0,0,0,,Chwila, czy właśnie wywołałem wilka z\Nlasu?!
Dialogue: 0,0:01:17.27,0:01:20.74,Default,Felis,0,0,0,,Dobra, czas iść.
Dialogue: 0,0:01:20.83,0:01:22.15,Default,Felis,0,0,0,,Dalej, Crusch.
Dialogue: 0,0:01:22.24,0:01:25.17,Default,,0,0,0,,Powiedz im kilka słów pożegnalnych.
Dialogue: 0,0:01:25.78,0:01:28.64,Default,Crusch,0,0,0,,Emilia, życzę ci zdrowia.
Dialogue: 0,0:01:29.02,0:01:32.07,Default,Crusch,0,0,0,,Nie mogę się doczekać, aż się zobaczymy.
Dialogue: 0,0:01:37.58,0:01:39.82,Default,Emilia,0,0,0,,Ty też, Crusch.
Dialogue: 0,0:01:40.39,0:01:43.59,Default,Emilia,0,0,0,,Następnym razem nie będę tą, którą ciągle\Ntrzeba ratować.
Dialogue: 0,0:01:43.68,0:01:46.37,Default,Emilia,0,0,0,,Będę mogła pomagać innym.
Dialogue: 0,0:01:48.92,0:01:50.51,Default,Crusch,0,0,0,,Natsuki Subaru,
Dialogue: 0,0:01:50.60,0:01:53.67,Default,Crusch,0,0,0,,Życzę ci też wszystkiego\Nnajlepszego w przyszłości.
Dialogue: 0,0:02:09.00,0:02:11.98,Default,Crusch,0,0,0,,Wiem, że jeszcze się spotkamy.
Dialogue: 0,0:02:24.20,0:02:25.62,Default,Subaru,0,0,0,,Dobrze, więc...
Dialogue: 0,0:02:27.46,0:02:31.80,Default,Emilia,0,0,0,,Wiesz, Subaru, zawsze siedzisz obok\Nmnie, jakby to był oczywisty wybór.
Dialogue: 0,0:02:31.89,0:02:33.92,Default,Subaru,0,0,0,,Czy jest w tym coś dziwnego?
Dialogue: 0,0:02:34.40,0:02:37.42,Default,Emilia,0,0,0,,Nie, początkowo było\Nmi trochę niewygodnie.
Dialogue: 0,0:02:37.93,0:02:40.89,Default,Emilia,0,0,0,,Ale teraz czuję się dziwnie,\Njeśli nie, więc w porządku.
Dialogue: 0,0:02:42.12,0:02:45.24,Default,Subaru,0,0,0,,Moje pilne wysiłki zostały\Nw końcu nagrodzone!
Dialogue: 0,0:02:45.33,0:02:46.49,Default,Subaru,0,0,0,,Jestem taki wzruszony!
Dialogue: 0,0:02:46.58,0:02:48.23,Default,Emilia,0,0,0,,Znowu ze mnie drwisz.
Dialogue: 0,0:02:49.41,0:02:51.86,Default,Emilia,0,0,0,,Wiem, że wciąż martwisz się o Rem.
Dialogue: 0,0:02:52.45,0:02:54.98,Default,Emilia,0,0,0,,Nie musisz tego ukrywać.
Dialogue: 0,0:02:56.62,0:02:58.96,Default,Emilia,0,0,0,,Ona jest dla ciebie ważna, prawda?
Dialogue: 0,0:02:59.05,0:03:00.59,Default,Subaru,0,0,0,,Jest bardzo ważna!
Dialogue: 0,0:03:00.68,0:03:02.57,Default,Subaru,0,0,0,,Tak ważna dla mnie jak ty!
Dialogue: 0,0:03:02.88,0:03:05.08,Default,Emilia,0,0,0,,Jesteś bardzo samolubny.
Dialogue: 0,0:03:05.53,0:03:06.91,Default,Emilia,0,0,0,,Czy wiesz o tym?
Dialogue: 0,0:03:07.41,0:03:08.72,Default,Subaru,0,0,0,,Oczywiście, że tak.
Dialogue: 0,0:03:08.81,0:03:11.04,Default,Subaru,0,0,0,,Czuję się jak śmieć, chciałbym umrzeć.
Dialogue: 0,0:03:11.53,0:03:13.67,Default,Subaru,0,0,0,,Ale to absolutna prawda.
Dialogue: 0,0:03:14.54,0:03:15.84,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:03:18.64,0:03:20.53,Default,Subaru,0,0,0,,Powiedziałaś moje imię?
Dialogue: 0,0:03:21.48,0:03:23.14,Default,Subaru,0,0,0,,Nie, nie powiedziałem!
Dialogue: 0,0:03:23.23,0:03:24.90,Default,Subaru,0,0,0,,Byłeś tu przez cały czas?
Dialogue: 0,0:03:24.99,0:03:27.23,Default,Otto,0,0,0,,Oczywiście, że tu byłem!
Dialogue: 0,0:03:27.32,0:03:30.68,Default,Otto,0,0,0,,Dlaczego myślisz, że zdecydowałem\Nsię z tobą pracować?!
Dialogue: 0,0:03:30.95,0:03:32.21,Default,Subaru,0,0,0,,Żartuję.
Dialogue: 0,0:03:32.30,0:03:35.21,Default,Subaru,0,0,0,,Chcesz osobiście negocjować z Roswaalem.
Dialogue: 0,0:03:35.30,0:03:36.47,Default,Subaru,0,0,0,,Nie zapomniałem o tym.
Dialogue: 0,0:03:36.56,0:03:40.31,Default,Otto,0,0,0,,Błagam cię, całe moje\Nżycie zależy od tego!
Dialogue: 0,0:03:40.40,0:03:42.35,Default,Subaru,0,0,0,,Tak, tak, rozumiem.
Dialogue: 0,0:03:42.44,0:03:45.78,Default,Subaru,0,0,0,,Czas się z tobą pożegnać.
Dialogue: 0,0:03:44.20,0:03:45.78,Default,Otto,0,0,0,,{\an8}Chwila...
Dialogue: 0,0:03:53.54,0:03:57.46,Default,Emilia,0,0,0,,Jestem pewna, że znajdziesz\Nsposób, by ją odzyskać.
Dialogue: 0,0:03:58.90,0:04:00.17,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:04:00.40,0:04:04.59,Default,Emilia,0,0,0,,Myślę też, że jesteśmy do siebie podobni\Npod tym względem,
Dialogue: 0,0:04:05.00,0:04:07.89,Default,Emilia,0,0,0,,że oboje kierujemy się egoistycznymi\Npobudkami.
Dialogue: 0,0:04:08.77,0:04:13.27,Default,Emilia,0,0,0,,Wiem, że ja też biorę udział w królewskiej\Nelekcji z egoistycznych pobudek.
Dialogue: 0,0:04:13.84,0:04:14.85,Default,Subaru,0,0,0,,Egoistycznych?
Dialogue: 0,0:04:15.47,0:04:18.98,Default,Emilia,0,0,0,,Przepraszam, nie potrafię tego wyjaśnić.
Dialogue: 0,0:04:19.60,0:04:22.31,Default,Emilia,0,0,0,,Nie chcę niczego przed tobą ukrywać.
Dialogue: 0,0:04:22.40,0:04:24.57,Default,Emilia,0,0,0,,Ale nie wiem, jak to wyrazić słowami.
Dialogue: 0,0:04:28.40,0:04:32.93,Default,Subaru,0,0,0,,Omówimy wszystko, gdy spotkamy się\Nz Roswaalem.
Dialogue: 0,0:04:34.60,0:04:37.25,Default,Subaru,0,0,0,,Może też wiedzieć, co stało się z Rem!
Dialogue: 0,0:04:38.77,0:04:39.65,Default,Emilia,0,0,0,,Tak.
Dialogue: 0,0:04:41.32,0:04:45.06,Default,Otto,0,0,0,,Wy dwoje, niedługo dotrzemy na miejsce!
Dialogue: 0,0:04:49.60,0:04:51.30,Default,Petra,0,0,0,,Nie ma tu nikogo.
Dialogue: 0,0:04:53.29,0:04:54.94,Default,Guy,0,0,0,,Tutaj też nikogo nie ma.
Dialogue: 0,0:04:55.03,0:04:57.50,Default,Kids,0,0,0,,Co? Dlaczego?
Dialogue: 0,0:04:57.85,0:05:00.67,Default,Emilia,0,0,0,,Ram i inni nie wrócili\Nz Sanktuarium?
Dialogue: 0,0:05:00.76,0:05:02.24,Default,Subaru,0,0,0,,Tak się wydaje.
Dialogue: 0,0:05:02.72,0:05:05.96,Default,Subaru,0,0,0,,A tak przy okazji, Emilia,\Nwiesz gdzie jest Sanktuarium?
Dialogue: 0,0:05:06.05,0:05:09.19,Default,Emilia,0,0,0,,Myślałam, {\i1}że{\i0} wiesz gdzie jest.
Dialogue: 0,0:05:09.28,0:05:10.16,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:05:11.95,0:05:14.01,Default,Subaru,0,0,0,,Wiem, że pytam o to późno,
Dialogue: 0,0:05:14.10,0:05:16.58,Default,Subaru,0,0,0,,ale czym właściwie jest Sanktuarium?
Dialogue: 0,0:05:16.97,0:05:18.40,Default,Emilia,0,0,0,,Ja też nie jestem pewna.
Dialogue: 0,0:05:18.49,0:05:22.58,Default,Emilia,0,0,0,,Roswaal powiedział tylko,\Nże to tajna baza... i...
Dialogue: 0,0:05:22.67,0:05:23.55,Default,Subaru,0,0,0,,A co?
Dialogue: 0,0:05:24.52,0:05:26.13,Default,Emilia,0,0,0,,Nic, nieważne.
Dialogue: 0,0:05:26.57,0:05:29.14,Default,Emilia,0,0,0,,Powinnam była zapytać.
Dialogue: 0,0:05:29.23,0:05:31.86,Default,Subaru,0,0,0,,Nie! Choć spieszyliśmy\Nsię w bezpieczne miejsce,
Dialogue: 0,0:05:31.95,0:05:34.40,Default,Subaru,0,0,0,,To ja byłem zbyt nieostrożny!
Dialogue: 0,0:05:38.50,0:05:40.86,Default,Subaru,0,0,0,,Na razie musimy iść do rezydencji.
Dialogue: 0,0:05:40.95,0:05:42.80,Default,Subaru,0,0,0,,Może tam znajdziemy jakieś wskazówki.
Dialogue: 0,0:05:43.22,0:05:44.86,Default,Subaru,0,0,0,,Otto, chodź z nami!
Dialogue: 0,0:05:45.43,0:05:47.24,Default,Otto,0,0,0,,Do rezydencji?
Dialogue: 0,0:05:47.39,0:05:49.76,Default,Subaru,0,0,0,,Nie bój się, jak dotarliśmy tak daleko.
Dialogue: 0,0:05:49.85,0:05:52.58,Default,Subaru,0,0,0,,Zabierz powóz i smoki lądowe na tyły,\Ndobrze?
Dialogue: 0,0:05:52.67,0:05:54.50,Default,Otto,0,0,0,,W porządku.
Dialogue: 0,0:05:59.41,0:06:01.46,Default,Subaru,0,0,0,,Wróciliśmy, Rem.
Dialogue: 0,0:06:02.08,0:06:03.35,Default,Emilia,0,0,0,,Wszystko w porządku?
Dialogue: 0,0:06:03.44,0:06:04.42,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:06:04.73,0:06:08.21,Default,Subaru,0,0,0,,Nie pamiętam, żebym zamknął\Ndrzwi, kiedy wychodziliśmy.
Dialogue: 0,0:06:08.30,0:06:09.65,Default,Subaru,0,0,0,,Myślisz, że nas obrabowano?
Dialogue: 0,0:06:10.04,0:06:13.76,Default,Emilia,0,0,0,,Beatrice została tutaj,\Nwięc nie musimy się martwić.
Dialogue: 0,0:06:13.85,0:06:16.68,Default,Emilia,0,0,0,,Może otworzy nam drzwi, jeśli zapukamy.
Dialogue: 0,0:06:18.12,0:06:20.87,Default,Subaru,0,0,0,,Może też wylecieć przez drzwi w\Nposzukiwaniu Pucka.
Dialogue: 0,0:06:20.96,0:06:21.84,Default,Emilia,0,0,0,,Tak, to prawda.
Dialogue: 0,0:06:22.58,0:06:24.61,Default,Emilia,0,0,0,,Puck? Puck?
Dialogue: 0,0:06:24.94,0:06:27.51,Default,Emilia,0,0,0,,Nie odpowiada.
Dialogue: 0,0:06:27.60,0:06:29.23,Default,Emilia,0,0,0,,Może śpi.
Dialogue: 0,0:06:29.32,0:06:30.36,Default,Subaru,0,0,0,,A może tutaj?
Dialogue: 0,0:06:34.52,0:06:36.57,Default,Frederica,0,0,0,,Tak, chwileczkę.
Dialogue: 0,0:06:38.59,0:06:41.46,Default,Frederica,0,0,0,,Witaj w domu, Emilia.
Dialogue: 0,0:06:41.55,0:06:44.50,Default,Frederica,0,0,0,,Czekałam na twój powrót.
Dialogue: 0,0:06:45.17,0:06:46.21,Default,Emilia,0,0,0,,Frederica?
Dialogue: 0,0:06:49.54,0:06:51.27,Default,Frederica,0,0,0,,Tak, to ja, Frederi
Dialogue: 0,0:06:51.36,0:06:52.56,Default,Subaru,0,0,0,,Te zęby są przerażające!
Dialogue: 0,0:06:54.39,0:06:55.66,Default,Frederica,0,0,0,,Przedstawię się.
Dialogue: 0,0:06:55.75,0:06:59.81,Default,Frederica,0,0,0,,Jestem Frederica Baumann,\Npracowałam tu w przeszłości.
Dialogue: 0,0:07:01.20,0:07:02.53,Default,Subaru,0,0,0,,Skoro o tym wspominasz,
Dialogue: 0,0:07:02.62,0:07:05.69,Default,Subaru,0,0,0,,Była pokojówka, która zrezygnowała\Ntuż przed moim przyjściem.
Dialogue: 0,0:07:06.18,0:07:10.01,Default,Frederica,0,0,0,,Odeszłam jedynie z powodów osobistych.
Dialogue: 0,0:07:10.48,0:07:14.91,Default,Frederica,0,0,0,,Wróciłam więc na prośbę Ram\Ni zastałam pustą rezydencję.
Dialogue: 0,0:07:15.76,0:07:18.43,Default,Frederica,0,0,0,,Na szczęście w gabinecie pana\Nznalazłam list,
Dialogue: 0,0:07:18.52,0:07:20.62,Default,Frederica,0,0,0,,który wyjaśnił mi, co się stało.
Dialogue: 0,0:07:20.71,0:07:21.60,Default,Emilia,0,0,0,,List?
Dialogue: 0,0:07:22.04,0:07:24.17,Default,Subaru,0,0,0,,A dlaczego Ram poprosiła cię o powrót?
Dialogue: 0,0:07:24.75,0:07:26.49,Default,Frederica,0,0,0,,Kiedy wróciłam,
Dialogue: 0,0:07:26.77,0:07:29.47,Default,,0,0,0,,Kuchnia i drzewa w ogrodzie\Nbyły zaniedbane.
Dialogue: 0,0:07:29.56,0:07:31.01,Default,Frederica,0,0,0,,To było okropne.
Dialogue: 0,0:07:33.33,0:07:34.97,Default,Subaru,0,0,0,,To dość poważny powód!
Dialogue: 0,0:07:36.34,0:07:38.18,Default,Emilia,0,0,0,,To dziwne.
Dialogue: 0,0:07:38.27,0:07:42.66,Default,Emilia,0,0,0,,Ram zawsze ciężko dla nas pracowała\Npodczas twojej nieobecności,
Dialogue: 0,0:07:42.75,0:07:45.00,Default,Emilia,0,0,0,,Więc dlaczego, w ciągu\Nostatnich kilku dni...
Dialogue: 0,0:07:47.43,0:07:51.13,Default,Subaru,0,0,0,,Ponieważ Rem zniknęła, Ram nie była w\Nstanie sama zajmować się rezydencją,
Dialogue: 0,0:07:51.22,0:07:53.66,Default,Subaru,0,0,0,,więc poprosiła Fredericę o pomoc?
Dialogue: 0,0:07:54.87,0:07:58.28,Default,Frederica,0,0,0,,Czy możesz mi wyjaśnić, kim jest ta\Ndziewczyna
Dialogue: 0,0:07:58.37,0:07:59.87,Default,,0,0,0,,tak uderzająco podobna do Ram?
Dialogue: 0,0:08:00.45,0:08:02.44,Default,Subaru,0,0,0,,To młodsza siostra Ram, Rem.
Dialogue: 0,0:08:02.53,0:08:04.35,Default,Subaru,0,0,0,,To naprawdę miła dziewczyna.
Dialogue: 0,0:08:04.93,0:08:08.18,Default,Subaru,0,0,0,,Jest miła, silna i bardzo ciężko pracuje.
Dialogue: 0,0:08:08.57,0:08:12.93,Default,Subaru,0,0,0,,Ona i Ram były sobie bardzo bliskie.
Dialogue: 0,0:08:13.58,0:08:16.58,Default,Subaru,0,0,0,,Jestem pewien, że ty też byłaś jej dobrą\Nprzyjaciółką.
Dialogue: 0,0:08:18.40,0:08:21.35,Default,Subaru,0,0,0,,Ty... prawdopodobnie\Nnie pamiętasz, prawda?
Dialogue: 0,0:08:22.25,0:08:23.82,Default,Frederica,0,0,0,,Niestety nie.
Dialogue: 0,0:08:23.91,0:08:28.07,Default,Frederica,0,0,0,,Ciekawe jak pan i Ram\Nzareagują kiedy wrócą...
Dialogue: 0,0:08:28.53,0:08:30.66,Default,Subaru,0,0,0,,Nie wiem nawet, co zrobi Roswaal.
Dialogue: 0,0:08:31.31,0:08:34.28,Default,Subaru,0,0,0,,I... nie chcę sobie\Nwyobrażać jak zareaguje Ram.
Dialogue: 0,0:08:35.60,0:08:39.54,Default,Emilia,0,0,0,,Frederico, dostałaś jakieś wieści\Nod Roswaala?
Dialogue: 0,0:08:39.63,0:08:44.79,Default,Frederica,0,0,0,,Niestety, nie mam możliwości poznania\Nwszystkiego, co dzieje się w umyśle pana.
Dialogue: 0,0:08:45.43,0:08:51.26,Default,Frederica,0,0,0,,Sądzę, że na świecie są tylko dwie osoby,\Nktórym ufa aż tak bardzo.
Dialogue: 0,0:08:51.76,0:08:52.71,Default,Subaru,0,0,0,,Dwie?
Dialogue: 0,0:08:52.80,0:08:56.59,Default,Frederica,0,0,0,,Ram i wielki duch z zakazanej biblioteki\Ntej rezydencji.
Dialogue: 0,0:08:56.68,0:08:58.72,Default,Subaru,0,0,0,,Wielki duch zakazanej biblioteki?
Dialogue: 0,0:09:00.30,0:09:02.11,Default,Frederica,0,0,0,,Mam na myśli panią Beatrice.
Dialogue: 0,0:09:13.32,0:09:15.70,Default,Subaru,0,0,0,,Hej, Beako, dawno się nie widzieliśmy!
Dialogue: 0,0:09:16.50,0:09:20.37,Default,Beatrice,0,0,0,,Teraz rozumiem, dlaczego rezydencja\Nnagle wydała się tak hałaśliwa.
Comment: 0,0:09:20.46,0:09:21.34,Default,,0,0,0,,
Dialogue: 0,0:09:22.54,0:09:25.32,Default,Subaru,0,0,0,,Wszyscy się o ciebie martwili.
Dialogue: 0,0:09:25.41,0:09:27.86,Default,Subaru,0,0,0,,Powinnaś przeprosić, nawet jeśli dopiero\Npóźniej.
Dialogue: 0,0:09:28.01,0:09:30.58,Default,Beatrice,0,0,0,,Przeprosić?
Dialogue: 0,0:09:30.67,0:09:34.17,Default,Beatrice,0,0,0,,Nie rozumiem, dlaczego\Nmuszę przepraszać i kogo.
Dialogue: 0,0:09:34.69,0:09:37.17,Default,Subaru,0,0,0,,Mogę przeprosić za ciebie, jeśli chcesz.
Dialogue: 0,0:09:37.26,0:09:40.84,Default,Subaru,0,0,0,,Powiem im, że dziękowałaś mi\Nze łzami i smarkami na twarzy.
Dialogue: 0,0:09:40.93,0:09:42.72,Default,Beatrice,0,0,0,,Nie wymyślaj historii!
Dialogue: 0,0:09:42.81,0:09:45.51,Default,Beatrice,0,0,0,,Nie płakałam od dawna.
Dialogue: 0,0:09:45.60,0:09:48.16,Default,Subaru,0,0,0,,Czasem dobrze jest porządnie się wypłakać.
Dialogue: 0,0:09:48.25,0:09:50.23,Default,Beatrice,0,0,0,,Te słowa mają głębokie znaczenie.
Dialogue: 0,0:09:50.32,0:09:53.69,Default,,0,0,0,,gdy mówi to facet, który\Nszlochał na kolanach ukochanej.
Dialogue: 0,0:09:53.78,0:09:56.46,Default,Subaru,0,0,0,,Możesz już o tym zapomnieć?
Dialogue: 0,0:09:56.55,0:09:58.71,Default,Beatrice,0,0,0,,Czy mógłbyś przejść do sedna?
Dialogue: 0,0:09:58.80,0:09:59.95,Default,Beatrice,0,0,0,,Słabeusz.
Dialogue: 0,0:10:00.28,0:10:01.18,Default,Subaru,0,0,0,,Tak...
Dialogue: 0,0:10:03.67,0:10:07.08,Default,Subaru,0,0,0,,Jak dobrze wiesz, co myśli Roswaal?
Dialogue: 0,0:10:08.98,0:10:13.80,Default,Subaru,0,0,0,,Ktoś mi powiedział,\Nże wiesz jak myśli Roswaal.
Dialogue: 0,0:10:14.25,0:10:15.43,Default,Beatrice,0,0,0,,Kto powiedział—
Dialogue: 0,0:10:15.52,0:10:16.40,Default,Beatrice,0,0,0,,Ach.
Dialogue: 0,0:10:16.72,0:10:19.82,Default,Beatrice,0,0,0,,To musiała być ta dziewczyna-półbestia,\Nktóra właśnie wróciła.
Dialogue: 0,0:10:20.24,0:10:24.19,Default,Beatrice,0,0,0,,W tym, co ci powiedziała, jest trochę\Nprawdy.
Dialogue: 0,0:10:24.28,0:10:28.73,Default,Beatrice,0,0,0,,Ale moja więź z Roswaalem nie ma nic\Nwspólnego z obecną sytuacją.
Dialogue: 0,0:10:29.16,0:10:31.80,Default,Subaru,0,0,0,,zostałaś tu zupełnie sama,
Dialogue: 0,0:10:32.19,0:10:34.07,Default,Subaru,0,0,0,,choć nie podjęto środków ostrożności.
Dialogue: 0,0:10:34.34,0:10:36.90,Default,Beatrice,0,0,0,,Jestem zdolna się bronić.
Dialogue: 0,0:10:36.99,0:10:39.07,Default,Beatrice,0,0,0,,Dlatego zostałam.
Dialogue: 0,0:10:39.16,0:10:41.51,Default,Beatrice,0,0,0,,Roswaal nie ma z tym nic wspólnego.
Dialogue: 0,0:10:41.60,0:10:46.08,Default,Beatrice,0,0,0,,Nie sądzę, żeby miał\Nw ogóle nic na myśli.
Dialogue: 0,0:10:46.27,0:10:47.40,Default,Subaru,0,0,0,,Hmm...
Dialogue: 0,0:10:47.49,0:10:53.21,Default,Subaru,0,0,0,,Czy wszyscy przecenialiśmy go,
Dialogue: 0,0:10:53.30,0:10:56.45,Default,Subaru,0,0,0,,sądząc, że nie stanąłby do walki z Kultem\NCzarownicy bez planu?
Dialogue: 0,0:10:57.26,0:10:58.46,Default,Subaru,0,0,0,,Tak, to prawda.
Dialogue: 0,0:10:59.68,0:11:00.86,Default,Subaru,0,0,0,,Spójrz na to.
Dialogue: 0,0:11:03.21,0:11:04.76,Default,Beatrice,0,0,0,,Ewangelia...
Dialogue: 0,0:11:05.35,0:11:08.60,Default,Beatrice,0,0,0,,Dlaczego akurat ty masz jedną z nich?!
Dialogue: 0,0:11:09.11,0:11:11.13,Default,Subaru,0,0,0,,Zabrałem ją pokonanemu wrogowi.
Dialogue: 0,0:11:11.22,0:11:14.98,Default,Subaru,0,0,0,,Należała do przywódcy Kultu Czarownicy,\Nktóry otoczył rezydencję.
Dialogue: 0,0:11:15.72,0:11:17.69,Default,Beatrice,0,0,0,,A co się z nim stało?
Dialogue: 0,0:11:18.01,0:11:19.11,Default,Subaru,0,0,0,,Nie żyje.
Dialogue: 0,0:11:19.46,0:11:21.28,Default,Subaru,0,0,0,,Zabiłem go.
Dialogue: 0,0:11:24.00,0:11:26.93,Default,Beatrice,0,0,0,,Więc zostawiłeś mnie też, przypuszczam...
Dialogue: 0,0:11:28.07,0:11:29.16,Default,Beatrice,0,0,0,,Geuse.
Dialogue: 0,0:11:30.28,0:11:31.23,Default,Subaru,0,0,0,,Kto to?
Dialogue: 0,0:11:32.36,0:11:33.85,Default,Beatrice,0,0,0,,To nie twoja sprawa.
Dialogue: 0,0:11:34.35,0:11:38.71,Default,Beatrice,0,0,0,,Jeśli zabiłeś Lenistwo, Arcybiskupa\NGrzechu,
Dialogue: 0,0:11:38.80,0:11:40.90,Default,Beatrice,0,0,0,,Co się stało z jego Czynnikiem Czarownicy?
Dialogue: 0,0:11:41.30,0:11:43.14,Default,Subaru,0,0,0,,Czynnik... Czarownicy?
Dialogue: 0,0:11:43.75,0:11:46.51,Default,Beatrice,0,0,0,,Naprawdę nie wiesz, co to jest?
Dialogue: 0,0:11:47.02,0:11:51.07,Default,Beatrice,0,0,0,,dlaczego w ogóle zabiłeś Lenistwo?
Dialogue: 0,0:11:51.16,0:11:53.06,Default,Beatrice,0,0,0,,A co z Roswaalem...?
Dialogue: 0,0:11:53.15,0:11:56.84,Default,Subaru,0,0,0,,Mówiłem ci, Roswaal\Njest w Sanktuarium!
Dialogue: 0,0:11:56.93,0:11:59.58,Default,Subaru,0,0,0,,To ja chcę wiedzieć, co on myśli!
Dialogue: 0,0:12:01.60,0:12:06.12,Default,Beatrice,0,0,0,,Wszystkie odpowiedzi leżą w Sanktuarium.
Dialogue: 0,0:12:06.60,0:12:07.55,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:12:07.64,0:12:10.84,Default,Beatrice,0,0,0,,Intencje Roswaala, znaczenie Ewangelii,
Dialogue: 0,0:12:10.93,0:12:14.33,Default,Beatrice,0,0,0,,Odpowiedzi dotyczące Czynnika\NCzarownicy... Wszystko tam znajdziesz.
Dialogue: 0,0:12:14.97,0:12:16.67,Default,Beatrice,0,0,0,,Jeśli ich chcesz, idź tam.
Dialogue: 0,0:12:17.57,0:12:20.76,Default,Beatrice,0,0,0,,Półbestia może cię tam zaprowadzić.
Dialogue: 0,0:12:21.03,0:12:23.32,Default,Subaru,0,0,0,,Poczekaj! Co się z tobą dzieje?
Dialogue: 0,0:12:23.41,0:12:25.23,Default,Subaru,0,0,0,,Czemu nagle chcesz rozmawiać?
Dialogue: 0,0:12:25.32,0:12:27.39,Default,Subaru,0,0,0,,Po co iść do Sanktuarium, skoro ty...
Dialogue: 0,0:12:27.48,0:12:29.07,Default,Beatrice,0,0,0,,Nie powiem ci.
Dialogue: 0,0:12:29.64,0:12:32.77,Default,Beatrice,0,0,0,,Mam prawo odmówić odpowiedzi.
Dialogue: 0,0:12:34.42,0:12:36.95,Default,Beatrice,0,0,0,,Pokazałam ci drogę prowadzącą do\Nodpowiedzi.
Dialogue: 0,0:12:37.04,0:12:39.47,Default,Beatrice,0,0,0,,Nie oczekuj, że będę ci dalej dogadzać!
Dialogue: 0,0:12:39.56,0:12:41.47,Default,Subaru,0,0,0,,Beako, Beatrice!
Dialogue: 0,0:12:41.56,0:12:45.20,Default,Beatrice,0,0,0,,Nie jestem narzędziem dla twojej wygody!
Dialogue: 0,0:12:49.81,0:12:54.12,Default,Otto,0,0,0,,{\an8}Dlaczego wpadłeś na mnie,\Ngdy wychodziłem z łazienki?
Dialogue: 0,0:12:53.26,0:12:57.12,Default,Subaru,0,0,0,,Dlaczego znów wyglądałaś,\Njakbyś miała się rozpłakać?
Dialogue: 0,0:12:57.21,0:12:59.09,Default,Otto,0,0,0,,Przepraszam! Mógłbyś ze mnie zejść...
Dialogue: 0,0:13:01.60,0:13:05.13,Default,Frederica,0,0,0,,Więc naprawdę masz prawo wejść do\Nzakazanej biblioteki Beatrice-sama?
Dialogue: 0,0:13:05.36,0:13:07.51,Default,Subaru,0,0,0,,Myślałaś, że nie będę?
Dialogue: 0,0:13:07.84,0:13:12.72,Default,Frederica,0,0,0,,Tak, ale Emilia mówiła mi,\Nże jest pan bardzo godny zaufania,
Dialogue: 0,0:13:12.81,0:13:15.51,Default,Frederica,0,0,0,,i bardzo dokładnie wyjaśniła dlaczego,
Dialogue: 0,0:13:15.90,0:13:18.47,Default,Frederica,0,0,0,,więc po części miałam wielką nadzieję, że\Ntak.
Dialogue: 0,0:13:18.56,0:13:19.44,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:13:19.53,0:13:20.63,Default,Emilia,0,0,0,,Hej, Frederica!
Dialogue: 0,0:13:20.72,0:13:22.48,Default,Subaru,0,0,0,,Co jej powiedziałaś?
Dialogue: 0,0:13:22.71,0:13:27.74,Default,Emilia,0,0,0,,To nie tak! Mówiłam jej o tobie,\Nale przesadza!
Dialogue: 0,0:13:28.06,0:13:30.59,Default,Otto,0,0,0,,Nie, ja też słyszałem, co powiedziałaś.
Dialogue: 0,0:13:30.68,0:13:33.53,Default,Otto,0,0,0,,Uznałem, że Natsuki musi być kimś więcej,\Nniż się wydaje.
Dialogue: 0,0:13:33.66,0:13:34.81,Default,Emilia,0,0,0,,Nie ty też, Otto!
Dialogue: 0,0:13:34.90,0:13:38.45,Default,Subaru,0,0,0,,Dlaczego nie byłem w pobliżu,\Nżeby to usłyszeć?!
Dialogue: 0,0:13:38.54,0:13:40.84,Default,Emilia,0,0,0,,Nigdy nie mogłabym\Npowiedzieć tego przy tobie.
Dialogue: 0,0:13:41.14,0:13:43.78,Default,Emilia,0,0,0,,Frederica, wracaj do tego, co mówiłaś!
Dialogue: 0,0:13:43.87,0:13:46.09,Default,Frederica,0,0,0,,Tak, oczywiście.
Dialogue: 0,0:13:46.68,0:13:50.74,Default,Frederica,0,0,0,,Porozmawiajmy, żebyś nie utknął w martwym\Npunkcie.
Dialogue: 0,0:13:50.83,0:13:52.75,Default,Subaru,0,0,0,,Co masz na myśli?
Dialogue: 0,0:13:52.84,0:13:54.79,Default,Emilia,0,0,0,,Nawet jeśli mógłbyś zobaczyć Beatrice,
Dialogue: 0,0:13:54.88,0:13:57.94,Default,Emilia,0,0,0,,To, czy odpowie na twoje\Npytanie, to inna sprawa.
Dialogue: 0,0:13:58.03,0:14:01.73,Default,Emilia,0,0,0,,Wiesz, że ty i Beatrice\Nmożecie być bardzo uparci.
Dialogue: 0,0:14:02.20,0:14:05.87,Default,Subaru,0,0,0,,To zdecydowanie zbyt urocze określenie,\Nale masz rację.
Dialogue: 0,0:14:05.96,0:14:06.84,Default,Subaru,0,0,0,,A co?
Dialogue: 0,0:14:07.21,0:14:10.46,Default,Emilia,0,0,0,,Ja też mam wiele do omówienia\Nz Roswaalem.
Dialogue: 0,0:14:10.88,0:14:12.70,Default,Emilia,0,0,0,,Dlatego poprosiłam Frederikę,
Dialogue: 0,0:14:13.13,0:14:15.33,Default,Emilia,0,0,0,,żeby powiedziała mi, gdzie jest\NSanktuarium.
Dialogue: 0,0:14:16.27,0:14:19.54,Default - flashback,Beatrice,0,0,0,,Ta półzwierzęca dziewczyna\Nmoże cię tam zaprowadzić.
Dialogue: 0,0:14:20.33,0:14:22.97,Default,Subaru,0,0,0,,Więc powiesz nam,\Ngdzie jest, Frederica?
Dialogue: 0,0:14:23.06,0:14:25.68,Default,Frederica,0,0,0,,Uległam uporowi Emilii,
Dialogue: 0,0:14:25.77,0:14:29.62,Default,Frederica,0,0,0,,choć zabroniono mi ujawniać więcej,\Nniż to konieczne.
Dialogue: 0,0:14:30.00,0:14:33.22,Default,Frederica,0,0,0,,Ale chciałabym prosić o trochę\Nczasu na przygotowanie.
Dialogue: 0,0:14:33.92,0:14:35.39,Default,Frederica,0,0,0,,Może dwa dni?
Dialogue: 0,0:14:35.68,0:14:36.97,Default,Subaru,0,0,0,,Przygotować?
Dialogue: 0,0:14:37.28,0:14:41.35,Default,Subaru,0,0,0,,Ach, racja. Wszyscy opuścimy\Nrezydencję, więc—
Dialogue: 0,0:14:41.52,0:14:44.19,Default,Frederica,0,0,0,,Nie, zostanę w rezydencji.
Dialogue: 0,0:14:44.28,0:14:45.53,Default,Frederica,0,0,0,,Nie mogę wam towarzyszyć.
Dialogue: 0,0:14:45.96,0:14:47.71,Default,Subaru,0,0,0,,Nie jedziesz z nami?
Dialogue: 0,0:14:47.80,0:14:49.54,Default,Subaru,0,0,0,,Jak mamy się tam dostać?
Dialogue: 0,0:14:51.93,0:14:54.48,Default,Otto,0,0,0,,Wolno kojarzysz, Natsuki.
Dialogue: 0,0:14:56.60,0:15:00.53,Default,Subaru,0,0,0,,Więc Otto zabierze nas do Sanktuarium?
Dialogue: 0,0:15:00.91,0:15:03.43,Default,Subaru,0,0,0,,Bo sądzi, że wspierając Emilię,
Dialogue: 0,0:15:05.53,0:15:07.05,Default,Otto,0,0,0,,{\an8}Nie, no...
Dialogue: 0,0:15:03.43,0:15:07.62,Default,Subaru,0,0,0,,zaimponuje jej sponsorowi, Roswaalowi?
Dialogue: 0,0:15:07.71,0:15:09.51,Default,Emilia,0,0,0,,Otto, czy to prawda?
Dialogue: 0,0:15:09.96,0:15:12.75,Default,Otto,0,0,0,,Czyste, niewinne spojrzenie Emilii mnie\Ndobija!
Dialogue: 0,0:15:12.84,0:15:14.71,Default,Otto,0,0,0,,Przepraszam, to jest dokładnie tak!
Dialogue: 0,0:15:14.80,0:15:18.58,Default,Subaru,0,0,0,,Im jawniej pokazujesz ukryte motywy,\Ntym bardziej cię lubię, Otto.
Dialogue: 0,0:15:18.67,0:15:21.48,Default,Otto,0,0,0,,W twoich ustach to niezbyt pocieszające!
Dialogue: 0,0:15:21.77,0:15:23.29,Default,Subaru,0,0,0,,Doceniam twoją pomoc.
Dialogue: 0,0:15:23.66,0:15:27.04,Default,Subaru,0,0,0,,W takim razie możesz opowiedzieć nam\Ntrojgu o Sanktuarium.
Dialogue: 0,0:15:27.76,0:15:29.19,Default,Frederica,0,0,0,,Dobrze.
Dialogue: 0,0:15:30.24,0:15:32.34,Default,Frederica,0,0,0,,Zdradzę wam położenie Sanktuarium Clemaldy
Dialogue: 0,0:15:32.43,0:15:36.28,Default,Frederica,0,0,0,,i sposób, w jaki można do niego wejść.
Dialogue: 0,0:15:36.99,0:15:41.99,Default,Frederica,0,0,0,,Jest jedno imię, którego\Nnie wolno ci zapomnieć.
Dialogue: 0,0:15:42.08,0:15:45.50,Default,Frederica,0,0,0,,Uważajcie na kogoś o imieniu Garfiel.
Dialogue: 0,0:15:45.93,0:15:47.43,Default,Frederica,0,0,0,,W Sanktuarium przede wszystkim
Dialogue: 0,0:15:47.52,0:15:53.42,Default,Frederica,0,0,0,,jego musicie się wystrzegać.
Dialogue: 0,0:16:00.20,0:16:01.08,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:16:01.67,0:16:02.88,Default,Subaru,0,0,0,,Wyjeżdżamy.
Dialogue: 0,0:16:03.46,0:16:06.83,Default,Subaru,0,0,0,,Powiedziałem Fredericce,\Nżeby się tobą zajęła.
Dialogue: 0,0:16:06.92,0:16:09.02,Default,Subaru,0,0,0,,Bądź grzeczna i czekaj tu\Nna mnie, dobrze?
Dialogue: 0,0:16:18.72,0:16:20.03,Default,Petra,0,0,0,,Gotowy?
Dialogue: 0,0:16:20.12,0:16:21.36,Default,Subaru,0,0,0,,Oczywiście, nowy rekrut.
Dialogue: 0,0:16:21.45,0:16:23.67,Default,Subaru,0,0,0,,Widzę, że mundur już świetnie na tobie\Nleży.
Dialogue: 0,0:16:23.76,0:16:24.94,Default,Petra,0,0,0,,Nieprawdaż?
Dialogue: 0,0:16:27.07,0:16:29.85,Default,Petra,0,0,0,,Pożegnałeś się z Rem?
Dialogue: 0,0:16:29.94,0:16:31.82,Default,Subaru,0,0,0,,Tak, coś w tym stylu.
Dialogue: 0,0:16:32.16,0:16:34.42,Default,Subaru,0,0,0,,Nie planujemy zostać tam długo.
Dialogue: 0,0:16:34.51,0:16:36.21,Default,Subaru,0,0,0,,Ale najpierw chciałem ją zobaczyć.
Dialogue: 0,0:16:36.84,0:16:41.47,Default,Subaru,0,0,0,,Zaopiekujesz się Rem pod moją\Nnieobecność, Petro?
Dialogue: 0,0:16:42.13,0:16:44.31,Default,Petra,0,0,0,,Rozumiem, Subaru!
Dialogue: 0,0:16:45.02,0:16:48.02,Default,Subaru,0,0,0,,Ale nabór nowej pokojówki\Nogłosiliśmy dwa dni temu.
Dialogue: 0,0:16:48.11,0:16:50.34,Default,Subaru,0,0,0,,A to twój pierwszy\Ndzień w rezydencji.
Dialogue: 0,0:16:50.43,0:16:52.90,Default,Subaru,0,0,0,,Imponuje mi, że dotarłaś tu\Nbez błądzenia.
Dialogue: 0,0:16:53.28,0:16:57.07,Default,Subaru,0,0,0,,I podziwiam twoją decyzję o\Nopuszczeniu rodziców w tak młodym wieku.
Dialogue: 0,0:16:57.16,0:17:00.54,Default,Petra,0,0,0,,Mam dwanaście lat, jestem\Nwystarczająco dorosła, żeby pracować!
Dialogue: 0,0:17:00.63,0:17:02.29,Default,Petra,0,0,0,,Jestem już dorosłą kobietą!
Dialogue: 0,0:17:02.81,0:17:06.15,Default,Petra,0,0,0,,Musisz traktować mnie jak dorosłą,\NSubaru!
Dialogue: 0,0:17:06.24,0:17:09.68,Default,Subaru,0,0,0,,Naucz się mówić grzecznie i\Nniech Frederica cię dobrze przeszkoli,
Dialogue: 0,0:17:09.77,0:17:10.81,Default,,0,0,0,,wtedy pomyślę.
Dialogue: 0,0:17:10.90,0:17:11.78,Default,Petra,0,0,0,,Dobrze!
Dialogue: 0,0:17:11.87,0:17:13.11,Default,Petra,0,0,0,,Tak jest!
Dialogue: 0,0:17:18.68,0:17:22.28,Default,Subaru,0,0,0,,Zapomniałem, jaka potrafi być kłopotliwa,\Nkiedy naprawdę chce się ukryć.
Dialogue: 0,0:17:22.46,0:17:24.89,Default,Petra,0,0,0,,Czy naprawdę jest tu tajemniczy pokój?
Dialogue: 0,0:17:25.24,0:17:26.97,Default,Subaru,0,0,0,,Tak, Beatrice.
Dialogue: 0,0:17:27.06,0:17:30.70,Default,Subaru,0,0,0,,Znasz ją, prawda? Zaopiekuj się też nią.
Dialogue: 0,0:17:31.28,0:17:35.28,Default,Subaru,0,0,0,,Możesz przypadkiem na nią trafić,\Notwierając jakieś drzwi.
Dialogue: 0,0:17:35.72,0:17:38.87,Default,Petra,0,0,0,,Poczekaj, Subaru! Nie wymagasz\Node mnie zbyt wiele?
Dialogue: 0,0:17:39.35,0:17:40.91,Default,Subaru,0,0,0,,Wiem, przepraszam.
Dialogue: 0,0:17:41.30,0:17:43.23,Default,Subaru,0,0,0,,Ale tylko ciebie mogę poprosić.
Dialogue: 0,0:17:43.32,0:17:44.58,Default,Subaru,0,0,0,,Naprawdę mi przykro.
Dialogue: 0,0:17:48.01,0:17:49.35,Default,Petra,0,0,0,,W porządku!
Dialogue: 0,0:17:49.44,0:17:52.00,Default,Petra,0,0,0,,Jeśli nalegasz, będę musiała ci pomóc!
Dialogue: 0,0:17:52.09,0:17:54.01,Default,Subaru,0,0,0,,Dzięki. Naprawdę bardzo mi pomagasz.
Dialogue: 0,0:17:55.43,0:17:57.47,Default,Emilia,0,0,0,,Zaopiekuj się rezydencją.
Dialogue: 0,0:17:57.56,0:18:00.22,Default,Emilia,0,0,0,,A także Rem, Petrą i Beatrice.
Dialogue: 0,0:18:00.68,0:18:02.27,Default,Frederica,0,0,0,,Możesz na mnie liczyć.
Dialogue: 0,0:18:02.36,0:18:05.18,Default,Frederica,0,0,0,,Uważaj na siebie podczas podróży, Emilia.
Dialogue: 0,0:18:05.99,0:18:07.55,Default,Frederica,0,0,0,,I weź to.
Dialogue: 0,0:18:08.26,0:18:10.63,Default,Frederica,0,0,0,,To pozwoli ci przejść\Nprzez barierę w lesie.
Dialogue: 0,0:18:10.72,0:18:12.94,Default,Frederica,0,0,0,,i wejść do Sanktuarium.
Dialogue: 0,0:18:13.52,0:18:17.78,Default,Frederica,0,0,0,,Stamtąd smoki lądowe zabiorą was do\Nmiejsca, które opisałam.
Dialogue: 0,0:18:18.34,0:18:22.06,Default,Subaru,0,0,0,,Więc ten kamień jest wymogiem\Ndo przejścia przez barierę?
Dialogue: 0,0:18:25.84,0:18:27.79,Default,Frederica,0,0,0,,Znacie miejsce i macie przepustkę.
Dialogue: 0,0:18:28.44,0:18:31.11,Default,Frederica,0,0,0,,Teraz potrzebujesz tylko\Ndeterminacji i silnej woli.
Dialogue: 0,0:18:32.68,0:18:33.83,Default,Emilia,0,0,0,,Frederica...
Dialogue: 0,0:18:37.44,0:18:39.82,Default,Frederica,0,0,0,,Zaopiekuj się Sanktuarium.
Dialogue: 0,0:18:40.16,0:18:42.68,Default,Frederica,0,0,0,,I nie zapomnij o tym,\Nco powiedziałam wcześniej.
Dialogue: 0,0:18:43.12,0:18:45.87,Default,Emilia,0,0,0,,Będziemy uważać na Garfiela.
Dialogue: 0,0:18:46.24,0:18:47.12,Default,Emilia,0,0,0,,Obiecuję.
Dialogue: 0,0:18:47.98,0:18:49.88,Default,Petra,0,0,0,,Um, Subaru...
Dialogue: 0,0:18:50.71,0:18:53.23,Default,Petra,0,0,0,,Czy mógłbyś to przyjąć?
Dialogue: 0,0:18:53.32,0:18:54.23,Default,Subaru,0,0,0,,Eee...
Dialogue: 0,0:18:54.48,0:18:57.05,Default,Frederica,0,0,0,,Podarowanie podróżnemu białej chusteczki,
Dialogue: 0,0:18:57.14,0:19:00.28,Default,Frederica,0,0,0,,którą po powrocie oddaje poplamioną i\Nzużytą podróżą,
Dialogue: 0,0:19:00.88,0:19:03.87,Default,Frederica,0,0,0,,to stary zwyczaj będący modlitwą o\Nbezpieczną drogę.
Dialogue: 0,0:19:04.16,0:19:06.26,Default,Subaru,0,0,0,,To jedna z tych rzeczy?
Dialogue: 0,0:19:06.84,0:19:09.06,Default,Subaru,0,0,0,,Dzięki, Petra.
Dialogue: 0,0:19:09.49,0:19:10.67,Default,Subaru,0,0,0,,Na pewno ją zwrócę.
Dialogue: 0,0:19:17.83,0:19:20.58,Default,Subaru,0,0,0,,Co spowodowało tę reakcję?
Dialogue: 0,0:19:20.98,0:19:23.64,Default,Subaru,0,0,0,,Ta nagła, buntownicza faza mnie zasmuca.
Dialogue: 0,0:19:25.64,0:19:27.76,Default,Frederica,0,0,0,,Powinniście się pospieszyć.
Dialogue: 0,0:19:28.22,0:19:32.85,Default,Frederica,0,0,0,,Zagubiony Las Clemaldy staje się bardziej\Nniebezpieczny w miarę zbliżania się nocy.
Dialogue: 0,0:19:36.00,0:19:38.26,Default,Frederica,0,0,0,,Życzę wam bezpiecznej podróży.
Dialogue: 0,0:19:39.39,0:19:41.49,Default,Petra,0,0,0,,Subaru!
Dialogue: 0,0:19:42.17,0:19:45.77,Default,Petra,0,0,0,,Lepiej ochraniaj damę!
Dialogue: 0,0:19:47.08,0:19:50.09,Default,Frederica,0,0,0,,Zrobiłam dokładnie tak, jak rozkazał pan.
Dialogue: 0,0:19:51.38,0:19:56.63,Default,Frederica,0,0,0,,Zobaczymy, jak Emilia pokona próbę\NSanktuarium.
Dialogue: 0,0:19:57.11,0:19:59.12,Default,Frederica,0,0,0,,Nie możemy nic zrobić, tylko się modlić.
Dialogue: 0,0:20:01.81,0:20:03.84,Default,Subaru,0,0,0,,Puck się nie pojawia?
Dialogue: 0,0:20:04.28,0:20:05.26,Default,Emilia,0,0,0,,Tak.
Dialogue: 0,0:20:05.35,0:20:06.95,Default,Emilia,0,0,0,,Kilkakrotnie go wołałam.
Dialogue: 0,0:20:07.04,0:20:09.59,Default,,0,0,0,,i czuję więź wynikającą z naszego\Nkontraktu, ale...
Dialogue: 0,0:20:09.98,0:20:12.09,Default,Subaru,0,0,0,,Czy coś takiego zdarzyło się wcześniej?
Dialogue: 0,0:20:12.18,0:20:15.67,Default,Emilia,0,0,0,,Nie bardzo często,\Nale było kilka razy
Dialogue: 0,0:20:15.76,0:20:18.15,Default,Emilia,0,0,0,,Kiedy nie pojawił się przez kilka dni.
Dialogue: 0,0:20:20.40,0:20:23.53,Default - flashback,Puck,0,0,0,,Liczę, że zaopiekujesz się Lią.
Dialogue: 0,0:20:24.13,0:20:25.14,Default,Subaru,0,0,0,,Nie mogło być...
Dialogue: 0,0:20:26.14,0:20:29.47,Default,Emilia,0,0,0,,Mam też kontrakty\Nz pomniejszymi duchami,
Dialogue: 0,0:20:29.56,0:20:31.60,Default,Emilia,0,0,0,,I mogę z nimi walczyć.
Dialogue: 0,0:20:31.69,0:20:34.32,Default,Emilia,0,0,0,,Cokolwiek się stanie, ochronię cię!
Dialogue: 0,0:20:34.41,0:20:36.27,Default,Subaru,0,0,0,,Ale z ciebie prawdziwy mężczyzna!
Dialogue: 0,0:20:36.36,0:20:37.36,Default,Emilia,0,0,0,,Hej!
Dialogue: 0,0:20:38.87,0:20:43.25,Default,Subaru,0,0,0,,Frederica ostrzegała nas,\Nże coś może się stać.
Dialogue: 0,0:20:43.34,0:20:45.85,Default,Emilia,0,0,0,,Garfiel, prawda?
Dialogue: 0,0:20:45.94,0:20:50.43,Default,Subaru,0,0,0,,Roswaal wspominał kilka razy,\Nże miał się z nim zobaczyć...
Dialogue: 0,0:20:50.52,0:20:51.72,Default,Otto,0,0,0,,Przepraszam!
Dialogue: 0,0:20:52.01,0:20:53.62,Default,Otto,0,0,0,,Jesteśmy w lesie!
Dialogue: 0,0:20:57.56,0:20:59.65,Default - flashback,Frederica,0,0,0,,{\i1}Zagubiony Las Clemaldy.{\i0}
Dialogue: 0,0:20:59.90,0:21:03.66,Default - flashback,Frederica,0,0,0,,Sanktuarium chroni specjalna bariera.
Dialogue: 0,0:21:04.08,0:21:07.41,Default - flashback,Frederica,0,0,0,,Sprawia, że obcy błądzą i nie mogą się\Nzbliżyć.
Dialogue: 0,0:21:07.91,0:21:11.12,Default - flashback,Frederica,0,0,0,,Dlatego nazwano go Zagubionym Lasem.
Dialogue: 0,0:21:11.77,0:21:14.19,Default,Subaru,0,0,0,,Więc Sanktuarium jest tuż przed nami...
Dialogue: 0,0:21:20.78,0:21:23.69,Default,Subaru,0,0,0,,Emilia, naprawdę jesteś zdenerwowana?
Dialogue: 0,0:21:23.78,0:21:25.93,Default,Emilia,0,0,0,,Skąd wiesz?
Dialogue: 0,0:21:26.30,0:21:28.61,Default,Subaru,0,0,0,,Wiem o tobie wszystko!
Dialogue: 0,0:21:28.70,0:21:32.16,Default,Subaru,0,0,0,,Chciałbym tak powiedzieć,\Nale każdy by się domyślił.
Dialogue: 0,0:21:36.55,0:21:37.94,Default,Emilia,0,0,0,,Masz rację!
Dialogue: 0,0:21:39.36,0:21:41.26,Default,Emilia,0,0,0,,Przepraszam, że cię martwię.
Dialogue: 0,0:21:41.35,0:21:43.40,Default,Emilia,0,0,0,,Gdy myślę, że dotrzemy do Sanktuarium,
Dialogue: 0,0:21:43.49,0:21:45.90,Default,Emilia,0,0,0,,wioski zamieszkanej wyłącznie przez\Npółludzi...
Dialogue: 0,0:21:46.68,0:21:50.33,Default,Subaru,0,0,0,,Nie pomyślałem o tym aż tak daleko.
Dialogue: 0,0:21:50.98,0:21:54.91,Default,Subaru,0,0,0,,Może są tam inni półelfowie tacy jak ty?
Dialogue: 0,0:21:55.50,0:21:59.39,Default,Emilia,0,0,0,,Nigdy nie widziałam\Nżadnego półelfa poza sobą.
Dialogue: 0,0:21:59.99,0:22:02.63,Default,Emilia,0,0,0,,Ale może w Sanktuarium...
Dialogue: 0,0:22:03.34,0:22:05.97,Default,Subaru,0,0,0,,Nie martw się. Ja...
Dialogue: 0,0:22:07.74,0:22:08.97,Default,Subaru,0,0,0,,Emilia?!
Dialogue: 0,0:22:09.44,0:22:10.97,Default,Emilia,0,0,0,,Czy to...
Dialogue: 0,0:22:11.13,0:22:13.23,Default,Subaru,0,0,0,,Mam nagle naprawdę złe przeczucie!
Dialogue: 0,0:22:13.32,0:22:14.43,Default,Subaru,0,0,0,,Pożyczam to, Emilio!
Dialogue: 0,0:22:18.81,0:22:19.86,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:22:31.72,0:22:33.99,Default,Subaru,0,0,0,,Gdzie... jestem?
Dialogue: 0,0:22:42.84,0:22:44.15,Default,Subaru,0,0,0,,Kim jesteś?
Dialogue: 0,0:22:45.44,0:22:46.60,Default,Subaru,0,0,0,,Te uszy...
Dialogue: 0,0:22:46.69,0:22:48.13,Default,Subaru,0,0,0,,Jesteś elfką?
Dialogue: 0,0:22:49.30,0:22:51.91,Default,Subaru,0,0,0,,Nie, czekaj! Zaczekaj chwilę!
Dialogue: 0,0:23:01.96,0:23:05.05,Default,Subaru,0,0,0,,Jest tu ktoś?
Dialogue: 0,0:23:05.59,0:23:09.09,Default,Subaru,0,0,0,,Jeśli to Sanktuarium,\Nniech ktoś mi odpowie!
Dialogue: 0,0:23:13.20,0:23:14.57,Default,Subaru,0,0,0,,To jest...
Dialogue: 0,0:23:29.39,0:23:30.34,Default,Echidna,0,0,0,,Rozumiem.
Dialogue: 0,0:23:31.20,0:23:33.79,Default,Echidna,0,0,0,,Więc to jest źródło twojego pragnienia?
Dialogue: 0,0:23:33.88,0:23:36.17,Default,Echidna,0,0,0,,Bardzo ciekawe.
Dialogue: 0,0:23:45.88,0:23:48.60,Default,Echidna,0,0,0,,Och, przestraszyłam cię?
Dialogue: 0,0:23:52.23,0:23:55.34,Default,Echidna,0,0,0,,Minęło sporo czasu odkąd\Nz kimś rozmawiałam.
Dialogue: 0,0:23:55.43,0:23:57.69,Default,Echidna,0,0,0,,Byłam zbyt podekscytowana.
Dialogue: 0,0:23:58.96,0:24:01.08,Default,Echidna,0,0,0,,Nazywam się Echidna...
Dialogue: 0,0:24:01.68,0:24:06.31,Default,Echidna,0,0,0,,A może lepiej znasz mnie jako\NCzarownicę Chciwości?
Dialogue: 0,0:24:06.96,0:24:09.96,Episode Title,Title,0,0,0,,{\fs24\t(1,3010,\fs30)\c&H000000&\bord0}Następne{\c&HCCCCCC&} {\c&H000000&}miejsce
Dialogue: 0,0:25:18.41,0:25:19.29,sign_36406_423_Missing,,0,0,0,,Jeśli...
Dialogue: 0,0:25:20.45,0:25:21.33,sign_36406_423_Missing,,0,0,0,,mam cię ocalić,
Dialogue: 0,0:25:21.74,0:25:22.64,sign_36406_423_Missing,,0,0,0,,nie obchodzi mnie,
Dialogue: 0,0:25:23.16,0:25:24.04,sign_36406_423_Missing,,0,0,0,,ile razy
Dialogue: 0,0:25:25.54,0:25:26.42,sign_36406_423_Missing,,0,0,0,,{\c&H1300C5&\4c&H0C0084&}u{\alpha&FF&\t(441,442,\alpha&00&)}mrę.
Dialogue: 0,0:24:09.96,0:24:16.96,Default,,0,0,0,,
