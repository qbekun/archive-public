Dialogue: 0,0:00:07.19,0:00:10.38,Default,Russell,0,0,0,,Gdyby cel Crusch\Nzostał osiągnięty,
Dialogue: 0,0:00:10.47,0:00:13.18,Default,Russell,0,0,0,,To z pewnością Pana\Nzadowoli, panie Wilhelmie.
Dialogue: 0,0:00:13.27,0:00:14.81,Default,Russell,0,0,0,,Oczekuję tego, co najlepsze.
Dialogue: 0,0:00:15.35,0:00:19.06,Default,Russell,0,0,0,,O rany, jakże to niezwykłe, że cię widzę!
Dialogue: 0,0:00:20.35,0:00:21.93,Default,Russell,0,0,0,,Przepraszam.
Dialogue: 0,0:00:22.33,0:00:26.40,Default,Russell,0,0,0,,Jestem skarbnikiem cechu\Nkupieckiego w stolicy.
Dialogue: 0,0:00:26.49,0:00:28.67,Default,Russell,0,0,0,,Nazywam się Russell Fellow.
Dialogue: 0,0:00:28.76,0:00:30.53,Default,Russell,0,0,0,,Miło mi cię poznać,
Dialogue: 0,0:00:32.18,0:00:34.08,Default,Russell,0,0,0,,Panie Subaru.
Dialogue: 0,0:00:37.32,0:00:39.30,Default,Subaru,0,0,0,,Wilhelm, kto to był?
Dialogue: 0,0:00:39.63,0:00:40.88,Default,Wilhelm,0,0,0,,Stypendysta Russella.
Dialogue: 0,0:00:41.53,0:00:43.07,Default,Wilhelm,0,0,0,,Pomimo tego, co powiedział,
Dialogue: 0,0:00:43.16,0:00:47.09,Default,Wilhelm,0,0,0,,jest sprytny i zajmuje się sprawami\Nfinansowymi, wewnętrznymi i zewnętrznymi.
Dialogue: 0,0:00:47.90,0:00:51.71,Default,Wilhelm,0,0,0,,Właśnie miałem wracać do środka...
Dialogue: 0,0:00:54.33,0:00:56.28,Default,Wilhelm,0,0,0,,Masz coś do powiedzenia?
Dialogue: 0,0:02:29.71,0:02:30.68,Default,Subaru,0,0,0,,Osoby pod nazwą
Dialogue: 0,0:02:30.77,0:02:34.17,Default,Subaru,0,0,0,,Kult Czarownicy planują zaatakować\Nposiadłość Roswaala za trzy dni.
Dialogue: 0,0:02:34.42,0:02:37.31,Default,Subaru,0,0,0,,Chciałbym prosić was o pomoc\Nw powstrzymaniu ich.
Dialogue: 0,0:02:37.91,0:02:39.01,Default,Crusch,0,0,0,,Rozumiem.
Dialogue: 0,0:02:39.15,0:02:40.79,Default,,0,0,0,,Więc w końcu się zdecydowali.
Dialogue: 0,0:02:40.88,0:02:41.98,Default,Felix,0,0,0,,Wygląda na to, że tak.
Dialogue: 0,0:02:42.16,0:02:46.03,Default,Felix,0,0,0,,Oczywiście od chwili, gdy na\Nscenę wkroczyła Emilia, półelfka,
Dialogue: 0,0:02:46.12,0:02:49.01,Default,Felix,0,0,0,,przewidzieliśmy, że coś takiego\Nmoże się wydarzyć.
Dialogue: 0,0:02:49.33,0:02:50.88,Default,Crusch,0,0,0,,Rozumiem tę sytuację.
Dialogue: 0,0:02:51.26,0:02:54.18,Default,Crusch,0,0,0,,Kolejne pytanie: dlaczego\Nwybrałeś do pomocy akurat mnie?
Dialogue: 0,0:02:54.27,0:02:58.43,Default,Subaru,0,0,0,,Szczerze mówiąc, to właśnie ty wydajesz\Nsię teraz najlepszy do pomocy.
Dialogue: 0,0:02:58.52,0:03:00.21,Default,Subaru,0,0,0,,Pomogliście Rem i mnie—
Dialogue: 0,0:03:00.30,0:03:01.30,Default,Crusch,0,0,0,,Nie zrozum tego źle.
Dialogue: 0,0:03:01.60,0:03:04.65,Default,Crusch,0,0,0,,Pomogłam wam, bo miałam taki\Nobowiązek wynikający z umowy.
Dialogue: 0,0:03:05.10,0:03:08.40,Default,Crusch,0,0,0,,Jeśli chcesz negocjować, musisz\Nmi pokazać, co mam z tego zyskać.
Dialogue: 0,0:03:08.49,0:03:10.78,Default,Crusch,0,0,0,,W przeciwnym razie nie ma o\Nczym rozmawiać.
Dialogue: 0,0:03:11.41,0:03:13.44,Default,Crusch,0,0,0,,Jeśli przy mojej pomocy,
Dialogue: 0,0:03:13.53,0:03:16.35,Default,,0,0,0,,można wyeliminować zagrożenie\Nze strony Kultu Czarownicy,
Dialogue: 0,0:03:16.44,0:03:17.78,Default,Crusch,0,0,0,,Jaki byłby mój zysk?
Dialogue: 0,0:03:17.89,0:03:19.01,Default,,0,0,0,,Powiedz mi to.
Dialogue: 0,0:03:20.32,0:03:23.28,Default,Subaru,0,0,0,,Jeśli pomożesz mi rozwiązać ten problem,
Dialogue: 0,0:03:23.44,0:03:25.97,Default,Subaru,0,0,0,,Będę miał wobec was ogromny\Ndług wdzięczności.
Dialogue: 0,0:03:27.12,0:03:29.24,Default,Crusch,0,0,0,,Czy powinnam przyjąć tę propozycję,
Dialogue: 0,0:03:29.54,0:03:32.98,Default,Crusch,0,0,0,,oznaczałoby to wycofanie się Emilii\Nz dążenia do władzy.
Dialogue: 0,0:03:33.17,0:03:34.65,Default,Crusch,0,0,0,,Rozumiesz to?
Dialogue: 0,0:03:35.95,0:03:37.10,Default,Crusch,0,0,0,,Czego się spodziewałeś?
Dialogue: 0,0:03:37.25,0:03:40.50,Default,Crusch,0,0,0,,Powierzenie swoich ziem innemu\Nwładcy to zdrada własnych ludzi
Dialogue: 0,0:03:40.69,0:03:42.79,Default,Crusch,0,0,0,,podważy jego zdolność do rządzenia krajem.
Dialogue: 0,0:03:43.33,0:03:45.43,Default,Crusch,0,0,0,,Mając to na uwadze, ponownie proszę was...
Dialogue: 0,0:03:45.69,0:03:48.04,Default,Crusch,0,0,0,,Jeśli w wyniku tego\Nzaciągniesz wobec mnie dług,
Dialogue: 0,0:03:48.15,0:03:50.50,Default,Crusch,0,0,0,,oznacza to usunięcie\NEmilii z dążenia do władzy
Dialogue: 0,0:03:51.24,0:03:52.74,Default,Crusch,0,0,0,,Jesteś pewien, że tego chcesz?
Dialogue: 0,0:03:54.50,0:03:55.71,Default,Subaru,0,0,0,,A jednak...
Dialogue: 0,0:03:55.97,0:03:57.22,Default,Subaru,0,0,0,,Potrzebuję twojej pomocy.
Dialogue: 0,0:03:58.21,0:04:00.75,Default,Subaru,0,0,0,,Jeśli ona umrze, to i tak\Nwszystko się skończy.
Dialogue: 0,0:04:02.56,0:04:03.46,Default,Crusch,0,0,0,,Rozumiem.
Dialogue: 0,0:04:04.02,0:04:08.07,Default,Crusch,0,0,0,,W takim razie rodzina Karstenów\Nnie udzieli żadnej pomocy.
Dialogue: 0,0:04:08.50,0:04:09.44,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:04:10.31,0:04:13.87,Default,Crusch,0,0,0,,Po pierwsze, warunek wycofania się Emilii,
Dialogue: 0,0:04:14.03,0:04:17.65,Default,Crusch,0,0,0,,który w akcie desperacji\Nprzedstawiłeś mi jako zaletę...
Dialogue: 0,0:04:18.53,0:04:21.13,Default,Crusch,0,0,0,,Nie ma to żadnego znaczenia\Nw tych negocjacjach.
Dialogue: 0,0:04:21.22,0:04:22.42,Default,Subaru,0,0,0,,Ale dlaczego?
Dialogue: 0,0:04:22.52,0:04:25.24,Default,Subaru,0,0,0,,Czy usnięcie jednego z\Nrywali nie jest rekompensatą?!
Dialogue: 0,0:04:25.70,0:04:27.36,Default,Crusch,0,0,0,,Naprawdę nie wiesz?
Dialogue: 0,0:04:27.75,0:04:29.80,Default,Crusch,0,0,0,,Wykluczenie Emilii z dążenia do władzy
Dialogue: 0,0:04:29.89,0:04:33.21,Default,Crusch,0,0,0,,to się stanie z moim udziałem czy bez.
Dialogue: 0,0:04:33.33,0:04:36.12,Default,Subaru,0,0,0,,Pozwolisz Kultowi Czarownicy na rzeź?
Dialogue: 0,0:04:36.21,0:04:38.60,Default,Subaru,0,0,0,,na mieszkańcach wiosek, na ziemi Roswaala?
Dialogue: 0,0:04:38.69,0:04:40.86,Default,Crusch,0,0,0,,Nie zmieniaj tematu, Panie Subaru.
Dialogue: 0,0:04:41.12,0:04:43.63,Default,Crusch,0,0,0,,Emilia nie ma takije mocy,\Nby chronić te tereny.
Dialogue: 0,0:04:43.80,0:04:46.48,Default,Crusch,0,0,0,,I Emilii podwładni zginą\Nz powodu jej niekompetencji.
Dialogue: 0,0:04:46.57,0:04:48.10,Default,Crusch,0,0,0,,To nie ja.
Dialogue: 0,0:04:48.35,0:04:51.26,Default,Subaru,0,0,0,,Pozwolenie na śmierć ludzi, to czyste zło.
Dialogue: 0,0:04:51.35,0:04:54.24,Default,Subaru,0,0,0,,Jeśli można ich uratować, to\Ndlaczego tego nie zrobić?!
Dialogue: 0,0:04:54.33,0:04:55.48,Default,Felix,0,0,0,,Hej, mam już tego dość—
Dialogue: 0,0:04:55.57,0:04:56.45,Default,Crusch,0,0,0,,W porządku.
Dialogue: 0,0:04:56.96,0:04:59.21,Default,Crusch,0,0,0,,Pozwól, że sprostuję pewne\Ntwoje przekonanie.
Dialogue: 0,0:04:59.54,0:05:01.72,Default,Crusch,0,0,0,,Załóżmy, że Kult Czarownicy\Nzacznie działać.
Dialogue: 0,0:05:01.81,0:05:03.38,Default,Crusch,0,0,0,,Niech spełni się to, co mówisz.
Dialogue: 0,0:05:03.83,0:05:05.63,Default,Crusch,0,0,0,,Problem pojawia się jednak później.
Dialogue: 0,0:05:05.75,0:05:06.92,Default,Subaru,0,0,0,,A potem?
Dialogue: 0,0:05:07.62,0:05:08.89,Default,Crusch,0,0,0,,To proste.
Dialogue: 0,0:05:09.25,0:05:13.35,Default,Crusch,0,0,0,,Skąd wiadomo, kiedy i gdzie zaatakują?
Dialogue: 0,0:05:14.02,0:05:15.20,Default,Subaru,0,0,0,,To...
Dialogue: 0,0:05:16.75,0:05:19.11,Default,Crusch,0,0,0,,Jeśli należysz do Kultu Czarownicy,
Dialogue: 0,0:05:19.20,0:05:20.33,Default,,0,0,0,,to miałoby sens.
Dialogue: 0,0:05:20.42,0:05:21.37,Default,Subaru,0,0,0,,To bzdura
Dialogue: 0,0:05:20.78,0:05:23.38,Default,Rem,0,0,0,,Crusch, proszę, nie żartuj.
Dialogue: 0,0:05:23.88,0:05:26.39,Default,Rem,0,0,0,,Subaru nie jest członkiem Kultu Czarownic.
Dialogue: 0,0:05:26.48,0:05:27.45,Default,Crusch,0,0,0,,{\a6}Naprawdę?
Dialogue: 0,0:05:27.54,0:05:29.33,Default,Crusch,0,0,0,,Biorąc pod uwagę to, co mówi,
Dialogue: 0,0:05:29.42,0:05:31.90,Default,,0,0,0,,jeśli nie potrafi wyjaśnić,\Nskąd zna te szczegóły,
Dialogue: 0,0:05:31.99,0:05:34.13,Default,Crusch,0,0,0,,Nie mogę wyciągnąć żadnego innego wniosku.
Dialogue: 0,0:05:34.50,0:05:37.31,Default,Crusch,0,0,0,,Czy nigdy nie wyczułeś w\Nnim czegoś takiego?
Dialogue: 0,0:05:38.90,0:05:39.82,Default,Rem,0,0,0,,Nigdy.
Dialogue: 0,0:05:41.23,0:05:46.68,Default,Crusch,0,0,0,,Niezależnie od tego nie mogę pomóc Emilii—
Dialogue: 0,0:05:46.77,0:05:48.49,Default,Subaru,0,0,0,,Zbliża się Kult Czarownicy!
Dialogue: 0,0:05:49.86,0:05:53.41,Default,Subaru,0,0,0,,Wybiją wszystkich mieszkańców wsi...
Dialogue: 0,0:05:54.10,0:05:54.98,Default,Subaru,0,0,0,,Zabij ich.
Dialogue: 0,0:05:55.17,0:05:56.67,Default,Subaru,0,0,0,,Po prostu musimy ich zabić!
Dialogue: 0,0:05:56.78,0:06:01.33,Default,Subaru,0,0,0,,Musimy tylko wykończyć każdego\Ndrania z tej sekty!
Dialogue: 0,0:06:01.42,0:06:04.37,Default,Subaru,0,0,0,,To rozwiąże wszystkie problemy! Wszystkie!
Dialogue: 0,0:06:04.66,0:06:05.71,Default,Subaru,0,0,0,,Rozumiesz to?
Dialogue: 0,0:06:05.80,0:06:08.08,Default,,0,0,0,,Nie możemy pozwolić tym draniom przeżyć!
Dialogue: 0,0:06:08.18,0:06:09.62,Default,Subaru,0,0,0,,Zabiję ich!
Dialogue: 0,0:06:10.70,0:06:13.39,Default,Subaru,0,0,0,,Proszę, pomóż mi!
Dialogue: 0,0:06:16.24,0:06:18.61,Default,Crusch,0,0,0,,Czy to dlatego zachowujesz\Nsię w ten sposób?
Dialogue: 0,0:06:21.21,0:06:22.79,Default,Crusch,0,0,0,,Ta nienawiść do Kultu...
Dialogue: 0,0:06:22.97,0:06:26.39,Default,Crusch,0,0,0,,Czy to jest prawdziwy powód,\Ndla którego zwróciłeś się do Emilii?
Dialogue: 0,0:06:26.53,0:06:28.25,Default,Subaru,0,0,0,,Nie, ja…
Dialogue: 0,0:06:28.34,0:06:33.64,Default,Crusch,0,0,0,,Ten błysk w twoich oczach to\Nnic innego jak żądza mordu.
Dialogue: 0,0:06:35.26,0:06:39.31,Default,Subaru,0,0,0,,Chcesz powiedzieć, że wykorzystuję\NEmilię jako pretekst do zemsty na nich?!
Dialogue: 0,0:06:39.99,0:06:42.80,Default,Subaru,0,0,0,,Moja nienawiść nie ma nic wspólnego z tym!
Dialogue: 0,0:06:42.89,0:06:44.63,Default,Subaru,0,0,0,,Nie można pozwolić im żyć...
Dialogue: 0,0:06:44.75,0:06:46.98,Default,Subaru,0,0,0,,Dlatego musimy ich wszystkich zabić!
Dialogue: 0,0:06:47.14,0:06:49.46,Default,Subaru,0,0,0,,To uratuje wszystkich!
Dialogue: 0,0:06:52.83,0:06:55.18,Default,Crusch,0,0,0,,Jestem pewna, że już ci to\Nmówiłam, Subaru.
Dialogue: 0,0:06:55.49,0:06:58.88,Default,Crusch,0,0,0,,Żeby oszukać innych, musisz najpierw\Nsam uwierzyć w swoje kłamstwo.
Dialogue: 0,0:06:59.01,0:07:00.80,Default,Subaru,0,0,0,,Dlaczego...
Dialogue: 0,0:07:00.89,0:07:01.97,Default,Crusch,0,0,0,,Nie wiesz dlaczego?
Dialogue: 0,0:07:02.06,0:07:03.64,Default,,0,0,0,,Ani razu tego nie powiedziałeś
Dialogue: 0,0:07:03.90,0:07:06.12,Default,Crusch,0,0,0,,że chcesz uratować Emilię.
Dialogue: 0,0:07:16.13,0:07:19.12,Default,Wilhelm,0,0,0,,Nie mogę pozwolić ci podejść bliżej.
Dialogue: 0,0:07:20.61,0:07:21.84,Default,Rem,0,0,0,,Subaru,
Dialogue: 0,0:07:22.53,0:07:23.54,Default,,0,0,0,,Proszę, uspokój się.
Dialogue: 0,0:07:26.37,0:07:32.22,Default,Crusch,0,0,0,,Zazwyczaj potrafię rozpoznać, kiedy\Nosoba, z którą rozmawiam, kłamie.
Dialogue: 0,0:07:32.96,0:07:37.35,Default,Crusch,0,0,0,,Prawdziwa duma – oszukać wytrawnego\Ngracza graniczy z cudem.
Dialogue: 0,0:07:37.99,0:07:40.36,Default,Crusch,0,0,0,,Opierając się na wieloletnim\Ndoświadczeniu,
Dialogue: 0,0:07:40.45,0:07:42.14,Default,Crusch,0,0,0,,Mogę powiedzieć, że nie kłamiesz.
Dialogue: 0,0:07:42.23,0:07:43.47,Default,Subaru,0,0,0,,No cóż, w takim razie...
Dialogue: 0,0:07:43.64,0:07:46.69,Default,Crusch,0,0,0,,Jesteś głęboko przekonany, że to, co\Nwygłaszasz, jest prawdą.
Dialogue: 0,0:07:46.83,0:07:50.55,Default,Crusch,0,0,0,,To po prostu szaleństwo,
Dialogue: 0,0:07:51.25,0:07:52.58,Default,Crusch,0,0,0,,Subaru.
Dialogue: 0,0:07:56.91,0:07:58.74,Default,Crusch,0,0,0,,Felis, wylecz mu wargę.
Dialogue: 0,0:07:58.86,0:08:00.31,Default,Subaru,0,0,0,,Nie zawracaj sobie tym głowy!
Dialogue: 0,0:08:01.55,0:08:02.92,Default,Subaru,0,0,0,,Rem, chodźmy.
Dialogue: 0,0:08:03.59,0:08:05.07,Default,Crusch,0,0,0,,Czy masz jeszcze kogoś?
Dialogue: 0,0:08:05.85,0:08:08.25,Default,Subaru,0,0,0,,Mam nadzieję, że zostaniesz\Nwspaniałym władcą...
Dialogue: 0,0:08:08.34,0:08:10.42,Default,Subaru,0,0,0,,Taki dyktator, który porzuca słabszych.
Dialogue: 0,0:08:16.20,0:08:18.96,Default,Rem,0,0,0,,W imieniu mojego pana\Nskładam wam podziękowania
Dialogue: 0,0:08:19.29,0:08:20.99,Default,,0,0,0,,za opiekę, jaką nam zapewniliście.
Dialogue: 0,0:08:23.49,0:08:24.74,Default,Rem,0,0,0,,Co zrobimy?
Dialogue: 0,0:08:24.83,0:08:28.05,Default,Rem,0,0,0,,Jeśli to, co mówisz, jest prawdą,\Nto mamy niewiele czasu.
Dialogue: 0,0:08:28.40,0:08:29.81,Default,Subaru,0,0,0,,„Jeśli” to prawda?
Dialogue: 0,0:08:30.43,0:08:31.90,Default,Rem,0,0,0,,Mamy mało czasu.
Dialogue: 0,0:08:32.47,0:08:34.37,Default,Rem,0,0,0,,Może wrócimy do pana Roswaala?
Dialogue: 0,0:08:34.94,0:08:38.90,Default,Subaru,0,0,0,,Nie, niewiele byśmy teraz zrobili,\Ngdybyśmy tam wrócili.
Dialogue: 0,0:08:39.13,0:08:40.82,Default,Subaru,0,0,0,,Jest nas za mało.
Dialogue: 0,0:08:41.49,0:08:43.29,Default,Subaru,0,0,0,,Co, do diabła, robi Roswaal?
Dialogue: 0,0:08:43.81,0:08:48.85,Default,Rem,0,0,0,,Pan Roswaal musiał odwiedzić\Nkilku urzędników w królestwie.
Dialogue: 0,0:08:48.94,0:08:51.12,Default,Rem,0,0,0,,Zostanie u nich przez kilka dni.
Dialogue: 0,0:08:51.21,0:08:53.61,Default,Subaru,0,0,0,,To dlatego nie może nic zrobić?
Dialogue: 0,0:08:54.16,0:08:57.36,Default,Subaru,0,0,0,,W takim razie, jeśli nie znajdziemy\Nposiłków, nic nam to nie da.
Dialogue: 0,0:09:00.38,0:09:01.51,Default,Subaru,0,0,0,,A co z Reinhardem?
Dialogue: 0,0:09:01.60,0:09:02.89,Default,,0,0,0,,Czyż nie pomógłby nam?
Dialogue: 0,0:09:03.13,0:09:05.09,Default,Rem,0,0,0,,Wczoraj powiedział, że
Dialogue: 0,0:09:05.22,0:09:07.78,Default,,0,0,0,,wyjedzie na chwilę ze stolicy z\Nwizytą kurtuazyjną.
Dialogue: 0,0:09:07.87,0:09:08.79,Default,Subaru,0,0,0,,Cholera!
Dialogue: 0,0:09:08.94,0:09:11.62,Default,Subaru,0,0,0,,Dlaczego wszyscy jesteście\Ntacy bezużyteczni?!
Dialogue: 0,0:09:16.96,0:09:19.33,Default,Subaru,0,0,0,,Jutro poszukamy kogoś innego,\Nkto nam pomoże.
Dialogue: 0,0:09:19.78,0:09:21.89,Default,Subaru,0,0,0,,Kierujesz się do posterunku rycerzy.
Dialogue: 0,0:09:22.17,0:09:25.00,Default,Subaru,0,0,0,,Zamierzam porozmawiać z jednym\Nz pozostałych kandydatów.
Dialogue: 0,0:09:25.09,0:09:26.18,Default,Rem,0,0,0,,W porządku.
Dialogue: 0,0:09:27.57,0:09:29.25,Default,Priscilla,0,0,0,,Kult czarownicy?
Dialogue: 0,0:09:29.59,0:09:30.77,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:09:30.89,0:09:33.46,Default,,0,0,0,,Jeśli ich nie powstrzymamy,\Nskrzywdzą wielu ludzi.
Dialogue: 0,0:09:33.69,0:09:36.10,Default,Subaru,0,0,0,,Emilia nie będzie ich jedyną ofiarą.
Dialogue: 0,0:09:36.25,0:09:38.17,Default,Subaru,0,0,0,,Chcę ich pokonać, zanim to się stanie!
Dialogue: 0,0:09:38.26,0:09:39.31,Default,,0,0,0,,Właśnie dlatego ja—
Dialogue: 0,0:09:41.30,0:09:44.00,Default,Priscilla,0,0,0,,Zabawne... Jesteś zabawny!
Dialogue: 0,0:09:44.33,0:09:45.28,Default,Priscilla,0,0,0,,Rzeczywiście.
Dialogue: 0,0:09:45.38,0:09:48.77,Default,,0,0,0,,Każdy błazen, który tu dotarł,\Nopanował swój numer do perfekcji.
Dialogue: 0,0:09:49.52,0:09:50.92,Default,Subaru,0,0,0,,Co w tym takiego śmiesznego?
Dialogue: 0,0:09:51.27,0:09:53.60,Default,Priscilla,0,0,0,,Rozumiem twoją desperację,
Dialogue: 0,0:09:53.77,0:09:55.86,Default,Priscilla,0,0,0,,ale nie przemyślałeś tego dokładnie.
Dialogue: 0,0:09:56.43,0:10:01.66,Default,Priscilla,0,0,0,,Pomagając na oślep, wspierasz wroga\Ni tracisz kontrolę.
Dialogue: 0,0:10:01.87,0:10:03.74,Default,Priscilla,0,0,0,,Lepiej już umrzeć.
Dialogue: 0,0:10:04.41,0:10:10.17,Default,Priscilla,0,0,0,,Właściwie to mogłabym ci teraz\Npo prostu ściąć głowę.
Dialogue: 0,0:10:11.14,0:10:14.58,Default,Priscilla,0,0,0,,Jednak nawet w obliczu\Ntak surowego traktowania,
Dialogue: 0,0:10:14.67,0:10:18.93,Default,Priscilla,0,0,0,,Twoje oddanie wobec pana\Njest co najmniej godne pochwały.
Dialogue: 0,0:10:19.87,0:10:21.12,Default,Priscilla,0,0,0,,No więc...
Dialogue: 0,0:10:21.87,0:10:23.18,Default,Priscilla,0,0,0,,Dam ci szansę.
Dialogue: 0,0:10:23.79,0:10:24.72,Default,Subaru,0,0,0,,Może… okazja?
Dialogue: 0,0:10:24.81,0:10:26.29,Default,Priscilla,0,0,0,,Tak, to szansa.
Dialogue: 0,0:10:26.42,0:10:28.26,Default,Priscilla,0,0,0,,To, co można by nazwać „szansą”.
Dialogue: 0,0:10:30.93,0:10:31.81,Default,Priscilla,0,0,0,,Poliż to.
Dialogue: 0,0:10:31.90,0:10:32.78,Default,,0,0,0,,Co?
Dialogue: 0,0:10:32.87,0:10:34.48,Default,Priscilla,0,0,0,,Czołgaj się po podłodze,
Dialogue: 0,0:10:34.59,0:10:36.80,Default,Priscilla,0,0,0,,rozkoszując się wstydem i upokorzeniem.
Dialogue: 0,0:10:36.89,0:10:38.88,Default,Priscilla,0,0,0,,I niczym nieszczęsna bestia,
Dialogue: 0,0:10:39.00,0:10:41.52,Default,Priscilla,0,0,0,,jak niemowlę ssące sutek matki,
Dialogue: 0,0:10:41.61,0:10:43.40,Default,Priscilla,0,0,0,,poliż mi stopę.
Dialogue: 0,0:10:44.05,0:10:47.27,Default,Priscilla,0,0,0,,Jeśli to zrobisz, rozważę\Ntwoją propozycję.
Dialogue: 0,0:10:48.40,0:10:50.35,Default,Priscilla,0,0,0,,Jeśli nie chcesz, to nic nie szkodzi...
Dialogue: 0,0:10:50.56,0:10:53.03,Default,Priscilla,0,0,0,,Jeśli wolisz raczej zadbać\No swoją nikłą dumę
Dialogue: 0,0:10:53.12,0:10:57.09,Default,Priscilla,0,0,0,,i porzucić kochankę, dla której\Nstarałeś się, no cóż, w porządku.
Dialogue: 0,0:10:57.51,0:11:00.98,Default,Priscilla,0,0,0,,Którąkolwiek opcję wybierzesz,\Nbędę się dobrze bawić.
Dialogue: 0,0:11:06.88,0:11:08.32,Default,Subaru,0,0,0,,No dobrze.
Dialogue: 0,0:11:23.60,0:11:27.87,Default,Priscilla,0,0,0,,Chyba naprawdę jesteś po prostu nikim!
Dialogue: 0,0:11:31.09,0:11:34.53,Default,Priscilla,0,0,0,,To, co właśnie pokazałeś, nie było\Nani lojalnością, ani oddaniem.
Dialogue: 0,0:11:34.62,0:11:38.45,Default,Priscilla,0,0,0,,To coś obrzydliwego, jak przywiązanie\Npsa czy chciwość świni,
Dialogue: 0,0:11:38.54,0:11:40.72,Default,Priscilla,0,0,0,,Ty leniwy świnio, która\Numiesz tylko chcieć!
Dialogue: 0,0:11:40.81,0:11:43.12,Default,Priscilla,0,0,0,,Chciwość świni to najgorsza\Nrzecz na świecie!
Dialogue: 0,0:11:44.60,0:11:47.16,Default,Priscilla,0,0,0,,Nawet jeśli Kult Czarownicy\Nzostanie pokonany,
Dialogue: 0,0:11:47.25,0:11:51.35,Default,Priscilla,0,0,0,,Zniszczę każdy obóz, do którego należysz!
Dialogue: 0,0:11:51.44,0:11:55.23,Default,Priscilla,0,0,0,,Twoje zachowanie i postawa\Nskłoniły mnie do podjęcia tej decyzji!
Dialogue: 0,0:12:01.10,0:12:01.98,Default,Priscilla,0,0,0,,Aldebaran.
Dialogue: 0,0:12:03.03,0:12:05.19,Default,Al,0,0,0,,Hej, no proszę... Co tu się stało?
Dialogue: 0,0:12:05.28,0:12:07.60,Default,Priscilla,0,0,0,,Wyrzućcie stąd tego okropnego głupca.
Dialogue: 0,0:12:07.70,0:12:09.70,Default,Priscilla,0,0,0,,Zabij go. To bez znaczenia.
Dialogue: 0,0:12:09.97,0:12:12.03,Default,Al,0,0,0,,Myślę, że to ma spore znaczenie.
Dialogue: 0,0:12:12.74,0:12:14.35,Default,Al,0,0,0,,Chodźmy, stary.
Dialogue: 0,0:12:15.73,0:12:17.43,Default,Al,0,0,0,,Nie denerwuj się tak, księżniczko.
Dialogue: 0,0:12:17.78,0:12:20.26,Default,Al,0,0,0,,Takie spojrzenie\Nszpeci twoją uroczą buzię.
Dialogue: 0,0:12:20.60,0:12:23.75,Default,Priscilla,0,0,0,,Chcesz, aby twoja zniszczona\Ntwarz ucierpiała jeszcze bardziej.
Dialogue: 0,0:12:23.84,0:12:25.92,Default,Priscilla,0,0,0,,Zabierz go stąd natychmiast, Aldebaran.
Dialogue: 0,0:12:26.01,0:12:28.48,Default,Al,0,0,0,,Mówiłem ci, żebyś mnie tak nie nazywał...
Dialogue: 0,0:12:29.68,0:12:31.01,Default,Al,0,0,0,,Czy możesz wstać, bracie?
Dialogue: 0,0:12:31.24,0:12:32.56,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:12:33.19,0:12:34.54,Default,Al,0,0,0,,Wyglądasz na zdrowego.
Dialogue: 0,0:12:34.63,0:12:36.77,Default,Al,0,0,0,,Nie wiem, o czym rozmawialiście,
Dialogue: 0,0:12:37.41,0:12:40.04,Default,Al,0,0,0,,ale wygląda na to, że nie\Nposzło zbyt dobrze.
Dialogue: 0,0:12:43.16,0:12:44.55,Default,Al,0,0,0,,Jeśli to potrwa zbyt długo,
Dialogue: 0,0:12:44.64,0:12:48.07,Default,,0,0,0,,może mi naprawdę kazać\Ncię przeciąć na pół,
Dialogue: 0,0:12:48.16,0:12:49.26,Default,,0,0,0,,Więc wracam.
Dialogue: 0,0:12:49.35,0:12:50.42,Default,Al,0,0,0,,Do zobaczenia, stary.
Dialogue: 0,0:12:53.17,0:12:55.27,Default - italics,Subaru,0,0,0,,Ta cholerna zarozumiała suka...
Dialogue: 0,0:12:55.36,0:12:58.63,Default - italics,Subaru,0,0,0,,Zapomina, że uratowałem ją, kiedy\Npoznaliśmy się po raz pierwszy!
Dialogue: 0,0:13:01.21,0:13:02.41,Default,Subaru,0,0,0,,Zmień bieg.
Dialogue: 0,0:13:02.50,0:13:04.76,Default,,0,0,0,,Nie ma czasu, żeby ci idioci\Nmnie spowalniali.
Dialogue: 0,0:13:04.92,0:13:06.22,Default,Mimi,0,0,0,,Wąch, wąch. Wąch, wąch.
Dialogue: 0,0:13:06.65,0:13:09.56,Default,Mimi,0,0,0,,To wygląda na naprawdę\Nbolesne! Wszystko w porządku?
Dialogue: 0,0:13:10.58,0:13:11.52,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:13:12.12,0:13:14.99,Default,Mimi,0,0,0,,Pachniesz krwią, i to nie tylko z ust.
Dialogue: 0,0:13:15.14,0:13:17.14,Default,Mimi,0,0,0,,Czy krwawiło ci z nosa?
Dialogue: 0,0:13:17.44,0:13:19.98,Default,Anastasia,0,0,0,,No już, Mimi, nie wygłupiaj się.
Dialogue: 0,0:13:20.28,0:13:21.30,Default,Mimi,0,0,0,,Okej!
Dialogue: 0,0:13:21.39,0:13:24.97,Default,Anastasia,0,0,0,,Bardzo mi przykro, że\Nsprawiała ci kłopoty.
Dialogue: 0,0:13:25.14,0:13:27.52,Default,Anastasia,0,0,0,,Hm? Czy to nie jesteś...
Dialogue: 0,0:13:27.75,0:13:29.80,Default,Anastasia,0,0,0,,No tak, to ty jesteś Subaru.
Dialogue: 0,0:13:29.89,0:13:32.70,Default,Anastasia,0,0,0,,Rycerz Emilii, Pan Subaru.
Dialogue: 0,0:13:32.79,0:13:34.55,Default,Anastasia,0,0,0,,Czy to nie przypadek?
Dialogue: 0,0:13:35.56,0:13:37.27,Default,Subaru,0,0,0,,Anastasia Hoshin...
Dialogue: 0,0:13:41.13,0:13:42.80,Default,Mimi,0,0,0,,Do stołu!
Dialogue: 0,0:13:44.33,0:13:46.13,Default,Subaru,0,0,0,,A więc co do wozu z smokami...
Dialogue: 0,0:13:46.45,0:13:48.73,Default,Anastasia,0,0,0,,Nie owijasz w bawełnę.
Dialogue: 0,0:13:49.01,0:13:52.47,Default,Anastasia,0,0,0,,Nikogo nie uszczęśliwisz,\Nmyśląc tylko o sobie.
Dialogue: 0,0:13:52.65,0:13:56.60,Default,Anastasia,0,0,0,,Staranie się zyskać przychylność drugiej\Nstrony to podstawowa zasada negocjacji.
Dialogue: 0,0:13:56.80,0:13:58.83,Default,Anastasia,0,0,0,,Właśnie tego ci brakuje, Subaru.
Dialogue: 0,0:13:58.92,0:14:01.17,Default,Subaru,0,0,0,,Przepraszam, ale mam tu poważny problem.
Dialogue: 0,0:14:01.51,0:14:03.81,Default,Subaru,0,0,0,,Chcę jutro wyjechać ze stolicy, więc...
Dialogue: 0,0:14:04.21,0:14:05.88,Default,Anastasia,0,0,0,,Kiedy spotykasz takich jak ja
Dialogue: 0,0:14:05.97,0:14:09.49,Default,,0,0,0,,granie na sentymentach\Nto najgorsza możliwa strategia.
Dialogue: 0,0:14:10.14,0:14:12.46,Default,Anastasia,0,0,0,,Ale doceniam twój wysiłek.
Dialogue: 0,0:14:13.89,0:14:18.16,Default,Anastasia,0,0,0,,W tej chwili nie jest łatwo znaleźć w\Nstolicy powóz ciągnięty przez smoki.
Dialogue: 0,0:14:18.50,0:14:21.26,Default,Anastasia,0,0,0,,Najwyraźniej ktoś je wszystkie wykupuje.
Dialogue: 0,0:14:21.52,0:14:24.80,Default,Anastasia,0,0,0,,Proszę. Pod tym adresem\Npowinien stać powóz.
Dialogue: 0,0:14:24.94,0:14:26.97,Default,Anastasia,0,0,0,,Podpisałam to własnoręcznie.
Dialogue: 0,0:14:27.52,0:14:28.93,Default,Anastasia,0,0,0,,To wszystko załatwi.
Dialogue: 0,0:14:32.08,0:14:33.22,Default,Subaru,0,0,0,,Nie zadzieraj nosa...
Dialogue: 0,0:14:33.67,0:14:35.32,Default,Anastasia,0,0,0,,Na pewno będę się wywyższać.
Dialogue: 0,0:14:35.41,0:14:38.14,Default,Anastasia,0,0,0,,Zwykłe przekazanie sprawy\Nbyłoby nudne, prawda?
Dialogue: 0,0:14:38.41,0:14:41.52,Default,Anastasia,0,0,0,,Chciałam tylko pogadać z tobą\No tym i o tamtym.
Dialogue: 0,0:14:41.62,0:14:44.65,Default,Subaru,0,0,0,,Po co się tym przejmować?\NNic na tym nie zyskasz.
Dialogue: 0,0:14:45.15,0:14:49.60,Default,Anastasia,0,0,0,,Wierzę, że nie ma na tym świecie niczego,\Nco nie miałoby znaczenie.
Dialogue: 0,0:14:50.03,0:14:53.38,Default,Anastasia,0,0,0,,Nigdy nie wiadomo, kto może\Ncię zainspirować.
Dialogue: 0,0:14:55.00,0:14:56.46,Default,Subaru,0,0,0,,O czym rozmawiamy?
Dialogue: 0,0:14:57.20,0:14:58.66,Default,Mimi,0,0,0,,Hej, moja droga,
Dialogue: 0,0:14:58.78,0:15:00.17,Default,,0,0,0,,Chcę jeszcze trochę zjeść!
Dialogue: 0,0:15:00.26,0:15:01.38,Default,,0,0,0,,Czy mogę zamówić?
Dialogue: 0,0:15:01.47,0:15:03.29,Default,Anastasia,0,0,0,,Jasne. Jedz, ile chcesz.
Dialogue: 0,0:15:03.54,0:15:06.08,Default,Anastasia,0,0,0,,Ale nie pobrudź sobie ust sosem.
Dialogue: 0,0:15:06.17,0:15:07.84,Default,Mimi,0,0,0,,Proszę, wytrzyj mi twarz!
Dialogue: 0,0:15:10.20,0:15:12.08,Default,Mimi,0,0,0,,Super! Wracam!
Dialogue: 0,0:15:13.37,0:15:14.83,Default,Anastasia,0,0,0,,Pomimo swojego wyglądu,
Dialogue: 0,0:15:14.95,0:15:17.34,Default,,0,0,0,,jest moją zastępczynią w mojej\Nprywatnej armii.
Dialogue: 0,0:15:17.49,0:15:18.56,Default,Subaru,0,0,0,,Prywatna armia?
Dialogue: 0,0:15:19.06,0:15:21.03,Default,Mimi,0,0,0,,{\an8}Ja też tego chcę!
Dialogue: 0,0:15:19.12,0:15:21.09,Default,Anastasia,0,0,0,,W Kararagi jest to dość znane.
Dialogue: 0,0:15:21.33,0:15:25.07,Default,Anastasia,0,0,0,,„Żelazny Kieł” – prywatny oddział\Nnajemników firmy Hoshin.
Dialogue: 0,0:15:25.86,0:15:27.76,Default,Anastasia,0,0,0,,Czyż nie jest urocza?
Dialogue: 0,0:15:27.89,0:15:30.58,Default,Anastasia,0,0,0,,Nie ma nic lepszego niż spanie\Nz nią w ramionach!
Dialogue: 0,0:15:32.45,0:15:35.91,Default,Anastasia,0,0,0,,Ostatnio w stolicy gromadzi\Nsię mnóstwo ludzi.
Dialogue: 0,0:15:36.18,0:15:39.30,Default,Anastasia,0,0,0,,Czy zauważyłeś, że atmosfera\Nsię zmieniła, Subaru?
Dialogue: 0,0:15:40.67,0:15:43.93,Default,Subaru,0,0,0,,Skoro o tym wspominasz, to fakt\Nwszyscy wyglądali, jakby oszaleli.
Dialogue: 0,0:15:44.02,0:15:45.17,Default,Subaru,0,0,0,,Czy to z powodu władcy?
Dialogue: 0,0:15:45.51,0:15:47.72,Default,Anastasia,0,0,0,,Kiedy rządzący działają,\Nludzie idą za nimi.
Dialogue: 0,0:15:47.90,0:15:50.20,Default,Anastasia,0,0,0,,Kiedy ludzie się ruszają,\Nwszystko się rusza.
Dialogue: 0,0:15:50.40,0:15:54.89,Default,Anastasia,0,0,0,,A tak przy okazji, ceny w stolicy\Nbardzo się teraz wahają.
Dialogue: 0,0:15:55.17,0:15:57.56,Default,Anastasia,0,0,0,,Najenniejszy produkt, to żelazo.
Dialogue: 0,0:15:58.02,0:16:01.97,Default,Anastasia,0,0,0,,Broń - miecze i włócznie, jest ściągana z\Ncałego kraju i z zagranicy.
Dialogue: 0,0:16:02.26,0:16:03.97,Default,Subaru,0,0,0,,Żelazo i broń?
Dialogue: 0,0:16:04.17,0:16:07.78,Default,Subaru,0,0,0,,Chyba nie zamierzają iść na\Nwojnę z tymi maszynami, prawda?
Dialogue: 0,0:16:07.89,0:16:11.15,Default,Anastasia,0,0,0,,Możliwe też, że ich celem nie jest\Nzdobycie tych przedmiotów,
Dialogue: 0,0:16:11.24,0:16:12.74,Default,,0,0,0,,ale o ożywienie gospodarki.
Dialogue: 0,0:16:13.22,0:16:14.62,Default,Subaru,0,0,0,,Sposób, w jaki to rzekłeś...
Dialogue: 0,0:16:14.82,0:16:17.46,Default,Subaru,0,0,0,,Czy wiadomo, kto zbiera całe to żelazo?
Dialogue: 0,0:16:18.00,0:16:20.46,Default,Anastasia,0,0,0,,To ktoś, kogo dobrze znasz, Natsuki.
Dialogue: 0,0:16:21.81,0:16:23.67,Default,Anastasia,0,0,0,,Księżna Crusch Karsten.
Dialogue: 0,0:16:24.35,0:16:25.65,Default,Subaru,0,0,0,,To Crusch?
Dialogue: 0,0:16:26.04,0:16:29.10,Default,Subaru,0,0,0,,Jak tak sobie pomyśleć, to\Nrzeczywiście ciągle miała gości...
Dialogue: 0,0:16:30.38,0:16:31.44,Default,Subaru,0,0,0,,Rozumiem.
Dialogue: 0,0:16:31.94,0:16:34.85,Default,,0,0,0,,Właśnie dlatego ten Russell tam był.
Dialogue: 0,0:16:35.12,0:16:36.59,Default,Anastasia,0,0,0,,Stypendysta Russella?
Dialogue: 0,0:16:37.21,0:16:38.59,Default,Anastasia,0,0,0,,To całkiem gruba ryba.
Dialogue: 0,0:16:39.38,0:16:41.86,Default,Anastasia,0,0,0,,To było całkiem pouczające.
Dialogue: 0,0:16:42.44,0:16:44.50,Default,Anastasia,0,0,0,,Dziękuję, Natsuki!
Dialogue: 0,0:16:45.65,0:16:49.36,Default,Anastasia,0,0,0,,Po wczorajszej kłótni z Crusch\Nwyszedłeś z jej mieszkania, prawda?
Dialogue: 0,0:16:49.57,0:16:51.88,Default,Anastasia,0,0,0,,Myślałam, że to będzie\Nłatwe do nauczenia się
Dialogue: 0,0:16:51.98,0:16:55.75,Default,,0,0,0,,wszelkiego rodzaju informacje\Npłynące z twoich ust, oczu i mimiki!
Dialogue: 0,0:17:00.34,0:17:02.73,Default,Subaru,0,0,0,,Wprowadziłeś mnie w błąd\Nod samego początku?
Dialogue: 0,0:17:04.17,0:17:06.85,Default,Subaru,0,0,0,,Czy jesteś z siebie zadowolony,
Dialogue: 0,0:17:06.97,0:17:09.80,Default,,0,0,0,,używając takich nieuczciwych metod?
Dialogue: 0,0:17:10.47,0:17:12.90,Default,Anastasia,0,0,0,,Jeśli chcesz kogoś przekonać,\Nże masz rację,
Dialogue: 0,0:17:12.99,0:17:15.25,Default,,0,0,0,,trzeba się jakoś wykazać,\Nżeby na to zasłużyć.
Dialogue: 0,0:17:15.34,0:17:17.90,Default,Anastasia,0,0,0,,A w tobie nie dostrzegam niczego takiego.
Dialogue: 0,0:17:18.20,0:17:21.68,Default,Anastasia,0,0,0,,Jedynym sposobem na zmianę swojej\Nreputacji jest zastąpienie jej inną.
Dialogue: 0,0:17:22.58,0:17:25.01,Default,Anastasia,0,0,0,,To, co zrobiłeś, decyduje o\Ntwojej reputacji.
Dialogue: 0,0:17:25.37,0:17:26.72,Default,Anastasia,0,0,0,,To znaczy twoja przeszłość.
Dialogue: 0,0:17:26.90,0:17:29.05,Default,Anastasia,0,0,0,,A przeszłości nie da się zmienić,
Dialogue: 0,0:17:29.30,0:17:32.10,Default,Anastasia,0,0,0,,więc moje zdanie o tobie\Nteż się nie zmieni.
Dialogue: 0,0:17:32.93,0:17:35.81,Default,Anastasia,0,0,0,,To, co zrobiłeś, nigdy nie\Nzostanie zapomniane.
Dialogue: 0,0:17:39.17,0:17:42.59,Default,Mimi,0,0,0,,Nie chcesz zbliżać się do\Nmojej dziewczyny.
Dialogue: 0,0:17:42.98,0:17:44.62,Default,Mimi,0,0,0,,Wiesz, jestem naprawdę silna.
Dialogue: 0,0:17:44.71,0:17:46.41,Default,Anastasia,0,0,0,,Dzięki, Mimi...
Dialogue: 0,0:17:46.98,0:17:48.64,Default,Anastasia,0,0,0,,Ale nie musisz nic robić.
Dialogue: 0,0:17:48.88,0:17:52.13,Default,Anastasia,0,0,0,,Natsuki i tak nic nie może na to poradzić.
Dialogue: 0,0:17:52.25,0:17:54.79,Default,Subaru,0,0,0,,Oboje jesteście kompletnymi łajdakami!
Dialogue: 0,0:17:54.88,0:17:56.18,Default,Subaru,0,0,0,,Idźcie oboje do diabła!
Dialogue: 0,0:17:56.97,0:17:59.45,Default,Anastasia,0,0,0,,Chyba wysiłki Juliusa poszły na marne...
Dialogue: 0,0:17:59.71,0:18:01.60,Default,Anastasia,0,0,0,,To jednak częściowo moja wina.
Dialogue: 0,0:18:03.20,0:18:06.07,Default,Anastasia,0,0,0,,Chyba nawet ty nie\Nzrobiłbyś czegoś tak głupiego.
Dialogue: 0,0:18:06.31,0:18:07.45,Default,,0,0,0,,Czuję ulgę.
Dialogue: 0,0:18:07.92,0:18:09.14,Default,Anastasia,0,0,0,,Mimi, chodźmy.
Dialogue: 0,0:18:09.23,0:18:10.11,Default,Mimi,0,0,0,,Okej!
Dialogue: 0,0:18:13.48,0:18:14.99,Default,Anastasia,0,0,0,,Jeszcze jedna rzecz.
Dialogue: 0,0:18:16.07,0:18:21.25,Default,Anastasia,0,0,0,,Kluczem do sukcesu w negocjacjach jest\Nprzygotowanie przed rozmową.
Dialogue: 0,0:18:21.57,0:18:24.74,Default,Anastasia,0,0,0,,Dowiedz się, czego chce druga\Nosoba, i zasugeruj jej to.
Dialogue: 0,0:18:25.32,0:18:28.99,Default,Anastasia,0,0,0,,A skoro wszystko, co robisz,\Nto pragniesz, to właśnie tego ci brakuje.
Dialogue: 0,0:18:29.92,0:18:32.62,Default,Anastasia,0,0,0,,No to ruszamy, ludzie?
Dialogue: 0,0:18:41.96,0:18:43.69,Default,Mimi,0,0,0,,Do zobaczenia!
Dialogue: 0,0:18:48.52,0:18:49.45,Default,Mimi,0,0,0,,Pa pa!
Dialogue: 0,0:18:53.39,0:18:54.74,Default,Subaru,0,0,0,,Cholera!
Dialogue: 0,0:18:59.17,0:19:01.11,Default,Rem,0,0,0,,Subaru, co się stało?
Dialogue: 0,0:19:01.41,0:19:02.44,Default,,0,0,0,,Co się stało?
Dialogue: 0,0:19:01.96,0:19:02.94,Default,Subaru,0,0,0,,Nic!
Dialogue: 0,0:19:03.52,0:19:05.13,Default,Subaru,0,0,0,,Rem, jak poszło?
Dialogue: 0,0:19:06.72,0:19:10.75,Default,Rem,0,0,0,,Zgłosiłam działania Kultu Czarownicy\Ndo posterunku rycerzy.
Dialogue: 0,0:19:11.46,0:19:14.18,Default,Rem,0,0,0,,Podałam im imię pana Roswaala, ale...
Dialogue: 0,0:19:14.42,0:19:16.38,Default,Subaru,0,0,0,,To nie jest ta odpowiedź
Dialogue: 0,0:19:17.74,0:19:21.42,Default,Rem,0,0,0,,Wygląda na to, że rycerze otrzymali\Njuż kilka takich doniesień.
Dialogue: 0,0:19:22.23,0:19:24.45,Default,Rem,0,0,0,,Ponieważ pochodzenie Kultu nie jest jasne,
Dialogue: 0,0:19:24.54,0:19:27.35,Default,Rem,0,0,0,,Zalewa ich fala anonimów\Nnie do zweryfikowania.
Dialogue: 0,0:19:27.86,0:19:30.68,Default,Subaru,0,0,0,,Jeśli w ten sposób\Nwyznawcy sekty pozostają w ukryciu,
Dialogue: 0,0:19:30.77,0:19:32.31,Default,,0,0,0,,to nie jest powód do śmiechu.
Dialogue: 0,0:19:32.40,0:19:35.27,Default,Subaru,0,0,0,,Jeśli nie uda nam się zebrać\Nsił zbrojnych...
Dialogue: 0,0:19:36.77,0:19:37.78,Default,Rem,0,0,0,,Co zrobimy?
Dialogue: 0,0:19:42.02,0:19:43.65,Default,Subaru,0,0,0,,Wrócimy do rezydencji...
Dialogue: 0,0:19:44.08,0:19:46.69,Default,Subaru,0,0,0,,Wróć i zabierz stamtąd Emilię i Ram.
Dialogue: 0,0:19:47.39,0:19:50.39,Default,Subaru,0,0,0,,Do stolicy albo do Roswaala…\NGdziekolwiek, nie ma znaczenia.
Dialogue: 0,0:19:50.74,0:19:52.79,Default,Subaru,0,0,0,,Miejsce, w którym są, jest niebezpieczne!
Dialogue: 0,0:19:52.99,0:19:53.95,Default,Subaru,0,0,0,,Nie ma czasu.
Dialogue: 0,0:19:54.04,0:19:55.30,Default,,0,0,0,,Powinniśmy już iść.
Dialogue: 0,0:19:58.78,0:20:01.62,Default - italics,Subaru,0,0,0,,W tym tempie powinniśmy dotrzeć\Nna miejsce przed świtem.
Dialogue: 0,0:20:01.71,0:20:06.05,Default - italics,Subaru,0,0,0,,Wtedy będziemy mieli mnóstwo czasu,\Nżeby zabrać Emilię i uciec.
Dialogue: 0,0:20:06.43,0:20:08.53,Default - italics,Subaru,0,0,0,,Pytanie brzmi: jak ją przetransportować...
Dialogue: 0,0:20:13.66,0:20:14.73,Default,Subaru,0,0,0,,To...
Dialogue: 0,0:20:16.38,0:20:18.19,Default,Otto,0,0,0,,Stąd do posiadłości Mathersów?
Dialogue: 0,0:20:18.28,0:20:19.18,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:20:19.40,0:20:21.73,Default,Otto,0,0,0,,Jest już późno. Czy to nie jest\Nniebezpieczne?
Dialogue: 0,0:20:21.82,0:20:24.45,Default,Otto,0,0,0,,Planowaliśmy rozbić tu dziś\Nwieczorem namiot.
Dialogue: 0,0:20:24.54,0:20:26.15,Default,Otto,0,0,0,,Czy zechciałbyś do nas dołączyć?
Dialogue: 0,0:20:26.24,0:20:28.24,Default,Guy,0,0,0,,Tak mówisz, Otto...
Dialogue: 0,0:20:28.40,0:20:30.84,Default,Guy,0,0,0,,Ale założę się, że\Nchcesz się czegoś pozbyć
Dialogue: 0,0:20:30.96,0:20:33.81,Default,,0,0,0,,chodzi o ten olej, który kupiłeś\Npoza sezonem, prawda?
Dialogue: 0,0:20:34.88,0:20:37.12,Default,Guy,0,0,0,,Wcale nie o to mi chodzi!
Dialogue: 0,0:20:37.35,0:20:43.20,Default,Otto,0,0,0,,Choć nie ukrywam, liczyłem,\Nże przyda się olej.
Dialogue: 0,0:20:43.29,0:20:44.98,Default,Rem,0,0,0,,O co chodzi z tą ropą?
Dialogue: 0,0:20:45.29,0:20:48.15,Default,Otto,0,0,0,,Och, popełniłem małą pomyłkę.
Dialogue: 0,0:20:48.30,0:20:53.66,Default,Otto,0,0,0,,A teraz mam mnóstwo ropy, która w tej\Nchwili nie jest zbyt wiele warta.
Dialogue: 0,0:20:54.70,0:20:59.22,Default,Otto,0,0,0,,Nawet gdybyśmy pojechali do stolicy,\Nnie wiem, czy uda mi się to sprzedać...
Dialogue: 0,0:20:59.31,0:21:02.00,Default,Otto,0,0,0,,A jeśli mi się nie uda,\Nto jestem skończony!
Dialogue: 0,0:21:02.41,0:21:03.78,Default,Otto,0,0,0,,Zrujnowany...
Dialogue: 0,0:21:05.24,0:21:07.01,Default,Subaru,0,0,0,,Otto, muszę z tobą pogadać—
Dialogue: 0,0:21:07.14,0:21:09.15,Default,,0,0,0,,No po prostu poproś o pomoc.
Dialogue: 0,0:21:09.91,0:21:13.36,Default,Subaru,0,0,0,,Kupię cały olej z twojego powozu.
Dialogue: 0,0:21:13.86,0:21:16.15,Default,Subaru,0,0,0,,W zamian za to użyczcie nam\Nśrodka transportu.
Dialogue: 0,0:21:16.24,0:21:17.99,Default,Subaru,0,0,0,,Wszyscy kupcy i powozy tutaj...
Dialogue: 0,0:21:18.39,0:21:21.72,Default,Subaru,0,0,0,,Kto ma środek transportu na sprzedaż,\Nniech mi go sprzeda!
Dialogue: 0,0:21:22.10,0:21:23.13,Default,Subaru,0,0,0,,Przewozimy ludzi!
Dialogue: 0,0:21:23.22,0:21:26.05,Default,Otto,0,0,0,,Ludzie?! Nie chcemy mieć nic wspólnego\Nz handlem ludźmi!
Dialogue: 0,0:21:26.21,0:21:28.73,Default,Subaru,0,0,0,,Nie prowadzę tego rodzaju\Ndziałalności pobocznej...
Dialogue: 0,0:21:29.10,0:21:31.65,Default,Subaru,0,0,0,,W pobliżu rezydencji Mathersów\Nznajduje się wioska.
Dialogue: 0,0:21:31.74,0:21:34.54,Default,Subaru,0,0,0,,Chcę, żebyście zabrali stamtąd\Nmieszkańców gdzie indziej!
Dialogue: 0,0:21:39.72,0:21:42.13,Default,Rem,0,0,0,,Oczywiście odpowiednio się\NPaństwu odwdzięczymy.
Dialogue: 0,0:21:45.62,0:21:47.81,Default,Otto,0,0,0,,Jeśli będziemy biec przez całą noc,
Dialogue: 0,0:21:47.91,0:21:50.96,Default,Otto,0,0,0,,do rana powinniśmy dotrzeć\Ndo posiadłości Mathersów.
Dialogue: 0,0:21:51.45,0:21:52.95,Default,Subaru,0,0,0,,Nie możemy robić przerw.
Dialogue: 0,0:21:53.04,0:21:54.03,Default,Otto,0,0,0,,Nie ma sprawy!
Dialogue: 0,0:21:54.12,0:21:57.39,Default,,0,0,0,,Pozbywam się zapasów i jeszcze\Nzarabiam na transporcie...
Dialogue: 0,0:21:57.48,0:21:58.79,Default,Otto,0,0,0,,Czuję się niepokonany!
Dialogue: 0,0:21:58.90,0:22:00.39,Default,Rem,0,0,0,,Subaru, przepraszam.
Dialogue: 0,0:22:00.56,0:22:03.59,Default,Rem,0,0,0,,Chciałabym sprawdzić na mapie,\Nile jeszcze pozostało drogi
Dialogue: 0,0:22:03.97,0:22:04.96,Default,Subaru,0,0,0,,Mapa?
Dialogue: 0,0:22:05.07,0:22:07.70,Default,Rem,0,0,0,,Jest w twojej torbie.
Dialogue: 0,0:22:08.88,0:22:10.24,Default,Subaru,0,0,0,,A to?
Dialogue: 0,0:22:10.75,0:22:13.74,Default,Subaru,0,0,0,,Jest jednak zbyt ciemno, żeby\Ncokolwiek dostrzec...
Dialogue: 0,0:22:13.83,0:22:14.84,Default,Subaru,0,0,0,,Ach, wiem.
Dialogue: 0,0:22:20.49,0:22:22.21,Default,Rem,0,0,0,,Subaru, co to jest?
Dialogue: 0,0:22:22.36,0:22:24.35,Default,Subaru,0,0,0,,Trochę zapomnianej technologii.
Dialogue: 0,0:22:24.44,0:22:27.26,Default,Subaru,0,0,0,,To po prostu technologia\Nprzyszłości – telefon komórkowy.
Dialogue: 0,0:22:27.35,0:22:30.33,Default,Subaru,0,0,0,,Chyba dobrze, że bateria jeszcze\Ntrochę działa, choć ledwo.
Dialogue: 0,0:22:30.79,0:22:32.05,Default,Subaru,0,0,0,,Zobacz.
Dialogue: 0,0:22:32.34,0:22:34.53,Default,Otto,0,0,0,,Natsuki, co to jest?
Dialogue: 0,0:22:35.28,0:22:37.33,Default,Guy,0,0,0,,Nie widziałem takiego kryształu.
Dialogue: 0,0:22:37.49,0:22:40.55,Default,Subaru,0,0,0,,To tajne narzędzie,\Nktóre dał mi margrabia.
Dialogue: 0,0:22:40.64,0:22:43.29,Default,Subaru,0,0,0,,Przepraszam, ale\Nlepiej zapomnij, że to widziałeś...
Dialogue: 0,0:22:43.38,0:22:47.04,Default,Otto,0,0,0,,Czysty biznes –\Nzero sentymentów, tylko kasa.
Dialogue: 0,0:22:47.30,0:22:48.83,Default,Rem,0,0,0,,Jeszcze tylko kawałek,
Dialogue: 0,0:22:48.92,0:22:51.35,Default,,0,0,0,,i powinniśmy zobaczyć Drzewo Flügela.
Dialogue: 0,0:22:51.46,0:22:54.82,Default,Rem,0,0,0,,Stamtąd posiadłość Mathersów na\Npółnocny wschód jest już blisko.
Dialogue: 0,0:22:55.06,0:22:56.56,Default,Subaru,0,0,0,,Drzewo Flügela?
Dialogue: 0,0:22:56.65,0:23:00.89,Default,Otto,0,0,0,,Wielkie drzewo przy autostradzie Lifaus\Nwznosi się wysoko, że aż przebija chmury.
Dialogue: 0,0:23:01.36,0:23:06.53,Default,Guy,0,0,0,,Legenda głosi, że wieki temu zasadził\Nje mądry człowiek o imieniu Flügel.
Dialogue: 0,0:23:07.86,0:23:09.30,Default,Subaru,0,0,0,,Rozumiem...
Dialogue: 0,0:23:09.70,0:23:11.96,Default,Subaru,0,0,0,,Nie mogę tego nazwać inaczej\Nniż niesamowitym.
Dialogue: 0,0:23:16.02,0:23:17.97,Default,Subaru,0,0,0,,Gdzie się podział ten facet w bandanie?
Dialogue: 0,0:23:19.96,0:23:23.01,Default,Subaru,0,0,0,,Czyżby drzewo go rozproszyło\Ni zboczył z kursu?
Dialogue: 0,0:23:23.70,0:23:25.19,Default,Otto,0,0,0,,Co się stało, Natsuki?
Dialogue: 0,0:23:25.36,0:23:27.49,Default,Subaru,0,0,0,,Gdzie się podział ten twój kumpel?
Dialogue: 0,0:23:27.81,0:23:29.44,Default,Subaru,0,0,0,,Ten starszy facet w bandanie,
Dialogue: 0,0:23:29.53,0:23:31.39,Default,,0,0,0,,czy ktoś jedzie po tej stronie?
Dialogue: 0,0:23:34.34,0:23:35.85,Default,Otto,0,0,0,,O czym ty mówisz?
Dialogue: 0,0:23:36.12,0:23:39.36,Default,Otto,0,0,0,,Po przeciwnej stronie nikt nie jechał.
Dialogue: 0,0:23:39.60,0:23:40.69,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:24:17.97,0:24:20.89,Episode Title,Title,0,0,0,,Chciwość świni
Comment: 0,0:24:20.98,0:24:22.98,Episode Title,,0,0,0,,
Dialogue: 0,0:24:25.94,0:24:26.94,Default,Rem,0,0,0,,Subaru!
Dialogue: 0,0:24:45.79,0:24:49.22,Default,Subaru,0,0,0,,Co… co się stało? Co tu się,\Ndo diabła, dzieje?!
Dialogue: 0,0:24:49.45,0:24:51.02,Default,Rem,0,0,0,,Subaru, nie wstawaj.
Dialogue: 0,0:24:51.11,0:24:52.66,Default,,0,0,0,,Nie ma naszej osłony od wiatru!
Dialogue: 0,0:24:52.82,0:24:54.32,Default,Otto,0,0,0,,Nie wiedziałeś?
Dialogue: 0,0:24:54.42,0:24:58.79,Default,Otto,0,0,0,,Tylko istota o tak ogromnych rozmiarach\Nmoże przelecieć przez mgłę!
Dialogue: 0,0:24:59.89,0:25:01.02,Default,Otto,0,0,0,,Biały wieloryb!
Dialogue: 0,0:25:10.23,0:25:12.44,Default,Subaru,0,0,0,,Rem, widzisz Białego Wieloryba?
Dialogue: 0,0:25:12.53,0:25:14.21,Default,Rem,0,0,0,,Nie dam rady! Jest za ciemno!
Dialogue: 0,0:25:14.40,0:25:16.24,Default,Subaru,0,0,0,,Co stało się z pozostałymi wagonami?
Dialogue: 0,0:25:16.56,0:25:18.21,Default,Rem,0,0,0,,Wygląda na to, że się rozeszli.
Dialogue: 0,0:25:18.33,0:25:20.54,Default,Rem,0,0,0,,Ale nie wiem, dokąd uciekli!
Dialogue: 0,0:25:20.63,0:25:21.53,Default,Subaru,0,0,0,,Cholera!
Dialogue: 0,0:25:21.62,0:25:23.97,Default,Subaru,0,0,0,,Kiedy w końcu złapaliśmy\Njakiś transport...
Dialogue: 0,0:25:31.10,0:25:32.21,Default,,0,0,0,,...
Dialogue: 0,0:25:41.24,0:25:42.72,Default,Rem,0,0,0,,Obejdź to z lewej strony!
Dialogue: 0,0:25:43.72,0:25:47.02,Default,Otto,0,0,0,,W lewo, w lewo, w lewo, w lewo,\Nw lewo, w lewo, w lewo!
Dialogue: 0,0:25:54.93,0:25:57.34,Default,Rem,0,0,0,,Zjedz to!
Dialogue: 0,0:26:03.14,0:26:05.10,Default,Otto,0,0,0,,Dostałeś to?
Dialogue: 0,0:26:09.85,0:26:10.76,Default,Subaru,0,0,0,,Nie zadziałało.
Dialogue: 0,0:26:10.85,0:26:13.24,Default,Otto,0,0,0,,Dlaczego to nas atakuje?
Dialogue: 0,0:26:13.33,0:26:15.61,Default,Otto,0,0,0,,Są tam jeszcze inne powozy!
Dialogue: 0,0:26:15.93,0:26:18.80,Default,Subaru,0,0,0,,Narzekanie niczego nie zmieni!
Dialogue: 0,0:26:19.81,0:26:22.47,Default,Subaru,0,0,0,,Myśl... Myśl, myśl!
Dialogue: 0,0:26:22.56,0:26:23.68,Default,Subaru,0,0,0,,Gdzie wyjście?
Dialogue: 0,0:26:23.77,0:26:26.68,Default,,0,0,0,,Czy nie ma czegoś?\NCokolwiek, cokolwiek, cokolwiek?!
Dialogue: 0,0:26:27.80,0:26:28.97,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:26:30.05,0:26:31.89,Default,Rem,0,0,0,,Proszę to przyjąć.
Dialogue: 0,0:26:31.98,0:26:33.51,Default,Subaru,0,0,0,,Wymyśliłeś już coś?
Dialogue: 0,0:26:34.29,0:26:36.50,Default,Rem,0,0,0,,Wysiądę z powozu i go zatrzymam.
Dialogue: 0,0:26:36.78,0:26:39.29,Default,Rem,0,0,0,,W międzyczasie udaje ci się uciec z mgły.
Dialogue: 0,0:26:40.41,0:26:43.31,Default,Rem,0,0,0,,Otto, proszę, zaopiekuj się Subaru.
Dialogue: 0,0:26:43.60,0:26:45.62,Default,Rem,0,0,0,,Ma pieniądze, które wam obiecaliśmy.
Dialogue: 0,0:26:45.71,0:26:47.36,Default,Otto,0,0,0,,Płatność?
Dialogue: 0,0:26:47.45,0:26:48.78,Default,,0,0,0,,To nie problem!
Dialogue: 0,0:26:48.87,0:26:51.16,Default,Otto,0,0,0,,Najpierw musimy przeżyć!
Dialogue: 0,0:26:51.25,0:26:53.80,Default,Rem,0,0,0,,Subaru, nie jestem zbyt mądry,
Dialogue: 0,0:26:53.89,0:26:56.00,Default,,0,0,0,,Więc to jedyny plan, jaki mam.
Dialogue: 0,0:26:56.09,0:26:56.97,Default,Rem,0,0,0,,Proszę...
Dialogue: 0,0:26:57.06,0:26:58.78,Default,Subaru,0,0,0,,Czekaj chwilę, Rem!
Dialogue: 0,0:26:58.87,0:27:00.94,Default,Subaru,0,0,0,,Nie pozwolę!\NNie pozwolę ci odejść!
Dialogue: 0,0:27:01.03,0:27:04.08,Default,Subaru,0,0,0,,Jeśli… Jeśli ty też umrzesz, to ja…
Dialogue: 0,0:27:12.26,0:27:16.69,Default,Rem,0,0,0,,Wierzę, że urodziłam się właśnie\Npo to, by przeżyć tę chwilę.
Dialogue: 0,0:27:19.11,0:27:20.07,Default,Subaru,0,0,0,,O czym ty mówisz—
Dialogue: 0,0:27:23.09,0:27:24.44,Default,Subaru,0,0,0,,Co ty...
Dialogue: 0,0:27:26.23,0:27:27.57,Default,Rem,0,0,0,,Wszystko będzie dobrze.
Dialogue: 0,0:27:27.66,0:27:31.60,Default,,0,0,0,,Zawsze będę czuwał nad tobą z ukrycia.
Dialogue: 0,0:27:57.59,0:27:58.73,Default,Subaru,0,0,0,,Gdzie jest Rem?
Dialogue: 0,0:27:58.82,0:28:00.69,Default,Otto,0,0,0,,Natsuki, obudziłaś się?
Dialogue: 0,0:28:01.10,0:28:02.51,Default,Otto,0,0,0,,Proszę się nie ruszać.
Dialogue: 0,0:28:02.60,0:28:04.62,Default,,0,0,0,,Smok lądowy wciąż pędzi szybko!
Dialogue: 0,0:28:04.71,0:28:07.08,Default,Otto,0,0,0,,Nie mam czasu, żeby się o ciebie martwić!
Dialogue: 0,0:28:07.17,0:28:09.12,Default,Subaru,0,0,0,,Nie obchodzi mnie to!
Dialogue: 0,0:28:09.22,0:28:11.12,Default,Subaru,0,0,0,,Gdzie jest Rem? Co się stało z Rem?
Dialogue: 0,0:28:11.80,0:28:14.34,Default,Subaru,0,0,0,,Odpowiedz mi, Otto! Co się stało z Remem?!
Dialogue: 0,0:28:17.62,0:28:19.64,Default,Otto,0,0,0,,żebyśmy mogli uciec,
Dialogue: 0,0:28:20.25,0:28:24.08,Default,Otto,0,0,0,,wyskoczyła z powozu, by\Nzatrzymać Białego Wieloryba.
Dialogue: 0,0:28:29.39,0:28:30.33,Default,Subaru,0,0,0,,Wróć.
Dialogue: 0,0:28:30.43,0:28:31.38,Default,Otto,0,0,0,,Co?!
Dialogue: 0,0:28:31.89,0:28:34.64,Default,Subaru,0,0,0,,Powiedziałem, żebyś wracał! Musimy...
Dialogue: 0,0:28:34.73,0:28:36.20,Default,Subaru,0,0,0,,Musimy uratować Rem!
Dialogue: 0,0:28:36.29,0:28:38.12,Default,Subaru,0,0,0,,Wracaj natychmiast!
Dialogue: 0,0:28:39.39,0:28:41.46,Default,Otto,0,0,0,,A… a co to da?
Dialogue: 0,0:28:41.55,0:28:45.41,Default,Otto,0,0,0,,Czy nie widziałeś, jak przerażający\Njest ten potwór, Biały Wieloryb?
Dialogue: 0,0:28:45.50,0:28:46.72,Default,Otto,0,0,0,,To byłoby samobójstwo!
Dialogue: 0,0:28:46.81,0:28:48.97,Default,Subaru,0,0,0,,Widziałem potwora z bliska!
Dialogue: 0,0:28:49.06,0:28:50.74,Default,,0,0,0,,Dlatego mówię, żebyś wracał!
Dialogue: 0,0:28:51.84,0:28:54.18,Default,Otto,0,0,0,,Czy oszalałeś?!
Dialogue: 0,0:28:54.45,0:28:58.63,Default,Otto,0,0,0,,Chcesz zaprzepaścić nadzieję,\Nktórą nam pozostawiła?
Dialogue: 0,0:28:58.72,0:29:00.78,Default,Subaru,0,0,0,,Nie waż się mówić o Rem!
Dialogue: 0,0:29:00.87,0:29:02.28,Default,Subaru,0,0,0,,Porzuciłeś ją...
Dialogue: 0,0:29:02.37,0:29:04.19,Default,,0,0,0,,Nie masz prawa o niej mówić!
Dialogue: 0,0:29:04.28,0:29:05.18,Default,Subaru,0,0,0,,Wróć!
Dialogue: 0,0:29:05.34,0:29:08.32,Default,Otto,0,0,0,,Nadal nie rozumiesz, jak\Nprzerażający jest Biały Wieloryb?!
Dialogue: 0,0:29:08.41,0:29:12.15,Default,Otto,0,0,0,,Kiedy siły karne, zebrane przez Lugunicę,\Nwyruszyły, by go podporządkować,
Dialogue: 0,0:29:12.24,0:29:15.38,Default,Otto,0,0,0,,Ten potwór zabił pierwszego\Nmistrza szermierki!
Dialogue: 0,0:29:15.47,0:29:16.84,Default,Otto,0,0,0,,Nie ma szans, na wygraną!
Dialogue: 0,0:29:17.78,0:29:20.24,Default,Subaru,0,0,0,,To zabiło… mistrza szermierki?
Dialogue: 0,0:29:21.89,0:29:24.46,Default,Otto,0,0,0,,Jestem słaby, a ty też.
Dialogue: 0,0:29:24.55,0:29:28.12,Default,Otto,0,0,0,,Nie ma więc żadnej szansy,\Nżebyśmy uratowali tę dziewczynę.
Dialogue: 0,0:29:30.07,0:29:33.73,Default,Subaru,0,0,0,,Ale wiem, że Rem też nie\Njest tak naprawdę silna.
Dialogue: 0,0:29:35.81,0:29:38.32,Default,Otto,0,0,0,,Na razie udało nam się tego uniknąć.
Dialogue: 0,0:29:38.45,0:29:41.72,Default,Otto,0,0,0,,Ale w tej mgle nie wiadomo,\Nkiedy znów się pojawi.
Dialogue: 0,0:29:42.98,0:29:45.67,Default,Subaru,0,0,0,,Otto, uważaj na to, co mówisz!
Dialogue: 0,0:29:45.76,0:29:47.37,Default,Otto,0,0,0,,Co? O co chodzi, Natsuki?
Dialogue: 0,0:29:47.46,0:29:49.61,Default,Subaru,0,0,0,,Nie mów tak, jakby to była jakaś zabawa!
Dialogue: 0,0:29:49.70,0:29:51.14,Default,Subaru,0,0,0,,Mieliśmy „szczęście”?!
Dialogue: 0,0:29:51.45,0:29:52.92,Default,Subaru,0,0,0,,Chyba żartujesz...
Dialogue: 0,0:29:53.01,0:29:55.52,Default,Subaru,0,0,0,,Czy wiesz, jak czuła się Rem, kiedy ona…
Dialogue: 0,0:29:55.83,0:29:57.83,Default,Otto,0,0,0,,Kim jest Rem?
Dialogue: 0,0:29:57.92,0:29:58.80,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:29:59.90,0:30:02.58,Default,Otto,0,0,0,,Nie było nikogo o tym imieniu
Dialogue: 0,0:30:02.67,0:30:05.22,Default,,0,0,0,,wśród kupców, którzy od nas odeszli.
Dialogue: 0,0:30:05.35,0:30:07.38,Default,Otto,0,0,0,,O kim mówisz?
Dialogue: 0,0:30:14.13,0:30:16.12,Default,Otto,0,0,0,,Co ty wyprawiasz?!
Dialogue: 0,0:30:16.29,0:30:17.82,Default,Subaru,0,0,0,,Daj spokój z tymi bzdurami...
Dialogue: 0,0:30:17.91,0:30:20.06,Default,,0,0,0,,Mówisz o tym, jak Rem pozwoliła nam uciec,
Dialogue: 0,0:30:20.15,0:30:21.97,Default,Subaru,0,0,0,,a potem zapytać, kim ona jest?
Dialogue: 0,0:30:22.06,0:30:23.33,Default,Subaru,0,0,0,,Czy chcesz się zabić?!
Dialogue: 0,0:30:23.53,0:30:26.57,Default,Otto,0,0,0,,Mówię ci, nie mam pojęcia,\No czym mówisz...
Dialogue: 0,0:30:26.77,0:30:29.08,Default,Otto,0,0,0,,Dlaczego nagle tak mówisz?
Dialogue: 0,0:30:29.17,0:30:31.90,Default,Otto,0,0,0,,Czy widok Białego Wieloryba\Nrozwcieczył Cię?
Dialogue: 0,0:30:40.54,0:30:43.65,Default,Otto,0,0,0,,Dlaczego? Dlaczego? Dlaczego\Nto jest takie uporczywe?
Dialogue: 0,0:30:43.74,0:30:45.81,Default,Otto,0,0,0,,Myślałem, że już to mamy za sobą!
Dialogue: 0,0:30:49.54,0:30:51.41,Default,Otto,0,0,0,,Dlaczego atakuje właśnie nas?
Dialogue: 0,0:30:52.02,0:30:55.21,Default,Otto,0,0,0,,Nawet w tej ciemności... Dlaczego?
Dialogue: 0,0:30:55.30,0:30:56.25,Default,Otto,0,0,0,,Rem...
Dialogue: 0,0:30:55.83,0:30:59.44,Default,Otto,0,0,0,,Czy... Czy to podąża za jakimś śladem?!
Dialogue: 0,0:31:00.63,0:31:01.74,Default,Subaru,0,0,0,,To niemożliwe.
Dialogue: 0,0:31:02.28,0:31:05.70,Default,Subaru,0,0,0,,Ten potwór, Biały Wieloryb...
Dialogue: 0,0:31:07.73,0:31:09.62,Default,Subaru,0,0,0,,To też jest mabeast?
Dialogue: 0,0:31:10.74,0:31:14.09,Default,Subaru,0,0,0,,W takim razie to coś mnie przyciąga?
Dialogue: 0,0:31:14.99,0:31:16.31,Default,Subaru,0,0,0,,Nie ma mowy.
Dialogue: 0,0:31:17.45,0:31:21.14,Default,Subaru,0,0,0,,Rem, ja… Nie…
Dialogue: 0,0:31:21.61,0:31:23.39,Default,Subaru,0,0,0,,To moja wina!
Dialogue: 0,0:31:25.02,0:31:27.30,Default,Otto,0,0,0,,Natsuki, proszę, umrzyj.
Dialogue: 0,0:31:28.00,0:31:28.88,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:31:32.45,0:31:34.29,Default,Otto,0,0,0,,To wszystko twoja wina!
Dialogue: 0,0:31:34.38,0:31:36.50,Default,Otto,0,0,0,,To… to nas śledzi przez ciebie!
Dialogue: 0,0:31:36.59,0:31:39.28,Default,Otto,0,0,0,,Weź na siebie odpowiedzialność!
Dialogue: 0,0:31:39.38,0:31:42.46,Default,Otto,0,0,0,,Giń! Giń, abym mógł żyć!
Dialogue: 0,0:32:09.72,0:32:11.60,Default,Subaru,0,0,0,,Nie chcę umierać...
Dialogue: 0,0:32:13.08,0:32:16.02,Default,Subaru,0,0,0,,Nie... Nie chcę umierać...
Dialogue: 0,0:32:16.88,0:32:19.68,Default,Subaru,0,0,0,,Pomocy... Nie chcę umierać!
Dialogue: 0,0:32:20.37,0:32:22.49,Default,Subaru,0,0,0,,Nie chcę umierać! Nie chcę umierać!
Dialogue: 0,0:32:22.58,0:32:23.88,Default,,0,0,0,,Nie chcę umierać!
Dialogue: 0,0:32:23.97,0:32:25.65,Default,Subaru,0,0,0,,Nie! Nie!
Dialogue: 0,0:32:25.74,0:32:27.00,Default,Subaru,0,0,0,,Pomóż mi!
Dialogue: 0,0:32:27.12,0:32:29.57,Default,Subaru,0,0,0,,Nie! Nie chcę umierać!
Dialogue: 0,0:32:33.36,0:32:35.33,Default,Subaru,0,0,0,,Nie chcę umierać...
Dialogue: 0,0:32:50.39,0:32:51.28,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:32:58.04,0:32:59.12,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:33:00.19,0:33:02.83,Default,Subaru,0,0,0,,Rem, wybacz mi.
Dialogue: 0,0:33:09.60,0:33:10.82,Default,Subaru,0,0,0,,Jesteś...
Dialogue: 0,0:33:14.02,0:33:16.72,Default,Subaru,0,0,0,,Gdzie on jest? Gdzie jest Otto?
Dialogue: 0,0:33:19.33,0:33:20.56,Default,Subaru,0,0,0,,Rozumiem...
Dialogue: 0,0:33:28.13,0:33:29.06,Default,Subaru,0,0,0,,Chodźmy.
Dialogue: 0,0:33:49.25,0:33:50.55,Default,Subaru,0,0,0,,Las?
Dialogue: 0,0:33:54.37,0:33:56.21,Default,Petra,0,0,0,,Co? Subaru?
Dialogue: 0,0:34:00.45,0:34:01.85,Default,Mildo,0,0,0,,To Subaru!
Dialogue: 0,0:34:02.72,0:34:04.34,Default,Dyne,0,0,0,,Co się z tobą stało, Subaru?
Dialogue: 0,0:34:06.46,0:34:08.72,Default,Lucas,0,0,0,,Jesteś w fatalnym stanie,\NSubaru. Cuchniesz!
Dialogue: 0,0:34:11.71,0:34:13.10,Default,Subaru,0,0,0,,Słuchajcie...
Dialogue: 0,0:34:14.87,0:34:18.11,Default,Subaru,0,0,0,,Tym razem nie spóźniłem się zbytnio?
Dialogue: 0,0:34:20.95,0:34:22.13,Default,Petra,0,0,0,,Subaru?
Dialogue: 0,0:34:42.14,0:34:43.06,Default,Subaru,0,0,0,,Rem—
Dialogue: 0,0:34:46.18,0:34:48.18,Default,Ram,0,0,0,,Dlaczego tak dotykasz mnie, Barusu?
Dialogue: 0,0:34:48.56,0:34:51.42,Default,Ram,0,0,0,,Rozumiem, że po dniach rozłąki\Ncieszysz się na mój widok.
Dialogue: 0,0:34:51.51,0:34:54.06,Default,Ram,0,0,0,,Ale nie rzucaj się na mnie od\Nrazu w ten sposób.
Dialogue: 0,0:34:54.15,0:34:55.09,Default,Ram,0,0,0,,To nieprzyzwoite.
Dialogue: 0,0:34:56.31,0:34:58.61,Default,Subaru,0,0,0,,Ach... Tak, racja...
Dialogue: 0,0:34:59.23,0:35:02.07,Default,Ram,0,0,0,,No to, Barusu, opowiedz mi, co się stało.
Dialogue: 0,0:35:03.18,0:35:04.79,Default,Ram,0,0,0,,Byłeś w fatalnej formie.
Dialogue: 0,0:35:04.98,0:35:08.83,Default,Ram,0,0,0,,Twoje zwichnięte ramię, rozcięte czoło\Ni złamane żebra zostały wyleczone.
Dialogue: 0,0:35:09.04,0:35:10.73,Default,Ram,0,0,0,,Jak drgniesz, to się otworzą.
Dialogue: 0,0:35:11.12,0:35:13.41,Default,Ram,0,0,0,,Wyrzuciłam twoje zabłocone\Nz krwią ubrania.
Dialogue: 0,0:35:13.63,0:35:15.57,Default,Subaru,0,0,0,,Och, dzięki.
Dialogue: 0,0:35:17.02,0:35:19.23,Default,Subaru,0,0,0,,Ten, który uleczył moje rany...
Dialogue: 0,0:35:19.75,0:35:20.67,Default,Ram,0,0,0,,To była Emilia.
Dialogue: 0,0:35:24.89,0:35:29.58,Default,Ram,0,0,0,,Nie powiedziała mi, co się\Nmiędzy wami działo w stolicy.
Dialogue: 0,0:35:29.67,0:35:31.06,Default,Ram,0,0,0,,Nie jestem zainteresowany.
Dialogue: 0,0:35:31.40,0:35:32.82,Default,Ram,0,0,0,,Sądząc po jej reakcji,
Dialogue: 0,0:35:32.91,0:35:35.33,Default,,0,0,0,,Zrobiłeś coś, czego nie powinieneś.
Dialogue: 0,0:35:35.42,0:35:36.80,Default,Subaru,0,0,0,,To trochę ostre.
Dialogue: 0,0:35:36.89,0:35:39.01,Default,Ram,0,0,0,,Myślę, że to trafna ocena.
Dialogue: 0,0:35:39.10,0:35:41.45,Default,Ram,0,0,0,,Idealne dla nieudacznika,\Nktóry boi się podejść.
Dialogue: 0,0:35:41.54,0:35:45.14,Default,Ram,0,0,0,,do sedna sprawy, który zrobiłby wszystko,\Nby choć trochę to odwlec.
Dialogue: 0,0:35:53.65,0:35:55.12,Default,Subaru,0,0,0,,Rem nie żyje.
Dialogue: 0,0:35:57.88,0:36:00.21,Default,Subaru,0,0,0,,Ja… nie mogłem nic zrobić.
Dialogue: 0,0:36:01.14,0:36:04.29,Default,Subaru,0,0,0,,Mgła… Biały Wieloryb…\Npojawił się na drodze.
Dialogue: 0,0:36:04.85,0:36:08.19,Default,Subaru,0,0,0,,Więc, żeby zatuszować moją\Nucieczkę, Rem...
Dialogue: 0,0:36:08.52,0:36:11.88,Default,Subaru,0,0,0,,Ale… zostałem sam w mgle.
Dialogue: 0,0:36:12.79,0:36:13.70,Default,,0,0,0,,I...
Dialogue: 0,0:36:13.79,0:36:14.73,Default,Ram,0,0,0,,Barusu...
Dialogue: 0,0:36:16.63,0:36:17.51,Default,Ram,0,0,0,,Rem...
Dialogue: 0,0:36:19.09,0:36:20.28,Default,Ram,0,0,0,,Kto to jest?
Dialogue: 0,0:36:22.42,0:36:23.30,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:36:23.84,0:36:26.49,Default,Ram,0,0,0,,Kim jest Rem, Barusu?
Dialogue: 0,0:36:26.58,0:36:28.35,Default,Subaru,0,0,0,,Co… co masz na myśli, mówiąc „kto”?
Dialogue: 0,0:36:28.44,0:36:29.79,Default,,0,0,0,,Nie wygłupiaj się...
Dialogue: 0,0:36:29.88,0:36:32.17,Default,Subaru,0,0,0,,To twoja młodsza siostra!
Dialogue: 0,0:36:32.26,0:36:34.34,Default,Subaru,0,0,0,,Wiesz, Rem! Rem... Rem!
Dialogue: 0,0:36:34.43,0:36:35.55,Default,Subaru,0,0,0,,Nie ma teraz czasu na…
Dialogue: 0,0:36:35.64,0:36:37.09,Default,Ram,0,0,0,,Nie mam młodszej siostry.
Dialogue: 0,0:36:37.22,0:36:39.87,Default,Subaru,0,0,0,,Nie mów tak! Gdyby nie Rem...
Dialogue: 0,0:36:39.96,0:36:41.24,Default,Subaru,0,0,0,,Zgadza się!
Dialogue: 0,0:36:41.33,0:36:44.09,Default,,0,0,0,,Jak byś nazwał ten cały bałagan\Nw lesie Mabeast?!
Dialogue: 0,0:36:44.18,0:36:46.56,Default,Subaru,0,0,0,,Ty, Rem i ja walczyliśmy z\Ntymi mabeastami i…
Dialogue: 0,0:36:46.65,0:36:48.90,Default,Ram,0,0,0,,Coś jest z tobą naprawdę nie tak, Barusu.
Dialogue: 0,0:36:49.30,0:36:50.69,Default,Ram,0,0,0,,Niechętnie to przyznaję,
Dialogue: 0,0:36:50.78,0:36:54.16,Default,,0,0,0,,ale to ty ponosisz połowę\Nodpowiedzialności za zabicie ulgarów.
Dialogue: 0,0:36:54.53,0:36:57.65,Default,Ram,0,0,0,,Resztą zajęliśmy się razem\Nz panem Roswaalem.
Dialogue: 0,0:36:58.36,0:37:02.78,Default,Ram,0,0,0,,Ta dawno zaginiona siostra, którą\Nnazywasz „Rem”, nie ma w tu miejsca.
Dialogue: 0,0:37:04.06,0:37:06.27,Default,Subaru,0,0,0,,To nie jest śmieszne.
Dialogue: 0,0:37:06.36,0:37:08.82,Default,Subaru,0,0,0,,Nawet jak na koszmar to nie ma sensu!
Dialogue: 0,0:37:08.91,0:37:11.17,Default,Ram,0,0,0,,Zawsze jestem poważny.
Dialogue: 0,0:37:11.26,0:37:13.30,Default,Ram,0,0,0,,To chyba ty śnisz.
Dialogue: 0,0:37:13.55,0:37:16.16,Default,Subaru,0,0,0,,Śnię... Śnię?
Dialogue: 0,0:37:16.89,0:37:18.39,Default,Subaru,0,0,0,,Śnisz?!
Dialogue: 0,0:37:18.65,0:37:20.05,Default,Subaru,0,0,0,,To bzdura!
Dialogue: 0,0:37:20.30,0:37:21.73,Default,Ram,0,0,0,,Barusu, nie powinieneś stać…
Dialogue: 0,0:37:21.86,0:37:25.21,Default,Subaru,0,0,0,,Zamknij się! Po prostu… Po prostu\Nsię nie odzywaj i patrz!
Dialogue: 0,0:37:33.16,0:37:35.07,Default,Subaru,0,0,0,,To niemożliwe...
Dialogue: 0,0:37:36.02,0:37:38.02,Default,Ram,0,0,0,,Barusu, jesteś zadowolony?
Dialogue: 0,0:37:39.19,0:37:41.22,Default,Subaru,0,0,0,,Rem nie jest...
Dialogue: 0,0:37:41.67,0:37:44.67,Default,Ram,0,0,0,,W tym pokoju nigdy nie mieszkała\Nżadna taka osoba.
Dialogue: 0,0:37:50.36,0:37:52.70,Default - flashback,Ram,0,0,0,,Wracaj do swojego pokoju i idź spać.
Dialogue: 0,0:37:53.68,0:37:55.71,Default - flashback,Ram,0,0,0,,Zmęczenie doprowadziło do zagubienia.
Dialogue: 0,0:37:59.80,0:38:02.82,Default - italics,Subaru,0,0,0,,Wystarczy tylko uciekać, uciekać, uciekać.
Dialogue: 0,0:38:06.29,0:38:08.30,Default,Subaru,0,0,0,,Co mi da bieganie?
Dialogue: 0,0:38:18.33,0:38:20.56,Default,Subaru,0,0,0,,Rem, dodaj mi odwagi!
Dialogue: 0,0:38:29.10,0:38:30.29,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:38:35.08,0:38:36.05,Default,Emilia,0,0,0,,Dlaczego...
Dialogue: 0,0:38:37.05,0:38:38.74,Default,,0,0,0,,Wróciłeś?
Dialogue: 0,0:38:41.65,0:38:42.60,Default,Subaru,0,0,0,,Chodźmy.
Dialogue: 0,0:38:42.88,0:38:44.63,Default,Subaru,0,0,0,,Nie możemy tu zostać!
Dialogue: 0,0:38:44.72,0:38:46.57,Default,Emilia,0,0,0,,Iść? Dokąd?
Dialogue: 0,0:38:46.66,0:38:48.33,Default,Emilia,0,0,0,,Nie... Dlaczego?
Dialogue: 0,0:38:48.42,0:38:50.77,Default,Subaru,0,0,0,,Gdziekolwiek, byle nie tutaj!
Dialogue: 0,0:38:50.86,0:38:54.59,Default,Subaru,0,0,0,,Jeśli musisz pytać, dlaczego,\Nodpowiedziałbym: „Dla twojego dobra”.
Dialogue: 0,0:38:54.68,0:38:56.00,Default,Subaru,0,0,0,,Wróciłem po ciebie!
Dialogue: 0,0:38:56.16,0:38:58.04,Default,Emilia,0,0,0,,Znowu Subaru?
Dialogue: 0,0:38:58.49,0:39:01.86,Default,Emilia,0,0,0,,Wróciłeś cały w ranach i\Nstrasznie się o ciebie martwiłam.
Dialogue: 0,0:39:01.95,0:39:05.01,Default,Emilia,0,0,0,,Czy nie byłeś w stolicy, żeby\NFelis mogła cię wyleczyć?
Dialogue: 0,0:39:05.10,0:39:07.80,Default,Emilia,0,0,0,,Dlaczego tu teraz jesteś?
Dialogue: 0,0:39:08.26,0:39:09.19,Default,Subaru,0,0,0,,Gdyby...
Dialogue: 0,0:39:09.28,0:39:11.65,Default,Subaru,0,0,0,,Jeśli stawisz opór,\Nwyciągnę cię stąd siłą!
Dialogue: 0,0:39:11.74,0:39:15.15,Default,Subaru,0,0,0,,Za kilka dni przyznasz\Nmi rację, chcąc nie chcąc!
Dialogue: 0,0:39:15.24,0:39:16.12,Default,Subaru,0,0,0,,Więc...
Dialogue: 0,0:39:16.21,0:39:17.57,Default,Emilia,0,0,0,,Czekaj! Czekaj, Subaru!
Dialogue: 0,0:39:17.66,0:39:18.71,Default,,0,0,0,,Co się z tobą stało?
Dialogue: 0,0:39:18.80,0:39:20.88,Default,Emilia,0,0,0,,Wcześniej nie byłeś takim człowiekiem.
Dialogue: 0,0:39:20.97,0:39:23.35,Default,Emilia,0,0,0,,Myślałam, że ty... A jednak...
Dialogue: 0,0:39:23.44,0:39:26.13,Default,Subaru,0,0,0,,Po prostu się nie odzywaj\Ni rób, co ci każę!
Dialogue: 0,0:39:26.84,0:39:28.70,Default,Subaru,0,0,0,,Nie możesz tu zostać!
Dialogue: 0,0:39:28.79,0:39:30.99,Default,Subaru,0,0,0,,Pożałujesz tego... Naprawdę!
Dialogue: 0,0:39:31.08,0:39:32.41,Default,,0,0,0,,Nikt nie zostanie ocalony.
Dialogue: 0,0:39:32.50,0:39:35.39,Default,Subaru,0,0,0,,Nie chcę już więcej cierpieć i płakać!
Dialogue: 0,0:39:35.50,0:39:38.04,Default,Subaru,0,0,0,,Po prostu rób, co mówię!
Dialogue: 0,0:39:38.13,0:39:40.88,Default,Subaru,0,0,0,,Wtedy wszystko się ułoży! Na pewno!
Dialogue: 0,0:39:41.54,0:39:44.39,Default,Subaru,0,0,0,,Dlaczego nikt tego nie rozumie?!
Dialogue: 0,0:39:45.05,0:39:46.22,Default,Emilia,0,0,0,,Przepraszam.
Dialogue: 0,0:39:46.31,0:39:50.19,Default,,0,0,0,,Nie rozumiem, o czym mówisz...
Dialogue: 0,0:39:50.77,0:39:52.28,Default,Emilia,0,0,0,,Chciałabym.
Dialogue: 0,0:39:52.69,0:39:56.98,Default,Emilia,0,0,0,,Ale w tej chwili nie jestem\Npewna, czy mam na to czas.
Dialogue: 0,0:39:57.41,0:40:00.17,Default,Emilia,0,0,0,,Mam tyle rzeczy do zrobienia.
Dialogue: 0,0:40:00.51,0:40:01.79,Default,Emilia,0,0,0,,Więc na razie...
Dialogue: 0,0:40:02.59,0:40:04.24,Default,Subaru,0,0,0,,To nie zadziała.
Dialogue: 0,0:40:05.89,0:40:07.19,Default,Subaru,0,0,0,,To nie zadziała.
Dialogue: 0,0:40:07.28,0:40:09.35,Default,Subaru,0,0,0,,Nie dasz rady. Poniesiesz porażkę!
Dialogue: 0,0:40:09.44,0:40:11.78,Default,Subaru,0,0,0,,Nie dasz rady. To nie ma sensu.
Dialogue: 0,0:40:11.87,0:40:14.44,Default,,0,0,0,,To puste słowa! Nikogo nie\Nzbawisz, nawet siebie!
Dialogue: 0,0:40:14.53,0:40:16.28,Default,Subaru,0,0,0,,Nadal będziesz działać bezmyślnie,
Dialogue: 0,0:40:16.37,0:40:19.77,Default,Subaru,0,0,0,,aż zobaczysz tyle trupów,\Nile podjęłeś lekkomyślnych decyzji!
Dialogue: 0,0:40:19.86,0:40:21.87,Default,Subaru,0,0,0,,To jest twoja przyszłość!
Dialogue: 0,0:40:22.64,0:40:23.73,Default,Emilia,0,0,0,,Dlaczego?
Dialogue: 0,0:40:24.86,0:40:28.80,Default,Emilia,0,0,0,,Dlaczego płaczesz, jakbyś\Ntak bardzo cierpiał?
Dialogue: 0,0:40:32.21,0:40:35.88,Default,Subaru,0,0,0,,Po tym, jak... Po tym,\Njak mnie tu wysłała...
Dialogue: 0,0:40:35.97,0:40:39.55,Default,Subaru,0,0,0,,Nie, po tym, jak mnie\Ntu przyprowadziła, jest...
Dialogue: 0,0:40:39.64,0:40:42.72,Default,Subaru,0,0,0,,Jest coś, co muszę zrobić dla dobra Rem...
Dialogue: 0,0:40:43.03,0:40:44.13,Default,Emilia,0,0,0,,Rem?
Dialogue: 0,0:40:46.95,0:40:48.10,Default,Subaru,0,0,0,,Ty też?
Dialogue: 0,0:40:49.54,0:40:51.19,Default,Subaru,0,0,0,,Ty też zapomniałeś o Remie?
Dialogue: 0,0:40:51.28,0:40:52.25,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:40:54.43,0:40:56.63,Default,Subaru,0,0,0,,No dobrze, opowiem ci wszystko...
Dialogue: 0,0:40:57.17,0:41:00.15,Default,Subaru,0,0,0,,Jeśli wszyscy zamierzacie\Nzapomnieć o Rem,
Dialogue: 0,0:41:00.24,0:41:04.10,Default,Subaru,0,0,0,,Wolę wszystko ujawnić i\Nskończyć z krwawieniem z ust!
Dialogue: 0,0:41:04.19,0:41:05.60,Default - italics,Subaru,0,0,0,,Chcesz? Śmiało.
Dialogue: 0,0:41:06.20,0:41:08.32,Default - italics,Subaru,0,0,0,,Z radością oddam ci moje bijące serce!
Dialogue: 0,0:41:11.14,0:41:12.28,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:41:13.30,0:41:14.25,Default,Emilia,0,0,0,,Tak?
Dialogue: 0,0:41:16.07,0:41:19.10,Default,Subaru,0,0,0,,Mogę użyć „Powrót po śmierci”, aby—
Dialogue: 0,0:41:40.64,0:41:42.19,Default - italics,Subaru,0,0,0,,O co w tym chodziło?
Dialogue: 0,0:41:42.28,0:41:43.31,Default - italics,Subaru,0,0,0,,Zazwyczaj...
Dialogue: 0,0:41:45.24,0:41:46.17,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:41:48.01,0:41:48.98,Default,Subaru,0,0,0,,Emilia?
Dialogue: 0,0:41:54.54,0:41:56.77,Default,Subaru,0,0,0,,Nie... Co... Hę?
Dialogue: 0,0:42:34.40,0:42:38.36,Default,Beatrice,0,0,0,,Wyglądasz jak ktoś, kto jest najbardziej\Nnieszczęśliwą osobę na świecie.
Dialogue: 0,0:42:41.25,0:42:42.58,Default,Subaru,0,0,0,,Beatrice...
Dialogue: 0,0:42:44.34,0:42:46.53,Default,Beatrice,0,0,0,,Bubby chyba nie wyjdzie.
Dialogue: 0,0:42:53.06,0:42:56.13,Default,Beatrice,0,0,0,,Nie martw się. Bubby chyba nie umrze.
Dialogue: 0,0:42:56.79,0:42:59.69,Default,Beatrice,0,0,0,,Na razie po prostu powrócił\Ndo swojej pierwotnej postaci.
Dialogue: 0,0:43:01.86,0:43:03.80,Default,Beatrice,0,0,0,,Masz chyba coś do powiedzenia?
Dialogue: 0,0:43:08.21,0:43:10.36,Default,Subaru,0,0,0,,Proszę, zabij mnie. Tutaj i teraz.
Dialogue: 0,0:43:13.47,0:43:15.84,Default,Beatrice,0,0,0,,Chcesz, żebym cię zabił?
Dialogue: 0,0:43:16.20,0:43:18.08,Default,Beatrice,0,0,0,,To chyba zbyt okrutne.
Dialogue: 0,0:43:19.82,0:43:21.57,Default,Beatrice,0,0,0,,Nic nie rozumiesz.
Dialogue: 0,0:43:21.87,0:43:24.16,Default,Beatrice,0,0,0,,Nic z tego nie rozumiesz.
Dialogue: 0,0:43:24.26,0:43:26.02,Default,Subaru,0,0,0,,Co? Beatrice?
Dialogue: 0,0:43:26.58,0:43:30.18,Default,Beatrice,0,0,0,,Chyba nie spełnię żadnego z twoich życzeń.
Dialogue: 0,0:43:30.58,0:43:33.48,Default,Beatrice,0,0,0,,Jeśli chcesz umrzeć, to umieraj sam.
Dialogue: 0,0:43:34.23,0:43:36.30,Default,Beatrice,0,0,0,,Betty raczej trzyma się od tego z daleka.
Dialogue: 0,0:43:38.44,0:43:39.58,Default,Subaru,0,0,0,,Co ty...
Dialogue: 0,0:43:39.67,0:43:42.19,Default,Beatrice,0,0,0,,Wszystko jest już stracone,
Dialogue: 0,0:43:42.28,0:43:44.64,Default,Beatrice,0,0,0,,ale to, że tu mieszkasz, stanowi problem.
Dialogue: 0,0:43:45.12,0:43:47.86,Default,Beatrice,0,0,0,,Cóż, przynajmniej postaram się to chronić.
Dialogue: 0,0:43:51.86,0:43:53.11,Default,Subaru,0,0,0,,Beatrice?
Dialogue: 0,0:43:53.60,0:43:56.14,Default,Beatrice,0,0,0,,Betty nie jest taka jak Roswaal.
Dialogue: 0,0:43:56.23,0:43:58.43,Default,Beatrice,0,0,0,,Nawet gdyby to zapewniło mi przyszłość,
Dialogue: 0,0:43:58.52,0:44:01.19,Default,Beatrice,0,0,0,,Mam już dość bólu, cierpienia, strachu...
Dialogue: 0,0:44:01.28,0:44:03.22,Default,,0,0,0,,Chyba wszystko!
Dialogue: 0,0:44:10.07,0:44:13.66,Default,Beatrice,0,0,0,,Przynajmniej umrzyj gdzieś,\Ngdzie cię nie zobaczę.
Dialogue: 0,0:44:26.28,0:44:27.80,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:44:33.15,0:44:35.38,Default,Subaru,0,0,0,,Przepraszam... Przepraszam.
Dialogue: 0,0:44:35.62,0:44:36.50,Default,Subaru,0,0,0,,Przepraszam.
Dialogue: 0,0:44:38.10,0:44:39.62,Default,Subaru,0,0,0,,Tak mi przykro...
Dialogue: 0,0:44:42.90,0:44:45.68,Default,Subaru,0,0,0,,Ktoś... Ktokolwiek...
Dialogue: 0,0:44:48.08,0:44:52.02,Default,Subaru,0,0,0,,Proszę, zabij mnie!
Dialogue: 0,0:45:03.09,0:45:07.60,Default,Betel,0,0,0,,Czekałem na ciebie, wierzącą w miłość.
Dialogue: 0,0:45:10.93,0:45:12.34,Default,Subaru,0,0,0,,Betelgeuse...
Dialogue: 0,0:45:13.04,0:45:14.65,Default,Betel,0,0,0,,No proszę, proszę, proszę...
Dialogue: 0,0:45:14.74,0:45:16.75,Default,Betel,0,0,0,,Ten, którego przyciskasz do piersi
Dialogue: 0,0:45:16.84,0:45:20.34,Default,Betel,0,0,0,,Czy to nie ta dziewczyna,\Nktóra jest w połowie diabłem?
Dialogue: 0,0:45:20.71,0:45:22.78,Default,Betel,0,0,0,,Ależ jesteś sumienny!
Dialogue: 0,0:45:23.03,0:45:25.00,Default,Betel,0,0,0,,Zanim zdążyliśmy cokolwiek zrobić,
Dialogue: 0,0:45:25.09,0:45:27.91,Default,,0,0,0,,odebrałeś życie półdiablicy\Nw imię Próby!
Dialogue: 0,0:45:29.01,0:45:30.78,Default,Subaru,0,0,0,,Jestem sumienny?
Dialogue: 0,0:45:31.15,0:45:32.66,Default,Betel,0,0,0,,Zgadza się!
Dialogue: 0,0:45:32.75,0:45:37.00,Default,Betel,0,0,0,,Jesteś bardzo pracowity! Fantastycznie!
Dialogue: 0,0:45:38.29,0:45:39.57,Default,Betel,0,0,0,,A jednak...
Dialogue: 0,0:45:39.84,0:45:41.91,Default,Betel,0,0,0,,Nie potrafiąc pokonać ani jednej próby,
Dialogue: 0,0:45:42.00,0:45:45.06,Default,Betel,0,0,0,,a tym bardziej zmierzyć się\Nz jednym z grzechów,
Dialogue: 0,0:45:45.31,0:45:46.90,Default,Betel,0,0,0,,i po całym tym czekaniu...
Dialogue: 0,0:45:47.07,0:45:50.52,Default,Betel,0,0,0,,Potknęła się o pierwszy kamyk\Nna swojej drodze i to już koniec...
Dialogue: 0,0:45:51.17,0:45:52.83,Default,Betel,0,0,0,,Ach, to ty
Dialogue: 0,0:45:53.85,0:45:56.03,Default,Betel,0,0,0,,naprawdę leniwy...
Dialogue: 0,0:46:06.37,0:46:10.65,Default,Betel,0,0,0,,Widziałeś przed chwilą Niewidzialną Rękę?
Dialogue: 0,0:46:12.40,0:46:13.49,Default,Betel,0,0,0,,Nie...
Dialogue: 0,0:46:14.16,0:46:15.62,Default,,0,0,0,,To niedobrze.
Dialogue: 0,0:46:16.28,0:46:18.43,Default,Betel,0,0,0,,To nie tak! To wszystko jest nie tak!
Dialogue: 0,0:46:18.52,0:46:21.77,Default,,0,0,0,,To pomyłka! Pomyłka!
Dialogue: 0,0:46:23.90,0:46:25.97,Default,Betel,0,0,0,,Mój Autorytet...
Dialogue: 0,0:46:26.33,0:46:28.05,Default,Betel,0,0,0,,Autorytet Lenistwa...
Dialogue: 0,0:46:28.33,0:46:32.52,Default,Betel,0,0,0,,Moja Niewidzialna Ręka,\Nktórą obdarzyła mnie miłość...
Dialogue: 0,0:46:32.61,0:46:39.04,Default,Betel,0,0,0,,Nikt inny nie może tego zobaczyć!
Dialogue: 0,0:46:46.44,0:46:49.81,Default,Betel,0,0,0,,Trzymałeś ją tak, jakby\Nbyła dla ciebie niezwykle cenna...
Dialogue: 0,0:46:49.94,0:46:56.94,Default,Betel,0,0,0,,Jak pięknie zapłaczesz,\Ngdy rozerwą półdiablicę?
Dialogue: 0,0:47:01.12,0:47:02.99,Default,Subaru,0,0,0,,Przestań...
Dialogue: 0,0:47:03.84,0:47:05.46,Default,Subaru,0,0,0,,Stój!
Dialogue: 0,0:47:07.58,0:47:12.12,Default,Subaru,0,0,0,,Proszę, przestań!
Dialogue: 0,0:47:19.01,0:47:20.37,Default,Puck,0,0,0,,Co robisz?
Dialogue: 0,0:47:24.90,0:47:27.28,Default,Puck,0,0,0,,Co ty robisz mojej córce,
Dialogue: 0,0:47:29.70,0:47:31.01,Default,Puck,0,0,0,,ty szumowino?
Dialogue: 0,0:47:34.95,0:47:39.96,Episode Title,Title,0,0,0,,Skrajna hańba
