Dialogue: 0,0:00:01.31,0:00:03.76,Default,Echidna,0,0,0,,Pokonałaś wszystkie te przeszkody
Dialogue: 0,0:00:03.85,0:00:06.68,Default,Echidna,0,0,0,,i dostałaś się do zamku snów?
Dialogue: 0,0:00:06.77,0:00:08.20,Default,Echidna,0,0,0,,Co za bezczelność.
Dialogue: 0,0:00:13.20,0:00:15.57,Default,Subaru,0,0,0,,Poważnie, co z tobą?
Dialogue: 0,0:00:16.21,0:00:17.95,Default,Subaru,0,0,0,,Czego ode mnie chcesz?!
Dialogue: 0,0:00:18.80,0:00:19.89,Default,Satella,0,0,0,,Tak długo...
Dialogue: 0,0:00:20.81,0:00:22.52,Default,Satella,0,0,0,,Tak bardzo długo...
Dialogue: 0,0:00:23.68,0:00:25.62,Default,Satella,0,0,0,,Kochałam cię...
Dialogue: 0,0:00:26.60,0:00:27.84,Default,Satella,0,0,0,,i nikogo innego.
Dialogue: 0,0:00:28.86,0:00:29.74,Default,Subaru,0,0,0,,Przestań...
Dialogue: 0,0:00:30.24,0:00:31.21,Default,Satella,0,0,0,,Kocham cię.
Dialogue: 0,0:00:32.53,0:00:33.50,Default,Subaru,0,0,0,,Przestań.
Dialogue: 0,0:00:33.59,0:00:39.43,Default,Satella,0,0,0,,Kochałam tylko ciebie przez tak, tak długi\Nczas.
Dialogue: 0,0:00:39.88,0:00:42.60,Default,Subaru,0,0,0,,Powiedziałem, przestań, do cholery!
Dialogue: 0,0:00:43.49,0:00:45.84,Default,Subaru,0,0,0,,Obie jesteście szalone!
Dialogue: 0,0:00:45.93,0:00:48.56,Default,Subaru,0,0,0,,Mam dość was obu!
Dialogue: 0,0:00:48.86,0:00:50.68,Default,Subaru,0,0,0,,Nie przyjmę pomocy od żadnej z was!
Dialogue: 0,0:00:50.77,0:00:52.66,Default,Subaru,0,0,0,,Sam znajdę sposób, żeby to naprawić!
Dialogue: 0,0:00:52.75,0:00:54.42,Default,Subaru,0,0,0,,Czy to nie wystarczy?
Dialogue: 0,0:00:54.70,0:00:58.05,Default,Minerva,0,0,0,,Więc będziesz po prostu umierał i zaczynał\Nod nowa,
Dialogue: 0,0:00:58.14,0:01:01.08,Default,Minerva,0,0,0,,doprowadzając wszystkich do łez? Naprawdę?
Dialogue: 0,0:01:01.32,0:01:02.81,Default,Minerva,0,0,0,,Musi być miło być tobą.
Dialogue: 0,0:01:02.90,0:01:04.73,Default,Minerva,0,0,0,,Nieważne jak wszyscy inni się czują,
Dialogue: 0,0:01:04.82,0:01:07.68,Default,Minerva,0,0,0,,Zawsze możesz użyć wymówki,\Nże cierpisz najbardziej.
Dialogue: 0,0:01:08.02,0:01:08.92,Default,Subaru,0,0,0,,Czy ty...
Dialogue: 0,0:01:09.27,0:01:11.83,Default,Subaru,0,0,0,,Chcesz powiedzieć, że udaję\Ntragicznego bohatera?!
Dialogue: 0,0:01:11.92,0:01:13.03,Default,Minerva,0,0,0,,Nie, tego nie mówię.
Dialogue: 0,0:01:13.12,0:01:17.23,Default,Minerva,0,0,0,,Mówię, że decydowanie, że tylko ty\Nmusisz cierpieć, jest tchórzostwem.
Dialogue: 0,0:01:17.32,0:01:21.62,Default,Minerva,0,0,0,,Tak wypaczone myślenie czyni cię\Nnikczemniejszym niż każda czarownica.
Dialogue: 0,0:01:22.54,0:01:23.59,Default,Minerva,0,0,0,,A przede wszystkim...
Dialogue: 0,0:01:25.39,0:01:28.13,Default,Minerva,0,0,0,,To wobec niej naprawdę niewdzięczne.
Dialogue: 0,0:01:31.59,0:01:33.16,Default,Subaru,0,0,0,,Podły?
Dialogue: 0,0:01:34.64,0:01:36.09,Default,Subaru,0,0,0,,Niewdzięczny?
Dialogue: 0,0:01:38.03,0:01:39.70,Default,Subaru,0,0,0,,Co do diabła?!
Dialogue: 0,0:01:40.99,0:01:45.24,Default,Subaru,0,0,0,,To ty mnie takim uczyniłaś!
Dialogue: 0,0:01:45.33,0:01:49.80,Default,Subaru,0,0,0,,Cały ból, całe cierpienie, to wszystko...\N{\i1}absolutnie wszystko{\i0}... spotyka tylko mnie!
Dialogue: 0,0:01:50.25,0:01:52.71,Default,Subaru,0,0,0,,Gdybym nic nie zrobił,\Nczy coś byłoby inaczej?!
Dialogue: 0,0:01:53.06,0:01:55.46,Default,Subaru,0,0,0,,Czy i tak nie mam strasznej przyszłości?!
Dialogue: 0,0:01:55.70,0:02:00.32,Default,Subaru,0,0,0,,Kto inny oprócz mnie zrobiłby to, co ja?!
Dialogue: 0,0:02:00.41,0:02:01.51,Default,Satella,0,0,0,,...ranić.
Dialogue: 0,0:02:02.46,0:02:04.05,Default,Satella,0,0,0,,Nie daj się zranić.
Dialogue: 0,0:02:04.14,0:02:05.54,Default,Satella,0,0,0,,Nie cierp.
Dialogue: 0,0:02:05.96,0:02:07.97,Default,Satella,0,0,0,,Nie bądź smutny.
Dialogue: 0,0:02:08.06,0:02:11.61,Default,Subaru,0,0,0,,Jak śmiesz...
Dialogue: 0,0:02:11.99,0:02:14.11,Default,Satella,0,0,0,,Więc... kochaj...
Dialogue: 0,0:02:14.60,0:02:16.69,Default,Subaru,0,0,0,,Więc do tego wszystko się sprowadza?
Dialogue: 0,0:02:17.19,0:02:20.34,Default,Subaru,0,0,0,,Jesteś aż tak zdesperowana, żebym cię\Npokochał?!
Dialogue: 0,0:02:20.43,0:02:21.35,Default,Satella,0,0,0,,Nie.
Dialogue: 0,0:02:21.85,0:02:25.33,Default,Satella,0,0,0,,Kochaj siebie bardziej.
Dialogue: 0,0:02:25.53,0:02:26.41,Default,Subaru,0,0,0,,Co—
Dialogue: 0,0:02:26.69,0:02:29.16,Default,Subaru,0,0,0,,Co ty przed chwilą powiedziałaś?
Dialogue: 0,0:02:29.25,0:02:31.63,Default,Satella,0,0,0,,Nie daj się zranić. Nie rozpaczaj.
Dialogue: 0,0:02:32.21,0:02:34.79,Default,Satella,0,0,0,,Ceń siebie bardziej.
Dialogue: 0,0:02:34.88,0:02:38.99,Default,Subaru,0,0,0,,To ty dałaś mi zdolność Powrotu przez\NŚmierć!
Dialogue: 0,0:02:39.08,0:02:40.78,Default,Satella,0,0,0,,Kocham cię.
Dialogue: 0,0:02:41.60,0:02:45.59,Default,Satella,0,0,0,,Więc chcę, żebyś pokochał i chronił samego\Nsiebie.
Dialogue: 0,0:02:44.89,0:02:47.94,Default,Subaru,0,0,0,,{\an8}Gdybym z miłości do siebie\Nstracił tę zdolność,
Dialogue: 0,0:02:48.03,0:02:50.48,Default,Subaru,0,0,0,,co by mi w ogóle zostało?!
Dialogue: 0,0:02:50.57,0:02:53.39,Default,Subaru,0,0,0,,Mam tylko własne życie,\Nktóre mogę wykorzystać!
Dialogue: 0,0:02:53.48,0:02:57.62,Default,Subaru,0,0,0,,Dopóki to ja cierpię bardziej niż\Nktokolwiek inny, żeby móc ich chronić,
Dialogue: 0,0:02:57.71,0:03:01.11,Default,Subaru,0,0,0,,nikt inny w ogóle nie musi cierpieć!
Dialogue: 0,0:03:01.72,0:03:05.67,Default,Subaru,0,0,0,,Przecież nikogo nie obchodzi, co stanie\Nsię z takim przegranym jak ja, prawda?!
Dialogue: 0,0:03:05.76,0:03:08.04,Default,Subaru,0,0,0,,Nieważne, jak bardzo oberwę,
Dialogue: 0,0:03:08.50,0:03:11.37,Default,Subaru,0,0,0,,dopóki wszyscy pozostali dotrą do\Nprzyszłości...
Dialogue: 0,0:03:11.90,0:03:17.42,Default,Subaru,0,0,0,,Dopóki możemy rozpocząć jutro, nikogo nie\Ntracąc... wtedy...
Dialogue: 0,0:03:20.76,0:03:22.56,Default,Subaru,0,0,0,,Rem zniknęła.
Dialogue: 0,0:03:23.64,0:03:25.58,Default,Subaru,0,0,0,,Gdybym był silniejszy...
Dialogue: 0,0:03:26.57,0:03:28.87,Default,Subaru,0,0,0,,Gdybym stanął na pierwszej linii
Dialogue: 0,0:03:28.96,0:03:31.40,Default,Subaru,0,0,0,,i nie martwił się o to, co może mi się\Nstać...
Dialogue: 0,0:03:32.82,0:03:34.78,Default,Subaru,0,0,0,,Mogłem temu zapobiec.
Dialogue: 0,0:03:37.62,0:03:39.19,Default,Subaru,0,0,0,,Nie chcę...
Dialogue: 0,0:03:39.76,0:03:43.98,Default,Subaru,0,0,0,,stracić nikogo więcej tak jak Rem!
Dialogue: 0,0:03:51.25,0:03:53.09,Default,Sekhmet,0,0,0,,Nie jesteś dzieckiem.
Dialogue: 0,0:03:53.98,0:03:58.25,Default,Sekhmet,0,0,0,,Spójrz na siebie... płaczesz, zawodzisz i\Npróbujesz poradzić sobie ze wszystkim sam.
Dialogue: 0,0:03:58.70,0:04:00.18,Default,Sekhmet,0,0,0,,Zachowujesz się zupełnie jak
Dialogue: 0,0:04:01.35,0:04:04.62,Default,Sekhmet,0,0,0,,małe, samotne dziecko.
Dialogue: 0,0:04:06.88,0:04:09.62,Default,Typhon,0,0,0,,Baru, płaczesz?
Dialogue: 0,0:04:10.27,0:04:13.97,Default,Typhon,0,0,0,,Spójrz, jak bardzo ktoś cię skrzywdził.\NBiedactwo.
Dialogue: 0,0:04:15.18,0:04:16.40,Default,Typhon,0,0,0,,Więc kto...
Dialogue: 0,0:04:17.12,0:04:18.90,Default,Typhon,0,0,0,,doprowadził cię do łez?
Dialogue: 0,0:04:28.55,0:04:31.83,Default,Satella,0,0,0,,Kocham cię.
Dialogue: 0,0:04:32.50,0:04:34.33,Default,Subaru,0,0,0,,Przestań...
Dialogue: 0,0:04:35.00,0:04:38.53,Default,Satella,0,0,0,,To dlatego, że dałeś mi wszystko.
Dialogue: 0,0:04:39.66,0:04:41.71,Default,Satella,0,0,0,,Dlatego ja...
Dialogue: 0,0:04:41.80,0:04:44.69,Default,Subaru,0,0,0,,Przestań!
Dialogue: 0,0:04:46.98,0:04:47.86,Default,Typhon,0,0,0,,Baru?
Dialogue: 0,0:04:51.99,0:04:56.55,Default,Echidna,0,0,0,,Ach, to rzeczywiście jedna z możliwości,\NNatsuki Subaru.
Dialogue: 0,0:05:00.80,0:05:02.27,Default,Minerva,0,0,0,,Jego język...
Dialogue: 0,0:05:02.36,0:05:04.61,Default,Minerva,0,0,0,,Ty kompletny kretynie!
Dialogue: 0,0:05:07.96,0:05:10.61,Default,Minerva,0,0,0,,To będzie łatwe!
Dialogue: 0,0:05:10.70,0:05:12.39,Default,Minerva,0,0,0,,Nie wchodź mi w drogę, Typhon!
Dialogue: 0,0:05:12.48,0:05:14.15,Default,Typhon,0,0,0,,Baru dokonał własnego wyboru!
Dialogue: 0,0:05:14.24,0:05:15.96,Default,Typhon,0,0,0,,{\i1}Ty{\i0} nie wchodź mi w drogę, Nerva!
Dialogue: 0,0:05:16.05,0:05:20.46,Default,Minerva,0,0,0,,Nie pozwolę przy mnie na samookaleczenie,\Nsamobójstwo ani morderstwo!
Dialogue: 0,0:05:22.88,0:05:24.05,Default,Minerva,0,0,0,,Sekhmet...
Dialogue: 0,0:05:24.36,0:05:28.11,Default,Sekhmet,0,0,0,,Emocjonalnie też jestem\Npo stronie chłopca.
Dialogue: 0,0:05:29.60,0:05:33.38,Default,Sekhmet,0,0,0,,I... też jestem po stronie Typhon.
Dialogue: 0,0:05:42.81,0:05:45.01,Default,Satella,0,0,0,,Dlaczego nie zdałeś sobie sprawy
Dialogue: 0,0:05:45.77,0:05:51.11,Default,Satella,0,0,0,,że powinieneś być wśród tych,\Nktórych chcesz ocalić?
Dialogue: 0,0:05:51.20,0:05:52.55,Default,Satella,0,0,0,,To powinno być oczywiste...
Dialogue: 0,0:05:59.95,0:06:05.00,Default,Satella,0,0,0,,Co mogłeś zobaczyć w tych dwóch próbach?
Dialogue: 0,0:06:08.60,0:06:10.49,Default - flashback,Kenichi,0,0,0,,Liczę na ciebie, synu.
Dialogue: 0,0:06:10.58,0:06:11.87,Default - flashback,Nahoko,0,0,0,,Uważaj na siebie.
Dialogue: 0,0:06:11.96,0:06:12.84,Default - italics,Subaru,0,0,0,,Ja...
Dialogue: 0,0:06:12.93,0:06:16.42,Default - flashback,Julius,0,0,0,,Chciałem cię nazwać przyjacielem.
Dialogue: 0,0:06:16.90,0:06:18.95,Default - flashback,Wilhelm,0,0,0,,Dlaczego? Dlaczego?!
Dialogue: 0,0:06:19.04,0:06:20.62,Default - flashback,Wilhelm,0,0,0,,Dlaczego tak łatwo umarłeś?
Dialogue: 0,0:06:20.71,0:06:22.69,Default - flashback,Wilhelm,0,0,0,,{\an8}Subaru-dono, jesteś...
Dialogue: 0,0:06:22.20,0:06:23.68,Default - italics,Subaru,0,0,0,,Nieważne w co wierzę...
Dialogue: 0,0:06:22.69,0:06:27.20,Default - flashback,Beatrice,0,0,0,,{\an8}Wiedziałam, że nie możesz być „tą osobą”.
Dialogue: 0,0:06:26.00,0:06:28.44,Default - italics,Subaru,0,0,0,,Nieważne, czego chcę...
Dialogue: 0,0:06:30.03,0:06:33.67,Default - flashback,Rem,0,0,0,,Pokaż mi, jaki potrafisz być niesamowity,\NSubaru.
Dialogue: 0,0:06:36.43,0:06:37.82,Default - flashback,Emilia,0,0,0,,Dziękuję, Subaru.
Dialogue: 0,0:06:38.51,0:06:40.25,Default - flashback,Emilia,0,0,0,,Za uratowanie mnie.
Dialogue: 0,0:06:43.33,0:06:45.58,Default - italics,Subaru,0,0,0,,Nie chcę umrzeć.
Dialogue: 0,0:06:45.67,0:06:48.26,Default,Minerva,0,0,0,,Widzisz?! Właśnie tak naprawdę się\Nczujesz!
Dialogue: 0,0:07:11.53,0:07:12.74,Default,,0,0,0,,Czy moje życie...
Dialogue: 0,0:07:13.48,0:07:15.53,Default,Subaru,0,0,0,,ma jakąkolwiek wartość?
Dialogue: 0,0:07:17.19,0:07:20.96,Default,Subaru,0,0,0,,Co mogę zrobić poza umieraniem i\Npowtarzaniem wszystkiego?
Dialogue: 0,0:07:31.95,0:07:38.95,Default,Subaru,0,0,0,,Czy naprawdę mogę wierzyć...\Nże ludzie, których lubię...
Dialogue: 0,0:07:41.35,0:07:44.48,Default,Subaru,0,0,0,,także... mnie lubią?
Dialogue: 0,0:07:46.75,0:07:47.86,Default,Satella,0,0,0,,Pozwalam ci.
Dialogue: 0,0:07:51.50,0:07:53.82,Default,Satella,0,0,0,,Ty mnie uratowałeś.
Dialogue: 0,0:07:54.44,0:07:58.70,Default,Satella,0,0,0,,Więc pozwolę, żeby i ciebie ocalono.
Dialogue: 0,0:07:59.52,0:08:01.54,Default,Satella,0,0,0,,Pragnę, żebyś
Dialogue: 0,0:08:02.34,0:08:04.54,Default,Satella,0,0,0,,został ocalony.
Dialogue: 0,0:08:17.58,0:08:19.22,Default,Echidna,0,0,0,,Pomijając Minervę,
Dialogue: 0,0:08:19.84,0:08:24.08,Default,Echidna,0,0,0,,bardziej zaskoczyło mnie zachowanie waszej\Ndwójki.
Dialogue: 0,0:08:25.71,0:08:27.77,Default,Typhon,0,0,0,,Nie wtrącaj się, Daph!
Dialogue: 0,0:08:28.05,0:08:32.34,Default,Daphne,0,0,0,,Subarun nieźle się przede mną przechwalał.
Dialogue: 0,0:08:32.43,0:08:36.74,Default,Daphne,0,0,0,,Więc chciałabym zobaczyć, jak\Nprzynajmniej spróbuje dotrzymać słowa.
Dialogue: 0,0:08:37.60,0:08:39.64,Default,Echidna,0,0,0,,To intrygująca myśl.
Dialogue: 0,0:08:40.08,0:08:44.62,Default,Echidna,0,0,0,,A to ty ściągnęłaś go znad krawędzi\Nśmierci, prawda,
Dialogue: 0,0:08:44.71,0:08:45.59,Default,Echidna,0,0,0,,Carmilla?
Dialogue: 0,0:08:46.46,0:08:50.83,Default,Echidna,0,0,0,,Użyłaś nawet „Oblubienicy bez twarzy”. Po\Nco?
Dialogue: 0,0:08:51.56,0:08:52.67,Default,Carmilla,0,0,0,,Bez... powodu...
Dialogue: 0,0:08:53.84,0:08:57.82,Default,Carmilla,0,0,0,,Ja tylko... myślę... że miłość jest ważna.
Dialogue: 0,0:08:58.26,0:09:01.14,Default,Carmilla,0,0,0,,Nawet jeśli nie chce tego zobaczyć,
Dialogue: 0,0:09:01.23,0:09:03.38,Default,Carmilla,0,0,0,,Jest tam miłość...
Dialogue: 0,0:09:03.88,0:09:05.77,Default,Carmilla,0,0,0,,I ja...
Dialogue: 0,0:09:06.63,0:09:09.78,Default,Carmilla,0,0,0,,Nie zniosę widoku miłości przyjmowanej,\Nlecz nieodwzajemnionej.
Dialogue: 0,0:09:13.16,0:09:16.87,Default,Echidna,0,0,0,,Sekhmet i Typhon uszanowały jego życzenie,
Dialogue: 0,0:09:16.96,0:09:18.96,Default,Echidna,0,0,0,,Minerva go wyleczyła.
Dialogue: 0,0:09:19.46,0:09:21.57,Default,Echidna,0,0,0,,Daphne pomogła przedłużyć jego życie.
Dialogue: 0,0:09:21.66,0:09:25.79,Default,Echidna,0,0,0,,A Carmilla użyła swojego Autorytetu, by\Nuświadomić mu miłość, której nie widział.
Dialogue: 0,0:09:26.24,0:09:29.73,Default,Echidna,0,0,0,,Więc choć każda z was może mieć własne\Npowody,
Dialogue: 0,0:09:29.82,0:09:32.75,Default,Echidna,0,0,0,,wszystkie chcecie pomóc Natsuki Subaru.
Dialogue: 0,0:09:36.24,0:09:38.11,Default,Echidna,0,0,0,,To naprawdę interesujące.
Dialogue: 0,0:09:38.60,0:09:40.47,Default,Echidna,0,0,0,,Nie zgadzacie się?
Dialogue: 0,0:09:41.67,0:09:46.14,Default,Subaru,0,0,0,,Poważnie... co jest z wami wszystkimi?
Dialogue: 0,0:09:48.07,0:09:52.51,Default,Subaru,0,0,0,,Nie rozumiem ani nie podzielam prawie\Nżadnego powodu, by mnie wspierać.
Dialogue: 0,0:09:52.60,0:09:54.52,Default,Subaru,0,0,0,,Nic dziwnego, że zwą was czarownicami.
Dialogue: 0,0:09:54.61,0:09:56.48,Default,Echidna,0,0,0,,Skoro znowu nas oczerniasz,
Dialogue: 0,0:09:56.57,0:09:58.57,Default,Echidna,0,0,0,,Czy mam przyjąć, że odzyskałeś siły?
Dialogue: 0,0:09:59.26,0:10:02.58,Default,Subaru,0,0,0,,Nie wiem już co robić.
Dialogue: 0,0:10:03.57,0:10:07.58,Default,Echidna,0,0,0,,Więc pozwól, że cię o to\Nzapytam, Natsuki Subaru.
Dialogue: 0,0:10:08.75,0:10:10.92,Default,Echidna,0,0,0,,Jeśli pomogę ci,
Dialogue: 0,0:10:11.01,0:10:16.21,Default,Echidna,0,0,0,,na pewno dotrzesz do przyszłości,\Nw której ocalisz wybrane osoby.
Dialogue: 0,0:10:16.86,0:10:19.48,Default,Echidna,0,0,0,,Jeśli nie wiesz co powinieneś zrobić,
Dialogue: 0,0:10:19.94,0:10:22.43,Default,Echidna,0,0,0,,wyciągniesz do mnie rękę?
Dialogue: 0,0:10:23.12,0:10:27.21,Default,Echidna,0,0,0,,Bez wątpienia zabiorę cię do przyszłości,\Nktórej pragniesz.
Dialogue: 0,0:10:28.21,0:10:29.69,Default,Echidna,0,0,0,,Masz moje słowo.
Dialogue: 0,0:10:35.23,0:10:39.82,Default,Subaru,0,0,0,,Echidno... boję się, że znów ucierpię.
Dialogue: 0,0:10:41.54,0:10:45.21,Default,Subaru,0,0,0,,Nienawidzę bólu, cierpienia i smutku.
Dialogue: 0,0:10:45.73,0:10:47.64,Default,Subaru,0,0,0,,Nie chcę czuć bólu.
Dialogue: 0,0:10:47.73,0:10:51.13,Default,Subaru,0,0,0,,Nie chcę też patrzeć, jak komuś innemu\Ndzieje się coś strasznego.
Dialogue: 0,0:10:53.05,0:10:54.70,Default,Subaru,0,0,0,,Nie chcę umrzeć.
Dialogue: 0,0:10:55.91,0:10:59.42,Default,Subaru,0,0,0,,Więc skoro wzięcie cię za rękę wymaga\Nofiar...
Dialogue: 0,0:11:00.13,0:11:02.10,Default,Subaru,0,0,0,,nie mogę znów jej przyjąć.
Dialogue: 0,0:11:05.05,0:11:08.84,Default,Subaru,0,0,0,,Jeśli mam dla nich jakąś wartość poza\Nwłasną śmiercią,
Dialogue: 0,0:11:09.71,0:11:11.78,Default,Subaru,0,0,0,,zamierzam jej poszukać.
Dialogue: 0,0:11:12.42,0:11:14.05,Default,Subaru,0,0,0,,Jeśli ją znajdę, czuję, że
Dialogue: 0,0:11:14.14,0:11:18.65,Default,Subaru,0,0,0,,Mogę im odpłacić w inny\Nsposób niż śmiercią.
Dialogue: 0,0:11:18.97,0:11:21.02,Default,Echidna,0,0,0,,Ta ścieżka jest wyłożona cierniami.
Dialogue: 0,0:11:21.14,0:11:23.34,Default,Echidna,0,0,0,,Gdybyś traktował swoją śmierć jak\Nnarzędzie,
Dialogue: 0,0:11:23.43,0:11:26.41,Default,Echidna,0,0,0,,twoje serce byłoby jedynym, co musiałbyś\Npoświęcić.
Dialogue: 0,0:11:27.01,0:11:31.47,Default,Echidna,0,0,0,,Lecz odrzucenie tego i próba ocalenia\Nwłasnego serca oraz przyszłości innych
Dialogue: 0,0:11:31.56,0:11:37.42,Default,Echidna,0,0,0,,byłyby niezwykle trudne, a przede\Nwszystkim...
Dialogue: 0,0:11:40.41,0:11:41.78,Default,Echidna,0,0,0,,chciwe.
Dialogue: 0,0:11:44.56,0:11:49.35,Default,Subaru,0,0,0,,To prawda, że ocaliłaś mnie już wiele\Nrazy.
Dialogue: 0,0:11:50.60,0:11:55.01,Default,Subaru,0,0,0,,Nieważne, jakie miałaś zamiary, to\Npozostaje prawdą.
Dialogue: 0,0:11:58.21,0:12:02.84,Default,Echidna,0,0,0,,Ten biedny, głupi Garfiel\Nboi się świata zewnętrznego.
Dialogue: 0,0:12:02.93,0:12:06.83,Default,Echidna,0,0,0,,Żeby uwolnić go z tej sytuacji, musiałbyś\Nprzełamać ten czar.
Dialogue: 0,0:12:07.48,0:12:08.50,Default,Subaru,0,0,0,,Echidna?
Dialogue: 0,0:12:08.94,0:12:11.95,Default,Echidna,0,0,0,,Och, jestem tylko rozgoryczoną przegraną,\Nktóra się wtrąca.
Dialogue: 0,0:12:12.04,0:12:15.66,Default,Echidna,0,0,0,,Nie chcę, żebyś myślał, że wszystkie inne\Nczarownice miały dobre serca,
Dialogue: 0,0:12:15.75,0:12:20.05,Default,Echidna,0,0,0,,Ale tylko Echidna była\Nzła do samego końca.
Dialogue: 0,0:12:20.51,0:12:25.83,Default,Echidna,0,0,0,,W końcu nadal jestem dziewczyną i darzę\Ncię sympatią.
Dialogue: 0,0:12:30.53,0:12:34.26,Default,Subaru,0,0,0,,Jesteście potworami\Npoza moim zrozumieniem.
Dialogue: 0,0:12:34.93,0:12:38.13,Default,Subaru,0,0,0,,Nigdy się nie zrozumiemy i wątpię,\Nczy kiedykolwiek was polubię.
Dialogue: 0,0:12:38.68,0:12:39.69,Default,Subaru,0,0,0,,Ale...
Dialogue: 0,0:12:41.07,0:12:43.52,Default,Subaru,0,0,0,,Dzięki, że byłyście gotowe pozwolić mi\Numrzeć.
Dialogue: 0,0:12:44.84,0:12:47.93,Default,Subaru,0,0,0,,Dzięki, że nie pozwoliłyście mi umrzeć.
Dialogue: 0,0:12:48.87,0:12:52.95,Default,Subaru,0,0,0,,Dzięki, że pozwoliłyście mi usłyszeć te\Ncenne głosy, które musiałem usłyszeć.
Dialogue: 0,0:12:53.63,0:12:55.67,Default,Subaru,0,0,0,,Dziękuję wam za to.
Dialogue: 0,0:13:01.00,0:13:03.93,Default,Subaru,0,0,0,,Nie rozumiem cię.
Dialogue: 0,0:13:05.68,0:13:10.43,Default,Subaru,0,0,0,,Ale to fakt, że moc Powrotu przez Śmierć,\Nktórą mi dałaś, wiele razy mnie uratowała.
Dialogue: 0,0:13:10.98,0:13:14.98,Default,Subaru,0,0,0,,Czy Powrót przez Śmierć jest jedną z\Ndostępnych mi możliwości?
Dialogue: 0,0:13:15.68,0:13:20.44,Default,Subaru,0,0,0,,Jeśli mam pokochać siebie, nie polegając\Nna nim zbyt mocno...
Dialogue: 0,0:13:22.88,0:13:25.36,Default,Subaru,0,0,0,,Nie mogę powiedzieć, że to będzie łatwe.
Dialogue: 0,0:13:26.07,0:13:31.41,Default,Subaru,0,0,0,,Ale spróbuję polubić siebie trochę\Nbardziej, tak jak powiedziałaś.
Dialogue: 0,0:13:32.68,0:13:33.87,Default,Satella,0,0,0,,Nic ci nie będzie?
Dialogue: 0,0:13:34.29,0:13:35.17,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:13:35.36,0:13:38.12,Default,Subaru,0,0,0,,W porównaniu ze śmiercią, to nic.
Dialogue: 0,0:13:44.55,0:13:47.05,Default,Satella,0,0,0,,Nie zadręczaj się w samotności.
Dialogue: 0,0:13:47.90,0:13:52.25,Default,Satella,0,0,0,,Walcz u boku ludzi, którym na tobie\Nzależy.
Dialogue: 0,0:13:53.95,0:13:58.81,Default,Satella,0,0,0,,Nie zapominaj, że są ludzie,\Nktórzy opłakują twoją śmierć.
Dialogue: 0,0:13:59.94,0:14:00.90,Default,Subaru,0,0,0,,Ja...
Dialogue: 0,0:14:06.85,0:14:08.11,Default,Satella,0,0,0,,I pewnego dnia,
Dialogue: 0,0:14:10.04,0:14:11.32,Default,Satella,0,0,0,,musisz przyjść...
Dialogue: 0,0:14:16.30,0:14:19.21,Default,Satella,0,0,0,,i mnie zabić.
Dialogue: 0,0:14:23.50,0:14:24.92,Default,Subaru,0,0,0,,Przysięgam...
Dialogue: 0,0:14:25.88,0:14:27.83,Default,Subaru,0,0,0,,Uratuję cię.
Dialogue: 0,0:14:27.92,0:14:30.93,Episode Title,Title,0,0,0,,{\pos(320,60)\t(1,5000,\fs40)}{\c&HB5AAAA&}Dźwięki, {\c&HFFFFFF&}przez które chce się płakać
Dialogue: 0,0:14:27.92,0:14:30.93,Episode Title,Title,0,0,0,,{\pos(320,60)\t(1,5000,\fs40)\clip(106,50,531,67)}{\c&H414A48&}Dźwięki, {\c&HFFFFFF&}przez które chce się płakać
Dialogue: 0,0:14:37.54,0:14:38.89,Default,Subaru,0,0,0,,To ty...
Dialogue: 0,0:14:41.05,0:14:42.90,Default,Otto,0,0,0,,Nie śpisz?
Dialogue: 0,0:14:43.18,0:14:44.18,Default,Subaru,0,0,0,,Otto?
Dialogue: 0,0:14:44.92,0:14:46.03,Default,Subaru,0,0,0,,To jest...
Dialogue: 0,0:14:46.95,0:14:48.50,Default,Subaru,0,0,0,,Normalnie byłbym w środku.
Dialogue: 0,0:14:49.26,0:14:50.90,Default,Subaru,0,0,0,,To ty mnie wyniosłeś?
Dialogue: 0,0:14:51.36,0:14:53.24,Default,Otto,0,0,0,,Patrasche to zrobiła.
Dialogue: 0,0:14:53.33,0:14:55.13,Default,Otto,0,0,0,,Zaczęła się wyrywać,
Dialogue: 0,0:14:55.22,0:14:57.27,Default,Otto,0,0,0,,I w chwili, gdy wypuściłem\Nją z powozu...
Dialogue: 0,0:14:59.09,0:15:00.08,Default,Subaru,0,0,0,,Czekaj...
Dialogue: 0,0:15:00.39,0:15:03.88,Default,Subaru,0,0,0,,Każdy, kto wchodzi na cmentarz bez\Nuprawnień, zostaje odrzucony.
Dialogue: 0,0:15:05.16,0:15:07.41,Default,Subaru,0,0,0,,Dlaczego próbowałaś czegoś takiego?
Dialogue: 0,0:15:07.99,0:15:10.89,Default,Subaru,0,0,0,,Wyszedłbym, gdy tylko bym się obudził.
Dialogue: 0,0:15:11.65,0:15:13.09,Default,Subaru,0,0,0,,Dlaczego mnie uratowałaś?
Dialogue: 0,0:15:14.12,0:15:17.93,Default,Otto,0,0,0,,Naprawdę nie wiesz dlaczego?
Dialogue: 0,0:15:22.88,0:15:25.95,Default,Otto,0,0,0,,Oczywiście, masz rację.
Dialogue: 0,0:15:26.04,0:15:28.99,Default,Subaru,0,0,0,,Co? Co powiedziała Patrasche?
Dialogue: 0,0:15:29.08,0:15:32.55,Default,Otto,0,0,0,,Powiedziała: „Nie każ mi mówić dlaczego”.
Dialogue: 0,0:15:32.64,0:15:34.71,Default,Otto,0,0,0,,Naprawdę nie wiesz?
Dialogue: 0,0:15:37.81,0:15:39.26,Default,Otto,0,0,0,,Posłuchaj...
Dialogue: 0,0:15:39.35,0:15:42.07,Default,Otto,0,0,0,,Ruszyć na ratunek komuś\Nw niebezpieczeństwie,
Dialogue: 0,0:15:42.16,0:15:44.65,Default,Otto,0,0,0,,ocalić go bez względu\Nna ryzyko dla siebie
Dialogue: 0,0:15:44.74,0:15:46.44,Default,Otto,0,0,0,,i uśmiechać się, gdy się obudzi...
Dialogue: 0,0:15:46.53,0:15:48.59,Default,Otto,0,0,0,,Wierzę, że stoją za tym te same uczucia,
Dialogue: 0,0:15:48.68,0:15:52.26,Default,,0,0,0,,niezależnie od tego, czy jest się\Nczłowiekiem, czy smokiem lądowym.
Dialogue: 0,0:15:53.47,0:15:56.90,Default,Otto,0,0,0,,Jesteś wyjątkowo tępy. Miło musi być tobą.
Dialogue: 0,0:16:03.08,0:16:04.84,Default,Otto,0,0,0,,N-Natsuki?
Dialogue: 0,0:16:04.08,0:16:07.15,Default,Subaru,0,0,0,,{\an8}Nie, nie, to nie to, co myślisz.
Dialogue: 0,0:16:07.24,0:16:08.98,Default,Subaru,0,0,0,,Po prostu... ten moment...
Dialogue: 0,0:16:12.93,0:16:17.28,Default,Subaru,0,0,0,,Rozumiem. Czyli naprawdę mnie lubisz, co?
Dialogue: 0,0:16:18.07,0:16:21.57,Default,Subaru,0,0,0,,Nie sądziłem, że to właśnie od ciebie\Ndowiem się tego po raz pierwszy.
Dialogue: 0,0:16:22.20,0:16:24.55,Default,Subaru,0,0,0,,Dzięki, Patrasche.
Dialogue: 0,0:16:33.59,0:16:36.24,Default,Otto,0,0,0,,Wszystko w porządku? Co się stało?
Dialogue: 0,0:16:36.33,0:16:39.52,Default,Subaru,0,0,0,,Martwiłeś się? Czekaj, ty też mnie lubisz?
Dialogue: 0,0:16:39.61,0:16:42.01,Default,Otto,0,0,0,,Możesz nie mówić takich\Nobrzydliwych rzeczy?!
Dialogue: 0,0:16:42.10,0:16:44.10,Default,Otto,0,0,0,,Myślę tylko o tym, co będzie dalej!
Dialogue: 0,0:16:44.51,0:16:47.23,Default,Subaru,0,0,0,,No tak. W końcu jesteśmy przyjaciółmi.
Dialogue: 0,0:16:49.52,0:16:50.41,Default,Otto,0,0,0,,Natsuki?
Dialogue: 0,0:16:50.50,0:16:54.61,Default,Subaru,0,0,0,,Czy to znaczy, że przeszedłem drugą próbę?
Dialogue: 0,0:17:04.21,0:17:05.11,Default,Otto,0,0,0,,Hej!
Dialogue: 0,0:17:05.20,0:17:07.62,Default,Subaru,0,0,0,,Cholera... Co to...
Dialogue: 0,0:17:09.82,0:17:11.79,Default,Subaru,0,0,0,,Odrzuciło mnie?
Dialogue: 0,0:17:12.54,0:17:15.72,Default,Subaru,0,0,0,,Czy straciłem uprawnienia? Dlaczego?
Dialogue: 0,0:17:18.74,0:17:20.78,Default,Subaru,0,0,0,,Ta paskudna mała...
Dialogue: 0,0:17:19.85,0:17:22.10,Default,Otto,0,0,0,,{\an8}Co się stało? Czy mogę jakoś—
Dialogue: 0,0:17:22.19,0:17:24.17,Default,Subaru,0,0,0,,Muszę coś zrobić.
Dialogue: 0,0:17:24.26,0:17:26.20,Default,Subaru,0,0,0,,Zabierz Patrasche do powozu.
Dialogue: 0,0:17:26.29,0:17:27.17,Default,Otto,0,0,0,,Ale—
Dialogue: 0,0:17:27.26,0:17:28.14,Default,Subaru,0,0,0,,Proszę.
Dialogue: 0,0:17:43.96,0:17:47.29,Default,Roswaal,0,0,0,,Jak opuścić Sanktuarium bez\Nprzechodzenia przez cmentarz?
Dialogue: 0,0:17:47.98,0:17:50.17,Default,Roswaal,0,0,0,,To dość śmiała propozycja.
Dialogue: 0,0:17:50.57,0:17:54.96,Default,Roswaal,0,0,0,,Zdaje mi się, że nie pierwszy raz o to\Npytasz.
Dialogue: 0,0:17:56.78,0:17:58.78,Default,Subaru,0,0,0,,Rozmawiamy o tym po raz pierwszy.
Dialogue: 0,0:17:59.56,0:18:01.62,Default,Subaru,0,0,0,,Nie ma nawet sensu liczyć,
Dialogue: 0,0:18:01.71,0:18:04.02,Default,,0,0,0,,ile razy do tej pory się\Nprzesłuchiwaliśmy.
Dialogue: 0,0:18:05.05,0:18:09.73,Default,Roswaal,0,0,0,,Wygląda na to, że sporo ze mną\Nprzeszedłeś.
Dialogue: 0,0:18:09.82,0:18:12.32,Default,Subaru,0,0,0,,Nauczyłem się też wielu innych rzeczy.
Dialogue: 0,0:18:12.41,0:18:14.42,Default,Subaru,0,0,0,,Na przykład o placówce z Ryuzu,
Dialogue: 0,0:18:14.51,0:18:16.90,Default,Subaru,0,0,0,,i o tym, że Garfiel jest Apostołem\NChciwości.
Dialogue: 0,0:18:17.14,0:18:19.99,Default,Roswaal,0,0,0,,Cóż, doprawdy wspaniale!
Dialogue: 0,0:18:20.08,0:18:24.95,Default,Roswaal,0,0,0,,Ale rezygnować z cmentarza\Nwydaje się strasznie tchórzliwe.
Dialogue: 0,0:18:25.04,0:18:27.49,Default,Roswaal,0,0,0,,Czy masz powód do takiego pośpiechu?
Dialogue: 0,0:18:27.58,0:18:29.30,Default,Subaru,0,0,0,,Oczywiście, że nie.
Dialogue: 0,0:18:29.77,0:18:30.65,Default,Subaru,0,0,0,,Ja tylko...
Dialogue: 0,0:18:31.48,0:18:35.13,Default,Subaru,0,0,0,,Nie mogę znieść patrzenia, jak Emilia\Nwciąż tam wchodzi i cierpi.
Dialogue: 0,0:18:35.39,0:18:37.01,Default,Roswaal,0,0,0,,Właśnie po to tu jesteś.
Dialogue: 0,0:18:38.83,0:18:42.69,Default,Roswaal,0,0,0,,Chyba nie chcesz powiedzieć, że cierpienie\Nza nią sprawiłoby ci ból?
Dialogue: 0,0:18:42.78,0:18:43.66,Default,Subaru,0,0,0,,To—
Dialogue: 0,0:18:43.75,0:18:45.71,Default,Roswaal,0,0,0,,Nie o to chodzi? Naprawdę?
Dialogue: 0,0:18:46.01,0:18:49.94,Default,Roswaal,0,0,0,,Jeśli naprawdę kochasz Emilię,\Npowinno to być dla ciebie proste.
Dialogue: 0,0:18:50.03,0:18:53.46,Default,Roswaal,0,0,0,,Emilia powinna być pierwsza, ty —\Ndopiero po niej.
Dialogue: 0,0:18:53.55,0:18:54.43,Default,Roswaal,0,0,0,,Czy ja się mylę?
Dialogue: 0,0:18:54.63,0:18:55.51,Default,Subaru,0,0,0,,Ja...
Dialogue: 0,0:18:55.66,0:19:00.49,Default - flashback,Satella,0,0,0,,Nie zapominaj, że są ludzie,\Nktórzy opłakują twoją śmierć.
Dialogue: 0,0:19:05.54,0:19:12.02,Default,Roswaal,0,0,0,,Widzę, że wciąż nie wyostrzyłeś\Nswojej determinacji.
Dialogue: 0,0:19:13.78,0:19:18.74,Default,Roswaal,0,0,0,,Tak, miałem tylko\Nodrobinę nadziei.
Dialogue: 0,0:19:19.16,0:19:20.80,Default,Roswaal,0,0,0,,Że może, tylko może,
Dialogue: 0,0:19:21.57,0:19:24.89,Default,Roswaal,0,0,0,,zobaczę przyszłość, której pragnąłem...
Dialogue: 0,0:19:26.30,0:19:31.00,Default,Roswaal,0,0,0,,Ale wciąż nie stanąłeś nawet na linii\Nstartu swojej determinacji.
Dialogue: 0,0:19:31.48,0:19:33.81,Default,Subaru,0,0,0,,Na linii startu... mojej determinacji?
Dialogue: 0,0:19:34.05,0:19:37.04,Default,Subaru,0,0,0,,Nie wiem, co to znaczy! Za kogo ty mnie—
Dialogue: 0,0:19:36.27,0:19:37.88,Default,Roswaal,0,0,0,,{\an8}Oczekuję, że będziesz miał
Dialogue: 0,0:19:37.97,0:19:40.31,Default,Roswaal,0,0,0,,chęć realizacji celu,
Dialogue: 0,0:19:40.40,0:19:43.07,Default,Roswaal,0,0,0,,nawet jeśli oznacza to podeptanie woli\NEmilii.
Dialogue: 0,0:19:43.32,0:19:44.27,Default,Roswaal,0,0,0,,Rozumiesz?
Dialogue: 0,0:19:44.74,0:19:48.84,Default,Roswaal,0,0,0,,Jeśli naprawdę robisz to wszystko dla\NEmilii,
Dialogue: 0,0:19:48.93,0:19:51.87,Default,Roswaal,0,0,0,,musisz zignorować to, czego chce\NEmilia.
Dialogue: 0,0:19:52.07,0:19:54.48,Default,Roswaal,0,0,0,,Dziecko marzące o dziecinnym raju
Dialogue: 0,0:19:54.57,0:19:58.29,Default,Roswaal,0,0,0,,nie ma dość determinacji, by przejść\Nprzez wybrane przez ciebie piekło.
Dialogue: 0,0:19:58.38,0:20:00.79,Default,Subaru,0,0,0,,To całkowicie odwrotnie, prawda?!
Dialogue: 0,0:20:00.88,0:20:02.12,Default,Subaru,0,0,0,,Jeśli to dla Emilii—
Dialogue: 0,0:20:02.21,0:20:03.72,Default,Roswaal,0,0,0,,Jest życie.
Dialogue: 0,0:20:04.60,0:20:06.99,Default,Roswaal,0,0,0,,Dopóki istnieje życie,\Nistnieje przyszłość.
Dialogue: 0,0:20:07.08,0:20:09.32,Default,Roswaal,0,0,0,,Dopóki jest przyszłość, jest nadzieja.
Dialogue: 0,0:20:09.41,0:20:12.33,Default,Roswaal,0,0,0,,Dopóki jest nadzieja,\Njest możliwość.
Dialogue: 0,0:20:12.42,0:20:15.63,Default,Roswaal,0,0,0,,Dopóki istnieje możliwość,\Nludzie mogą być uratowani.
Dialogue: 0,0:20:15.72,0:20:16.79,Default,Roswaal,0,0,0,,Czy ja się mylę?
Dialogue: 0,0:20:23.22,0:20:26.07,Default,Roswaal,0,0,0,,Widzę, że nie masz nic do powiedzenia.
Dialogue: 0,0:20:26.81,0:20:31.54,Default,Roswaal,0,0,0,,Ile razy jeszcze musisz mnie rozczarować?
Dialogue: 0,0:20:31.85,0:20:35.67,Default,Roswaal,0,0,0,,W takim razie, podczas gdy pracujesz\Nnad wyostrzeniem swojej determinacji,
Dialogue: 0,0:20:35.76,0:20:38.39,Default,Roswaal,0,0,0,,pozwól, że poruszę jeszcze jedną sprawę.
Dialogue: 0,0:20:40.44,0:20:45.83,Default,Roswaal,0,0,0,,Wierzę, że stawiłeś czoła\Nwielu problemom w Sanktuarium,
Dialogue: 0,0:20:45.92,0:20:48.89,Default,Roswaal,0,0,0,,Ale te problemy nie ograniczają\Nsię tylko do Sanktuarium.
Dialogue: 0,0:20:49.99,0:20:52.90,Default,Subaru,0,0,0,,Masz na myśli rezydencję? Wiesz o—
Dialogue: 0,0:20:52.99,0:20:54.19,Default,Roswaal,0,0,0,,Oczywiście.
Dialogue: 0,0:20:58.89,0:21:02.40,Default,Roswaal,0,0,0,,Rozkaz, by zabójcy\Nzaatakowali rezydencję...
Dialogue: 0,0:21:03.93,0:21:08.00,Default,Roswaal,0,0,0,,w końcu wydałem osobiście.
Dialogue: 0,0:21:16.20,0:21:20.22,Default,Subaru,0,0,0,,Czekaj... Czekaj. Chwileczkę.
Dialogue: 0,0:21:21.72,0:21:23.10,Default,Subaru,0,0,0,,To ty?
Dialogue: 0,0:21:23.19,0:21:25.33,Default,Roswaal,0,0,0,,Wysłałem zabójców do rezydencji
Dialogue: 0,0:21:25.84,0:21:28.25,Default,Roswaal,0,0,0,,żeby pomóc wyostrzyć twoją determinację.
Dialogue: 0,0:21:28.34,0:21:29.30,Default,Subaru,0,0,0,,Moja determinacja?
Dialogue: 0,0:21:29.56,0:21:33.97,Default,Roswaal,0,0,0,,Nawet ze swoim Autorytetem nie możesz\Nocalić obu stron.
Dialogue: 0,0:21:34.68,0:21:38.05,Default,Roswaal,0,0,0,,Musisz zdecydować, co jest\Ndla ciebie ważniejsze.
Dialogue: 0,0:21:38.14,0:21:41.27,Default,Roswaal,0,0,0,,Kiedy raz dokonasz wyboru, nigdy nie\Nbędziesz mógł go cofnąć.
Dialogue: 0,0:21:41.54,0:21:43.81,Default,Roswaal,0,0,0,,W końcu osiągniesz doskonałość...
Dialogue: 0,0:21:43.90,0:21:46.99,Default,Roswaal,0,0,0,,jako istota zdolna ocalić tylko jedną\Nosobę i nikogo więcej.
Dialogue: 0,0:21:51.20,0:21:53.36,Default,Subaru,0,0,0,,Jesteś naprawdę szalony.
Dialogue: 0,0:21:53.45,0:21:57.39,Default,Roswaal,0,0,0,,Owszem. Od dawna jestem szalony.
Dialogue: 0,0:21:57.48,0:22:00.82,Default,Roswaal,0,0,0,,Od chwili, gdy czterysta lat temu\Noczarowały mnie te oczy,
Dialogue: 0,0:22:00.91,0:22:03.42,Default,Roswaal,0,0,0,,jestem szalony.
Dialogue: 0,0:22:04.04,0:22:05.88,Default,Subaru,0,0,0,,Czterysta lat temu?
Dialogue: 0,0:22:06.13,0:22:11.27,Default,Roswaal,0,0,0,,Natsuki Subaru, dlaczego jeszcze nie\Noszalałeś?
Dialogue: 0,0:22:11.36,0:22:14.21,Default,Roswaal,0,0,0,,By pokonać sytuacje, którym\Nsprosta tylko szaleniec,
Dialogue: 0,0:22:14.30,0:22:16.10,Default,Roswaal,0,0,0,,i kroczyć drogą samotności,
Dialogue: 0,0:22:16.19,0:22:18.10,Default,Roswaal,0,0,0,,Serce człowieka jest tylko przeszkodą.
Dialogue: 0,0:22:19.16,0:22:23.09,Default,Roswaal,0,0,0,,Dlatego ci to narzucę.
Dialogue: 0,0:22:28.48,0:22:29.61,Default,Roswaal,0,0,0,,Co...
Dialogue: 0,0:22:30.46,0:22:32.01,Default,Roswaal,0,0,0,,próbujesz zrobić?
Dialogue: 0,0:22:34.55,0:22:35.58,Default,Subaru,0,0,0,,Czekaj...
Dialogue: 0,0:22:36.60,0:22:39.41,Default,Subaru,0,0,0,,Proszę. Proszę, wybacz mi.
Dialogue: 0,0:22:39.50,0:22:42.32,Default,Subaru,0,0,0,,To była... To była moja wina... więc...
Dialogue: 0,0:22:42.41,0:22:45.32,Default,Roswaal,0,0,0,,Podnieś głowę, Subaru.
Dialogue: 0,0:22:45.41,0:22:47.47,Default,Roswaal,0,0,0,,To nie twoja wi—
Dialogue: 0,0:22:46.78,0:22:48.17,Default,Subaru,0,0,0,,{\an8}Mylisz się!
Dialogue: 0,0:22:48.26,0:22:50.81,Default,Subaru,0,0,0,,Chcę zrobić to,\Nco powiedziałeś, ale nie mogę.
Dialogue: 0,0:22:50.90,0:22:52.99,Default,Subaru,0,0,0,,Straciłem uprawnienia do podjęcia próby.
Dialogue: 0,0:22:53.08,0:22:53.96,Default,Roswaal,0,0,0,,Co?
Dialogue: 0,0:22:54.47,0:22:58.16,Default,Subaru,0,0,0,,Proszę! Nasłanie zabójców na rezydencję\Nnic nie da!
Dialogue: 0,0:22:58.25,0:23:00.19,Default,Subaru,0,0,0,,Nieważne, kto umrze, to nie...
Dialogue: 0,0:23:00.69,0:23:02.38,Default,Subaru,0,0,0,,Więc proszę...
Dialogue: 0,0:23:04.19,0:23:05.72,Default,Roswaal,0,0,0,,Nie, odmawiam.
Dialogue: 0,0:23:06.93,0:23:09.98,Default,Roswaal,0,0,0,,Właściwie teraz widzę jeszcze większą\Npotrzebę, by to zrobić.
Dialogue: 0,0:23:10.28,0:23:15.66,Default,Roswaal,0,0,0,,Jeśli naprawdę tego pragniesz, Echidna\Nna pewno przywróci ci kwalifikacje.
Dialogue: 0,0:23:15.75,0:23:18.50,Default,Roswaal,0,0,0,,Taka jest natura jej chciwej osobowości.
Dialogue: 0,0:23:18.59,0:23:21.62,Default,Roswaal,0,0,0,,Możesz odzyskać uprawnienia. Możesz to\Nnaprawić.
Dialogue: 0,0:23:22.25,0:23:24.88,Default,Roswaal,0,0,0,,Dlatego moje działania się nie zmienią.
Dialogue: 0,0:23:25.44,0:23:28.99,Default,Roswaal,0,0,0,,Będę nadal przypierać cię do muru, żeby\Nwyostrzyć twoją determinację...
Dialogue: 0,0:23:29.08,0:23:31.55,Default,Roswaal,0,0,0,,aż osiągniesz doskonałość.
Dialogue: 0,0:23:33.31,0:23:35.35,Default,Roswaal,0,0,0,,Nie bądź zarozumiały, Natsuki Subaru.
Dialogue: 0,0:23:35.99,0:23:39.81,Default,Roswaal,0,0,0,,Nie tylko ty rozumiesz Echidnę!
Dialogue: 0,0:23:41.83,0:23:45.69,Default,Subaru,0,0,0,,Jeśli... jeśli mnie nienawidzisz, skieruj\Ncałą nienawiść tylko na mnie...
Dialogue: 0,0:23:45.88,0:23:47.74,Default,Roswaal,0,0,0,,Nienawidzić ciebie?
Dialogue: 0,0:23:50.37,0:23:53.74,Default,Roswaal,0,0,0,,Nigdy bym cię nie znienawidził.
Dialogue: 0,0:23:53.83,0:23:55.70,Default,Roswaal,0,0,0,,Jesteś moją nadzieją.
Dialogue: 0,0:23:55.99,0:23:59.09,Default,Roswaal,0,0,0,,Jedynymi osobami, dzięki którym odczuwam\Njakąkolwiek nadzieję,
Dialogue: 0,0:23:59.18,0:24:01.30,Default,Roswaal,0,0,0,,jesteście ty i Ram.
Dialogue: 0,0:24:02.06,0:24:04.54,Default,Roswaal,0,0,0,,Z głębi serca,
Dialogue: 0,0:24:04.85,0:24:06.25,Default,Roswaal,0,0,0,,Wierzę w ciebie.
Dialogue: 0,0:24:16.61,0:24:17.49,Default,Subaru,0,0,0,,Ja...
Dialogue: 0,0:24:19.40,0:24:22.73,Default,Subaru,0,0,0,,Ja... nigdy nie będę taki jak ty.
Dialogue: 0,0:24:24.89,0:24:26.67,Default,Subaru,0,0,0,,Jestem człowiekiem.
Dialogue: 0,0:24:27.70,0:24:29.98,Default,Subaru,0,0,0,,Zawsze będę... człowiekiem.
Dialogue: 0,0:24:45.85,0:24:48.72,Default,Subaru,0,0,0,,Cholera! Cholera!
Dialogue: 0,0:24:59.88,0:25:01.21,Default,Subaru,0,0,0,,Co mam zrobić?
Dialogue: 0,0:25:02.86,0:25:04.56,Default,Subaru,0,0,0,,Co mam zrobić?
Dialogue: 0,0:25:05.07,0:25:07.52,Default,Subaru,0,0,0,,Co mam zrobić? Co mam zrobić?
Dialogue: 0,0:25:07.98,0:25:09.77,Default,Subaru,0,0,0,,Co mam zrobić? Co mam zrobić?
Dialogue: 0,0:25:09.86,0:25:11.89,Default,Subaru,0,0,0,,Co robić? Co robić? Co robić?
Dialogue: 0,0:25:11.98,0:25:14.07,Default,Subaru,0,0,0,,Co robić? Co robić? Co robić?
Dialogue: 0,0:25:14.16,0:25:15.82,Default,Subaru,0,0,0,,Co robić?! Co robić?! Co robić?!
Dialogue: 0,0:25:15.91,0:25:18.91,Default,Otto,0,0,0,,Chcesz, żebym ci powiedział,\Nco powinieneś zrobić?
Dialogue: 0,0:25:25.49,0:25:26.59,Default,Subaru,0,0,0,,Otto?
Dialogue: 0,0:25:27.26,0:25:28.79,Default,Otto,0,0,0,,Tak, witaj.
Dialogue: 0,0:25:29.26,0:25:30.86,Default,Otto,0,0,0,,Dzień dobry.
Dialogue: 0,0:25:31.41,0:25:33.34,Default,Otto,0,0,0,,Zgadza się. To ja.
Dialogue: 0,0:25:33.64,0:25:34.75,Default,Subaru,0,0,0,,Dob...
Dialogue: 0,0:25:38.18,0:25:39.84,Default,Subaru,0,0,0,,Co ty tu robisz?
Dialogue: 0,0:25:39.93,0:25:42.22,Default,Otto,0,0,0,,Na razie odłóżmy to na bok.
Dialogue: 0,0:25:42.31,0:25:44.47,Default,Otto,0,0,0,,Musimy najpierw porozmawiać o tobie.
Dialogue: 0,0:25:44.56,0:25:48.10,Default,Otto,0,0,0,,Majaczyłeś pod nosem z miną człowieka\Nbliskiego śmierci.
Dialogue: 0,0:25:48.19,0:25:49.42,Default,Subaru,0,0,0,,Majaczyłem?
Dialogue: 0,0:25:49.51,0:25:50.39,Default,Otto,0,0,0,,Tak.
Dialogue: 0,0:25:50.84,0:25:51.92,Default,Subaru,0,0,0,,Rozumiem.
Dialogue: 0,0:25:54.47,0:25:58.68,Default,Subaru,0,0,0,,Zawsze mnie znajdujesz w najdziwniejszych\Nchwilach.
Dialogue: 0,0:25:58.77,0:26:01.27,Default,Otto,0,0,0,,Kupiec musi umieć szybko myśleć.
Dialogue: 0,0:26:01.36,0:26:04.47,Default,Subaru,0,0,0,,Przepraszam, ale nie mam czasu z tobą\Nżartować.
Dialogue: 0,0:26:04.56,0:26:06.03,Default,Subaru,0,0,0,,Muszę pomyśleć, więc teraz—
Dialogue: 0,0:26:06.12,0:26:07.93,Default,Otto,0,0,0,,Byłeś u kresu wytrzymałości, prawda?
Dialogue: 0,0:26:08.02,0:26:10.45,Default,Otto,0,0,0,,A ty chcesz wiedzieć,\Nco powinieneś zrobić?
Dialogue: 0,0:26:10.97,0:26:12.34,Default,Otto,0,0,0,,Zostaw to mnie.
Dialogue: 0,0:26:12.84,0:26:14.46,Default,Subaru,0,0,0,,Co mam ci zostawić?
Dialogue: 0,0:26:14.68,0:26:17.62,Default,Otto,0,0,0,,Posłuchaj. To wymaga przygotowania.
Dialogue: 0,0:26:17.71,0:26:18.63,Default,Subaru,0,0,0,,Przygotowanie?
Dialogue: 0,0:26:18.72,0:26:22.73,Default,Otto,0,0,0,,Tak. Najpierw weź długi, głęboki oddech.
Dialogue: 0,0:26:23.39,0:26:24.27,Default,Subaru,0,0,0,,Hę?
Dialogue: 0,0:26:24.36,0:26:25.62,Default,Otto,0,0,0,,Szybko.
Dialogue: 0,0:26:42.03,0:26:43.45,Default,Otto,0,0,0,,Przestań
Dialogue: 0,0:26:44.01,0:26:46.41,Default,Otto,0,0,0,,udawać twardziela przed przyjaciółmi,
Dialogue: 0,0:26:46.70,0:26:48.07,Default,Otto,0,0,0,,Natsuki Subaru!
Dialogue: 0,0:26:48.16,0:26:55.16,Default,,0,0,0,,
