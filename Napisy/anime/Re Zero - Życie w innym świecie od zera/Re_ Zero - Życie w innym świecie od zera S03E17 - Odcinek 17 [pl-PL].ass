Dialogue: 0,0:00:10.60,0:00:11.55,Default,Puck,0,0,0,,Przepraszam.
Dialogue: 0,0:00:12.53,0:00:13.48,Default,,0,0,0,,Przepraszam.
Dialogue: 0,0:00:15.47,0:00:18.11,Default,Emilia,0,0,0,,Dlaczego płaczesz?
Dialogue: 0,0:00:19.34,0:00:22.19,Default,Puck,0,0,0,,Bo zostawiłem cię samą...
Dialogue: 0,0:00:23.06,0:00:25.50,Default,Emilia,0,0,0,,Naprawdę?
Dialogue: 0,0:00:26.50,0:00:31.95,Default,Puck,0,0,0,,Bo nie mogłem cię znaleźć\Nprzez cały ten czas...
Dialogue: 0,0:00:33.28,0:00:36.23,Default,Emilia,0,0,0,,Ale... jestem tutaj.
Dialogue: 0,0:00:39.87,0:00:42.27,Default,Emilia,0,0,0,,Jak się nazywasz?
Dialogue: 0,0:00:44.38,0:00:47.91,Default,Puck,0,0,0,,Nazywam się...
Dialogue: 0,0:01:08.72,0:01:10.88,Default,Emilia,0,0,0,,Wiem, że to tylko świat snu.
Dialogue: 0,0:01:11.17,0:01:14.68,Default,Emilia,0,0,0,,Ale czuję zapach wiatru i ziemię pod\Nstopami.
Dialogue: 0,0:01:14.77,0:01:16.71,Default,Emilia,0,0,0,,To takie dziwne, prawda?
Dialogue: 0,0:01:17.57,0:01:20.10,Default,Emilia,0,0,0,,Echidna? Słuchasz mnie?
Dialogue: 0,0:01:24.64,0:01:26.51,Default,Emilia,0,0,0,,Przepraszam, wszystko w porządku?
Dialogue: 0,0:01:26.60,0:01:28.80,Default,Emilia,0,0,0,,Szłam za szybko?
Dialogue: 0,0:01:28.89,0:01:30.57,Default,Echidna,0,0,0,,Myślałaś, że jawne współczucie
Dialogue: 0,0:01:30.66,0:01:33.36,Default,,0,0,0,,choć odrobinę zmieni moje nastawienie?
Dialogue: 0,0:01:33.73,0:01:35.24,Default,Echidna,0,0,0,,Jesteś całkiem głupia.
Dialogue: 0,0:01:36.19,0:01:38.77,Default,Emilia,0,0,0,,Proszę, martwiłam się o ciebie.
Dialogue: 0,0:01:38.86,0:01:41.59,Default,Echidna,0,0,0,,W ogóle nie potrzebuję twojej troski.
Dialogue: 0,0:01:41.68,0:01:45.09,Default,Echidna,0,0,0,,Po prostu zbyt wiele snów nakładało się na\Nsiebie naraz.
Dialogue: 0,0:01:45.18,0:01:46.91,Default,Echidna,0,0,0,,Wkrótce samo się dostosuje.
Dialogue: 0,0:01:47.23,0:01:48.43,Default,Echidna,0,0,0,,Właśnie tak.
Dialogue: 0,0:01:49.12,0:01:50.00,Default,Echidna,0,0,0,,Widzisz?!
Dialogue: 0,0:01:50.90,0:01:54.63,Default,Echidna,0,0,0,,„Świat snu” to tylko\Nobrazowe wyrażenie.
Dialogue: 0,0:01:54.96,0:01:58.53,Default,Echidna,0,0,0,,Dokładniej mówiąc, to oddzielny\Nświat, który odtwarza wspomnienia.
Dialogue: 0,0:01:58.62,0:02:02.10,Default,Echidna,0,0,0,,Odzwierciedla też świadomość tych, którzy\Nprzechodzą próbę.
Dialogue: 0,0:02:02.52,0:02:06.78,Default,Emilia,0,0,0,,Dziękuję, że tak jasno mi to wyjaśniłaś,\Nchoć mnie nienawidzisz.
Dialogue: 0,0:02:06.87,0:02:11.90,Default,Echidna,0,0,0,,Tylko nie wyobrażaj sobie, że naprawdę\Njestem bardzo miłą osobą.
Dialogue: 0,0:02:11.99,0:02:15.64,Default,Echidna,0,0,0,,Po prostu z natury odpowiadam na każde\Nzadane mi pytanie.
Dialogue: 0,0:02:16.02,0:02:17.17,Default,Emilia,0,0,0,,Tak, oczywiście.
Dialogue: 0,0:02:19.77,0:02:24.09,Default,Echidna,0,0,0,,Pamiętasz, jak żałośnie zmagałaś się, gdy\Nostatnio podjęłaś próbę?
Dialogue: 0,0:02:24.66,0:02:29.17,Default,Emilia,0,0,0,,Byłam tak bezradna, że nawet nie mogę\Nzaprzeczyć temu złośliwemu opisowi.
Dialogue: 0,0:02:29.57,0:02:33.32,Default,Emilia,0,0,0,,Musiałam ukryć wspomnienia,\Nbo nie chciałam ich widzieć.
Dialogue: 0,0:02:33.41,0:02:37.14,Default,Emilia,0,0,0,,Dlatego nie mogę ich sobie przypomnieć.
Dialogue: 0,0:02:37.99,0:02:39.18,Default,Emilia,0,0,0,,I nawet teraz,
Dialogue: 0,0:02:39.82,0:02:43.10,Default,,0,0,0,,Wciąż nie jestem gotowa.
Dialogue: 0,0:02:43.33,0:02:46.65,Default,Echidna,0,0,0,,Więc nikogo nie zdziwi, jeśli znowu\Nponiesiesz porażkę?
Dialogue: 0,0:02:46.74,0:02:50.27,Default,Echidna,0,0,0,,Szukanie wymówki przed startem\Njest strasznie defetystyczne.
Dialogue: 0,0:02:50.36,0:02:52.31,Default,Emilia,0,0,0,,Nie, nie o to chodzi.
Dialogue: 0,0:02:52.66,0:02:56.31,Default,Emilia,0,0,0,,Przygotuję się właśnie teraz.
Dialogue: 0,0:02:59.72,0:03:03.03,Default,Echidna,0,0,0,,To nie jest zwykłe drzewo, prawda?
Dialogue: 0,0:03:03.12,0:03:06.82,Default,Echidna,0,0,0,,Było coś, co za wszelką cenę chciałaś\Nzamknąć w tym drzewie.
Dialogue: 0,0:03:06.91,0:03:08.50,Default,Emilia,0,0,0,,To pokój księżniczki.
Dialogue: 0,0:03:09.29,0:03:12.39,Default,Emilia,0,0,0,,Kiedy byłam mała, często przysyłano mnie\Ntu, żebym się bawiła.
Dialogue: 0,0:03:12.48,0:03:15.09,Default,Emilia,0,0,0,,No tak... nie mogę dotknąć drzwi.
Dialogue: 0,0:03:15.34,0:03:17.37,Default,Emilia,0,0,0,,Możemy po prostu przez nie przejść?
Dialogue: 0,0:03:39.41,0:03:41.48,Default,Echidna,0,0,0,,Ta mała dziewczynka to ty, prawda?
Dialogue: 0,0:03:41.97,0:03:43.78,Default,Echidna,0,0,0,,Choć jeszcze nic nie wiedziałaś,
Dialogue: 0,0:03:44.10,0:03:46.52,Default,Echidna,0,0,0,,wyglądasz irytująco beztrosko.
Dialogue: 0,0:03:46.61,0:03:49.05,Default,Emilia,0,0,0,,Musisz narzekać nawet na moją młodszą\Nwersję?
Dialogue: 0,0:03:49.81,0:03:51.70,Default,Emilia,0,0,0,,Poza tym, teraz ja...
Dialogue: 0,0:04:01.63,0:04:03.24,Default,Emilia,0,0,0,,Matka Fortuna...
Dialogue: 0,0:04:04.66,0:04:07.80,Default,Fortuna,0,0,0,,Emilio, muszę się\Nzająć czymś ważnym.
Dialogue: 0,0:04:08.18,0:04:10.64,Default,Fortuna,0,0,0,,Zostań więc w tym pokoju i bądź grzeczna,\Ndobrze?
Dialogue: 0,0:04:10.77,0:04:12.91,Default,Emilia,0,0,0,,Znowu coś ważnego?
Dialogue: 0,0:04:15.73,0:04:18.32,Default,Fortuna,0,0,0,,Masz srebrne włosy mojego brata...
Dialogue: 0,0:04:18.78,0:04:22.41,Default,Fortuna,0,0,0,,Ale twoje łagodne cechy\Npochodzą od twojej matki.
Dialogue: 0,0:04:22.50,0:04:24.55,Default,Fortuna,0,0,0,,W rodzinie mamy groźne spojrzenie.
Dialogue: 0,0:04:25.31,0:04:28.16,Default,Emilia,0,0,0,,Lubię twoje oczy, Matko Fortuno!
Dialogue: 0,0:04:28.74,0:04:31.90,Default,Emilia,0,0,0,,Matka Fortuna była młodszą\Nsiostrą mojego ojca.
Dialogue: 0,0:04:32.31,0:04:36.17,Default,Emilia,0,0,0,,Moi prawdziwi rodzice byli zbyt\Nzajęci, by spędzać ze mną czas.
Dialogue: 0,0:04:36.75,0:04:39.82,Default,Emilia,0,0,0,,Zostałam pod opieką Matki Fortuny.
Dialogue: 0,0:04:49.82,0:04:51.43,Default,Emilia,0,0,0,,Jestem taka znudzona!
Dialogue: 0,0:04:51.84,0:04:55.89,Default,Emilia,0,0,0,,A mama zawsze mówi, że kłamstwo i\Nskrywanie tajemnic są złe!
Dialogue: 0,0:04:55.98,0:04:57.12,Default,Emilia,0,0,0,,Prawda?!
Dialogue: 0,0:04:58.28,0:05:00.40,Default,Emilia,0,0,0,,Chciałabym wyjść na zewnątrz.
Dialogue: 0,0:05:06.95,0:05:08.30,Default,Emilia,0,0,0,,Wróżka?
Dialogue: 0,0:05:10.88,0:05:12.70,Default,Emilia,0,0,0,,Hej, tak nie wolno! Zaczekaj!
Dialogue: 0,0:05:30.18,0:05:33.59,Default,Emilia,0,0,0,,Matka Fortuna i wszyscy inni\Ntrzymają przed mną tajemnice.
Dialogue: 0,0:05:33.68,0:05:34.81,Default,Emilia,0,0,0,,Więc jesteśmy kwita!
Dialogue: 0,0:05:42.40,0:05:43.55,Default,Emilia,0,0,0,,Skradam się, skradam...
Dialogue: 0,0:05:46.15,0:05:47.03,Default,Emilia,0,0,0,,Skradam się...
Dialogue: 0,0:05:57.59,0:06:01.54,Default,Fortuna,0,0,0,,Wszyscy tak wiele dla nas zrobiliście.
Dialogue: 0,0:06:01.63,0:06:06.14,Default,Geuse,0,0,0,,A my przysporzyliśmy wam tylu kłopotów.
Dialogue: 0,0:06:06.23,0:06:08.34,Default,Fortuna,0,0,0,,To dotyczy nas obojga.
Dialogue: 0,0:06:08.43,0:06:09.31,Default,Fortuna,0,0,0,,Geuse.
Dialogue: 0,0:06:11.28,0:06:12.26,Default,Geuse,0,0,0,,I jeszcze...
Dialogue: 0,0:06:12.64,0:06:15.39,Default,Geuse,0,0,0,,Wiem, że pytam o to za każdym razem, gdy\Nsię spotykamy,
Dialogue: 0,0:06:15.94,0:06:17.73,Default,Geuse,0,0,0,,Ale czy pieczęć jest nienaruszona?
Dialogue: 0,0:06:18.11,0:06:20.36,Default,Fortuna,0,0,0,,Nic się nie zmieniło.
Dialogue: 0,0:06:20.80,0:06:22.39,Default,Fortuna,0,0,0,,Jeśli stanie się najgorsze,
Dialogue: 0,0:06:22.48,0:06:25.52,Default,,0,0,0,,nie mogłabym spojrzeć w oczy bratu i\Nsiostrze.
Dialogue: 0,0:06:26.07,0:06:28.45,Default,Geuse,0,0,0,,Masz na myśli twojego\Nbrata... i jego żonę?
Dialogue: 0,0:06:28.82,0:06:31.09,Default,Fortuna,0,0,0,,W porządku. Wiem.
Dialogue: 0,0:06:31.57,0:06:36.83,Default,Fortuna,0,0,0,,Ale nigdy nie zapomnę o ciężarze\Nodpowiedzialności, którą niosę.
Dialogue: 0,0:06:36.92,0:06:39.77,Default,Fortuna,0,0,0,,Nie chcę jej porzucić ani pozostawić\Nniedokończonej.
Dialogue: 0,0:06:40.34,0:06:41.79,Default,Fortuna,0,0,0,,Czy z tobą nie jest tak samo?
Dialogue: 0,0:06:42.10,0:06:43.15,Default,Geuse,0,0,0,,Ja...
Dialogue: 0,0:06:44.76,0:06:47.42,Default,Geuse,0,0,0,,W końcu nie mam nic innego.
Dialogue: 0,0:06:48.02,0:06:51.84,Default,Geuse,0,0,0,,To chyba inne poczucie\Nodpowiedzialności od twojego.
Dialogue: 0,0:06:52.43,0:06:54.15,Default,Geuse,0,0,0,,Obsesja, żal...
Dialogue: 0,0:06:54.93,0:06:58.28,Default,Geuse,0,0,0,,Trzymam się tylko rzeczy, które\Nrównie dobrze mogą być złudzeniami.
Dialogue: 0,0:07:01.63,0:07:03.16,Default,Fortuna,0,0,0,,Dzięki duchom,
Dialogue: 0,0:07:03.25,0:07:06.19,Default,,0,0,0,,w lesie pory roku niewiele się zmieniają,
Dialogue: 0,0:07:06.28,0:07:09.08,Default,Fortuna,0,0,0,,ale nadal przynosisz nam ubrania, książki\Ni inne rzeczy.
Dialogue: 0,0:07:09.45,0:07:10.86,Default,Fortuna,0,0,0,,Naprawdę to doceniamy.
Dialogue: 0,0:07:12.39,0:07:13.87,Default,Fortuna,0,0,0,,Dziękuję, jak zawsze.
Dialogue: 0,0:07:15.42,0:07:17.80,Default,Geuse,0,0,0,,W rzeczywistości, to złe\Nzmuszać was wszystkich
Dialogue: 0,0:07:17.89,0:07:21.87,Default,,0,0,0,,do życia w takich niedogodnościach i w\Ntakim miejscu.
Dialogue: 0,0:07:22.45,0:07:24.91,Default,Fortuna,0,0,0,,Nie nazywaj tego "takim miejscem".
Dialogue: 0,0:07:25.28,0:07:27.67,Default,Fortuna,0,0,0,,Kochamy ten las.
Dialogue: 0,0:07:28.34,0:07:29.47,Default,Archi,0,0,0,,Fortuna!
Dialogue: 0,0:07:30.61,0:07:32.71,Default,Archi,0,0,0,,Wszystkie przedmioty zostały przeniesione.
Dialogue: 0,0:07:33.14,0:07:34.75,Default,Fortuna,0,0,0,,Dziękuję, Archi.
Dialogue: 0,0:07:35.22,0:07:38.35,Default,Geuse,0,0,0,,Ty też stałeś się bardziej\Ngodny zaufania, Archi.
Dialogue: 0,0:07:38.59,0:07:41.14,Default,Archi,0,0,0,,Jako część następnego\Npokolenia mieszkańców lasów,
Dialogue: 0,0:07:41.23,0:07:43.60,Default,,0,0,0,,Nie mogę być uważany za\Nnowicjusza na zawsze.
Dialogue: 0,0:07:44.41,0:07:46.36,Default,Geuse,0,0,0,,Obyś nadal cieszył się zdrowiem.
Dialogue: 0,0:07:46.79,0:07:48.34,Default,Geuse,0,0,0,,Dla lasu i pieczęci,
Dialogue: 0,0:07:49.03,0:07:51.26,Default,Geuse,0,0,0,,dla swojej rodziny i dla siebie.
Dialogue: 0,0:07:58.32,0:08:01.12,Default,Geuse,0,0,0,,Jeszcze jedno.
Dialogue: 0,0:08:01.89,0:08:04.25,Default,Geuse,0,0,0,,Czy Emilia jest zdrowa?
Dialogue: 0,0:08:05.78,0:08:07.30,Default,Fortuna,0,0,0,,Nie martw się.
Dialogue: 0,0:08:07.39,0:08:10.88,Default,Fortuna,0,0,0,,Emilia staje się bardzo dobrą,\Nbardzo zdrową dziewczyną.
Dialogue: 0,0:08:11.41,0:08:12.62,Default,Fortuna,0,0,0,,Ale... przepraszam.
Dialogue: 0,0:08:13.02,0:08:14.68,Default,,0,0,0,,Nie mogę pozwolić jej cię poznać.
Dialogue: 0,0:08:15.05,0:08:16.16,Default,Geuse,0,0,0,,Nie ma sprawy.
Dialogue: 0,0:08:16.52,0:08:20.67,Default,Geuse,0,0,0,,Wystarczy, że Emilia\Nwyrośnie zdrowa.
Dialogue: 0,0:08:21.09,0:08:25.74,Default,Geuse,0,0,0,,Grzesznik taki jak ja nie\Nodważyłby się prosić o więcej.
Dialogue: 0,0:08:28.23,0:08:31.09,Default,Black,0,0,0,,Biskupie Romanée-Conti, jesteś gotowy?
Dialogue: 0,0:08:31.18,0:08:32.78,Default,Geuse,0,0,0,,Tak, skończyłem.
Dialogue: 0,0:08:33.19,0:08:35.97,Default,,0,0,0,,Wyruszajmy więc, my grzesznicy.
Dialogue: 0,0:08:36.69,0:08:39.62,Default,Geuse,0,0,0,,Obyśmy się wkrótce spotkali, Fortuna.
Dialogue: 0,0:08:40.42,0:08:42.47,Default,Fortuna,0,0,0,,Nawet jeśli nikt inny tego nie powie,
Dialogue: 0,0:08:42.56,0:08:44.93,Default,,0,0,0,,Jesteśmy wam wdzięczni.
Dialogue: 0,0:08:45.32,0:08:47.08,Default,Fortuna,0,0,0,,Naprawdę.
Dialogue: 0,0:08:47.51,0:08:53.50,Default,Geuse,0,0,0,,Twoje słowa wystarczą mi, by przetrwać\Nnawet sto lat zamętu.
Dialogue: 0,0:09:05.42,0:09:07.60,Default,Archi,0,0,0,,Fortuna, jesteś zmęczona?
Dialogue: 0,0:09:08.03,0:09:10.79,Default,Fortuna,0,0,0,,Nie traktuj mnie jak jakiejś staruszki.
Dialogue: 0,0:09:11.06,0:09:14.44,Default,Fortuna,0,0,0,,Wiem, że przy takim młodzieńcu jak ty\Njestem już stara,
Dialogue: 0,0:09:14.53,0:09:15.82,Default,Fortuna,0,0,0,,Jestem w dobrej formie!
Dialogue: 0,0:09:16.08,0:09:18.63,Default,Archi,0,0,0,,To nie to miałem na myśli!
Dialogue: 0,0:09:18.72,0:09:22.92,Default,Archi,0,0,0,,Pomyślałem tylko, że musi ci być ciężko,\Ngdy odpowiadasz też za mieszkańców lasu...
Dialogue: 0,0:09:23.09,0:09:25.79,Default,Fortuna,0,0,0,,Więc może skorzystam z\Ntwojej życzliwości...
Dialogue: 0,0:09:26.37,0:09:28.10,Default,Fortuna,0,0,0,,i powierzę ci resztę.
Dialogue: 0,0:09:28.56,0:09:33.22,Default,Fortuna,0,0,0,,Muszę uwolnić pewną małą księżniczkę,\Nktóra pewnie bardzo się nudzi.
Dialogue: 0,0:09:35.24,0:09:37.99,Default,Emilia,0,0,0,,Co mam robić? Co mam robić? Co mam robić?\NCo mam robić?
Dialogue: 0,0:09:38.08,0:09:39.45,Default,Emilia,0,0,0,,Co mam robić? Co mam—
Dialogue: 0,0:09:40.41,0:09:41.96,Default,Emilia,0,0,0,,Co mam robić? Co mam robić? Co—
Dialogue: 0,0:09:42.32,0:09:43.67,Default,Emilia,0,0,0,,Co mam robić? Co mam robić?
Dialogue: 0,0:09:45.01,0:09:47.06,Default,Emilia,0,0,0,,Co mam robić? Co mam robić? Co mam robić?
Dialogue: 0,0:09:54.23,0:09:55.65,Default,Emilia,0,0,0,,Wow...
Dialogue: 0,0:09:56.02,0:09:57.72,Default,Fortuna,0,0,0,,Emilio, nie śpisz?
Dialogue: 0,0:09:57.81,0:09:58.72,Default,Emilia,0,0,0,,Aa!
Dialogue: 0,0:09:58.81,0:10:00.48,Default,Emilia,0,0,0,,N-Nie śpię!
Dialogue: 0,0:10:00.92,0:10:02.21,Default,Emilia,0,0,0,,Ale...
Dialogue: 0,0:10:02.30,0:10:03.35,Default,Fortuna,0,0,0,,Co?
Dialogue: 0,0:10:03.44,0:10:05.25,Default,Fortuna,0,0,0,,Dlaczego jesteś taka zdenerwowana?
Dialogue: 0,0:10:08.19,0:10:11.20,Default,Emilia,0,0,0,,Przepraszam.
Dialogue: 0,0:10:11.29,0:10:14.37,Default,Emilia,0,0,0,,Rozlałam mnóstwo atramentu do rysowania.
Dialogue: 0,0:10:14.91,0:10:16.32,Default,Fortuna,0,0,0,,Ojej...
Dialogue: 0,0:10:16.41,0:10:19.03,Default,Emilia,0,0,0,,Matko Fortuna, ja...
Dialogue: 0,0:10:19.12,0:10:21.93,Default,Fortuna,0,0,0,,Szczerze mówiąc, martwisz\Nsię za dużo, Emilio.
Dialogue: 0,0:10:22.51,0:10:25.82,Default,Fortuna,0,0,0,,Nie musisz się tak bać. Nie jestem zła.
Dialogue: 0,0:10:26.66,0:10:28.64,Default,Fortuna,0,0,0,,Ale nie jesteś ranna, prawda?
Dialogue: 0,0:10:33.04,0:10:34.15,Default,Emilia,0,0,0,,Matko?
Dialogue: 0,0:10:34.92,0:10:37.04,Default,Fortuna,0,0,0,,Och, nic.
Dialogue: 0,0:10:37.73,0:10:41.15,Default,Fortuna,0,0,0,,Tak, tak bardzo za tobą tęskniłam.
Dialogue: 0,0:10:44.42,0:10:45.67,Default,Fortuna,0,0,0,,Rozpieszczona córeczko...
Dialogue: 0,0:10:47.16,0:10:48.69,Default,Fortuna,0,0,0,,Słuchaj, Emilio...
Dialogue: 0,0:10:50.82,0:10:52.08,Default,Fortuna,0,0,0,,Kocham cię.
Dialogue: 0,0:10:55.73,0:10:59.64,Default,Echidna,0,0,0,,Może obrazy, które zamknęłaś głęboko w\Nsercu, zaczęły
Dialogue: 0,0:10:59.73,0:11:02.43,Default,Echidna,0,0,0,,stopniowo nakładać się na sceny z twoich\Nwspomnień?
Dialogue: 0,0:11:02.62,0:11:03.56,Default,Emilia,0,0,0,,Jestem zaskoczona.
Dialogue: 0,0:11:03.65,0:11:08.27,Default,Emilia,0,0,0,,Myślałam, że będziesz miała jakieś\Nuszczypliwe uwagi o mnie i matce.
Dialogue: 0,0:11:08.85,0:11:10.64,Default,Echidna,0,0,0,,Nawet jeśli tak myślałaś,
Dialogue: 0,0:11:10.73,0:11:13.66,Default,Echidna,0,0,0,,Nie polecam tego mówić.
Dialogue: 0,0:11:14.04,0:11:16.90,Default,Echidna,0,0,0,,Moja opinia o tobie jest\Njuż wystarczająco niska.
Dialogue: 0,0:11:16.99,0:11:19.64,Default,Echidna,0,0,0,,A ty sprawiasz, że spada jeszcze niżej.
Dialogue: 0,0:11:19.73,0:11:21.28,Default,Emilia,0,0,0,,Nie martw się.
Dialogue: 0,0:11:21.37,0:11:24.20,Default,Emilia,0,0,0,,Nikomu więcej o tym nie powiem.
Dialogue: 0,0:11:25.57,0:11:27.29,Default,Echidna,0,0,0,,Czy to dobrze, czy źle,
Dialogue: 0,0:11:27.38,0:11:30.83,Default,Echidna,0,0,0,,Jego wpływ na ciebie staje\Nsię coraz silniejszy.
Dialogue: 0,0:11:31.17,0:11:32.12,Default,Emilia,0,0,0,,Naprawdę?
Dialogue: 0,0:11:32.74,0:11:34.00,Default,,0,0,0,,Dziękuję.
Dialogue: 0,0:11:36.00,0:11:37.70,Default,Echidna,0,0,0,,W każdym razie przypomniałaś sobie
Dialogue: 0,0:11:37.79,0:11:42.25,Default,Echidna,0,0,0,,swoją matkę, kilku znajomych i tę tak\Nzwaną wróżkę...
Dialogue: 0,0:11:42.34,0:11:44.64,Default,Echidna,0,0,0,,Jesteś gotowa stawić\Nczoła swojej przeszłości?
Dialogue: 0,0:11:44.98,0:11:46.51,Default,Emilia,0,0,0,,Nie, jeszcze nie.
Dialogue: 0,0:11:48.45,0:11:51.74,Default,Emilia,0,0,0,,Nadal brakuje mi\Nważnych wspomnień.
Dialogue: 0,0:11:52.41,0:11:53.73,Default,Echidna,0,0,0,,Co jeszcze może być?
Dialogue: 0,0:11:56.21,0:11:57.18,Default,Emilia,0,0,0,,Pieczęć.
Dialogue: 0,0:12:00.58,0:12:04.82,Default,Emilia,0,0,0,,Chodź, mała wróżko. Uciekamy dziś znowu.
Dialogue: 0,0:12:06.78,0:12:07.85,Default,Archi,0,0,0,,Emilio, wchodzę.
Dialogue: 0,0:12:07.94,0:12:08.82,Default,Emilia,0,0,0,,Aa!
Dialogue: 0,0:12:11.28,0:12:12.29,Default,Archi,0,0,0,,Co się stało?
Dialogue: 0,0:12:12.56,0:12:15.89,Default,Emilia,0,0,0,,A ty, Archi, czego potrzebowałeś?
Dialogue: 0,0:12:15.98,0:12:19.03,Default,Archi,0,0,0,,Najpierw przyniosłem ci przekąski.
Dialogue: 0,0:12:19.12,0:12:20.00,Default,Archi,0,0,0,,To orzechy.
Dialogue: 0,0:12:20.97,0:12:23.34,Default,Archi,0,0,0,,Zjedz to i bądź grzeczną\Ndziewczyną, dobrze?
Dialogue: 0,0:12:25.09,0:12:26.35,Default,Emilia,0,0,0,,Dziękuję.
Dialogue: 0,0:12:27.36,0:12:30.34,Default,Emilia,0,0,0,,Archi ostatnio strasznie się o mnie\Nzamartwia.
Dialogue: 0,0:12:30.43,0:12:31.77,Default,,0,0,0,,Muszę być ostrożna.
Dialogue: 0,0:12:33.09,0:12:33.97,Default,Emilia,0,0,0,,Skradam się...
Dialogue: 0,0:12:34.41,0:12:36.77,Default,Emilia,0,0,0,,Grupa Geuse'a znów dziś tu jest.
Dialogue: 0,0:12:37.49,0:12:40.58,Default,Emilia,0,0,0,,Myślałam, że cokolwiek ukrywają,\Nbędzie zabawniejsze.
Dialogue: 0,0:12:40.67,0:12:42.61,Default,Emilia,0,0,0,,Matka i reszta są takie dziwne.
Dialogue: 0,0:12:43.47,0:12:46.71,Default,Fortuna,0,0,0,,Emilia ostatnio jest pełna energii.
Dialogue: 0,0:12:46.80,0:12:49.44,Default,Fortuna,0,0,0,,Zawsze wraca do domu w ubraniach całych w\Nbłocie.
Dialogue: 0,0:12:49.53,0:12:52.53,Default,Geuse,0,0,0,,To, że jest taka zdrowa, może być tylko\Nczymś dobrym.
Dialogue: 0,0:12:52.62,0:12:54.71,Default,Geuse,0,0,0,,Przyniosę jej jak najwięcej nowych ubrań.
Dialogue: 0,0:12:54.97,0:12:56.97,Default,Fortuna,0,0,0,,Przepraszam, jeśli żądam jeszcze więcej,
Dialogue: 0,0:12:57.06,0:12:59.19,Default,,0,0,0,,skoro już tak wiele zrobiłeś.
Dialogue: 0,0:12:59.97,0:13:01.54,Default,Fortuna,0,0,0,,Masz też ubrania dla dorosłych?
Dialogue: 0,0:13:01.93,0:13:03.09,Default,Geuse,0,0,0,,Tak, oczywiście.
Dialogue: 0,0:13:03.71,0:13:07.84,Default,Geuse,0,0,0,,Jestem pewien, że mamy coś, w czym\Nbędziesz wyglądać prześlicznie.
Dialogue: 0,0:13:09.28,0:13:11.86,Default,Fortuna,0,0,0,,Wiem, że znamy się od dawna.
Dialogue: 0,0:13:11.95,0:13:14.10,Default,Fortuna,0,0,0,,Ale kiedy zacząłeś robić takie żarty?
Dialogue: 0,0:13:15.22,0:13:17.72,Default,Geuse,0,0,0,,Powiedziałem tylko to,\Nco czuję, że jest prawdą...
Dialogue: 0,0:13:17.81,0:13:20.32,Default,Geuse,0,0,0,,Czy było coś dziwnego w\Ntym, co powiedziałem?
Dialogue: 0,0:13:28.10,0:13:30.26,Default,Fortuna,0,0,0,,Geuse, co to jest?
Dialogue: 0,0:13:30.35,0:13:32.93,Default,Geuse,0,0,0,,Przypomniała mi się nasza dawna rozmowa,
Dialogue: 0,0:13:33.02,0:13:36.06,Default,,0,0,0,,podczas której wyglądałaś\Nna nieszczęśliwą,
Dialogue: 0,0:13:36.15,0:13:38.77,Default,Geuse,0,0,0,,bo miałaś gorączkę.
Dialogue: 0,0:13:38.86,0:13:41.12,Default,Geuse,0,0,0,,Nie jesteś teraz rozgrzana...
Dialogue: 0,0:13:41.21,0:13:44.20,Default,Fortuna,0,0,0,,Daj spokój, to było dziesiątki lat temu!
Dialogue: 0,0:13:44.29,0:13:46.08,Default,Fortuna,0,0,0,,Nie traktuj mnie jak dziecko!
Dialogue: 0,0:13:46.53,0:13:47.93,Default,Fortuna,0,0,0,,Szczerze...
Dialogue: 0,0:13:50.13,0:13:51.57,Default,Emilia,0,0,0,,Głupi Geuse!
Dialogue: 0,0:13:51.66,0:13:53.64,Default,Emilia,0,0,0,,I głupi Archi!
Dialogue: 0,0:13:56.74,0:14:00.19,Default,Geuse,0,0,0,,Więc... czy pieczęć jest nadal na miejscu?
Dialogue: 0,0:14:00.50,0:14:02.24,Default,Fortuna,0,0,0,,Jak zawsze, tak.
Dialogue: 0,0:14:03.09,0:14:06.45,Default,Fortuna,0,0,0,,To sumienne z twojej strony,\Nże sprawdzasz to za każdym razem.
Dialogue: 0,0:14:06.54,0:14:08.42,Default,Geuse,0,0,0,,To mój obowiązek.
Dialogue: 0,0:14:09.03,0:14:11.95,Default,Geuse,0,0,0,,Sytuacja poza lasem jest teraz niepewna.
Dialogue: 0,0:14:12.57,0:14:14.26,Default,Geuse,0,0,0,,Może moje obawy są bezpodstawne.
Dialogue: 0,0:14:14.35,0:14:16.25,Default,,0,0,0,,Ale chciałem, żebyś o tym wiedziała.
Dialogue: 0,0:14:16.88,0:14:17.91,Default,Fortuna,0,0,0,,Rozumiem.
Dialogue: 0,0:14:18.48,0:14:20.14,Default,Geuse,0,0,0,,Proszę, zachowaj czujność.
Dialogue: 0,0:14:20.65,0:14:24.13,Default,Geuse,0,0,0,,Dla dobra Emilii i ich obojga.
Dialogue: 0,0:14:24.92,0:14:26.13,Default,Emilia,0,0,0,,Pieczęć?
Dialogue: 0,0:14:31.52,0:14:33.06,Default,Emilia,0,0,0,,Tak, proszę!
Dialogue: 0,0:14:53.68,0:14:54.65,Default,Echidna,0,0,0,,Drzwi?
Dialogue: 0,0:14:55.67,0:14:57.43,Default,Echidna,0,0,0,,Co za dziwny widok.
Dialogue: 0,0:15:01.17,0:15:03.24,Default,Emilia,0,0,0,,To jest... pieczęć.
Dialogue: 0,0:15:08.90,0:15:12.34,Default,Emilia,0,0,0,,Istnienie tej pieczęci... jest powodem...
Dialogue: 0,0:15:15.26,0:15:16.97,Default,Echidna,0,0,0,,Znalazłaś odpowiedź?
Dialogue: 0,0:15:27.21,0:15:29.20,Default,Emilia,0,0,0,,To jest pieczęć?
Dialogue: 0,0:15:34.88,0:15:40.00,Default,Subaru,0,0,0,,Jakiś facet zobaczył list do\Nukochanej, zanim zobaczyła go ona.
Dialogue: 0,0:15:40.26,0:15:41.97,Default,Subaru,0,0,0,,Moje życie się skończyło.
Dialogue: 0,0:15:42.06,0:15:44.95,Default,Garfiel,0,0,0,,Jesteś o wiele zbyt przygnębiony!
Dialogue: 0,0:15:45.04,0:15:47.19,Default,Garfiel,0,0,0,,No dalej, pozbieraj się!
Dialogue: 0,0:15:47.28,0:15:51.72,Default,Subaru,0,0,0,,Nie spodziewałem się, że Garfiel będzie\Ntam czekał, żeby się odegrać...
Dialogue: 0,0:15:51.81,0:15:54.92,Default,Otto,0,0,0,,I tak zawsze ją podrywasz na oczach ludzi.
Dialogue: 0,0:15:55.01,0:15:58.39,Default,Otto,0,0,0,,Dlaczego się tak wstydzisz,\Ntylko dlatego, że to napisałeś?
Dialogue: 0,0:15:58.48,0:16:01.30,Default,Subaru,0,0,0,,Zwykle jestem gotów, że\Npo prostu to zignoruje!
Dialogue: 0,0:16:01.39,0:16:04.23,Default,Subaru,0,0,0,,I tak się zawsze dzieje, więc w porządku!
Dialogue: 0,0:16:04.32,0:16:06.79,Default,Subaru,0,0,0,,Ale tym razem mówiłem poważnie!
Dialogue: 0,0:16:06.88,0:16:09.93,Default,Subaru,0,0,0,,A przecież to był istny nocny list\Nmiłosny.
Dialogue: 0,0:16:10.02,0:16:11.70,Default,Subaru,0,0,0,,Najbardziej żenujący z możliwych!
Dialogue: 0,0:16:11.79,0:16:13.91,Default,Garfiel,0,0,0,,Nie martw się, szefie.
Dialogue: 0,0:16:14.00,0:16:17.66,Default,Garfiel,0,0,0,,Aż chciałbym uszczknąć trochę twojego\Nszczęścia.
Dialogue: 0,0:16:17.75,0:16:20.66,Default,Garfiel,0,0,0,,„W miłości bierz przykład\Nz lingdorna”, jak mówią.
Dialogue: 0,0:16:20.75,0:16:22.86,Default,Subaru,0,0,0,,Kiedy {\i1}ty{\i0} to mówisz,
Dialogue: 0,0:16:22.95,0:16:26.00,Default,,0,0,0,,brzmi to tak, jakbyś podjudzał, nawet\Njeśli tego nie robisz!
Dialogue: 0,0:16:27.17,0:16:30.61,Default,Subaru,0,0,0,,Garfielowi zajęło to około godziny,
Dialogue: 0,0:16:30.70,0:16:32.38,Default,Subaru,0,0,0,,Myślę, że zajmie jej to tyle.
Dialogue: 0,0:16:32.62,0:16:34.98,Default,Otto,0,0,0,,Jeśli odniesie sukces, tak.
Dialogue: 0,0:16:35.47,0:16:36.35,Default,Otto,0,0,0,,Au!
Dialogue: 0,0:16:37.06,0:16:39.09,Default,Ram,0,0,0,,Spróbuj choć raz wyczuć sytuację.
Dialogue: 0,0:16:39.85,0:16:40.87,Default,Otto,0,0,0,,Au!
Dialogue: 0,0:16:40.96,0:16:42.67,Default,Ram,0,0,0,,Jesteś tak nieświadomy nastroju,
Dialogue: 0,0:16:42.76,0:16:43.88,Default,,0,0,0,,I nazywasz się kupcem?
Dialogue: 0,0:16:43.97,0:16:46.90,Default,Otto,0,0,0,,To bolało jeszcze bardziej\Nniż uderzenie w czoło!
Dialogue: 0,0:16:46.06,0:16:46.94,Default,Ram,0,0,0,,{\an8}W każdym razie...
Dialogue: 0,0:16:47.77,0:16:50.54,Default,Ram,0,0,0,,Shima chce z tobą porozmawiać, Barusu.
Dialogue: 0,0:16:50.63,0:16:53.03,Default,Ram,0,0,0,,Chce kontynuować wczorajszą dyskusję.
Dialogue: 0,0:16:53.47,0:16:57.13,Default,Garfiel,0,0,0,,O czym rozmawialiście z bab— ze staruszką?
Dialogue: 0,0:16:57.22,0:16:58.41,Default,Subaru,0,0,0,,Nie ma sensu powtarzać.
Dialogue: 0,0:16:58.50,0:17:01.24,Default,,0,0,0,,Wszyscy wiemy, że jesteś babcinym synkiem.
Dialogue: 0,0:17:01.33,0:17:04.37,Default,Subaru,0,0,0,,Opowiedziała mi, co się stało,\Ngdy poszedłeś na cmentarz.
Dialogue: 0,0:17:05.15,0:17:06.58,Default,Garfiel,0,0,0,,Naprawdę?
Dialogue: 0,0:17:06.75,0:17:10.60,Default,Subaru,0,0,0,,Wczoraj byłem zajęty obmyślaniem,\Njak poradzić sobie z Garfielem.
Dialogue: 0,0:17:10.69,0:17:13.51,Default,Subaru,0,0,0,,W końcu odłożyliśmy najważniejszą część.
Dialogue: 0,0:17:13.60,0:17:15.74,Default,Ram,0,0,0,,Co odłożyłeś?
Dialogue: 0,0:17:16.42,0:17:17.30,Default,Subaru,0,0,0,,Cóż...
Dialogue: 0,0:17:17.39,0:17:23.02,Default,Shima,0,0,0,,Temat, którego nie da się uniknąć, jeśli\Nchcecie wyzwolić Sanktuarium.
Dialogue: 0,0:17:31.09,0:17:33.39,Default,Emilia,0,0,0,,Hngh... Hngh... Hngh...
Dialogue: 0,0:17:35.08,0:17:37.53,Default,Emilia,0,0,0,,Dlaczego nie chce się przewrócić?
Dialogue: 0,0:17:37.85,0:17:40.70,Default,Emilia,0,0,0,,To dla mnie trochę zbyt dziwne, żebym\Nmogła to zrozumieć.
Dialogue: 0,0:17:40.79,0:17:43.73,Default,Emilia,0,0,0,,Ale dzięki wam wszystkim udało mi się ją\Nznaleźć!
Dialogue: 0,0:17:43.82,0:17:46.00,Default,Emilia,0,0,0,,Klaszcz, klaszcz, klaszcz!
Dialogue: 0,0:17:47.15,0:17:50.68,Default,Emilia,0,0,0,,Hmmm. To wszystko wina Matki Fortuny.
Dialogue: 0,0:17:50.77,0:17:52.47,Default,Emilia,0,0,0,,I to wina Geuse'a.
Dialogue: 0,0:17:53.06,0:17:54.46,Default,Emilia,0,0,0,,Nyaa!
Dialogue: 0,0:17:57.14,0:17:59.93,Default,Emilia,0,0,0,,Czas wracać do domu.
Dialogue: 0,0:18:00.02,0:18:04.52,Default,Emilia,0,0,0,,Dziś malarz chce pomalować niebo\Nna czerwono, a las na biało!
Dialogue: 0,0:18:09.34,0:18:10.59,Default,Emilia,0,0,0,,Co się stało?
Dialogue: 0,0:18:15.94,0:18:18.37,Default,Emilia,0,0,0,,Czyżby... coś miało się wydarzyć?
Dialogue: 0,0:18:24.66,0:18:26.54,Default,Geuse,0,0,0,,To spory problem.
Dialogue: 0,0:18:27.81,0:18:30.24,Default,Geuse,0,0,0,,Może nie zdążę do wyznaczonego czasu.
Dialogue: 0,0:18:32.60,0:18:36.19,Default,Geuse,0,0,0,,Och? Czyj to uroczy mały tyłeczek?
Dialogue: 0,0:18:39.36,0:18:42.46,Default,Emilia,0,0,0,,Błagam cię, abyś mi udzielił\Numiarkowanego miłosierdzia...
Dialogue: 0,0:18:42.55,0:18:46.98,Default,Geuse,0,0,0,,No proszę! Co za urocza młoda dama—
Dialogue: 0,0:18:49.89,0:18:51.86,Default,Geuse,0,0,0,,Czy ty...
Dialogue: 0,0:18:52.23,0:18:55.36,Default,Geuse,0,0,0,,Nie, to niemożliwe...
Dialogue: 0,0:18:57.22,0:18:58.10,Default,Emilia,0,0,0,,Geuse?
Dialogue: 0,0:18:59.63,0:19:00.57,Default,Emilia,0,0,0,,Wszystko dobrze?
Dialogue: 0,0:19:10.45,0:19:12.08,Default,Geuse,0,0,0,,Jestem... w porządku...
Dialogue: 0,0:19:13.00,0:19:16.81,Default,Geuse,0,0,0,,Tak... tak! Oczywiście, że wszystko w\Nporządku!
Dialogue: 0,0:19:16.90,0:19:18.84,Default,Geuse,0,0,0,,Nic mi nie jest!
Dialogue: 0,0:19:19.54,0:19:20.84,Default,Geuse,0,0,0,,Bo ja...
Dialogue: 0,0:19:21.77,0:19:25.12,Default,Geuse,0,0,0,,Ja... ja tylko...
Dialogue: 0,0:19:26.53,0:19:30.93,Default,Geuse,0,0,0,,Otrzymałem zbawienie jak nigdy dotąd!
Dialogue: 0,0:19:33.60,0:19:34.75,Default,Emilia,0,0,0,,Naprawdę?
Dialogue: 0,0:19:35.93,0:19:38.23,Default,Emilia,0,0,0,,Zostałeś ocalony, ale płaczesz?
Dialogue: 0,0:19:38.76,0:19:42.10,Default,Geuse,0,0,0,,Nie płaczę dlatego, że jestem smutny.
Dialogue: 0,0:19:42.55,0:19:45.81,Default,Geuse,0,0,0,,Jestem taki szczęśliwy... tak bardzo się\Ncieszę.
Dialogue: 0,0:19:46.21,0:19:48.01,Default,Geuse,0,0,0,,Jestem naprawdę błogosławiony...
Dialogue: 0,0:19:48.24,0:19:52.21,Default,Geuse,0,0,0,,I taka radość może czasami\Nprzynosić ciepłe łzy.
Dialogue: 0,0:20:01.13,0:20:04.43,Default,Emilia,0,0,0,,Płaczesz... nawet kiedy jesteś szczęśliwy?
Dialogue: 0,0:20:06.59,0:20:09.04,Default,Emilia,0,0,0,,W porządku, Geuse.
Dialogue: 0,0:20:09.57,0:20:10.68,Default,,0,0,0,,W porządku.
Dialogue: 0,0:20:12.39,0:20:13.63,Default,Emilia,0,0,0,,W porządku.
Dialogue: 0,0:20:18.72,0:20:22.01,Default,Emilia,0,0,0,,Wiem, że jest tyle takich rzeczy,\No których zapomniałam...
Dialogue: 0,0:20:22.10,0:20:26.82,Default,Emilia,0,0,0,,Ale nie tak dawno temu nie byłabym\Nw stanie tego zaakceptować.
Dialogue: 0,0:20:27.62,0:20:28.76,Default,Emilia,0,0,0,,Ale teraz...
Dialogue: 0,0:20:30.85,0:20:33.75,Default,Emilia,0,0,0,,Boję się, ale nie będę kuliła się ze\Nstrachu.
Dialogue: 0,0:20:34.07,0:20:37.15,Default,Echidna,0,0,0,,Rezygnujesz z polegania na mężczyźnie czy\Nfigurze ojca,
Dialogue: 0,0:20:37.24,0:20:41.00,Default,Echidna,0,0,0,,choć to takie typowe dla plugawych kobiet\Njak ty?
Dialogue: 0,0:20:41.09,0:20:44.59,Default,Emilia,0,0,0,,Jestem pewna, że Subaru wybaczyłby mi,\Ngdybym tak zrobiła,
Dialogue: 0,0:20:45.21,0:20:47.14,Default,Emilia,0,0,0,,ale nadal byłabym słaba
Dialogue: 0,0:20:47.23,0:20:49.33,Default,,0,0,0,,i nie chcę po prostu ignorować tego faktu.
Dialogue: 0,0:20:49.62,0:20:50.56,Default,Emilia,0,0,0,,Poza tym...
Dialogue: 0,0:20:50.96,0:20:55.69,Default,Emilia,0,0,0,,Nie chcę, żeby wszystko, co Subaru dla\Nmnie napisał, okazało się nieprawdą.
Dialogue: 0,0:20:56.48,0:20:58.33,Default,Emilia,0,0,0,,Subaru wierzy we mnie.
Dialogue: 0,0:20:58.42,0:21:01.56,Default,Emilia,0,0,0,,I dlatego nie chcę zawieść uczuć, którymi\Nmnie darzy.
Dialogue: 0,0:21:02.84,0:21:04.65,Default,Echidna,0,0,0,,Rób co chcesz.
Dialogue: 0,0:21:04.96,0:21:09.26,Default,Echidna,0,0,0,,Po prostu znajdę satysfakcję\Nw twoim cierpieniu.
Dialogue: 0,0:21:11.47,0:21:13.58,Default,Emilia,0,0,0,,Więc wszystko jest gotowe?
Dialogue: 0,0:21:14.00,0:21:17.05,Default,Echidna,0,0,0,,Rozgrzewka się skończyła.
Dialogue: 0,0:21:17.53,0:21:21.50,Default,Echidna,0,0,0,,Próba, która kiedyś cię złamała, teraz\Nzaczyna się na dobre.
Dialogue: 0,0:21:22.88,0:21:24.84,Default,Geuse,0,0,0,,Proszę zaczekaj, Emilia!
Dialogue: 0,0:21:24.93,0:21:26.88,Default,Geuse,0,0,0,,Takie bieganie jest niebezpieczne!
Dialogue: 0,0:21:26.97,0:21:28.48,Default,Emilia,0,0,0,,Nie, nie!
Dialogue: 0,0:21:28.57,0:21:30.76,Default,Emilia,0,0,0,,Spróbuj mnie złapać!
Dialogue: 0,0:21:32.88,0:21:36.86,Default,Fortuna,0,0,0,,Jej psoty są zbyt wielkie nawet dla nas.
Dialogue: 0,0:21:37.45,0:21:39.58,Default,Geuse,0,0,0,,To dobrze mieć tyle energii.
Dialogue: 0,0:21:39.67,0:21:43.40,Default,Geuse,0,0,0,,Chciałbym, żeby unikała\Nniebezpiecznych czynów.
Dialogue: 0,0:21:44.12,0:21:46.18,Default,Geuse,0,0,0,,Gdyby mogła tylko skakać w swoim domu,
Dialogue: 0,0:21:46.27,0:21:48.22,Default,Geuse,0,0,0,,zdrowa i skąpana w słońcu,
Dialogue: 0,0:21:48.31,0:21:50.79,Default,,0,0,0,,bez obaw o złamanie czegokolwiek...
Dialogue: 0,0:21:50.88,0:21:52.24,Default,Fortuna,0,0,0,,Geuse...
Dialogue: 0,0:21:52.53,0:21:54.95,Default,Fortuna,0,0,0,,To byłoby bardzo trudne.
Dialogue: 0,0:21:56.77,0:21:58.19,Default,Geuse,0,0,0,,Czyżby?
Dialogue: 0,0:21:58.69,0:22:01.80,Default,Geuse,0,0,0,,Ale dla dobra Emilii...
Dialogue: 0,0:22:01.89,0:22:03.09,Default,Geuse,0,0,0,,Ja tylko...
Dialogue: 0,0:22:04.63,0:22:05.51,Default,Emilia,0,0,0,,Hej!
Dialogue: 0,0:22:06.00,0:22:09.79,Default,Emilia,0,0,0,,Mamo, Geuse! Dlaczego żadne z was mnie nie\Ngoni?
Dialogue: 0,0:22:09.88,0:22:12.51,Default,Emilia,0,0,0,,Czy nie bawimy się w berka?!
Dialogue: 0,0:22:12.90,0:22:15.03,Default,Geuse,0,0,0,,Ach, wybacz mi!
Dialogue: 0,0:22:15.12,0:22:17.61,Default,Geuse,0,0,0,,Nigdy nie popełniłem\Ntak straszliwego błędu!
Dialogue: 0,0:22:18.02,0:22:19.98,Default,Fortuna,0,0,0,,Nie rozpieszczaj jej tak.
Dialogue: 0,0:22:20.40,0:22:22.48,Default,Fortuna,0,0,0,,Emilia, chodź tu.
Dialogue: 0,0:22:23.03,0:22:24.69,Default,Emilia,0,0,0,,Co się stało, matko?
Dialogue: 0,0:22:25.21,0:22:28.07,Default,Emilia,0,0,0,,Naprawdę jesteś taka rozpieszczona.
Dialogue: 0,0:22:28.50,0:22:29.46,Default,Emilia,0,0,0,,Aa!
Dialogue: 0,0:22:29.55,0:22:30.79,Default,Fortuna,0,0,0,,Za późno!
Dialogue: 0,0:22:30.88,0:22:34.12,Default,,0,0,0,,Zostałaś schwytana przez Matkę Fortunę!
Dialogue: 0,0:22:34.21,0:22:36.15,Default,Emilia,0,0,0,,To oszustwo, matko!
Dialogue: 0,0:22:36.24,0:22:38.30,Default,Emilia,0,0,0,,Tak nie wolno! To nieuczciwe! Przeproś!
Dialogue: 0,0:22:38.39,0:22:41.28,Default,Fortuna,0,0,0,,Posłuchajcie tylko tej dziewczynki!
Dialogue: 0,0:22:41.37,0:22:45.83,Default,Fortuna,0,0,0,,A więc myślałaś o tym, co ci powiedziałam?
Dialogue: 0,0:22:45.92,0:22:49.13,Default,Fortuna,0,0,0,,Jak myślisz, dlaczego\NGeuse i ja cię ścigaliśmy?
Dialogue: 0,0:22:50.36,0:22:52.51,Default,Emilia,0,0,0,,Nie, matko!
Dialogue: 0,0:22:52.60,0:22:56.89,Default,Emilia,0,0,0,,Wróżki powiedziały, że powinniśmy\Nwyjść i się pobawić, więc...
Dialogue: 0,0:22:57.28,0:23:02.32,Default,Fortuna,0,0,0,,Nie lubię dzieci, które zrzucają winę na\Ninnych — a właściwie na wróżki.
Dialogue: 0,0:23:04.40,0:23:05.72,Default,Emilia,0,0,0,,Przepraszam.
Dialogue: 0,0:23:05.81,0:23:08.26,Default,Emilia,0,0,0,,Odkąd zaprzyjaźniłam się z Geuse,
Dialogue: 0,0:23:08.35,0:23:11.07,Default,,0,0,0,,Chciałam ci o tym powiedzieć.
Dialogue: 0,0:23:11.16,0:23:13.29,Default,Emilia,0,0,0,,A ponieważ Geuse jest beksą,
Dialogue: 0,0:23:13.38,0:23:14.91,Default,,0,0,0,,czułam, że muszę mu pomóc.
Dialogue: 0,0:23:15.30,0:23:17.88,Default,Fortuna,0,0,0,,To uczucie jest bardzo cenne.
Dialogue: 0,0:23:17.97,0:23:22.32,Default,Fortuna,0,0,0,,Ale obiecałaś, że nigdy nie pójdziesz w\Ntamto miejsce, prawda?
Dialogue: 0,0:23:23.04,0:23:25.13,Default,Emilia,0,0,0,,Tak... tak.
Dialogue: 0,0:23:25.57,0:23:28.39,Default,Fortuna,0,0,0,,To było bardzo złe.
Dialogue: 0,0:23:31.56,0:23:34.89,Default,Fortuna,0,0,0,,Obietnica jest ucieleśnieniem zaufania,
Dialogue: 0,0:23:35.39,0:23:40.51,Default,Fortuna,0,0,0,,a jej złamanie to zdrada tego zaufania,\Nwięc nie wolno ci tego robić.
Dialogue: 0,0:23:41.19,0:23:44.08,Default,Fortuna,0,0,0,,Obiecaj mi, Emilio,
Dialogue: 0,0:23:44.17,0:23:47.20,Default,,0,0,0,,że od teraz dotrzymasz obietnic.
Dialogue: 0,0:23:48.88,0:23:50.78,Default,Emilia,0,0,0,,Tak... dotrzymam.
Dialogue: 0,0:23:51.24,0:23:53.96,Default,Emilia,0,0,0,,Przepraszam, matko...
Dialogue: 0,0:23:55.54,0:23:56.42,Default,Fortuna,0,0,0,,W porządku.
Dialogue: 0,0:23:57.96,0:23:59.23,Default,Fortuna,0,0,0,,Wystarczy.
Dialogue: 0,0:24:04.77,0:24:07.59,Default,Fortuna,0,0,0,,A ty, Geuse, wszystko w porządku?
Dialogue: 0,0:24:07.68,0:24:12.27,Default,Geuse,0,0,0,,To był taki olśniewający widok...
Dialogue: 0,0:24:12.36,0:24:15.42,Default,Geuse,0,0,0,,Nie mogłem powstrzymać łez.
Dialogue: 0,0:24:17.44,0:24:19.24,Default,Fortuna,0,0,0,,W każdym razie, Emilia...
Dialogue: 0,0:24:19.97,0:24:22.16,Default,Fortuna,0,0,0,,Wspomniałaś o wróżkach?
Dialogue: 0,0:24:22.25,0:24:24.65,Default,Emilia,0,0,0,,Wróżki!
Dialogue: 0,0:24:24.74,0:24:27.49,Default,Emilia,0,0,0,,Przychodzą mi pomóc od dawna!
Dialogue: 0,0:24:28.00,0:24:28.88,Default,Emilia,0,0,0,,Chodźmy.
Dialogue: 0,0:24:32.28,0:24:34.12,Default,Fortuna,0,0,0,,Czy to... mniejsze duchy?!
Dialogue: 0,0:24:34.61,0:24:36.64,Default,Fortuna,0,0,0,,I tak wiele ich jest!
Dialogue: 0,0:24:41.09,0:24:46.25,Default,Geuse,0,0,0,,Emilia ma wrodzony talent, by zostać\Nużytkowniczką sztuk duchowych.
Dialogue: 0,0:24:46.68,0:24:50.09,Default,Emilia,0,0,0,,Mniejsze duchy? Wrodzony talent... do\Nsztuk duchowych?
Dialogue: 0,0:24:50.42,0:24:54.87,Default,Geuse,0,0,0,,Istoty, które nazywasz „wróżkami”, to\Nmniejsze duchy.
Dialogue: 0,0:24:54.96,0:24:58.20,Default,Geuse,0,0,0,,Ludzi, którzy się z nimi\Nporozumiewają i zawierają kontrakty
Dialogue: 0,0:24:58.29,0:25:01.39,Default,Geuse,0,0,0,,i pożyczają ich moc, nazywa się\Nużytkownikami sztuk duchowych.
Dialogue: 0,0:25:01.52,0:25:03.56,Default,Emilia,0,0,0,,Czy ja też mogę nią zostać?
Dialogue: 0,0:25:03.92,0:25:07.05,Default,Fortuna,0,0,0,,Nie dawaj jej żadnych dziwnych pomysłów.
Dialogue: 0,0:25:07.14,0:25:10.55,Default,Geuse,0,0,0,,Emilia nie pozostanie\Ntaka młoda na zawsze.
Dialogue: 0,0:25:10.64,0:25:15.45,Default,Geuse,0,0,0,,Zwłaszcza gdy nikt nie będzie\Nprzy niej, będą jej siłą.
Dialogue: 0,0:25:15.78,0:25:20.43,Default,Fortuna,0,0,0,,Ale to może być niebezpieczne i nie\Nmogę pozwolić mojej słodkiej Emilii...
Dialogue: 0,0:25:21.29,0:25:23.77,Default,Emilia,0,0,0,,Jestem po stronie Geuse'a!
Dialogue: 0,0:25:23.86,0:25:26.92,Default,Emilia,0,0,0,,Będę użytkowniczką sztuk duchowych! I już!
Dialogue: 0,0:25:27.31,0:25:29.69,Default,Fortuna,0,0,0,,Widzisz, traktuje cię poważnie.
Dialogue: 0,0:25:29.78,0:25:31.13,Default,Fortuna,0,0,0,,Jak za to odpowiesz?
Dialogue: 0,0:25:31.33,0:25:34.09,Default,Geuse,0,0,0,,Nie wiem, co...
Dialogue: 0,0:25:34.44,0:25:35.32,Default,Geuse,0,0,0,,Yyy...
Dialogue: 0,0:25:36.16,0:25:37.47,Default,Geuse,0,0,0,,Co za dylemat.
Dialogue: 0,0:25:40.13,0:25:43.16,Default,Emilia,0,0,0,,Wiecie, Matko Fortuno i Geuse,
Dialogue: 0,0:25:43.25,0:25:45.00,Default,,0,0,0,,zachowujecie się jak mama i tata.
Dialogue: 0,0:25:45.09,0:25:45.98,Default,Fortuna,0,0,0,,Co?
Dialogue: 0,0:25:47.30,0:25:49.61,Default,Fortuna,0,0,0,,Nie mów takich głupot!
Dialogue: 0,0:25:49.70,0:25:53.30,Default,Fortuna,0,0,0,,Geuse i ja znamy się od dawna!
Dialogue: 0,0:25:51.54,0:25:53.21,Default,Geuse,0,0,0,,{\an8}Tak jest, Emilia!
Dialogue: 0,0:25:53.30,0:25:55.05,Default,Geuse,0,0,0,,Dla kogoś, kto żyje tak długo,
Dialogue: 0,0:25:55.14,0:25:57.64,Default,Geuse,0,0,0,,Nawet Fortuna jest w zasadzie dzieckiem.
Dialogue: 0,0:25:58.18,0:26:00.74,Default,Fortuna,0,0,0,,Nazywanie mnie dzieckiem to przesada!
Dialogue: 0,0:26:00.83,0:26:03.41,Default,Fortuna,0,0,0,,Wiesz w ogóle ile mam lat?!
Dialogue: 0,0:26:03.50,0:26:06.36,Default,Geuse,0,0,0,,Nie, nie wyraziłem tego poprawnie!
Dialogue: 0,0:26:06.45,0:26:09.40,Default,Geuse,0,0,0,,Oczywiście, jestem świadomy\Ntwojego dokładnego wieku,
Dialogue: 0,0:26:09.49,0:26:14.13,Default,Geuse,0,0,0,,A ty jesteś zdecydowanie za piękna\Ni dojrzała, by być dzieckiem.
Dialogue: 0,0:26:15.60,0:26:16.74,Default,Fortuna,0,0,0,,Owszem, owszem.
Dialogue: 0,0:26:17.28,0:26:19.80,Default,Fortuna,0,0,0,,W takim razie wybaczę ci.
Dialogue: 0,0:26:21.12,0:26:23.76,Default,Fortuna,0,0,0,,Ale lepiej, żebyś bardzo, bardzo\Nprzepraszał.
Dialogue: 0,0:26:24.44,0:26:25.32,Default,Geuse,0,0,0,,Tak...
Dialogue: 0,0:26:26.72,0:26:31.55,Default,Geuse,0,0,0,,W każdym razie znam\NFortunę od bardzo dawna.
Dialogue: 0,0:26:31.94,0:26:36.19,Default,Geuse,0,0,0,,Właściwie od czasów, gdy twoja matka i\Nojciec byli jeszcze zdrowi—
Dialogue: 0,0:26:36.28,0:26:37.25,Default,Fortuna,0,0,0,,Geuse!
Dialogue: 0,0:26:38.01,0:26:39.94,Default,Geuse,0,0,0,,Wybacz mi.
Dialogue: 0,0:26:40.86,0:26:42.99,Default,Emilia,0,0,0,,Moja matka i ojciec?
Dialogue: 0,0:26:47.48,0:26:49.32,Default,Fortuna,0,0,0,,Przepraszam, Emilio.
Dialogue: 0,0:26:50.53,0:26:52.74,Default,Fortuna,0,0,0,,Porozmawiamy o tym innym razem.
Dialogue: 0,0:26:53.32,0:26:55.04,Default,Fortuna,0,0,0,,Wracaj do swojego pokoju.
Dialogue: 0,0:26:55.93,0:26:57.80,Default,Emilia,0,0,0,,Innym razem?
Dialogue: 0,0:26:58.68,0:27:00.57,Default,Emilia,0,0,0,,Naprawdę mi powiesz?
Dialogue: 0,0:27:03.25,0:27:05.68,Default,Fortuna,0,0,0,,Bądź grzeczna, wiem, że dasz radę.
Dialogue: 0,0:27:06.36,0:27:09.95,Default,Fortuna,0,0,0,,Wkrótce pozwolę ci też znów spotkać się z\NGeuse'em.
Dialogue: 0,0:27:10.04,0:27:11.23,Default,Emilia,0,0,0,,Naprawdę? Naprawdę?
Dialogue: 0,0:27:11.57,0:27:14.52,Default,Emilia,0,0,0,,Obiecujesz? I nie złamiesz obietnicy?
Dialogue: 0,0:27:22.58,0:27:24.66,Default,Fortuna,0,0,0,,Tak, obiecuję.
Dialogue: 0,0:27:26.10,0:27:30.70,Default,Fortuna,0,0,0,,To będzie bardzo, bardzo ważna obietnica\Nmiędzy nami.
Dialogue: 0,0:27:33.53,0:27:34.78,Default,Emilia,0,0,0,,W porządku.
Dialogue: 0,0:27:35.19,0:27:37.76,Default,Emilia,0,0,0,,Wracam do pokoju.
Dialogue: 0,0:27:43.22,0:27:44.64,Default,Emilia,0,0,0,,Do zobaczenia, Geuse.
Dialogue: 0,0:27:45.06,0:27:47.27,Default,Emilia,0,0,0,,Nie płacz za dużo.
Dialogue: 0,0:27:47.78,0:27:49.93,Default,Emilia,0,0,0,,To nasza obietnica do następnego\Nspotkania.
Dialogue: 0,0:27:51.59,0:27:55.48,Default,Geuse,0,0,0,,Oczywiście, spotkamy się wkrótce.
Dialogue: 0,0:28:05.12,0:28:06.45,Default,Echidna,0,0,0,,Ktoś nadchodzi.
Dialogue: 0,0:28:19.57,0:28:20.45,Default,Fortuna,0,0,0,,Kim jesteś?
Dialogue: 0,0:28:28.80,0:28:31.39,Default,Regulus,0,0,0,,Kiedy chcesz wiedzieć czyjeś imię,
Dialogue: 0,0:28:31.59,0:28:35.35,Default,Regulus,0,0,0,,Czy nie jest to zwyczajna\Nuprzejmość dać najpierw swoje?
Dialogue: 0,0:28:35.73,0:28:38.59,Default,Regulus,0,0,0,,To pierwszy raz, kiedy się widzimy.
Dialogue: 0,0:28:38.68,0:28:43.21,Default,Regulus,0,0,0,,Powinniśmy być na równi\Nw budowaniu relacji.
Dialogue: 0,0:28:43.30,0:28:47.38,Default,Regulus,0,0,0,,Więc czemu żądasz mojego imienia, jakbyś\Nbyła ode mnie lepsza?
Dialogue: 0,0:28:47.47,0:28:51.04,Default,Fortuna,0,0,0,,Jak na mężczyznę,\Nto chyba lubisz dużo gadać.
Dialogue: 0,0:28:50.48,0:28:52.55,Default,Regulus,0,0,0,,{\an8}„Jak na mężczyznę”?
Dialogue: 0,0:28:52.64,0:28:56.65,Default,Regulus,0,0,0,,Dzięki za dowód, że nie znasz mężczyzn,\Nz którymi możesz mnie porównać.
Dialogue: 0,0:28:56.74,0:28:59.67,Default,Regulus,0,0,0,,Nie mogę puścić płazem takiej postawy.
Dialogue: 0,0:29:00.12,0:29:03.54,Default,Regulus,0,0,0,,Nie szanujesz mojej indywidualności,\Nmojego Autorytetu—
Dialogue: 0,0:29:03.63,0:29:04.58,Default,Fortuna,0,0,0,,Wystarczy!
Dialogue: 0,0:29:04.67,0:29:07.05,Default,Fortuna,0,0,0,,Przestań mówić, jakbyś był upojony samym\Nsobą!
Dialogue: 0,0:29:07.14,0:29:08.64,Default,Fortuna,0,0,0,,Kim ty jesteś?!
Dialogue: 0,0:29:20.56,0:29:23.98,Default,Regulus,0,0,0,,Arcybiskup Grzechu z Kultu Czarownicy,\Nreprezentujący Chciwość...
Dialogue: 0,0:29:24.50,0:29:26.51,Default,Regulus,0,0,0,,Regulus Corneas.
Dialogue: 0,0:29:26.95,0:29:29.95,Episode Title,Title,0,0,0,,{\pos(320,60)\fs38\t(1,2526,\fs33)}Podróż przez {\c&HB7AAAA&}wspomnienia
Dialogue: 0,0:29:36.51,0:29:43.51,Default,,0,0,0,,
