Dialogue: 0,0:00:24.13,0:00:27.04,Default,Subaru,0,0,0,,Tak się zmieniła, bo mnie nie było.
Dialogue: 0,0:00:28.35,0:00:31.46,Default,Subaru,0,0,0,,I mówiłem, że nie chcę,\Nżeby wyglądała smutnie...
Dialogue: 0,0:00:33.12,0:00:35.13,Default,Subaru,0,0,0,,Emilio, wszystko w porządku?
Dialogue: 0,0:00:41.05,0:00:42.27,Default - italics,Subaru,0,0,0,,Uratuję Emilię...
Dialogue: 0,0:00:42.56,0:00:45.63,Default - italics,Subaru,0,0,0,,i Sanktuarium, i rezydencję.
Dialogue: 0,0:00:45.72,0:00:48.02,Default - italics,Subaru,0,0,0,,Uratuję każdego z nich.
Dialogue: 0,0:00:49.08,0:00:51.01,Default - italics,Subaru,0,0,0,,Choćby miało mnie to kosztować życie.
Dialogue: 0,0:00:55.69,0:00:57.50,Default,Ram,0,0,0,,Dobrze się czujesz?
Dialogue: 0,0:00:58.54,0:01:01.45,Default,Emilia,0,0,0,,Tak... bo Subaru był przy mnie, myślę.
Dialogue: 0,0:01:01.89,0:01:04.40,Default - italics,Subaru,0,0,0,,Największy problem to Roswaal.
Dialogue: 0,0:01:04.49,0:01:07.36,Default - italics,Subaru,0,0,0,,Wiedział, że powtarzam wydarzenia,
Dialogue: 0,0:01:07.45,0:01:10.67,Default - italics,Subaru,0,0,0,,Nawet jeśli nie wiedział,\Nże muszę umrzeć, żeby to zrobić.
Dialogue: 0,0:01:10.88,0:01:14.38,Default - italics,Subaru,0,0,0,,Oczywiście kieruje się Księgą Mądrości.
Dialogue: 0,0:01:14.53,0:01:16.88,Default - italics,Subaru,0,0,0,,Nie zaakceptuje niczego sprzecznego z\Nzapisami,
Dialogue: 0,0:01:16.97,0:01:20.97,Default - italics,Subaru,0,0,0,,a jeśli coś się nie zgadza, bez wahania\Nwykorzysta moje powroty, by to naprawić.
Dialogue: 0,0:01:21.39,0:01:23.89,Default - italics,Subaru,0,0,0,,Co go zmusza do tego wszystkiego?
Dialogue: 0,0:01:26.08,0:01:26.96,Default - italics,Subaru,0,0,0,,Ja...
Dialogue: 0,0:01:27.42,0:01:28.40,Default - flashback,Roswaal,0,0,0,,Robiąc to...
Dialogue: 0,0:01:28.74,0:01:32.15,Default - flashback,Roswaal,0,0,0,,możesz stać się taki jak ja.
Dialogue: 0,0:01:37.25,0:01:39.14,Default - italics,Subaru,0,0,0,,...nigdy nie będę taki jak ty.
Dialogue: 0,0:01:39.69,0:01:40.83,Default - italics,Subaru,0,0,0,,Nigdy.
Dialogue: 0,0:01:41.59,0:01:44.66,Default - italics,Subaru,0,0,0,,Więc... mogę znów się do ciebie zwrócić?
Dialogue: 0,0:01:46.62,0:01:50.88,Default - italics,Subaru,0,0,0,,Tyle rzeczy chcę odkryć i wspólnie z tobą\Nprzemyśleć.
Dialogue: 0,0:01:52.12,0:01:54.67,Default,Subaru,0,0,0,,Zaproś mnie, Echidno!
Dialogue: 0,0:01:56.16,0:01:58.44,Default,Subaru,0,0,0,,Dam ci moje życie tyle razy, ile zechcesz!
Dialogue: 0,0:01:58.53,0:02:01.13,Default,Subaru,0,0,0,,I moją dumę, i wszystko inne!
Dialogue: 0,0:02:01.22,0:02:03.18,Default,Subaru,0,0,0,,Więc proszę, Echidno!
Dialogue: 0,0:02:03.77,0:02:04.68,Default,Subaru,0,0,0,,Pozwól mi...
Dialogue: 0,0:02:15.37,0:02:17.65,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:02:18.41,0:02:19.29,Default,Subaru,0,0,0,,Hę?
Dialogue: 0,0:02:21.66,0:02:22.54,Default,Emilia,0,0,0,,...amca.
Dialogue: 0,0:02:23.00,0:02:24.13,Default,Emilia,0,0,0,,Kłamca.
Dialogue: 0,0:02:24.78,0:02:27.28,Default,Emilia,0,0,0,,Kłamca! Kłamca! Kłamca!
Dialogue: 0,0:02:27.37,0:02:31.58,Default,Emilia,0,0,0,,{\an8}Kłamca! Kłamca! Subaru, ty kłamco!
Dialogue: 0,0:02:28.32,0:02:30.03,Default - italics,Subaru,0,0,0,,Co to jest?
Dialogue: 0,0:02:30.12,0:02:31.49,Default,Wilhelm,0,0,0,,Emilia!
Dialogue: 0,0:02:31.58,0:02:33.73,Default,Emilia,0,0,0,,Ty kłamco!
Dialogue: 0,0:02:33.82,0:02:37.34,Default,Emilia,0,0,0,,{\an8}Subaru... Subaru... Kłamco...
Dialogue: 0,0:02:36.89,0:02:40.10,Default,Wilhelm,0,0,0,,Felis! Natychmiast tu przyjdź! To pilne!\NSzybko!
Dialogue: 0,0:02:37.71,0:02:40.48,Default,Emilia,0,0,0,,{\an8}Powiedziałeś... że będziemy razem...
Dialogue: 0,0:02:40.57,0:02:42.09,Default - italics,Subaru,0,0,0,,Nie rozpoznaję tego...
Dialogue: 0,0:02:42.49,0:02:44.77,Default - italics,Subaru,0,0,0,,Nie znam tego scenariusza.
Dialogue: 0,0:02:44.86,0:02:45.74,Default,Felis,0,0,0,,Stary Wil!
Dialogue: 0,0:02:45.83,0:02:49.34,Default,Wilhelm,0,0,0,,{\an8}Ma przebite gardło! Nie mamy ani chwili do\Nstracenia!
Dialogue: 0,0:02:45.69,0:02:47.22,Default - italics,Subaru,0,0,0,,Jak mógłbym to rozpoznać?
Dialogue: 0,0:02:51.04,0:02:54.90,Default - italics,Subaru,0,0,0,,Przestań... To nie ma sensu. On już nie\Nżyje.
Dialogue: 0,0:02:55.12,0:02:56.23,Default,Wilhelm,0,0,0,,Nie pozwolę ci umrzeć!
Dialogue: 0,0:02:56.53,0:02:59.68,Default,Wilhelm,0,0,0,,Nie pozwolę, żeby ten, który mnie\Nuratował, umarł w ten sposób!
Dialogue: 0,0:03:00.06,0:03:02.25,Default,Felis,0,0,0,,Dlaczego to musiało się stać teraz?
Dialogue: 0,0:03:02.34,0:03:04.94,Default,Felis,0,0,0,,Przestań żartować! Przestań z nas kpić!
Dialogue: 0,0:03:05.03,0:03:09.13,Default - italics,Subaru,0,0,0,,Przestańcie! Przestańcie! Przestańcie!\NPrzestańcie! Przestańcie! Przestańcie!
Dialogue: 0,0:03:09.22,0:03:13.28,Default,Felis,0,0,0,,Jego dusza już odeszła.
Dialogue: 0,0:03:13.37,0:03:15.21,Default,Wilhelm,0,0,0,,Dlaczego? Dlaczego?!
Dialogue: 0,0:03:15.72,0:03:17.27,Default,Wilhelm,0,0,0,,Dlaczego tak łatwo umarłeś?
Dialogue: 0,0:03:18.16,0:03:20.73,Default,Wilhelm,0,0,0,,Subaru, jesteś...
Dialogue: 0,0:03:18.60,0:03:20.73,Default,Felis,0,0,0,,Słabeusz. Tchórz.
Dialogue: 0,0:03:21.32,0:03:23.74,Default,Felis,0,0,0,,Zostawiasz wszystkich,\Nna których ci zależało.
Dialogue: 0,0:03:23.83,0:03:27.50,Default,Felis,0,0,0,,Przerzucasz na nas cały ból i cierpienie.
Dialogue: 0,0:03:29.36,0:03:30.56,Default,Emilia,0,0,0,,Powiedziałeś...
Dialogue: 0,0:03:31.40,0:03:36.02,Default,Emilia,0,0,0,,Powiedziałeś... że mnie kochałeś.
Dialogue: 0,0:03:43.86,0:03:44.92,Default,Subaru,0,0,0,,Czy to...
Dialogue: 0,0:03:52.17,0:03:56.25,Default,Subaru,0,0,0,,...czy tak wyglądał ten świat po mojej\Nśmierci?
Dialogue: 0,0:03:56.97,0:04:00.97,Default,Subaru,0,0,0,,A może to była próba? Nie moja przeszłość,\Nlecz druga próba?
Dialogue: 0,0:04:01.45,0:04:03.79,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:04:14.41,0:04:15.93,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:04:16.02,0:04:18.08,Default,Julius,0,0,0,,Emilia, proszę...
Dialogue: 0,0:04:18.65,0:04:21.20,Default,Julius,0,0,0,,Wytrzyj mu twarz.
Dialogue: 0,0:04:25.62,0:04:26.69,Default,Emilia,0,0,0,,Dlaczego?
Dialogue: 0,0:04:27.39,0:04:29.85,Default,Emilia,0,0,0,,Dlaczego Subaru tak wygląda?
Dialogue: 0,0:04:30.94,0:04:34.00,Default,Emilia,0,0,0,,Dlaczego musiało go to spotkać?
Dialogue: 0,0:04:34.49,0:04:36.26,Default,Emilia,0,0,0,,Żeby mnie uratować?
Dialogue: 0,0:04:37.15,0:04:39.71,Default,Emilia,0,0,0,,Dlaczego? Proszę, powiedz mi.
Dialogue: 0,0:04:40.20,0:04:45.65,Default,Julius,0,0,0,,Chciałem jeszcze z tobą porozmawiać,\NNatsuki Subaru.
Dialogue: 0,0:04:50.31,0:04:53.89,Default,Julius,0,0,0,,Chciałem cię nazwać przyjacielem.
Dialogue: 0,0:05:01.83,0:05:03.68,Default,Subaru,0,0,0,,Przestańcie...
Dialogue: 0,0:05:04.73,0:05:05.65,Default,Subaru,0,0,0,,Proszę...
Dialogue: 0,0:05:05.96,0:05:07.50,Default,Subaru,0,0,0,,Przestańcie!
Dialogue: 0,0:05:10.63,0:05:12.90,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:05:17.61,0:05:21.80,Default,Ram,0,0,0,,Po tych wszystkich bzdurach,\Nktóre ciągle wygłaszasz...
Dialogue: 0,0:05:27.39,0:05:31.90,Default,Ram,0,0,0,,Czy to także było częścią twojego planu,\NBeatrice?
Dialogue: 0,0:05:32.84,0:05:34.06,Default,Beatrice,0,0,0,,Dlaczego?
Dialogue: 0,0:05:35.46,0:05:39.59,Default,Beatrice,0,0,0,,Wiedziałam, że nie możesz być „tą osobą”.
Dialogue: 0,0:05:40.88,0:05:41.77,Default,Beatrice,0,0,0,,Ale mimo to...
Dialogue: 0,0:05:45.28,0:05:48.49,Default,Ram,0,0,0,,To nazywasz „miłością”? Doprawdy...
Dialogue: 0,0:05:49.04,0:05:50.49,Default,Ram,0,0,0,,Nie ma dla ciebie ratunku.
Dialogue: 0,0:05:51.07,0:05:53.16,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:05:56.22,0:05:57.94,Default,Puck,0,0,0,,Więc to ty.
Dialogue: 0,0:06:04.81,0:06:09.30,Default,Reinhard,0,0,0,,Emilia i Subaru już nie żyją, prawda?
Dialogue: 0,0:06:09.57,0:06:12.27,Default,Puck,0,0,0,,Lia śpi na zawsze.
Dialogue: 0,0:06:13.16,0:06:16.10,Default,Puck,0,0,0,,Nie chcę żyć w świecie bez niej.
Dialogue: 0,0:06:16.65,0:06:21.44,Default,Puck,0,0,0,,Dlatego zgodnie z naszym kontraktem\Nzamrożę cały świat.
Dialogue: 0,0:06:22.18,0:06:25.15,Default,Puck,0,0,0,,Obaj jesteśmy równie winni.
Dialogue: 0,0:06:25.42,0:06:30.03,Default,Reinhard,0,0,0,,I dlatego próbujesz zniszczyć świat?
Dialogue: 0,0:06:30.84,0:06:33.95,Default,Reinhard,0,0,0,,Zatrzymam cię przed\Nwyrządzeniem dalszej szkody.
Dialogue: 0,0:06:34.55,0:06:36.95,Default,Reinhard,0,0,0,,Jeśli musisz kogoś nienawidzić, znienawidź\Nmnie.
Dialogue: 0,0:06:37.35,0:06:39.54,Default,Puck,0,0,0,,Nikogo nie nienawidzę, Reinhardzie.
Dialogue: 0,0:06:40.00,0:06:43.38,Default,Puck,0,0,0,,Jesteś prawdziwym bohaterem.
Dialogue: 0,0:06:43.99,0:06:46.24,Default,Puck,0,0,0,,I niczym więcej niż bohaterem być nie\Nmożesz.
Dialogue: 0,0:06:55.89,0:06:58.31,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:00.68,0:07:03.01,Default,Elsa,0,0,0,,I to koniec.
Dialogue: 0,0:07:03.10,0:07:06.17,Default,Elsa,0,0,0,,To nie była zbyt satysfakcjonująca praca.
Dialogue: 0,0:07:07.12,0:07:09.24,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:10.03,0:07:12.36,Default,Rem,0,0,0,,Tylko zapobiegłam pogorszeniu sytuacji.
Dialogue: 0,0:07:12.77,0:07:16.17,Default,Rem,0,0,0,,Widziałam, że dla Subaru-kuna\Nnie ma już ratunku.
Dialogue: 0,0:07:16.26,0:07:19.12,Default,Rem,0,0,0,,{\an8}Na pewno chciał, żebym zakończyła to jak\Nnajszybciej.
Dialogue: 0,0:07:16.86,0:07:19.12,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:19.58,0:07:21.83,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:21.96,0:07:24.08,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:24.21,0:07:26.21,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:26.41,0:07:28.29,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:28.38,0:07:29.96,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:29.87,0:07:31.23,Default - italics,SubaruVO,0,0,0,,Niepojęta teraźniejszość.
Dialogue: 0,0:07:31.32,0:07:33.60,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:33.69,0:07:35.98,Default - italics,SubaruVO,0,0,0,,Oto niepojęta teraźniejszość.
Dialogue: 0,0:07:43.22,0:07:47.51,Default,Rem,0,0,0,,Nie możesz już ustać na nogach,\NSubaru?
Dialogue: 0,0:07:55.19,0:07:56.34,Default,Subaru,0,0,0,,To nie może być prawda.
Dialogue: 0,0:07:56.43,0:07:57.87,Default,Rem,0,0,0,,To prawda.
Dialogue: 0,0:07:58.28,0:08:02.47,Default,Rem,0,0,0,,Będę przy tobie, kiedy tylko zechcesz,\NSubaru.
Dialogue: 0,0:08:03.84,0:08:04.72,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:08:04.81,0:08:07.81,Default,Rem,0,0,0,,Tak. Jestem twoją Rem.
Dialogue: 0,0:08:13.99,0:08:14.87,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:08:14.96,0:08:16.73,Default,Rem,0,0,0,,Tak, jestem Rem.
Dialogue: 0,0:08:16.82,0:08:20.68,Default,Rem,0,0,0,,Twoja własna, wszechstronna,\Nzawsze przydatna pokojówka.
Dialogue: 0,0:08:21.05,0:08:22.39,Default,Subaru,0,0,0,,Ty...
Dialogue: 0,0:08:22.91,0:08:25.94,Default,Rem,0,0,0,,Wszystko w porządku? Jesteś zmęczony?
Dialogue: 0,0:08:27.20,0:08:28.27,Default,Subaru,0,0,0,,Nie wiem...
Dialogue: 0,0:08:29.43,0:08:31.36,Default,Subaru,0,0,0,,Może jestem zmęczony.
Dialogue: 0,0:08:32.28,0:08:34.58,Default,Subaru,0,0,0,,Ale jeszcze nic nie zrobiłem...
Dialogue: 0,0:08:36.22,0:08:41.90,Default,Subaru,0,0,0,,Gdybym był silniejszy, mądrzejszy i zdolny\Ndo więcej,
Dialogue: 0,0:08:42.36,0:08:47.08,Default,Subaru,0,0,0,,Nie musieliby tak cierpieć.
Dialogue: 0,0:08:47.76,0:08:49.04,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:08:49.49,0:08:52.85,Default,Subaru,0,0,0,,Gdyby świat nadal trwał po mojej śmierci,
Dialogue: 0,0:08:52.94,0:08:56.05,Default,Subaru,0,0,0,,ile razy po prostu zostawiłem ich\Nwszystkich na śmierć?
Dialogue: 0,0:08:56.59,0:08:57.51,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:08:57.79,0:09:00.92,Default,Subaru,0,0,0,,Ile razy pozwoliłem ci umrzeć?
Dialogue: 0,0:09:01.88,0:09:04.55,Default,Subaru,0,0,0,,Ile razy mam cię zabić?!
Dialogue: 0,0:09:04.64,0:09:05.98,Default,Rem,0,0,0,,Subaru.
Dialogue: 0,0:09:08.51,0:09:10.02,Default,Rem,0,0,0,,W porządku.
Dialogue: 0,0:09:10.62,0:09:11.50,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:09:11.96,0:09:13.23,Default,Rem,0,0,0,,Kocham cię.
Dialogue: 0,0:09:14.57,0:09:16.66,Default,Rem,0,0,0,,Kocham cię, Subaru.
Dialogue: 0,0:09:17.20,0:09:20.03,Default,Rem,0,0,0,,Więc wszystko będzie dobrze.
Dialogue: 0,0:09:20.47,0:09:23.90,Default,Subaru,0,0,0,,T-To niczego... nie wyjaśnia...
Dialogue: 0,0:09:23.99,0:09:25.22,Default,Rem,0,0,0,,Wyjaśnia.
Dialogue: 0,0:09:25.67,0:09:29.00,Default,Rem,0,0,0,,To, że teraz tak cię obejmuję,
Dialogue: 0,0:09:29.69,0:09:31.21,Default,Rem,0,0,0,,jest odpowiedzią na wszystko.
Dialogue: 0,0:09:32.48,0:09:35.06,Default,Rem,0,0,0,,Tyle przeszedłeś, Subaru.
Dialogue: 0,0:09:35.64,0:09:37.87,Default,Rem,0,0,0,,Tak wiele wycierpiałeś w samotności...
Dialogue: 0,0:09:37.96,0:09:42.54,Default,Rem,0,0,0,,Ale nie musisz się już\Ncały czas czuć tak smutno.
Dialogue: 0,0:09:43.21,0:09:44.31,Default,Subaru,0,0,0,,Ja...
Dialogue: 0,0:09:45.08,0:09:48.18,Default,Rem,0,0,0,,Przyjmę na siebie wszystko, co czujesz.
Dialogue: 0,0:09:48.74,0:09:51.98,Default,Rem,0,0,0,,Po prostu powierz mi wszystko,
Dialogue: 0,0:09:52.07,0:09:54.03,Default,Rem,0,0,0,,i na razie odpocznij.
Dialogue: 0,0:09:54.61,0:09:56.57,Default,Rem,0,0,0,,Wystarczy, że zaśniesz.
Dialogue: 0,0:10:04.18,0:10:05.11,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:10:06.76,0:10:08.75,Default - flashback,Rem,0,0,0,,{\i1}Łatwo się poddać.{\i0}
Dialogue: 0,0:10:08.84,0:10:11.86,Default - flashback,Rem,0,0,0,,{\i1}Ale do ciebie to nie pasuje.{\i0}
Dialogue: 0,0:10:13.70,0:10:15.47,Default,Subaru,0,0,0,,Kim jesteś?
Dialogue: 0,0:10:15.56,0:10:16.44,Default,Rem,0,0,0,,Hę?
Dialogue: 0,0:10:16.53,0:10:19.43,Default,Subaru,0,0,0,,Pytam, kim jesteś.
Dialogue: 0,0:10:19.60,0:10:21.80,Default,Rem,0,0,0,,S-Subaru-kun, co ty—
Dialogue: 0,0:10:21.89,0:10:24.71,Default,Subaru,0,0,0,,Wiedziałem, że kiedy byłem u kresu sił,
Dialogue: 0,0:10:24.80,0:10:27.64,Default,Subaru,0,0,0,,skulony i pogrążony w rozpaczy,
Dialogue: 0,0:10:28.29,0:10:31.52,Default,Subaru,0,0,0,,zawsze przychodziłaś i łagodnie trwałaś\Nprzy mnie.
Dialogue: 0,0:10:32.02,0:10:36.32,Default,Subaru,0,0,0,,Wysłuchiwałaś moich problemów, pozwalałaś\Nmi wylać z siebie wszystkie obawy,
Dialogue: 0,0:10:36.76,0:10:39.61,Default,Subaru,0,0,0,,i wyciągałaś ze mnie wszystko, aż zabrakło\Nmi łez...
Dialogue: 0,0:10:40.01,0:10:43.83,Default,Subaru,0,0,0,,A potem mówiłaś: „A teraz wstań”.
Dialogue: 0,0:10:45.16,0:10:47.97,Default,Subaru,0,0,0,,Nie powiedziałabyś mi, żebym po prostu\Nodpoczął.
Dialogue: 0,0:10:48.06,0:10:51.12,Default,Subaru,0,0,0,,Nie kazałabyś mi się poddać i powierzyć ci\Nwszystkiego.
Dialogue: 0,0:10:51.67,0:10:54.11,Default,Subaru,0,0,0,,Lubisz mnie i ja ciebie.
Dialogue: 0,0:10:54.20,0:10:56.87,Default,Subaru,0,0,0,,Jesteś dla mnie dobra i kochasz mnie.
Dialogue: 0,0:10:56.96,0:10:59.61,Default,Subaru,0,0,0,,Ale jesteś też dla mnie surowsza niż\Nktokolwiek inny.
Dialogue: 0,0:10:59.70,0:11:02.35,Default,Subaru,0,0,0,,Rem to jedyna dziewczyna, która nigdy mi\Nnie pobłaża!
Dialogue: 0,0:11:02.44,0:11:05.10,Default,Rem,0,0,0,,Mylisz się! Posłuchaj mnie, Subaru!
Dialogue: 0,0:11:05.19,0:11:06.81,Default,Rem,0,0,0,,Nie chcę patrzeć, jak cierpisz—
Dialogue: 0,0:11:06.90,0:11:10.45,Default,Subaru,0,0,0,,Pokażę ci moją słabość i kruchość.
Dialogue: 0,0:11:10.54,0:11:13.19,Default,Subaru,0,0,0,,Ale nigdy nie pozwolę ci\Nzobaczyć, jak się poddaję!
Dialogue: 0,0:11:13.46,0:11:15.86,Default,Rem,0,0,0,,Bo jesteś moim bohaterem, Subaru!
Dialogue: 0,0:11:16.22,0:11:18.19,Default,Subaru,0,0,0,,Wynoś się stąd, ty oszustko!
Dialogue: 0,0:11:18.28,0:11:23.20,Default,Subaru,0,0,0,,Nie waż się mnie rozpieszczać,\Nużywając twarzy i głosu Rem!
Dialogue: 0,0:11:25.06,0:11:31.67,Default,Rem,0,0,0,,T-To nie tak... miało być...
Dialogue: 0,0:11:32.12,0:11:33.00,Default,Subaru,0,0,0,,Hę?
Dialogue: 0,0:11:42.31,0:11:44.04,Default,Subaru,0,0,0,,A ty kim jesteś?
Dialogue: 0,0:11:44.13,0:11:48.69,Default,Carmilla,0,0,0,,J-Jestem Carmilla, W-Czarownica Pożądania.
Dialogue: 0,0:11:48.78,0:11:50.53,Default,Carmilla,0,0,0,,Miło mi cię poznać.
Dialogue: 0,0:11:50.62,0:11:54.31,Default,Subaru,0,0,0,,Czy to dziwne miejsce jest\Nczęścią snu Echidny?
Dialogue: 0,0:11:55.30,0:11:57.56,Default,Subaru,0,0,0,,Co próbowałaś wcześniej zrobić?!
Dialogue: 0,0:11:57.96,0:11:59.28,Default,Carmilla,0,0,0,,Wcześniej?
Dialogue: 0,0:11:59.66,0:12:02.46,Default,Subaru,0,0,0,,Mówię o tym, że przyszłaś do mnie\Nprzebrana za Rem!
Dialogue: 0,0:12:02.55,0:12:04.11,Default,Subaru,0,0,0,,Czy to twoja moc?!
Dialogue: 0,0:12:04.20,0:12:05.72,Default,Carmilla,0,0,0,,N-nie!
Dialogue: 0,0:12:05.81,0:12:09.20,Default,Carmilla,0,0,0,,Gdybym wyglądała jak ktoś inny,
Dialogue: 0,0:12:09.29,0:12:13.45,Default,Carmilla,0,0,0,,To dlatego... że chciałeś mnie taką\Nwidzieć...
Dialogue: 0,0:12:13.54,0:12:14.42,Default,Subaru,0,0,0,,Co?!
Dialogue: 0,0:12:14.63,0:12:18.68,Default,Carmilla,0,0,0,,Nie chciałam,\Nale Echidna-chan powiedziała:
Dialogue: 0,0:12:18.77,0:12:20.66,Default,Carmilla,0,0,0,,że w-wystarczy cię rozpieszczać...
Dialogue: 0,0:12:20.75,0:12:22.75,Default,Subaru,0,0,0,,Więc Echidna {\i1}jest{\i0} za tym wszystkim?!
Dialogue: 0,0:12:22.84,0:12:25.26,Default,Echidna,0,0,0,,Dalszy ciąg zagrozi twojemu życiu.
Dialogue: 0,0:12:32.72,0:12:34.95,Default,Echidna,0,0,0,,„Oblubienica bez twarzy” Carmilli
Dialogue: 0,0:12:35.04,0:12:37.90,Default,Echidna,0,0,0,,sprawia, że zapominamy o\Noddychaniu w jej obecności.
Dialogue: 0,0:12:38.32,0:12:41.74,Default,Echidna,0,0,0,,W końcu nawet zatrzymuje\Nbicie serca.
Dialogue: 0,0:12:42.29,0:12:46.57,Default,Subaru,0,0,0,,Co ty, do diabła, knujesz, Echidno?
Dialogue: 0,0:12:46.66,0:12:48.02,Default,Echidna,0,0,0,,Czy to nie jest oczywiste?
Dialogue: 0,0:12:48.11,0:12:50.57,Default,Echidna,0,0,0,,Oczywiście zły plan. W końcu {\i1}jestem{\i0}\Nczarownicą.
Dialogue: 0,0:12:51.32,0:12:52.87,Default,Subaru,0,0,0,,Dlaczego zrobiłaś coś takiego?
Dialogue: 0,0:12:53.39,0:12:57.49,Default,Echidna,0,0,0,,Bo to była najbardziej\Nskuteczna metoda.
Dialogue: 0,0:12:57.58,0:12:59.25,Default,Echidna,0,0,0,,Gdybym nic nie zrobiła,
Dialogue: 0,0:12:59.34,0:13:02.98,Default,Echidna,0,0,0,,podczas Próby twój umysł\Nzostałby doszczętnie wyniszczony.
Dialogue: 0,0:13:03.49,0:13:06.13,Default,Subaru,0,0,0,,Więc mówisz, że zrobiłaś to, żeby mnie\Nocalić?
Dialogue: 0,0:13:07.16,0:13:11.48,Default,Echidna,0,0,0,,Nie mogę usprawiedliwić tego,\Nże zraniłam twoje serce.
Dialogue: 0,0:13:11.57,0:13:13.72,Default,Echidna,0,0,0,,Pogodziłam się z przyjęciem twojego\Ngniewu.
Dialogue: 0,0:13:22.88,0:13:26.32,Default,Echidna,0,0,0,,Wiem, co chcesz wiedzieć\Nnajbardziej.
Dialogue: 0,0:13:26.93,0:13:28.78,Default,Echidna,0,0,0,,Pozwól, że wyjaśnię ci próbę.
Dialogue: 0,0:13:29.74,0:13:31.75,Default,Echidna,0,0,0,,Tak jak pierwsza,
Dialogue: 0,0:13:31.84,0:13:35.85,Default,Echidna,0,0,0,,druga próba przenosi cię do świata\Nodtworzonego z twoich wspomnień.
Dialogue: 0,0:13:36.26,0:13:38.95,Default,Echidna,0,0,0,,To niezwykle dobrze skonstruowane\Nzłudzenie.
Dialogue: 0,0:13:40.50,0:13:41.38,Default,Subaru,0,0,0,,W takim razie—
Dialogue: 0,0:13:41.47,0:13:42.35,Default,Echidna,0,0,0,,Jednak...
Dialogue: 0,0:13:42.44,0:13:45.94,Default,Echidna,0,0,0,,Twój Powrót przez Śmierć to Autorytet\NCzarownicy Zazdrości.
Dialogue: 0,0:13:46.03,0:13:50.55,Default,Echidna,0,0,0,,W zasadzie tylko ona wie, czy to, co\Nwidziałeś
Dialogue: 0,0:13:50.64,0:13:53.74,Default,Echidna,0,0,0,,podczas drugiej próby wydarzyło się w\Njakiejś rzeczywistości.
Dialogue: 0,0:13:53.98,0:13:58.42,Default,Subaru,0,0,0,,To znaczy, że te rzeczy\Nmogły się naprawdę zdarzyć?
Dialogue: 0,0:13:58.51,0:14:00.75,Default,Echidna,0,0,0,,Mówię tylko, że istnieje taka możliwość.
Dialogue: 0,0:14:00.84,0:14:04.03,Default,Echidna,0,0,0,,Zamiast liczyć wszystkich,\Nktórych mogłeś nie ocalić,
Dialogue: 0,0:14:04.12,0:14:07.20,Default,Echidna,0,0,0,,powinieneś liczyć tych wszystkich, których\Nocaliłeś.
Dialogue: 0,0:14:07.29,0:14:09.29,Default,Subaru,0,0,0,,Takie idealistyczne banały nie pomagają!
Dialogue: 0,0:14:09.48,0:14:13.03,Default,Echidna,0,0,0,,Wiem, że wykorzystałeś całą swoją siłę,
Dialogue: 0,0:14:13.12,0:14:16.54,Default,Echidna,0,0,0,,fizyczną i psychiczną, żeby dotąd\Nprzetrwać.
Dialogue: 0,0:14:17.52,0:14:22.43,Default,Echidna,0,0,0,,Nic z tego, czego doświadczyłeś po drodze,\Nnie poszło na marne.
Dialogue: 0,0:14:23.20,0:14:26.71,Default,Echidna,0,0,0,,Dotarłeś do tej chwili, robiąc wszystko,\Nco w twojej mocy,
Dialogue: 0,0:14:26.80,0:14:28.59,Default,Echidna,0,0,0,,ryzykując własnym życiem.
Dialogue: 0,0:14:29.44,0:14:32.01,Default,Echidna,0,0,0,,Powinieneś być z tego dumny.
Dialogue: 0,0:14:33.82,0:14:38.94,Default,Subaru,0,0,0,,Dlaczego ciągle próbujesz mi pomóc?
Dialogue: 0,0:14:40.00,0:14:46.28,Default,Echidna,0,0,0,,To trochę nieuprzejme zmuszać dziewczynę,\Nżeby powiedziała to wprost.
Dialogue: 0,0:14:49.78,0:14:54.75,Default,Echidna,0,0,0,,Czy byłbyś gotów zawrzeć ze\Nmną kontrakt, Natsuki Subaru?
Dialogue: 0,0:14:55.81,0:14:57.27,Default,Subaru,0,0,0,,Kontrakt?
Dialogue: 0,0:14:57.36,0:15:00.97,Default,Echidna,0,0,0,,Tak, formalny kontrakt\Nz Czarownicą Chciwości.
Dialogue: 0,0:15:01.06,0:15:03.70,Default,Echidna,0,0,0,,Czy zawrzesz go ze mną?
Dialogue: 0,0:15:04.86,0:15:06.88,Default,Subaru,0,0,0,,Co się stanie, jeśli to zrobię?
Dialogue: 0,0:15:07.36,0:15:08.92,Default,Echidna,0,0,0,,To bardzo proste.
Dialogue: 0,0:15:09.28,0:15:13.00,Default,Echidna,0,0,0,,Od teraz, kiedy napotkasz przeszkodę,\Nktórej nie możesz pokonać,
Dialogue: 0,0:15:13.09,0:15:15.81,Default,Echidna,0,0,0,,kiedy poczujesz, że przygniata cię ciężar\Ngrzechów,
Dialogue: 0,0:15:15.90,0:15:17.92,Default,Echidna,0,0,0,,udzielę ci wsparcia.
Dialogue: 0,0:15:18.01,0:15:20.22,Default,Echidna,0,0,0,,Jestem pewna, że mam ogromną wiedzę.
Dialogue: 0,0:15:20.31,0:15:23.59,Default,Echidna,0,0,0,,Powinnam znaleźć sposób\Nna każdy twój problem.
Dialogue: 0,0:15:23.68,0:15:27.66,Default,Echidna,0,0,0,,Przede wszystkim mogę dzielić z tobą\Nzdolność Powrotu przez Śmierć.
Dialogue: 0,0:15:28.07,0:15:29.44,Default,Subaru,0,0,0,,Co to znaczy?
Dialogue: 0,0:15:30.01,0:15:33.37,Default,Subaru,0,0,0,,Naprawdę przedstawiasz mi zalety zawarcia\Nz tobą kontraktu?
Dialogue: 0,0:15:33.73,0:15:37.23,Default,Echidna,0,0,0,,Wydaje mi się oczywiste, że powinnam\Nwyjaśnić zalety takiego układu.
Dialogue: 0,0:15:37.32,0:15:41.26,Default,Echidna,0,0,0,,Tym lepiej dla mnie, jeśli choć trochę\Nskłoni cię to do zgody.
Dialogue: 0,0:15:41.64,0:15:42.94,Default,Echidna,0,0,0,,Wszystko mam skalkulowane.
Dialogue: 0,0:15:51.28,0:15:54.13,Default,Subaru,0,0,0,,To może nie być taki zły pomysł.
Dialogue: 0,0:15:54.22,0:15:55.47,Default,Echidna,0,0,0,,Co to znaczy?!
Dialogue: 0,0:15:57.95,0:16:00.13,Default,Echidna,0,0,0,,To znaczy... tak.
Dialogue: 0,0:16:00.22,0:16:03.85,Default,Echidna,0,0,0,,Jeśli koniecznie nalegasz, nie mam nic\Nprzeciwko zawarciu kontraktu—
Dialogue: 0,0:16:03.94,0:16:05.94,Default,Subaru,0,0,0,,Trochę za późno, żeby udawać obojętność!
Dialogue: 0,0:16:06.23,0:16:09.72,Default,Subaru,0,0,0,,W każdym razie, jak mamy\Nzawrzeć ten kontrakt?
Dialogue: 0,0:16:09.81,0:16:12.02,Default,Echidna,0,0,0,,Aby zawrzeć formalny kontrakt,
Dialogue: 0,0:16:12.11,0:16:15.74,Default,Echidna,0,0,0,,Ty i ja musimy stworzyć więź\Nmiędzy naszymi duszami.
Dialogue: 0,0:16:16.30,0:16:19.46,Default,Echidna,0,0,0,,Najpierw unosimy dłonie ku sobie, tak.
Dialogue: 0,0:16:29.38,0:16:30.78,Default,Subaru,0,0,0,,C-co?!
Dialogue: 0,0:16:34.96,0:16:36.54,Default,Minerva,0,0,0,,Muszę...
Dialogue: 0,0:16:37.51,0:16:39.31,Default,Minerva,0,0,0,,powstrzymać zawarcie tego kontraktu.
Dialogue: 0,0:16:40.80,0:16:42.18,Default,Subaru,0,0,0,,Czarownica Gniewu?!
Dialogue: 0,0:16:42.61,0:16:44.10,Default,Minerva,0,0,0,,Nie zgadzam się!
Dialogue: 0,0:16:44.55,0:16:46.71,Default,Echidna,0,0,0,,Tobie też na nim zależy?
Dialogue: 0,0:16:46.80,0:16:48.39,Default,Echidna,0,0,0,,Chyba jesteś zazdrosna.
Dialogue: 0,0:16:48.48,0:16:50.15,Default,Minerva,0,0,0,,Przestań mnie drażnić!
Dialogue: 0,0:16:50.24,0:16:53.78,Default,Minerva,0,0,0,,Jestem oburzona!
Dialogue: 0,0:16:53.87,0:16:56.47,Default,Minerva,0,0,0,,Aż kipię ze złości!
Dialogue: 0,0:16:56.56,0:16:58.71,Default,Subaru,0,0,0,,Jak ona tu w ogóle jest?
Dialogue: 0,0:16:58.80,0:17:02.71,Default,Subaru,0,0,0,,Czy inne czarownice nie muszą zamienić\Nsię z tobą miejscami, żeby się pojawić?
Dialogue: 0,0:17:02.80,0:17:03.96,Default,Minerva,0,0,0,,To kłamstwo!
Dialogue: 0,0:17:04.19,0:17:08.33,Default,Minerva,0,0,0,,To złośliwa kretynka, która bez powodu\Nrobi takie podłe sztuczki!
Dialogue: 0,0:17:09.63,0:17:12.23,Default,Echidna,0,0,0,,Nie chciałam przywoływać\Nkolejnych czarownic
Dialogue: 0,0:17:12.32,0:17:14.94,Default,Echidna,0,0,0,,ani pozwolić, by któraś mi cię odebrała.
Dialogue: 0,0:17:15.03,0:17:19.29,Default,Minerva,0,0,0,,Nie daj się tak łatwo omamić gładkim\Ngadaniem Echidny!
Dialogue: 0,0:17:19.38,0:17:20.59,Default,Minerva,0,0,0,,To mnie wkurza!
Dialogue: 0,0:17:20.68,0:17:23.20,Default,Minerva,0,0,0,,Nie powiedziała ci nawet,\Nktóre części umowy...
Dialogue: 0,0:17:23.29,0:17:24.19,Default,Minerva,0,0,0,,byłyby...
Dialogue: 0,0:17:24.28,0:17:25.16,Default,Minerva,0,0,0,,niekorzystne...
Dialogue: 0,0:17:25.25,0:17:26.73,Default,Minerva,0,0,0,,dla ciebie!
Dialogue: 0,0:17:26.88,0:17:28.93,Default,Subaru,0,0,0,,Czekaj! "Złe" dla mnie?!
Dialogue: 0,0:17:29.02,0:17:31.92,Default,Echidna,0,0,0,,Mówi o cenie, jaką zapłacisz za kontrakt\Nze mną.
Dialogue: 0,0:17:32.01,0:17:35.86,Default,Echidna,0,0,0,,Choć nazywanie tego czymś złym to chyba\Nlekka przesada.
Dialogue: 0,0:17:36.24,0:17:39.07,Default,Subaru,0,0,0,,Czego ode mnie chcesz?
Dialogue: 0,0:17:39.16,0:17:41.18,Default,Subaru,0,0,0,,Jaką cenę mam zapłacić?
Dialogue: 0,0:17:41.67,0:17:43.08,Default,Echidna,0,0,0,,To bardzo proste.
Dialogue: 0,0:17:43.64,0:17:47.22,Default,Echidna,0,0,0,,Wszystko, co czujesz, wszystko, co\Nmyślisz,
Dialogue: 0,0:17:47.31,0:17:49.35,Default,Echidna,0,0,0,,wszystko, co pozostaje w twoim sercu,
Dialogue: 0,0:17:49.44,0:17:51.14,Default,Echidna,0,0,0,,przyszłość, jaką znasz,
Dialogue: 0,0:17:51.23,0:17:52.86,Default,Echidna,0,0,0,,cokolwiek osiągniesz,
Dialogue: 0,0:17:52.95,0:17:55.02,Default,Echidna,0,0,0,,cały drzemiący w tobie potencjał,
Dialogue: 0,0:17:55.11,0:17:59.58,Default,Echidna,0,0,0,,wszystkie owoce nieznanego, które rodzą\Nsię z samego twojego istnienia...
Dialogue: 0,0:18:00.50,0:18:03.39,Default,Echidna,0,0,0,,Chcę tego skosztować.
Dialogue: 0,0:18:05.12,0:18:07.95,Default,Carmilla,0,0,0,,To wszystko prawda...
Dialogue: 0,0:18:08.04,0:18:12.22,Default,Carmilla,0,0,0,,A-Ale nie zakładaj, że powiedziała ci\Nwszystko...
Dialogue: 0,0:18:12.31,0:18:13.73,Default,Subaru,0,0,0,,Czarownica Pożądania?
Dialogue: 0,0:18:13.82,0:18:18.71,Default,Carmilla,0,0,0,,E-Echidna... nie kłamie...
Dialogue: 0,0:18:18.80,0:18:21.28,Default,Carmilla,0,0,0,,Ale wiele przed tobą ukrywa...
Dialogue: 0,0:18:21.72,0:18:25.94,Default,Echidna,0,0,0,,Nie zawracaj sobie głowy słuchaniem tej\Ndwójki, Natsuki Subaru.
Dialogue: 0,0:18:26.41,0:18:28.79,Default,Echidna,0,0,0,,Kiedy zawrzesz ze mną kontrakt,
Dialogue: 0,0:18:29.29,0:18:33.75,Default,Echidna,0,0,0,,Bez wątpienia poprowadzę cię do\Nprzyszłości, której pragniesz.
Dialogue: 0,0:18:34.16,0:18:38.92,Default,Sekhmet,0,0,0,,Czy to nie ta obietnica, którą zawsze\Nzaczynasz od słów „ostatecznie...”, co?
Dialogue: 0,0:18:39.97,0:18:41.77,Default,Subaru,0,0,0,,A kim ty jesteś?
Dialogue: 0,0:18:41.86,0:18:44.23,Default,Sekhmet,0,0,0,,Czarownica Lenistwa, Sekhmet.
Dialogue: 0,0:18:45.76,0:18:48.45,Default,Sekhmet,0,0,0,,Podaję ci tylko swoje imię, dla porządku.
Dialogue: 0,0:18:49.21,0:18:50.81,Default,Subaru,0,0,0,,Jesteś szóstą...
Dialogue: 0,0:18:51.10,0:18:56.58,Default,Sekhmet,0,0,0,,Jestem tu tylko jako strażniczka, żeby\Npilnować uczciwości tego miejsca.
Dialogue: 0,0:18:57.81,0:19:00.82,Default,Sekhmet,0,0,0,,Ale wypełnię swój obowiązek wobec niej.
Dialogue: 0,0:19:01.51,0:19:03.23,Default,Typhon,0,0,0,,Baru, jesteś tutaj?
Dialogue: 0,0:19:03.32,0:19:06.95,Default,Typhon,0,0,0,,Czy wszyscy już tu są? To niezwykłe!
Dialogue: 0,0:19:07.80,0:19:10.48,Default,Daphne,0,0,0,,Dawno nie urządzałyśmy herbatki.
Dialogue: 0,0:19:10.57,0:19:12.58,Default,Daphne,0,0,0,,Mógłbyś zaprosić i mnie.
Dialogue: 0,0:19:12.67,0:19:15.26,Default,Subaru,0,0,0,,Dlaczego ciągle pojawiacie się jedna po\Ndrugiej?!
Dialogue: 0,0:19:15.35,0:19:16.75,Default,Subaru,0,0,0,,Czego ode mnie chcecie?!
Dialogue: 0,0:19:16.84,0:19:18.60,Default,Sekhmet,0,0,0,,Chyba już ci mówiłam.
Dialogue: 0,0:19:19.32,0:19:23.42,Default,Sekhmet,0,0,0,,To obietnica, którą zawsze poprzedza\N„ostatecznie...”
Dialogue: 0,0:19:25.22,0:19:27.42,Default,Subaru,0,0,0,,„Ostatecznie”?
Dialogue: 0,0:19:30.70,0:19:37.70,Default,Subaru,0,0,0,,Echidno, mówiłaś, że poprowadzisz mnie do\Nnajlepszej możliwej przyszłości, prawda?
Dialogue: 0,0:19:37.84,0:19:40.74,Default,Echidna,0,0,0,,Tak. Mówiłam prawdę.
Dialogue: 0,0:19:40.83,0:19:44.53,Default,Subaru,0,0,0,,I z twoją pomocą, czy osiągnę\Nnajlepszą możliwą przyszłość
Dialogue: 0,0:19:44.94,0:19:47.52,Default,Subaru,0,0,0,,podążając najlepszą możliwą drogą?
Dialogue: 0,0:19:50.12,0:19:51.69,Default,Subaru,0,0,0,,Dlaczego nic nie mówisz?
Dialogue: 0,0:19:52.46,0:19:54.00,Default,Subaru,0,0,0,,Odpowiedz mi, Echidno!
Dialogue: 0,0:19:56.94,0:19:59.88,Default,Subaru,0,0,0,,Odpowiedz mi, Czarownico Chciwości!
Dialogue: 0,0:20:02.50,0:20:05.01,Default,Echidna,0,0,0,,W celu osiągnięcia przyszłości,\Nktórej pragniesz,
Dialogue: 0,0:20:05.10,0:20:08.09,Default,Echidna,0,0,0,,musisz zaakceptować wszystkie ofiary\Nponiesione po drodze.
Dialogue: 0,0:20:08.18,0:20:13.06,Default,Echidna,0,0,0,,Czy nie na to się zdecydowałeś, Natsuki\NSubaru?
Dialogue: 0,0:20:13.23,0:20:15.58,Default,Subaru,0,0,0,,Czekaj, czekaj, czekaj, czekaj, czekaj,\Nczekaj!
Dialogue: 0,0:20:15.67,0:20:17.39,Default,Echidna,0,0,0,,Nie, nie zaczekam.
Dialogue: 0,0:20:17.48,0:20:19.48,Default,Echidna,0,0,0,,To ty musisz lepiej zrozumieć.
Dialogue: 0,0:20:19.84,0:20:21.11,Default,Echidna,0,0,0,,Pomyśl o tym!
Dialogue: 0,0:20:21.50,0:20:25.08,Default,Echidna,0,0,0,,Autorytet Powrotu przez Śmierć, który\Nposiadasz, jest potężny.
Dialogue: 0,0:20:25.17,0:20:28.01,Default,Echidna,0,0,0,,Nie rozumiesz w pełni, jak naprawdę jest\Nprzydatny.
Dialogue: 0,0:20:28.10,0:20:32.14,Default,Echidna,0,0,0,,Pozwala ci wciąż zaczynać od nowa,\Naż osiągniesz wymarzoną przyszłość.
Dialogue: 0,0:20:32.23,0:20:36.03,Default,Echidna,0,0,0,,To ucieleśnienie największego ideału,\No jakim może marzyć każdy poszukiwacz!
Dialogue: 0,0:20:36.34,0:20:39.86,Default,Echidna,0,0,0,,Oczywiście nie zmuszę cię,\Nbyś użył Powrotu przez Śmierć.
Dialogue: 0,0:20:39.95,0:20:43.16,Default,Echidna,0,0,0,,Użyjesz go do osiągnięcia\Npożądanego wyniku.
Dialogue: 0,0:20:43.25,0:20:47.60,Default,Echidna,0,0,0,,I pożyczę ci całą mądrość, której\Npotrzebujesz, by spełnić twoje życzenie.
Dialogue: 0,0:20:47.80,0:20:50.60,Default,Echidna,0,0,0,,Oczekuję, że wszystkie rezultaty powstałe\Nw tym procesie
Dialogue: 0,0:20:50.69,0:20:54.85,Default,Echidna,0,0,0,,w ogromnym stopniu zaspokoją moją\Nciekawość!
Dialogue: 0,0:20:55.17,0:20:59.07,Default,Echidna,0,0,0,,Wspólnie stawimy czoła tym problemom\Ni znajdziemy rozwiązania.
Dialogue: 0,0:20:59.16,0:21:01.99,Default,Echidna,0,0,0,,To będzie optymalna relacja do osiągnięcia\Ntego celu!
Dialogue: 0,0:21:02.34,0:21:04.18,Default,Echidna,0,0,0,,Gdy ja będę korzystać z twojej mocy,
Dialogue: 0,0:21:04.27,0:21:07.93,Default,Echidna,0,0,0,,ty wykorzystuj mnie, żeby osiągnąć\Nnajlepszą możliwą przyszłość.
Dialogue: 0,0:21:08.02,0:21:13.11,Default,Echidna,0,0,0,,Moje dziewczęce uczucie do ciebie i chęć\Npomocy są szczere.
Dialogue: 0,0:21:13.20,0:21:15.99,Default,Echidna,0,0,0,,Chętnie pozwolę ci używać\Nmnie jak narzędzia.
Dialogue: 0,0:21:16.08,0:21:20.13,Default,Echidna,0,0,0,,Jeśli zechcesz, możesz nawet użyć mojego\Nciała dla własnej przyjemności!
Dialogue: 0,0:21:20.60,0:21:22.13,Default,Echidna,0,0,0,,Z radością ci je oddam!
Dialogue: 0,0:21:22.60,0:21:26.06,Default,Echidna,0,0,0,,Słowami dam ci siłę, by iść dalej.
Dialogue: 0,0:21:26.15,0:21:28.51,Default,Echidna,0,0,0,,Czy chcesz pocieszenia,\Nmotywacji, czy miłości,
Dialogue: 0,0:21:28.60,0:21:32.76,Default,Echidna,0,0,0,,a nawet nienawiści — dam ci wszystko. Mogę\Ndać ci wszystko!
Dialogue: 0,0:21:33.06,0:21:35.16,Default,Echidna,0,0,0,,Lubisz dziewczyny, które dają ci wszystko?
Dialogue: 0,0:21:35.26,0:21:37.06,Default,Echidna,0,0,0,,Potrzebujesz mnie!
Dialogue: 0,0:21:37.30,0:21:40.52,Default,Echidna,0,0,0,,Nikt oprócz ciebie nie może\Nzaspokoić mojej ciekawości.
Dialogue: 0,0:21:40.61,0:21:43.24,Default,Echidna,0,0,0,,Jeśli użyjesz swojej\Nmocy, by kogoś ocalić,
Dialogue: 0,0:21:43.33,0:21:44.84,Default,Echidna,0,0,0,,Chcę, żebyś ocalił mnie.
Dialogue: 0,0:21:44.93,0:21:47.99,Default,Echidna,0,0,0,,Nie mogę kontrolować własnej chciwości!
Dialogue: 0,0:21:48.08,0:21:52.45,Default,Echidna,0,0,0,,Cokolwiek się stanie, poprowadzę cię\Ndo przyszłości, której pragniesz.
Dialogue: 0,0:21:52.54,0:21:54.86,Default,Echidna,0,0,0,,Przysięgam! Naprawdę przysięgam!
Dialogue: 0,0:21:54.95,0:21:57.33,Default,Echidna,0,0,0,,A za tym czeka wyzwolenie Sanktuarium.
Dialogue: 0,0:21:57.42,0:22:02.30,Default,Echidna,0,0,0,,Możesz ocalić uwięzionych — ukochaną\Ni wszystkich, na których ci zależy!
Dialogue: 0,0:22:02.50,0:22:05.07,Default,Echidna,0,0,0,,W tym celu chcę, żebyś\Nmnie wziął, wykorzystał,
Dialogue: 0,0:22:05.16,0:22:07.11,Default,Echidna,0,0,0,,i wziął tyle mej chciwości, ile chcesz,
Dialogue: 0,0:22:07.20,0:22:08.65,Default,Echidna,0,0,0,,byśmy zdobyli przyszłość!
Dialogue: 0,0:22:08.74,0:22:10.63,Default,Echidna,0,0,0,,To wszystko, czego od ciebie pragnę,
Dialogue: 0,0:22:10.72,0:22:13.81,Default,,0,0,0,,i wszystko, co oferuję w zamian.
Dialogue: 0,0:22:13.90,0:22:19.04,Default,Echidna,0,0,0,,Powiedziałam ci wszystko... naprawdę,\Ndo ostatniego szczegółu, z pasją.
Dialogue: 0,0:22:19.13,0:22:22.41,Default,Echidna,0,0,0,,To może być coś bliskiego miłości. To\Nprzysięga miłości!
Dialogue: 0,0:22:22.50,0:22:24.90,Default,Echidna,0,0,0,,A jak odpowiesz na moją miłość?
Dialogue: 0,0:22:24.99,0:22:26.20,Default,Echidna,0,0,0,,Chcę twojej odpowiedzi!
Dialogue: 0,0:22:26.29,0:22:30.44,Default,Echidna,0,0,0,,To przecież jedna z odpowiedzi, które\Nzaspokoją moją ciekawość.
Dialogue: 0,0:22:36.54,0:22:37.46,Default,Subaru,0,0,0,,Echidna...
Dialogue: 0,0:22:37.55,0:22:38.74,Default,Echidna,0,0,0,,Tak?
Dialogue: 0,0:22:38.83,0:22:41.59,Default,Subaru,0,0,0,,Wykorzystasz mnie?
Dialogue: 0,0:22:41.68,0:22:42.59,Default,Echidna,0,0,0,,Tak.
Dialogue: 0,0:22:42.68,0:22:44.63,Default,Echidna,0,0,0,,I możesz zrobić to samo ze mną.
Dialogue: 0,0:22:44.72,0:22:46.50,Default,Echidna,0,0,0,,Po to jest ten kontrakt.
Dialogue: 0,0:22:46.77,0:22:49.34,Default,Echidna,0,0,0,,Jeśli chcesz mnie krytykować\Nza używanie go,
Dialogue: 0,0:22:49.43,0:22:52.08,Default,Echidna,0,0,0,,przyjmę zarzut, że chcę\Ncię tylko dla siebie.
Dialogue: 0,0:22:52.17,0:22:53.30,Default,Echidna,0,0,0,,To prawda.
Dialogue: 0,0:22:54.87,0:22:57.09,Default,Subaru,0,0,0,,Nie jest tak, że nigdy nie rozważałem
Dialogue: 0,0:22:57.67,0:23:00.67,Default,Subaru,0,0,0,,że twoje intencje mogą\Nnie być w 100% dobre.
Dialogue: 0,0:23:01.88,0:23:06.90,Default,Subaru,0,0,0,,Ale... to już gruba przesada!
Dialogue: 0,0:23:09.46,0:23:13.37,Default,Echidna,0,0,0,,Nie rozumiem, co jest dla\Nciebie tak problematyczne.
Dialogue: 0,0:23:13.88,0:23:17.24,Default,Subaru,0,0,0,,Wszystko w twoim nastawieniu\Njest takie dziecinne i płytkie!
Dialogue: 0,0:23:17.33,0:23:19.64,Default,Subaru,0,0,0,,To wszystko jest całkowicie powierzchowne!
Dialogue: 0,0:23:19.73,0:23:23.38,Default,Subaru,0,0,0,,Kiedy się śmiejesz, nawet kiedy jesteś\Nwściekła, twoja postawa jest...
Dialogue: 0,0:23:24.44,0:23:29.29,Default,Subaru,0,0,0,,Echidno, nie jesteś w stanie zrozumieć,\Njak czują się inni!
Dialogue: 0,0:23:30.91,0:23:33.56,Default,Subaru,0,0,0,,To akurat chwila, w której mogłabyś się\Nrozgniewać...
Dialogue: 0,0:23:35.12,0:23:37.62,Default,Echidna,0,0,0,,Rozumiem. Wiele mnie nauczyłeś.
Dialogue: 0,0:23:38.64,0:23:40.94,Default,Echidna,0,0,0,,Kiedy następnym razem\Nbędziemy mieli okazję...
Dialogue: 0,0:23:41.18,0:23:42.77,Default,Echidna,0,0,0,,Zrobię to.
Dialogue: 0,0:23:46.86,0:23:48.68,Default,Echidna,0,0,0,,Ale najpierw może usiądziesz?
Dialogue: 0,0:23:48.77,0:23:51.74,Default,Echidna,0,0,0,,Chciałabym jeszcze trochę omówić nasz\Nkontrakt.
Dialogue: 0,0:23:52.40,0:23:53.50,Default,Subaru,0,0,0,,Przypomniałem sobie...
Dialogue: 0,0:23:53.95,0:23:57.47,Default,Subaru,0,0,0,,Jest coś, o co chciałem cię zapytać, kiedy\Nznów cię zobaczę.
Dialogue: 0,0:23:57.56,0:23:59.33,Default,Echidna,0,0,0,,Och? A cóż takiego?
Dialogue: 0,0:23:59.42,0:24:03.42,Default,Subaru,0,0,0,,Po twojej odpowiedzi chyba zdołam podjąć\Ndecyzję.
Dialogue: 0,0:24:05.39,0:24:07.09,Default,Subaru,0,0,0,,Znasz Beatrice, prawda?
Dialogue: 0,0:24:07.45,0:24:08.68,Default,Echidna,0,0,0,,Tak, znam ją.
Dialogue: 0,0:24:08.77,0:24:12.26,Default,Echidna,0,0,0,,W końcu byłam głęboko zaangażowana w jej\Nnarodziny.
Dialogue: 0,0:24:12.55,0:24:14.75,Default,Subaru,0,0,0,,Beatrice spędziła życie związana\Nkontraktem,
Dialogue: 0,0:24:14.84,0:24:17.27,Default,Subaru,0,0,0,,który kazał jej czekać na „tę osobę”.
Dialogue: 0,0:24:17.36,0:24:20.51,Default,Subaru,0,0,0,,Wierzę, że zawarła go z tobą.
Dialogue: 0,0:24:20.60,0:24:22.74,Default,Echidna,0,0,0,,To prawda, to ja jej nakazałam chronić
Dialogue: 0,0:24:22.83,0:24:26.02,Default,Echidna,0,0,0,,zakazaną bibliotekę i czekać na tego, kto\Npo nią przyjdzie.
Dialogue: 0,0:24:26.11,0:24:28.88,Default,Subaru,0,0,0,,Więc kim jest "ta osoba"?
Dialogue: 0,0:24:28.97,0:24:30.82,Default,Subaru,0,0,0,,Jak mogę ją uwolnić?
Dialogue: 0,0:24:37.43,0:24:40.33,Default,Echidna,0,0,0,,Dobre pytanie! Któż to może być?
Dialogue: 0,0:24:41.79,0:24:42.68,Default,Subaru,0,0,0,,Co?!
Dialogue: 0,0:24:43.96,0:24:48.21,Default,Subaru,0,0,0,,Mówisz, że nawet nie wiesz,\Nna kogo czeka Beatrice?
Dialogue: 0,0:24:48.30,0:24:49.80,Default,Echidna,0,0,0,,Naprawdę nie wiem.
Dialogue: 0,0:24:50.16,0:24:51.41,Default,Subaru,0,0,0,,Ale dlaczego?
Dialogue: 0,0:24:51.87,0:24:54.23,Default,Subaru,0,0,0,,Czy to nie ty kazałaś jej czekać?!
Dialogue: 0,0:24:54.32,0:24:56.82,Default,Echidna,0,0,0,,Mocno to opacznie zrozumiałeś.
Dialogue: 0,0:24:57.24,0:25:00.32,Default,Echidna,0,0,0,,Nie kazałam Beatrice składać tej obietnicy\Npo to,
Dialogue: 0,0:25:00.41,0:25:02.76,Default,,0,0,0,,by przekazała zakazaną bibliotekę „tej\Nosobie”.
Dialogue: 0,0:25:03.03,0:25:03.91,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:25:04.04,0:25:06.62,Default,Echidna,0,0,0,,To nie był mój cel.
Dialogue: 0,0:25:07.02,0:25:11.38,Default,Echidna,0,0,0,,Kazałam jej obiecać, że będzie czekać, aż\N„ta osoba” do niej przyjdzie,
Dialogue: 0,0:25:11.47,0:25:14.35,Default,Echidna,0,0,0,,bo chcę się dowiedzieć, kogo wybierze
Dialogue: 0,0:25:14.95,0:25:16.86,Default,Echidna,0,0,0,,na „tę osobę”.
Dialogue: 0,0:25:18.99,0:25:23.72,Default,Echidna,0,0,0,,Oczywiście jednym ze skutków było to,\Nże przez 400 lat nikogo nie wybrała.
Dialogue: 0,0:25:23.81,0:25:26.99,Default,Echidna,0,0,0,,To, że dotąd nie potrafiła\Nłatwo nikogo wybrać,
Dialogue: 0,0:25:27.08,0:25:31.27,Default,Echidna,0,0,0,,i że w rozterce, czy nadal dotrzymywać\Nkontraktu, zapragnęła śmierci,
Dialogue: 0,0:25:31.36,0:25:32.91,Default,Echidna,0,0,0,,także jest jednym z rezultatów.
Dialogue: 0,0:25:34.00,0:25:36.72,Default,Subaru,0,0,0,,A co o tym myślisz?
Dialogue: 0,0:25:39.94,0:25:42.43,Default,Echidna,0,0,0,,Myślę, że to wspaniałe.
Dialogue: 0,0:25:42.85,0:25:44.43,Default,Subaru,0,0,0,,Echidna...
Dialogue: 0,0:25:45.51,0:25:47.35,Default,Subaru,0,0,0,,Jesteś czarownicą!
Dialogue: 0,0:25:48.76,0:25:52.26,Default,Subaru,0,0,0,,Jesteś niepojętym potworem, którego nie\Nsposób zrozumieć!
Dialogue: 0,0:25:53.35,0:25:54.41,Default,Subaru,0,0,0,,I ja...
Dialogue: 0,0:25:55.00,0:25:57.24,Default,Subaru,0,0,0,,Nie przyjmę twojej dłoni.
Dialogue: 0,0:25:58.16,0:26:00.74,Default,Subaru,0,0,0,,Wiem, czyją rękę chcę wziąć.
Dialogue: 0,0:26:02.08,0:26:05.55,Default,Subaru,0,0,0,,Jest dziewczyna skrępowana słowami,
Dialogue: 0,0:26:05.64,0:26:08.74,Default,,0,0,0,,które wypowiedziałaś z czystej ciekawości,\Nbez złych zamiarów.
Dialogue: 0,0:26:11.88,0:26:13.26,Default,Subaru,0,0,0,,Zdecydowałem się.
Dialogue: 0,0:26:13.35,0:26:15.40,Default,Subaru,0,0,0,,Wezmę {\i1}ją{\i0} za rękę.
Dialogue: 0,0:26:15.49,0:26:17.18,Default,Subaru,0,0,0,,Nie pójdę z tobą.
Dialogue: 0,0:26:25.75,0:26:26.63,Default,Minerva,0,0,0,,Jest tutaj.
Dialogue: 0,0:26:26.72,0:26:27.79,Default,Carmilla,0,0,0,,N-nie!
Dialogue: 0,0:26:27.88,0:26:30.47,Default,Carmilla,0,0,0,,Nie mam z tym nic wspólnego!
Dialogue: 0,0:26:29.45,0:26:34.25,Default,Sekhmet,0,0,0,,{\an8}Ta kłopotliwa dziewczyna zjawiła się\Nw złej chwili, by narobić problemów.
Dialogue: 0,0:26:34.57,0:26:39.16,Default,Daphne,0,0,0,,Czuję się bardzo, bardzo głodna!
Dialogue: 0,0:26:44.35,0:26:46.25,Default,Typhon,0,0,0,,To Tella!
Dialogue: 0,0:26:46.46,0:26:48.50,Default,Typhon,0,0,0,,Dawno się nie widziałyśmy!
Dialogue: 0,0:26:56.88,0:26:59.88,Episode Title,Title,0,0,0,,{\t(1,5000,\fs40)\c&HE1E1E1&}Herbatka {\c&H1BAF2E&}C{\c&H8AFFF9&}z{\c&HC0C0C0&}a{\c&HB1A9FA&}r{\c&H900086&}o{\c&HB4A8AA&}wnic
Dialogue: 0,0:26:58.50,0:27:05.50,Default,,0,0,0,,
