Dialogue: 0,0:00:10.36,0:00:11.54,Default,Puck,0,0,0,,Umrzyj.
Dialogue: 0,0:00:17.52,0:00:20.29,Default,Betel,0,0,0,,Mój mózg drży...
Dialogue: 0,0:00:20.59,0:00:21.51,Default,Subaru,0,0,0,,Puck!
Dialogue: 0,0:00:21.60,0:00:23.43,Default,Puck,0,0,0,,Cicho, Subaru.
Dialogue: 0,0:00:23.64,0:00:25.35,Default,,0,0,0,,Nie obchodzi mnie, co ty…
Dialogue: 0,0:00:29.99,0:00:32.80,Default,Betel,0,0,0,,Samozadowolenie! Zaniedbanie!\NTo jest lenistwo!
Dialogue: 0,0:00:32.89,0:00:36.39,Default,Betel,0,0,0,,Trzeba było mnie od razu zabić!
Dialogue: 0,0:00:37.09,0:00:38.97,Default,Betel,0,0,0,,Nawet mając taką władzę,
Dialogue: 0,0:00:39.06,0:00:42.07,Default,,0,0,0,,Nie zrobiłeś tego, co do ciebie należało!
Dialogue: 0,0:00:42.32,0:00:43.69,Default,Puck,0,0,0,,Głupota.
Dialogue: 0,0:00:46.15,0:00:48.15,Default,Puck,0,0,0,,Jeśli naprawdę chcesz mnie zabić...
Dialogue: 0,0:00:52.43,0:00:57.04,Default,Puck,0,0,0,,Wtedy wyrosło tysiąc cieni,\Npołowa tego, co potrafiła Satella...
Dialogue: 0,0:02:31.92,0:02:34.27,Default,Subaru,0,0,0,,Czy to ty... Puck?
Dialogue: 0,0:02:35.38,0:02:37.08,Default,Puck,0,0,0,,Nie widzisz tego?
Dialogue: 0,0:02:37.36,0:02:39.30,Default,Puck,0,0,0,,Może to okrutne, że o to pytam.
Dialogue: 0,0:02:41.75,0:02:43.35,Default,Betel,0,0,0,,Niewiarygodne...
Dialogue: 0,0:02:43.62,0:02:45.59,Default,Betel,0,0,0,,To niewiarygodne!
Dialogue: 0,0:02:45.68,0:02:47.60,Default,,0,0,0,,To niemożliwe!
Dialogue: 0,0:02:47.69,0:02:49.10,Default,Betel,0,0,0,,Zwykły duch...
Dialogue: 0,0:02:49.19,0:02:50.21,Default,Betel,0,0,0,,Moja wiara...
Dialogue: 0,0:02:50.30,0:02:51.99,Default,,0,0,0,,Wszystko, co kochałem...
Dialogue: 0,0:02:52.08,0:02:53.66,Default,Betel,0,0,0,,Z rąk zwykłego ducha—
Dialogue: 0,0:02:53.83,0:02:58.20,Default,Puck,0,0,0,,Człowiek żyjący zaledwie parę dekad\Nnie powinien prawić duchowi o czasie.
Dialogue: 0,0:02:58.51,0:03:02.11,Default,Betel,0,0,0,,Czas nie ma żadnego\Nzwiązku z głębią wiary!
Dialogue: 0,0:03:02.20,0:03:04.00,Default,Betel,0,0,0,,Chciałbym, żebyś mnie nie porównywał
Dialogue: 0,0:03:04.09,0:03:07.74,Default,Betel,0,0,0,,do takiego głupca jak ty,\Nistoty, która żyje wiecznie,
Dialogue: 0,0:03:07.83,0:03:10.41,Default,Betel,0,0,0,,ale większość tego czasu\Nmarnuje na bezczynność!
Dialogue: 0,0:03:10.50,0:03:13.97,Default,Betel,0,0,0,,{\an8}Ach, mój mózg mi drży, drży, drży...
Dialogue: 0,0:03:14.29,0:03:16.05,Default,Puck,0,0,0,,Śmierć nie jest nawet karą.
Dialogue: 0,0:03:17.01,0:03:19.63,Default,Puck,0,0,0,,Właśnie dlatego was wszystkich nienawidzę.
Dialogue: 0,0:03:19.72,0:03:21.92,Default,Betel,0,0,0,,Próba została zakończona.
Dialogue: 0,0:03:22.09,0:03:24.27,Default,Betel,0,0,0,,Nawet jeśli moje ciało umrze,
Dialogue: 0,0:03:24.36,0:03:26.78,Default,,0,0,0,,moje pragnienia staną u\Nboku tej czarownicy.
Dialogue: 0,0:03:26.87,0:03:28.17,Default,,0,0,0,,I przyjmę jej miłość.
Dialogue: 0,0:03:28.26,0:03:31.17,Default,Betel,0,0,0,,Nie mogę się doczekać naszego spotkania!
Dialogue: 0,0:03:32.50,0:03:34.10,Default,Puck,0,0,0,,Zrezygnował, gdy miał przewagę.
Dialogue: 0,0:03:37.78,0:03:40.49,Default,Puck,0,0,0,,Może porozmawiamy chwilę?
Dialogue: 0,0:03:40.58,0:03:43.97,Default,Puck,0,0,0,,Subaru, popełniłeś trzy grzechy.
Dialogue: 0,0:03:44.60,0:03:47.78,Default,Puck,0,0,0,,Po pierwsze, złamałeś obietnicę daną Lii.
Dialogue: 0,0:03:48.44,0:03:52.54,Default,Puck,0,0,0,,Wygląda na to, że nie rozumiesz,\Njak ważna jest obietnica
Dialogue: 0,0:03:53.34,0:03:55.56,Default,Puck,0,0,0,,dla osoby znającej sztuki duchowe.
Dialogue: 0,0:03:56.26,0:03:59.76,Default,Puck,0,0,0,,Po drugie, zignorowałeś\Nżyczenia Lii i wróciłeś tutaj.
Dialogue: 0,0:04:00.65,0:04:02.29,Default,Puck,0,0,0,,A po trzecie...
Dialogue: 0,0:04:04.30,0:04:06.02,Default,Puck,0,0,0,,To przez ciebie Lia zginęła!
Dialogue: 0,0:04:08.01,0:04:09.50,Default,Puck,0,0,0,,Zgodnie z moją umową,
Dialogue: 0,0:04:09.92,0:04:12.11,Default,Puck,0,0,0,,Teraz zniszczę świat.
Dialogue: 0,0:04:12.20,0:04:13.81,Default,Subaru,0,0,0,,Dlaczego?
Dialogue: 0,0:04:14.72,0:04:15.60,Default,Puck,0,0,0,,Lia to...
Dialogue: 0,0:04:16.98,0:04:20.20,Default,Puck,0,0,0,,Emilia jest sensem mojego życia.
Dialogue: 0,0:04:20.66,0:04:23.35,Default,Puck,0,0,0,,Nie ma dla mnie sensu życie\Nw świecie bez niej.
Dialogue: 0,0:04:24.65,0:04:26.18,Default,Puck,0,0,0,,Mgła się zbliża.
Dialogue: 0,0:04:26.83,0:04:29.37,Default,Puck,0,0,0,,Wygląda na to, że niezła zagadka.
Dialogue: 0,0:04:30.38,0:04:31.26,Default,Puck,0,0,0,,Obżarstwo...
Dialogue: 0,0:04:31.94,0:04:34.97,Default,Puck,0,0,0,,Ach, no to chyba teraz nazywają\Nto „Białym Wielorybem”.
Dialogue: 0,0:04:35.42,0:04:37.69,Default,Puck,0,0,0,,To ty tak postanowiłeś,\Npozwoliłeś Lii umrzeć,
Dialogue: 0,0:04:37.78,0:04:39.65,Default,Puck,0,0,0,,a teraz sam umrzesz.
Dialogue: 0,0:04:41.18,0:04:43.13,Default,Puck,0,0,0,,Jesteś naprawdę bezużyteczny.
Dialogue: 0,0:04:46.82,0:04:49.05,Default - italics,Subaru,0,0,0,,Już kiedyś słyszałem ten śmiech.
Dialogue: 0,0:04:49.44,0:04:52.20,Default - italics,Subaru,0,0,0,,Głos mężczyzny, którego\Nnienawidziłem z całego serca.
Dialogue: 0,0:04:53.46,0:04:56.45,Default - italics,Subaru,0,0,0,,Nie... To ja.
Dialogue: 0,0:04:56.54,0:04:57.90,Default - italics,Subaru,0,0,0,,Śmieję się z siebie.
Dialogue: 0,0:04:58.77,0:05:01.24,Default - italics,Subaru,0,0,0,,Pozwoliłem Rem umrzeć, zabiłem Emilię,
Dialogue: 0,0:05:01.33,0:05:03.91,Default - italics,Subaru,0,0,0,,a teraz umrę na próżno.
Dialogue: 0,0:05:04.16,0:05:06.49,Default - italics,Subaru,0,0,0,,Naprawdę jestem tak...
Dialogue: 0,0:05:07.97,0:05:09.81,Default,Puck,0,0,0,,Naprawdę jesteś leniwy, Subaru.
Dialogue: 0,0:05:21.42,0:05:22.30,Default,Rem,0,0,0,,Subaru?
Dialogue: 0,0:05:22.86,0:05:23.97,Default,Rem,0,0,0,,Co się stało?
Dialogue: 0,0:05:25.63,0:05:26.51,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:05:26.89,0:05:29.28,Default,Rem,0,0,0,,Tak, to ja, Rem.
Dialogue: 0,0:05:33.22,0:05:35.42,Default,Rem,0,0,0,,Przepraszam, że tego nie zauważyłam...
Dialogue: 0,0:05:35.78,0:05:37.94,Default,Rem,0,0,0,,Ten tłum cię męczy, prawda?
Dialogue: 0,0:05:38.37,0:05:39.71,Default,Subaru,0,0,0,,Męczy.
Dialogue: 0,0:05:40.40,0:05:42.70,Default,,0,0,0,,Tak, zgadza się...
Dialogue: 0,0:05:43.48,0:05:45.74,Default,Subaru,0,0,0,,Nie mam już siły, jestem wyczerpany...
Dialogue: 0,0:05:45.83,0:05:47.27,Default,Subaru,0,0,0,,Jestem zmęczony.
Dialogue: 0,0:06:03.15,0:06:04.42,Default,Rem,0,0,0,,Subaru!
Dialogue: 0,0:06:11.97,0:06:13.70,Default,Subaru,0,0,0,,Przepraszam za to...
Dialogue: 0,0:06:13.87,0:06:16.19,Default,Subaru,0,0,0,,Czułem się trochę zestresowany,
Dialogue: 0,0:06:16.33,0:06:18.63,Default,Subaru,0,0,0,,więc nie zadałem sobie trudu,\Nżeby to wyjaśnić.
Dialogue: 0,0:06:18.75,0:06:19.69,Default,,0,0,0,,Przepraszam.
Dialogue: 0,0:06:19.78,0:06:21.67,Default,Rem,0,0,0,,Naprawdę, nie wolno ci tego robić...
Dialogue: 0,0:06:21.76,0:06:26.00,Default,Rem,0,0,0,,Zdaję sobie sprawę, że poświęcasz\Nwiele uwagi naszej sytuacji.
Dialogue: 0,0:06:26.57,0:06:28.99,Default,Rem,0,0,0,,Ale podoba mi się, gdy\Njesteś taki stanowczy.
Dialogue: 0,0:06:29.38,0:06:31.06,Default,Subaru,0,0,0,,Przepraszam, że cię zmartwiłem.
Dialogue: 0,0:06:31.15,0:06:32.44,Default,,0,0,0,,Już wszystko w porządku.
Dialogue: 0,0:06:32.68,0:06:36.91,Default,Subaru,0,0,0,,Pewnie widziałeś, jak się zachowuję –\Njestem żałosny i ciągle przygnębiony...
Dialogue: 0,0:06:37.39,0:06:39.01,Default,Subaru,0,0,0,,Ale teraz to rozumiem.
Dialogue: 0,0:06:39.98,0:06:42.21,Default,Rem,0,0,0,,Rozumiesz już?
Dialogue: 0,0:06:42.72,0:06:44.68,Default,Subaru,0,0,0,,Zmęczyłem już wielu ludzi
Dialogue: 0,0:06:44.85,0:06:46.93,Default,,0,0,0,,po długich rozmyślaniach i zmaganiach,
Dialogue: 0,0:06:47.30,0:06:50.18,Default,Subaru,0,0,0,,ale w końcu udało mi się wszystko ogarnąć.
Dialogue: 0,0:06:50.66,0:06:53.27,Default,Subaru,0,0,0,,Albo, jak się nad tym dobrze zastanowić,
Dialogue: 0,0:06:53.36,0:06:55.68,Default,Subaru,0,0,0,,Od samego początku\Nmówiono mi, co mam robić.
Dialogue: 0,0:06:56.26,0:06:58.26,Default,Subaru,0,0,0,,Ale nie wiem, kiedy się poddać...
Dialogue: 0,0:06:58.81,0:07:01.96,Default,Rem,0,0,0,,Ale myślę, że właśnie to\Njest w tobie takie wspaniałe.
Dialogue: 0,0:07:04.33,0:07:07.25,Default,Subaru,0,0,0,,Rzeczy, z które uświadomiłem i\Ndo których doszedłem...
Dialogue: 0,0:07:07.70,0:07:11.33,Default,Subaru,0,0,0,,Doprowadziły mnie tu\Nróżnorodne doświadczenia,
Dialogue: 0,0:07:11.76,0:07:14.41,Default,Subaru,0,0,0,,ale tak naprawdę znam\Nodpowiedź już od dawna...
Dialogue: 0,0:07:16.90,0:07:18.70,Default,Subaru,0,0,0,,Podjąłem decyzję, Rem.
Dialogue: 0,0:07:19.28,0:07:20.16,Default,Rem,0,0,0,,Tak?
Dialogue: 0,0:07:23.97,0:07:25.54,Default,Subaru,0,0,0,,Ucieknij ze mną.
Dialogue: 0,0:07:26.05,0:07:27.70,Default,,0,0,0,,Tak daleko, jak to tylko możliwe.
Dialogue: 0,0:07:33.26,0:07:34.26,Default,Rem,0,0,0,,Co?
Dialogue: 0,0:07:34.77,0:07:37.42,Default,Subaru,0,0,0,,Zamierzam opuścić stolicę i\Nudać się daleko na zachód.
Dialogue: 0,0:07:37.58,0:07:38.54,Default,,0,0,0,,A może na północ.
Dialogue: 0,0:07:38.64,0:07:39.52,Default,Rem,0,0,0,,Hm...
Dialogue: 0,0:07:39.68,0:07:41.79,Default,Subaru,0,0,0,,Nie można wejść do południowego królestwa,
Dialogue: 0,0:07:41.88,0:07:42.81,Default,,0,0,0,,więc jeden wybór,
Dialogue: 0,0:07:42.98,0:07:44.35,Default,Subaru,0,0,0,,Nie lubię zimna,
Dialogue: 0,0:07:44.51,0:07:45.99,Default,,0,0,0,,Dlatego poleciłbym na zachód.
Dialogue: 0,0:07:46.09,0:07:47.31,Default,Rem,0,0,0,,Ach, hm...
Dialogue: 0,0:07:47.40,0:07:49.82,Default,Subaru,0,0,0,,Szczerze mówiąc, to może być długa droga,
Dialogue: 0,0:07:49.91,0:07:51.79,Default,,0,0,0,,i wiem, że to impuls,
Dialogue: 0,0:07:51.88,0:07:53.40,Default,Subaru,0,0,0,,więc nie łatwo —
Dialogue: 0,0:07:53.49,0:07:55.03,Default,Rem,0,0,0,,Proszę, poczekaj!
Dialogue: 0,0:07:55.58,0:07:58.58,Default,Rem,0,0,0,,Sposób, w jaki to powiedziałeś,\Nsprawia wrażenie, jakby
Dialogue: 0,0:07:58.97,0:08:03.27,Default,Rem,0,0,0,,planujesz wyjechać do jakiegoś innego\Nkraju, który nie jest Lugunicą...
Dialogue: 0,0:08:03.46,0:08:04.40,Default,Rem,0,0,0,,O!
Dialogue: 0,0:08:04.49,0:08:09.63,Default,Rem,0,0,0,,Znając cię, to pewnie dlatego, że\Nwpadłeś na kolejny świetny pomysł!
Dialogue: 0,0:08:09.81,0:08:12.53,Default,Rem,0,0,0,,Coś, co pomoże Emilii i Roswaalowi!
Dialogue: 0,0:08:12.62,0:08:14.21,Default,Subaru,0,0,0,,To nie o to chodzi, Rem.
Dialogue: 0,0:08:15.91,0:08:18.10,Default,Subaru,0,0,0,,W stolicy nic nie mogę zrobić.
Dialogue: 0,0:08:18.71,0:08:21.98,Default,Subaru,0,0,0,,Ale gdybym wrócił do rezydencji,\Nbyłbym równie bezradny.
Dialogue: 0,0:08:23.73,0:08:25.47,Default,Subaru,0,0,0,,Tak właśnie doszedłem do wniosku.
Dialogue: 0,0:08:26.21,0:08:29.14,Default,Subaru,0,0,0,,Więc ucieknij ze mną, Rem.
Dialogue: 0,0:08:29.82,0:08:31.75,Default,Subaru,0,0,0,,Nie możemy tu zostać.
Dialogue: 0,0:08:32.01,0:08:34.48,Default,Subaru,0,0,0,,Właśnie to wszyscy mi powtarzają.
Dialogue: 0,0:08:34.87,0:08:36.73,Default,Subaru,0,0,0,,Nie chciałem w to wierzyć,
Dialogue: 0,0:08:36.82,0:08:38.93,Default,,0,0,0,,więc zaprzeczałem temu z\Ncałych sił, ale...
Dialogue: 0,0:08:39.57,0:08:40.74,Default,Subaru,0,0,0,,Tak, mają rację.
Dialogue: 0,0:08:41.34,0:08:43.51,Default,Subaru,0,0,0,,Nikt nigdy mnie nie potrzebował.
Dialogue: 0,0:08:43.60,0:08:44.87,Default,Rem,0,0,0,,To nie jest…
Dialogue: 0,0:08:44.51,0:08:45.80,Default,Subaru,0,0,0,,To prawda!
Dialogue: 0,0:08:46.14,0:08:49.69,Default,Subaru,0,0,0,,Wielokrotnie mi to wyjaśniano...
Dialogue: 0,0:08:50.78,0:08:53.22,Default,Subaru,0,0,0,,Dlatego postanowiłem po prostu zniknąć.
Dialogue: 0,0:08:53.72,0:08:54.60,Default,Subaru,0,0,0,,Tak lepiej.
Dialogue: 0,0:08:54.69,0:08:57.76,Default,,0,0,0,,Cokolwiek zrobię, skończy\Nsię to tylko śmiercią...
Dialogue: 0,0:08:57.96,0:08:59.86,Default,Subaru,0,0,0,,zależnie od rozwoju wypadków.
Dialogue: 0,0:09:02.51,0:09:04.08,Default,Subaru,0,0,0,,Mam już tego dość.
Dialogue: 0,0:09:04.98,0:09:06.26,Default,Subaru,0,0,0,,Chodźmy, ucieknijmy Rem.
Dialogue: 0,0:09:06.58,0:09:08.08,Default,,0,0,0,,Nie możemy tu zostać.
Dialogue: 0,0:09:09.23,0:09:10.98,Default,Subaru,0,0,0,,Nie powinniśmy tu być!
Dialogue: 0,0:09:12.44,0:09:14.57,Default,Rem,0,0,0,,Ale to takie nagłe...
Dialogue: 0,0:09:15.35,0:09:16.85,Default,Subaru,0,0,0,,Nie mamy czasu!
Dialogue: 0,0:09:16.94,0:09:18.99,Default,Subaru,0,0,0,,Przepraszam, że to takie nagłe.
Dialogue: 0,0:09:19.67,0:09:22.21,Default,Subaru,0,0,0,,Naprawdę, naprawdę tak jest.
Dialogue: 0,0:09:23.81,0:09:25.12,Default,Subaru,0,0,0,,Ale dokonaj wyboru.
Dialogue: 0,0:09:25.45,0:09:26.71,Default,Rem,0,0,0,,Wybrać?
Dialogue: 0,0:09:26.92,0:09:29.25,Default,Subaru,0,0,0,,Ja? A może ktoś inny?
Dialogue: 0,0:09:29.59,0:09:30.47,Default,Subaru,0,0,0,,Wybierz.
Dialogue: 0,0:09:32.30,0:09:35.12,Default,Subaru,0,0,0,,Weźmy powóz ciągnięty przez\Nsmoki i ruszajmy na zachód.
Dialogue: 0,0:09:35.72,0:09:39.11,Default,Subaru,0,0,0,,Opuścimy Lugunicę i udamy się daleko na\Nzachód… Do Kararagi
Dialogue: 0,0:09:39.51,0:09:42.32,Default,Subaru,0,0,0,,Kupimy mały domek i będziemy\Ntam mieszkać razem.
Dialogue: 0,0:09:43.23,0:09:44.74,Default,Subaru,0,0,0,,Nawet jeśli zdarzą złe rzeczy,
Dialogue: 0,0:09:44.90,0:09:46.70,Default,,0,0,0,,Mogę iść dalej, jeśli będziesz obok.
Dialogue: 0,0:09:47.28,0:09:49.93,Default,Subaru,0,0,0,,Wystarczy, że ktoś czeka na\Nmnie w domu z uśmiechem...
Dialogue: 0,0:09:50.28,0:09:51.64,Default,Subaru,0,0,0,,Nieważne, czy zmęczony,
Dialogue: 0,0:09:51.73,0:09:54.21,Default,,0,0,0,,jeśli wiem, że na mnie czekasz, to wiem...
Dialogue: 0,0:09:56.61,0:09:58.13,Default,Subaru,0,0,0,,Proszę, wybierz mnie!
Dialogue: 0,0:09:58.95,0:10:02.14,Default,Subaru,0,0,0,,Jeśli mnie wybierzesz, dam\Nci wszystko, co mam!
Dialogue: 0,0:10:02.93,0:10:03.84,Default,Subaru,0,0,0,,Więc proszę...
Dialogue: 0,0:10:04.91,0:10:06.15,Default,,0,0,0,,Ucieknij ze mną.
Dialogue: 0,0:10:06.61,0:10:08.04,Default,Subaru,0,0,0,,Zamieszkaj ze mną!
Dialogue: 0,0:10:16.05,0:10:17.31,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:10:18.83,0:10:21.93,Default,Rem,0,0,0,,Nie mogę z tobą uciec.
Dialogue: 0,0:10:22.68,0:10:24.98,Default,Rem,0,0,0,,Powinniśmy się razem śmiać,
Dialogue: 0,0:10:25.36,0:10:27.68,Default,,0,0,0,,kiedy rozmawiamy o przyszłości, pamiętasz?
Dialogue: 0,0:10:29.21,0:10:33.23,Default,Subaru,0,0,0,,Może teraz nie możemy się\Nz tego śmiać, ale...
Dialogue: 0,0:10:33.52,0:10:36.31,Default,,0,0,0,,Wiesz, jak już się w końcu\Nzabierzemy do roboty,
Dialogue: 0,0:10:36.40,0:10:37.34,Default,,0,0,0,,damy radę
Dialogue: 0,0:10:36.92,0:10:38.61,Default,Rem,0,0,0,,Ja też o tym myślałam.
Dialogue: 0,0:10:42.50,0:10:44.02,Default,Rem,0,0,0,,Dotrzemy do Kararagi,
Dialogue: 0,0:10:44.27,0:10:45.71,Default,,0,0,0,,i wynajmiemy mieszkanie.
Dialogue: 0,0:10:46.33,0:10:49.05,Default,Rem,0,0,0,,Dopóki będziemy mieli dom i pracę,
Dialogue: 0,0:10:49.14,0:10:50.38,Default,,0,0,0,,damy radę.
Dialogue: 0,0:10:51.08,0:10:55.82,Default,Rem,0,0,0,,Na szczęście, dzięki panu Roswaalowi,\Notrzymałam wykształcenie,
Dialogue: 0,0:10:56.06,0:11:00.05,Default,Rem,0,0,0,,Myślę więc, że bez problemu znalazłabym\Npracę, nawet w Kararagi.
Dialogue: 0,0:11:00.23,0:11:03.47,Default,Rem,0,0,0,,Być może będziesz musiała poszukać\Npracy fizycznej
Dialogue: 0,0:11:03.61,0:11:07.30,Default,Rem,0,0,0,,albo zająć się moimi sprawami.
Dialogue: 0,0:11:08.18,0:11:10.12,Default,Rem,0,0,0,,Kiedy już będziemy mieli stały dochód,
Dialogue: 0,0:11:10.21,0:11:12.64,Default,,0,0,0,,moglibyśmy poszukać\Nlepszego miejsca do życia.
Dialogue: 0,0:11:13.15,0:11:14.95,Default,Rem,0,0,0,,W międzyczasie możesz się uczyć
Dialogue: 0,0:11:15.08,0:11:18.33,Default,,0,0,0,,przez około rok, abyś mogła znaleźć
Dialogue: 0,0:11:18.66,0:11:22.16,Default,Rem,0,0,0,,przyzwoitą pracę, dopóki nie\Nznajdziesz docelowej pracy.
Dialogue: 0,0:11:23.00,0:11:24.40,Default,Rem,0,0,0,,Będziemy współpracować.
Dialogue: 0,0:11:24.50,0:11:28.37,Default,,0,0,0,,A jak już będziemy mieli dużo\Npieniędzy, może uda nam się kupić dom.
Dialogue: 0,0:11:29.34,0:11:31.66,Default,Rem,0,0,0,,Może moglibyśmy nawet otworzyć sklep.
Dialogue: 0,0:11:32.10,0:11:34.69,Default,Rem,0,0,0,,W końcu Kararagi to tętniące\Nżyciem miejsce.
Dialogue: 0,0:11:34.78,0:11:37.84,Default,Rem,0,0,0,,Jestem pewna, że moglibyśmy zarabiać\Nna życie twoim pomysłom.
Dialogue: 0,0:11:38.68,0:11:40.34,Default,Rem,0,0,0,,A kiedy już nasze życie ułoży...
Dialogue: 0,0:11:40.91,0:11:43.11,Default,Rem,0,0,0,,Hm, trochę mi wstyd to przyznać,
Dialogue: 0,0:11:43.42,0:11:44.82,Default,,0,0,0,,ale moglibyśmy mieć dziecko.
Dialogue: 0,0:11:44.91,0:11:46.96,Default,Rem,0,0,0,,Byłaby to istota pół-demon, pół-człowiek,
Dialogue: 0,0:11:47.07,0:11:49.30,Default,,0,0,0,,więc jestem pewien,\Nże byłaby pełna energii.
Dialogue: 0,0:11:49.39,0:11:51.54,Default,Rem,0,0,0,,Nieważne, czy to chłopiec,\Nczy dziewczynka,
Dialogue: 0,0:11:51.70,0:11:53.02,Default,Rem,0,0,0,,bliźniaki, czy trojaczki,
Dialogue: 0,0:11:53.11,0:11:54.87,Default,,0,0,0,,Wiem, że byłyby urocze.
Dialogue: 0,0:11:56.13,0:11:58.69,Default,Rem,0,0,0,,Jestem pewna, że nie\Nwszystko byłoby tylko zabawą.
Dialogue: 0,0:11:59.06,0:12:02.51,Default,Rem,0,0,0,,Nie wszystko potoczyło się tak,\Njak sobie to wyobrażałam.
Dialogue: 0,0:12:03.36,0:12:07.22,Default,Rem,0,0,0,,Może będą tylko córki, a nie synowie,
Dialogue: 0,0:12:07.60,0:12:11.33,Default,Rem,0,0,0,,możesz więc nie czuć się\Ndumna ze swojej rodziny.
Dialogue: 0,0:12:11.68,0:12:12.59,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:12:12.73,0:12:15.14,Default,Rem,0,0,0,,Ale… Ale… Nawet gdy dzieci dorosną
Dialogue: 0,0:12:15.29,0:12:18.31,Default,Rem,0,0,0,,i osiągną wiek, w którym\Nzaczną cię traktować oschle,
Dialogue: 0,0:12:18.44,0:12:20.50,Default,Rem,0,0,0,,Nadal będę po twojej stronie!
Dialogue: 0,0:12:20.86,0:12:24.01,Default,Rem,0,0,0,,W okolicy będziemy znani\Njako para starych zakochanych,
Dialogue: 0,0:12:25.22,0:12:30.97,Default,Rem,0,0,0,,spokojnie spędzimy razem życie\Ni zestarzejemy się...
Dialogue: 0,0:12:31.93,0:12:32.81,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:12:32.98,0:12:35.50,Default,Rem,0,0,0,,Byłoby mi przykro, gdybym ci to zrobił,
Dialogue: 0,0:12:35.70,0:12:38.25,Default,Rem,0,0,0,,ale wolałabym umrzeć przed\Ntobą, jeśli to możliwe.
Dialogue: 0,0:12:38.60,0:12:39.81,Default,Rem,0,0,0,,Chcę umrzeć w spokoju,
Dialogue: 0,0:12:39.90,0:12:42.10,Default,,0,0,0,,leżąc na naszym łóżku,\Ntrzymając cię za rękę,
Dialogue: 0,0:12:42.19,0:12:45.03,Default,Rem,0,0,0,,w otoczeniu naszych dzieci i ich dzieci.
Dialogue: 0,0:12:45.26,0:12:48.93,Default,Rem,0,0,0,,Powiedzieć: „Byłam taki szczęśliwa”,
Dialogue: 0,0:12:49.02,0:12:51.37,Default,,0,0,0,,podczas gdy wszyscy patrzyliby...
Dialogue: 0,0:12:52.76,0:12:57.66,Default,Rem,0,0,0,,Mogłabym zakończyć swoje\Nżycie szczęśliwie, tak bardzo szczęśliwie.
Dialogue: 0,0:12:58.06,0:12:59.17,Default,Subaru,0,0,0,,Jeśli...
Dialogue: 0,0:12:59.90,0:13:03.47,Default,Subaru,0,0,0,,Jeśli aż tak bardzo tego chcesz, to...
Dialogue: 0,0:13:04.01,0:13:07.69,Default,Rem,0,0,0,,Gdybym mógł z uśmiechem\Npomarzyć o takiej przyszłości,
Dialogue: 0,0:13:08.58,0:13:12.47,Default,Rem,0,0,0,,Byłabym naprawdę szczęśliwa,\Nmogąc umrzeć w ten sposób...
Dialogue: 0,0:13:14.03,0:13:16.25,Default,Rem,0,0,0,,Gdybym tylko mógł z tobą mieszkać.
Dialogue: 0,0:13:16.81,0:13:21.94,Default,Rem,0,0,0,,Wystarczy, że wiem, że chcesz,\Nżebym była przy tobie, kiedy uciekasz
Dialogue: 0,0:13:22.15,0:13:24.56,Default,Rem,0,0,0,,sprawia, że czuję się\Nszczęśliwa z całego serca.
Dialogue: 0,0:13:25.66,0:13:27.45,Default,Rem,0,0,0,,Ale nie potrafię.
Dialogue: 0,0:13:28.11,0:13:29.26,Default,Rem,0,0,0,,Ponieważ wiem
Dialogue: 0,0:13:29.87,0:13:31.66,Default,,0,0,0,,że gdybyśmy teraz razem uciekli,
Dialogue: 0,0:13:32.51,0:13:36.81,Default,Rem,0,0,0,,musiałabym zostawić Subaru,\Nktórego kocham ponad wszystko.
Dialogue: 0,0:13:38.39,0:13:39.33,Default,Rem,0,0,0,,Subaru,
Dialogue: 0,0:13:40.21,0:13:42.43,Default,,0,0,0,,Proszę, powiedz mi, co się stało.
Dialogue: 0,0:13:43.72,0:13:46.13,Default,Rem,0,0,0,,Jeśli nie możesz, proszę, zaufaj mi.
Dialogue: 0,0:13:46.42,0:13:48.83,Default,Rem,0,0,0,,Zrobię wszystko, żeby to naprawić.
Dialogue: 0,0:13:50.89,0:13:53.03,Default,Rem,0,0,0,,Ale na razie powinniśmy wrócić.
Dialogue: 0,0:13:53.12,0:13:56.19,Default,Rem,0,0,0,,Nie będziemy się spieszyć i\Nspokojnie wszystko przemyślimy,
Dialogue: 0,0:13:56.28,0:13:58.75,Default,Rem,0,0,0,,może znajdziemy inne rozwiązanie.
Dialogue: 0,0:13:59.68,0:14:01.57,Default,Subaru,0,0,0,,Już się nad tym długo zastanawiałem.
Dialogue: 0,0:14:01.66,0:14:02.83,Default,Subaru,0,0,0,,Zastanawiałem się.
Dialogue: 0,0:14:02.92,0:14:04.09,Default,,0,0,0,,Wiele wycierpiałem.
Dialogue: 0,0:14:04.70,0:14:07.44,Default,Subaru,0,0,0,,Właśnie dlatego się poddałem.
Dialogue: 0,0:14:08.95,0:14:11.83,Default,Rem,0,0,0,,Łatwo jest się poddać, ale...
Dialogue: 0,0:14:14.70,0:14:17.06,Default,Subaru,0,0,0,,Łatwo jest się poddać?
Dialogue: 0,0:14:17.49,0:14:18.40,Default,Rem,0,0,0,,Subaru?
Dialogue: 0,0:14:18.49,0:14:20.01,Default,Subaru,0,0,0,,Nie wciskaj mi tego!
Dialogue: 0,0:14:20.10,0:14:23.26,Default,Subaru,0,0,0,,Poddanie się nie jest wcale łatwe!
Dialogue: 0,0:14:24.24,0:14:25.78,Default,Subaru,0,0,0,,Myślisz, że nic nie robię,
Dialogue: 0,0:14:25.87,0:14:27.36,Default,,0,0,0,,nie myśląc o niczym,
Dialogue: 0,0:14:27.45,0:14:29.24,Default,Subaru,0,0,0,,odcinając się,
Dialogue: 0,0:14:29.33,0:14:31.25,Default,,0,0,0,,i wyrzucając wszystko do kosza!
Dialogue: 0,0:14:31.34,0:14:35.02,Default,Subaru,0,0,0,,I to wystarczyło, żeby się poddać?!
Dialogue: 0,0:14:36.13,0:14:38.94,Default,Subaru,0,0,0,,Nie było łatwo się poddać!
Dialogue: 0,0:14:39.28,0:14:41.84,Default,Subaru,0,0,0,,O wiele łatwiej było mi myśleć
Dialogue: 0,0:14:42.07,0:14:44.26,Default,,0,0,0,,Było coś, co mogłem zrobić!
Dialogue: 0,0:14:45.28,0:14:47.19,Default,Subaru,0,0,0,,Ale nic nie mogę na to poradzić...
Dialogue: 0,0:14:47.46,0:14:49.13,Default,Subaru,0,0,0,,Nie ma wyjścia!
Dialogue: 0,0:14:49.54,0:14:51.89,Default,Subaru,0,0,0,,Jedyna droga którą idę, to poddanie się!
Dialogue: 0,0:14:52.20,0:14:53.66,Default,Subaru,0,0,0,,Gdybym tylko...
Dialogue: 0,0:14:54.39,0:14:57.25,Default,Subaru,0,0,0,,Chciałbym... Chciałbym...
Dialogue: 0,0:15:01.09,0:15:02.26,Default,Rem,0,0,0,,Subaru...
Dialogue: 0,0:15:04.45,0:15:06.43,Default,Rem,0,0,0,,Łatwo jest się poddać.
Dialogue: 0,0:15:07.36,0:15:10.53,Default,Rem,0,0,0,,Ale to do ciebie nie pasuje.
Dialogue: 0,0:15:12.31,0:15:15.28,Default,Rem,0,0,0,,Nie wiem, jakie bolesne\Ndoświadczenia cię spotkały,
Dialogue: 0,0:15:15.69,0:15:19.89,Default,Rem,0,0,0,,albo co takiego zrobiłeś, że tak cierpisz.
Dialogue: 0,0:15:21.00,0:15:23.05,Default,Rem,0,0,0,,Wiem, że to byłoby z mojej strony złe
Dialogue: 0,0:15:23.28,0:15:25.70,Default,,0,0,0,,bez zastanowienia powiedzieć, że rozumiem
Dialogue: 0,0:15:26.33,0:15:28.36,Default,Rem,0,0,0,,Ale… Ale mimo to…
Dialogue: 0,0:15:29.20,0:15:31.39,Default,Rem,0,0,0,,Jedno wiem na pewno.
Dialogue: 0,0:15:33.14,0:15:38.08,Default,Rem,0,0,0,,Wiem, że jesteś osobą, która nie\Npotrafi zrezygnować w połowie drogi.
Dialogue: 0,0:15:39.87,0:15:43.54,Default,Rem,0,0,0,,Wiem, że jesteś osobą, która\Npotrafi się uśmiechać
Dialogue: 0,0:15:44.16,0:15:47.25,Default,Rem,0,0,0,,gdy mówisz o swoich planach na przyszłość.
Dialogue: 0,0:15:47.91,0:15:49.22,Default,Rem,0,0,0,,Wiem...
Dialogue: 0,0:15:49.98,0:15:53.49,Default,Rem,0,0,0,,Wiem, że jesteś osobą, która nie\Npotrafi zrezygnować z przyszłości.
Dialogue: 0,0:15:54.05,0:15:55.13,Default,Subaru,0,0,0,,Mylisz się.
Dialogue: 0,0:15:55.96,0:15:58.39,Default,,0,0,0,,Nie jestem takim typem...
Dialogue: 0,0:15:58.48,0:15:59.36,Default,Rem,0,0,0,,Nie mylę się.
Dialogue: 0,0:15:59.74,0:16:01.32,Default,Rem,0,0,0,,Nie zrezygnowałeś z nikogo.
Dialogue: 0,0:16:01.66,0:16:03.80,Default,Rem,0,0,0,,Nie „Emilia” ani „Siostra”.
Dialogue: 0,0:16:03.89,0:16:09.30,Default,,0,0,0,,Albo pan Roswaal, albo pani Beatrice,\Nalbo ktokolwiek inny.
Dialogue: 0,0:16:10.04,0:16:12.65,Default,Subaru,0,0,0,,Ja... ja się poddałem!
Dialogue: 0,0:16:12.88,0:16:15.54,Default,Subaru,0,0,0,,Od początku nie było mowy,\Nżeby to wszystko unieść!
Dialogue: 0,0:16:15.93,0:16:17.66,Default,Subaru,0,0,0,,Moje dłonie są takie małe
Dialogue: 0,0:16:17.75,0:16:20.56,Default,,0,0,0,,że wszystko mi się wymknęło\Nz rąk i nic nie zostało.
Dialogue: 0,0:16:21.00,0:16:24.31,Default,Rem,0,0,0,,Nie, to nieprawda. Masz…
Dialogue: 0,0:16:24.40,0:16:26.93,Default,Subaru,0,0,0,,No proszę, kto by pomyślał?!
Dialogue: 0,0:16:27.02,0:16:29.86,Default,Subaru,0,0,0,,Co ty o mnie wiesz?!
Dialogue: 0,0:16:30.67,0:16:32.78,Default,Subaru,0,0,0,,Oto jaki jestem!
Dialogue: 0,0:16:33.22,0:16:35.57,Default,Subaru,0,0,0,,Nie mam siły, ale pragnę tego wszystkiego.
Dialogue: 0,0:16:35.66,0:16:37.66,Default,Subaru,0,0,0,,Nie mam pojęcia, tylko wciąż marzę.
Dialogue: 0,0:16:37.75,0:16:40.50,Default,Subaru,0,0,0,,Nic nie poradzę, walczę z tym na próżno!
Dialogue: 0,0:16:42.06,0:16:43.97,Default,Subaru,0,0,0,,Ja... ja...
Dialogue: 0,0:16:44.38,0:16:46.47,Default,Subaru,0,0,0,,Nienawidzę siebie!
Dialogue: 0,0:16:47.64,0:16:49.74,Default,Subaru,0,0,0,,Wszystko, co robię, to tylko\Nwielkie słowa,
Dialogue: 0,0:16:49.83,0:16:52.48,Default,Subaru,0,0,0,,I zgrywanie kogoś ważnego,\Nchoć nic nie potrafię!
Dialogue: 0,0:16:52.95,0:16:54.55,Default,Subaru,0,0,0,,Nigdy nic nie robię,
Dialogue: 0,0:16:54.64,0:16:56.99,Default,,0,0,0,,a jednak potrafię narzekać\Njak profesjonalista.
Dialogue: 0,0:16:57.25,0:16:58.80,Default,Subaru,0,0,0,,Za kogo ja się uważam?!
Dialogue: 0,0:16:59.07,0:17:02.66,Default,Subaru,0,0,0,,To niesamowite, że mogę tak żyć i\Nnie czuć się zawstydzony!
Dialogue: 0,0:17:02.98,0:17:04.04,Default,Subaru,0,0,0,,Prawda?!
Dialogue: 0,0:17:05.78,0:17:07.04,Default,Subaru,0,0,0,,Czuję się zepusty...
Dialogue: 0,0:17:07.47,0:17:09.28,Default,,0,0,0,,W ogóle nic we mnie nie ma!
Dialogue: 0,0:17:09.39,0:17:10.80,Default,Subaru,0,0,0,,Wiem, że...
Dialogue: 0,0:17:11.44,0:17:12.66,Default,Subaru,0,0,0,,No tak, to oczywiste...
Dialogue: 0,0:17:13.35,0:17:14.63,Default,Subaru,0,0,0,,Wiem, że to oczywiste.
Dialogue: 0,0:17:15.68,0:17:17.12,Default,Subaru,0,0,0,,Zanim tu przyjechałem...
Dialogue: 0,0:17:17.21,0:17:19.88,Default,Subaru,0,0,0,,Zanim trafiłem do was wszystkich,
Dialogue: 0,0:17:19.97,0:17:21.52,Default,Subaru,0,0,0,,Czy wiesz, co zrobiłem?
Dialogue: 0,0:17:23.31,0:17:24.77,Default,Subaru,0,0,0,,Nic nie zrobiłem...
Dialogue: 0,0:17:25.65,0:17:28.19,Default,Subaru,0,0,0,,Nigdy nie zrobiłem absolutnie nic.
Dialogue: 0,0:17:28.93,0:17:31.89,Default,Subaru,0,0,0,,Miałem tyle czasu, tyle swobody...
Dialogue: 0,0:17:32.24,0:17:34.23,Default,Subaru,0,0,0,,Mógłbym zrobić wszystko,
Dialogue: 0,0:17:34.32,0:17:35.85,Default,Subaru,0,0,0,,ale nigdy nic nie zrobiłem.
Dialogue: 0,0:17:36.12,0:17:39.20,Default,Subaru,0,0,0,,I oto efekt! To, kim teraz\Njestem, to właśnie ten efekt!
Dialogue: 0,0:17:39.88,0:17:42.50,Default,Subaru,0,0,0,,Cała moja bezsilność,\Ncała moja nieudolność,
Dialogue: 0,0:17:43.03,0:17:46.29,Default,Subaru,0,0,0,,jest wynikiem mojego zepsutego charakteru.
Dialogue: 0,0:17:46.46,0:17:50.04,Default,Subaru,0,0,0,,Chciałem coś osiągnąć,\Nchoć nigdy wcześniej niczego nie zrobiłem,
Dialogue: 0,0:17:50.13,0:17:52.09,Default,Subaru,0,0,0,,to już wykracza poza granice arogancji!
Dialogue: 0,0:17:53.00,0:17:56.80,Default,Subaru,0,0,0,,Cena mojego lenistwa i wszystkich\Nmarnotrawnych nawyków w moim życiu
Dialogue: 0,0:17:57.24,0:17:59.14,Default,Subaru,0,0,0,,doprowadzi do tego, że oboje zginiemy.
Dialogue: 0,0:18:01.84,0:18:02.98,Default,Subaru,0,0,0,,Zgadza się.
Dialogue: 0,0:18:03.09,0:18:04.48,Default,,0,0,0,,Nie mam charakteru.
Dialogue: 0,0:18:04.88,0:18:09.03,Default,Subaru,0,0,0,,Nawet gdy myślałem, że dam radę\Ntu zostać, nic się nie zmieniło...
Dialogue: 0,0:18:10.04,0:18:13.57,Default,Subaru,0,0,0,,Ten starszy pan doskonale\Ndostrzegł tę część mnie.
Dialogue: 0,0:18:13.92,0:18:15.08,Default,,0,0,0,,Prawda?
Dialogue: 0,0:18:15.17,0:18:17.04,Default,Subaru,0,0,0,,Nie chciałem stać się silniejszy,
Dialogue: 0,0:18:17.36,0:18:19.65,Default,Subaru,0,0,0,,albo próbując coś poprawić.
Dialogue: 0,0:18:20.26,0:18:23.62,Default,Subaru,0,0,0,,Po prostu przyjąłem oczywistą pozę,\Nżeby się usprawiedliwić,
Dialogue: 0,0:18:23.95,0:18:29.49,Default,Subaru,0,0,0,,żeby powiedzieć, że się starałem,\Nże to nie tak, jakbym nic nie robił.
Dialogue: 0,0:18:30.12,0:18:31.68,Default,Subaru,0,0,0,,Że nie zatrzymałem się.
Dialogue: 0,0:18:31.83,0:18:33.88,Default,Subaru,0,0,0,,Chciałem usłyszeć, że inaczej się nie da!
Dialogue: 0,0:18:34.26,0:18:38.74,Default,Subaru,0,0,0,,Tylko udawałem, że doprowadzam\Nswoje ciało do granic wytrzymałości!
Dialogue: 0,0:18:39.97,0:18:42.36,Default,Subaru,0,0,0,,Nawet kiedy prosiłem cię o pomoc w nauce,
Dialogue: 0,0:18:42.46,0:18:45.58,Default,Subaru,0,0,0,,Po prostu udawałem, żeby ukryć, jak\Nbardzo mi było wstyd!
Dialogue: 0,0:18:46.73,0:18:48.02,Default,Subaru,0,0,0,,W gruncie rzeczy,
Dialogue: 0,0:18:48.69,0:18:51.99,Default,,0,0,0,,jestem tylko małym, tchórzliwym,\Nobrzydliwym śmieciem,
Dialogue: 0,0:18:52.08,0:18:55.95,Default,Subaru,0,0,0,,który zawsze martwi się tym, jak\Npostrzegają mnie inni. I nic...
Dialogue: 0,0:18:56.33,0:18:58.66,Default,Subaru,0,0,0,,Nic się u mnie nie zmieniło!
Dialogue: 0,0:19:04.72,0:19:06.55,Default,Subaru,0,0,0,,Wiedziałem to od samego początku.
Dialogue: 0,0:19:07.03,0:19:09.31,Default,Subaru,0,0,0,,Że to wszystko była moja wina...
Dialogue: 0,0:19:10.01,0:19:11.61,Default,Subaru,0,0,0,,Jestem najgorszym z najgorszych.
Dialogue: 0,0:19:12.90,0:19:15.89,Default,Subaru,0,0,0,,Naprawdę nienawidzę siebie...
Dialogue: 0,0:19:20.26,0:19:21.56,Default,Rem,0,0,0,,Wiem...
Dialogue: 0,0:19:22.41,0:19:25.81,Default,Rem,0,0,0,,Że bez względu na to, jak głęboko\Npogrążyłaś się w ciemności,
Dialogue: 0,0:19:26.57,0:19:29.94,Default,Rem,0,0,0,,nadal masz odwagę wyciągnąć rękę.
Dialogue: 0,0:19:31.34,0:19:34.47,Default,Rem,0,0,0,,Uwielbiam, kiedy głaszczesz\Nmnie po włosach.
Dialogue: 0,0:19:34.85,0:19:36.90,Default,Rem,0,0,0,,Mam wrażenie, że potrafimy się zrozumieć
Dialogue: 0,0:19:37.05,0:19:39.86,Default,,0,0,0,,poprzez dotyk Twojej dłoni i moich włosów.
Dialogue: 0,0:19:40.69,0:19:42.73,Default,Rem,0,0,0,,Uwielbiam twój głos.
Dialogue: 0,0:19:42.98,0:19:44.53,Default,Rem,0,0,0,,Wystarczy, jedno słowo
Dialogue: 0,0:19:44.70,0:19:47.01,Default,,0,0,0,,które rozgrzewa mi serce.
Dialogue: 0,0:19:47.88,0:19:49.51,Default,Rem,0,0,0,,Uwielbiam twoje oczy.
Dialogue: 0,0:19:50.18,0:19:52.03,Default,Rem,0,0,0,,Zazwyczaj są chłodne,
Dialogue: 0,0:19:52.12,0:19:54.17,Default,Rem,0,0,0,,ale kiedy okazujesz komuś życzliwość,
Dialogue: 0,0:19:54.71,0:19:56.66,Default,Rem,0,0,0,,Uwielbiam to, jak miękną.
Dialogue: 0,0:19:58.29,0:20:00.11,Default,Rem,0,0,0,,Uwielbiam twoje palce.
Dialogue: 0,0:20:00.63,0:20:03.01,Default,Rem,0,0,0,,Jak na chłopca masz\Nnaprawdę śliczne palce.
Dialogue: 0,0:20:03.41,0:20:07.01,Default,Rem,0,0,0,,Ale kiedy chwytają mnie za rękę,\Nwiem, że sa silne,
Dialogue: 0,0:20:07.22,0:20:09.47,Default,,0,0,0,,smukłe palce mężczyzny.
Dialogue: 0,0:20:10.07,0:20:12.37,Default,Rem,0,0,0,,Podoba mi się sposób, w jaki chodzisz.
Dialogue: 0,0:20:12.68,0:20:14.72,Default,Rem,0,0,0,,Kiedy idziemy razem,
Dialogue: 0,0:20:14.81,0:20:20.53,Default,Rem,0,0,0,,Podoba mi się, jak od czasu do czasu się\Nodwracasz, żeby sprawdzić, czy nadążam.
Dialogue: 0,0:20:20.62,0:20:21.58,Default,Subaru,0,0,0,,Przestań...
Dialogue: 0,0:20:21.87,0:20:24.06,Default,Rem,0,0,0,,Uwielbiam to, jak wyglądasz, kiedy śpisz.
Dialogue: 0,0:20:24.20,0:20:26.23,Default,Rem,0,0,0,,Wyglądasz na bezbronnego, jak niemowlę,
Dialogue: 0,0:20:26.32,0:20:28.29,Default,Rem,0,0,0,,a twoje rzęsy są raczej długie.
Dialogue: 0,0:20:28.59,0:20:30.66,Default,Rem,0,0,0,,Kiedy dotykam policzka, uspokajasz się...
Dialogue: 0,0:20:31.27,0:20:34.47,Default,Rem,0,0,0,,A kiedy figlarnie dotykam twoich ust,\Nnawet tego nie zauważasz...
Dialogue: 0,0:20:34.68,0:20:36.88,Default,Rem,0,0,0,,I to sprawia, że serce mi strasznie pęka.
Dialogue: 0,0:20:37.62,0:20:38.59,Default,Rem,0,0,0,,Kocham cię.
Dialogue: 0,0:20:39.49,0:20:40.81,Default,Subaru,0,0,0,,Dlaczego?
Dialogue: 0,0:20:41.42,0:20:45.23,Default,Rem,0,0,0,,Kiedy powiedziałeś, że się nienawidzisz,
Dialogue: 0,0:20:45.32,0:20:47.95,Default,Rem,0,0,0,,to sprawiło, że zapragnęłam\Nci o tym powiedzieć
Dialogue: 0,0:20:48.04,0:20:50.77,Default,,0,0,0,,wszystkie te cudowne rzeczy,\Nktóre o tobie wiem.
Dialogue: 0,0:20:51.11,0:20:53.24,Default,Subaru,0,0,0,,To wszystko było fałszywe.
Dialogue: 0,0:20:53.33,0:20:55.26,Default,,0,0,0,,Po prostu mnie nie znasz!
Dialogue: 0,0:20:55.35,0:20:58.61,Default,Subaru,0,0,0,,Znam siebie lepiej niż ktokolwiek inny!
Dialogue: 0,0:20:59.07,0:21:01.32,Default,Rem,0,0,0,,Znasz tylko siebie!
Dialogue: 0,0:21:02.33,0:21:07.33,Default,Rem,0,0,0,,Ile wiesz o tym Subaru, którego widzę?!
Dialogue: 0,0:21:09.42,0:21:12.10,Default,Subaru,0,0,0,,Dlaczego… tak bardzo mnie lubisz?
Dialogue: 0,0:21:13.33,0:21:14.34,Default,Subaru,0,0,0,,Ja...
Dialogue: 0,0:21:15.00,0:21:16.66,Default,Subaru,0,0,0,,Jestem słaby i drobny.
Dialogue: 0,0:21:17.30,0:21:18.28,Default,,0,0,0,,Uciekam.
Dialogue: 0,0:21:18.37,0:21:20.21,Default,Subaru,0,0,0,,Tak jak ostatnim razem uciekłem!
Dialogue: 0,0:21:20.90,0:21:23.09,Default,Subaru,0,0,0,,Więc dlaczego?
Dialogue: 0,0:21:23.59,0:21:27.38,Default,Rem,0,0,0,,Bo jesteś moim bohaterem, Subaru!
Dialogue: 0,0:21:30.34,0:21:31.99,Default,Rem,0,0,0,,W tym ciemnym lesie,
Dialogue: 0,0:21:32.08,0:21:34.56,Default,,0,0,0,,kiedy już nawet nie wiedziałem, kim jestem
Dialogue: 0,0:21:34.93,0:21:37.61,Default,Rem,0,0,0,,i nie potrafiłam myśleć o niczym innym,
Dialogue: 0,0:21:37.95,0:21:39.78,Default,Rem,0,0,0,,uratowałeś mnie.
Dialogue: 0,0:21:40.00,0:21:41.62,Default,Rem,0,0,0,,Obudziłam się i nic nie mogłam
Dialogue: 0,0:21:41.87,0:21:44.57,Default,Rem,0,0,0,,a Siostra była wyczerpana po\Nnadmiernym użyciu magii,
Dialogue: 0,0:21:44.70,0:21:48.56,Default,Rem,0,0,0,,zmierzyłeś się z potworami, by zmylić\Nich, dlatego mogliśmy uciec.
Dialogue: 0,0:21:48.95,0:21:50.20,Default,Rem,0,0,0,,Nie było szans wygrać,
Dialogue: 0,0:21:50.40,0:21:52.40,Default,,0,0,0,,a twoje życie było naprawdę zagrożone.
Dialogue: 0,0:21:52.59,0:21:54.24,Default,Rem,0,0,0,,Ale mimo to zostałeś,
Dialogue: 0,0:21:54.57,0:21:58.58,Default,Rem,0,0,0,,i wróciłeś w moje ramiona, wciąż ciepły.
Dialogue: 0,0:21:59.15,0:22:01.06,Default,Rem,0,0,0,,Kiedy się obudziłeś, uśmiechnąłeś się,
Dialogue: 0,0:22:01.15,0:22:03.31,Default,Rem,0,0,0,,i rzekłeś słowa, które chciałam usłyszeć,
Dialogue: 0,0:22:03.40,0:22:05.21,Default,Rem,0,0,0,,i ich posłuchać,
Dialogue: 0,0:22:05.30,0:22:07.94,Default,,0,0,0,,od osoby, od której najbardziej\Nchciałam je usłyszeć.
Dialogue: 0,0:22:09.01,0:22:12.06,Default,Rem,0,0,0,,Mój czas zatrzymał się już dawno temu.
Dialogue: 0,0:22:12.86,0:22:14.64,Default,Rem,0,0,0,,Od tamtej burzliwej nocy,
Dialogue: 0,0:22:14.79,0:22:17.59,Default,Rem,0,0,0,,tej nocy, kiedy straciłam wszystko\Noprócz mojej siostry,
Dialogue: 0,0:22:18.07,0:22:21.15,Default,Rem,0,0,0,,czas się dla mnie zatrzymał...
Dialogue: 0,0:22:22.04,0:22:25.75,Default,Rem,0,0,0,,To właśnie ty stopiłeś moje\Nzamarznięte serce,
Dialogue: 0,0:22:25.94,0:22:30.37,Default,Rem,0,0,0,,i sprawiłeś, że mój zatrzymany\Nczas znów zaczął płynąć!
Dialogue: 0,0:22:31.46,0:22:35.86,Default,Rem,0,0,0,,Na pewno nie masz pojęcia,\Njak bardzo mi pomogłeś,
Dialogue: 0,0:22:36.13,0:22:40.56,Default,Rem,0,0,0,,albo jak bardzo byłam szczęśliwa\Nw tamtej chwili, tamtego poranka.
Dialogue: 0,0:22:41.75,0:22:44.42,Default,Rem,0,0,0,,Właśnie dlatego w to wierzę.
Dialogue: 0,0:22:45.14,0:22:47.85,Default,Rem,0,0,0,,Niezależnie od tego, jakie trudne\Nrzeczy się zdarzają,
Dialogue: 0,0:22:47.94,0:22:50.38,Default,Rem,0,0,0,,nawet jeśli wydaje się, że przegrasz...
Dialogue: 0,0:22:50.74,0:22:53.82,Default,Rem,0,0,0,,Kiedy nikt inny na świecie w\Nciebie nie wierzy,
Dialogue: 0,0:22:54.02,0:22:57.36,Default,Rem,0,0,0,,kiedy nawet w siebie nie wierzysz...
Dialogue: 0,0:22:57.95,0:22:59.49,Default,Rem,0,0,0,,Uwierzę!
Dialogue: 0,0:23:06.91,0:23:09.46,Default,Rem,0,0,0,,Że to właśnie Subaru mnie uratował
Dialogue: 0,0:23:09.90,0:23:12.26,Default,Rem,0,0,0,,i jest prawdziwym bohaterem.
Dialogue: 0,0:23:25.96,0:23:27.66,Default,Subaru,0,0,0,,Nieważne, jak bardzo się starałem,
Dialogue: 0,0:23:28.12,0:23:29.38,Default,,0,0,0,,Nie uratowałem nikogo...
Dialogue: 0,0:23:30.33,0:23:31.38,Default,Rem,0,0,0,,Jestem tutaj.
Dialogue: 0,0:23:32.07,0:23:35.67,Default,Rem,0,0,0,,Zapisany plik REM\Nznajduje się właśnie tutaj.
Dialogue: 0,0:23:36.71,0:23:39.08,Default,Subaru,0,0,0,,Nigdy niczego nie zrobiłem.\NCzuję się pusty.
Dialogue: 0,0:23:40.03,0:23:42.36,Default,Subaru,0,0,0,,Nikt nawet nie chce mnie wysłuchać.
Dialogue: 0,0:23:42.71,0:23:43.95,Default,Rem,0,0,0,,Jestem tutaj.
Dialogue: 0,0:23:44.38,0:23:47.02,Default,Rem,0,0,0,,Wysłucham wszystkiego, co masz\Ndo powiedzenia.
Dialogue: 0,0:23:47.39,0:23:48.33,Default,Rem,0,0,0,,Chciałabym.
Dialogue: 0,0:23:49.52,0:23:51.40,Default,Subaru,0,0,0,,Nikt niczego ode mnie nie oczekuje.
Dialogue: 0,0:23:52.09,0:23:53.83,Default,Subaru,0,0,0,,Nikt we mnie nie wierzy.
Dialogue: 0,0:23:55.92,0:23:57.84,Default,Subaru,0,0,0,,Nienawidzę siebie.
Dialogue: 0,0:24:00.88,0:24:05.04,Default,Rem,0,0,0,,Cóż, kocham cię, Subaru!
Dialogue: 0,0:24:08.94,0:24:11.43,Default,Subaru,0,0,0,,Naprawdę nie masz nic\Nprzeciwko temu, że to ja?
Dialogue: 0,0:24:12.05,0:24:13.84,Default,Rem,0,0,0,,Chcę, żebyś to była właśnie ty.
Dialogue: 0,0:24:15.09,0:24:17.65,Default,Rem,0,0,0,,Nie chciałabym, żeby to był ktoś inny.
Dialogue: 0,0:24:19.73,0:24:22.08,Default,Rem,0,0,0,,Jeśli nie potrafisz sobie wybaczyć
Dialogue: 0,0:24:22.53,0:24:24.82,Default,,0,0,0,,za to, że jesteś pusty i nic nie masz,
Dialogue: 0,0:24:24.91,0:24:27.19,Default,Rem,0,0,0,,W takim razie zacznijmy właśnie tutaj.
Dialogue: 0,0:24:27.54,0:24:28.72,Default,Subaru,0,0,0,,Co zacząć?
Dialogue: 0,0:24:29.56,0:24:33.63,Default,Rem,0,0,0,,Tak jak ty uruchomiłeś dla mnie\Nczas, gdy się zatrzymał,
Dialogue: 0,0:24:33.90,0:24:36.86,Default,Rem,0,0,0,,sprawimy, że czas, który się zatrzymał,\Nznów zacznie płynąć,
Dialogue: 0,0:24:37.17,0:24:38.55,Default,,0,0,0,,znów ruszy.
Dialogue: 0,0:24:39.71,0:24:41.53,Default,Rem,0,0,0,,Zacznijmy od tego.
Dialogue: 0,0:24:43.13,0:24:44.31,Default,Rem,0,0,0,,Od początku.
Dialogue: 0,0:24:45.45,0:24:46.52,Default,Rem,0,0,0,,Nie,
Dialogue: 0,0:24:47.49,0:24:48.51,Default,Rem,0,0,0,,od zera!
Dialogue: 0,0:24:53.30,0:24:55.39,Default,Rem,0,0,0,,Jeśli chodzenie sprawia ci trudność,
Dialogue: 0,0:24:55.51,0:24:56.88,Default,,0,0,0,,Będę cię podtrzymywać.
Dialogue: 0,0:24:57.35,0:25:00.80,Default,Rem,0,0,0,,W drodze będziemy się wspierać\Ni dzielić ciężarem.
Dialogue: 0,0:25:01.43,0:25:04.26,Default,Rem,0,0,0,,Czy nie to właśnie mi powiedziałeś\Ntamtego ranka?
Dialogue: 0,0:25:05.57,0:25:09.14,Default,Rem,0,0,0,,Pokaż mi, jak niesamowity\Npotrafisz być, Subaru.
Dialogue: 0,0:25:11.74,0:25:12.62,Default,Subaru,0,0,0,,Rem...
Dialogue: 0,0:25:13.25,0:25:14.13,Default,Rem,0,0,0,,Tak?
Dialogue: 0,0:25:17.57,0:25:19.46,Default,Subaru,0,0,0,,Kocham Emilię.
Dialogue: 0,0:25:22.47,0:25:23.37,Default,Rem,0,0,0,,Tak.
Dialogue: 0,0:25:24.42,0:25:26.26,Default,Subaru,0,0,0,,Chcę zobaczyć uśmiech Emilii.
Dialogue: 0,0:25:26.80,0:25:28.83,Default,Subaru,0,0,0,,Chcę pomóc Emilii w jej przyszłości.
Dialogue: 0,0:25:29.60,0:25:30.88,Default,Subaru,0,0,0,,Nawet jeśli przeszkadzam,
Dialogue: 0,0:25:31.36,0:25:33.46,Default,,0,0,0,,nawet jeśli powie mi, żebym nie zbliżał...
Dialogue: 0,0:25:35.02,0:25:37.14,Default,Subaru,0,0,0,,Chcę być przy niej.
Dialogue: 0,0:25:38.47,0:25:40.85,Default,Subaru,0,0,0,,Wykorzystam moje uczucia do niej
Dialogue: 0,0:25:41.57,0:25:44.06,Default,Subaru,0,0,0,,żeby wszystko zrozumiała
Dialogue: 0,0:25:44.70,0:25:46.05,Default,Subaru,0,0,0,,Czy to aroganckie?
Dialogue: 0,0:25:47.95,0:25:49.91,Default,Subaru,0,0,0,,Nic złego, że ona tego nie rozumie.
Dialogue: 0,0:25:50.36,0:25:52.29,Default,,0,0,0,,Chcę ją po prostu uratować.
Dialogue: 0,0:25:52.82,0:25:55.41,Default,Subaru,0,0,0,,Jeśli czeka ją ponura, bolesna przyszłość,
Dialogue: 0,0:25:55.78,0:25:58.79,Default,Subaru,0,0,0,,Chcę zabrać ją tam, gdzie wszyscy\Nbędziemy się razem śmiać!
Dialogue: 0,0:26:02.37,0:26:04.70,Default,Subaru,0,0,0,,Pomożesz mi?
Dialogue: 0,0:26:05.80,0:26:07.45,Default,Subaru,0,0,0,,Sam nie dam rady.
Dialogue: 0,0:26:07.94,0:26:09.48,Default,,0,0,0,,Brakuje mi wszystkiego.
Dialogue: 0,0:26:09.91,0:26:12.17,Default,Subaru,0,0,0,,Nie jestem pewien, czy dam\Nradę iść prosto.
Dialogue: 0,0:26:12.47,0:26:14.80,Default,Subaru,0,0,0,,Jestem słaby, delikatny i mały.
Dialogue: 0,0:26:15.97,0:26:18.97,Default,Subaru,0,0,0,,Aby więc mieć pewność, że idę prosto,
Dialogue: 0,0:26:19.06,0:26:21.01,Default,Subaru,0,0,0,,pomóż mi, żeby wiedzieć kiedy się mylę,
Dialogue: 0,0:26:21.13,0:26:22.70,Default,Subaru,0,0,0,,Pomożesz mi?
Dialogue: 0,0:26:26.14,0:26:28.45,Default,Rem,0,0,0,,Jesteś okrutnym człowiekiem, Subaru.
Dialogue: 0,0:26:28.79,0:26:31.85,Default,Rem,0,0,0,,Pytają o to wszystko kogoś, kogo\Nwłaśnie odrzucili?
Dialogue: 0,0:26:32.20,0:26:36.28,Default,Subaru,0,0,0,,Ciężko prosić o to kogoś,\Nkto odrzucił
Dialogue: 0,0:26:36.37,0:26:37.77,Default,,0,0,0,,jedyną propozycję małżeństwa
Dialogue: 0,0:26:49.88,0:26:51.57,Default,Rem,0,0,0,,Z pokorą przyjmuję.
Dialogue: 0,0:26:52.59,0:26:54.26,Default,Rem,0,0,0,,Jeśli to ci pomoże,
Dialogue: 0,0:26:55.41,0:26:57.04,Default,Rem,0,0,0,,mój bohaterze,
Dialogue: 0,0:26:57.49,0:26:59.70,Default,,0,0,0,,Jeśli chcesz z uśmiechem witać przyszłość.
Dialogue: 0,0:27:01.38,0:27:02.97,Default,Subaru,0,0,0,,Tak, po prostu patrz.
Dialogue: 0,0:27:03.83,0:27:05.37,Default,Subaru,0,0,0,,Miejsce w pierwszym rzędzie...
Dialogue: 0,0:27:10.58,0:27:12.32,Default,Subaru,0,0,0,,żeby zobaczyć ukochanego
Dialogue: 0,0:27:12.64,0:27:15.99,Default,,0,0,0,,Zostań najwspanialszym\Nbohaterem wszech czasów!
Dialogue: 0,0:27:26.84,0:27:28.24,Default - italics,Subaru,0,0,0,,{\fad(1,552)}Mam cię na oku.
Dialogue: 0,0:27:29.60,0:27:31.01,Default - italics,Subaru,0,0,0,,Patrzysz na mnie.
Dialogue: 0,0:27:32.22,0:27:33.77,Default - italics,Subaru,0,0,0,,Więc nie będę spoglądać w dół.
Dialogue: 0,0:27:34.25,0:27:39.29,Default - italics,Subaru,0,0,0,,Historia Natsuki Subaru rozpocznie się\Nwłaśnie tutaj, od zera.
Dialogue: 0,0:27:43.00,0:27:46.42,Default - italics,Subaru,0,0,0,,Moje życie w innym świecie zaczyna się\Nwłaśnie tutaj, od zera!
Dialogue: 0,0:27:47.90,0:27:50.81,Episode Title,Title,0,0,0,,Od zera
Comment: 0,0:27:50.90,0:27:52.90,Episode Title,,0,0,0,,
Dialogue: 0,0:27:55.40,0:27:56.33,Default,Crusch,0,0,0,,Co?
Dialogue: 0,0:27:56.97,0:27:58.82,Default,Subaru,0,0,0,,No dobrze, powiem to jeszcze raz.
Dialogue: 0,0:27:59.08,0:28:03.08,Default,Subaru,0,0,0,,Sojusz między obozami Emilii i Crusch,\Nzawarty na równych warunkach.
Dialogue: 0,0:28:03.48,0:28:06.16,Default,Subaru,0,0,0,,W tym celu podam godzinę i miejsce
Dialogue: 0,0:28:06.43,0:28:08.72,Default,Subaru,0,0,0,,kolejne pojawienie się Białego Wieloryba.
Dialogue: 0,0:28:08.81,0:28:10.91,Default,Subaru,0,0,0,,To jedyna karta, jaką mam w rękawie.
Dialogue: 0,0:28:15.29,0:28:16.54,Default,Wilhelm,0,0,0,,Biały wieloryb?
Dialogue: 0,0:28:25.63,0:28:27.57,Default,Wilhelm,0,0,0,,Proszę, wybacz mi tę niedyskrecję.
Dialogue: 0,0:28:28.18,0:28:30.26,Default,Wilhelm,0,0,0,,Chyba wciąż muszę się wiele nauczyć.
Dialogue: 0,0:28:31.70,0:28:36.07,Default,Crusch,0,0,0,,No i? Trochę dziwne, że teraz wspominasz\No Białym Wielorybie.
Dialogue: 0,0:28:36.16,0:28:37.83,Default,Subaru,0,0,0,,Wcale nie.
Dialogue: 0,0:28:37.92,0:28:39.66,Default,Subaru,0,0,0,,Kiedy rozpoczęliśmy te negocjacje,
Dialogue: 0,0:28:39.75,0:28:44.63,Default,Subaru,0,0,0,,Wspomniałem o magicznych kamieniach z\Nposiadłości Roswaala, z Lasu Elior.
Dialogue: 0,0:28:44.78,0:28:47.46,Default,Subaru,0,0,0,,Jeśli podział praw do\Nwydobycia to za mało,
Dialogue: 0,0:28:47.86,0:28:50.87,Default,Subaru,0,0,0,,Muszę zaproponować coś jeszcze.
Dialogue: 0,0:28:51.28,0:28:54.90,Default,Subaru,0,0,0,,Crusch, jestem przekonany, że moje\Ninformacje okażą się pomocne
Dialogue: 0,0:28:55.01,0:28:57.57,Default,,0,0,0,,w twoim planie pokonania Białego Wieloryba
Dialogue: 0,0:28:58.42,0:29:01.30,Default,Crusch,0,0,0,,Pozwól, że zadam ci jedno pytanie,\NNatsuki Subaru.
Dialogue: 0,0:29:01.73,0:29:03.93,Default,Crusch,0,0,0,,Skąd ten pomysł?
Dialogue: 0,0:29:04.02,0:29:06.85,Default,Crusch,0,0,0,,Tej uwagi nie można było uznać\Nza bezpodstawny zarzut.
Dialogue: 0,0:29:07.37,0:29:08.66,Default,Subaru,0,0,0,,W ciągu kilku dni,
Dialogue: 0,0:29:08.75,0:29:10.18,Default,,0,0,0,,wiele mnie niepokoi.
Dialogue: 0,0:29:10.63,0:29:13.06,Default,Subaru,0,0,0,,Większy ruch wokół Państwa rezydencji.
Dialogue: 0,0:29:13.23,0:29:16.20,Default,Subaru,0,0,0,,To było trochę przesadzone.
Dialogue: 0,0:29:16.29,0:29:20.69,Default,Subaru,0,0,0,,Wiem też, że w stolicy\Nkupujesz broń i zbroje.
Dialogue: 0,0:29:20.85,0:29:21.73,Default,Subaru,0,0,0,,A poza tym...
Dialogue: 0,0:29:21.90,0:29:24.86,Default - flashback,Russell,0,0,0,,Gdyby cel Crusch został osiągnięty,
Dialogue: 0,0:29:25.15,0:29:28.08,Default - flashback,Russell,0,0,0,,Jestem pewien, że to Pana zadowoli,\Npanie Wilhelm.
Dialogue: 0,0:29:28.82,0:29:32.38,Default,Subaru,0,0,0,,Wyglądało na to, że szykujesz\Ncoś wielkiego.
Dialogue: 0,0:29:32.53,0:29:34.01,Default,Subaru,0,0,0,,Nie potrafię tego udowodnić.
Dialogue: 0,0:29:34.56,0:29:36.88,Default,Subaru,0,0,0,,Może po prostu dostrzegłem ten związek
Dialogue: 0,0:29:36.97,0:29:40.28,Default,,0,0,0,,bo wiem, że wkrótce pojawi\Nsię Biały Wieloryb.
Dialogue: 0,0:29:40.76,0:29:43.46,Default,Crusch,0,0,0,,Mam jeszcze jedno pytanie, Natsuki Subaru.
Dialogue: 0,0:29:43.72,0:29:47.09,Default,Crusch,0,0,0,,Skąd wiesz, że Biały Wieloryb się pojawi?
Dialogue: 0,0:29:48.71,0:29:49.64,Default,Subaru,0,0,0,,To.
Dialogue: 0,0:29:50.92,0:29:52.35,Default,Crusch,0,0,0,,Co to, u licha, jest?
Dialogue: 0,0:29:53.77,0:29:56.48,Default - italics,Subaru,0,0,0,,Chwilę przed tym, jak to się stało...
Dialogue: 0,0:30:00.70,0:30:02.93,Default,Subaru,0,0,0,,Można by to nazwać metią.
Dialogue: 0,0:30:03.47,0:30:07.27,Default,Subaru,0,0,0,,Informuje mnie, kiedy i gdzie\Npojawi się Biały Wieloryb.
Dialogue: 0,0:30:07.36,0:30:09.87,Default,Crusch,0,0,0,,Trudno mi w to uwierzyć...
Dialogue: 0,0:30:12.60,0:30:14.45,Default,Crusch,0,0,0,,Ale widzę, że nie kłamiesz.
Dialogue: 0,0:30:14.54,0:30:18.66,Default,Subaru,0,0,0,,Doceniam to, ale czy na pewno chcesz\Nmi tak łatwo wierzyć?
Dialogue: 0,0:30:19.06,0:30:21.53,Default,Felix,0,0,0,,Kłamstwa nic ci nie dadzą w\Nrozmowie z Crusch.
Dialogue: 0,0:30:21.76,0:30:23.69,Default,Felix,0,0,0,,Ma boską ochronę odczytywania wiatru!
Dialogue: 0,0:30:24.13,0:30:25.32,Default,Subaru,0,0,0,,Co proszę?
Dialogue: 0,0:30:25.61,0:30:29.93,Default,Crusch,0,0,0,,Kiedy ktoś kłamie, wokół niego unosi się\Ncharakterystyczny powiew.
Dialogue: 0,0:30:30.17,0:30:31.44,Default,Crusch,0,0,0,,Widzi ten wiatr.
Dialogue: 0,0:30:32.19,0:30:34.02,Default,Crusch,0,0,0,,Nie miałeś tego.
Dialogue: 0,0:30:34.16,0:30:36.73,Default,Subaru,0,0,0,,Czy to oznacza, że zgodzisz się na sojusz?
Dialogue: 0,0:30:36.82,0:30:38.64,Default,,0,0,0,,za informacje o Białym Wielorybie?
Dialogue: 0,0:30:38.85,0:30:41.33,Default,Crusch,0,0,0,,Trochę za szybko, Subaru.
Dialogue: 0,0:30:41.85,0:30:43.68,Default,Crusch,0,0,0,,Nieważne czy się na to zgodzę,
Dialogue: 0,0:30:43.77,0:30:46.74,Default,,0,0,0,,a to, czy w to wierzę, to już\Nzupełnie inna sprawa.
Dialogue: 0,0:30:47.19,0:30:48.83,Default,Crusch,0,0,0,,Moja decyzja będzie miała wpływ
Dialogue: 0,0:30:48.92,0:30:52.08,Default,,0,0,0,,nawynik wyboru władcy, a może nawet\Nprzyszłość samego królestwa.
Dialogue: 0,0:30:52.17,0:30:53.94,Default,Crusch,0,0,0,,Nie można robić tego po łebkach.
Dialogue: 0,0:30:55.41,0:30:59.10,Default,Anastasia,0,0,0,,Czy mogę się przyłączyć do tej rozmowy?
Dialogue: 0,0:31:00.78,0:31:02.31,Default,Russell,0,0,0,,Przepraszamy.
Dialogue: 0,0:31:02.40,0:31:03.84,Default,Crusch,0,0,0,,Anastasia...
Dialogue: 0,0:31:04.42,0:31:05.77,Default,Crusch,0,0,0,,Stypendystka Russella?
Dialogue: 0,0:31:07.17,0:31:09.82,Default,Anastasia,0,0,0,,Cóż, sami nas zaprosiliście,\Nwięc oto jesteśmy,
Dialogue: 0,0:31:09.91,0:31:11.52,Default,Anastasia,0,0,0,,zaczynają bez nas.
Dialogue: 0,0:31:11.61,0:31:12.98,Default,,0,0,0,,To nie jest sprawiedliwe.
Dialogue: 0,0:31:13.07,0:31:14.54,Default,Anastasia,0,0,0,,Wtajemniczcie nas w to.
Dialogue: 0,0:31:14.63,0:31:18.47,Default,Crusch,0,0,0,,Czy to Subaru poprosił cię,\Nżebyś tu przyszła?
Dialogue: 0,0:31:18.90,0:31:22.25,Default,Anastasia,0,0,0,,Cóż, ściślej mówiąc, chodziło o tę\Ndziewczynę, z którą się spotyka.
Dialogue: 0,0:31:22.58,0:31:24.39,Default,Anastasia,0,0,0,,Usłyszałam tylko ogólny zarys,
Dialogue: 0,0:31:24.48,0:31:28.39,Default,Anastasia,0,0,0,,ale jeśli naprawdę planujecie pokonać\NBiałego Wieloryba, nie mogę się doczekać!
Dialogue: 0,0:31:28.48,0:31:30.02,Default,Anastasia,0,0,0,,Dla nas, ludzi biznesu,
Dialogue: 0,0:31:30.11,0:31:33.02,Default,Anastasia,0,0,0,,obecność Białego Wieloryba\Nto kwestia życia i śmierci.
Dialogue: 0,0:31:33.11,0:31:35.46,Default,Anastasia,0,0,0,,Oczywiście nasi najemnicy\Nchętnie wam pomogą.
Dialogue: 0,0:31:36.14,0:31:38.72,Default,Russell,0,0,0,,Poza Białym Wielorybem interesuje mnie
Dialogue: 0,0:31:39.01,0:31:40.77,Default,Russell,0,0,0,,koncesja zaproponowana
Dialogue: 0,0:31:40.86,0:31:44.40,Default,,0,0,0,,przez Subaru: prawa do wydobycia\Nmagicznych kamieni.
Dialogue: 0,0:31:44.95,0:31:46.84,Default,Russell,0,0,0,,Jeśli zawrzemy sojusz, kamienie
Dialogue: 0,0:31:46.93,0:31:48.27,Default,Russell,0,0,0,,z dotąd nietkniętych złóż
Dialogue: 0,0:31:48.36,0:31:52.25,Default,,0,0,0,,trafią do stolicy za pośrednictwem Crusch.
Dialogue: 0,0:31:52.34,0:31:56.03,Default,Russell,0,0,0,,Jako przedstawiciel cechu kupieckiego\Nnie mogę zignorować tej propozycji.
Dialogue: 0,0:31:56.12,0:31:57.86,Default,Crusch,0,0,0,,Subaru też cię wezwał?
Dialogue: 0,0:31:58.93,0:32:00.27,Default,Subaru,0,0,0,,Powiem to jeszcze raz.
Dialogue: 0,0:32:00.81,0:32:03.07,Default,Subaru,0,0,0,,W zamian za sojusz oferuję
Dialogue: 0,0:32:03.16,0:32:05.48,Default,Subaru,0,0,0,,udział w prawach do wydobycia kamieni
Dialogue: 0,0:32:05.57,0:32:07.77,Default,Subaru,0,0,0,,oraz gdzie i kiedy pojawi się Wieloryb.
Dialogue: 0,0:32:08.08,0:32:11.81,Default,Subaru,0,0,0,,Innymi słowy, paliwo potrzebne\Ndo pokonania mabeasta
Dialogue: 0,0:32:12.53,0:32:14.52,Default,,0,0,0,,która od tak dawna terroryzuje świat!
Dialogue: 0,0:32:16.27,0:32:20.20,Default,Subaru,0,0,0,,Jeśli to, co mówię, nie ma dla ciebie\Nsensu, zapomnij, że o tym.
Dialogue: 0,0:32:20.49,0:32:23.79,Default,Subaru,0,0,0,,Ale jeśli twój cel pokrywa się z\Nmoim pragnieniem,
Dialogue: 0,0:32:24.86,0:32:26.41,Default,Subaru,0,0,0,,to pokonajmy Białego Wieloryba.
Dialogue: 0,0:32:28.22,0:32:30.03,Default,Subaru,0,0,0,,Wybierzmy się na polowanie!
Dialogue: 0,0:32:40.60,0:32:42.52,Default,Crusch,0,0,0,,Mam jeszcze kilka pytań,
Dialogue: 0,0:32:42.80,0:32:45.32,Default,Crusch,0,0,0,,genialnie to rozegrałeś, ujawniając plany.
Dialogue: 0,0:32:46.34,0:32:47.54,Default,Subaru,0,0,0,,A potem...
Dialogue: 0,0:32:47.78,0:32:49.96,Default,Crusch,0,0,0,,Mam pytania, a także wątpliwości.
Dialogue: 0,0:32:50.11,0:32:51.73,Default,Crusch,0,0,0,,Dużo niejasności,
Dialogue: 0,0:32:51.82,0:32:54.00,Default,Crusch,0,0,0,,więc trudno mi się od razu zgodzić.
Dialogue: 0,0:32:54.40,0:32:55.28,Default,Crusch,0,0,0,,Jednak...
Dialogue: 0,0:32:55.50,0:32:57.71,Default,Crusch,0,0,0,,Postanawiam zaufać twoim oczom
Dialogue: 0,0:32:57.80,0:33:00.02,Default,Crusch,0,0,0,,i duchowi, który cię do tego skłonił.
Dialogue: 0,0:33:02.43,0:33:04.49,Default,Russell,0,0,0,,I tak dochodzi do zawarcia umowy.
Dialogue: 0,0:33:07.86,0:33:10.05,Default,Russell,0,0,0,,Kilka razy sytuacja wisiała na włosku,
Dialogue: 0,0:33:10.22,0:33:12.31,Default,Russell,0,0,0,,ale cieszę się z sukcesu, Subaru
Dialogue: 0,0:33:12.40,0:33:14.76,Default,Russell,0,0,0,,Liczę, że obietnica nadal obowiązuje.
Dialogue: 0,0:33:14.85,0:33:17.23,Default,Subaru,0,0,0,,Tak, bardzo mi pan pomógł, panie Russell.
Dialogue: 0,0:33:17.32,0:33:20.36,Default,Subaru,0,0,0,,Gdy podbój dobiegnie końca, dam ci metię.
Dialogue: 0,0:33:21.91,0:33:24.21,Default,Crusch,0,0,0,,Więc przed przyjazdem przygotowałeś.
Dialogue: 0,0:33:24.59,0:33:27.11,Default,Crusch,0,0,0,,Czekałeś pod drzwiami na właściwy moment?
Dialogue: 0,0:33:27.51,0:33:30.49,Default,Anastasia,0,0,0,,Ale to my decydowaliśmy, kiedy przerwać.
Dialogue: 0,0:33:30.58,0:33:34.10,Default,Anastasia,0,0,0,,Cóż, jeśli chodzi o negocjacje, to chyba\Nmożna to uznać za zakończone?
Dialogue: 0,0:33:34.19,0:33:35.49,Default,Subaru,0,0,0,,Długo to trwało!
Dialogue: 0,0:33:35.60,0:33:38.14,Default,,0,0,0,,Myślałem, że już nigdy się nie pojawisz!
Dialogue: 0,0:33:38.61,0:33:41.50,Default,Anastasia,0,0,0,,W negocjacjach trzeba wyczuć\Nmoment na ruch.
Dialogue: 0,0:33:42.17,0:33:45.32,Default,Anastasia,0,0,0,,Skoro już szykujesz się do podboju
Dialogue: 0,0:33:45.41,0:33:47.96,Default,Anastasia,0,0,0,,Nie zapomnijcie wspierać firmy Hoshin.
Dialogue: 0,0:33:49.04,0:33:52.86,Default,Crusch,0,0,0,,Przygotowałeś grunt jeszcze przed\Nrozpoczęciem negocjacji?
Dialogue: 0,0:33:53.13,0:33:56.31,Default,Crusch,0,0,0,,Jesteś zaskakująco bystry, Subaru.
Dialogue: 0,0:33:56.40,0:33:59.41,Default,Subaru,0,0,0,,Po prostu przygotowanie i\Npowtórka się opłaciły.
Dialogue: 0,0:33:59.50,0:34:01.95,Default,Subaru,0,0,0,,Szczerze? poczułem ulgę.
Dialogue: 0,0:34:02.04,0:34:04.66,Default,Felix,0,0,0,,Cóż, to oczywiste.
Dialogue: 0,0:34:07.63,0:34:11.52,Default,Subaru,0,0,0,,Udało nam się zachować twarz,\Nzostając w stolicy. Prawda, Rem?
Dialogue: 0,0:34:11.90,0:34:14.80,Default,Rem,0,0,0,,Tak, jesteś naprawdę wspaniały, Subaru.
Dialogue: 0,0:34:16.58,0:34:17.85,Default,Rem,0,0,0,,Kult czarownicy?
Dialogue: 0,0:34:18.22,0:34:21.25,Default,Subaru,0,0,0,,Tak, są w drodze i ścigają Emilię.
Dialogue: 0,0:34:22.41,0:34:26.37,Default,Rem,0,0,0,,Roswaal również się tego obawiał.
Dialogue: 0,0:34:26.62,0:34:27.94,Default,Subaru,0,0,0,,Chcę ich powstrzymać,
Dialogue: 0,0:34:28.36,0:34:30.04,Default,,0,0,0,,ale nie mam siły, by walczyć.
Dialogue: 0,0:34:30.47,0:34:33.34,Default,Subaru,0,0,0,,Muszę już teraz zacząć negocjować,\Nżeby coś zorganizować.
Dialogue: 0,0:34:34.48,0:34:36.32,Default,Subaru,0,0,0,,Pomożesz mi?
Dialogue: 0,0:34:42.24,0:34:43.89,Default,Wilhelm,0,0,0,,Panie Subaru...
Dialogue: 0,0:34:45.94,0:34:47.01,Default,Wilhelm,0,0,0,,Dziękuję.
Dialogue: 0,0:34:47.84,0:34:48.72,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:34:49.31,0:34:50.53,Default,Wilhelm,0,0,0,,Wyrażam wam wdzięczność
Dialogue: 0,0:34:50.84,0:34:54.86,Default,Wilhelm,0,0,0,,równą tej, którą składam mojej pani,\Nksiężnej Crusch.
Dialogue: 0,0:34:55.12,0:34:57.36,Default,Subaru,0,0,0,,E-Eee, to znaczy, hm...
Dialogue: 0,0:34:57.65,0:34:59.26,Default,Wilhelm,0,0,0,,Skoro jesteś tak spostrzegawczy,
Dialogue: 0,0:34:59.56,0:35:02.33,Default,Wilhelm,0,0,0,,Na pewno już wiesz, ale pozwól,\Nże się przedstawię...
Dialogue: 0,0:35:03.09,0:35:04.82,Default,Wilhelm,0,0,0,,Nazywam się Astrea.
Dialogue: 0,0:35:05.56,0:35:09.49,Default,Wilhelm,0,0,0,,Poślubiłem poprzednią Mistrzynię Miecza,\NTheresię van Astrea,
Dialogue: 0,0:35:09.78,0:35:12.33,Default,Wilhelm,0,0,0,,przyznała mi "zaszczyt" bycia\Nostatnim w rodzie.
Dialogue: 0,0:35:12.69,0:35:16.49,Default,Wilhelm,0,0,0,,Właśnie tym jestem ja, Wilhelm van Astrea.
Dialogue: 0,0:35:18.18,0:35:21.01,Default,Wilhelm,0,0,0,,Dziękuję za łaskawe przyjęcie starca,
Dialogue: 0,0:35:21.51,0:35:24.77,Default,Wilhelm,0,0,0,,szansę na pokonanie ohydnej bestii,\Nktóra porwała moją żonę.
Dialogue: 0,0:35:27.27,0:35:29.99,Default,Subaru,0,0,0,,Jasne! Oczywiście, że o tym wiedziałem!
Dialogue: 0,0:35:30.22,0:35:33.62,Default,Subaru,0,0,0,,Pomyślałem, że Crusch przyjmie moją\Npropozycję, mając to na uwadze—
Dialogue: 0,0:35:33.71,0:35:34.89,Default,Crusch,0,0,0,,Subaru...
Dialogue: 0,0:35:35.60,0:35:38.37,Default,Crusch,0,0,0,,Od ciebie wieje kłamstwem.
Dialogue: 0,0:35:49.45,0:35:51.25,Default,Subaru,0,0,0,,Rozumiem...
Dialogue: 0,0:35:51.34,0:35:53.71,Default,Subaru,0,0,0,,Wykupiłeś na tę okazję\Nwszystkie smocze powozy,
Dialogue: 0,0:35:53.80,0:35:56.59,Default,Subaru,0,0,0,,Przez to miałem problem z\Npowrotem do rezydencji.
Dialogue: 0,0:35:56.68,0:35:58.13,Default,Felix,0,0,0,,Jeszcze nie śpisz?
Dialogue: 0,0:35:58.29,0:36:00.27,Default,Subaru,0,0,0,,Jakbym mógł zasnąć.
Dialogue: 0,0:36:00.36,0:36:02.23,Default,Subaru,0,0,0,,Wszyscy inni pracują przez całą noc.
Dialogue: 0,0:36:02.32,0:36:03.61,Default,Felix,0,0,0,,Nie mają wyboru.
Dialogue: 0,0:36:03.73,0:36:04.77,Default,,0,0,0,,Mamy mało czasu.
Dialogue: 0,0:36:04.99,0:36:08.37,Default,Subaru,0,0,0,,Tak, „Biały wieloryb” pojawi\Nsię jutro wieczorem,
Dialogue: 0,0:36:08.46,0:36:10.22,Default,Subaru,0,0,0,,w okolicy Drzewa Flügela.
Dialogue: 0,0:36:10.31,0:36:13.63,Default,Felix,0,0,0,,Biorąc pod uwagę czas podróży,\Nledwo zdążymy.
Dialogue: 0,0:36:13.72,0:36:16.40,Default,Felix,0,0,0,,Poza tym, czyż nie widać tego\Nna ich twarzach?
Dialogue: 0,0:36:19.75,0:36:22.95,Default,Felix,0,0,0,,Nikt nie przygotowuje się do tego chętnie.
Dialogue: 0,0:36:23.04,0:36:25.92,Default,Felix,0,0,0,,Każdy chce się pozbyć Białego Wieloryba,
Dialogue: 0,0:36:26.34,0:36:28.69,Default,Felix,0,0,0,,zwłaszcza stary Wil.
Dialogue: 0,0:36:30.23,0:36:32.57,Default,Subaru,0,0,0,,Powiedział, że jego żona potrzebowała...
Dialogue: 0,0:36:33.14,0:36:34.02,Default,Felix,0,0,0,,Tak.
Dialogue: 0,0:36:34.55,0:36:37.87,Default,Felix,0,0,0,,Przez cały ten czas ścigał\NBiałego Wieloryba.
Dialogue: 0,0:36:38.23,0:36:43.46,Default,Felix,0,0,0,,Odkąd zabił poprzedniego mistrza\Nszermierki, swoją żonę.
Dialogue: 0,0:36:44.29,0:36:46.09,Default,Subaru,0,0,0,,Poprzedni mistrz szermierki...
Dialogue: 0,0:36:46.18,0:36:48.02,Default,Felix,0,0,0,,No cóż, teraz już wiesz,
Dialogue: 0,0:36:48.11,0:36:50.67,Default,Felix,0,0,0,,Więc przestań się martwić i idź spać.
Dialogue: 0,0:36:51.03,0:36:53.29,Default,Felix,0,0,0,,Nic nie możesz zrobić, żeby pomóc
Dialogue: 0,0:36:53.38,0:36:56.07,Default,,0,0,0,,w każdym razie z dystrybucją lub\Norganizacją dostaw.
Dialogue: 0,0:36:56.26,0:36:57.85,Default,Subaru,0,0,0,,Być może to prawda,
Dialogue: 0,0:36:57.94,0:36:59.57,Default,,0,0,0,,ale nie musiałeś tego mówić!
Dialogue: 0,0:37:10.17,0:37:12.95,Default,Subaru,0,0,0,,Mam wybrać dowolną opcję?
Dialogue: 0,0:37:13.77,0:37:15.89,Default,Felix,0,0,0,,O co chodzi? Nie podobają ci się?
Dialogue: 0,0:37:15.98,0:37:17.07,Default,Subaru,0,0,0,,To nie o to chodzi!
Dialogue: 0,0:37:17.16,0:37:19.20,Default,,0,0,0,,Cieszę się, że pozwalasz mi go pożyczyć,
Dialogue: 0,0:37:19.29,0:37:22.00,Default,Subaru,0,0,0,,ale nie potrafię nic powiedzieć\No ich jakości!
Dialogue: 0,0:37:22.33,0:37:26.43,Default,Subaru,0,0,0,,Czy wyglądam na weterana, który\Nbada smoki od dekad...
Dialogue: 0,0:37:31.25,0:37:33.19,Default,Subaru,0,0,0,,Czy to ty jesteś tym z...
Dialogue: 0,0:37:39.65,0:37:41.45,Default,Subaru,0,0,0,,Wygląda na to, że to właśnie to.
Dialogue: 0,0:37:42.41,0:37:44.11,Default,Rem,0,0,0,,Jestem zaskoczony.
Dialogue: 0,0:37:44.20,0:37:48.78,Default,Rem,0,0,0,,Ten smok lądowy należy do gatunku znanego\Nze swojej ogromnej dumy.
Dialogue: 0,0:37:49.09,0:37:50.54,Default,Subaru,0,0,0,,Felis, ja się tym zajmę.
Dialogue: 0,0:37:50.63,0:37:51.87,Default,,0,0,0,,Wielka Miłość!
Dialogue: 0,0:37:52.04,0:37:53.10,Default,Felix,0,0,0,,Jasne.
Dialogue: 0,0:37:53.19,0:37:54.79,Default,Felix,0,0,0,,Ale nie mów: „Wielka Miłość”.
Dialogue: 0,0:37:54.88,0:37:56.50,Default,,0,0,0,,Wtedy, że Rem robi smutną minę.
Dialogue: 0,0:37:56.59,0:37:58.28,Default,Rem,0,0,0,,Nie dąsam się!
Dialogue: 0,0:37:58.54,0:38:01.52,Default,,0,0,0,,Będę do niego miły! Dam radę!
Dialogue: 0,0:38:13.59,0:38:14.72,Default,Subaru,0,0,0,,Co?!
Dialogue: 0,0:38:15.16,0:38:17.52,Default,Ricardo,0,0,0,,Moja pani opowiadała mi o tobie.
Dialogue: 0,0:38:17.61,0:38:20.44,Default,Ricardo,0,0,0,,To ty jesteś gwiazdą tego małego\Nprzedstawienia, prawda?
Dialogue: 0,0:38:20.53,0:38:23.57,Default,Subaru,0,0,0,,To logo… I akcent Kararagi u półczłowieka…
Dialogue: 0,0:38:19.85,0:38:21.47,SignA,Text,0,0,0,,Ho
Dialogue: 0,0:38:24.30,0:38:25.97,Default,Subaru,0,0,0,,Więc jesteś z Anastasią?
Dialogue: 0,0:38:26.06,0:38:27.92,Default,Ricardo,0,0,0,,Co, wiedziałeś?
Dialogue: 0,0:38:28.28,0:38:30.27,Default,Ricardo,0,0,0,,Jestem Ricardo, dowódca jej najemników.
Dialogue: 0,0:38:31.07,0:38:33.20,Default,Ricardo,0,0,0,,Miło cię poznać, mała damo!
Dialogue: 0,0:38:33.98,0:38:35.68,Default,Subaru,0,0,0,,Cicho bądź! Jesteś ogromny!
Dialogue: 0,0:38:35.77,0:38:37.00,Default,,0,0,0,,Złamiesz mi kark!
Dialogue: 0,0:38:37.09,0:38:38.35,Default,Ricardo,0,0,0,,Hej! Moja pani!
Dialogue: 0,0:38:38.44,0:38:39.71,Default,Subaru,0,0,0,,Hej!
Dialogue: 0,0:38:40.31,0:38:41.30,Default,Subaru,0,0,0,,Auć...
Dialogue: 0,0:38:42.60,0:38:46.26,Default,Crusch,0,0,0,,Oto powód do dumy Anastazji i\NHoshinsów – Żelazny Kieł...
Dialogue: 0,0:38:46.70,0:38:49.89,Default,Crusch,0,0,0,,Rozumiem. Wszyscy wyglądają\Nna dość silnych.
Dialogue: 0,0:38:49.98,0:38:51.14,Default,Crusch,0,0,0,,Wyspałeś się w nocy?
Dialogue: 0,0:38:51.32,0:38:53.72,Default,Subaru,0,0,0,,Przed chwilą omal nie zginąłem...
Dialogue: 0,0:38:54.04,0:38:56.78,Default,Subaru,0,0,0,,Aha, to znaczy, że ty też walczysz?
Dialogue: 0,0:38:56.87,0:38:58.18,Default,Crusch,0,0,0,,Myślisz, że dam radę?
Dialogue: 0,0:38:58.27,0:39:01.71,Default,,0,0,0,,czy nie wolisz po prostu usiąść na krześle\Ni czekać na dobre wieści?
Dialogue: 0,0:39:01.80,0:39:04.91,Default,Crusch,0,0,0,,Bardziej mnie zaskakuje, że\Nw tym bierzesz udział.
Dialogue: 0,0:39:05.00,0:39:06.31,Default,Crusch,0,0,0,,Potrafisz walczyć?
Dialogue: 0,0:39:06.40,0:39:07.85,Default,Subaru,0,0,0,,Nie, nie mogę.
Dialogue: 0,0:39:07.94,0:39:09.95,Default,Subaru,0,0,0,,Ale nawet jeśli nie mogę walczyć,
Dialogue: 0,0:39:10.48,0:39:14.79,Default,Subaru,0,0,0,,Myślę, że ten człowiek będzie całkiem\Nprzydatny w walce z Białym Wielorybem.
Dialogue: 0,0:39:14.88,0:39:16.99,Default,Crusch,0,0,0,,Muszę zapytać… Na jakiej podstawie?
Dialogue: 0,0:39:17.50,0:39:20.33,Default,Subaru,0,0,0,,Sam też nie jestem z tego zbyt zadowolony,
Dialogue: 0,0:39:20.42,0:39:23.58,Default,Subaru,0,0,0,,Chyba po prostu przyciągam potwory.
Dialogue: 0,0:39:24.41,0:39:25.60,Default,Crusch,0,0,0,,Co?
Dialogue: 0,0:39:26.90,0:39:28.35,Default,Rem,0,0,0,,To prawda.
Dialogue: 0,0:39:28.44,0:39:31.76,Default,Rem,0,0,0,,Dlatego Subaru już kiedyś\Nuratował mi życie.
Dialogue: 0,0:39:32.07,0:39:33.52,Default,Subaru,0,0,0,,Na moim smoku ziemnym,
Dialogue: 0,0:39:33.61,0:39:37.54,Default,Subaru,0,0,0,,będę biegał przed Białym Wielorybem\Ni odwrócę jego uwagę,
Dialogue: 0,0:39:37.63,0:39:40.01,Default,Subaru,0,0,0,,a wy w tym czasie rozpoczniecie\Ntotalny atak!
Dialogue: 0,0:39:40.10,0:39:42.61,Default,Subaru,0,0,0,,To właśnie tę taktykę bym polecił.
Dialogue: 0,0:39:43.11,0:39:45.68,Default,Crusch,0,0,0,,Pod nosem Białego Wieloryba?
Dialogue: 0,0:39:48.25,0:39:50.98,Default,Crusch,0,0,0,,Zaskakujące, ale nie kłamiesz.
Dialogue: 0,0:39:51.67,0:39:53.21,Default,Crusch,0,0,0,,Nigdy bym nie pomyślał
Dialogue: 0,0:39:53.30,0:39:57.55,Default,Crusch,0,0,0,,w pół dnia zwątpiłam w moją\Nboską opiekę częściej niż kiedykolwiek.
Dialogue: 0,0:40:02.39,0:40:03.37,Default,Crusch,0,0,0,,Już są.
Dialogue: 0,0:40:07.22,0:40:11.12,Default,Conwood,0,0,0,,Crusch, dotarliśmy.
Dialogue: 0,0:40:12.58,0:40:14.11,Default,Conwood,0,0,0,,Czy ten chłopak...
Dialogue: 0,0:40:14.20,0:40:15.64,Default,Crusch,0,0,0,,Tak, to prawda.
Dialogue: 0,0:40:18.47,0:40:20.20,Default,Conwood,0,0,0,,Dziękuję ci, młody człowieku.
Dialogue: 0,0:40:20.29,0:40:21.22,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:40:21.31,0:40:24.00,Default,Conwood,0,0,0,,Dzięki Wam nasze marzenie\Nmoże się spełnić.
Dialogue: 0,0:40:24.09,0:40:25.72,Default,Conwood,0,0,0,,Cieszy nas to.
Dialogue: 0,0:40:26.64,0:40:27.68,Default,Conwood,0,0,0,,Dziękuję.
Dialogue: 0,0:40:35.91,0:40:39.19,Default,Rem,0,0,0,,Wygląda na to, że każdy ma porachunki\Nz Białym Wielorybem.
Dialogue: 0,0:40:39.54,0:40:42.96,Default,Subaru,0,0,0,,Więc są tacy jak pan Wilhelm?
Dialogue: 0,0:40:43.23,0:40:46.91,Default,Crusch,0,0,0,,Tak, wielu to weterani z pierwszej linii.
Dialogue: 0,0:40:47.64,0:40:51.78,Default,Crusch,0,0,0,,Dołączyli do naszych sił okupacyjnych\Nna zaproszenie Wilhelma.
Dialogue: 0,0:40:52.06,0:40:53.17,Default,Crusch,0,0,0,,Ich doświadczenie
Dialogue: 0,0:40:53.26,0:40:55.52,Default,Crusch,0,0,0,,dorównuje osiągnięciom rycerzy ze stolicy.
Dialogue: 0,0:40:56.59,0:40:58.21,Default,Felix,0,0,0,,Crusch, już czas.
Dialogue: 0,0:40:58.30,0:40:59.19,Default,Crusch,0,0,0,,Racja.
Dialogue: 0,0:41:05.71,0:41:07.04,Default,Crusch,0,0,0,,Czterysta lat.
Dialogue: 0,0:41:07.67,0:41:09.68,Default,Crusch,0,0,0,,Od pojawienia się Wieloryba Czarownicy,
Dialogue: 0,0:41:10.05,0:41:11.96,Default,,0,0,0,,uczynił świat swoim terenem łowieckim,
Dialogue: 0,0:41:12.05,0:41:15.76,Default,Crusch,0,0,0,,depcząc słabszych i panując nad ziemią,\Njakby była jej właścicielem,
Dialogue: 0,0:41:15.85,0:41:17.77,Default,Crusch,0,0,0,,minęło czterysta lat.
Dialogue: 0,0:41:18.18,0:41:21.68,Default,Crusch,0,0,0,,W tym czasie zginęła\Nniezliczona liczba osób.
Dialogue: 0,0:41:22.10,0:41:24.74,Default,Crusch,0,0,0,,Biorąc pod uwagę bezwzględność tej mgły,
Dialogue: 0,0:41:25.07,0:41:28.70,Default,Crusch,0,0,0,,przybywać będzie tylko\Nbezimiennych grobów.
Dialogue: 0,0:41:30.94,0:41:33.84,Default,Crusch,0,0,0,,Ale te dni bezczynności\Nkończą się dzisiaj!
Dialogue: 0,0:41:34.58,0:41:36.91,Default,Crusch,0,0,0,,Dzisiaj my położymy temu kres!
Dialogue: 0,0:41:37.00,0:41:40.34,Default,Crusch,0,0,0,,Pokonamy Białego Wieloryba i\Npowstrzymamy kolejne tragedie!
Dialogue: 0,0:41:41.29,0:41:44.15,Default,Crusch,0,0,0,,Pokażemy smutek, to będzie
Dialogue: 0,0:41:44.24,0:41:46.52,Default,,0,0,0,,okazja, by wylać zaległe łzy!
Dialogue: 0,0:41:48.52,0:41:49.53,Default,Crusch,0,0,0,,Ruszamy!
Dialogue: 0,0:41:50.05,0:41:53.11,Default,Crusch,0,0,0,,Naszym celem jest Drzewo Flügela,\Nprzy autostradzie Lifaus.
Dialogue: 0,0:41:53.51,0:41:57.16,Default,Crusch,0,0,0,,Dzisiaj wieczorem własnoręcznie\Npokonamy Białego Wieloryba!
Dialogue: 0,0:42:06.71,0:42:08.98,Default,Mimi,0,0,0,,Cześć, jestem Mimi! Miło cię poznać!
Dialogue: 0,0:42:09.07,0:42:11.46,Default,Hetaro,0,0,0,,Nazywam się Hetaro. Miło mi cię poznać.
Dialogue: 0,0:42:11.56,0:42:13.09,Default,Subaru,0,0,0,,Tak, miło cię poznać.
Dialogue: 0,0:42:13.18,0:42:16.09,Default,Subaru,0,0,0,,W każdym razie, nie żebym\Nw to wątpił, ale...
Dialogue: 0,0:42:16.67,0:42:18.95,Default,Subaru,0,0,0,,Naprawdę jesteś zastępcą dowódcy, co?
Dialogue: 0,0:42:19.17,0:42:22.68,Default,Mimi,0,0,0,,Hm? Czy my się już gdzieś spotkaliśmy?
Dialogue: 0,0:42:22.84,0:42:26.37,Default,Mimi,0,0,0,,Hmm... Zupełnie nie pamiętam!
Dialogue: 0,0:42:26.58,0:42:29.67,Default,Hetaro,0,0,0,,Siostro, stań prosto.
Dialogue: 0,0:42:27.77,0:42:30.37,Default,Mimi,0,0,0,,{\an8}Absolutnie nie potrafię...
Dialogue: 0,0:42:30.46,0:42:33.06,Default,Subaru,0,0,0,,Nie przejmuj się tym...\NPo prostu gadam do siebie.
Dialogue: 0,0:42:33.15,0:42:34.40,Default,Subaru,0,0,0,,Nazywam się Subaru.
Dialogue: 0,0:42:34.49,0:42:36.69,Default,,0,0,0,,Więc jesteście rodzeństwem, co?
Dialogue: 0,0:42:36.94,0:42:38.85,Default,Hetaro,0,0,0,,Tak, moja siostra i ja zajmiemy się…
Dialogue: 0,0:42:38.94,0:42:41.32,Default,Mimi,0,0,0,,Kiedy Mimi i Hetaro są\Nrazem jesteśmy silni!
Dialogue: 0,0:42:41.41,0:42:43.81,Default,Mimi,0,0,0,,Kapitan też tu jest, więc\Njesteśmy najsilniejsi!
Dialogue: 0,0:42:44.98,0:42:48.76,Default,Mimi,0,0,0,,{\an8}Najsilniejszy! Najsilniejszy!\NNajsilniejszy ze wszystkich!
Dialogue: 0,0:42:44.63,0:42:49.10,Default,Hetaro,0,0,0,,No cóż, moja siostra i kapitan\Nmają tendencję do pochopnych decyzji,
Dialogue: 0,0:42:49.30,0:42:51.12,Default,Hetaro,0,0,0,,dlatego ja wydaję polecenia.
Dialogue: 0,0:42:51.21,0:42:52.56,Default,Subaru,0,0,0,,Rozumiem...
Dialogue: 0,0:42:52.86,0:42:54.53,Default,,0,0,0,,To musi być ciężkie...
Dialogue: 0,0:42:54.62,0:42:57.10,Default,Ricardo,0,0,0,,Co z tobą, stary? Wyglądasz na przybitego.
Dialogue: 0,0:42:57.19,0:42:58.78,Default,Subaru,0,0,0,,Czyja to wina?
Dialogue: 0,0:42:58.87,0:43:01.11,Default,Subaru,0,0,0,,Kapitan nie powinien sprawiać kłopotów.
Dialogue: 0,0:43:01.20,0:43:03.58,Default,Ricardo,0,0,0,,Hej, masz tam niezłego smoka ziemnego.
Dialogue: 0,0:43:03.67,0:43:04.80,Default,Subaru,0,0,0,,Hej!
Dialogue: 0,0:43:05.53,0:43:06.91,Default,Subaru,0,0,0,,Naprawdę?
Dialogue: 0,0:43:07.25,0:43:10.61,Default,,0,0,0,,Pożyczyłem tę książkę, bo wydawało\Nmi się, że będzie dobra, ale...
Dialogue: 0,0:43:10.70,0:43:11.92,Default,Subaru,0,0,0,,Jak tak sobie pomyśleć,
Dialogue: 0,0:43:12.01,0:43:13.94,Default,,0,0,0,,Te, wyglądają inaczej.
Dialogue: 0,0:43:14.20,0:43:15.72,Default,Ricardo,0,0,0,,Nazywają się rigersami.
Dialogue: 0,0:43:15.81,0:43:17.77,Default,Ricardo,0,0,0,,Ale tutaj nie ma ich zbyt dużo.
Dialogue: 0,0:43:18.22,0:43:20.29,Default,Ricardo,0,0,0,,Nie są tak silne jak smoki lądowe,
Dialogue: 0,0:43:20.38,0:43:22.24,Default,,0,0,0,,ale są o wiele zwinniejsze.
Dialogue: 0,0:43:22.33,0:43:24.21,Default,Ricardo,0,0,0,,Jeśli dojdzie do starcia z Whale,
Dialogue: 0,0:43:24.30,0:43:27.06,Default,Ricardo,0,0,0,,właśnie tam są inne,\Nwięc przyglądaj się uważnie.
Dialogue: 0,0:43:28.38,0:43:32.45,Default,Subaru,0,0,0,,Nie lepiej było przewieźć\Nładunek smokami naziemnymi?
Dialogue: 0,0:43:32.83,0:43:35.91,Default,Ricardo,0,0,0,,Musimy sami zająć się naszym bagażem.
Dialogue: 0,0:43:36.37,0:43:38.78,Default,Ricardo,0,0,0,,Myślisz, że Biały Wieloryb\Nto nasz jedyny wróg,
Dialogue: 0,0:43:38.87,0:43:41.04,Default,Ricardo,0,0,0,,to zostaniesz z niczym.
Dialogue: 0,0:43:42.65,0:43:46.54,Default,Ricardo,0,0,0,,W końcu nie ma żadnej gwarancji, że\Npo drodze nie natkniemy się na złodziei.
Dialogue: 0,0:43:46.63,0:43:50.06,Default,Subaru,0,0,0,,Jeśli ktoś ma odwagę zmierzyć\Nsię z taką w pełni uzbrojoną grupą,
Dialogue: 0,0:43:50.15,0:43:51.78,Default,Subaru,0,0,0,,lepiej nie być złodziejem.
Dialogue: 0,0:43:51.89,0:43:53.89,Default,Ricardo,0,0,0,,Słuszna uwaga!
Dialogue: 0,0:44:00.46,0:44:05.73,Default,Rem,0,0,0,,Wygląda na to, że Ricardo\Npróbuje wszystkich uspokoić.
Dialogue: 0,0:44:06.29,0:44:07.17,Default,Rem,0,0,0,,Subaru?
Dialogue: 0,0:44:10.26,0:44:12.95,Default,Subaru,0,0,0,,Myślałem, że się na to przygotowałem...
Dialogue: 0,0:44:13.44,0:44:16.02,Default,Subaru,0,0,0,,Możesz nakazać bohaterowi\Nw sobie, by się obudził,
Dialogue: 0,0:44:16.11,0:44:18.32,Default,Subaru,0,0,0,,ale to nie jest tak proste,\Njak się wydaje.
Dialogue: 0,0:44:33.73,0:44:35.90,Default,Subaru,0,0,0,,To jest ogromne!
Dialogue: 0,0:44:36.20,0:44:38.50,Default,Rem,0,0,0,,Wyglądasz na zadowolonego, Subaru.
Dialogue: 0,0:44:43.14,0:44:46.52,Default,Subaru,0,0,0,,O, wygląda na to, że ktoś wyrył\Nswoje imię na pniu.
Dialogue: 0,0:44:46.63,0:44:48.45,Default,Subaru,0,0,0,,To nie jest jakaś wycieczka szkolna.
Dialogue: 0,0:44:48.54,0:44:50.65,Default,,0,0,0,,To po prostu brak wychowania...
Dialogue: 0,0:44:50.74,0:44:52.70,Default,Subaru,0,0,0,,Rem, podaj mi dłuto!
Dialogue: 0,0:44:52.79,0:44:55.83,Default,Rem,0,0,0,,Nawet ty powinieneś wiedzieć,\Nże to same kłopoty, Subaru.
Dialogue: 0,0:44:55.92,0:44:57.27,Default,Rem,0,0,0,,Na początek ze mną.
Dialogue: 0,0:44:58.38,0:45:00.37,Default,Rem,0,0,0,,Więc Biały Wieloryb tu płynie?
Dialogue: 0,0:45:01.51,0:45:03.51,Default,Rem,0,0,0,,Szczerze mówiąc, jestem przeciwna
Dialogue: 0,0:45:03.96,0:45:06.89,Default,,0,0,0,,by użyć zapachu Czarownicy\Ndo zwabienia Białego Wieloryba.
Dialogue: 0,0:45:06.98,0:45:08.10,Default,Rem,0,0,0,,To zbyt niebezpieczne.
Dialogue: 0,0:45:08.33,0:45:10.89,Default,Subaru,0,0,0,,Wykorzystam wszystko, co się da.
Dialogue: 0,0:45:11.89,0:45:15.56,Default,Subaru,0,0,0,,Jeśli to zwiększa szanse\Nna wygraną, warto.
Dialogue: 0,0:45:16.05,0:45:18.05,Default,Subaru,0,0,0,,Jak na kogoś, kto ma same wady,
Dialogue: 0,0:45:18.14,0:45:20.53,Default,Subaru,0,0,0,,Mogę to zrekompensować tylko w ten sposób.
Dialogue: 0,0:45:21.87,0:45:24.02,Default,Rem,0,0,0,,Jesteś wspaniały, Subaru.
Dialogue: 0,0:45:27.93,0:45:31.91,Default,Rem,0,0,0,,Czy ta metia powie ci, kiedy\Npojawi się Biały Wieloryb?
Dialogue: 0,0:45:32.07,0:45:35.35,Default,Subaru,0,0,0,,Tak, ustawiłem to tak, żeby wydawało\Ndźwięk, gdy nadejdzie pora.
Dialogue: 0,0:45:35.86,0:45:36.85,Default,Subaru,0,0,0,,Szczerze mówiąc, …
Dialogue: 0,0:45:36.94,0:45:37.82,Default,Rem,0,0,0,,To nieprawda.
Dialogue: 0,0:45:40.01,0:45:42.12,Default,Subaru,0,0,0,,Co… co ty mówisz?
Dialogue: 0,0:45:42.21,0:45:44.37,Default,Subaru,0,0,0,,{\an8}Jeśli to kłamstwo, to jak mam...
Dialogue: 0,0:45:44.46,0:45:47.23,Default,Rem,0,0,0,,Mówisz w dialekcie Kararagi.
Dialogue: 0,0:45:47.32,0:45:48.96,Default,Rem,0,0,0,,To w ogóle do ciebie nie pasuje.
Dialogue: 0,0:45:49.05,0:45:52.33,Default,Subaru,0,0,0,,Nie, nie, nie! To znaczy,\Nnie ma mowy, żebym kłamał!
Dialogue: 0,0:45:52.42,0:45:53.73,Default,Subaru,0,0,0,,Crusch powiedziała, że…
Dialogue: 0,0:45:53.82,0:45:55.19,Default,Rem,0,0,0,,Nie ma sprawy, Subaru.
Dialogue: 0,0:45:55.86,0:45:59.94,Default,Rem,0,0,0,,Zawsze wiem, kiedy kłamiesz.
Dialogue: 0,0:46:00.55,0:46:04.03,Default,Rem,0,0,0,,Wiem też, że nie potrafisz mi\Nwyjaśnić, dlaczego tak robisz.
Dialogue: 0,0:46:04.77,0:46:06.96,Default,Rem,0,0,0,,Nie ma więc potrzeby, by mnie przekonywać
Dialogue: 0,0:46:07.05,0:46:08.96,Default,,0,0,0,,albo wszystko owijać w kłamstwa,
Dialogue: 0,0:46:09.05,0:46:13.20,Default,Rem,0,0,0,,albo nie próbuj w ten\Nsposób brać winy na siebie.
Dialogue: 0,0:46:15.22,0:46:19.78,Default,Rem,0,0,0,,Bo mam do ciebie pełne zaufanie, Subaru.
Dialogue: 0,0:46:27.51,0:46:31.86,Default,Subaru,0,0,0,,Rany! Widok tego ogromnego\Ndrzewa naprawdę dodaje energii, co?
Dialogue: 0,0:46:31.95,0:46:33.73,Default,Rem,0,0,0,,Tak, to prawda.
Dialogue: 0,0:46:34.95,0:46:38.35,Default,Subaru,0,0,0,,Jeśli nie będę na to patrzeć przez\Ndłuższy czas, nie odpocznę!
Dialogue: 0,0:46:38.75,0:46:41.04,Default,Subaru,0,0,0,,Przez jakiś czas nie będę\Nmógł patrzeć w dół!
Dialogue: 0,0:46:41.22,0:46:43.34,Default,Rem,0,0,0,,Tak, masz rację.
Dialogue: 0,0:46:47.17,0:46:50.82,Default,Subaru,0,0,0,,Powinienem teraz raczej mówić\N„dziękuję” zamiast „przepraszam”, co?
Dialogue: 0,0:46:52.22,0:46:54.85,Default,Rem,0,0,0,,Nie ma za co.
Dialogue: 0,0:46:55.68,0:47:00.88,Default,Rem,0,0,0,,Poza tym jestem ci\Nbardzo wdzięczna, Subaru.
Dialogue: 0,0:47:01.28,0:47:02.34,Default,Rem,0,0,0,,Więc jesteśmy kwita.
Dialogue: 0,0:47:14.13,0:47:16.11,Default,Subaru,0,0,0,,Eee... Panie Wilhelm?
Dialogue: 0,0:47:18.30,0:47:20.40,Default,Subaru,0,0,0,,Słyszałem fragment tej historii od Felisa.
Dialogue: 0,0:47:21.48,0:47:24.95,Default,Subaru,0,0,0,,Że mścisz się na Wielorybie odkąd\Nten porwał twoją żonę.
Dialogue: 0,0:47:26.08,0:47:27.44,Default,Wilhelm,0,0,0,,Proszę o tym zapomnieć.
Dialogue: 0,0:47:28.14,0:47:32.16,Default,Wilhelm,0,0,0,,Był to czas stracony na próżno w\Nurojeniach starego człowieka.
Dialogue: 0,0:47:32.84,0:47:34.78,Default,Rem,0,0,0,,Naprawdę kochasz swoją żonę, prawda?
Dialogue: 0,0:47:36.93,0:47:39.30,Default,Wilhelm,0,0,0,,Tak, kocham swoją żonę.
Dialogue: 0,0:47:40.00,0:47:41.45,Default,Wilhelm,0,0,0,,Bardziej niż ktokolwiek inny.
Dialogue: 0,0:47:41.84,0:47:44.01,Default,,0,0,0,,I bez względu na to, ile czasu minie.
Dialogue: 0,0:47:45.52,0:47:49.08,Default,Wilhelm,0,0,0,,Moja żona była kobietą,\Nktóra uwielbiała patrzeć na kwiaty.
Dialogue: 0,0:47:50.98,0:47:53.00,Default,Wilhelm,0,0,0,,Nigdy nie chciała władać mieczem,
Dialogue: 0,0:47:53.09,0:47:55.40,Default,Wilhelm,0,0,0,,ale miecz kochał ją\Nnajbardziej na świecie.
Dialogue: 0,0:47:56.40,0:47:58.77,Default,Wilhelm,0,0,0,,Mając za jedyny wybór\Npoświęcenie się mieczowi,
Dialogue: 0,0:47:59.20,0:48:02.87,Default,Wilhelm,0,0,0,,moja żona pogodziła się ze swoim losem.
Dialogue: 0,0:48:04.37,0:48:06.58,Default,Wilhelm,0,0,0,,Kiedy się z nią\Nożeniłem, odebrałem jej to,
Dialogue: 0,0:48:06.67,0:48:09.08,Default,Wilhelm,0,0,0,,co pozbawiło ją tytułu „Mistrzyni Miecza”.
Dialogue: 0,0:48:10.08,0:48:13.50,Default,Wilhelm,0,0,0,,Ale miecz nie pozwolił jej tego zrobić.
Dialogue: 0,0:48:17.34,0:48:20.20,Default,Wilhelm,0,0,0,,Panie Subaru, jeszcze raz dziękuję.
Dialogue: 0,0:48:20.89,0:48:24.63,Default,Wilhelm,0,0,0,,W tej walce odpowiedzi znajdę\Nw moim własnym mieczu.
Dialogue: 0,0:48:26.59,0:48:30.50,Default,Wilhelm,0,0,0,,I być może w końcu uda mi\Nsię odwiedzić grób mojej żony.
Dialogue: 0,0:48:32.26,0:48:34.60,Default,Wilhelm,0,0,0,,W końcu mogę ją odwiedzić.
Dialogue: 0,0:48:39.39,0:48:43.41,Default,Subaru,0,0,0,,Zabierzmy się razem za tego\Ncholernego wieloryba i dajmy mu popalić.
Dialogue: 0,0:48:43.68,0:48:45.68,Default,Subaru,0,0,0,,Ja też zrobię wszystko, co w mojej mocy.
Dialogue: 0,0:49:08.04,0:49:10.26,Default,Crusch,0,0,0,,Zostało już niewiele czasu.
Dialogue: 0,0:49:35.45,0:49:36.92,Default,Crusch,0,0,0,,Żołnierze, bądźcie czujni!
Dialogue: 0,0:49:45.64,0:49:47.21,Default,Guy,0,0,0,,Nie rozumiem tego...
Dialogue: 0,0:49:57.83,0:49:59.11,Default - italics,Crusch,0,0,0,,Nie przyjedzie?
Dialogue: 0,0:50:00.65,0:50:01.55,Default,Guy,0,0,0,,Czy to...
Dialogue: 0,0:50:37.40,0:50:38.36,Default,Crusch,0,0,0,,Żołnierze
Dialogue: 0,0:50:37.89,0:50:39.79,Default,Subaru,0,0,0,,Niech mu się dostanie!
Dialogue: 0,0:50:39.88,0:50:41.14,Default - italics,Rem,0,0,0,,Al Huma!
Dialogue: 0,0:50:57.36,0:51:00.77,Default,Crusch,0,0,0,,Żołnierze! Za tymi dwoma głupcami!
Dialogue: 0,0:51:06.95,0:51:09.92,Episode Title,Title,0,0,0,,Walka z białym wielorybem
