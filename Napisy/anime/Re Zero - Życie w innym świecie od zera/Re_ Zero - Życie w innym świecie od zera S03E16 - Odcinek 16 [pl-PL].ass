Dialogue: 0,0:00:29.15,0:00:30.67,Default - flashback,Shima,0,0,0,,Młody Gar, przestań!
Dialogue: 0,0:00:30.92,0:00:32.83,Default - flashback,,0,0,0,,Przestań! Przestań!
Dialogue: 0,0:00:51.49,0:00:52.94,Default - flashback,Shima,0,0,0,,Młody Gar...
Dialogue: 0,0:01:02.78,0:01:04.88,Default,Subaru,0,0,0,,Otto, idioto.
Dialogue: 0,0:01:04.97,0:01:07.58,Default,Subaru,0,0,0,,Zrobiłeś coś szalonego, prawda?
Dialogue: 0,0:01:07.95,0:01:10.69,Default,Garfiel,0,0,0,,Nie wiedziałem, że go na to stać.
Dialogue: 0,0:01:11.07,0:01:14.34,Default,Garfiel,0,0,0,,Jakby tego było mało, przeciągnął nawet\NRam na swoją stronę...
Dialogue: 0,0:01:14.55,0:01:16.59,Default,Garfiel,0,0,0,,A teraz wyglądam tak!
Dialogue: 0,0:01:16.89,0:01:18.02,Default,Subaru,0,0,0,,Ram?
Dialogue: 0,0:01:18.11,0:01:19.30,Default,Subaru,0,0,0,,Co się z nimi stało?
Dialogue: 0,0:01:19.61,0:01:23.38,Default,Garfiel,0,0,0,,Mam gdzieś to, co knujecie.
Dialogue: 0,0:01:23.47,0:01:24.89,Default,Subaru,0,0,0,,Nie zabiłeś ich, prawda?
Dialogue: 0,0:01:25.09,0:01:26.98,Default,Garfiel,0,0,0,,Mówiłem, że mam to gdzieś!
Dialogue: 0,0:01:27.33,0:01:31.11,Default,Garfiel,0,0,0,,Odsuń się. Rozwalę wejście
Dialogue: 0,0:01:31.20,0:01:33.82,Default,Garfiel,0,0,0,,i położę temu kres.
Dialogue: 0,0:01:34.15,0:01:38.52,Default,Subaru,0,0,0,,Jeśli to zrobisz, Sanktuarium\Nzostanie zamknięte na zawsze.
Dialogue: 0,0:01:38.61,0:01:40.03,Default,Subaru,0,0,0,,Czy tego chcesz?
Dialogue: 0,0:01:40.86,0:01:42.57,Default,Garfiel,0,0,0,,Tak.
Dialogue: 0,0:01:42.66,0:01:45.54,Default,Garfiel,0,0,0,,Wszystko inne jest problemem!
Dialogue: 0,0:02:01.25,0:02:04.16,Default,Garfiel,0,0,0,,Co ty wyprawiasz?
Dialogue: 0,0:02:04.92,0:02:09.06,Default,Emilia,0,0,0,,Garfiel, czego się tak boisz?
Dialogue: 0,0:02:09.62,0:02:12.36,Default,Garfiel,0,0,0,,Myślisz, że się boję?
Dialogue: 0,0:02:12.85,0:02:14.47,Default,Emilia,0,0,0,,Boisz się.
Dialogue: 0,0:02:14.56,0:02:18.77,Default,Emilia,0,0,0,,Dlatego krzyczysz i próbujesz\Nwyglądać na większego, prawda?
Dialogue: 0,0:02:18.86,0:02:19.83,Default,Garfiel,0,0,0,,Co ty...
Dialogue: 0,0:02:19.92,0:02:23.04,Default,Garfiel,0,0,0,,Co ty, do diabła, myślisz,\Nże o mnie wiesz?!
Dialogue: 0,0:02:23.13,0:02:24.18,Default,Emilia,0,0,0,,Wiem.
Dialogue: 0,0:02:24.59,0:02:29.42,Default,Emilia,0,0,0,,Bo... bałam się wielu\Nrzeczy przez całe życie.
Dialogue: 0,0:02:30.32,0:02:33.58,Default,Emilia,0,0,0,,Do dziś żyłam w strachu.
Dialogue: 0,0:02:33.67,0:02:37.24,Default,Emilia,0,0,0,,Powierzyłam Puckowi złe\Nwspomnienia, by o nich zapomnieć,
Dialogue: 0,0:02:37.33,0:02:38.86,Default,Emilia,0,0,0,,W końcu sobie przypomniałam.
Dialogue: 0,0:02:38.95,0:02:40.09,Default,Garfiel,0,0,0,,Zamknij się.
Dialogue: 0,0:02:40.54,0:02:44.65,Default,Emilia,0,0,0,,Wciąż nie wiem, co mam zrobić.
Dialogue: 0,0:02:44.74,0:02:47.86,Default,Emilia,0,0,0,,Muszę się dowiedzieć, co to jest.
Dialogue: 0,0:02:48.36,0:02:49.24,Default,,0,0,0,,Ale...
Dialogue: 0,0:02:49.33,0:02:51.27,Default,Garfiel,0,0,0,,Zamknij się! Wynoś się!
Dialogue: 0,0:02:51.36,0:02:54.25,Default,Garfiel,0,0,0,,Nie... nawet się nie waż...
Dialogue: 0,0:02:54.34,0:02:58.33,Default,Emilia,0,0,0,,Ale przecież sam już znalazłeś coś\Ntakiego, prawda?
Dialogue: 0,0:02:58.42,0:03:00.13,Default,Garfiel,0,0,0,,Mówiłem, żebyś się zamknęła!
Dialogue: 0,0:03:00.22,0:03:02.70,Default,Subaru,0,0,0,,Wszystko robisz na pół gwizdka, Garfiel.
Dialogue: 0,0:03:03.12,0:03:06.39,Default,Subaru,0,0,0,,To prawda, że Emilia raz nie przeszła\Npróby.
Dialogue: 0,0:03:06.48,0:03:08.36,Default,Subaru,0,0,0,,Nie przeczę, że wypłakała oczy,
Dialogue: 0,0:03:08.45,0:03:11.55,Default,,0,0,0,,gdy pokazano jej przeszłość, której nie\Nchciała oglądać.
Dialogue: 0,0:03:12.10,0:03:15.28,Default,Subaru,0,0,0,,Ale Emilia będzie próbować, raz po raz.
Dialogue: 0,0:03:15.64,0:03:18.63,Default,Subaru,0,0,0,,W przeciwieństwie do ciebie,\Nktóry się poddał i uciekł.
Dialogue: 0,0:03:18.72,0:03:22.48,Default,Subaru,0,0,0,,Garfiel, czy żywisz urazę
Dialogue: 0,0:03:22.57,0:03:24.78,Default,Subaru,0,0,0,,do matki, która cię porzuciła?
Dialogue: 0,0:03:28.08,0:03:29.28,Default,Subaru,0,0,0,,Wybacz, stary.
Dialogue: 0,0:03:29.37,0:03:31.62,Default,Subaru,0,0,0,,Wchodząc do czyjegoś domu, zdejmujemy\Nbuty,
Dialogue: 0,0:03:31.71,0:03:36.27,Default,Subaru,0,0,0,,ale w rodzinie Natsukich depczemy ludziom\Npo sercach, nie zdejmując obuwia.
Dialogue: 0,0:03:36.61,0:03:41.12,Default,Subaru,0,0,0,,Twoja matka zostawiła ciebie i Fredericę,\Ngdy opuściła Sanktuarium.
Dialogue: 0,0:03:41.58,0:03:44.12,Default,Subaru,0,0,0,,A potem... co zrobiłeś?
Dialogue: 0,0:03:48.76,0:03:50.70,Default,Subaru,0,0,0,,Frederica też opuściła Sanktuarium.
Dialogue: 0,0:03:51.25,0:03:53.67,Default,Subaru,0,0,0,,Wierzyła, że w końcu je wyzwolisz.
Dialogue: 0,0:03:54.21,0:03:58.06,Default,Subaru,0,0,0,,Więc wyszła, by przygotować na zewnątrz\Nmiejsce dla tutejszych mieszkańców.
Dialogue: 0,0:03:58.27,0:04:01.21,Default,Subaru,0,0,0,,A co ty robiłeś w środku?
Dialogue: 0,0:04:01.30,0:04:06.37,Default,Subaru,0,0,0,,Chcesz na zawsze zamknąć Sanktuarium, bo\Nnienawidzisz swojej matki
Dialogue: 0,0:04:06.46,0:04:09.32,Default,Subaru,0,0,0,,i świata zewnętrznego, przez który cię\Nopuściła?
Dialogue: 0,0:04:09.41,0:04:11.16,Default,Subaru,0,0,0,,Bo nie chcesz zostać tu zraniony?!
Dialogue: 0,0:04:11.25,0:04:13.72,Default,Garfiel,0,0,0,,Nie, ty... Co ty w ogóle...
Dialogue: 0,0:04:13.81,0:04:15.88,Default,Subaru,0,0,0,,Nie wiem! Dopóki mi nie powiesz!
Dialogue: 0,0:04:15.97,0:04:18.36,Default,Subaru,0,0,0,,Nie zrozumiem, dopóki nie powiesz!
Dialogue: 0,0:04:19.03,0:04:20.65,Default,Subaru,0,0,0,,Jeśli nienawidzisz swojej matki,
Dialogue: 0,0:04:20.74,0:04:23.89,Default,Subaru,0,0,0,,to rusz stąd natychmiast i zemścij się na\Nniej czy coś!
Dialogue: 0,0:04:23.98,0:04:26.91,Default,Subaru,0,0,0,,Nie wyładowuj się na nas wszystkich!
Dialogue: 0,0:04:27.89,0:04:31.04,Default,Subaru,0,0,0,,Nienawidzisz swojej rodziny! Bo gdyby nie—
Dialogue: 0,0:04:31.13,0:04:32.01,Default,Garfiel,0,0,0,,Mylisz się!
Dialogue: 0,0:04:34.20,0:04:36.91,Default,Garfiel,0,0,0,,Ja... ja...
Dialogue: 0,0:04:37.00,0:04:39.19,Default,Subaru,0,0,0,,Powiedz mi prawdę!
Dialogue: 0,0:04:41.65,0:04:45.02,Default,Garfiel,0,0,0,,Chciałem...
Dialogue: 0,0:04:46.74,0:04:50.11,Default,Garfiel,0,0,0,,żeby moja mama... była szczęśliwa.
Dialogue: 0,0:04:52.21,0:04:53.99,Default,Garfiel,0,0,0,,Byliśmy ciężarem, prawda?
Dialogue: 0,0:04:54.08,0:04:58.55,Default,Garfiel,0,0,0,,Moja siostra i ja przeszkadzaliśmy\Njej w szczęściu, prawda?!
Dialogue: 0,0:05:00.13,0:05:01.34,Default,Garfiel,0,0,0,,To ma sens!
Dialogue: 0,0:05:01.43,0:05:03.70,Default,,0,0,0,,Nie mogła nawet na nas patrzeć!
Dialogue: 0,0:05:03.79,0:05:07.87,Default,Garfiel,0,0,0,,Jeśli ktoś dźwiga taki bagaż, co złego w\Ntym, że gdzieś go porzuci?!
Dialogue: 0,0:05:08.18,0:05:12.21,Default,Garfiel,0,0,0,,Mama odeszła, żeby znaleźć szczęście!
Dialogue: 0,0:05:12.80,0:05:15.22,Default,Garfiel,0,0,0,,Więc nie mam do niej żalu!
Dialogue: 0,0:05:15.94,0:05:18.18,Default,Garfiel,0,0,0,,Ale... widziałem to.
Dialogue: 0,0:05:19.76,0:05:21.16,Default,Garfiel,0,0,0,,Widziałem to na cmentarzu...
Dialogue: 0,0:05:22.12,0:05:25.74,Default,Garfiel,0,0,0,,Zaraz po tym, jak mama stąd odeszła,\Nzeszła lawina błotna.
Dialogue: 0,0:05:28.04,0:05:30.39,Default,Garfiel,0,0,0,,I umarła!
Dialogue: 0,0:05:31.48,0:05:37.85,Default,Garfiel,0,0,0,,Dlaczego? Czy nie odeszła, żeby znaleźć\Nszczęście?
Dialogue: 0,0:05:39.64,0:05:45.15,Default,Garfiel,0,0,0,,Czy nie zostawiła nas, żeby znaleźć\Nszczęście?!
Dialogue: 0,0:05:45.75,0:05:51.84,Default,Garfiel,0,0,0,,Jeśli porzuciła nas tylko po to, by\Numrzeć, zanim znalazła szczęście...
Dialogue: 0,0:05:53.20,0:05:55.95,Default,Garfiel,0,0,0,,Co mamy zrobić?
Dialogue: 0,0:05:56.70,0:06:00.35,Default,Garfiel,0,0,0,,Chciałem, żeby mama była szczęśliwa.
Dialogue: 0,0:06:00.44,0:06:03.30,Default,Garfiel,0,0,0,,Chciałem, żeby pokazała mi, że nasz smutek\Ni samotność
Dialogue: 0,0:06:03.39,0:06:08.57,Default,Garfiel,0,0,0,,miały sens, bo pomogły jej znaleźć\Nszczęście!
Dialogue: 0,0:06:09.73,0:06:14.43,Default,Garfiel,0,0,0,,Chciałem, żeby sprawiła, żebym ją\Nznienawidził!
Dialogue: 0,0:06:17.94,0:06:21.40,Default,Garfiel,0,0,0,,Nie pozwolę ci dotrzeć\Ndo świata zewnętrznego.
Dialogue: 0,0:06:22.45,0:06:25.82,Default,Garfiel,0,0,0,,Zmiany nie uszczęśliwią wszystkich.
Dialogue: 0,0:06:26.17,0:06:29.36,Default,Garfiel,0,0,0,,Dla wielu z nas nic nigdy się nie poprawi!
Dialogue: 0,0:06:31.17,0:06:33.25,Default,Garfiel,0,0,0,,Będę ich chronił.
Dialogue: 0,0:06:33.34,0:06:38.53,Default,Garfiel,0,0,0,,Będę chronił wszystko i wszystkich,\Nktórych zdołam dosięgnąć.
Dialogue: 0,0:06:38.62,0:06:41.80,Default,Garfiel,0,0,0,,Stanę się barierą!
Dialogue: 0,0:06:41.89,0:06:45.91,Default,Garfiel,0,0,0,,Prawdziwą barierą oddzielającą wnętrze od\Nświata zewnętrznego!
Dialogue: 0,0:06:46.00,0:06:47.00,Default,Subaru,0,0,0,,Garfiel!
Dialogue: 0,0:06:47.09,0:06:51.89,Default,Garfiel,0,0,0,,Sanktuarium, tutejszych ludzi,\Nstaruszkę... ochronię ich wszystkich!
Dialogue: 0,0:06:51.98,0:06:54.24,Default,Garfiel,0,0,0,,Nikt poza mną tego nie zrobi!
Dialogue: 0,0:06:54.33,0:06:56.36,Default,Garfiel,0,0,0,,Tylko ja będę o tym wiedział!
Dialogue: 0,0:06:56.45,0:06:59.44,Default,Garfiel,0,0,0,,I nikt inny {\i1}nie musi{\i0} wiedzieć!
Dialogue: 0,0:07:12.42,0:07:13.30,Default,Emilia,0,0,0,,Subaru!
Dialogue: 0,0:07:14.58,0:07:16.41,Default,Subaru,0,0,0,,W porządku, Emilio.
Dialogue: 0,0:07:19.82,0:07:22.16,Default,Subaru,0,0,0,,Jesteś cholernie uparty.
Dialogue: 0,0:07:22.25,0:07:25.77,Default,Subaru,0,0,0,,Chyba muszę zmusić cię do\Nkapitulacji, żebyś zrozumiał...
Dialogue: 0,0:07:25.86,0:07:29.51,Default,Subaru,0,0,0,,że jesteś tylko dużym, słodkim idiotą!
Dialogue: 0,0:07:31.72,0:07:34.60,Default,Subaru,0,0,0,,Wytrzymaj to, moje ciało!
Dialogue: 0,0:07:35.22,0:07:37.60,Default,Subaru,0,0,0,,Shamac!
Dialogue: 0,0:07:46.00,0:07:47.32,Default,Subaru,0,0,0,,Dziękuję.
Dialogue: 0,0:07:55.70,0:07:59.66,Default,Subaru,0,0,0,,Złaź na mój poziom, Garfiel!
Dialogue: 0,0:08:22.26,0:08:23.87,Default,Garfiel,0,0,0,,C-Co się właśnie...
Dialogue: 0,0:08:30.05,0:08:32.57,Default,Garfiel,0,0,0,,Czy to... mojej siostry?
Dialogue: 0,0:08:33.07,0:08:35.19,Default,Garfiel,0,0,0,,Cholera, dlaczego...
Dialogue: 0,0:08:36.05,0:08:37.54,Default,Subaru,0,0,0,,Dobre pytanie.
Dialogue: 0,0:08:37.63,0:08:41.64,Default,Subaru,0,0,0,,Może w środku jest głodny kot?
Dialogue: 0,0:08:41.73,0:08:43.96,Default,Puck,0,0,0,,Tyle mogę ci pomóc.
Dialogue: 0,0:08:44.21,0:08:46.72,Default,Subaru,0,0,0,,Najwyraźniej nawet wtedy,\Ngdy nie możesz mówić,
Dialogue: 0,0:08:46.81,0:08:49.56,Default,Subaru,0,0,0,,potrafisz mnie irytować nawet samym\Nświeceniem.
Dialogue: 0,0:08:50.80,0:08:52.51,Default,Subaru,0,0,0,,Spójrz na mnie, Garfiel.
Dialogue: 0,0:08:53.68,0:08:54.77,Default,Garfiel,0,0,0,,Co?
Dialogue: 0,0:08:55.13,0:08:57.88,Default,Subaru,0,0,0,,Jeśli chcesz mnie powstrzymać,\Nzrób to własnymi rękami.
Dialogue: 0,0:08:58.24,0:09:02.37,Default,Subaru,0,0,0,,Nie tchórz i nie zasłaniaj się swoim\Npochodzeniem, ty bezkręgowy tchórzu!
Dialogue: 0,0:09:02.96,0:09:05.63,Default,Subaru,0,0,0,,Kiedy przestaniesz mnie brać za głupca?
Dialogue: 0,0:09:06.41,0:09:08.70,Default,Subaru,0,0,0,,Idziemy na zewnątrz.
Dialogue: 0,0:09:08.79,0:09:10.52,Default,Subaru,0,0,0,,Emilia podejmie próbę w krypcie.
Dialogue: 0,0:09:10.61,0:09:12.19,Default,Subaru,0,0,0,,Sanktuarium zostanie wyzwolone.
Dialogue: 0,0:09:12.59,0:09:14.31,Default,Subaru,0,0,0,,Czy tego chcesz, czy nie.
Dialogue: 0,0:09:15.70,0:09:17.16,Default,Garfiel,0,0,0,,Kto cię o to prosił?!
Dialogue: 0,0:09:17.54,0:09:19.00,Default,,0,0,0,,Kto powiedział, że możesz?!
Dialogue: 0,0:09:19.09,0:09:21.89,Default,Garfiel,0,0,0,,To miejsce nie musi się zmieniać!
Dialogue: 0,0:09:21.98,0:09:24.87,Default,Subaru,0,0,0,,Wiesz, że nie pozostanie tak wiecznie!
Dialogue: 0,0:09:24.96,0:09:27.51,Default,Subaru,0,0,0,,Tak jak nas wszystkich zepchnięto pod\Nścianę,
Dialogue: 0,0:09:27.60,0:09:30.65,Default,Subaru,0,0,0,,nadejdzie chwila, gdy sam okażesz się\Nbezradny!
Dialogue: 0,0:09:30.74,0:09:33.79,Default,Subaru,0,0,0,,Może być jutro... albo teraz!
Dialogue: 0,0:09:34.37,0:09:36.33,Default,Subaru,0,0,0,,Po prostu padnij, Garfiel.
Dialogue: 0,0:09:36.42,0:09:38.37,Default,,0,0,0,,Przekonaj się, co znaczy siła w grupie!
Dialogue: 0,0:09:38.66,0:09:40.73,Default,Garfiel,0,0,0,,Musiał istnieć...
Dialogue: 0,0:09:41.24,0:09:43.77,Default,Garfiel,0,0,0,,lepszy sposób, żeby to powiedzieć!
Dialogue: 0,0:10:02.85,0:10:05.00,Default,Subaru,0,0,0,,Przyjrzyj się dobrze, Garfiel.
Dialogue: 0,0:10:05.54,0:10:08.96,Default,Subaru,0,0,0,,Ściana, której się tak boisz,\Nnie istnieje.
Dialogue: 0,0:10:09.84,0:10:13.24,Default,Garfiel,0,0,0,,Ona istnieje! To ja jestem tą ścianą!
Dialogue: 0,0:10:13.33,0:10:17.49,Default,Garfiel,0,0,0,,Ja zatrzymałem się tutaj, podobnie jak\Nstaruszka i wszyscy inni.
Dialogue: 0,0:10:17.58,0:10:19.11,Default,Garfiel,0,0,0,,I to koniec!
Dialogue: 0,0:10:19.20,0:10:20.47,Default,Garfiel,0,0,0,,To znaczy, że to koniec!
Dialogue: 0,0:10:20.56,0:10:22.89,Default,Subaru,0,0,0,,Nie spisuj siebie na straty!
Dialogue: 0,0:10:22.98,0:10:26.43,Default,Subaru,0,0,0,,Zawsze, kiedy myślisz: "Chcę\Nto zrobić! Chcę się zmienić!"
Dialogue: 0,0:10:26.52,0:10:29.14,Default,Subaru,0,0,0,,Od tego wszystko się zaczyna!
Dialogue: 0,0:10:29.38,0:10:32.18,Default,Subaru,0,0,0,,Kiedy postanawiasz podnieść głowę i znów\Nruszyć naprzód,
Dialogue: 0,0:10:32.27,0:10:35.11,Default,Subaru,0,0,0,,Kto ma prawo cię powstrzymać,\Nz jakiegokolwiek powodu?!
Dialogue: 0,0:10:36.57,0:10:39.28,Default,Subaru,0,0,0,,Czyż nie, Garfiel?!
Dialogue: 0,0:10:40.07,0:10:42.64,Default,Subaru,0,0,0,,Czyż nie, Emilio?!
Dialogue: 0,0:10:44.15,0:10:45.08,Default,Subaru,0,0,0,,I...
Dialogue: 0,0:10:47.14,0:10:49.18,Default,Subaru,0,0,0,,Czyż nie, Rem?!
Dialogue: 0,0:10:51.99,0:10:54.32,Default,Garfiel,0,0,0,,Do diabła z tobą!
Dialogue: 0,0:11:34.59,0:11:37.99,Default,Subaru,0,0,0,,Niezbyt udany debiut nowej techniki.
Dialogue: 0,0:11:41.92,0:11:44.30,Default,Subaru,0,0,0,,No nie, chyba żartujesz.
Dialogue: 0,0:11:45.20,0:11:48.44,Default,Subaru,0,0,0,,Jakim cudem jesteś taki wytrzymały?
Dialogue: 0,0:11:49.17,0:11:52.27,Default,Garfiel,0,0,0,,Nie... nie lekceważ mnie.
Dialogue: 0,0:11:52.58,0:11:56.83,Default,Garfiel,0,0,0,,Dopóki... się nie złamię... wciąż mogę...
Dialogue: 0,0:11:59.97,0:12:01.04,Default,Subaru,0,0,0,,Cholera.
Dialogue: 0,0:12:01.40,0:12:04.57,Default,Subaru,0,0,0,,Po tym wszystkim nie mam innego\Nwyboru, jak uznać twoją siłę.
Dialogue: 0,0:12:04.66,0:12:08.41,Default,Garfiel,0,0,0,,To koniec!
Dialogue: 0,0:12:08.50,0:12:10.79,Default,Garfiel,0,0,0,,Nikt inny już nigdy—
Dialogue: 0,0:12:30.64,0:12:32.87,Default,Subaru,0,0,0,,Co o tym myślisz, Garfiel?
Dialogue: 0,0:12:32.96,0:12:35.49,Default,Subaru,0,0,0,,To właśnie nazywa się „siłą w grupie”.
Dialogue: 0,0:12:36.19,0:12:40.53,Default,Garfiel,0,0,0,,Znowu... mogłeś...
Dialogue: 0,0:12:40.93,0:12:44.28,Default,Garfiel,0,0,0,,powiedzieć to... jakoś lepiej.
Dialogue: 0,0:12:44.64,0:12:47.86,Default,Subaru,0,0,0,,No dobrze. Wszystkie nasze uczucia\Npołączyły się,
Dialogue: 0,0:12:47.95,0:12:49.91,Default,Subaru,0,0,0,,a nasza więź zapewniła nam zwycięstwo.
Dialogue: 0,0:12:52.48,0:12:58.38,Default,Garfiel,0,0,0,,Chyba nikt nie podniesie kamienia kwain w\Npojedynkę...
Dialogue: 0,0:12:59.19,0:13:03.85,Default,Subaru,0,0,0,,W końcu powiedziałeś coś, co brzmi,\Njakby to pochodziło od ciebie...
Dialogue: 0,0:13:11.17,0:13:14.81,Default - italics,Subaru,0,0,0,,Ta paskudna czarownica\Npewnie za tym stała.
Dialogue: 0,0:13:15.20,0:13:18.77,Default - italics,Subaru,0,0,0,,Ten Czynnik Czarownicy Lenistwa, o którym\Nmówiła...
Dialogue: 0,0:13:19.38,0:13:20.32,Default,Garfiel,0,0,0,,Rawr!
Dialogue: 0,0:13:22.62,0:13:26.06,Default - italics,Subaru,0,0,0,,Niewidzialna Dłoń... Niezauważalne\NUderzenie...
Dialogue: 0,0:13:26.15,0:13:28.82,Default - italics,Subaru,0,0,0,,Nie... to niewidzialna wola Boga.
Dialogue: 0,0:13:30.42,0:13:33.41,Default,Subaru,0,0,0,,Niewidzialna Opatrzność. Tak ją nazwę.
Dialogue: 0,0:13:33.66,0:13:35.46,Default,Emilia,0,0,0,,Co powiedziałeś?
Dialogue: 0,0:13:35.55,0:13:37.36,Default,Subaru,0,0,0,,Yyy, nic.
Dialogue: 0,0:13:40.82,0:13:44.27,Default,Subaru,0,0,0,,Znowu użyczasz mi kolan jako poduszki.
Dialogue: 0,0:13:45.07,0:13:48.17,Default,Subaru,0,0,0,,Chyba to moja nagroda za wygranie\Nnajcięższej dotąd bitwy.
Dialogue: 0,0:13:49.70,0:13:50.76,Default,Emilia,0,0,0,,Tak, tak.
Dialogue: 0,0:13:58.00,0:13:59.94,Default,Otto,0,0,0,,Och, Natsuki, już nie śp—
Dialogue: 0,0:14:04.11,0:14:06.13,Default,Otto,0,0,0,,Po co to zrobiłeś?
Dialogue: 0,0:14:06.22,0:14:08.04,Default,Subaru,0,0,0,,Zamknij się, idioto! Ty draniu!
Dialogue: 0,0:14:08.13,0:14:10.55,Default,Subaru,0,0,0,,To się stało, bo działałeś na własną rękę!
Dialogue: 0,0:14:10.64,0:14:13.99,Default,Subaru,0,0,0,,Ale bez twojej pomocy chyba wpadłbym w\Ntarapaty,
Dialogue: 0,0:14:14.08,0:14:16.01,Default,Subaru,0,0,0,,więc przyznam, że jestem wdzięczny.
Dialogue: 0,0:14:16.10,0:14:17.94,Default,Otto,0,0,0,,Nie wiem, o czym mówisz!
Dialogue: 0,0:14:23.47,0:14:25.26,Default,Subaru,0,0,0,,Cieszę się, że nic ci nie jest.
Dialogue: 0,0:14:30.02,0:14:31.50,Default,Otto,0,0,0,,Wzajemnie, Natsuki.
Dialogue: 0,0:14:38.32,0:14:39.86,Default,Otto,0,0,0,,Potrzebujesz tłumaczenia?
Dialogue: 0,0:14:39.95,0:14:42.70,Default,Subaru,0,0,0,,Powiedziała: „Nie martw mnie tak więcej”,\Nprawda?
Dialogue: 0,0:14:42.79,0:14:46.98,Default,Otto,0,0,0,,I jeszcze: „Nie myśl sobie za wiele.\NNastępnego razu nie będzie”.
Dialogue: 0,0:14:47.07,0:14:49.52,Default,Otto,0,0,0,,To stąd pochodzi dodatkowy gniew.
Dialogue: 0,0:14:51.72,0:14:52.78,Default,Subaru,0,0,0,,Dzięki, dziewczyno.
Dialogue: 0,0:14:58.17,0:15:00.52,Default,Subaru,0,0,0,,Więc... gdzie jest Garfiel?
Dialogue: 0,0:15:01.17,0:15:02.10,Default,Emilia,0,0,0,,Tam.
Dialogue: 0,0:15:03.02,0:15:06.62,Default,Emilia,0,0,0,,Ale... nie powinniśmy\Njeszcze przeszkadzać.
Dialogue: 0,0:15:07.52,0:15:08.40,Default,Subaru,0,0,0,,Przeszkadzać?
Dialogue: 0,0:15:09.65,0:15:10.53,Default,Emilia,0,0,0,,Tak.
Dialogue: 0,0:15:16.19,0:15:17.93,Default,Ram,0,0,0,,Garf, już nie śpisz?
Dialogue: 0,0:15:18.58,0:15:21.27,Default,Garfiel,0,0,0,,Tak... nie śpię.
Dialogue: 0,0:15:21.36,0:15:22.93,Default,Ram,0,0,0,,Więc już ze mnie zejdź.
Dialogue: 0,0:15:25.22,0:15:27.19,Default,Ram,0,0,0,,Drętwieją mi nogi.
Dialogue: 0,0:15:30.23,0:15:34.39,Default,Garfiel,0,0,0,,Nadal nie masz w sobie ani odrobiny\Nserdeczności, co?
Dialogue: 0,0:15:34.48,0:15:37.88,Default,Ram,0,0,0,,Gdy pojawi się ktoś, dla kogo warto być\Nmiłą, potrafię być miła.
Dialogue: 0,0:15:37.97,0:15:38.85,Default,Garfiel,0,0,0,,Co...
Dialogue: 0,0:15:40.62,0:15:43.08,Default,Garfiel,0,0,0,,A ja nie jestem tego wart, co?
Dialogue: 0,0:15:43.40,0:15:44.35,Default,Ram,0,0,0,,Przepraszam.
Dialogue: 0,0:15:44.44,0:15:46.56,Default,Ram,0,0,0,,Jeśli chcesz poznać uczucia damy,
Dialogue: 0,0:15:46.65,0:15:48.10,Default,,0,0,0,,musisz postarać się bardziej.
Dialogue: 0,0:15:52.82,0:15:55.19,Default,Ram,0,0,0,,Garf, jesteś na to za głupi.
Dialogue: 0,0:15:55.28,0:15:56.76,Default,,0,0,0,,Nie ma sensu próbować myśleć.
Dialogue: 0,0:15:56.85,0:15:57.73,Default,Garfiel,0,0,0,,Hę?
Dialogue: 0,0:15:57.82,0:16:01.35,Default,Ram,0,0,0,,Od teraz walcz z pustą\Ngłową i nie myśl o niczym.
Dialogue: 0,0:16:02.16,0:16:04.23,Default,Ram,0,0,0,,Dla mnie i dla Emilii.
Dialogue: 0,0:16:05.29,0:16:06.17,Default,Garfiel,0,0,0,,Bu—
Dialogue: 0,0:16:06.44,0:16:07.86,Default,Garfiel,0,0,0,,Nie bądź głupia!
Dialogue: 0,0:16:07.95,0:16:09.71,Default,Garfiel,0,0,0,,Przyznaję, że przegrałem!
Dialogue: 0,0:16:09.80,0:16:13.67,Default,Garfiel,0,0,0,,Ale przyznanie się do porażki i poddanie\Nsię to dwie różne rzeczy!
Dialogue: 0,0:16:13.76,0:16:15.58,Default,Garfiel,0,0,0,,Mogę wrócić do przerwanego—
Dialogue: 0,0:16:15.67,0:16:16.67,Default,Ram,0,0,0,,Przestań jęczeć!
Dialogue: 0,0:16:19.74,0:16:21.99,Default,Ram,0,0,0,,Przegrałeś, Garf, ty beznadziejny\Nprzegrywie.
Dialogue: 0,0:16:22.34,0:16:26.84,Default,Ram,0,0,0,,Jak długo będziesz się tak popisywał przed\Nukochaną kobietą?
Dialogue: 0,0:16:27.14,0:16:32.52,Default,Garfiel,0,0,0,,C-Czyli mam po prostu z uśmiechem stanąć\Npo waszej stronie?
Dialogue: 0,0:16:32.61,0:16:36.76,Default,Garfiel,0,0,0,,Przyjmuję, że przegrałem, ale\Nnie przyjmuję, że się myliłem!
Dialogue: 0,0:16:36.85,0:16:41.10,Default,Garfiel,0,0,0,,Nie sądzę, żebym się mylił!
Dialogue: 0,0:16:41.19,0:16:43.43,Default,Garfiel,0,0,0,,Więc nie mogę tak po prostu na pół\Ngwizdka—
Dialogue: 0,0:16:43.52,0:16:45.56,Default,Ram,0,0,0,,Jeśli nie chcesz stanąć w pół drogi,
Dialogue: 0,0:16:45.65,0:16:48.33,Default,Ram,0,0,0,,Musisz tylko udowodnić,\Nże nie stoisz nieruchomo.
Dialogue: 0,0:16:48.42,0:16:49.30,Default,Garfiel,0,0,0,,Hę?
Dialogue: 0,0:16:53.22,0:16:54.43,Default,Garfiel,0,0,0,,Próba...
Dialogue: 0,0:16:55.15,0:16:56.88,Default,Ram,0,0,0,,Możesz się zmienić?
Dialogue: 0,0:16:56.97,0:17:00.87,Default,Ram,0,0,0,,czy zawsze będziesz małym, zalęknionym\Ndzieckiem tkwiącym w miejscu?
Dialogue: 0,0:17:01.29,0:17:03.47,Default,Ram,0,0,0,,Przekonaj się na własne oczy.
Dialogue: 0,0:17:04.54,0:17:07.84,Default,Garfiel,0,0,0,,Nie mów tego tak, żebym miał ochotę\Nzaprzeczyć!
Dialogue: 0,0:17:10.16,0:17:12.17,Default - flashback,Subaru,0,0,0,,Nie spisuj siebie na straty!
Dialogue: 0,0:17:17.99,0:17:20.74,Default,Ram,0,0,0,,Wyglądasz, jakbyś się zdecydował.
Dialogue: 0,0:17:21.91,0:17:23.84,Default,Ram,0,0,0,,Wszystko będzie dobrze, Garf.
Dialogue: 0,0:17:24.64,0:17:28.51,Default,Ram,0,0,0,,Jeśli coś cię przestraszy\Ndo łez, pocieszę cię.
Dialogue: 0,0:17:28.60,0:17:31.20,Default,Ram,0,0,0,,W ramach przysługi dla starego znajomego,\Nrozumiesz?
Dialogue: 0,0:17:50.18,0:17:51.76,Default,Garfiel,0,0,0,,Do cholery!
Dialogue: 0,0:17:58.96,0:18:02.86,Default - italics,Garfiel,0,0,0,,Najpierw musisz zmierzyć\Nsię z własną przeszłością.
Dialogue: 0,0:18:28.49,0:18:30.48,Default,Garfiel,0,0,0,,Mamo...
Dialogue: 0,0:18:32.95,0:18:34.80,Default,Ryuzu,0,0,0,,Nalegasz, by odejść?
Dialogue: 0,0:18:35.10,0:18:35.98,Default,Mom,0,0,0,,Tak.
Dialogue: 0,0:18:36.32,0:18:40.08,Default,Mom,0,0,0,,Chociaż wiem, że to będzie\Nciężarem dla ciebie...
Dialogue: 0,0:18:40.56,0:18:43.36,Default,Ryuzu,0,0,0,,Nie o to się martwię.
Dialogue: 0,0:18:43.90,0:18:45.27,Default,Ryuzu,0,0,0,,Większym problemem jest...
Dialogue: 0,0:18:45.62,0:18:48.14,Default,Ryuzu,0,0,0,,co czują te dwa maluchy.
Dialogue: 0,0:18:52.66,0:18:55.19,Default,Garfiel,0,0,0,,Ty gnojku!
Dialogue: 0,0:18:58.88,0:19:02.01,Default,Frederica,0,0,0,,Mamo, j-ja...
Dialogue: 0,0:19:04.16,0:19:05.77,Default,Mom,0,0,0,,Przepraszam, Fred, kochanie.
Dialogue: 0,0:19:06.13,0:19:09.54,Default,Mom,0,0,0,,Wiem, że to też cię martwi.
Dialogue: 0,0:19:11.60,0:19:15.04,Default,Frederica,0,0,0,,Nic mi nie jest... ale\Nprzykro mi z powodu Garfa.
Dialogue: 0,0:19:15.89,0:19:19.51,Default,Mom,0,0,0,,Chciałabym, żebyśmy poszli razem,\Nale jestem taka niezdarna.
Dialogue: 0,0:19:19.84,0:19:23.30,Default,Mom,0,0,0,,Wiem, że to byłoby dla niego\Nstraszne doświadczenie.
Dialogue: 0,0:19:23.97,0:19:27.69,Default,Mom,0,0,0,,Fred, jak na moje dziecko jesteś bardzo\Nodpowiedzialna,
Dialogue: 0,0:19:27.78,0:19:28.89,Default,Mom,0,0,0,,Zaopiekuj się nim.
Dialogue: 0,0:19:30.11,0:19:32.26,Default,Garfiel,0,0,0,,Nie rób tego!
Dialogue: 0,0:19:32.35,0:19:35.02,Default,Garfiel,0,0,0,,Mamo, nie wychodź!
Dialogue: 0,0:19:35.57,0:19:36.52,Default,Mom,0,0,0,,Masz.
Dialogue: 0,0:19:38.45,0:19:40.75,Default,Mom,0,0,0,,Dla ciebie i Gara.
Dialogue: 0,0:19:46.19,0:19:47.12,Default,Mom,0,0,0,,Gar, kochanie.
Dialogue: 0,0:19:48.10,0:19:50.71,Default,Mom,0,0,0,,Twoja mama musi już iść.
Dialogue: 0,0:19:52.72,0:19:53.83,Default,Garfiel,0,0,0,,Nie!
Dialogue: 0,0:19:57.21,0:20:01.31,Default,Mom,0,0,0,,Obiecuję, że sprowadzę twojego ojca.
Dialogue: 0,0:20:01.65,0:20:03.82,Default,Mom,0,0,0,,Poczekaj na mnie do tego czasu.
Dialogue: 0,0:20:06.87,0:20:08.85,Default,Garfiel,0,0,0,,Mój... ojciec?
Dialogue: 0,0:20:13.11,0:20:15.19,Default,Garfiel,0,0,0,,To kłamstwo... to nie tak.
Dialogue: 0,0:20:15.56,0:20:19.54,Default,Garfiel,0,0,0,,Wyszłaś stąd, by znaleźć szczęście.
Dialogue: 0,0:20:19.63,0:20:25.66,Default,Frederica,0,0,0,,Mama bardzo kochała nas oboje, Garf.
Dialogue: 0,0:20:26.26,0:20:29.82,Default,Frederica,0,0,0,,Opuściła Sanktuarium dla\Ndobra swojej rodziny.
Dialogue: 0,0:20:30.25,0:20:32.89,Default,Frederica,0,0,0,,Nie zadowala cię to?
Dialogue: 0,0:20:32.98,0:20:36.93,Default,Garfiel,0,0,0,,N-Nieprawda! Gdyby nas kochała,\Nto dlaczego—
Dialogue: 0,0:20:37.02,0:20:40.42,Default,Frederica,0,0,0,,Pewnie łatwiej było uwierzyć,\Nże nas nie kocha.
Dialogue: 0,0:20:41.42,0:20:44.32,Default,Frederica,0,0,0,,Jeśli wierzyłeś, że twoja miłość jest\Njednostronna,
Dialogue: 0,0:20:44.41,0:20:46.66,Default,Frederica,0,0,0,,mógłbyś usprawiedliwić zadany ci ból.
Dialogue: 0,0:20:46.75,0:20:48.87,Default,Garfiel,0,0,0,,Nie, mylisz się!
Dialogue: 0,0:20:48.96,0:20:50.34,Default,Garfiel,0,0,0,,Nic nie wiesz!
Dialogue: 0,0:20:50.43,0:20:52.20,Default,,0,0,0,,Kiedy mama stąd wyjdzie, ona—
Dialogue: 0,0:20:52.29,0:20:54.23,Default,Frederica,0,0,0,,Oczywiście, że wiem.
Dialogue: 0,0:20:54.32,0:20:55.20,Default,Garfiel,0,0,0,,Hę?
Dialogue: 0,0:20:55.32,0:20:56.87,Default,Frederica,0,0,0,,Nie mogłabym tego nie wiedzieć.
Dialogue: 0,0:20:57.33,0:21:02.10,Default,Frederica,0,0,0,,Jeśli po odejściu stąd mamę spotkało\Nnieszczęście,
Dialogue: 0,0:21:02.19,0:21:05.36,Default,Frederica,0,0,0,,myślisz, że babcia by nas o tym nie\Npowiadomiła?
Dialogue: 0,0:21:05.45,0:21:08.32,Default,Garfiel,0,0,0,,Więc... więc dlaczego?!
Dialogue: 0,0:21:08.85,0:21:12.35,Default,Frederica,0,0,0,,Musisz wiedzieć, dlaczego nie powiedziano\Nci tego, gdy byłeś tak mały.
Dialogue: 0,0:21:12.80,0:21:17.56,Default,Frederica,0,0,0,,Bo, Garf, nie jesteś\Njuż małym dzieckiem.
Dialogue: 0,0:21:20.83,0:21:25.29,Default,Frederica,0,0,0,,Tak naprawdę pamiętałeś, że mama cię\Nkochała, prawda?
Dialogue: 0,0:21:26.29,0:21:30.47,Default,Frederica,0,0,0,,Masz bliznę na czole, bo chciałeś\Nzapomnieć o jej pocałunku.
Dialogue: 0,0:21:30.88,0:21:33.96,Default,Frederica,0,0,0,,Chciałeś zatrzeć pocałunek,\Nwięc sam zrobiłeś sobie bliznę.
Dialogue: 0,0:21:38.13,0:21:40.98,Default,Frederica,0,0,0,,To koniec twojej przeszłości.
Dialogue: 0,0:21:44.76,0:21:45.64,Default,Garfiel,0,0,0,,Poczekaj.
Dialogue: 0,0:21:45.77,0:21:46.70,Default,,0,0,0,,Chwileczkę!
Dialogue: 0,0:21:47.37,0:21:49.57,Default,Garfiel,0,0,0,,Co mam zrobić?
Dialogue: 0,0:21:50.36,0:21:53.47,Default,Frederica,0,0,0,,Jeśli nawet teraz musisz polegać na\Nstarszej siostrze,
Dialogue: 0,0:21:53.56,0:21:55.25,Default,Frederica,0,0,0,,Nigdy nie znajdziesz odpowiedzi.
Dialogue: 0,0:21:55.61,0:21:57.51,Default,Garfiel,0,0,0,,Wiem, że to żałosne!
Dialogue: 0,0:21:57.60,0:22:00.20,Default,Garfiel,0,0,0,,Ale tylko na ciebie mogę liczyć!
Dialogue: 0,0:22:01.20,0:22:02.08,Default,Garfiel,0,0,0,,Proszę...
Dialogue: 0,0:22:02.25,0:22:04.96,Default,Frederica,0,0,0,,Co chcesz zrobić, Garf?
Dialogue: 0,0:22:08.69,0:22:12.14,Default,Frederica,0,0,0,,Co chcesz zrobić, Garf?
Dialogue: 0,0:22:14.79,0:22:17.47,Default,Garfiel,0,0,0,,Chcę zrobić to, czego się ode mnie\Noczekuje.
Dialogue: 0,0:22:18.24,0:22:21.04,Default,Frederica,0,0,0,,Kto czego od ciebie oczekuje?
Dialogue: 0,0:22:21.52,0:22:25.74,Default,Garfiel,0,0,0,,Wszyscy ludzie, którzy mnie potrzebują.
Dialogue: 0,0:22:26.16,0:22:28.16,Default,Garfiel,0,0,0,,Chcę zrobić to, czego ode mnie oczekują.
Dialogue: 0,0:22:28.53,0:22:31.99,Default,Frederica,0,0,0,,A co sprawia, że tak czujesz?
Dialogue: 0,0:22:36.71,0:22:40.31,Default,Garfiel,0,0,0,,Przypomnieli mi...
Dialogue: 0,0:22:42.52,0:22:43.63,Default,Garfiel,0,0,0,,że mama...
Dialogue: 0,0:22:46.74,0:22:49.19,Default,Garfiel,0,0,0,,naprawdę mnie kochała.
Dialogue: 0,0:23:00.64,0:23:05.61,Default,Emilia,0,0,0,,Więc... czy Shima jest starszą siostrą\NRyuzu, czy jej młodszą siostrą?
Dialogue: 0,0:23:06.16,0:23:10.43,Default,Subaru,0,0,0,,Właściwie... to trochę mylące,\Nwięc zachowamy to na później.
Dialogue: 0,0:23:14.10,0:23:15.22,Default,Delma,0,0,0,,Młody Gar!
Dialogue: 0,0:23:17.32,0:23:18.75,Default,Delma,0,0,0,,M-Młody Gar...
Dialogue: 0,0:23:18.84,0:23:21.29,Default,Delma,0,0,0,,Widzisz, ja... my...
Dialogue: 0,0:23:21.77,0:23:24.67,Default,Garfiel,0,0,0,,Nie róbcie takich min, staruszki. To do\Nwas nie pasuje.
Dialogue: 0,0:23:27.73,0:23:30.11,Default,Garfiel,0,0,0,,Przepraszam, że was martwiłem.
Dialogue: 0,0:23:34.85,0:23:36.87,Default,Ram,0,0,0,,Garf, jak poszło?
Dialogue: 0,0:23:38.93,0:23:42.31,Default,Garfiel,0,0,0,,Cóż, nie mogę powiedzieć, żebym osiągnął\Njakieś widoczne rezultaty.
Dialogue: 0,0:23:42.69,0:23:46.77,Default,Garfiel,0,0,0,,Ale... czuję, że udało mi się z tym\Npogodzić.
Dialogue: 0,0:23:50.16,0:23:52.65,Default,Subaru,0,0,0,,Dobra, więc zróbmy resztę próby, póki—
Dialogue: 0,0:23:52.74,0:23:55.18,Default,Garfiel,0,0,0,,To nie moja robota.
Dialogue: 0,0:23:55.27,0:23:57.96,Default,Emilia,0,0,0,,To moja praca.
Dialogue: 0,0:23:58.05,0:23:59.93,Default,Emilia,0,0,0,,Nie odbieraj mi jej.
Dialogue: 0,0:24:00.02,0:24:01.28,Default,Garfiel,0,0,0,,No, ten...
Dialogue: 0,0:24:01.96,0:24:04.11,Default,Garfiel,0,0,0,,Chciałbym też powiedzieć...
Dialogue: 0,0:24:04.20,0:24:07.21,Default,Garfiel,0,0,0,,Myślę, że w końcu podjąłem próbę
Dialogue: 0,0:24:07.30,0:24:09.49,Default,Garfiel,0,0,0,,właśnie dzięki tobie.
Dialogue: 0,0:24:10.33,0:24:11.38,Default,Garfiel,0,0,0,,Dziękuję.
Dialogue: 0,0:24:13.70,0:24:15.55,Default,Subaru,0,0,0,,Powiedziałeś "dziękuję"?
Dialogue: 0,0:24:15.64,0:24:17.31,Default,Garfiel,0,0,0,,Nie będę powtarzał!
Dialogue: 0,0:24:17.40,0:24:18.28,Default,Garfiel,0,0,0,,Posłuchajcie!
Dialogue: 0,0:24:18.40,0:24:20.23,Default,,0,0,0,,Zdaję sobie sprawę, że przegrałem!
Dialogue: 0,0:24:20.32,0:24:25.65,Default,Garfiel,0,0,0,,Jeśli wyzwolicie to miejsce i\Nstaruszki ucierpią, nie będę łagodny!
Dialogue: 0,0:24:25.74,0:24:27.68,Default,Subaru,0,0,0,,Tak, oczywiście...
Dialogue: 0,0:24:27.77,0:24:32.28,Default,Garfiel,0,0,0,,Co oznacza, że będę tu, żeby upewnić\Nsię, że nie będziecie tylko gadać!
Dialogue: 0,0:24:32.79,0:24:35.87,Default,Garfiel,0,0,0,,Więc dopilnuj, żebyście zrobili to\Nporządnie, szefie!
Dialogue: 0,0:24:35.96,0:24:36.84,Default,Subaru,0,0,0,,Au!
Dialogue: 0,0:24:38.00,0:24:39.96,Default,Emilia,0,0,0,,Jego twarz była taka czerwona!
Dialogue: 0,0:24:40.05,0:24:41.77,Default,Subaru,0,0,0,,Szefie?
Dialogue: 0,0:24:41.86,0:24:44.79,Default,Subaru,0,0,0,,Ale z nas dwóch to ty jesteś silniejszy.
Dialogue: 0,0:24:45.04,0:24:47.79,Default,Ram,0,0,0,,Pewnie czujesz się, jakbyś zyskał\Nmłodszego brata.
Dialogue: 0,0:24:48.19,0:24:50.55,Default,Ram,0,0,0,,Jesteś starszy od niego,\Nwięc bądź łagodny.
Dialogue: 0,0:24:50.83,0:24:52.73,Default,Subaru,0,0,0,,W takim razie...
Dialogue: 0,0:24:52.82,0:24:54.16,Default,Subaru,0,0,0,,Chwileczkę!
Dialogue: 0,0:24:54.25,0:24:57.51,Default,,0,0,0,,Czy właśnie powiedziałaś,\Nże jest młodszy ode mnie?!
Dialogue: 0,0:24:58.75,0:25:01.22,Default,Ram,0,0,0,,Garf dopiero kończy 14 lat.
Dialogue: 0,0:25:03.65,0:25:06.65,Default,Subaru,0,0,0,,Jest w ósmej klasie!
Dialogue: 0,0:25:13.60,0:25:14.66,Default,Subaru,0,0,0,,Idziesz?
Dialogue: 0,0:25:15.66,0:25:20.26,Default,Emilia,0,0,0,,Tak. Jeśli zostanę tu zbyt długo, moja\Ndeterminacja osłabnie.
Dialogue: 0,0:25:22.61,0:25:23.62,Default,Emilia,0,0,0,,Hej, Subaru...
Dialogue: 0,0:25:25.43,0:25:28.24,Default,Emilia,0,0,0,,Co do tego, co stało się na cmentarzu...
Dialogue: 0,0:25:31.73,0:25:32.74,Default,Subaru,0,0,0,,Emilia?
Dialogue: 0,0:25:33.36,0:25:35.76,Default,Emilia,0,0,0,,Wiesz, kiedy...
Dialogue: 0,0:25:39.09,0:25:41.49,Default,Emilia,0,0,0,,To wiele dla mnie znaczy.
Dialogue: 0,0:25:41.58,0:25:44.57,Default,Emilia,0,0,0,,Więc kiedy próba i wszystko inne się\Nskończą,
Dialogue: 0,0:25:44.66,0:25:46.34,Default,Emilia,0,0,0,,Porozmawiajmy o tym... dobrze?
Dialogue: 0,0:25:45.12,0:25:47.23,Default,Subaru,0,0,0,,{\an8}Mhm! Mhm!
Dialogue: 0,0:25:51.93,0:25:54.81,Default,Subaru,0,0,0,,Mówiąc o tym, co zrobisz\Npo tym wszystkim...
Dialogue: 0,0:25:54.90,0:25:57.41,Default,Subaru,0,0,0,,Musisz być pewna siebie, Emilia.
Dialogue: 0,0:25:57.73,0:25:59.08,Default,Emilia,0,0,0,,Nie jestem pewna.
Dialogue: 0,0:25:59.30,0:26:02.24,Default,Emilia,0,0,0,,Może tylko próbuję udawać silną.
Dialogue: 0,0:26:03.38,0:26:05.04,Default,Subaru,0,0,0,,Wiem, że się uda.
Dialogue: 0,0:26:05.76,0:26:09.31,Default,Subaru,0,0,0,,Założę się z tobą o randkę!
Dialogue: 0,0:26:11.12,0:26:12.27,Default,Emilia,0,0,0,,Tak, oczywiście.
Dialogue: 0,0:26:16.26,0:26:18.47,Default,Emilia,0,0,0,,Już idę.
Dialogue: 0,0:26:18.56,0:26:19.81,Default,Subaru,0,0,0,,Daj z siebie wszystko!
Dialogue: 0,0:26:19.90,0:26:22.39,Default,Subaru,0,0,0,,Uważaj na samochody i chłopców!
Dialogue: 0,0:26:23.15,0:26:24.64,Default,Emilia,0,0,0,,Nie wygłupiaj się.
Dialogue: 0,0:26:32.37,0:26:34.67,Default,Garfiel,0,0,0,,Giltylaw, któremu zabrakło jednego kroku?
Dialogue: 0,0:26:35.12,0:26:39.02,Default,Garfiel,0,0,0,,Niewiele z ciebie za faceta, jeśli ciągle\Nrobisz taką zatroskaną minę, szefie.
Dialogue: 0,0:26:39.11,0:26:43.21,Default,Subaru,0,0,0,,Teraz, kiedy wiem, że jesteś w ósmej\Nklasie, to twój sposób mówienia ma sens.
Dialogue: 0,0:26:43.30,0:26:46.28,Default,Subaru,0,0,0,,W tym wieku też wygłaszałem\Ncytaty sławnych ludzi.
Dialogue: 0,0:26:46.37,0:26:51.87,Default,Garfiel,0,0,0,,Słuchaj... muszę cię\Nza coś przeprosić.
Dialogue: 0,0:26:51.96,0:26:54.25,Default,Subaru,0,0,0,,To godne podziwu.
Dialogue: 0,0:26:54.34,0:26:57.07,Default,Subaru,0,0,0,,Możesz rozmawiać ze swoim\Nszefem o wszystkim.
Dialogue: 0,0:26:57.76,0:26:59.84,Default,Subaru,0,0,0,,Stary, wstyd mi to mówić.
Dialogue: 0,0:27:00.57,0:27:02.90,Default,Garfiel,0,0,0,,Widziałem cię.
Dialogue: 0,0:27:03.34,0:27:04.22,Default,Subaru,0,0,0,,Hę?
Dialogue: 0,0:27:04.72,0:27:06.87,Default,Garfiel,0,0,0,,Kiedy... wiesz...
Dialogue: 0,0:27:07.84,0:27:09.72,Default,Garfiel,0,0,0,,zrobiłeś się trochę... zdesperowany?
Dialogue: 0,0:27:13.54,0:27:16.48,Default,Subaru,0,0,0,,O, cholera, zapomniałem!
Dialogue: 0,0:27:16.57,0:27:20.04,Default,Subaru,0,0,0,,Ale nie spodziewałem\Nsię, że wejdziesz!
Dialogue: 0,0:27:20.40,0:27:22.48,Default,Garfiel,0,0,0,,Zobaczenie tego sprawiło,\Nże zrozumiałem.
Dialogue: 0,0:27:22.57,0:27:25.75,Default,Garfiel,0,0,0,,Może jesteś kompletnym głupcem,
Dialogue: 0,0:27:25.84,0:27:29.30,Default,Garfiel,0,0,0,,ale cieszę się, że przegrałem właśnie z\Ntobą!
Dialogue: 0,0:27:29.39,0:27:31.30,Default,Subaru,0,0,0,,Zamknij się! Po prostu o tym zapomnij!
Dialogue: 0,0:27:31.39,0:27:33.59,Default,Subaru,0,0,0,,Nie jesteś dzieckiem. Nic nie widziałeś.
Dialogue: 0,0:27:33.68,0:27:35.71,Default,Subaru,0,0,0,,Czekaj, {\i1}jesteś{\i0} dzieckiem!
Dialogue: 0,0:27:41.45,0:27:43.38,Default,Subaru,0,0,0,,Subaru, głupcze.
Dialogue: 0,0:27:49.85,0:27:52.31,Default - italics,Subaru,0,0,0,,"Daj z siebie wszystko,\Nwiem, że dasz radę".
Dialogue: 0,0:27:52.83,0:27:54.52,Default - italics,Subaru,0,0,0,,„Puck i ja obaj ci kibicujemy”.
Dialogue: 0,0:27:54.88,0:27:57.02,Default - italics,Subaru,0,0,0,,"Kiedy to się skończy, chodźmy na randkę!"
Dialogue: 0,0:28:01.73,0:28:03.96,Default,Emilia,0,0,0,,Naprawdę jesteś głupcem.
Dialogue: 0,0:28:05.78,0:28:07.34,Default,Emilia,0,0,0,,Głupcze... głupcze...
Dialogue: 0,0:28:07.65,0:28:09.29,Default,Emilia,0,0,0,,Subaru, ty głupku.
Dialogue: 0,0:28:09.38,0:28:12.29,Default,Emilia,0,0,0,,Jak mogłeś złamać obietnicę,\Nże zostaniesz ze mną?
Dialogue: 0,0:28:13.14,0:28:17.26,Default,Emilia,0,0,0,,Przysięgam, że nigdy ci nie\Nwybaczę, dopóki nie przeprosisz.
Dialogue: 0,0:28:25.28,0:28:29.42,Default,Echidna,0,0,0,,Ostatnio miałam sporo gości.
Dialogue: 0,0:28:31.21,0:28:36.78,Default,Echidna,0,0,0,,Bardzo odważnie wchodzisz tu po tamtym\Nżałosnym przedstawieniu.
Dialogue: 0,0:28:36.87,0:28:38.94,Default,Echidna,0,0,0,,Nawet ja jestem zaskoczona.
Dialogue: 0,0:28:39.49,0:28:41.59,Default,Echidna,0,0,0,,Ty rozwiązła kobieto, która kleisz się do
Dialogue: 0,0:28:41.68,0:28:45.91,Default,Echidna,0,0,0,,pierwszego mężczyzny, który pocieszy cię,\Ngdy szlochasz w rozpaczy...
Dialogue: 0,0:28:46.42,0:28:50.42,Default,Echidna,0,0,0,,Bezwstydna idiotko, wciąż plugawiąca\Nświat należący tylko do mnie...
Dialogue: 0,0:28:50.51,0:28:55.34,Default,Echidna,0,0,0,,Ty samolubna hedonistko, która kochasz\Nsiebie, bo on ci wybaczył...
Dialogue: 0,0:28:56.58,0:28:58.29,Default,Echidna,0,0,0,,No, powiedz coś...
Dialogue: 0,0:28:59.08,0:29:00.63,Default,Echidna,0,0,0,,córko czarownicy.
Dialogue: 0,0:29:06.61,0:29:09.01,Default,Emilia,0,0,0,,Nazywam się Emilia!
Dialogue: 0,0:29:09.38,0:29:12.98,Default,Emilia,0,0,0,,Jestem Zamarzniętą Czarownicą, urodzoną w\NLesie Elior!
Dialogue: 0,0:29:18.30,0:29:21.28,Default,Emilia,0,0,0,,Nie poddam się złośliwości\Ninnej czarownicy.
Dialogue: 0,0:29:21.97,0:29:24.82,Default,Emilia,0,0,0,,W końcu jestem dość nieznośną kobietą!
Dialogue: 0,0:29:25.45,0:29:29.95,Episode Title,Title,0,0,0,,{\pos(320,60)\t(1,5000,\fs33)}Nikt nie podniesie kamienia kwain {\c&H37D6F8&}w\Npojedynkę
Dialogue: 0,0:29:34.82,0:29:41.82,Default,,0,0,0,,
