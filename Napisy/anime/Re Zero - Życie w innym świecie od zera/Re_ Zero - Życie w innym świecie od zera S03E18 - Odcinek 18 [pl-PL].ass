Dialogue: 0,0:00:01.94,0:00:04.44,Default,Subaru,0,0,0,,Shima, wszystko w porządku?
Dialogue: 0,0:00:06.62,0:00:08.96,Default,Ryuzu,0,0,0,,Chyba ci mówiłam, Młody Su,
Dialogue: 0,0:00:09.46,0:00:14.07,Default,Ryuzu,0,0,0,,że nasze ciała stale się wyczerpują,\Npodobnie jak ciała duchów.
Dialogue: 0,0:00:14.49,0:00:17.67,Default,Subaru,0,0,0,,Wiem, że są trzy kopie Ryuzu, które pełnią\Nsłużbę na zmianę,
Dialogue: 0,0:00:17.76,0:00:21.64,Default,Subaru,0,0,0,,ale odkąd wyłączono cię z rotacji, nie ma\Nnikogo na zastępstwo.
Dialogue: 0,0:00:23.02,0:00:27.79,Default,Shima,0,0,0,,Nie wiem, czy wytrzymam,\Ndopóki Emilia nie wróci.
Dialogue: 0,0:00:28.39,0:00:31.31,Default,Shima,0,0,0,,Więc powiem to, co trzeba powiedzieć.
Dialogue: 0,0:00:31.40,0:00:33.80,Default,Garfiel,0,0,0,,Nie musisz się tak forsować!
Dialogue: 0,0:00:33.89,0:00:35.66,Default,Garfiel,0,0,0,,Ta zdrowa staruszka tutaj może cię—
Dialogue: 0,0:00:35.75,0:00:39.52,Default,Subaru,0,0,0,,To zbyt mylące! Nazywajmy je Starą Shi i\NStarą Ryu!
Dialogue: 0,0:00:39.61,0:00:41.53,Default,Subaru,0,0,0,,Poza tym, to nie zadziała.
Dialogue: 0,0:00:41.62,0:00:45.27,Default,Subaru,0,0,0,,Tylko Shima może nam to powiedzieć.
Dialogue: 0,0:00:46.56,0:00:53.20,Default,Shima,0,0,0,,Tak. Tylko ja, która weszłam na cmentarz i\Npodjęłam próbę, mogę o tym mówić.
Dialogue: 0,0:00:55.17,0:00:58.41,Default,Shima,0,0,0,,Chodzi o wspomnienia Ryuzu Meyer,
Dialogue: 0,0:00:58.78,0:01:03.18,Default,Shima,0,0,0,,naszego pierwowzoru, od którego pochodzimy\Nmy, kopie.
Dialogue: 0,0:01:06.43,0:01:13.43,Default,Shima,0,0,0,,To było zanim to miejsce stało\Nsię znane jako Sanktuarium.
Dialogue: 0,0:01:23.91,0:01:26.60,Default,Shima,0,0,0,,Ta nieznana historia zaczęła się
Dialogue: 0,0:01:26.69,0:01:29.68,Default,Shima,0,0,0,,od młodej dziewczyny o ślicznej twarzy,
Dialogue: 0,0:01:30.44,0:01:35.89,Default,Shima,0,0,0,,skórze białej jak śnieg i bladoniebieskich\Noczach.
Dialogue: 0,0:01:38.87,0:01:40.32,Default - flashback,Beatrice,0,0,0,,Co to jest?
Dialogue: 0,0:01:41.06,0:01:42.71,Default - flashback,Beatrice,0,0,0,,Patrz na mnie tak jak chcesz.
Dialogue: 0,0:01:42.80,0:01:44.45,Default - flashback,,0,0,0,,Ale nic ci nie dam.
Dialogue: 0,0:01:50.84,0:01:52.96,Default - flashback,Beatrice,0,0,0,,Znowu cisza.
Dialogue: 0,0:01:53.38,0:01:56.18,Default - flashback,Beatrice,0,0,0,,Ale z ciebie nudna, tchórzliwa dziewczyna,\Njak sądzę.
Dialogue: 0,0:01:57.97,0:02:01.10,Default - flashback,Echidna,0,0,0,,Beatrice, dlaczego się tak zachowujesz?
Dialogue: 0,0:02:01.78,0:02:03.38,Default - flashback,Ryuzu,0,0,0,,Echidna...
Dialogue: 0,0:02:04.53,0:02:07.96,Default - flashback,Echidna,0,0,0,,Czy ja cię tak uczyłam?
Dialogue: 0,0:02:08.05,0:02:10.69,Default - flashback,Beatrice,0,0,0,,Mylisz się, mamo!
Dialogue: 0,0:02:10.78,0:02:12.41,Default - flashback,Beatrice,0,0,0,,Nic nie zrobiłam!
Dialogue: 0,0:02:12.98,0:02:13.86,Default - flashback,Beatrice,0,0,0,,Po prostu...
Dialogue: 0,0:02:13.95,0:02:15.50,Default - flashback,Beatrice,0,0,0,,Ta dziewczyna była...
Dialogue: 0,0:02:16.52,0:02:17.60,Default - flashback,Echidna,0,0,0,,Rozumiem.
Dialogue: 0,0:02:18.21,0:02:21.20,Default - flashback,Echidna,0,0,0,,Więc dlaczego nie posłuchamy jej?
Dialogue: 0,0:02:21.69,0:02:24.74,Default - flashback,Ryuzu,0,0,0,,Co... no cóż...
Dialogue: 0,0:02:25.74,0:02:28.91,Default - flashback,Ryuzu,0,0,0,,Tak. Bardzo przepraszam.
Dialogue: 0,0:02:29.00,0:02:31.64,Default - flashback,Ryuzu,0,0,0,,Zobaczyłam, jak stoi tam z tęsknym\Nspojrzeniem,
Dialogue: 0,0:02:31.73,0:02:33.88,Default - flashback,Ryuzu,0,0,0,,i zauroczyła mnie.
Dialogue: 0,0:02:34.96,0:02:37.18,Default - flashback,Echidna,0,0,0,,Zauroczyła?
Dialogue: 0,0:02:38.52,0:02:41.34,Default - flashback,Echidna,0,0,0,,Beatrice, słyszałaś Ryuzu.
Dialogue: 0,0:02:43.22,0:02:44.16,Default - flashback,Beatrice,0,0,0,,Miau...
Dialogue: 0,0:02:45.84,0:02:50.48,Default - flashback,Echidna,0,0,0,,To byłoby niedokładne, by nazwać cię\Ndziecinną, ponieważ {\i1}jesteś{\i0} dzieckiem,
Dialogue: 0,0:02:50.57,0:02:52.90,Default - flashback,Echidna,0,0,0,,ale zupełnie brakuje ci wyrozumiałości.
Dialogue: 0,0:02:53.32,0:02:55.63,Default - flashback,Echidna,0,0,0,,To prawda, że jesteś wyjątkowa.
Dialogue: 0,0:02:55.72,0:02:58.40,Default - flashback,Echidna,0,0,0,,Ale nie tak, żeby patrzyć\Nna innych z góry.
Dialogue: 0,0:02:59.94,0:03:01.69,Default - flashback,Echidna,0,0,0,,Przepraszam, że cię przestraszyłam.
Dialogue: 0,0:03:01.78,0:03:03.43,Default - flashback,,0,0,0,,To jest Beatrice.
Dialogue: 0,0:03:03.52,0:03:05.75,Default - flashback,Echidna,0,0,0,,Jest dla mnie jak córka.
Dialogue: 0,0:03:05.84,0:03:07.19,Default - flashback,Beatrice,0,0,0,,Nie jestem jak twoja córka!
Dialogue: 0,0:03:07.28,0:03:08.95,Default - flashback,,0,0,0,,{\i1}Jestem{\i0} twoją córką, jak sądzę!
Dialogue: 0,0:03:10.66,0:03:12.84,Default - flashback,Echidna,0,0,0,,Tak, cóż, sama widzisz.
Dialogue: 0,0:03:13.75,0:03:18.33,Default - flashback,Echidna,0,0,0,,Sądzę, że od teraz będzie mi tu często\Ntowarzyszyć.
Dialogue: 0,0:03:18.42,0:03:20.21,Default - flashback,Echidna,0,0,0,,Proszę, bądź dla niej miła.
Dialogue: 0,0:03:20.30,0:03:24.38,Default - flashback,Ryuzu,0,0,0,,Tak, możesz na mnie liczyć, Echidna.
Dialogue: 0,0:03:24.47,0:03:25.47,Default - flashback,Beatrice,0,0,0,,Nie potrzebuję jej.
Dialogue: 0,0:03:25.79,0:03:29.14,Default - flashback,,0,0,0,,Sama świetnie sobie poradzę.
Dialogue: 0,0:03:29.91,0:03:33.76,Default,Shima,0,0,0,,Tak poznały się dwie dziewczyny.
Dialogue: 0,0:03:34.93,0:03:41.05,Default,Shima,0,0,0,,Potem czarownica i jej córka od czasu do\Nczasu odwiedzały osadę.
Dialogue: 0,0:03:44.05,0:03:46.83,Default - flashback,Beatrice,0,0,0,,Dlaczego tu stoisz?
Dialogue: 0,0:03:47.44,0:03:50.09,Default - flashback,Beatrice,0,0,0,,Widzę, że jak zawsze jesteś nudna.
Dialogue: 0,0:03:50.18,0:03:51.67,Default - flashback,Ryuzu,0,0,0,,Pani Beatrice...
Dialogue: 0,0:03:51.76,0:03:54.28,Default - flashback,Beatrice,0,0,0,,Matka prowadzi dyskusję w środku.
Dialogue: 0,0:03:54.37,0:03:55.91,Default - flashback,Beatrice,0,0,0,,Wróci, jak skończy.
Dialogue: 0,0:03:56.00,0:03:59.51,Default - flashback,Beatrice,0,0,0,,Więc pospiesz się i wrzuć to irytujące\Npranie do kosza, jak sądzę.
Dialogue: 0,0:03:59.60,0:04:00.82,Default - flashback,Ryuzu,0,0,0,,Oczywiście.
Dialogue: 0,0:04:03.04,0:04:04.39,Default - flashback,Ryuzu,0,0,0,,Przepraszam.
Dialogue: 0,0:04:18.08,0:04:20.19,Default - flashback,Ryuzu,0,0,0,,Pani Beatrice?
Dialogue: 0,0:04:20.28,0:04:23.49,Default - flashback,Beatrice,0,0,0,,Nic, chyba tylko zabijam czas.
Dialogue: 0,0:04:33.70,0:04:35.02,Default - flashback,Ryuzu,0,0,0,,Pani Beatrice...
Dialogue: 0,0:04:35.90,0:04:38.55,Default - flashback,Ryuzu,0,0,0,,Jeśli nie masz nic przeciwko,
Dialogue: 0,0:04:39.09,0:04:42.91,Default - flashback,Ryuzu,0,0,0,,Pomożesz mi złożyć pranie?
Dialogue: 0,0:04:44.01,0:04:44.89,Default - flashback,Beatrice,0,0,0,,Co?!
Dialogue: 0,0:04:49.10,0:04:51.35,Default - flashback,Beatrice,0,0,0,,Jeśli to zbyt wiele, by się tym zająć,
Dialogue: 0,0:04:51.44,0:04:54.06,Default - flashback,Beatrice,0,0,0,,chyba nie mam wyboru i muszę ci pomóc.
Dialogue: 0,0:04:55.70,0:04:56.58,Default - flashback,Ryuzu,0,0,0,,Hę?
Dialogue: 0,0:04:56.67,0:04:58.22,Default - flashback,Beatrice,0,0,0,,Nie powtórzę tego, jak sądzę!
Dialogue: 0,0:04:58.31,0:05:00.86,Default - flashback,Beatrice,0,0,0,,No, ruszaj się! Idziemy, jak sądzę!
Dialogue: 0,0:05:07.41,0:05:12.51,Default - flashback,Ryuzu,0,0,0,,Jeśli nie masz nic przeciwko, poniosłabyś\Ntrochę?
Dialogue: 0,0:05:12.60,0:05:13.75,Default - flashback,Beatrice,0,0,0,,Posłuchaj...
Dialogue: 0,0:05:13.84,0:05:16.25,Default - flashback,Beatrice,0,0,0,,Nie pozwalaj sobie za dużo.
Dialogue: 0,0:05:18.02,0:05:19.50,Default - flashback,Beatrice,0,0,0,,Tylko tyle, jak sądzę.
Dialogue: 0,0:05:20.48,0:05:24.75,Default,Shima,0,0,0,,Więc kiedy czarownica miała\Ncoś do załatwienia,
Dialogue: 0,0:05:24.84,0:05:29.97,Default,Shima,0,0,0,,dziewczynka spędzała czas z Ryuzu Meyer.
Dialogue: 0,0:05:33.22,0:05:35.06,Default - flashback,Roswaal,0,0,0,,Hej, ty. Wybacz.
Dialogue: 0,0:05:35.38,0:05:38.15,Default - flashback,Roswaal,0,0,0,,Myślę, że Echidna jest tutaj.
Dialogue: 0,0:05:38.24,0:05:39.37,Default - flashback,Roswaal,0,0,0,,Widziałaś ją?
Dialogue: 0,0:05:39.74,0:05:40.67,Default - flashback,Ryuzu,0,0,0,,Co?
Dialogue: 0,0:05:42.22,0:05:44.23,Default - flashback,Ryuzu,0,0,0,,M-Mathers!
Dialogue: 0,0:05:44.95,0:05:48.32,Default - flashback,Roswaal,0,0,0,,Nie lubię, gdy do mnie\Nzwracają się nazwiskiem.
Dialogue: 0,0:05:49.25,0:05:52.32,Default - flashback,Roswaal,0,0,0,,Mogłabyś mówić mi po prostu Roswaal?
Dialogue: 0,0:05:52.41,0:05:53.74,Default,Subaru,0,0,0,,Chwileczkę!
Dialogue: 0,0:05:53.83,0:05:57.40,Default,Subaru,0,0,0,,Beatrice była w Sanktuarium? Roswaal też?
Dialogue: 0,0:05:57.49,0:06:00.79,Default,Ram,0,0,0,,Ściślej mówiąc, był to Roswaal sprzed\Nkilku pokoleń.
Dialogue: 0,0:06:01.20,0:06:04.25,Default,Ram,0,0,0,,Ale to brzmi, jakby\NBeatrice się nie zmieniła.
Dialogue: 0,0:06:04.66,0:06:07.64,Default,Garfiel,0,0,0,,Bardziej interesuje mnie czarownica.
Dialogue: 0,0:06:07.73,0:06:11.44,Default,Garfiel,0,0,0,,Wiem, że to ośrodek doświadczalny\NCzarownicy Chciwości,
Dialogue: 0,0:06:11.53,0:06:14.75,Default,Garfiel,0,0,0,,Ale nigdy nie słyszałem jej historii.
Dialogue: 0,0:06:14.84,0:06:18.73,Default,Subaru,0,0,0,,Naprawdę? Nie spotkałeś czarownicy podczas\Nprób?
Dialogue: 0,0:06:18.82,0:06:21.56,Default,Garfiel,0,0,0,,Poszedłem tylko wyrównać rachunki.
Dialogue: 0,0:06:21.65,0:06:23.32,Default,Garfiel,0,0,0,,Nie spotkałem czarownicy.
Dialogue: 0,0:06:23.41,0:06:26.04,Default,Garfiel,0,0,0,,Ale gdy tak mówisz, brzmi, jakbyś ty...
Dialogue: 0,0:06:26.13,0:06:29.34,Default,Ram,0,0,0,,Spotkałeś Czarownicę Chciwości, Barusu?
Dialogue: 0,0:06:30.77,0:06:31.65,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:06:32.66,0:06:33.54,Default,Ram,0,0,0,,Rozumiem.
Dialogue: 0,0:06:34.28,0:06:36.92,Default,Shima,0,0,0,,Dla kogoś, kto nie żył w tym czasie,
Dialogue: 0,0:06:37.01,0:06:41.04,Default,Shima,0,0,0,,Czarownica może wydawać się nieosiągalna.
Dialogue: 0,0:06:41.36,0:06:44.71,Default,Shima,0,0,0,,Oczywiście, nawet moje wspomnienia\Nsą wspomnieniami kogoś innego.
Dialogue: 0,0:06:44.80,0:06:47.51,Default,Shima,0,0,0,,Nie znam jej osobiście.
Dialogue: 0,0:06:47.60,0:06:49.70,Default,Ryuzu,0,0,0,,Widząc kogoś, kto wygląda jak ja,
Dialogue: 0,0:06:49.79,0:06:53.55,Default,Ryuzu,0,0,0,,Czuję się jakbym oszalała.
Dialogue: 0,0:06:52.61,0:06:55.81,Default,Subaru,0,0,0,,{\an8}Czuję się, jakbym słuchał klonów\Nopowiadających czarne dowcipy.
Dialogue: 0,0:06:55.97,0:07:01.90,Default,Shima,0,0,0,,Beatrice bardzo często pojawia się\Nwe wspomnieniach Ryuzu Meyer.
Dialogue: 0,0:07:01.99,0:07:05.73,Default,Shima,0,0,0,,Łączyła je niezwykle serdeczna przyjaźń.
Dialogue: 0,0:07:06.00,0:07:07.80,Default,Subaru,0,0,0,,Dokończ proszę tę historię.
Dialogue: 0,0:07:07.89,0:07:10.71,Default,Subaru,0,0,0,,Sanktuarium z pozoru było takie spokojne,
Dialogue: 0,0:07:10.80,0:07:12.06,Default,Subaru,0,0,0,,Więc co się stało?
Dialogue: 0,0:07:15.76,0:07:17.66,Default,Shima,0,0,0,,Upadło.
Dialogue: 0,0:07:18.05,0:07:23.83,Default,Shima,0,0,0,,Wtedy pojawił się prawdziwy\Npowód istnienia Sanktuarium.
Dialogue: 0,0:07:23.92,0:07:27.94,Default,Subaru,0,0,0,,Prawdziwy powód... jego istnienia?
Dialogue: 0,0:07:38.76,0:07:42.14,Default,Regulus,0,0,0,,Arcybiskup Grzechu z Kultu Czarownicy,\Nreprezentujący Chciwość...
Dialogue: 0,0:07:42.73,0:07:44.76,Default,Regulus,0,0,0,,Regulus Corneas.
Dialogue: 0,0:07:45.54,0:07:47.65,Default,Emilia,0,0,0,,Arcybiskup Grzechu z Kultu Czarownicy?
Dialogue: 0,0:07:47.74,0:07:49.65,Default,Geuse,0,0,0,,Co ty tu robisz?
Dialogue: 0,0:07:49.91,0:07:54.84,Default,Geuse,0,0,0,,Zapewniono mnie, że nikt oprócz\Nmnie nie może się w to mieszać!
Dialogue: 0,0:07:55.31,0:07:56.92,Default,Regulus,0,0,0,,Zapewniono cię?
Dialogue: 0,0:07:57.01,0:08:00.83,Default,Regulus,0,0,0,,Chyba sam wymyśliłeś tę zasadę i sam\Nsiebie o niej zapewniłeś.
Dialogue: 0,0:08:00.92,0:08:04.55,Default,Regulus,0,0,0,,A teraz próbujesz zmusić innych, by się\Njej podporządkowali?
Dialogue: 0,0:08:04.64,0:08:07.48,Default,Regulus,0,0,0,,Nieźle zarozumiały jak na\Nbezwartościowego ducha.
Dialogue: 0,0:08:07.57,0:08:09.88,Default,Geuse,0,0,0,,Jeśli nie lubisz tej zasady,
Dialogue: 0,0:08:09.97,0:08:12.32,Default,Geuse,0,0,0,,Więc omów to z Kościołem!
Dialogue: 0,0:08:12.41,0:08:14.34,Default,Geuse,0,0,0,,Dlaczego tu przyszedłeś?!
Dialogue: 0,0:08:14.93,0:08:16.09,Default,Pandora,0,0,0,,Bo...
Dialogue: 0,0:08:16.99,0:08:19.06,Default,Pandora,0,0,0,,Rozkazałam mu to zrobić.
Dialogue: 0,0:08:31.15,0:08:34.91,Default,Pandora,0,0,0,,Co się stało, biskupie Romanée-Conti?
Dialogue: 0,0:08:35.35,0:08:36.91,Default,Geuse,0,0,0,,Dlaczego?
Dialogue: 0,0:08:37.19,0:08:38.96,Default,Geuse,0,0,0,,Dlaczego tu jesteś?!
Dialogue: 0,0:08:39.49,0:08:42.88,Default,Geuse,0,0,0,,Regulusie Corneasie! Dlaczego ona tu\Njest?!
Dialogue: 0,0:08:42.97,0:08:46.63,Default,Regulus,0,0,0,,Przyszła tu z własnej woli.
Dialogue: 0,0:08:46.72,0:08:48.74,Default,Regulus,0,0,0,,Dlaczego wszystko zrzucasz na mnie?
Dialogue: 0,0:08:48.83,0:08:50.74,Default,,0,0,0,,Masz coś przeciwko mnie?
Dialogue: 0,0:08:50.83,0:08:55.58,Default,Pandora,0,0,0,,Biskupie Corneas, on po\Nprostu jest zdezorientowany.
Dialogue: 0,0:08:55.67,0:08:57.90,Default,Pandora,0,0,0,,Nie krytykuj go tak bardzo.
Dialogue: 0,0:09:00.98,0:09:04.61,Default,Pandora,0,0,0,,Teraz, przynieś klucz i pieczęć tutaj,
Dialogue: 0,0:09:04.70,0:09:07.85,Default,Pandora,0,0,0,,aby Kult Czarownicy mógł spełnić swoje\Nodwieczne pragnienie.
Dialogue: 0,0:09:07.94,0:09:09.77,Default,Fortuna,0,0,0,,Pandora!
Dialogue: 0,0:09:12.96,0:09:13.84,Default,Pandora,0,0,0,,Hm?
Dialogue: 0,0:09:13.93,0:09:15.29,Default,Fortuna,0,0,0,,Nadziej się na lód!
Dialogue: 0,0:09:15.38,0:09:18.07,Default,Fortuna,0,0,0,,I przeproś mojego brata i jego żonę!
Dialogue: 0,0:09:19.49,0:09:22.37,Default,Fortuna,0,0,0,,Teraz odejdź na zawsze!
Dialogue: 0,0:09:29.81,0:09:31.45,Default,Regulus,0,0,0,,No proszę.
Dialogue: 0,0:09:31.54,0:09:34.96,Default,Regulus,0,0,0,,Nawet nie celowałaś w moją stronę,
Dialogue: 0,0:09:35.05,0:09:38.17,Default,Regulus,0,0,0,,a użyłaś ataku, o którym wiedziałaś, że\Ntrafi także we mnie?
Dialogue: 0,0:09:38.26,0:09:40.67,Default,Regulus,0,0,0,,To tak jak deptanie mojego życia,
Dialogue: 0,0:09:40.76,0:09:46.85,Default,Regulus,0,0,0,,mojego istnienia, mojego Autorytetu i\Nsamego człowieczeństwa, prawda?
Dialogue: 0,0:09:59.84,0:10:01.17,Default,Geuse,0,0,0,,Fortuna!
Dialogue: 0,0:10:01.26,0:10:03.99,Default,Geuse,0,0,0,,Proszę, zabierz Emilię i wyjdź stąd.
Dialogue: 0,0:10:04.87,0:10:06.01,Default,Emilia,0,0,0,,Matko...
Dialogue: 0,0:10:06.90,0:10:07.85,Default,Fortuna,0,0,0,,Emilia...
Dialogue: 0,0:10:08.64,0:10:09.71,Default,Geuse,0,0,0,,Nie martw się.
Dialogue: 0,0:10:10.33,0:10:14.17,Default,Geuse,0,0,0,,Nie zostałbym tu bez planu.
Dialogue: 0,0:10:18.25,0:10:20.52,Default,Fortuna,0,0,0,,Przysięgam, że wrócę ci pomóc!
Dialogue: 0,0:10:20.61,0:10:21.52,Default,Fortuna,0,0,0,,Przysięgam!
Dialogue: 0,0:10:21.61,0:10:22.79,Default,Emilia,0,0,0,,Geuse!
Dialogue: 0,0:10:22.88,0:10:26.97,Default,Echidna,0,0,0,,Mając na uwadze próbę, powinnaś chyba\Npodążyć za samą sobą, prawda?
Dialogue: 0,0:10:27.06,0:10:28.16,Default,Echidna,0,0,0,,Co zrobisz?
Dialogue: 0,0:10:28.98,0:10:31.23,Default,Regulus,0,0,0,,To było całkiem godne podziwu.
Dialogue: 0,0:10:31.62,0:10:35.48,Default,Regulus,0,0,0,,Ale kto pozwolił ci dać im uciec?
Dialogue: 0,0:10:35.57,0:10:40.16,Default,Regulus,0,0,0,,To narusza moje prawo do działania i mój\NAutorytet, prawda?
Dialogue: 0,0:10:40.25,0:10:41.85,Default,Geuse,0,0,0,,Mów co chcesz.
Dialogue: 0,0:10:41.94,0:10:44.03,Default,Geuse,0,0,0,,Choćbym miał zaryzykować istnienie,
Dialogue: 0,0:10:44.12,0:10:47.41,Default,Geuse,0,0,0,,nie pozwolę wam przejść dalej!
Dialogue: 0,0:10:51.42,0:10:53.48,Default,Regulus,0,0,0,,Czekaj, nie zamierzasz...
Dialogue: 0,0:10:53.57,0:10:57.30,Default,Geuse,0,0,0,,Nie potrafię się do tego przystosować.
Dialogue: 0,0:10:57.65,0:11:01.56,Default,Geuse,0,0,0,,Dlatego jedynie strzegłem go, odkąd mi go\Npowierzono.
Dialogue: 0,0:11:01.65,0:11:04.83,Default,Geuse,0,0,0,,Ale właśnie na taką chwilę był\Nprzeznaczony!
Dialogue: 0,0:11:06.34,0:11:09.09,Default,Pandora,0,0,0,,Biskupie Petelgeuse Romanée-Conti...
Dialogue: 0,0:11:11.01,0:11:12.44,Default,Pandora,0,0,0,,Miłej podróży.
Dialogue: 0,0:11:22.32,0:11:25.53,Default,Geuse,0,0,0,,Proszę... wybacz mi...
Dialogue: 0,0:11:26.58,0:11:28.29,Default,Geuse,0,0,0,,Flugel!
Dialogue: 0,0:11:40.23,0:11:41.45,Default,Regulus,0,0,0,,Co za idiota.
Dialogue: 0,0:11:46.73,0:11:48.68,Default,Pandora,0,0,0,,Wspaniałe...
Dialogue: 0,0:11:51.53,0:11:53.65,Default,Pandora,0,0,0,,Biskup Regulus Corneas.
Dialogue: 0,0:11:55.15,0:11:56.03,Default,Regulus,0,0,0,,Tak?
Dialogue: 0,0:11:57.17,0:11:58.36,Default,Pandora,0,0,0,,Nadchodzi.
Dialogue: 0,0:12:13.17,0:12:15.38,Default,Geuse,0,0,0,,Mówiłem ci...
Dialogue: 0,0:12:15.93,0:12:19.15,Default,Geuse,0,0,0,,To, co tu widzisz, to nadzieja.
Dialogue: 0,0:12:19.24,0:12:24.91,Default,Geuse,0,0,0,,Wielki, niezapomniany dług wobec ludzi,\Nktórzy uczynili mnie tym, kim jestem.
Dialogue: 0,0:12:25.60,0:12:26.60,Default,Geuse,0,0,0,,Więc teraz...
Dialogue: 0,0:12:27.48,0:12:31.23,Default,Geuse,0,0,0,,Jeśli jestem godzien tego, by pluć\Nkrwią...
Dialogue: 0,0:12:31.32,0:12:36.10,Default,Pandora,0,0,0,,Co widzisz tymi szkarłatnymi oczami,
Dialogue: 0,0:12:36.71,0:12:38.40,Default,Pandora,0,0,0,,biskupie Romanée-Conti?
Dialogue: 0,0:12:39.52,0:12:40.57,Default,Geuse,0,0,0,,Miłość.
Dialogue: 0,0:12:41.25,0:12:43.28,Default,Geuse,0,0,0,,Nie pozwolę ci ścigać tamtej dwójki.
Dialogue: 0,0:12:44.13,0:12:49.98,Default,Geuse,0,0,0,,Nie pozwolę ci mnie ominąć!
Dialogue: 0,0:12:54.18,0:12:56.67,Default,Emilia,0,0,0,,Geuse, co... co zrobiłeś?!
Dialogue: 0,0:12:57.11,0:12:59.54,Default,Pandora,0,0,0,,Wspaniały pokaz twojej determinacji.
Dialogue: 0,0:12:59.63,0:13:02.23,Default,Pandora,0,0,0,,Biskupie Petelgeuse Romanée-Conti.
Dialogue: 0,0:13:02.73,0:13:05.19,Default,Pandora,0,0,0,,W imię Czarownicy Próżności,
Dialogue: 0,0:13:05.28,0:13:07.91,Default,Pandora,0,0,0,,za twoją determinację\Ni niezachwianą wolę,
Dialogue: 0,0:13:08.00,0:13:10.22,Default,,0,0,0,,nadaję ci miano Lenistwa.
Dialogue: 0,0:13:10.66,0:13:14.76,Default,Geuse,0,0,0,,Myślisz, że pragnę takiego tytułu?
Dialogue: 0,0:13:14.85,0:13:17.23,Default,Geuse,0,0,0,,Jest tylko jedna rzecz,\Nktórej pragnę teraz:
Dialogue: 0,0:13:17.97,0:13:20.98,Default,Geuse,0,0,0,,spokój dla tej matki i jej dziecka!
Dialogue: 0,0:13:21.76,0:13:22.65,Default,Pandora,0,0,0,,Miłość...
Dialogue: 0,0:13:23.44,0:13:25.36,Default,Pandora,0,0,0,,Jak cudownie.
Dialogue: 0,0:13:25.90,0:13:27.84,Default,Geuse,0,0,0,,To kłamstwo, które wypowiadasz...
Dialogue: 0,0:13:28.75,0:13:32.79,Default,Geuse,0,0,0,,jest ciepłem, które nigdy nie może\Nzaistnieć!
Dialogue: 0,0:13:38.88,0:13:40.00,Default,Regulus,0,0,0,,Hej, posłuchaj...
Dialogue: 0,0:13:42.13,0:13:44.60,Default,Regulus,0,0,0,,Pojawiłem się tutaj, stoję tutaj,
Dialogue: 0,0:13:44.69,0:13:46.92,Default,Regulus,0,0,0,,I ty mnie ignorujesz?
Dialogue: 0,0:13:47.01,0:13:49.04,Default,,0,0,0,,Co ty sobie myślisz?
Dialogue: 0,0:13:49.13,0:13:50.01,Default,Emilia,0,0,0,,Nie...
Dialogue: 0,0:13:50.61,0:13:52.81,Default,Geuse,0,0,0,,Regulus Corneas!
Dialogue: 0,0:13:52.90,0:13:54.77,Default,Regulus,0,0,0,,To mnie wkurza!
Dialogue: 0,0:13:55.25,0:13:58.10,Default,Regulus,0,0,0,,Nie ma mowy, by Czynnik Czarownicy wybrał\Nwłaśnie ciebie,
Dialogue: 0,0:13:58.19,0:14:01.67,Default,Regulus,0,0,0,,a mimo ceny, jakiej wymaga, kurczowo się\Ngo trzymasz?
Dialogue: 0,0:14:01.76,0:14:04.43,Default,Geuse,0,0,0,,Nie obchodzi mnie, co powiesz! Ja—
Dialogue: 0,0:14:16.65,0:14:17.91,Default,Echidna,0,0,0,,Remis przez powtórzenie.
Dialogue: 0,0:14:18.64,0:14:20.87,Default,Echidna,0,0,0,,Dopóki tkwią w impasie,
Dialogue: 0,0:14:20.96,0:14:23.55,Default,Echidna,0,0,0,,coś powinno dziać się z pozostałą dwójką.
Dialogue: 0,0:14:23.64,0:14:25.62,Default,Emilia,0,0,0,,Mówisz, że powinnyśmy stąd wyjść?
Dialogue: 0,0:14:25.71,0:14:28.18,Default,Emilia,0,0,0,,Ale spójrz, co Geuse sam sobie robi!
Dialogue: 0,0:14:28.27,0:14:32.88,Default,Echidna,0,0,0,,Można dyskutować, czy siła woli mogła\Nwpłynąć na wynik.
Dialogue: 0,0:14:32.97,0:14:35.59,Default,Emilia,0,0,0,,Nie możemy po prostu tu stać i patrzeć?
Dialogue: 0,0:14:35.68,0:14:36.56,Default,Emilia,0,0,0,,Chcę—
Dialogue: 0,0:14:43.36,0:14:48.95,Default,Echidna,0,0,0,,Wygląda na to, że nawet twój ograniczony\Numysł pojął, który wybór jest mądrzejszy.
Dialogue: 0,0:14:54.44,0:14:55.96,Default,Echidna,0,0,0,,Zmiana miejsca.
Dialogue: 0,0:14:56.05,0:14:59.46,Default,Echidna,0,0,0,,Przenosimy się tam, dokąd uciekłyście z\Nmatką.
Dialogue: 0,0:15:00.63,0:15:03.68,Default,Emilia,0,0,0,,{\an8}Nie! Nie, mamo!
Dialogue: 0,0:15:02.29,0:15:06.00,Default,Fortuna,0,0,0,,Proszę, Emilio. Zaraz wrócę, tylko...
Dialogue: 0,0:15:04.85,0:15:07.40,Default,Emilia,0,0,0,,{\an8}Nie! Nie możesz!
Dialogue: 0,0:15:07.49,0:15:10.32,Default,Emilia,0,0,0,,Masz taki sam wyraz twarzy jak Geuse!
Dialogue: 0,0:15:10.41,0:15:13.17,Default,Emilia,0,0,0,,Nie zostawiaj mnie! Nie zostawiaj mnie\Nsamej!
Dialogue: 0,0:15:13.26,0:15:16.45,Default,Emilia,0,0,0,,Nie będę już więcej kłamać\Nani łamać obietnic!
Dialogue: 0,0:15:16.54,0:15:20.14,Default,Emilia,0,0,0,,Będę grzeczna! Będę grzeczną dziewczynką!
Dialogue: 0,0:15:21.57,0:15:22.55,Default,Fortuna,0,0,0,,Emilia...
Dialogue: 0,0:15:23.78,0:15:26.11,Default,Fortuna,0,0,0,,Emilia... Emilia...
Dialogue: 0,0:15:26.89,0:15:27.88,Default,Fortuna,0,0,0,,Emilia...
Dialogue: 0,0:15:34.75,0:15:36.53,Default,Emilia,0,0,0,,Matka Fortuna...
Dialogue: 0,0:15:41.04,0:15:46.67,Default,Emilia,0,0,0,,Matka Fortuna... była\Nmoją prawdziwą matką.
Dialogue: 0,0:15:50.54,0:15:52.08,Default,Emilia,0,0,0,,Matka Fortuna...
Dialogue: 0,0:15:52.83,0:15:53.86,Default,,0,0,0,,Kocham cię.
Dialogue: 0,0:15:55.41,0:15:56.29,Default,Archi,0,0,0,,Fortuna!
Dialogue: 0,0:16:01.60,0:16:04.10,Default,Fortuna,0,0,0,,Archi, czy mieszkańcy są bezpieczni?
Dialogue: 0,0:16:06.18,0:16:07.64,Default,Archi,0,0,0,,Nie mam dobrych wiadomości.
Dialogue: 0,0:16:08.21,0:16:12.19,Default,Archi,0,0,0,,Mężczyźni walczą z ludźmi, którzy przybyli\Nz biskupem.
Dialogue: 0,0:16:12.65,0:16:15.14,Default,Archi,0,0,0,,Jeśli zostaniemy w lesie,\Nw końcu nas znajdą.
Dialogue: 0,0:16:15.23,0:16:16.62,Default,Archi,0,0,0,,Oni chcą...
Dialogue: 0,0:16:17.57,0:16:19.47,Default,Fortuna,0,0,0,,Pieczęć, prawda?
Dialogue: 0,0:16:19.85,0:16:21.54,Default,Fortuna,0,0,0,,Skąd się dowiedzieli?
Dialogue: 0,0:16:24.32,0:16:25.74,Default,Fortuna,0,0,0,,Nawet ta kobieta...
Dialogue: 0,0:16:27.33,0:16:29.20,Default,Fortuna,0,0,0,,Dobrze, zaraz przyjdę.
Dialogue: 0,0:16:29.29,0:16:31.73,Default,Archi,0,0,0,,Nie, będziemy walczyć.
Dialogue: 0,0:16:31.82,0:16:33.88,Default,Archi,0,0,0,,Musisz zabrać Emilię i opuścić las!
Dialogue: 0,0:16:33.97,0:16:35.87,Default,Fortuna,0,0,0,,A co się stanie, jeśli ucieknę teraz?!
Dialogue: 0,0:16:36.32,0:16:38.29,Default,Fortuna,0,0,0,,Jeśli dostaną pieczęć,
Dialogue: 0,0:16:38.38,0:16:40.40,Default,,0,0,0,,tym razem świat {\i1}naprawdę{\i0} się skończy!
Dialogue: 0,0:16:42.71,0:16:46.86,Default,Fortuna,0,0,0,,Przykro mi, że musiałeś przez\Nto przejść, żeby nas chronić.
Dialogue: 0,0:16:46.95,0:16:48.39,Default,Archi,0,0,0,,Proszę, nie mów tak!
Dialogue: 0,0:16:48.48,0:16:51.12,Default,Archi,0,0,0,,Kto mógłby okazać taką\Npogardę dla członka rodziny?!
Dialogue: 0,0:16:51.65,0:16:52.67,Default,Fortuna,0,0,0,,Przepraszam.
Dialogue: 0,0:16:54.99,0:16:56.07,Default,Fortuna,0,0,0,,Emilia...
Dialogue: 0,0:16:56.48,0:17:01.55,Default,Fortuna,0,0,0,,Muszę odejść i wypełnić bardzo ważny\Nobowiązek: ochronić wszystkich.
Dialogue: 0,0:17:02.01,0:17:04.47,Default,Fortuna,0,0,0,,Dlatego muszę na chwilę odejść, dobrze?
Dialogue: 0,0:17:04.56,0:17:07.80,Default,Emilia,0,0,0,,Nie, mamo! Ja... ja...
Dialogue: 0,0:17:07.89,0:17:10.57,Default,Fortuna,0,0,0,,Zrób, o co proszę.
Dialogue: 0,0:17:10.66,0:17:13.55,Default,Fortuna,0,0,0,,Chcę, żebyś opuściła ten las z Archim.
Dialogue: 0,0:17:18.70,0:17:21.88,Default,Archi,0,0,0,,Fortuna...
Dialogue: 0,0:17:21.97,0:17:22.85,Default,Fortuna,0,0,0,,Archi...
Dialogue: 0,0:17:23.89,0:17:25.45,Default,Fortuna,0,0,0,,Trochę za wcześnie.
Dialogue: 0,0:17:25.54,0:17:27.92,Default,,0,0,0,,Ale powierzam ci misję mieszkańców lasu.
Dialogue: 0,0:17:28.59,0:17:30.54,Default,Fortuna,0,0,0,,Proszę, zabierz Emilię stąd.
Dialogue: 0,0:17:31.26,0:17:33.02,Default,Fortuna,0,0,0,,Niełatwo jest żyć w tym świecie.
Dialogue: 0,0:17:33.11,0:17:34.64,Default,Fortuna,0,0,0,,Ale wiem, że jest nadzieja.
Dialogue: 0,0:17:35.61,0:17:36.94,Default,Fortuna,0,0,0,,Jestem tego pewna.
Dialogue: 0,0:17:37.03,0:17:39.47,Default,Archi,0,0,0,,Nie mogę! Muszę zostać z nimi aż do—
Dialogue: 0,0:17:39.56,0:17:40.54,Default,Fortuna,0,0,0,,Zabierz Emilię.
Dialogue: 0,0:17:41.08,0:17:41.96,Default,Fortuna,0,0,0,,Proszę.
Dialogue: 0,0:17:42.69,0:17:47.74,Default,,0,0,0,,Jest ukochaną córką mojego brata, jego\Nżony i moją.
Dialogue: 0,0:17:50.89,0:17:52.24,Default,Archi,0,0,0,,To nie fair.
Dialogue: 0,0:17:52.74,0:17:57.76,Default,Archi,0,0,0,,Wiesz, że nie mogę odmówić,\Nkiedy mi to mówisz.
Dialogue: 0,0:17:58.03,0:17:59.07,Default,Fortuna,0,0,0,,Przepraszam.
Dialogue: 0,0:18:00.53,0:18:02.93,Default,Fortuna,0,0,0,,Postępujemy nieuczciwie, ale proszę,\Nwybacz nam.
Dialogue: 0,0:18:03.87,0:18:04.75,Default,Fortuna,0,0,0,,Emilia...
Dialogue: 0,0:18:04.84,0:18:08.03,Default,Emilia,0,0,0,,Nie, zostaję, chcę zostać z tobą!
Dialogue: 0,0:18:08.12,0:18:13.47,Default,Emilia,0,0,0,,Proszę! Proszę! Nie chcę... nie chcę być\Nsama!
Dialogue: 0,0:18:14.22,0:18:17.15,Default,Fortuna,0,0,0,,Nigdy nie będziesz sama.
Dialogue: 0,0:18:19.37,0:18:22.90,Default,Fortuna,0,0,0,,Zawsze będę przy tobie.
Dialogue: 0,0:18:23.82,0:18:27.71,Default,Fortuna,0,0,0,,W wspomnieniach, które pojawiają\Nsię, gdy zamykasz oczy...
Dialogue: 0,0:18:28.42,0:18:31.98,Default,Fortuna,0,0,0,,W snach, w których obejmujesz się i\Nczujesz ciepło...
Dialogue: 0,0:18:32.74,0:18:36.24,Default,Fortuna,0,0,0,,W echach, które słyszysz,\Ngdy krzyczysz w niebo...
Dialogue: 0,0:18:37.05,0:18:40.11,Default,Fortuna,0,0,0,,Zawsze będę z tobą.
Dialogue: 0,0:18:40.47,0:18:43.11,Default,Fortuna,0,0,0,,Jestem z tobą na zawsze.
Dialogue: 0,0:18:43.20,0:18:45.42,Default,Emilia,0,0,0,,Kłamiesz... kłamiesz!
Dialogue: 0,0:18:45.95,0:18:48.07,Default,Emilia,0,0,0,,Kłamiesz, mamo!
Dialogue: 0,0:18:49.93,0:18:51.94,Default,Fortuna,0,0,0,,Emilia, obiecuję.
Dialogue: 0,0:19:04.10,0:19:07.54,Default,Fortuna,0,0,0,,Ty i ja zawsze będziemy razem.
Dialogue: 0,0:19:08.28,0:19:11.18,Default,Fortuna,0,0,0,,Obiecuję ci to teraz.
Dialogue: 0,0:19:12.45,0:19:16.09,Default,Emilia,0,0,0,,Naprawdę? Zostaniesz ze mną?
Dialogue: 0,0:19:16.64,0:19:18.68,Default,Fortuna,0,0,0,,Tak, naprawdę.
Dialogue: 0,0:19:19.20,0:19:21.15,Default,Fortuna,0,0,0,,Bardziej niż kogokolwiek, Emilio...
Dialogue: 0,0:19:21.70,0:19:26.86,Default,Fortuna,0,0,0,,Kocham cię bardziej niż\Nkogokolwiek innego na świecie.
Dialogue: 0,0:19:36.25,0:19:38.16,Default,Emilia,0,0,0,,Matka Fortuna...
Dialogue: 0,0:19:38.61,0:19:41.74,Default,Emilia,0,0,0,,Ja ciebie też, mamo.
Dialogue: 0,0:19:42.21,0:19:43.74,Default,Emilia,0,0,0,,Kocham cię!
Dialogue: 0,0:19:44.48,0:19:48.93,Default,Emilia,0,0,0,,Kocham cię... kocham cię, Matko Fortuno.
Dialogue: 0,0:19:49.32,0:19:54.46,Default,Emilia,0,0,0,,Tak bardzo cię kocham...\Ntak bardzo... tak bardzo!
Dialogue: 0,0:19:55.50,0:19:57.62,Default,Fortuna,0,0,0,,Lia, kocham cię.
Dialogue: 0,0:20:02.74,0:20:05.38,Default,Fortuna,0,0,0,,Kocham cię, Emilio.
Dialogue: 0,0:20:06.89,0:20:10.04,Default,Emilia,0,0,0,,Dlaczego? Dlaczego tak się stało?
Dialogue: 0,0:20:10.13,0:20:12.56,Default,Emilia,0,0,0,,Bo złamałam obietnicę i wyszłam z pokoju?
Dialogue: 0,0:20:12.65,0:20:14.90,Default,Archi,0,0,0,,Nie! To wcale nie twoja wina!
Dialogue: 0,0:20:15.17,0:20:16.52,Default,Archi,0,0,0,,To nie jest niczyja wina!
Dialogue: 0,0:20:16.61,0:20:20.09,Default,Emilia,0,0,0,,Więc dlaczego? Dlaczego musimy wyjechać?
Dialogue: 0,0:20:20.18,0:20:23.51,Default,Emilia,0,0,0,,Czy powinnam była na zawsze zostać\Nzamknięta w pokoju?
Dialogue: 0,0:20:23.60,0:20:26.79,Default,Emilia,0,0,0,,Żeby nikt nie odchodził i\Nwszyscy mogli zostać razem?
Dialogue: 0,0:20:26.88,0:20:27.83,Default,Archi,0,0,0,,Mylisz się, Emilio!
Dialogue: 0,0:20:28.21,0:20:30.05,Default,Emilia,0,0,0,,Byłam niegrzeczna?
Dialogue: 0,0:20:30.14,0:20:33.20,Default,,0,0,0,,Czy dlatego wszyscy mnie nienawidzą i\Nzostaję sama?
Dialogue: 0,0:20:33.29,0:20:35.83,Default,Archi,0,0,0,,Nie! To nieprawda, Emilio!
Dialogue: 0,0:20:36.06,0:20:38.01,Default,Archi,0,0,0,,Nikt cię nie nienawidzi!
Dialogue: 0,0:20:38.10,0:20:41.46,Default,Archi,0,0,0,,Wszystko na tym świecie\Nistnieje, by cię błogosławić!
Dialogue: 0,0:20:54.08,0:20:55.35,Default,Archi,0,0,0,,Czarny Wąż?
Dialogue: 0,0:20:55.68,0:20:58.23,Default,Archi,0,0,0,,Tygiel chorób... magiczna bestia\Nroznosząca zarazę?
Dialogue: 0,0:21:00.19,0:21:01.23,Default,Archi,0,0,0,,Fula!
Dialogue: 0,0:21:02.18,0:21:03.52,Default,Archi,0,0,0,,Huma!
Dialogue: 0,0:21:04.45,0:21:05.39,Default,Emilia,0,0,0,,Archi?
Dialogue: 0,0:21:05.76,0:21:08.16,Default,Archi,0,0,0,,Nic mi nie jest.
Dialogue: 0,0:21:08.97,0:21:11.16,Default,Archi,0,0,0,,Wszystko jest... w porządku.
Dialogue: 0,0:21:19.44,0:21:25.10,Default,Archi,0,0,0,,Emilia... widzisz te białe kwiaty\Nmiędzy tymi dwoma drzewami?
Dialogue: 0,0:21:25.19,0:21:26.07,Default,Emilia,0,0,0,,Mhm.
Dialogue: 0,0:21:26.20,0:21:28.59,Default,Archi,0,0,0,,Możesz pobiec do tych kwiatów?
Dialogue: 0,0:21:29.17,0:21:33.09,Default,Archi,0,0,0,,Przebiegnij przez nie i biegnij prosto.
Dialogue: 0,0:21:33.77,0:21:36.72,Default,Emilia,0,0,0,,Mogę... mogę biec.
Dialogue: 0,0:21:37.37,0:21:38.25,Default,Emilia,0,0,0,,Ale...
Dialogue: 0,0:21:38.34,0:21:42.59,Default,Archi,0,0,0,,Nie martw się, Emilio, nie będziesz sama.
Dialogue: 0,0:21:43.36,0:21:44.53,Default,Emilia,0,0,0,,Archi...
Dialogue: 0,0:21:45.98,0:21:47.64,Default,Archi,0,0,0,,Teraz biegnij!
Dialogue: 0,0:21:47.73,0:21:49.66,Default,Archi,0,0,0,,Nie patrz wstecz, cokolwiek usłyszysz!
Dialogue: 0,0:21:52.46,0:21:54.63,Default,Archi,0,0,0,,Tak.
Dialogue: 0,0:21:55.30,0:21:56.87,Default,Archi,0,0,0,,Biegnij dalej.
Dialogue: 0,0:21:57.33,0:22:00.07,Default,Archi,0,0,0,,Tak jak zawsze każesz nam za sobą ganiać.
Dialogue: 0,0:22:04.98,0:22:08.10,Default,Archi,0,0,0,,Myślisz, że cię puścę?
Dialogue: 0,0:22:10.18,0:22:11.72,Default,Archi,0,0,0,,Fortuna...
Dialogue: 0,0:22:12.00,0:22:15.71,Default,Archi,0,0,0,,Wiem, że twojej córce nic nie będzie.
Dialogue: 0,0:22:25.53,0:22:28.05,Default,Geuse,0,0,0,,Nawet po tym wszystkim...
Dialogue: 0,0:22:28.45,0:22:32.58,Default,Regulus,0,0,0,,Dlaczego po prostu nie przyznajesz,\Nże to beznadziejne?
Dialogue: 0,0:22:36.00,0:22:42.57,Default,Regulus,0,0,0,,Tyle znaczyły twoje postanowienia,\Ndeterminacja i cała reszta.
Dialogue: 0,0:22:42.66,0:22:45.99,Default,Regulus,0,0,0,,Nie robię tego dlatego, że jestem sadystą.
Dialogue: 0,0:22:46.08,0:22:49.91,Default,Regulus,0,0,0,,Wygląda tylko, jakbym cię dręczył, bo\Njesteś słaby.
Dialogue: 0,0:22:50.74,0:22:55.55,Default,Pandora,0,0,0,,Nie krytykuj go zbyt surowo,\Nbiskupie Corneas.
Dialogue: 0,0:22:55.64,0:22:59.85,Default,Pandora,0,0,0,,Jesteś wyjątkowszy i doskonalszy niż\Ninni, dlatego jesteś wspaniały...
Dialogue: 0,0:22:59.94,0:23:04.02,Default,Pandora,0,0,0,,Są też wspaniali, mimo\Nswojej niedoskonałości.
Dialogue: 0,0:23:05.43,0:23:09.20,Default,Regulus,0,0,0,,Dajesz mi więcej pracy, głupcze.
Dialogue: 0,0:23:09.42,0:23:10.91,Default,Fortuna,0,0,0,,Al Fula!
Dialogue: 0,0:23:13.76,0:23:15.28,Default,Fortuna,0,0,0,,Czekaj, Geuse!
Dialogue: 0,0:23:15.70,0:23:18.84,Default,Geuse,0,0,0,,Fortuna... Czy Emilia—
Dialogue: 0,0:23:18.93,0:23:21.16,Default,Fortuna,0,0,0,,Wysłałam ją z lasu razem z Archim.
Dialogue: 0,0:23:21.25,0:23:22.52,Default,Fortuna,0,0,0,,Dzięki tobie.
Dialogue: 0,0:23:23.24,0:23:26.09,Default,Geuse,0,0,0,,To... miło słyszeć...
Dialogue: 0,0:23:27.14,0:23:29.80,Default,Regulus,0,0,0,,Nie ma w tym nic dobrego!
Dialogue: 0,0:23:30.30,0:23:34.31,Default,Regulus,0,0,0,,Za kogo się uważasz, że tu wracasz?
Dialogue: 0,0:23:34.40,0:23:38.14,Default,Regulus,0,0,0,,Miałem zmiażdżyć mu głowę pod stopą!
Dialogue: 0,0:23:38.37,0:23:39.51,Default,Regulus,0,0,0,,Ja!
Dialogue: 0,0:23:39.60,0:23:42.81,Default,Regulus,0,0,0,,Kto ci dał prawo, kto ci pozwolił,
Dialogue: 0,0:23:42.90,0:23:48.44,Default,Regulus,0,0,0,,żeby przeszkadzać mnie,\Nmnie, mnie, mnie, mnie?!
Dialogue: 0,0:23:46.98,0:23:49.70,Default,Pandora,0,0,0,,{\an8}Czekaj, biskupie Corneas.
Dialogue: 0,0:23:49.79,0:23:52.53,Default,Regulus,0,0,0,,Co to było, Pandora?
Dialogue: 0,0:23:52.74,0:23:54.79,Default,Pandora,0,0,0,,Uspokój się.
Dialogue: 0,0:23:54.88,0:23:58.23,Default,Pandora,0,0,0,,Nie pozwolę ci ich tu zabić.
Dialogue: 0,0:23:58.32,0:24:01.71,Default,Pandora,0,0,0,,Nie czujesz nic, kiedy ich widzisz?
Dialogue: 0,0:24:07.53,0:24:11.26,Default,Regulus,0,0,0,,Czy właśnie rozkazałaś mi uspokoić gniew?
Dialogue: 0,0:24:12.01,0:24:16.35,Default,Regulus,0,0,0,,Nie bądź taka zarozumiała, kobieto!
Dialogue: 0,0:24:21.84,0:24:23.02,Default,Fortuna,0,0,0,,Nie...
Dialogue: 0,0:24:24.84,0:24:27.66,Default,Regulus,0,0,0,,Tak się kończy pyskowanie do mnie.
Dialogue: 0,0:24:28.10,0:24:30.08,Default,Regulus,0,0,0,,Nie przeszkadzaj mi!
Dialogue: 0,0:24:30.47,0:24:32.49,Default,Regulus,0,0,0,,Nie przerywaj, kiedy mówię!
Dialogue: 0,0:24:34.11,0:24:36.29,Default,Geuse,0,0,0,,Fortuna, proszę, uciekaj—
Dialogue: 0,0:24:36.38,0:24:38.09,Default,Fortuna,0,0,0,,Nie bądź głupcem.
Dialogue: 0,0:24:38.18,0:24:40.37,Default,,0,0,0,,Zostawiłam Emilię, żeby tu wrócić.
Dialogue: 0,0:24:40.90,0:24:42.65,Default,Geuse,0,0,0,,Ale dlaczego...
Dialogue: 0,0:24:42.74,0:24:44.54,Default,Fortuna,0,0,0,,Żebyś nie umarł.
Dialogue: 0,0:24:46.00,0:24:47.93,Default,Fortuna,0,0,0,,I żeby, gdybyś umarł,
Dialogue: 0,0:24:48.83,0:24:50.78,Default,Fortuna,0,0,0,,była przy tobie.
Dialogue: 0,0:24:53.48,0:24:55.53,Default,Fortuna,0,0,0,,Gdyby ciebie nie było już na tym świecie,
Dialogue: 0,0:24:56.00,0:24:58.21,Default,Fortuna,0,0,0,,gdybyś przestał przychodzić do tego lasu,
Dialogue: 0,0:24:58.37,0:25:00.46,Default,Fortuna,0,0,0,,na co miałabym czekać?
Dialogue: 0,0:25:01.33,0:25:06.79,Default,Fortuna,0,0,0,,Nie wytrzymałabym tak długo bez ciebie.\NJestem zbyt słaba.
Dialogue: 0,0:25:06.88,0:25:09.32,Default,Geuse,0,0,0,,Ty... nie jesteś słaba.
Dialogue: 0,0:25:09.80,0:25:10.82,Default,Fortuna,0,0,0,,Tak, jestem!
Dialogue: 0,0:25:12.24,0:25:16.20,Default,Fortuna,0,0,0,,Tylko udawałam twardą przed tobą i Emilią.
Dialogue: 0,0:25:21.18,0:25:22.06,Default,Regulus,0,0,0,,Tch!
Dialogue: 0,0:25:22.15,0:25:28.00,Default,Regulus,0,0,0,,Chcesz mnie tak długo ignorować, a potem\Nbawić się beze mnie? Dobrze!
Dialogue: 0,0:25:28.09,0:25:30.87,Default,Regulus,0,0,0,,Zmiażdżę was oboje, aż zostanie tylko\Nkałuża krwi!
Dialogue: 0,0:25:30.96,0:25:34.84,Default,Pandora,0,0,0,,Mówiłam, żebyś zaczekał, biskupie Corneas.
Dialogue: 0,0:25:39.14,0:25:44.54,Default,Pandora,0,0,0,,Wybaczę ci wszystkie twoje\Ngwałtowne czyny i pochopne wybuchy.
Dialogue: 0,0:25:45.03,0:25:48.72,Default,Pandora,0,0,0,,Mój cel w przyprowadzeniu cię\Ntutaj został już spełniony.
Dialogue: 0,0:25:49.37,0:25:51.92,Default,Pandora,0,0,0,,Możesz już odejść.
Dialogue: 0,0:25:52.11,0:25:56.01,Default,Regulus,0,0,0,,To ty mnie tu sprowadziłaś, a teraz, gdy\Njesteś zadowolona, każesz mi odejść?!
Dialogue: 0,0:25:56.10,0:25:57.73,Default,Regulus,0,0,0,,Za jakiego głupca mnie uważasz—
Dialogue: 0,0:25:57.82,0:26:00.98,Default,Pandora,0,0,0,,Więc wezmę to na siebie.
Dialogue: 0,0:26:01.75,0:26:05.29,Default,Pandora,0,0,0,,Biskup Corneas nie powinien tu być.
Dialogue: 0,0:26:05.80,0:26:09.11,Default,Pandora,0,0,0,,Jest w swojej posiadłości,\Notoczony przez swoje żony.
Dialogue: 0,0:26:09.20,0:26:10.08,Default,Regulus,0,0,0,,Cze—
Dialogue: 0,0:26:13.44,0:26:16.79,Default,Pandora,0,0,0,,Odesłałam hałaśliwego młodzieńca.
Dialogue: 0,0:26:17.69,0:26:20.85,Default,Pandora,0,0,0,,Teraz możemy spokojnie porozmawiać.
Dialogue: 0,0:26:22.44,0:26:24.43,Default,Fortuna,0,0,0,,Mogę najpierw o coś zapytać?
Dialogue: 0,0:26:24.82,0:26:28.14,Default,Fortuna,0,0,0,,Czy wcześniej nie rozerwało cię na kawałki\Ni nie zabiło?
Dialogue: 0,0:26:28.48,0:26:29.36,Default,Pandora,0,0,0,,Słucham?
Dialogue: 0,0:26:29.95,0:26:32.40,Default,Pandora,0,0,0,,Może twoje oczy cię oszukały?
Dialogue: 0,0:26:33.17,0:26:35.75,Default,Pandora,0,0,0,,Teraz, gdy biskup Corneas odszedł,
Dialogue: 0,0:26:35.84,0:26:39.38,Default,Pandora,0,0,0,,Oczywiście, wyniki jego\Ndziałań również zniknęły.
Dialogue: 0,0:26:39.47,0:26:41.12,Default,Geuse,0,0,0,,To jest...
Dialogue: 0,0:26:41.60,0:26:45.94,Default,Pandora,0,0,0,,Nie cofnę jednak tego, że przejął cię\NCzynnik Czarownicy Lenistwa.
Dialogue: 0,0:26:46.03,0:26:49.08,Default,Pandora,0,0,0,,Chciałabym pochwalić cię za twoje\Nzachowanie
Dialogue: 0,0:26:49.17,0:26:53.46,Default,Pandora,0,0,0,,oraz zachowanie tej kobiety, która po\Nciebie wróciła.
Dialogue: 0,0:27:00.32,0:27:01.20,Default,Geuse,0,0,0,,Fortuna!
Dialogue: 0,0:27:01.99,0:27:04.76,Default,Geuse,0,0,0,,Pokonajmy ją razem!
Dialogue: 0,0:27:05.28,0:27:08.58,Default,Geuse,0,0,0,,Musimy zrobić wszystko co\Nw naszej mocy dla Emilii!
Dialogue: 0,0:27:13.12,0:27:15.53,Default,Fortuna,0,0,0,,Zamroź sam upływ czasu na biało,
Dialogue: 0,0:27:15.88,0:27:21.03,Default,Fortuna,0,0,0,,Demoniczny lód starożytności,\Nktóry przynosi wieczny sen duszy!
Dialogue: 0,0:27:22.58,0:27:26.92,Default,Geuse,0,0,0,,Moje życie, moja misja,\Ncała moja głęboka miłość...
Dialogue: 0,0:27:27.01,0:27:29.46,Default,Geuse,0,0,0,,Tutaj i teraz, w tej chwili!
Dialogue: 0,0:27:30.67,0:27:33.29,Default,Pandora,0,0,0,,No dalej.
Dialogue: 0,0:27:33.86,0:27:38.54,Default,Pandora,0,0,0,,Obejmijcie mnie i pozwólcie mi poczuć\Npełnię waszej determinacji.
Dialogue: 0,0:27:38.63,0:27:41.63,Episode Title,Title,0,0,0,,{\pos(320,60)\fs38\t(1,3000,\fs33)}Dzień, w którym Betel{\c&H448E25&}geuse {\c&HFFFFFF&}się roześmiał
Dialogue: 0,0:27:44.59,0:27:46.11,Default,Emilia,0,0,0,,Matka Fortuna...
Dialogue: 0,0:27:46.20,0:27:47.77,Default,Emilia,0,0,0,,Geuse... Archi...
Dialogue: 0,0:27:48.21,0:27:52.02,Default,Emilia,0,0,0,,Muszę... ja też muszę coś zrobić.
Dialogue: 0,0:27:52.50,0:27:54.61,Default,Pandora,0,0,0,,Przynieś klucz i pieczęć.
Dialogue: 0,0:27:58.67,0:28:00.07,Default,Emilia,0,0,0,,Pieczęć?
Dialogue: 0,0:28:02.74,0:28:04.85,Default,Emilia,0,0,0,,Jeśli tego chcesz,
Dialogue: 0,0:28:05.38,0:28:08.14,Default,Emilia,0,0,0,,Po prostu ci ją dam.
Dialogue: 0,0:28:08.61,0:28:09.86,Default,Emilia,0,0,0,,Tam jest ta rzecz...
Dialogue: 0,0:28:10.69,0:28:11.58,Default,Emilia,0,0,0,,Ale...
Dialogue: 0,0:28:31.91,0:28:33.64,Default,Emilia,0,0,0,,Wróżki?
Dialogue: 0,0:28:34.02,0:28:36.65,Default,Emilia,0,0,0,,Pokazujecie mi drogę?
Dialogue: 0,0:28:37.10,0:28:40.22,Default,Emilia,0,0,0,,Pieczęć... jest w tamtą stronę?
Dialogue: 0,0:28:40.76,0:28:44.14,Default,Emilia,0,0,0,,Mogę uratować matkę i wszystkich innych?
Dialogue: 0,0:29:05.12,0:29:07.56,Default,Emilia,0,0,0,,Chcę być z wami znowu!
Dialogue: 0,0:29:07.65,0:29:10.51,Default,Emilia,0,0,0,,Będę grzeczną dziewczyną!
Dialogue: 0,0:29:20.91,0:29:22.28,Default,Pandora,0,0,0,,Witaj.
Dialogue: 0,0:29:26.24,0:29:28.07,Default,Pandora,0,0,0,,Czekałam na ciebie.
Dialogue: 0,0:29:28.16,0:29:35.16,Default,,0,0,0,,
