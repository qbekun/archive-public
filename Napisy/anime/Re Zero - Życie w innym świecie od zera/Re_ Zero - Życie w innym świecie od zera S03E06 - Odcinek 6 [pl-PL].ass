Dialogue: 0,0:00:06.11,0:00:08.40,Default,Subaru,0,0,0,,Czy ja właśnie umarłem?
Dialogue: 0,0:00:11.74,0:00:14.91,Default,Subaru,0,0,0,,Elsa... co ta kobieta\Nrobiła w rezydencji?
Dialogue: 0,0:00:17.59,0:00:19.78,Default,Subaru,0,0,0,,To jest... cmentarz?
Dialogue: 0,0:00:19.87,0:00:22.76,Default,Subaru,0,0,0,,Więc... zaraz po próbie?
Dialogue: 0,0:00:22.85,0:00:23.92,Default,Subaru,0,0,0,,Albo...
Dialogue: 0,0:00:24.49,0:00:25.44,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:00:36.76,0:00:38.07,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:00:38.16,0:00:40.29,Default,Subaru,0,0,0,,Tak, to ja.
Dialogue: 0,0:00:43.22,0:00:46.18,Default,Emilia,0,0,0,,To nie ja! Naprawdę!
Dialogue: 0,0:00:44.80,0:00:46.09,Default,Subaru,0,0,0,,Wiem.
Dialogue: 0,0:00:46.18,0:00:48.42,Default,Subaru,0,0,0,,Wszystko w porządku.
Dialogue: 0,0:00:50.39,0:00:51.48,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:01:00.73,0:01:01.82,Default,Emilia,0,0,0,,Przepraszam.
Dialogue: 0,0:01:02.28,0:01:03.43,Default,Emilia,0,0,0,,W końcu się uspokoiłam.
Dialogue: 0,0:01:03.88,0:01:04.79,Default,Subaru,0,0,0,,Emilia...
Dialogue: 0,0:01:04.88,0:01:06.67,Default,Ram,0,0,0,,Dobrze się czujesz?
Dialogue: 0,0:01:07.76,0:01:10.79,Default,Emilia,0,0,0,,Tak... bo Subaru był\Nprzy mnie, myślę.
Dialogue: 0,0:01:11.52,0:01:14.09,Default,Emilia,0,0,0,,Musimy teraz porozmawiać o próbie.
Dialogue: 0,0:01:15.26,0:01:18.43,Default,Subaru,0,0,0,,Tak... ale mam całkiem dobre\Npojęcie o czym to jest.
Dialogue: 0,0:01:19.76,0:01:22.09,Default,Subaru,0,0,0,,Pokazało ci to twoją przeszłość, prawda?
Dialogue: 0,0:01:22.96,0:01:23.84,Default,Otto,0,0,0,,Przeszłość?
Dialogue: 0,0:01:24.24,0:01:27.23,Default,Garfiel,0,0,0,,Skąd, do cholery, wiesz, co dzieje się\Npodczas próby?
Dialogue: 0,0:01:27.72,0:01:29.99,Default,Subaru,0,0,0,,Widziałeś świecące ruiny, prawda?
Dialogue: 0,0:01:30.08,0:01:31.93,Default,Subaru,0,0,0,,Ja też byłem do niej uprawniony.
Dialogue: 0,0:01:32.64,0:01:33.52,Default,Subaru,0,0,0,,I...
Dialogue: 0,0:01:34.20,0:01:35.08,Default,Subaru,0,0,0,,I ją przeszedłem.
Dialogue: 0,0:01:38.16,0:01:40.87,Default,Ryuzu,0,0,0,,Młody Su przeszedł, co?
Dialogue: 0,0:01:41.07,0:01:43.73,Default,Ram,0,0,0,,Jeśli nie żartuje, to spore osiągnięcie.
Dialogue: 0,0:01:43.82,0:01:45.77,Default,Ram,0,0,0,,Jeśli to prawda, możemy usunąć barierę.
Dialogue: 0,0:01:46.21,0:01:48.11,Default,Ram,0,0,0,,Garf, jak wygląda teraz bariera?
Dialogue: 0,0:01:48.20,0:01:49.29,Default,Garfiel,0,0,0,,Nie ma zmian.
Dialogue: 0,0:01:49.52,0:01:51.25,Default,Ram,0,0,0,,Więc skłamałeś. Giń.
Dialogue: 0,0:01:51.43,0:01:53.59,Default,Subaru,0,0,0,,Doszłaś do tego wniosku za szybko!
Dialogue: 0,0:01:55.43,0:01:56.71,Default,Subaru,0,0,0,,Co się stało, Garfiel?
Dialogue: 0,0:01:57.78,0:01:59.84,Default,Garfiel,0,0,0,,Nic się nie stało.
Dialogue: 0,0:02:01.04,0:02:02.24,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:02:02.33,0:02:04.68,Default,Emilia,0,0,0,,Jeśli to prawda, to jak...
Dialogue: 0,0:02:04.91,0:02:06.60,Default,Emilia,0,0,0,,Co widziałeś?
Dialogue: 0,0:02:07.23,0:02:10.53,Default,Subaru,0,0,0,,Nie powiedziałbym, że coś „zobaczyłem”...\NRaczej „zrozumiałem”.
Dialogue: 0,0:02:10.94,0:02:14.57,Default,Subaru,0,0,0,,Wygląda na to, że tych sadystycznych prób\Njest więcej niż jedna.
Dialogue: 0,0:02:15.43,0:02:17.40,Default,Subaru,0,0,0,,Są w sumie trzy.
Dialogue: 0,0:02:18.04,0:02:20.08,Default,Emilia,0,0,0,,Więc... jeszcze dwie?
Dialogue: 0,0:02:23.52,0:02:26.56,Default,Subaru,0,0,0,,Emilio, mam propozycję.
Dialogue: 0,0:02:27.73,0:02:30.10,Default,Subaru,0,0,0,,Może ci się nie spodobać.
Dialogue: 0,0:02:30.83,0:02:31.81,Default,Emilia,0,0,0,,Masz jakiś pomysł?
Dialogue: 0,0:02:33.34,0:02:36.00,Default,Subaru,0,0,0,,Mogę przejść pozostałe próby za ciebie
Dialogue: 0,0:02:36.09,0:02:38.26,Default,Subaru,0,0,0,,To moja propozycja.
Dialogue: 0,0:02:38.60,0:02:40.50,Default,Subaru,0,0,0,,Chcę być twoją siłą.
Dialogue: 0,0:02:40.96,0:02:43.76,Default,Subaru,0,0,0,,Nie wiem, co zobaczyłaś w swojej\Nprzeszłości,
Dialogue: 0,0:02:44.30,0:02:48.45,Default,Subaru,0,0,0,,Ale jeśli to sprawiło, że płakałaś tak\Nmocno i wyglądałaś jakbyś cierpiała...
Dialogue: 0,0:02:49.04,0:02:50.35,Default,Subaru,0,0,0,,Chcę ci pomóc.
Dialogue: 0,0:02:50.44,0:02:51.32,Default,Garfiel,0,0,0,,Czekaj!
Dialogue: 0,0:02:51.41,0:02:55.58,Default,Garfiel,0,0,0,,Mówisz, co ci się podoba, a my siedzimy i\Nsłuchamy,
Dialogue: 0,0:02:55.67,0:02:57.99,Default,Garfiel,0,0,0,,ale nie chcę, żeby tę próbę przechodził
Dialogue: 0,0:02:58.08,0:03:01.69,Default,Garfiel,0,0,0,,ktokolwiek poza księżniczką Emilią.
Dialogue: 0,0:03:01.78,0:03:07.70,Default,Garfiel,0,0,0,,Jesteś ostatnią osobą, której pozwolę\Npozbyć się bariery!
Dialogue: 0,0:03:08.70,0:03:12.16,Default - flashback,Garfiel,0,0,0,,Możesz przejść próbę zamiast Emilii.{ep30 final}
Dialogue: 0,0:03:12.25,0:03:13.91,Default,Subaru,0,0,0,,Czekaj, czekaj, czekaj!
Dialogue: 0,0:03:14.00,0:03:17.44,Default,Garfiel,0,0,0,,Dziwi cię, że jestem przeciwko?
Dialogue: 0,0:03:17.53,0:03:19.08,Default,Garfiel,0,0,0,,Jesteś prawdziwym dupkiem.
Dialogue: 0,0:03:19.17,0:03:20.34,Default,Subaru,0,0,0,,Nie, dlaczego?
Dialogue: 0,0:03:20.43,0:03:21.34,Default,Emilia,0,0,0,,Subaru...
Dialogue: 0,0:03:22.52,0:03:26.06,Default,Emilia,0,0,0,,C-Czy twierdzisz, że nie możesz mi tego\Npowierzyć?
Dialogue: 0,0:03:26.38,0:03:27.26,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:03:27.35,0:03:30.11,Default,Emilia,0,0,0,,Bo widziałeś, jak zawiodłam.
Dialogue: 0,0:03:30.70,0:03:32.20,Default,Emilia,0,0,0,,Więc chcesz zrobić to za mnie?
Dialogue: 0,0:03:32.29,0:03:34.69,Default,Subaru,0,0,0,,Nie! Nie stawiaj czoła\Nprzeszłości, jeśli...
Dialogue: 0,0:03:34.78,0:03:38.12,Default,Emilia,0,0,0,,Ale jeśli się z nią nie zmierzę, nigdy nie\Nprzejdę próby!
Dialogue: 0,0:03:38.21,0:03:40.07,Default,Emilia,0,0,0,,Jeśli odwrócę wzrok od przykrości,
Dialogue: 0,0:03:40.16,0:03:42.20,Default,Emilia,0,0,0,,zostawię wszystko tobie i ucieknę...
Dialogue: 0,0:03:42.63,0:03:45.66,Default,Emilia,0,0,0,,Co wtedy mi zostanie?
Dialogue: 0,0:03:49.52,0:03:50.92,Default,Ram,0,0,0,,Przestańmy o tym mówić.
Dialogue: 0,0:03:52.92,0:03:54.04,Default,Subaru,0,0,0,,Masz chwilę?
Dialogue: 0,0:03:54.55,0:03:58.60,Default,Subaru,0,0,0,,Dlaczego tak stanowczo sprzeciwiłeś się\Nmojej propozycji?
Dialogue: 0,0:03:58.69,0:03:59.57,Default,Garfiel,0,0,0,,Bo...
Dialogue: 0,0:03:59.66,0:04:02.23,Default,Ryuzu,0,0,0,,Bo tego chce Młody Ros.
Dialogue: 0,0:04:02.91,0:04:08.38,Default,Ryuzu,0,0,0,,Młody Ros uważa, że to Emilia powinna\Nwyzwolić Sanktuarium.
Dialogue: 0,0:04:08.47,0:04:11.89,Default,Subaru,0,0,0,,I wy go w tym popieracie?
Dialogue: 0,0:04:11.98,0:04:13.35,Default,Garfiel,0,0,0,,Nie zrozum mnie źle!
Dialogue: 0,0:04:13.44,0:04:16.24,Default,Garfiel,0,0,0,,Nienawidzę tego sukinsyna tak samo jak ty.
Dialogue: 0,0:04:16.33,0:04:18.98,Default,Garfiel,0,0,0,,Ale... rozumiesz, prawda?!
Dialogue: 0,0:04:19.79,0:04:20.95,Default,Subaru,0,0,0,,Chyba...
Dialogue: 0,0:04:21.04,0:04:24.74,Default,,0,0,0,,Nawet gdy bariera zniknie, a Sanktuarium\Nstanie się częścią jego ziem...
Dialogue: 0,0:04:24.83,0:04:27.63,Default,Ryuzu,0,0,0,,Nadzór nad tą ziemią sprawuje Młody Ros.
Dialogue: 0,0:04:27.72,0:04:30.87,Default,Ryuzu,0,0,0,,Nikt z nas nie chce się mu sprzeciwić i\Nnarazić naszej pozycji.
Dialogue: 0,0:04:31.00,0:04:33.46,Default,Ryuzu,0,0,0,,Mam nadzieję, że ty i inni\Nwiecie, że mi przykro.
Dialogue: 0,0:04:33.66,0:04:37.88,Default,Subaru,0,0,0,,Coraz trudniej mi jest\Nufać Roswaalowi.
Dialogue: 0,0:04:38.08,0:04:41.31,Default,Garfiel,0,0,0,,W każdym razie to księżniczka musi przejść\Npróbę!
Dialogue: 0,0:04:41.40,0:04:45.34,Default,Garfiel,0,0,0,,Nawet jeśli {\i1}jesteś{\i0} wykwalifikowany,\Nnie pozwolę ci tego zrobić!
Dialogue: 0,0:04:49.14,0:04:51.55,Default,Subaru,0,0,0,,Cholera, Emilia...
Dialogue: 0,0:04:52.72,0:04:54.45,Default - italics,Subaru,0,0,0,,Nie, spokojnie.
Dialogue: 0,0:04:54.54,0:04:56.79,Default - italics,Subaru,0,0,0,,Muszę się dowiedzieć,\Nco zrobić z rezydencją.
Dialogue: 0,0:04:57.87,0:05:02.78,Default - italics,Subaru,0,0,0,,Ta szalona kobieta na pewno coś zrobi Rem\Ni nowym pokojówkom.
Dialogue: 0,0:05:03.44,0:05:05.48,Default - italics,Subaru,0,0,0,,Martwię się o Fredericę.
Dialogue: 0,0:05:05.57,0:05:08.24,Default - italics,Subaru,0,0,0,,Czy ona ma jakieś więzi z Elsą?
Dialogue: 0,0:05:09.28,0:05:13.45,Default - italics,Subaru,0,0,0,,W każdym razie, muszę wrócić do\Nposiadłości tak szybko jak to możliwe.
Dialogue: 0,0:05:15.03,0:05:19.17,Default,Roswaal,0,0,0,,A co chciałbyś, żebym zrobił?
Dialogue: 0,0:05:19.44,0:05:21.76,Default,Subaru,0,0,0,,Zabierz mieszkańców Arlam z powrotem do\Ndomu.
Dialogue: 0,0:05:22.28,0:05:25.73,Default,Subaru,0,0,0,,Chcę, żebyś przedstawił tę\Npropozycję Ryuzu i reszcie.
Dialogue: 0,0:05:26.45,0:05:31.11,Default,Subaru,0,0,0,,Nie wygląda na to, że tym razem\Nuda mi się ich przekonać.
Dialogue: 0,0:05:31.78,0:05:32.80,Default,Roswaal,0,0,0,,"Tym razem"?
Dialogue: 0,0:05:33.92,0:05:35.85,Default,Roswaal,0,0,0,,A dlaczego?
Dialogue: 0,0:05:36.05,0:05:39.86,Default,Subaru,0,0,0,,Ten Garfiel chyba mnie nienawidzi.
Dialogue: 0,0:05:40.26,0:05:43.13,Default,Subaru,0,0,0,,Nie mam czasu przekonywać\Nkogoś tak zmiennego jak on.
Dialogue: 0,0:05:43.97,0:05:45.57,Default,Subaru,0,0,0,,I jeszcze jedno.
Dialogue: 0,0:05:45.71,0:05:48.11,Default,Subaru,0,0,0,,Chcę powiedzieć ludziom, którzy zostali w\NArlam,
Dialogue: 0,0:05:48.20,0:05:50.03,Default,Subaru,0,0,0,,że ich rodziny są bezpieczne.
Dialogue: 0,0:05:50.56,0:05:52.79,Default,Subaru,0,0,0,,Wracam tam sam, żeby im to powiedzieć.
Dialogue: 0,0:05:53.43,0:05:57.41,Default,Subaru,0,0,0,,Oczywiście, idę też do rezydencji,\Ngdzie Frederica coś planuje.
Dialogue: 0,0:05:57.50,0:05:59.78,Default,Roswaal,0,0,0,,Ram mnie o tym poinformowała.
Dialogue: 0,0:05:59.87,0:06:02.95,Default,Roswaal,0,0,0,,Ale znając ją, Frederica\Nnie działałaby pochopnie...
Dialogue: 0,0:06:03.04,0:06:04.46,Default,Subaru,0,0,0,,I co ty wiesz?
Dialogue: 0,0:06:04.81,0:06:07.39,Default,Subaru,0,0,0,,Frederica dała Emilii świecący kamień.
Dialogue: 0,0:06:07.48,0:06:09.68,Default,Subaru,0,0,0,,To dowód, że coś planuje!
Dialogue: 0,0:06:12.93,0:06:16.31,Default,Roswaal,0,0,0,,A jeśli okaże się\Nwrogiem, co zrobisz?
Dialogue: 0,0:06:16.94,0:06:20.13,Default,Roswaal,0,0,0,,Przykro mi to mówić, ale nie\Nmasz szans przeciwko niej.
Dialogue: 0,0:06:21.15,0:06:24.90,Default,Subaru,0,0,0,,Emilia zajmuje się barierą,\Nty jesteś ranny,
Dialogue: 0,0:06:24.99,0:06:26.82,Default,Subaru,0,0,0,,a Otto nie chce w tym uczestniczyć.
Dialogue: 0,0:06:27.04,0:06:27.99,Default,Subaru,0,0,0,,Utknęliśmy.
Dialogue: 0,0:06:28.08,0:06:31.05,Default,Roswaal,0,0,0,,To prawda, z wyjątkiem jednej osoby.
Dialogue: 0,0:06:32.31,0:06:34.40,Default,Ram,0,0,0,,Mi się to nie podoba.
Dialogue: 0,0:06:34.49,0:06:37.52,Default,Subaru,0,0,0,,Nadal tak mówisz, Nee?
Dialogue: 0,0:06:37.61,0:06:40.27,Default,Ram,0,0,0,,Gdy Roswaal jest w takim stanie,
Dialogue: 0,0:06:40.36,0:06:42.67,Default,Ram,0,0,0,,Nie lubię opuszczać jego boku.
Dialogue: 0,0:06:42.92,0:06:46.28,Default,Subaru,0,0,0,,Tak, ale nie możesz zrobić\Ndla niego nic, prawda?
Dialogue: 0,0:06:46.37,0:06:49.82,Default,Subaru,0,0,0,,Nie mogłem uwierzyć, kiedy usłyszałem,\Nże Garfiel założył mu bandaże.
Dialogue: 0,0:06:49.92,0:06:51.25,Default,Ram,0,0,0,,Nie bądź głupi.
Dialogue: 0,0:06:51.34,0:06:54.43,Default,Ram,0,0,0,,A gdybym je nałożyła\Ni tylko pogorszyła jego rany?
Dialogue: 0,0:06:54.72,0:06:56.03,Default,Subaru,0,0,0,,Okaż choć trochę skruchy!
Dialogue: 0,0:06:56.12,0:06:59.68,Default,Garfiel,0,0,0,,Wracasz triumfalnie z ładną\Ndziewczyną na każdym ramieniu?
Dialogue: 0,0:06:59.77,0:07:01.85,Default,Garfiel,0,0,0,,Masz naprawdę odwagę, wiesz o tym?
Dialogue: 0,0:07:02.21,0:07:05.75,Default,Subaru,0,0,0,,Nie spodziewałem się, że tak wcześnie\Nrano przyjdziesz mnie pożegnać.
Dialogue: 0,0:07:05.84,0:07:06.73,Default,Subaru,0,0,0,,Słyszałeś?
Dialogue: 0,0:07:07.05,0:07:11.58,Default,Garfiel,0,0,0,,Szczerze mówiąc, wkurza mnie to,\Nże wszystko zostało zdecydowane beze mnie,
Dialogue: 0,0:07:11.67,0:07:13.17,Default,Garfiel,0,0,0,,ale nie będę z tym walczył.
Dialogue: 0,0:07:13.46,0:07:16.07,Default,Subaru,0,0,0,,Dobrze wiedzieć.
Dialogue: 0,0:07:16.16,0:07:17.85,Default,Subaru,0,0,0,,Gdybyś próbował mnie powstrzymać,
Dialogue: 0,0:07:17.94,0:07:20.69,Default,Subaru,0,0,0,,musiałbym wyrzucić Ram w dal jako\Nprzynętę.
Dialogue: 0,0:07:20.78,0:07:22.70,Default,Garfiel,0,0,0,,Jakby to nawet działało!
Dialogue: 0,0:07:23.24,0:07:24.12,Default,Garfiel,0,0,0,,Czyżby?
Dialogue: 0,0:07:24.21,0:07:25.22,Default,Subaru,0,0,0,,Skąd mam wiedzieć?!
Dialogue: 0,0:07:25.31,0:07:27.02,Default,Subaru,0,0,0,,Powinieneś coś powiedzieć...
Dialogue: 0,0:07:29.13,0:07:30.63,Default,Subaru,0,0,0,,Ram, co się stało?
Dialogue: 0,0:07:31.01,0:07:33.54,Default,Ram,0,0,0,,Ta głupia rozmowa sprawiła,\Nże boli mnie głowa.
Dialogue: 0,0:07:35.56,0:07:36.89,Default,Subaru,0,0,0,,No to wychodzę.
Dialogue: 0,0:07:37.42,0:07:40.54,Default,Subaru,0,0,0,,Wrócę jutro, więc do tego czasu pilnuj\Nwszystkiego.
Dialogue: 0,0:07:40.63,0:07:43.40,Default,Garfiel,0,0,0,,Nie pożegnasz się z księżniczką?
Dialogue: 0,0:07:43.68,0:07:47.03,Default,Subaru,0,0,0,,Dziwię się, że naprawdę martwisz się o\NEmilię.
Dialogue: 0,0:07:47.12,0:07:50.14,Default,Subaru,0,0,0,,Ale nic się nie stało,\Nzostawiłem jej list.
Dialogue: 0,0:07:53.16,0:07:55.74,Default,Subaru,0,0,0,,Swoją drogą, nie masz niczego dla mnie?
Dialogue: 0,0:07:56.26,0:07:57.99,Default,Garfiel,0,0,0,,O czym ty mówisz?
Dialogue: 0,0:07:59.89,0:08:02.37,Default,Ram,0,0,0,,Więc może okażesz mi trochę troski?
Dialogue: 0,0:08:02.65,0:08:05.35,Default,Ram,0,0,0,,Kobieta, którą kochasz, rusza wypełnić\Nswój obowiązek.
Dialogue: 0,0:08:05.44,0:08:07.50,Default,Ram,0,0,0,,Nie chcesz jej pomóc?
Dialogue: 0,0:08:08.52,0:08:12.22,Default,Garfiel,0,0,0,,Jesteś miła tylko wtedy, gdy\Ncoś z tego wyciągniesz, prawda?
Dialogue: 0,0:08:12.67,0:08:13.85,Default,Garfiel,0,0,0,,Masz!
Dialogue: 0,0:08:15.45,0:08:16.78,Default,Subaru,0,0,0,,Zajmij się Emilią.
Dialogue: 0,0:08:16.87,0:08:20.61,Default,Subaru,0,0,0,,Zrób co w twojej mocy, żeby wiedziała,\Nże przepraszam z głębi serca!
Dialogue: 0,0:08:20.70,0:08:24.10,Default,Garfiel,0,0,0,,Powiedz jej to sam, do cholery!
Dialogue: 0,0:08:26.84,0:08:28.02,Default,Ram,0,0,0,,Więc, Barusu...
Dialogue: 0,0:08:28.39,0:08:30.73,Default,Ram,0,0,0,,Czy ta rzecz od Garfa nam się przyda?
Dialogue: 0,0:08:31.04,0:08:32.09,Default,Subaru,0,0,0,,Nie wiem.
Dialogue: 0,0:08:32.18,0:08:35.19,Default,Subaru,0,0,0,,Znasz go dłużej niż ja.
Dialogue: 0,0:08:35.28,0:08:36.99,Default,Ram,0,0,0,,Właściwie to nie mam pojęcia.
Dialogue: 0,0:08:37.41,0:08:39.38,Default,Ram,0,0,0,,Ponieważ jest częścią pasującej pary,
Dialogue: 0,0:08:39.47,0:08:41.52,Default,Ram,0,0,0,,Jestem pewna, że coś dla niego znaczy.
Dialogue: 0,0:08:44.81,0:08:47.46,Default,Subaru,0,0,0,,Wyglądasz dziś dość nieszczęśliwie.
Dialogue: 0,0:08:48.84,0:08:50.05,Default,Ram,0,0,0,,To co powiedziałeś...
Dialogue: 0,0:08:51.17,0:08:54.01,Default,Ram,0,0,0,,Kiedy powiedziałeś,\Nże rzucisz mnie jako przynętę.
Dialogue: 0,0:08:54.28,0:08:57.63,Default,Ram,0,0,0,,Z jakiegoś powodu to mnie bardziej\Nniepokoiło niż się spodziewałam.
Dialogue: 0,0:08:58.00,0:08:58.88,Default,Ram,0,0,0,,Prawie jakby...
Dialogue: 0,0:09:00.08,0:09:02.59,Default,Ram,0,0,0,,Coś takiego zdarzyło się już wcześniej.
Dialogue: 0,0:09:11.36,0:09:12.24,Default,Ram,0,0,0,,Barusu?
Dialogue: 0,0:09:13.05,0:09:15.98,Default,Subaru,0,0,0,,Ram, muszę ci coś ważnego\Npowiedzieć.
Dialogue: 0,0:09:16.87,0:09:19.82,Default,Subaru,0,0,0,,O czymś dla ciebie najważniejszym.
Dialogue: 0,0:09:21.07,0:09:24.16,Default,Ram,0,0,0,,Jedyną rzeczą, która jest dla\Nmnie ważna jest Roswaal-sama.
Dialogue: 0,0:09:24.25,0:09:25.78,Default,Subaru,0,0,0,,Nie, jest coś jeszcze.
Dialogue: 0,0:09:27.00,0:09:29.75,Default,Subaru,0,0,0,,Więc ci o tym opowiem.
Dialogue: 0,0:09:32.30,0:09:34.48,Default,Subaru,0,0,0,,Jest dziewczyna o imieniu Rem...
Dialogue: 0,0:09:41.72,0:09:44.04,Default - italics,Subaru,0,0,0,,Proszę, nie pozwól, żeby coś się stało.
Dialogue: 0,0:09:44.48,0:09:46.56,Default - italics,Subaru,0,0,0,,Jestem tu dwa dni wcześniej niż ostatnio.
Dialogue: 0,0:09:47.04,0:09:48.31,Default - italics,Subaru,0,0,0,,Jeśli nadal pójdzie źle,
Dialogue: 0,0:09:48.40,0:09:52.63,Default - italics,Subaru,0,0,0,,Będę musiał wyjechać na Patrasche w\Nmomencie, gdy obudzę się na cmentarzu.
Dialogue: 0,0:09:53.26,0:09:55.69,Default - italics,Subaru,0,0,0,,Jeśli Frederica okaże się wrogiem,
Dialogue: 0,0:09:55.78,0:09:58.44,Default - italics,Subaru,0,0,0,,To ważne, żeby wiedzieć,\Nkiedy podejmie działania.
Dialogue: 0,0:09:58.53,0:09:59.41,Default,Ram,0,0,0,,Barusu?
Dialogue: 0,0:09:59.50,0:10:00.99,Default - italics,Subaru,0,0,0,,Zaatakować czy uciekać?
Dialogue: 0,0:10:01.08,0:10:04.48,Default - italics,Subaru,0,0,0,,Jeśli mam do czynienia z Elsą,\Nlepiej wziąć nogi za pas.
Dialogue: 0,0:10:04.57,0:10:05.55,Default - italics,Subaru,0,0,0,,Co oznacza...
Dialogue: 0,0:10:05.64,0:10:06.62,Default,Ram,0,0,0,,Barusu!
Dialogue: 0,0:10:06.86,0:10:10.29,Default,Subaru,0,0,0,,Myślałem o...
Dialogue: 0,0:10:12.18,0:10:14.60,Default,Petra,0,0,0,,Witaj z powrotem, Subaru.
Dialogue: 0,0:10:15.13,0:10:18.01,Default,Petra,0,0,0,,Wróciłeś znacznie wcześniej\Nniż się spodziewałam.
Dialogue: 0,0:10:21.36,0:10:23.16,Default,Petra,0,0,0,,Czy coś jest nie tak, Subaru?
Dialogue: 0,0:10:23.75,0:10:27.52,Default,Subaru,0,0,0,,Jesteś taka słodka!
Dialogue: 0,0:10:27.72,0:10:29.59,Default,Petra,0,0,0,,Co to jest? Subaru!
Dialogue: 0,0:10:29.68,0:10:33.54,Default,Subaru,0,0,0,,Cholera! Nie masz pojęcia, przez co\Nprzeszedłem!
Dialogue: 0,0:10:34.32,0:10:36.31,Default,Subaru,0,0,0,,Poważnie... do cholery...
Dialogue: 0,0:10:39.13,0:10:40.03,Default,Subaru,0,0,0,,Czy to...
Dialogue: 0,0:10:40.12,0:10:42.50,Default,Petra,0,0,0,,To pasuje do tego, który ci dałam.
Dialogue: 0,0:10:49.44,0:10:50.92,Default,Petra,0,0,0,,Jesteś ranny?
Dialogue: 0,0:10:54.22,0:10:55.10,Default,Subaru,0,0,0,,Nie.
Dialogue: 0,0:10:55.86,0:10:59.01,Default,Subaru,0,0,0,,Po prostu czuję ogromną ulgę, z głębi\Nserca.
Dialogue: 0,0:11:00.48,0:11:02.47,Default,Subaru,0,0,0,,Dobrze jest wrócić, Petra.
Dialogue: 0,0:11:02.87,0:11:05.01,Default,Ram,0,0,0,,Mi się to nie podoba.
Dialogue: 0,0:11:05.10,0:11:07.15,Default,Subaru,0,0,0,,Czuję się jakbym słyszał to wcześniej...
Dialogue: 0,0:11:07.24,0:11:08.72,Default,Ram,0,0,0,,Tak, bo to był sarkazm.
Dialogue: 0,0:11:08.99,0:11:12.75,Default,Ram,0,0,0,,Uroczy sarkazm zapomnianej Ram,\Npozostawionej samej sobie.
Dialogue: 0,0:11:13.39,0:11:16.22,Default,Petra,0,0,0,,Jesteś Ram-Neesama, prawda?
Dialogue: 0,0:11:17.14,0:11:20.90,Default,Petra,0,0,0,,Właśnie zostałam zatrudniona jako nowa\Npokojówka w służbie pana rezydencji.
Dialogue: 0,0:11:20.99,0:11:22.03,Default,Petra,0,0,0,,Jestem Petra.
Dialogue: 0,0:11:22.51,0:11:24.12,Default,Petra,0,0,0,,Miło cię poznać.
Dialogue: 0,0:11:25.12,0:11:28.12,Default,Ram,0,0,0,,W przeciwieństwie do Barusu wydajesz się\Nznać swoje miejsce.
Dialogue: 0,0:11:28.21,0:11:30.08,Default,Ram,0,0,0,,Bardzo dobrze. Zaliczyłaś.
Dialogue: 0,0:11:30.63,0:11:32.53,Default,Ram,0,0,0,,A ty, Barusu, oblałeś.
Dialogue: 0,0:11:32.62,0:11:34.64,Default,Ram,0,0,0,,Nie pozwolę ci przekroczyć progu.
Dialogue: 0,0:11:34.73,0:11:37.09,Default,Subaru,0,0,0,,Jaki był więc sens powrotu?
Dialogue: 0,0:11:38.81,0:11:43.04,Default,Subaru,0,0,0,,Hej, Petra... Czy coś dziwnego\Nsię stało, kiedy nas nie było?
Dialogue: 0,0:11:43.13,0:11:44.42,Default,Subaru,0,0,0,,Z Fredericą?
Dialogue: 0,0:11:44.51,0:11:46.20,Default,Petra,0,0,0,,Frederica-neesama?
Dialogue: 0,0:11:46.64,0:11:48.47,Default,Petra,0,0,0,,Nie ma w niej nic dziwnego.
Dialogue: 0,0:11:48.66,0:11:50.11,Default,Subaru,0,0,0,,Jest teraz w środku?
Dialogue: 0,0:11:50.20,0:11:52.40,Default,Petra,0,0,0,,Patroluje leśną barierę.
Dialogue: 0,0:11:52.49,0:11:54.61,Default,Petra,0,0,0,,Może to potrwać trochę zanim wróci.
Dialogue: 0,0:11:54.70,0:11:56.81,Default,Ram,0,0,0,,Nie wiem, czy trafiliśmy w dobry moment.
Dialogue: 0,0:11:56.90,0:11:58.58,Default,Ram,0,0,0,,Co mamy zrobić, Barusu?
Dialogue: 0,0:12:00.01,0:12:01.63,Default,Subaru,0,0,0,,Chcę zobaczyć, co zrobi.
Dialogue: 0,0:12:01.72,0:12:03.42,Default,Subaru,0,0,0,,W międzyczasie zaczekamy przy Rem.
Dialogue: 0,0:12:11.88,0:12:14.29,Default,Petra,0,0,0,,Wracam do sprzątania.
Dialogue: 0,0:12:14.38,0:12:16.26,Default,Petra,0,0,0,,W razie potrzeby zawołaj mnie.
Dialogue: 0,0:12:20.35,0:12:21.80,Default,Subaru,0,0,0,,Jesteś zdenerwowana, co?
Dialogue: 0,0:12:21.89,0:12:23.06,Default,Ram,0,0,0,,Nie jestem.
Dialogue: 0,0:12:23.15,0:12:25.01,Default,Subaru,0,0,0,,Powinnaś.
Dialogue: 0,0:12:25.10,0:12:28.10,Default,Subaru,0,0,0,,To właściwa reakcja. Właśnie tego chcę.
Dialogue: 0,0:12:34.52,0:12:36.14,Default,Subaru,0,0,0,,Cieszę się, że nic ci nie jest.
Dialogue: 0,0:12:42.95,0:12:43.83,Default,Ram,0,0,0,,Barusu...
Dialogue: 0,0:12:44.53,0:12:45.41,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:12:45.72,0:12:47.78,Default,Ram,0,0,0,,Możesz nas na chwilę zostawić?
Dialogue: 0,0:13:00.12,0:13:01.34,Default,Subaru,0,0,0,,To początek...
Dialogue: 0,0:13:02.18,0:13:03.59,Default,Subaru,0,0,0,,To początek.
Dialogue: 0,0:13:03.68,0:13:06.68,Default,Frederica,0,0,0,,Wróciłeś wcześniej niż się\Nspodziewałam, Subaru.
Dialogue: 0,0:13:07.92,0:13:09.64,Default,Frederica,0,0,0,,Co za niespodzianka.
Dialogue: 0,0:13:13.76,0:13:16.89,Default,Frederica,0,0,0,,Skoro Emilia nie jest z tobą,
Dialogue: 0,0:13:16.98,0:13:19.43,Default,Frederica,0,0,0,,Zakładam, że próba nie została jeszcze\Nukończona?
Dialogue: 0,0:13:20.00,0:13:20.88,Default,Subaru,0,0,0,,Tak.
Dialogue: 0,0:13:21.28,0:13:23.98,Default,Subaru,0,0,0,,Chciałbym cię o coś zapytać.
Dialogue: 0,0:13:24.07,0:13:25.65,Default,Subaru,0,0,0,,Najpierw o tym.
Dialogue: 0,0:13:29.99,0:13:30.87,Default,Frederica,0,0,0,,To jest...
Dialogue: 0,0:13:35.56,0:13:38.15,Default,Frederica,0,0,0,,Kamień Garfa.
Dialogue: 0,0:13:38.24,0:13:40.31,Default,Subaru,0,0,0,,Więc naprawdę go znasz...
Dialogue: 0,0:13:40.40,0:13:42.67,Default,,0,0,0,,Naprawdę jesteście spokrewnieni?
Dialogue: 0,0:13:42.76,0:13:45.42,Default,Frederica,0,0,0,,Garf nie powiedział ci tego osobiście?
Dialogue: 0,0:13:45.51,0:13:47.50,Default,Subaru,0,0,0,,Łatwo się domyślić po waszych twarzach.
Dialogue: 0,0:13:47.88,0:13:50.35,Default,Subaru,0,0,0,,A ty jesteś chyba starszą siostrą.
Dialogue: 0,0:13:51.52,0:13:52.86,Default,Frederica,0,0,0,,Masz rację.
Dialogue: 0,0:13:54.50,0:13:56.18,Default,Frederica,0,0,0,,Jestem siostrą Garfa...
Dialogue: 0,0:13:57.19,0:14:00.69,Default,Frederica,0,0,0,,starszą, rodzoną siostrą Garfiela.
Dialogue: 0,0:14:03.66,0:14:04.94,Default,Subaru,0,0,0,,Odpowiedz mi.
Dialogue: 0,0:14:05.03,0:14:07.39,Default,,0,0,0,,Dlaczego użyłaś świecącego kamienia,
Dialogue: 0,0:14:07.48,0:14:09.23,Default,Subaru,0,0,0,,by zastawić pułapkę teleportacyjną?
Dialogue: 0,0:14:11.60,0:14:14.05,Default,Subaru,0,0,0,,Nie możesz mi tego powiedzieć\Nz powodu przysięgi?
Dialogue: 0,0:14:14.40,0:14:15.95,Default,Subaru,0,0,0,,To jedna rzecz, którą musisz...
Dialogue: 0,0:14:16.04,0:14:17.26,Default,Frederica,0,0,0,,Subaru...
Dialogue: 0,0:14:17.78,0:14:19.96,Default,Frederica,0,0,0,,Co masz na myśli mówiąc "teleportować"?
Dialogue: 0,0:14:22.23,0:14:24.51,Default,Frederica,0,0,0,,Nie wiem, jak odpowiedzieć\Nna to spojrzenie.
Dialogue: 0,0:14:24.60,0:14:26.33,Default,Subaru,0,0,0,,Czekaj! Czekaj, czekaj!
Dialogue: 0,0:14:26.42,0:14:27.49,Default,Subaru,0,0,0,,Nie oszukasz mnie!
Dialogue: 0,0:14:27.58,0:14:31.42,Default,Subaru,0,0,0,,Wiem, że wspierasz konserwatystów\Nprzeciwnych uwolnieniu Sanktuarium!
Dialogue: 0,0:14:31.51,0:14:34.22,Default,Frederica,0,0,0,,Konserwatyści? Nie wiem, o czym mówisz.
Dialogue: 0,0:14:34.76,0:14:37.18,Default,Frederica,0,0,0,,Musisz wszystko wyjaśnić\Nod początku...
Dialogue: 0,0:14:37.38,0:14:40.77,Default,Subaru,0,0,0,,N-Naprawdę nie udajesz ani nie dajesz\Nznaków?
Dialogue: 0,0:14:40.86,0:14:43.32,Default,Ram,0,0,0,,Spędzać czas z Fredericą\Nw mojej nieobecności?
Dialogue: 0,0:14:43.84,0:14:46.69,Default,Ram,0,0,0,,Wygląda na to, że nie potrzebujesz\Nswojego życia, Barusu.
Dialogue: 0,0:14:47.02,0:14:48.49,Default,Subaru,0,0,0,,Nie, ja...
Dialogue: 0,0:14:52.64,0:14:56.45,Default,Ram,0,0,0,,Widzę, że twoje umiejętności w\Nrobieniu herbaty nie poprawiły się.
Dialogue: 0,0:14:56.76,0:15:00.29,Default,Frederica,0,0,0,,Ale robienie herbaty to jedyna\Nrzecz, w której się wyróżniam.
Dialogue: 0,0:15:00.38,0:15:01.83,Default,Frederica,0,0,0,,Jesteś nie do pokochania.
Dialogue: 0,0:15:02.15,0:15:04.10,Default,Ram,0,0,0,,Jestem całkiem urocza.
Dialogue: 0,0:15:04.40,0:15:06.47,Default,Ram,0,0,0,,Gdybym była milsza, świat by ucierpiał.
Dialogue: 0,0:15:06.56,0:15:09.23,Default,Frederica,0,0,0,,Zawsze masz gotową ciętą ripostę.
Dialogue: 0,0:15:09.32,0:15:10.20,Default,Frederica,0,0,0,,Szczerze...
Dialogue: 0,0:15:10.63,0:15:12.20,Default,Frederica,0,0,0,,Cała ty.
Dialogue: 0,0:15:12.29,0:15:13.17,Default,Ram,0,0,0,,A co?
Dialogue: 0,0:15:13.84,0:15:17.60,Default,Ram,0,0,0,,Skoro nie wiesz o teleportacji, dlaczego\Ndałaś Barusu świecący kamień?
Dialogue: 0,0:15:17.69,0:15:18.78,Default,Frederica,0,0,0,,Cóż...
Dialogue: 0,0:15:18.87,0:15:21.48,Default,Ram,0,0,0,,Nie możesz nam powiedzieć\Nz powodu twojej przysięgi?
Dialogue: 0,0:15:21.78,0:15:24.19,Default,Ram,0,0,0,,Jeśli tak, to żałosna wymówka, Frederica.
Dialogue: 0,0:15:25.76,0:15:27.31,Default,Frederica,0,0,0,,Masz rację.
Dialogue: 0,0:15:27.40,0:15:30.03,Default,Frederica,0,0,0,,Nic ci nie mogę powiedzieć.
Dialogue: 0,0:15:30.30,0:15:31.99,Default,Ram,0,0,0,,Trzymasz się swojej wymówki.
Dialogue: 0,0:15:32.08,0:15:34.09,Default,Ram,0,0,0,,Więc nie ma o czym więcej rozmawiać.
Dialogue: 0,0:15:34.18,0:15:35.37,Default,Subaru,0,0,0,,Hej, spokojnie!
Dialogue: 0,0:15:35.46,0:15:38.50,Default,Ram,0,0,0,,Odmowa odpowiedzi na pytanie\Nczyni twoją zdradę jasną.
Dialogue: 0,0:15:38.82,0:15:41.46,Default,Ram,0,0,0,,Zatrzymamy cię i\Nzabierzemy do Sanktuarium.
Dialogue: 0,0:15:42.12,0:15:45.87,Default,Ram,0,0,0,,Wtedy dowiemy się,\Nkto dawał ci rozkazy.
Dialogue: 0,0:15:45.96,0:15:47.27,Default,Subaru,0,0,0,,Tak, ale...
Dialogue: 0,0:15:47.36,0:15:50.91,Default,Frederica,0,0,0,,Jeśli nalegacie, by zabrać mnie do\NSanktuarium, nie będę się opierać.
Dialogue: 0,0:15:51.00,0:15:53.05,Default,Subaru,0,0,0,,Widzisz? Nawet Frederica...
Dialogue: 0,0:15:53.57,0:15:54.45,Default,Subaru,0,0,0,,Czekaj. Co?
Dialogue: 0,0:15:54.54,0:15:57.30,Default,Frederica,0,0,0,,Powiedziałam, że nie będę się opierać.
Dialogue: 0,0:15:57.39,0:15:59.14,Default,Subaru,0,0,0,,Nie będziesz?
Dialogue: 0,0:15:59.69,0:16:00.57,Default,Subaru,0,0,0,,Dlaczego?!
Dialogue: 0,0:16:00.66,0:16:02.33,Default,Ram,0,0,0,,Strasznie wolno kojarzysz.
Dialogue: 0,0:16:02.50,0:16:05.55,Default,Ram,0,0,0,,Frederica nie może złamać swojej\Nprzysięgi z własnej woli.
Dialogue: 0,0:16:05.64,0:16:08.36,Default,Ram,0,0,0,,Więc będziesz musiał użyć siły,\Naby ją zmusić, Barusu.
Dialogue: 0,0:16:09.36,0:16:11.39,Default,Ram,0,0,0,,To jest wymówka, której potrzebuje.
Dialogue: 0,0:16:14.41,0:16:16.63,Default,Subaru,0,0,0,,Jesteście w idealnej synchronizacji.
Dialogue: 0,0:16:16.72,0:16:17.92,Default,Frederica,0,0,0,,Oczywiście.
Dialogue: 0,0:16:18.01,0:16:19.91,Default,Ram,0,0,0,,Znamy się od prawie 10 lat.
Dialogue: 0,0:16:20.88,0:16:23.75,Default,Subaru,0,0,0,,Jeśli to wszystko, co trzeba,\Nszczerze mówiąc, to ulga.
Dialogue: 0,0:16:23.84,0:16:25.52,Default,Subaru,0,0,0,,Chcę stąd jak najszybciej wyjść.
Dialogue: 0,0:16:25.68,0:16:26.56,Default,Elsa,0,0,0,,O mój Boże.
Dialogue: 0,0:16:26.67,0:16:29.80,Default,Elsa,0,0,0,,Wolałabym, żebyś nie mówił tak\Nnieprzyjaznych rzeczy.
Dialogue: 0,0:16:39.36,0:16:42.48,Default,Elsa,0,0,0,,Teraz dotrzymajmy naszej obietnicy.
Dialogue: 0,0:16:43.08,0:16:44.07,Default,Petra,0,0,0,,Nee-sama...
Dialogue: 0,0:16:44.16,0:16:45.20,Default,Petra,0,0,0,,Subaru...
Dialogue: 0,0:16:47.45,0:16:48.85,Default,Petra,0,0,0,,Uciekaj!
Dialogue: 0,0:16:48.94,0:16:50.19,Default,Ram,0,0,0,,El Fula!
Dialogue: 0,0:16:53.70,0:16:56.32,Default,Elsa,0,0,0,,Częściowa przemiana... Masz krew półludzi.
Dialogue: 0,0:16:56.51,0:16:57.39,Default,Frederica,0,0,0,,Petra!
Dialogue: 0,0:16:58.20,0:16:59.66,Default,Ram,0,0,0,,Roztrzaskam cię na strzępy!
Dialogue: 0,0:17:03.33,0:17:04.21,Default,Ram,0,0,0,,Jej ręka...
Dialogue: 0,0:17:04.36,0:17:06.42,Default,Elsa,0,0,0,,Boże, to bolało.
Dialogue: 0,0:17:08.64,0:17:10.21,Default,Elsa,0,0,0,,Myślałam, że już po mnie.
Dialogue: 0,0:17:11.11,0:17:12.45,Default,Elsa,0,0,0,,Podoba mi się.
Dialogue: 0,0:17:12.54,0:17:15.79,Default,Elsa,0,0,0,,Pokojówki w dużym, średnim i małym\Nrozmiarze oraz jeden chłopiec.
Dialogue: 0,0:17:16.45,0:17:19.79,Default,Elsa,0,0,0,,Położę was na stole i porównam,\Nco jest w waszych brzuchach.
Dialogue: 0,0:17:19.88,0:17:21.97,Default,Ram,0,0,0,,Nawet teksty Garfa są lepsze!
Dialogue: 0,0:17:22.06,0:17:22.94,Default,Ram,0,0,0,,Barusu!
Dialogue: 0,0:17:23.03,0:17:24.00,Default,Subaru,0,0,0,,Wiem!
Dialogue: 0,0:17:24.12,0:17:25.80,Default,Subaru,0,0,0,,Shamac!
Dialogue: 0,0:17:31.55,0:17:32.78,Default,Ram,0,0,0,,Wyjeżdżamy!
Dialogue: 0,0:17:33.35,0:17:34.23,Default,Petra,0,0,0,,Subaru!
Dialogue: 0,0:17:34.32,0:17:35.70,Default,Subaru,0,0,0,,Frederica!
Dialogue: 0,0:17:37.45,0:17:38.64,Default,Ram,0,0,0,,Ul Fula!
Dialogue: 0,0:17:45.49,0:17:46.91,Default,Petra,0,0,0,,Frederica-nee!
Dialogue: 0,0:17:47.85,0:17:49.83,Default,Frederica,0,0,0,,Nie doceniłam naszego przeciwnika.
Dialogue: 0,0:17:50.14,0:17:51.32,Default,Subaru,0,0,0,,Au...
Dialogue: 0,0:17:51.73,0:17:54.07,Default,Subaru,0,0,0,,Cholera... złapaliśmy ją?
Dialogue: 0,0:17:54.16,0:17:57.30,Default,Ram,0,0,0,,Nie poczułam trafienia. Kim ona była?
Dialogue: 0,0:17:58.00,0:18:00.33,Default,Subaru,0,0,0,,Rem, Beatrice...
Dialogue: 0,0:18:02.56,0:18:04.05,Default,Subaru,0,0,0,,Musimy je uratować.
Dialogue: 0,0:18:04.89,0:18:05.96,Default,Ram,0,0,0,,Zostawimy je tutaj.
Dialogue: 0,0:18:07.11,0:18:09.65,Default,Ram,0,0,0,,Cała nasza czwórka ucieknie, a je\Nzostawimy tutaj.
Dialogue: 0,0:18:10.25,0:18:12.01,Default,Ram,0,0,0,,To najlepsza opcja.
Dialogue: 0,0:18:13.04,0:18:14.72,Default,Subaru,0,0,0,,Co... czy ty...
Dialogue: 0,0:18:15.55,0:18:17.40,Default,Subaru,0,0,0,,Co ty mówisz?
Dialogue: 0,0:18:17.49,0:18:19.56,Default,Ram,0,0,0,,Co da ci krzyk? Uspokój się.
Dialogue: 0,0:18:19.65,0:18:22.31,Default,Subaru,0,0,0,,W rezydencji jest Rem! Twoja siostra!
Dialogue: 0,0:18:22.40,0:18:26.31,Default,Subaru,0,0,0,,Kochasz ją, a ona kocha ciebie! Musisz\Nchronić młodszą siostrę!
Dialogue: 0,0:18:26.40,0:18:28.15,Default,Ram,0,0,0,,Zrobiłam tylko odpowiedni osąd.
Dialogue: 0,0:18:28.24,0:18:33.35,Default,Ram,0,0,0,,Utrata ciebie wraz ze mną i Fredericą\Nbyłaby o wiele większa dla naszej strony.
Dialogue: 0,0:18:33.44,0:18:34.94,Default,Ram,0,0,0,,Trzeba ponieść ofiary.
Dialogue: 0,0:18:35.03,0:18:36.56,Default,Subaru,0,0,0,,Mówisz o poświęceniu...
Dialogue: 0,0:18:36.65,0:18:39.05,Default,Ram,0,0,0,,Tak, może jest moją młodszą siostrą.
Dialogue: 0,0:18:39.60,0:18:43.51,Default,Ram,0,0,0,,Czułam, że w niej płynie\Nta sama krew co we mnie.
Dialogue: 0,0:18:43.83,0:18:47.98,Default,Ram,0,0,0,,Ale jej samo istnienie jest puste.
Dialogue: 0,0:18:48.36,0:18:51.51,Default,Ram,0,0,0,,Ale jeśli to moja siostra,\Nto tak by powiedziała:
Dialogue: 0,0:18:53.04,0:18:57.25,Default,Ram,0,0,0,,„Poświęćcie mnie, żeby uratować Roswaala”.
Dialogue: 0,0:18:59.47,0:19:03.59,Default,Subaru,0,0,0,,Nie przyprowadziłem cię tutaj,\Nżeby cię zmusić do tego.
Dialogue: 0,0:19:03.68,0:19:07.37,Default,Frederica,0,0,0,,Uważam, że powinniśmy je ocalić.
Dialogue: 0,0:19:07.76,0:19:13.16,Default,Frederica,0,0,0,,Zarówno Beatrice, jak i Rem są ważne dla\Nnaszej strony.
Dialogue: 0,0:19:13.25,0:19:17.29,Default,Petra,0,0,0,,Myślę, że powinniśmy je też ocalić!
Dialogue: 0,0:19:17.38,0:19:18.72,Default,Petra,0,0,0,,Zgadzam się z nią!
Dialogue: 0,0:19:18.81,0:19:20.77,Default,Ram,0,0,0,,Nie będziemy głosować większością.
Dialogue: 0,0:19:20.86,0:19:22.09,Default,Ram,0,0,0,,Bądź cicho, dziecko.
Dialogue: 0,0:19:22.18,0:19:24.70,Default,Petra,0,0,0,,Może i jestem dzieckiem, ale jestem już\Ndorosła!
Dialogue: 0,0:19:24.79,0:19:28.44,Default,Petra,0,0,0,,Frederica-neesama nawet powiedziała,\Nże jestem bardziej przydatna niż ty!
Dialogue: 0,0:19:28.60,0:19:31.01,Default,Ram,0,0,0,,Frederica, co jej powiedziałaś?
Dialogue: 0,0:19:31.10,0:19:35.18,Default,Frederica,0,0,0,,Ponieważ to był mój pomysł, wezmę na\Nsiebie zadanie powstrzymania wroga.
Dialogue: 0,0:19:39.03,0:19:42.27,Default,Ram,0,0,0,,Więc celowo wybierasz,\Nby znowu wyciągnąć krótką słomkę.
Dialogue: 0,0:19:42.36,0:19:43.71,Default,Ram,0,0,0,,Jesteś jak Garf.
Dialogue: 0,0:19:43.80,0:19:46.96,Default,Frederica,0,0,0,,Jesteście moimi cennymi młodszymi\Nkoleżankami.
Dialogue: 0,0:19:47.05,0:19:49.83,Default,Frederica,0,0,0,,Nie jest też poprawne mówić,\Nże jestem "tak jak Garf".
Dialogue: 0,0:19:50.22,0:19:52.71,Default,Frederica,0,0,0,,Garf jest tym, który mnie naśladuje.
Dialogue: 0,0:20:05.15,0:20:07.01,Default,Subaru,0,0,0,,Więc to przemiana bestii?
Dialogue: 0,0:20:13.91,0:20:16.61,Default,Frederica,0,0,0,,Petra, przepraszam, że cię przestraszyłam.
Dialogue: 0,0:20:17.00,0:20:18.83,Default,Subaru,0,0,0,,Nadal możesz tak mówić?
Dialogue: 0,0:20:18.92,0:20:21.07,Default,Frederica,0,0,0,,W końcu nadal jestem sobą.
Dialogue: 0,0:20:21.45,0:20:24.21,Default,Frederica,0,0,0,,Wspaniale się spisałaś, powstrzymując\Nkrzyk.
Dialogue: 0,0:20:24.30,0:20:25.18,Default,Petra,0,0,0,,Tak...
Dialogue: 0,0:20:25.51,0:20:28.39,Default,Petra,0,0,0,,Tak! Proszę, uważaj na siebie!
Dialogue: 0,0:20:28.48,0:20:29.95,Default,Frederica,0,0,0,,Dobra dziewczyna.
Dialogue: 0,0:20:30.14,0:20:32.15,Default,Frederica,0,0,0,,Ram, pozostawiam resztę w twoich rękach.
Dialogue: 0,0:20:32.24,0:20:33.46,Default,Ram,0,0,0,,Nie przypominaj.
Dialogue: 0,0:20:34.00,0:20:36.92,Default,Ram,0,0,0,,Ale jeśli zostaniesz zbyt w tyle,\Nsprawię, że pożałujesz.
Dialogue: 0,0:20:44.03,0:20:45.05,Default,Ram,0,0,0,,Otrząśnij się!
Dialogue: 0,0:20:46.63,0:20:47.61,Default,Ram,0,0,0,,Chodźmy.
Dialogue: 0,0:20:47.70,0:20:50.30,Default,Subaru,0,0,0,,Dobrze... Zaczniemy od Rem.
Dialogue: 0,0:20:59.11,0:21:00.06,Default,Subaru,0,0,0,,To niedobrze...
Dialogue: 0,0:21:00.15,0:21:02.40,Default,Subaru,0,0,0,,Niedobrze. Niedobrze...
Dialogue: 0,0:21:03.81,0:21:05.46,Default,Subaru,0,0,0,,Musimy szybko dostać się na górę!
Dialogue: 0,0:21:18.33,0:21:19.71,Default,Subaru,0,0,0,,Bestia demoniczna?!
Dialogue: 0,0:21:22.60,0:21:23.51,Default,Petra,0,0,0,,Tędy!
Dialogue: 0,0:21:25.97,0:21:27.28,Default,Ram,0,0,0,,El Fula!
Dialogue: 0,0:21:28.06,0:21:29.41,Default,Subaru,0,0,0,,Skąd tu bestia demoniczna?!
Dialogue: 0,0:21:29.50,0:21:30.55,Default,Ram,0,0,0,,Nie czas na pytania.
Dialogue: 0,0:21:30.64,0:21:31.78,Default,Ram,0,0,0,,Jest tutaj i już!
Dialogue: 0,0:21:31.87,0:21:33.48,Default,Ram,0,0,0,,Pójdę po smoka ze stajni.
Dialogue: 0,0:21:33.57,0:21:34.92,Default,Subaru,0,0,0,,Masz na myśli Patrasche?
Dialogue: 0,0:21:35.34,0:21:38.59,Default,Ram,0,0,0,,Skoro jest tu bestia demoniczna, będziemy\Npotrzebować transportu.
Dialogue: 0,0:21:38.68,0:21:41.11,Default,Ram,0,0,0,,Zabierz je, a ja ją odciągnę.
Dialogue: 0,0:21:42.48,0:21:43.38,Default,Ram,0,0,0,,Fula!
Dialogue: 0,0:21:45.53,0:21:46.49,Default,Ram,0,0,0,,Za mną!
Dialogue: 0,0:21:58.04,0:22:00.32,Default,Subaru,0,0,0,,Dobrze... Teraz moja...
Dialogue: 0,0:22:02.00,0:22:03.06,Default,Petra,0,0,0,,Subaru?!
Dialogue: 0,0:22:04.17,0:22:05.23,Default,Petra,0,0,0,,Krwawisz!
Dialogue: 0,0:22:09.26,0:22:11.15,Default,Petra,0,0,0,,To będzie bolało! Wytrzymaj!
Dialogue: 0,0:22:11.24,0:22:12.72,Default,Petra,0,0,0,,Trzy, dwa...
Dialogue: 0,0:22:22.84,0:22:24.17,Default,Subaru,0,0,0,,Dziękuję.
Dialogue: 0,0:22:25.20,0:22:27.04,Default,Subaru,0,0,0,,Ale co się stało z „jeden”?
Dialogue: 0,0:22:27.13,0:22:29.30,Default,Petra,0,0,0,,Tak byłeś mniej zdenerwowany.
Dialogue: 0,0:22:31.77,0:22:33.83,Default,Subaru,0,0,0,,Petra... przepraszam.
Dialogue: 0,0:22:33.92,0:22:36.63,Default,Subaru,0,0,0,,Zawsze narażam cię na niebezpieczeństwo.
Dialogue: 0,0:22:36.72,0:22:40.12,Default,Petra,0,0,0,,Nie mów takich głupot! Jestem ci\Nwdzięczna!
Dialogue: 0,0:22:40.64,0:22:43.63,Default,Petra,0,0,0,,Zawsze mnie ratujesz,\Ngdy jestem w niebezpieczeństwie!
Dialogue: 0,0:22:44.00,0:22:45.93,Default,Petra,0,0,0,,Więc tym razem, to moja kolej.
Dialogue: 0,0:22:46.66,0:22:49.20,Default,Petra,0,0,0,,Zabierzemy stąd Rem i Beatrice,
Dialogue: 0,0:22:49.29,0:22:52.47,Default,Petra,0,0,0,,a potem wszyscy uciekniemy z Ram i\NFredericą!
Dialogue: 0,0:22:52.96,0:22:56.33,Default,Subaru,0,0,0,,Jesteś niesamowita, Petra. Czuję się taki\Nżałosny.
Dialogue: 0,0:22:56.42,0:22:57.30,Default,Petra,0,0,0,,Nie jesteś.
Dialogue: 0,0:22:57.39,0:22:59.40,Default,Subaru,0,0,0,,Nie, nie chciałem narzekać.
Dialogue: 0,0:22:59.69,0:23:02.69,Default,Subaru,0,0,0,,Muszę się bardziej starać, żeby być równie\Nwspaniały jak ty.
Dialogue: 0,0:23:05.07,0:23:06.04,Default,Subaru,0,0,0,,Chodźmy.
Dialogue: 0,0:23:06.13,0:23:08.78,Default,Subaru,0,0,0,,Jak powiedziałaś, wszyscy stąd wyjdziemy.
Dialogue: 0,0:23:10.68,0:23:11.56,Default,Petra,0,0,0,,Tak!
Dialogue: 0,0:23:19.01,0:23:19.89,Default,Petra,0,0,0,,Och!
Dialogue: 0,0:23:19.98,0:23:21.37,Default,Subaru,0,0,0,,Co?!
Dialogue: 0,0:23:21.72,0:23:24.21,Default,Petra,0,0,0,,Miałam na myśli „tak jest”, a nie „tak”!
Dialogue: 0,0:23:24.30,0:23:26.38,Default,Petra,0,0,0,,Właściwą odpowiedzią było „tak jest”!
Dialogue: 0,0:23:26.91,0:23:29.76,Default,Subaru,0,0,0,,Poproszę Fredericę albo Ram, żeby później\Ncię skarciła...
Dialogue: 0,0:23:34.35,0:23:35.72,Default,Ram,0,0,0,,Barusu!
Dialogue: 0,0:23:37.43,0:23:40.22,Default,Ram,0,0,0,,To był błąd. Powinnam była\Nsprawdzić wcześniej.
Dialogue: 0,0:23:40.31,0:23:42.72,Default,Ram,0,0,0,,Muszę zrobić to, co muszę.
Dialogue: 0,0:23:42.81,0:23:44.23,Default,Ram,0,0,0,,Ja też to zrobię.
Dialogue: 0,0:23:44.89,0:23:46.52,Default,Ram,0,0,0,,To wszystko.
Dialogue: 0,0:23:51.15,0:23:53.24,Default,Subaru,0,0,0,,Pa...trasche...
Dialogue: 0,0:24:14.48,0:24:16.39,Default,Subaru,0,0,0,,To... to...
Dialogue: 0,0:24:21.40,0:24:23.35,Default,Subaru,0,0,0,,Wszystko w porządku, Pet...
Dialogue: 0,0:24:53.67,0:24:57.10,Default,Elsa,0,0,0,,W końcu mnie znalazłeś!
Dialogue: 0,0:24:57.95,0:24:59.96,Default,Subaru,0,0,0,,Gdzie jest Frederica?
Dialogue: 0,0:25:00.05,0:25:02.17,Default,Elsa,0,0,0,,Masz na myśli wielką pokojówkę?
Dialogue: 0,0:25:02.26,0:25:03.65,Default,Elsa,0,0,0,,Nie martw się.
Dialogue: 0,0:25:03.74,0:25:05.44,Default,Elsa,0,0,0,,Okazała się być całkiem przyjemna.
Dialogue: 0,0:25:06.68,0:25:09.15,Default,Subaru,0,0,0,,Kto cię posłał?
Dialogue: 0,0:25:09.55,0:25:12.03,Default,Elsa,0,0,0,,Nie mówię o moich klientach.
Dialogue: 0,0:25:12.12,0:25:14.91,Default,Elsa,0,0,0,,Przynajmniej taką mam uprzejmość.
Dialogue: 0,0:25:15.35,0:25:17.72,Default,Elsa,0,0,0,,Skoro wróciłeś wcześniej\Nniż się spodziewałam,
Dialogue: 0,0:25:17.81,0:25:21.28,Default,Elsa,0,0,0,,Nie potoczyło się to dokładnie zgodnie z\Nmoimi instrukcjami.
Dialogue: 0,0:25:21.37,0:25:23.62,Default,Subaru,0,0,0,,Nie tak jak... określono...
Dialogue: 0,0:25:23.88,0:25:26.82,Default,Elsa,0,0,0,,Dwie pokojówki i jedna odludka...
Dialogue: 0,0:25:26.91,0:25:29.25,Default,Elsa,0,0,0,,Miało być zaplanowane na twój powrót.
Dialogue: 0,0:25:31.79,0:25:33.71,Default,Subaru,0,0,0,,To wystarczy.
Dialogue: 0,0:25:33.99,0:25:38.15,Default,Elsa,0,0,0,,Nie chcę, żeby Maylie brała\Nwięcej zasług ode mnie.
Dialogue: 0,0:25:38.24,0:25:40.21,Default,Elsa,0,0,0,,Więc zakończmy to teraz.
Dialogue: 0,0:25:40.96,0:25:43.18,Default,Elsa,0,0,0,,Wyślę cię na spotkanie z aniołami.
Dialogue: 0,0:25:45.55,0:25:47.18,Default - italics,Subaru,0,0,0,,Nawet jeśli świat nie przetrwa,
Dialogue: 0,0:25:47.27,0:25:49.11,Default - italics,Subaru,0,0,0,,Nie pozwolę jej skrzywdzić Rem!
Dialogue: 0,0:25:50.78,0:25:51.66,Default - italics,Subaru,0,0,0,,Rem!
Dialogue: 0,0:25:58.87,0:26:00.12,Default,Subaru,0,0,0,,Dlaczego?
Dialogue: 0,0:26:02.75,0:26:04.86,Default,Subaru,0,0,0,,Dlaczego mnie uratowałaś?!
Dialogue: 0,0:26:04.95,0:26:09.92,Episode Title,Title,0,0,0,,{\fs30\t(1,5010,\fs25)}Ewangelia {\c&H90F5FF&}dziew{\c&HFAFAFA&}czyny
Dialogue: 0,0:26:05.87,0:26:08.03,Default,Subaru,0,0,0,,Beatrice!
Dialogue: 0,0:26:08.12,0:26:15.12,Default,,0,0,0,,
