Dialogue: 0,0:00:03.19,0:00:06.72,Default,Subaru,0,0,0,,Po pierwsze, chciałbym coś powiedzieć.
Dialogue: 0,0:00:09.12,0:00:11.37,Default,Subaru,0,0,0,,Ładnie wyglądasz w tym mundurze.
Dialogue: 0,0:01:20.35,0:01:21.23,sign_36406_423_Missing,Text,0,0,0,,Jeśli
Dialogue: 0,0:01:22.39,0:01:23.27,sign_36406_423_Missing,Text,0,0,0,,mam cię ocalić,
Dialogue: 0,0:01:23.68,0:01:24.58,sign_36406_423_Missing,Text,0,0,0,,nie obchodzi mnie,
Dialogue: 0,0:01:25.10,0:01:25.98,sign_36406_423_Missing,Text,0,0,0,,ile razy
Dialogue: 0,0:01:27.48,0:01:28.36,sign_36406_423_Missing,Text,0,0,0,,{\c&H1300C5&\4c&H0C0084&}umrę{\alpha&FF&\t(441,442,\alpha&00&)}.
Dialogue: 0,0:01:46.16,0:01:47.90,Default,Echidna,0,0,0,,Dziękuję!
Dialogue: 0,0:01:47.99,0:01:53.16,Default,Echidna,0,0,0,,Kiedy to mówisz, wiem, że warto było\Nodtworzyć go z twoich wspomnień.
Dialogue: 0,0:01:53.25,0:01:55.31,Default,Subaru,0,0,0,,Więc co to za miejsce?
Dialogue: 0,0:01:55.40,0:01:58.25,Default,Echidna,0,0,0,,Jako osoba uprawniona wszedłeś na\Ncmentarz.
Dialogue: 0,0:01:58.34,0:02:00.20,Default,Echidna,0,0,0,,Tak rozpoczęła się próba.
Dialogue: 0,0:02:00.29,0:02:01.86,Default,Echidna,0,0,0,,To wszystko.
Dialogue: 0,0:02:01.95,0:02:05.02,Default,Echidna,0,0,0,,Nie słyszałeś: „Najpierw zmierz się z\Nwłasną przeszłością”?
Dialogue: 0,0:02:05.76,0:02:08.29,Default,Subaru,0,0,0,,Stopniowo zaczynam pamiętać.
Dialogue: 0,0:02:08.38,0:02:10.19,Default,Subaru,0,0,0,,Co mi zrobiłaś?!
Dialogue: 0,0:02:10.28,0:02:12.56,Default,Subaru,0,0,0,,Całkowicie o tobie zapomniałem.
Dialogue: 0,0:02:12.92,0:02:15.33,Default,Echidna,0,0,0,,Szybciej było ingerować w twoje\Nwspomnienia,
Dialogue: 0,0:02:15.42,0:02:18.89,Default,Echidna,0,0,0,,niż zaufać, że możesz\Nzachować sekret.
Dialogue: 0,0:02:18.98,0:02:21.99,Default,Subaru,0,0,0,,Czy przeszedłem próbę?
Dialogue: 0,0:02:23.00,0:02:25.97,Default,Echidna,0,0,0,,Widziałam całą próbę.
Dialogue: 0,0:02:26.06,0:02:28.71,Default,Echidna,0,0,0,,Twój wynik był więcej niż zadowalający.
Dialogue: 0,0:02:28.94,0:02:31.46,Default,Subaru,0,0,0,,Czekaj, ty...
Dialogue: 0,0:02:31.97,0:02:34.46,Default,Echidna,0,0,0,,„Tak mi przykro!”
Dialogue: 0,0:02:34.55,0:02:37.56,Default,Echidna,0,0,0,,Kiedy to powiedziałeś, nawet ja się\Nwzruszyłam.
Dialogue: 0,0:02:37.65,0:02:40.34,Default,Subaru,0,0,0,,Nie mów o tym nikomu,\Nto zbyt żenujące!
Dialogue: 0,0:02:40.64,0:02:43.28,Default,Subaru,0,0,0,,Tak czy owak, ten świat jest...
Dialogue: 0,0:02:43.37,0:02:45.01,Default,Echidna,0,0,0,,Tak, tak jest.
Dialogue: 0,0:02:45.10,0:02:47.16,Default,Echidna,0,0,0,,To sztucznie stworzony świat,
Dialogue: 0,0:02:47.25,0:02:50.64,Default,Echidna,0,0,0,,który odtworzyłam z najwyższą wiernością\Ntwoim wspomnieniom.
Dialogue: 0,0:02:50.89,0:02:54.86,Default,Echidna,0,0,0,,Wszystko, łącznie z twoimi rodzicami.\NRozumiesz?
Dialogue: 0,0:02:55.34,0:02:57.55,Default,Subaru,0,0,0,,To wszystko stworzyłaś? Naprawdę?
Dialogue: 0,0:02:57.64,0:02:59.91,Default,Subaru,0,0,0,,Ale padły słowa, których nawet ja nie\Nznałem.
Dialogue: 0,0:03:00.00,0:03:03.03,Default,Echidna,0,0,0,,Jesteś pewien, że nie wiedziałeś?
Dialogue: 0,0:03:03.12,0:03:06.36,Default,Echidna,0,0,0,,Czy ani razu nie pomyślałeś, że twój\Nojciec
Dialogue: 0,0:03:06.45,0:03:10.00,Default,Echidna,0,0,0,,mógł być inny, niż go sobie wyobrażałeś?
Dialogue: 0,0:03:11.39,0:03:14.33,Default,Echidna,0,0,0,,Naprawdę myślałeś, że możesz\Nukryć części swojego serca
Dialogue: 0,0:03:14.42,0:03:17.09,Default,Echidna,0,0,0,,o których sądziłeś, że nikt nie wie?
Dialogue: 0,0:03:17.18,0:03:19.73,Default,Echidna,0,0,0,,Chcesz, by się dowiedzieli,\Nbo poczułbyś ulgę...
Dialogue: 0,0:03:19.82,0:03:22.80,Default,Echidna,0,0,0,,Pragnienie, by nadal cię\Nkochali, nawet jeśli wiedzieli...
Dialogue: 0,0:03:23.06,0:03:27.26,Default,Echidna,0,0,0,,Czy możesz z całą pewnością powiedzieć, że\Nniczego takiego nie oczekiwałeś
Dialogue: 0,0:03:27.88,0:03:29.48,Default,Echidna,0,0,0,,od twoich wymyślonych rodziców?
Dialogue: 0,0:03:29.97,0:03:33.72,Default,Echidna,0,0,0,,To byłoby zbyt idealistyczne, nie\Nwspominając już o wygodzie.
Dialogue: 0,0:03:33.81,0:03:35.75,Default,Echidna,0,0,0,,Nie zgadzasz się?
Dialogue: 0,0:03:37.56,0:03:40.28,Default,Subaru,0,0,0,,Nie wyśmiewaj się z\Nmoich rodziców, Echidno.
Dialogue: 0,0:03:41.00,0:03:41.93,Default,Echidna,0,0,0,,Co?
Dialogue: 0,0:03:42.02,0:03:44.47,Default,Subaru,0,0,0,,Dałem wszystkie odpowiedzi.
Dialogue: 0,0:03:44.56,0:03:47.31,Default,Subaru,0,0,0,,i oboje, mama i tata, zaakceptowali je.
Dialogue: 0,0:03:47.78,0:03:53.00,Default,Subaru,0,0,0,,Powiedzieli mi, żebym dał z\Nsiebie wszystko i uważał.
Dialogue: 0,0:03:53.44,0:03:56.03,Default,Subaru,0,0,0,,Ich głosy, uśmiechy i\Nwszystko inne.
Dialogue: 0,0:03:56.12,0:03:58.35,Default,Subaru,0,0,0,,przekroczyły wszystko, co sobie\Nwyobrażałem.
Dialogue: 0,0:03:58.84,0:04:03.13,Default,Subaru,0,0,0,,Moi rodzice są zbyt wielcy, by zmieścić\Nsię w mojej marnej wyobraźni!
Dialogue: 0,0:04:03.60,0:04:04.72,Default,Subaru,0,0,0,,Nie lekceważ ich!
Dialogue: 0,0:04:06.12,0:04:08.68,Default,Subaru,0,0,0,,Powiedziałem im wszystko,\Nco chciałem powiedzieć.
Dialogue: 0,0:04:08.77,0:04:11.85,Default,Subaru,0,0,0,,Nie pozwolę, by cokolwiek, co powiesz,\Nzbiło mnie z tropu.
Dialogue: 0,0:04:15.16,0:04:18.39,Default,Echidna,0,0,0,,Ta próba naprawdę dobiegła końca.
Dialogue: 0,0:04:18.48,0:04:20.96,Default,Echidna,0,0,0,,Ciekawe, jak rozwiążesz następne pytanie.
Dialogue: 0,0:04:21.05,0:04:22.76,Default,Subaru,0,0,0,,Czekaj, "następne pytanie"?
Dialogue: 0,0:04:22.85,0:04:25.06,Default,Subaru,0,0,0,,Co to znaczy? Jest więcej niż jedna\Npróba?!
Dialogue: 0,0:04:25.16,0:04:27.38,Default,Echidna,0,0,0,,W sumie są trzy próby na cmentarzu.
Dialogue: 0,0:04:27.47,0:04:30.63,Default,Echidna,0,0,0,,Musisz przejść je wszystkie, by uwolnić\NSanktuarium.
Dialogue: 0,0:04:30.72,0:04:33.91,Default,Echidna,0,0,0,,Tak się cieszę, że w\Nkońcu ci to powiedziałam!
Dialogue: 0,0:04:34.32,0:04:37.56,Default,Echidna,0,0,0,,Widok twojego zaskoczenia aż wprawia moje\Nserce w zachwyt.
Dialogue: 0,0:04:38.70,0:04:41.04,Default,Echidna,0,0,0,,Już zaczyna zniknąć.
Dialogue: 0,0:04:41.13,0:04:42.54,Default,Echidna,0,0,0,,Jeśli wyjdziesz na zewnątrz,
Dialogue: 0,0:04:42.63,0:04:45.26,Default,,0,0,0,,Powinieneś wrócić na cmentarz.
Dialogue: 0,0:04:45.80,0:04:47.27,Default,Subaru,0,0,0,,Hej, Echidno...
Dialogue: 0,0:04:47.36,0:04:50.10,Default,Echidna,0,0,0,,Chcesz, żebym pozwoliła ci mnie uderzyć?
Dialogue: 0,0:04:50.43,0:04:53.73,Default,Echidna,0,0,0,,Masz do tego prawo, to prawda.
Dialogue: 0,0:04:53.82,0:04:55.81,Default,Echidna,0,0,0,,Ale jestem dziewczyną. Moja twarz...
Dialogue: 0,0:04:55.90,0:04:57.05,Default,Subaru,0,0,0,,Dziękuję.
Dialogue: 0,0:04:58.60,0:05:01.18,Default,Subaru,0,0,0,,Nawet jeśli nie byli prawdziwi...
Dialogue: 0,0:05:01.27,0:05:04.23,Default,Subaru,0,0,0,,Choć nie mogłem tego powiedzieć\Nprawdziwym rodzicom...
Dialogue: 0,0:05:04.32,0:05:07.36,Default,Subaru,0,0,0,,Dzięki tobie mogłem powiedzieć to, co\Nchciałem.
Dialogue: 0,0:05:07.45,0:05:08.33,Default,Subaru,0,0,0,,Więc...
Dialogue: 0,0:05:09.18,0:05:10.39,Default,Subaru,0,0,0,,Dziękuję.
Dialogue: 0,0:05:12.03,0:05:14.66,Default,Echidna,0,0,0,,Jesteś bardzo intrygującym człowiekiem.
Dialogue: 0,0:05:14.75,0:05:16.63,Default,,0,0,0,,Nie mogę cię po prostu zrozumieć.
Dialogue: 0,0:05:16.72,0:05:18.07,Default,Echidna,0,0,0,,Właściwie to mnie przeraża.
Dialogue: 0,0:05:18.32,0:05:21.02,Default,Subaru,0,0,0,,To zaszczyt wiedzieć,\Nże mogę przestraszyć czarownicę.
Dialogue: 0,0:05:27.19,0:05:28.07,Default,Subaru,0,0,0,,Tak, to jest...
Dialogue: 0,0:05:28.34,0:05:33.67,Default,Subaru,0,0,0,,Brzmiało to tak, jakbyś bardzo chciała,\Nżebym przeszedł kolejną próbę,
Dialogue: 0,0:05:33.76,0:05:35.60,Default,Subaru,0,0,0,,Ale nie mogę spełnić tego życzenia.
Dialogue: 0,0:05:36.58,0:05:37.56,Default,Echidna,0,0,0,,Co to znaczy?
Dialogue: 0,0:05:38.37,0:05:43.07,Default,Subaru,0,0,0,,To nie ja przejdę próby i uwolnię\NSanktuarium.
Dialogue: 0,0:05:43.16,0:05:45.76,Default,Subaru,0,0,0,,Ktoś inny spełni twoje życzenie.
Dialogue: 0,0:05:48.05,0:05:50.74,Default,Echidna,0,0,0,,Zastanawiam się...
Dialogue: 0,0:06:01.32,0:06:02.92,Default,Subaru,0,0,0,,Gdzie...
Dialogue: 0,0:06:03.50,0:06:06.66,Default,Subaru,0,0,0,,Właśnie. Przeszedłem próbę.
Dialogue: 0,0:06:10.36,0:06:11.60,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:06:18.27,0:06:21.04,Default,Subaru,0,0,0,,Emilia?! Hej, trzymaj się!
Dialogue: 0,0:06:21.13,0:06:23.35,Default,Subaru,0,0,0,,Emilia! Emilia!
Dialogue: 0,0:06:24.38,0:06:25.63,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:06:26.58,0:06:32.28,Default,Emilia,0,0,0,,Właśnie... przechodziłam próbę... i...
Dialogue: 0,0:06:37.80,0:06:38.96,Default,Subaru,0,0,0,,Emilia?
Dialogue: 0,0:06:39.50,0:06:42.78,Default,Emilia,0,0,0,,To nie ja!
Dialogue: 0,0:06:42.87,0:06:43.75,Default,Subaru,0,0,0,,Co?
Dialogue: 0,0:06:43.92,0:06:46.07,Default,Emilia,0,0,0,,Nie! A jednak...
Dialogue: 0,0:06:46.16,0:06:48.13,Default,Emilia,0,0,0,,Powtarzam ci, że to nie ja, a jednak...
Dialogue: 0,0:06:48.44,0:06:50.00,Default,Subaru,0,0,0,,Hej, uspokój się!
Dialogue: 0,0:06:50.09,0:06:51.75,Default,Subaru,0,0,0,,Spójrz na mnie, Emilio!
Dialogue: 0,0:06:52.28,0:06:54.89,Default,Emilia,0,0,0,,Nie patrz tak na mnie!
Dialogue: 0,0:06:54.98,0:06:56.13,Default,Emilia,0,0,0,,Nie, nie!
Dialogue: 0,0:06:56.22,0:06:57.58,Default,Emilia,0,0,0,,{\an8}To nie ja!
Dialogue: 0,0:06:56.22,0:06:58.43,Default,Subaru,0,0,0,,W porządku! Spokojnie, wszystko dobrze!
Dialogue: 0,0:06:58.52,0:06:59.48,Default,Emilia,0,0,0,,{\an8}...samą...
Dialogue: 0,0:06:58.52,0:07:00.55,Default,Subaru,0,0,0,,Jestem z tobą! Jestem tutaj!
Dialogue: 0,0:07:00.64,0:07:02.15,Default,Subaru,0,0,0,,Nie zostawię cię samej!
Dialogue: 0,0:07:02.24,0:07:03.35,Default,Subaru,0,0,0,,Wszystko w porządku!
Dialogue: 0,0:07:04.73,0:07:06.05,Default,Emilia,0,0,0,,Ojcze...
Dialogue: 0,0:07:06.70,0:07:07.95,Default,Emilia,0,0,0,,Pomóż mi!
Dialogue: 0,0:07:08.04,0:07:09.14,Default,Emilia,0,0,0,,Puck...
Dialogue: 0,0:07:09.66,0:07:11.03,Default,Emilia,0,0,0,,Puck!
Dialogue: 0,0:07:15.14,0:07:19.07,Default,Ram,0,0,0,,W końcu się uspokoiła i\Nteraz odpoczywa.
Dialogue: 0,0:07:19.64,0:07:22.92,Default,Ram,0,0,0,,Hipnoza zapachem zapobiegnie koszmarom.
Dialogue: 0,0:07:23.30,0:07:25.58,Default,Subaru,0,0,0,,Przepraszam, że sprawiam kłopot.
Dialogue: 0,0:07:25.67,0:07:27.26,Default,Ram,0,0,0,,Nie zrobiłam tego dla ciebie.
Dialogue: 0,0:07:27.35,0:07:30.68,Default,Ram,0,0,0,,Ale teraz Sanktuarium jest\Njeszcze dalej od uwolnienia.
Dialogue: 0,0:07:31.48,0:07:33.62,Default,Otto,0,0,0,,Mogę coś powiedzieć?
Dialogue: 0,0:07:34.45,0:07:35.33,Default,Subaru,0,0,0,,Co słychać, Otto?
Dialogue: 0,0:07:35.74,0:07:38.53,Default,Otto,0,0,0,,Może uda się wyciągnąć\Nwszystkich poza barierę.
Dialogue: 0,0:07:38.62,0:07:40.94,Default,Otto,0,0,0,,bez przejścia próby i\Nuwolnienia Sanktuarium.
Dialogue: 0,0:07:41.03,0:07:42.83,Default,Garfiel,0,0,0,,O czym ty mówisz?
Dialogue: 0,0:07:42.92,0:07:44.28,Default,Garfiel,0,0,0,,Nie ma mowy.
Dialogue: 0,0:07:44.37,0:07:45.93,Default,Otto,0,0,0,,Posłuchaj mnie.
Dialogue: 0,0:07:46.02,0:07:50.13,Default,Otto,0,0,0,,Wiem, że każda osoba mieszanej krwi, która\Ndotknie bariery, traci przytomność.
Dialogue: 0,0:07:50.22,0:07:52.01,Default,Otto,0,0,0,,Widziałem to na własne oczy.
Dialogue: 0,0:07:52.89,0:07:53.86,Default,Otto,0,0,0,,Więc...
Dialogue: 0,0:07:55.10,0:07:57.23,Default,Otto,0,0,0,,Dlaczego ci z nas,
Dialogue: 0,0:07:57.32,0:08:00.23,Default,Otto,0,0,0,,odporni na barierę nie\Nmogliby przeprowadzić innych,
Dialogue: 0,0:08:00.32,0:08:02.35,Default,Otto,0,0,0,,kiedy będą nieprzytomni?
Dialogue: 0,0:08:03.40,0:08:06.31,Default,Subaru,0,0,0,,Rozumiem! W ten sposób moglibyśmy\Nwszystkich...
Dialogue: 0,0:08:06.40,0:08:10.18,Default,Ryuzu,0,0,0,,Zabawny pomysł, ale lepiej,\Nżebyście go nie próbowali.
Dialogue: 0,0:08:10.71,0:08:15.59,Default,Ryuzu,0,0,0,,Wolałabym nie stać się\Npustą muszlą duszy.
Dialogue: 0,0:08:20.38,0:08:22.23,Default,Subaru,0,0,0,,Jesteś tą dziewczyną z
Dialogue: 0,0:08:22.32,0:08:23.42,Default,Subaru,0,0,0,,Au, au, au!
Dialogue: 0,0:08:23.51,0:08:24.62,Default,Ram,0,0,0,,Barusu, twoja herbata.
Dialogue: 0,0:08:24.71,0:08:27.47,Default,Subaru,0,0,0,,Herbata, do cholery! Gorąca! Spalisz mi\Npoliczek!
Dialogue: 0,0:08:27.56,0:08:28.56,Default,Subaru,0,0,0,,Nic nie rozumiałem!
Dialogue: 0,0:08:28.65,0:08:31.32,Default,Ram,0,0,0,,Co za dramat. Żałosna namiastka mężczyzny.
Dialogue: 0,0:08:32.19,0:08:34.36,Default,Ram,0,0,0,,Nie rób niepotrzebnych komentarzy.
Dialogue: 0,0:08:35.10,0:08:37.59,Default,Garfiel,0,0,0,,Ram, przynieś mi też herbaty.
Dialogue: 0,0:08:37.68,0:08:39.01,Default,Ram,0,0,0,,To marna herbata.
Dialogue: 0,0:08:39.10,0:08:41.54,Default,Garfiel,0,0,0,,Czy zwykle nie mówisz bardziej skromnie?
Dialogue: 0,0:08:41.71,0:08:43.81,Default,Ram,0,0,0,,Zaparzyłam liście, które akurat znalazłam.
Dialogue: 0,0:08:43.90,0:08:47.20,Default,Ram,0,0,0,,Okaż wdzięczność za jej przygotowanie i\Nwypij do ostatniej kropli.
Dialogue: 0,0:08:48.85,0:08:53.30,Default,Ryuzu,0,0,0,,Słyszałam, że przyprowadziłeś\Nwięcej ludzi z zewnątrz, Młody Gar.
Dialogue: 0,0:08:53.39,0:08:55.38,Default,Ryuzu,0,0,0,,Co za hałaśliwy chłopak.
Dialogue: 0,0:08:55.73,0:08:58.64,Default,Otto,0,0,0,,A ty jesteś...
Dialogue: 0,0:08:58.73,0:09:00.71,Default,Ryuzu,0,0,0,,Jestem Ryuzu Bilma.
Dialogue: 0,0:09:00.80,0:09:04.39,Default,Ryuzu,0,0,0,,Moim obowiązkiem jest\Nreprezentować tę społeczność.
Dialogue: 0,0:09:04.69,0:09:06.90,Default,Ryuzu,0,0,0,,choć jestem stara i słaba, jak widzisz.
Dialogue: 0,0:09:07.41,0:09:08.82,Default,Subaru,0,0,0,,Jak widać?
Dialogue: 0,0:09:09.19,0:09:11.11,Default,,0,0,0,,Więc jesteś tak zwaną starą loli?
Dialogue: 0,0:09:11.20,0:09:12.73,Default,Subaru,0,0,0,,Wiedziałem, że ją spotkam,
Dialogue: 0,0:09:12.82,0:09:14.22,Default,,0,0,0,,Pasujesz do stereotypu.
Dialogue: 0,0:09:14.31,0:09:16.86,Default,Ryuzu,0,0,0,,Jak śmiesz nazywać mnie starą kobietą?
Dialogue: 0,0:09:17.70,0:09:18.99,Default,Ryuzu,0,0,0,,Nieważne.
Dialogue: 0,0:09:19.39,0:09:23.20,Default,Ryuzu,0,0,0,,A ty jesteś Barusu... więc będziesz Młody\NSu.
Dialogue: 0,0:09:23.48,0:09:24.73,Default,Subaru,0,0,0,,Młody Su?
Dialogue: 0,0:09:24.82,0:09:29.17,Default,Otto,0,0,0,,Więc, Ryuzu, dlaczego myślisz,\Nże mój pomysł nie zadziała?
Dialogue: 0,0:09:29.26,0:09:30.79,Default,Otto,0,0,0,,Coś o "pustej skorupie duszy"?
Dialogue: 0,0:09:31.18,0:09:32.99,Default,Ryuzu,0,0,0,,Nie słyszałeś?
Dialogue: 0,0:09:33.48,0:09:35.63,Default,Ryuzu,0,0,0,,Kiedy osoba mieszanej krwi dotknie\Nbariery,
Dialogue: 0,0:09:35.72,0:09:36.86,Default,,0,0,0,,Traci ona przytomność.
Dialogue: 0,0:09:36.95,0:09:39.97,Default,Ryuzu,0,0,0,,Dokładniej mówiąc, bariera odpycha jej\Nduszę.
Dialogue: 0,0:09:40.26,0:09:43.51,Default,Otto,0,0,0,,Odpycha jej duszę? Eee...
Dialogue: 0,0:09:43.60,0:09:47.88,Default,Subaru,0,0,0,,Kiedy więc mieszaniec próbuje siłą przejść\Nprzez barierę,
Dialogue: 0,0:09:47.97,0:09:49.89,Default,Subaru,0,0,0,,jego dusza oddziela się od ciała,
Dialogue: 0,0:09:49.98,0:09:55.82,Default,Subaru,0,0,0,,a dusza zostaje w barierze,\Nzostawiając pustą skorupę, prawda?
Dialogue: 0,0:09:56.07,0:09:58.97,Default,Ryuzu,0,0,0,,Szybko się uczysz.
Dialogue: 0,0:09:59.40,0:10:01.43,Default,Ryuzu,0,0,0,,Tak, o to chodzi.
Dialogue: 0,0:10:01.52,0:10:05.74,Default,Ryuzu,0,0,0,,Kiedy ciało bez duszy wyjdzie z bariery,
Dialogue: 0,0:10:05.83,0:10:08.00,Default,Ryuzu,0,0,0,,Innymi słowy, nie żyje.
Dialogue: 0,0:10:08.24,0:10:09.32,Default,Otto,0,0,0,,Nie żyje?
Dialogue: 0,0:10:11.29,0:10:13.25,Default,Garfiel,0,0,0,,Ta herbata jest obrzydliwa!
Dialogue: 0,0:10:13.34,0:10:14.74,Default,Garfiel,0,0,0,,Smakuje jak trawa!
Dialogue: 0,0:10:15.16,0:10:17.94,Default,Subaru,0,0,0,,Naprawdę zrobiłaś ją z trawy?
Dialogue: 0,0:10:18.79,0:10:22.93,Default,Subaru,0,0,0,,Mimo to, skoro warunkiem przystąpienia do\Npróby jest mieszana krew,
Dialogue: 0,0:10:23.02,0:10:27.23,Default,Subaru,0,0,0,,Czy to nie znaczy, że ty lub Garfiel\Nmoglibyście to zrobić?
Dialogue: 0,0:10:27.60,0:10:30.87,Default,Ryuzu,0,0,0,,Jeśli mówimy tylko o podjęciu próby,\Nlogiczne jest, że możemy.
Dialogue: 0,0:10:30.96,0:10:33.73,Default,Ryuzu,0,0,0,,Ale nie możemy uwolnić Sanktuarium.
Dialogue: 0,0:10:34.05,0:10:36.67,Default,Ryuzu,0,0,0,,To jest kontrakt, który\Nzostał przekazany.
Dialogue: 0,0:10:36.76,0:10:39.99,Default,Ryuzu,0,0,0,,wśród nas, mieszkańców Sanktuarium, od\Npokoleń.
Dialogue: 0,0:10:48.28,0:10:49.27,Default,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:10:50.09,0:10:51.73,Default,Subaru,0,0,0,,Dzień dobry, Emilia.
Dialogue: 0,0:10:52.15,0:10:53.13,Default,,0,0,0,,Dobrze spałaś?
Dialogue: 0,0:10:53.79,0:10:55.06,Default,Emilia,0,0,0,,Dzień dobry.
Dialogue: 0,0:10:55.62,0:10:57.63,Default,Emilia,0,0,0,,Zostałeś ze mną przez całą noc?
Dialogue: 0,0:10:57.99,0:11:00.66,Default,Subaru,0,0,0,,I tak nie mógłbym spać\Nw swoim pokoju.
Dialogue: 0,0:11:00.75,0:11:03.14,Default,Subaru,0,0,0,,Otto mówi we śnie.
Dialogue: 0,0:11:04.28,0:11:06.04,Default,Emilia,0,0,0,,Przepraszam za wczoraj.
Dialogue: 0,0:11:06.53,0:11:09.60,Default,Emilia,0,0,0,,Naprawdę straciłam spokój na cmentarzu.
Dialogue: 0,0:11:10.73,0:11:12.52,Default,Subaru,0,0,0,,Nie martw się o to.
Dialogue: 0,0:11:12.93,0:11:13.81,Default,Subaru,0,0,0,,Co ważniejsze...
Dialogue: 0,0:11:20.17,0:11:21.70,Default,Emilia,0,0,0,,To nie tak!
Dialogue: 0,0:11:22.11,0:11:25.10,Default,Emilia,0,0,0,,To zabawne... dlaczego ja...
Dialogue: 0,0:11:25.19,0:11:28.93,Default,Subaru,0,0,0,,Czy wreszcie jesteś na tyle śmiała, by\Npodświadomie po mnie sięgać?!
Dialogue: 0,0:11:28.24,0:11:30.19,Default,Emilia,0,0,0,,{\an8}Nie, nie, to wcale nie tak!
Dialogue: 0,0:11:30.28,0:11:31.62,Default,Emilia,0,0,0,,Chyba nie myślałam...
Dialogue: 0,0:11:31.71,0:11:34.23,Default,Subaru,0,0,0,,Tak szybko zaprzeczyłaś!\NI „nie myślałaś”?!
Dialogue: 0,0:11:34.32,0:11:35.49,Default,Emilia,0,0,0,,To znaczy...
Dialogue: 0,0:11:37.12,0:11:39.14,Default,Subaru,0,0,0,,Dopóki się uśmiechasz, wszystko gra.
Dialogue: 0,0:11:39.53,0:11:42.97,Default,Subaru,0,0,0,,Możesz ponownie przystąpić do próby tej\Nnocy.
Dialogue: 0,0:11:45.87,0:11:48.12,Default,Emilia,0,0,0,,Znowu... dziś...
Dialogue: 0,0:11:52.27,0:11:53.98,Default,Ram,0,0,0,,Muszę ci coś powiedzieć, Barusu.
Dialogue: 0,0:11:55.56,0:12:00.77,Default,Ram,0,0,0,,Nie wszyscy mieszkańcy są\Nza uwolnieniem Sanktuarium.
Dialogue: 0,0:12:00.86,0:12:02.32,Default,Subaru,0,0,0,,Co masz na myśli?
Dialogue: 0,0:12:02.73,0:12:08.58,Default,Ram,0,0,0,,Tylko twardogłowi ludzie tacy jak Garf,\Nprowadzeni przez Ryuzu, chcą je uwolnić.
Dialogue: 0,0:12:09.07,0:12:13.10,Default,Ram,0,0,0,,Jest konserwatywna frakcja, która nie\Nchce, by Sanktuarium zostało uwolnione.
Dialogue: 0,0:12:13.19,0:12:15.79,Default,Subaru,0,0,0,,Są ludzie, którzy nie chcą,\Nżeby to uwolniono?
Dialogue: 0,0:12:16.08,0:12:20.92,Default,Ram,0,0,0,,Konserwatyści uważają, że minimalna\Ninterakcja z obcymi jest idealna.
Dialogue: 0,0:12:21.36,0:12:25.80,Default,Ram,0,0,0,,Według nich zniszczenie tego nie\Nspowoduje nic innego jak kłopoty.
Dialogue: 0,0:12:26.48,0:12:30.00,Default,Subaru,0,0,0,,Rozumiem Garfiela, ale oni nie ufają nawet\NRyuzu?
Dialogue: 0,0:12:30.09,0:12:31.64,Default,Ram,0,0,0,,Ani Frederice.
Dialogue: 0,0:12:37.66,0:12:40.90,Default,Ram,0,0,0,,To Frederica dała Emilii ten\Nświecący kamień.
Dialogue: 0,0:12:40.99,0:12:44.20,Default,Subaru,0,0,0,,Więc myślisz, że Frederica\Nzaczęła to wszystko?
Dialogue: 0,0:12:44.68,0:12:49.37,Default,Ram,0,0,0,,Poszlaki wskazują, że Frederica ma jakiś\Nplan.
Dialogue: 0,0:12:50.15,0:12:54.37,Default,Ram,0,0,0,,Emilia uniknęła katastrofy o włos.
Dialogue: 0,0:12:54.46,0:12:55.96,Default,Ram,0,0,0,,Dzięki twojemu szlachetnemu...
Dialogue: 0,0:12:56.05,0:12:57.95,Default,,0,0,0,,twojej stosunkowo szlachetnej ofierze.
Dialogue: 0,0:12:58.04,0:12:59.55,Default,Subaru,0,0,0,,Nie musiałaś tego zmieniać.
Dialogue: 0,0:12:59.64,0:13:02.84,Default,Subaru,0,0,0,,Nie poświęciłem się, więc\Nmożesz to {\i1}poprawić{\i0}, ale...
Dialogue: 0,0:13:03.40,0:13:05.19,Default,Ram,0,0,0,,Uważaj, Barusu.
Dialogue: 0,0:13:05.28,0:13:08.26,Default,Ram,0,0,0,,Dla tych, którzy sprzeciwiają\Nsię uwolnieniu Sanktuarium,
Dialogue: 0,0:13:08.35,0:13:12.85,Default,Ram,0,0,0,,najpewniejszym sposobem, by osiągnęli cel,\Njest skrzywdzenie Emilii.
Dialogue: 0,0:13:13.11,0:13:14.85,Default,Ram,0,0,0,,Nie wiesz, kto może być wrogiem.
Dialogue: 0,0:13:15.63,0:13:17.24,Default,Ram,0,0,0,,Bądź czujny przez cały czas.
Dialogue: 0,0:13:35.78,0:13:37.54,Default,Garfiel,0,0,0,,Chodź, Ram, dołącz do nas.
Dialogue: 0,0:13:38.36,0:13:40.29,Default,Garfiel,0,0,0,,Co jest? Nie umiesz się bawić.
Dialogue: 0,0:13:40.76,0:13:43.21,Default,Subaru,0,0,0,,Lubisz Ram czy co?
Dialogue: 0,0:13:43.30,0:13:45.77,Default,Garfiel,0,0,0,,Jest śliczna, prawda?
Dialogue: 0,0:13:45.86,0:13:50.18,Default,Garfiel,0,0,0,,Nic niezwykłego w tym, że faceta pociąga\Nsilna, zdolna dziewczyna.
Dialogue: 0,0:13:50.88,0:13:53.11,Default,Garfiel,0,0,0,,Mam nadzieję, że tym razem będzie lepiej.
Dialogue: 0,0:13:53.20,0:13:57.46,Default,Garfiel,0,0,0,,Nie chcemy, żeby krótka drzemka dla\Nmoroloka była całodniowym snem dla nas.
Dialogue: 0,0:13:58.40,0:14:01.94,Default,Subaru,0,0,0,,Chcesz coś zrobić po\Nwyjściu z bariery?
Dialogue: 0,0:14:02.72,0:14:04.99,Default,Garfiel,0,0,0,,To wyszło znikąd.
Dialogue: 0,0:14:05.08,0:14:07.45,Default,Garfiel,0,0,0,,Co chcę robić, gdy wyjdę?
Dialogue: 0,0:14:07.54,0:14:09.76,Default,Garfiel,0,0,0,,Facet, który może przychodzić i odchodzić,
Dialogue: 0,0:14:09.85,0:14:12.45,Default,,0,0,0,,nie miałby pojęcia, co czujemy ze\Nstaruszką.
Dialogue: 0,0:14:13.98,0:14:15.75,Default,Subaru,0,0,0,,A co z Fredericą?
Dialogue: 0,0:14:16.12,0:14:17.03,Default,Garfiel,0,0,0,,Co?
Dialogue: 0,0:14:17.12,0:14:20.23,Default,Subaru,0,0,0,,Co Frederica myśli\No Sanktuarium?
Dialogue: 0,0:14:20.32,0:14:23.43,Default,Garfiel,0,0,0,,Nie powiedziała ci nic?
Dialogue: 0,0:14:23.52,0:14:26.90,Default,Subaru,0,0,0,,Powiedziała tylko, że nie może\Nmi tego wyjaśnić w szczegółach.
Dialogue: 0,0:14:26.99,0:14:29.50,Default,Subaru,0,0,0,,Powiedziała mi o tobie tylko twoje imię,
Dialogue: 0,0:14:29.59,0:14:30.94,Default,,0,0,0,,z powodu pewnej przysięgi.
Dialogue: 0,0:14:31.03,0:14:33.09,Default,Garfiel,0,0,0,,Przysięga, do cholery.
Dialogue: 0,0:14:33.18,0:14:35.68,Default,Garfiel,0,0,0,,Ależ wygodna wymówka.
Dialogue: 0,0:14:35.77,0:14:37.35,Default,Garfiel,0,0,0,,Brzmi jak jej cholerny pan.
Dialogue: 0,0:14:37.84,0:14:40.87,Default,Subaru,0,0,0,,Czy ty i Frederica nie\Njesteście nawet tak blisko?
Dialogue: 0,0:14:40.96,0:14:43.11,Default,Garfiel,0,0,0,,Jeśli pytasz, czy się dogadujemy,
Dialogue: 0,0:14:43.20,0:14:44.69,Default,Garfiel,0,0,0,,to nie, nie dogadujemy się.
Dialogue: 0,0:14:44.78,0:14:48.02,Default,Garfiel,0,0,0,,W każdym razie, gdy wczoraj byłeś na\Ncmentarzu, czy nie...
Dialogue: 0,0:14:54.35,0:14:55.41,Default,Subaru,0,0,0,,Emilia!
Dialogue: 0,0:14:58.27,0:15:01.72,Default,Emilia,0,0,0,,Przepraszam! Ja... ja...
Dialogue: 0,0:15:01.81,0:15:02.69,Default,Emilia,0,0,0,,...znów...
Dialogue: 0,0:15:04.15,0:15:07.26,Default,Roswaal,0,0,0,,Rozumiem. To niefortunne.
Dialogue: 0,0:15:07.63,0:15:13.05,Default,Roswaal,0,0,0,,Ale już sama wiedza, że nie możesz stracić\Nprawa do próby, ma znaczenie.
Dialogue: 0,0:15:13.54,0:15:17.81,Default,Subaru,0,0,0,,No więc? Po co wezwałeś mnie tutaj bez\NEmilii?
Dialogue: 0,0:15:17.90,0:15:20.10,Default,Roswaal,0,0,0,,To tylko trochę spisku.
Dialogue: 0,0:15:20.48,0:15:26.55,Default,Roswaal,0,0,0,,Nie jestem tak wielkoduszny, żeby\Nzaprosić kogoś, komu nie można ufać.
Dialogue: 0,0:15:26.64,0:15:29.41,Default,Subaru,0,0,0,,Nie można jej ufać? Mówisz o Emilii?
Dialogue: 0,0:15:29.50,0:15:30.48,Default,Subaru,0,0,0,,Co ty do diabła...
Dialogue: 0,0:15:30.57,0:15:33.07,Default,Roswaal,0,0,0,,Spokojnie, Subaru.
Dialogue: 0,0:15:33.40,0:15:37.66,Default,Roswaal,0,0,0,,Chciałbym, żebyś nadal pomagał i wspierał\NEmilię jak zawsze.
Dialogue: 0,0:15:37.92,0:15:40.35,Default,Subaru,0,0,0,,Nie musisz mnie o to prosić.
Dialogue: 0,0:15:40.44,0:15:42.37,Default,Subaru,0,0,0,,Ale co zamierzasz zrobić?
Dialogue: 0,0:15:42.46,0:15:44.20,Default,Roswaal,0,0,0,,Oczywiście, to samo.
Dialogue: 0,0:15:44.29,0:15:47.91,Default,Roswaal,0,0,0,,Zrobię wszystko, by pomóc Emilii zwyciężyć\Nw królewskiej elekcji.
Dialogue: 0,0:15:48.00,0:15:51.13,Default,Roswaal,0,0,0,,Chodzi mi o to, że jesteśmy\Nwspólnikami w zbrodni.
Dialogue: 0,0:15:51.38,0:15:53.90,Default,Subaru,0,0,0,,Nie powinieneś powiedzieć,\Nże jesteśmy partnerami?
Dialogue: 0,0:15:53.99,0:15:55.89,Default,Subaru,0,0,0,,Ciągle sobie zaprzeczasz.
Dialogue: 0,0:15:56.22,0:15:58.90,Default,Roswaal,0,0,0,,Co masz na myśli...?
Dialogue: 0,0:15:59.28,0:16:00.71,Default,Subaru,0,0,0,,Przestań udawać głupca!
Dialogue: 0,0:16:00.80,0:16:02.97,Default,Subaru,0,0,0,,Wszyscy wiedzieli, że Kult zaatakuje,
Dialogue: 0,0:16:03.06,0:16:05.98,Default,Subaru,0,0,0,,gdy udział Emilii zostanie publicznie\Nogłoszony!
Dialogue: 0,0:16:06.07,0:16:07.73,Default,Subaru,0,0,0,,A co ty, do diabła, robiłeś?!
Dialogue: 0,0:16:08.14,0:16:11.65,Default,Subaru,0,0,0,,Ukryłeś przed Emilią informacje o Kulcie\NCzarownicy, prawda?!
Dialogue: 0,0:16:11.96,0:16:13.87,Default,Subaru,0,0,0,,Emilia nic nie wiedziała!
Dialogue: 0,0:16:13.96,0:16:16.46,Default,Subaru,0,0,0,,Gdyby wiedziała, wszystko wyglądałoby\Ninaczej!
Dialogue: 0,0:16:16.87,0:16:18.33,Default,Subaru,0,0,0,,A jeśli tak...
Dialogue: 0,0:16:19.11,0:16:20.45,Default,Subaru,0,0,0,,To nie mogło...
Dialogue: 0,0:16:22.87,0:16:24.75,Default,Subaru,0,0,0,,Powinieneś tam być.
Dialogue: 0,0:16:25.13,0:16:28.36,Default,Subaru,0,0,0,,Gdybyś tam był,\Nto by się nie stało.
Dialogue: 0,0:16:28.83,0:16:30.63,Default,Subaru,0,0,0,,Gdybyś chronił wszystkich...
Dialogue: 0,0:16:30.86,0:16:35.29,Default,Roswaal,0,0,0,,Ale spełniłeś moją rolę\Nw mojej nieobecności.
Dialogue: 0,0:16:35.38,0:16:37.76,Default,Roswaal,0,0,0,,Jako rycerz, twój występ\Nbył godny pochwały.
Dialogue: 0,0:16:37.85,0:16:39.26,Default,Subaru,0,0,0,,Kogo to obchodzi?
Dialogue: 0,0:16:39.82,0:16:41.15,Default,Ram,0,0,0,,Uspokój się, Barusu.
Dialogue: 0,0:16:41.24,0:16:43.28,Default,Subaru,0,0,0,,Ram, zgadzasz się na to wszystko?!
Dialogue: 0,0:16:43.37,0:16:46.92,Default,Subaru,0,0,0,,Zostawiono cię w rezydencji jak pionek na\Nofiarę!
Dialogue: 0,0:16:47.01,0:16:50.07,Default,Ram,0,0,0,,Popieram wszystko, co zrobił Roswaal.
Dialogue: 0,0:16:50.50,0:16:55.18,Default,Ram,0,0,0,,Bez względu na to, jak mnie traktowano i\Nczy mnie porzucono, to się nie zmieni.
Dialogue: 0,0:16:56.42,0:17:01.66,Default,Subaru,0,0,0,,Więc nie obchodzi cię, że Rem poświęcono z\Ntak głupiego powodu?!
Dialogue: 0,0:17:05.45,0:17:08.12,Default,Ram,0,0,0,,Nie wiem o kim mówisz.
Dialogue: 0,0:17:08.21,0:17:11.07,Default,Ram,0,0,0,,Ale imię obcego nic dla\Nmnie nie znaczy.
Dialogue: 0,0:17:14.60,0:17:19.73,Default,Roswaal,0,0,0,,Dlaczego ukryłem informacje,\Nktóre powinienem był ujawnić Emilii?
Dialogue: 0,0:17:19.82,0:17:23.12,Default,Roswaal,0,0,0,,Dlaczego nie byłem obecny w rezydencji?
Dialogue: 0,0:17:23.21,0:17:25.61,Default,,0,0,0,,gdy Kult Czarownicy przygotowywał się do\Nataku?
Dialogue: 0,0:17:26.12,0:17:28.67,Default,Roswaal,0,0,0,,Na wszystkie te pytania\Njest tylko jedna odpowiedź.
Dialogue: 0,0:17:28.92,0:17:33.05,Default,Roswaal,0,0,0,,Aby samemu nie musieć stawiać czoła\NKultowi Czarownicy,
Dialogue: 0,0:17:33.67,0:17:35.49,Default,Roswaal,0,0,0,,Osobiście...
Dialogue: 0,0:17:36.00,0:17:37.99,Default,Roswaal,0,0,0,,doprowadziłem do tych wydarzeń.
Dialogue: 0,0:17:40.73,0:17:42.95,Default,Roswaal,0,0,0,,W końcu, gdybym sam rozwiązał\Nten problem,
Dialogue: 0,0:17:43.04,0:17:48.88,Default,Roswaal,0,0,0,,ani Emilia, ani ty nie moglibyście\Nprzypisać sobie żadnych zasług.
Dialogue: 0,0:17:49.10,0:17:51.92,Default,Roswaal,0,0,0,,To miało ogromny wpływ, prawda?
Dialogue: 0,0:17:52.01,0:17:54.38,Default,Roswaal,0,0,0,,Stosunek mieszkańców wioski Arlam do\NEmilii
Dialogue: 0,0:17:54.47,0:17:58.89,Default,Roswaal,0,0,0,,jest teraz zupełnie inny niż przed atakiem\NKultu Czarownicy.
Dialogue: 0,0:17:58.98,0:18:01.35,Default,Roswaal,0,0,0,,Nie widzą w niej niepojętej\Nkrewnej czarownicy.
Dialogue: 0,0:18:01.44,0:18:05.31,Default,Roswaal,0,0,0,,lecz kogoś, kto przyczynił się\Ndo ocalenia ich życia.
Dialogue: 0,0:18:05.92,0:18:10.15,Default,Subaru,0,0,0,,Czy ty... masz pojęcie o czym mówisz?!
Dialogue: 0,0:18:10.24,0:18:12.43,Default,Subaru,0,0,0,,Tak to wygląda dopiero z perspektywy\Nczasu!
Dialogue: 0,0:18:12.52,0:18:15.19,Default,Subaru,0,0,0,,Wiesz ile ludzi zginęło,\Nbo cię tam nie było?
Dialogue: 0,0:18:15.28,0:18:16.86,Default,,0,0,0,,i nikomu nic nie powiedziałeś?!
Dialogue: 0,0:18:16.95,0:18:20.74,Default,Roswaal,0,0,0,,Wyrażam współczucie dla\Nwszystkich, którzy zginęli.
Dialogue: 0,0:18:20.83,0:18:24.08,Default,Roswaal,0,0,0,,A może wolałbyś usłyszeć przeprosiny?
Dialogue: 0,0:18:23.22,0:18:25.81,Default,Subaru,0,0,0,,{\an8}Nie, nie, nie, nie, nie, to nie to!
Dialogue: 0,0:18:25.90,0:18:27.04,Default,Subaru,0,0,0,,Nie tego chcę!
Dialogue: 0,0:18:27.35,0:18:29.43,Default,Subaru,0,0,0,,Gdybym nadal był bezużytecznym\Nśmieciem,
Dialogue: 0,0:18:29.52,0:18:31.07,Default,Subaru,0,0,0,,Co byś zrobił?!
Dialogue: 0,0:18:31.16,0:18:34.98,Default,Subaru,0,0,0,,Gdyby nie udało się ocalić ani\Nmieszkańców, ani Emilii...
Dialogue: 0,0:18:34.38,0:18:36.34,Default,Roswaal,0,0,0,,{\an8}Miałem wiarę...
Dialogue: 0,0:18:36.58,0:18:37.91,Default,Roswaal,0,0,0,,w ciebie.
Dialogue: 0,0:18:38.93,0:18:41.43,Default,Roswaal,0,0,0,,Ufałem, że zrobisz\Nwszystko dla Emilii.
Dialogue: 0,0:18:41.52,0:18:44.38,Default,Roswaal,0,0,0,,dołożysz wszelkich starań, by zawrzeć\Nsojusz z Crusch,
Dialogue: 0,0:18:44.47,0:18:47.42,Default,Roswaal,0,0,0,,zaryzykujesz życie, by powstrzymać atak\NKultu Czarownicy,
Dialogue: 0,0:18:47.51,0:18:49.81,Default,Roswaal,0,0,0,,i doskonale wykonasz wszystkie te zadania.
Dialogue: 0,0:18:49.90,0:18:52.07,Default,Subaru,0,0,0,,Co ty o mnie wiesz?
Dialogue: 0,0:18:52.16,0:18:55.24,Default,Subaru,0,0,0,,Kiedy cię ostatnio widziałem,\Nbyłem kompletnym śmieciem!
Dialogue: 0,0:18:55.33,0:18:59.03,Default,Subaru,0,0,0,,Stałem się tylko trochę mniej bezużyteczny\Nz powodu tego co się stało!
Dialogue: 0,0:18:59.12,0:19:02.46,Default,Subaru,0,0,0,,Nikt nie wie, co się stało później!
Dialogue: 0,0:19:02.55,0:19:04.94,Default,Subaru,0,0,0,,Co sprawiło, że we mnie uwierzyłeś?!
Dialogue: 0,0:19:03.09,0:19:07.12,Default,Roswaal,0,0,0,,{\an8}Wygląda na to, że dzisiejsza\Nrozmowa dobiegła końca.
Dialogue: 0,0:19:07.87,0:19:11.07,Default,Roswaal,0,0,0,,A tak przy okazji, jeśli powiesz\NEmilii, o czym rozmawialiśmy...
Dialogue: 0,0:19:11.33,0:19:13.16,Default,Subaru,0,0,0,,Jakbym mógł jej powiedzieć!
Dialogue: 0,0:19:13.73,0:19:16.47,Default,Roswaal,0,0,0,,Choć ogarnęło cię takie oburzenie,
Dialogue: 0,0:19:16.56,0:19:19.72,Default,Roswaal,0,0,0,,W duszy rozumiesz, że wszystko\Njest takie, jakie powinno być.
Dialogue: 0,0:19:19.81,0:19:21.80,Default,Roswaal,0,0,0,,Że dla jej szans w królewskiej elekcji
Dialogue: 0,0:19:21.89,0:19:25.76,Default,Roswaal,0,0,0,,nie możesz wywołać konfliktu między nią a\Nmną ani mieszkańcami wioski.
Dialogue: 0,0:19:27.62,0:19:31.78,Default,Roswaal,0,0,0,,Wiedziałem, że będziesz dla mnie\Nodpowiednim wspólnikiem w zbrodni.
Dialogue: 0,0:19:34.51,0:19:37.30,Default,Emilia,0,0,0,,Przepraszam. Znowu zawiodłam.
Dialogue: 0,0:19:37.90,0:19:40.08,Default,Subaru,0,0,0,,Nie musisz się tak obwiniać.
Dialogue: 0,0:19:40.17,0:19:42.84,Default,Subaru,0,0,0,,Nie możesz stracić prawa do próby,
Dialogue: 0,0:19:42.93,0:19:45.71,Default,Subaru,0,0,0,,Więc teraz wszystko zależy\Nod twoich własnych uczuć.
Dialogue: 0,0:19:46.34,0:19:48.41,Default,Emilia,0,0,0,,Moje własne uczucia...
Dialogue: 0,0:19:49.09,0:19:51.51,Default,Subaru,0,0,0,,Wiem, że to dla ciebie trudne.
Dialogue: 0,0:19:51.60,0:19:55.98,Default,Subaru,0,0,0,,Ale nie ma sensu uwalniać Sanktuarium,\Njeśli nie ty to zrobisz...
Dialogue: 0,0:19:56.07,0:19:57.02,Default,Subaru,0,0,0,,Chyba tak.
Dialogue: 0,0:19:58.67,0:20:01.77,Default,Subaru,0,0,0,,Myślisz, że możesz spróbować\Njeszcze raz... żeby to się stało?
Dialogue: 0,0:20:07.16,0:20:08.57,Default,Emilia,0,0,0,,Subaru, ty kretynie.
Dialogue: 0,0:20:08.66,0:20:10.46,Default,Subaru,0,0,0,,Czekaj, skąd nagle te obelgi?!
Dialogue: 0,0:20:10.97,0:20:13.70,Default,Emilia,0,0,0,,Kiedy pytasz z takim łagodnym spojrzeniem,
Dialogue: 0,0:20:13.79,0:20:16.07,Default,Emilia,0,0,0,,jak mogłabym powiedzieć, że nie dam rady?
Dialogue: 0,0:20:16.16,0:20:19.19,Default,Emilia,0,0,0,,Nie jestem zbyt mądra,
Dialogue: 0,0:20:19.28,0:20:21.98,Default,Emilia,0,0,0,,ale wiem, że to mój obowiązek.
Dialogue: 0,0:20:22.91,0:20:25.54,Default,Emilia,0,0,0,,Nie rozpieszczaj mnie,\Ntylko wierz we mnie.
Dialogue: 0,0:20:25.98,0:20:29.45,Default,Emilia,0,0,0,,Wiem, że pewnie nie brzmię teraz zbyt\Nprzekonująco...
Dialogue: 0,0:20:29.65,0:20:32.50,Default,Subaru,0,0,0,,To nieprawda! Będę czekał i wierzył w\Nciebie!
Dialogue: 0,0:20:34.82,0:20:36.46,Default,Emilia,0,0,0,,Dobrze, dziękuję.
Dialogue: 0,0:20:37.09,0:20:40.82,Default,Emilia,0,0,0,,Ale wiem, że będę sprawiać\Nkłopoty ludziom z Arlam.
Dialogue: 0,0:20:41.24,0:20:43.29,Default,Emilia,0,0,0,,To jedyna rzecz, której żałuję.
Dialogue: 0,0:20:43.38,0:20:45.33,Default,Subaru,0,0,0,,A propos...
Dialogue: 0,0:20:45.42,0:20:47.49,Default,Subaru,0,0,0,,Mogłabyś zostawić to wszystko mnie?
Dialogue: 0,0:20:48.66,0:20:51.40,Default,Emilia,0,0,0,,Ufam ci.
Dialogue: 0,0:20:52.36,0:20:55.11,Default,Emilia,0,0,0,,Nie zaczęłabym w ciebie wątpić\Nteraz, po tym wszystkim.
Dialogue: 0,0:20:55.46,0:20:56.45,Default,Emilia,0,0,0,,Ufam ci.
Dialogue: 0,0:20:59.72,0:21:03.37,Default,Otto,0,0,0,,W każdym razie, jestem pod wrażeniem,\Nże udało ci się przekonać Garfiela.
Dialogue: 0,0:21:03.46,0:21:05.91,Default,Subaru,0,0,0,,Ale to zajęło dwa dni.
Dialogue: 0,0:21:06.00,0:21:08.67,Default,Subaru,0,0,0,,Rozumie, że skoro Emilia\Njest już w barierze,
Dialogue: 0,0:21:08.76,0:21:12.62,Default,Subaru,0,0,0,,Uwolnienie mieszkańców wioski Arlam\Nnie spowoduje żadnych problemów.
Dialogue: 0,0:21:13.01,0:21:19.51,Default,Otto,0,0,0,,Byłem pewien, że nigdy nie posłucha tego,\Nco mamy do powiedzenia.
Dialogue: 0,0:21:19.60,0:21:22.76,Default,Subaru,0,0,0,,Jak na handlowca, jesteś\Nkiepskim osądcą charakteru.
Dialogue: 0,0:21:27.27,0:21:29.63,Default,Ram,0,0,0,,To dość staromodny amulet\Nna szczęście.
Dialogue: 0,0:21:29.72,0:21:32.03,Default,Subaru,0,0,0,,Petra dała mi go przed wyjazdem.
Dialogue: 0,0:21:32.45,0:21:34.89,Default,Subaru,0,0,0,,Tuż po zatrudnieniu jej przez Fredericę.
Dialogue: 0,0:21:35.60,0:21:39.07,Default,Ram,0,0,0,,Frederica nigdy nie zrobiłaby niczego\Nzłego nowej pracownicy.
Dialogue: 0,0:21:39.16,0:21:41.63,Default,Ram,0,0,0,,Nigdy nie byłaby taka diabelska.
Dialogue: 0,0:21:41.72,0:21:43.80,Default,Ram,0,0,0,,Nie musisz się martwić o dziewczynę.
Dialogue: 0,0:21:44.25,0:21:47.54,Default,Subaru,0,0,0,,Ufasz Frederice czy nie?
Dialogue: 0,0:21:47.63,0:21:48.51,Default,Subaru,0,0,0,,Nie wiem.
Dialogue: 0,0:21:48.88,0:21:50.29,Default,Ram,0,0,0,,Nie wiem, co ona planuje.
Dialogue: 0,0:21:50.38,0:21:54.54,Default,Ram,0,0,0,,Ale Frederica to Frederica. Co do tego nie\Nmam wątpliwości.
Dialogue: 0,0:21:54.96,0:21:57.71,Default,Ram,0,0,0,,Mam też wiadomość od Roswaala.
Dialogue: 0,0:21:59.35,0:22:02.20,Default,Ram,0,0,0,,Jeśli martwisz się konfrontacją z\NFredericą,
Dialogue: 0,0:22:02.29,0:22:04.36,Default,Ram,0,0,0,,Proszę się zwrócić do pani Beatrice.
Dialogue: 0,0:22:04.45,0:22:05.80,Default,Ram,0,0,0,,I powiedz jej:
Dialogue: 0,0:22:06.40,0:22:09.49,Default,Ram,0,0,0,,Roswaal kazał zadać pytanie.
Dialogue: 0,0:22:09.58,0:22:10.47,Default,Subaru,0,0,0,,Pytanie?
Dialogue: 0,0:22:10.56,0:22:12.22,Default,Ram,0,0,0,,Nie znam szczegółów.
Dialogue: 0,0:22:12.31,0:22:15.59,Default,Ram,0,0,0,,Ale kiedy Beatrice usłyszy te słowa,
Dialogue: 0,0:22:15.68,0:22:17.02,Default,,0,0,0,,Wszystko się zmieni.
Dialogue: 0,0:22:17.11,0:22:19.02,Default,Ram,0,0,0,,Tak powiedział Roswaal.
Dialogue: 0,0:22:21.00,0:22:21.94,Default,Emilia,0,0,0,,Subaru!
Dialogue: 0,0:22:22.81,0:22:23.69,Default,Subaru,0,0,0,,Cześć.
Dialogue: 0,0:22:24.00,0:22:26.86,Default,Emilia,0,0,0,,Czy przerwałam rozmowę z Ram?
Dialogue: 0,0:22:27.24,0:22:29.33,Default,Subaru,0,0,0,,Nie, nie ma problemu.
Dialogue: 0,0:22:29.42,0:22:32.10,Default,Subaru,0,0,0,,Nie rozmawialiśmy o niczym ważnym.
Dialogue: 0,0:22:32.19,0:22:33.79,Default,Subaru,0,0,0,,Poza tym, ty masz pierwszeństwo!
Dialogue: 0,0:22:34.04,0:22:36.35,Default,Emilia,0,0,0,,To mnie naprawdę uszczęśliwia.
Dialogue: 0,0:22:36.44,0:22:39.34,Default,Emilia,0,0,0,,ale teraz powinieneś dać pierwszeństwo\Nmieszkańcom wioski.
Dialogue: 0,0:22:39.61,0:22:40.51,Default,Subaru,0,0,0,,Oczywiście.
Dialogue: 0,0:22:43.36,0:22:46.70,Default,Emilia,0,0,0,,Niech błogosławieństwo\Nduchów będzie z wami.
Dialogue: 0,0:22:50.96,0:22:54.79,Default,Subaru,0,0,0,,Dzięki, że zgodziłeś się zawieźć nas aż do\Nbariery.
Dialogue: 0,0:22:54.88,0:22:56.50,Default,Garfiel,0,0,0,,Wszystko w porządku.
Dialogue: 0,0:22:57.05,0:22:58.55,Default,Garfiel,0,0,0,,A tak przy okazji, płotko...
Dialogue: 0,0:22:59.33,0:23:02.61,Default,Garfiel,0,0,0,,Przeszedłeś próbę na cmentarzu, prawda?
Dialogue: 0,0:23:04.89,0:23:06.61,Default,Garfiel,0,0,0,,Nie musisz tego ukrywać.
Dialogue: 0,0:23:06.70,0:23:07.82,Default,Garfiel,0,0,0,,Widzę.
Dialogue: 0,0:23:08.56,0:23:10.61,Default,Subaru,0,0,0,,I jaki jest sens pytania mnie o to?
Dialogue: 0,0:23:11.20,0:23:12.80,Default,Garfiel,0,0,0,,To proste.
Dialogue: 0,0:23:12.89,0:23:16.26,Default,Garfiel,0,0,0,,Możesz przejść próbę zamiast Emilii.
Dialogue: 0,0:23:16.35,0:23:18.78,Default,Subaru,0,0,0,,Nie mogę! Precedens byłby...
Dialogue: 0,0:23:18.87,0:23:23.00,Default,Garfiel,0,0,0,,Czy to naprawdę konieczne,\Nby przezwyciężyć przeszłość?
Dialogue: 0,0:23:24.04,0:23:27.55,Default,Garfiel,0,0,0,,Widziałem, jak Emilia przechodziła próbę.
Dialogue: 0,0:23:27.64,0:23:28.63,Default,Garfiel,0,0,0,,Ją to złamało.
Dialogue: 0,0:23:29.39,0:23:32.13,Default,Garfiel,0,0,0,,I za każdym razem wraca\Ncałkowicie przerażona.
Dialogue: 0,0:23:32.22,0:23:33.47,Default,Garfiel,0,0,0,,Nie mogę tego oglądać.
Dialogue: 0,0:23:34.36,0:23:38.80,Default,Subaru,0,0,0,,Wierzę, że Emilia zdoła przejść próbę.
Dialogue: 0,0:23:38.89,0:23:39.77,Default,Subaru,0,0,0,,Więc ja...
Dialogue: 0,0:23:39.90,0:23:41.87,Default,Garfiel,0,0,0,,Możesz oczekiwać od niej, czego chcesz.
Dialogue: 0,0:23:41.96,0:23:45.74,Default,Garfiel,0,0,0,,Ale czy naprawdę chce\Nprzezwyciężyć swoją przeszłość?
Dialogue: 0,0:23:45.83,0:23:49.19,Default,Garfiel,0,0,0,,Gdy płacze ze strachu, czy nie\Npokazuje prawdziwych uczuć?
Dialogue: 0,0:23:49.28,0:23:51.78,Default,Subaru,0,0,0,,Jak się naprawdę czuje Emilia?
Dialogue: 0,0:23:55.37,0:23:57.46,Default,Subaru,0,0,0,,Czy Emilia naprawdę...
Dialogue: 0,0:23:58.10,0:23:59.60,Default,Garfiel,0,0,0,,Bariera jest już blisko.
Dialogue: 0,0:24:00.38,0:24:03.35,Default,Garfiel,0,0,0,,Dalej nie mogę cię zabrać.
Dialogue: 0,0:24:04.93,0:24:05.92,Default,Garfiel,0,0,0,,Weź to.
Dialogue: 0,0:24:07.42,0:24:08.71,Default,Subaru,0,0,0,,To jest...
Dialogue: 0,0:24:09.14,0:24:11.91,Default,Garfiel,0,0,0,,Nie powiem ci, dlaczego.
Dialogue: 0,0:24:12.00,0:24:14.64,Default,Garfiel,0,0,0,,Ale jeśli nie wrócisz,
Dialogue: 0,0:24:14.73,0:24:16.83,Default,,0,0,0,,To my będziemy cierpieć.
Dialogue: 0,0:24:16.92,0:24:19.24,Default,Garfiel,0,0,0,,Pokaż to Fredericce, jeśli będzie trzeba.
Dialogue: 0,0:24:33.01,0:24:34.24,Default,Subaru,0,0,0,,Nie ma sprawy.
Dialogue: 0,0:24:41.06,0:24:42.62,Default,Subaru,0,0,0,,Nikt tu nie jest?
Dialogue: 0,0:24:54.26,0:24:55.90,Default,Subaru,0,0,0,,Co się dzieje?
Dialogue: 0,0:25:02.44,0:25:04.64,Default,Subaru,0,0,0,,Rem... Co z Rem?
Dialogue: 0,0:25:15.16,0:25:16.04,Default,Subaru,0,0,0,,Rem!
Dialogue: 0,0:25:50.99,0:25:52.90,Default,Elsa,0,0,0,,Obiecałeś, prawda?
Dialogue: 0,0:25:53.83,0:25:58.42,Default,Elsa,0,0,0,,Że będziesz dobrze dbał o swoje\Njelita, dopóki się nie spotkamy.
Dialogue: 0,0:26:06.96,0:26:09.83,Episode Title,Title,0,0,0,,{\fs30\t(1,5010,\fs25)}Krok {\c&H514E51&}naprzód
